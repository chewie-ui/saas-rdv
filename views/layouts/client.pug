doctype html
html(lang="fr")
    head
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(charset="UTF-8")
        title= title || 'Mon espace — BranShee'

        //- Google tag (GA4 + Google Ads)
        script(async src="https://www.googletagmanager.com/gtag/js?id=G-PZR5994GKD")
        script.
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-PZR5994GKD');
            gtag('config', 'AW-18287595473');
        include ../includes/gads-conversion
        meta(name="robots" content="noindex, nofollow")
        //- Favicons. Le `?v=` est indispensable : le logo a changé le 02/07 et
        //- Safari garde son cache d'icônes très longtemps sur une URL identique.
        //- L'incrémenter à chaque changement de logo.
        link(rel="icon" href="/images/icon.svg?v=2" type="image/svg+xml")
        link(rel="icon" href="/favicon.ico?v=2" sizes="32x32")
        link(rel="apple-touch-icon" href="/images/icon.png?v=2")
        link(rel="stylesheet", href="/css/import.css")
        link(rel="stylesheet", href="/css/layouts/client.css")
        //- Anti-flash : applique le thème AVANT le rendu
        script.
            (function(){try{var t=localStorage.getItem('branshee-theme')||localStorage.getItem('saymiro-theme');if(t==='dark')document.documentElement.setAttribute('data-theme','dark');}catch(e){}})();
        block links
    body
        .client-layout
            include ../common/sidebar-client
            .client-main
                .client-nav
                    button#openMenu.client-nav__burger(type="button" aria-label="Ouvrir le menu")
                        svg(xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor")
                            path(d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z")
                    h2.client-nav__title= pageName || 'Mon espace'
                .client-main-wrapper
                    block content
        script(src="/js/layouts/admin.js" type="module")
        script(src="/js/theme.js")
        script(src="/js/pageview-beacon.js")
        block scripts
        script.
            window.__t = !{JSON.stringify(t.js)};
