
include ../templates/modals/dialog.pug

doctype html
html(lang="fr")
    head
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(charset="UTF-8")
        title= title || 'admin'
        link(rel="shortcut icon", href="/images/icon.webp", type="image/x-icon")
        link(rel="stylesheet", href="/css/import.css")
        link(rel="stylesheet", href="/css/layouts/admin.css")
        block links
    body
        div.layout
            include ../common/sidebar
            .main
                .admin-nav
                    h2= pageName || "Undefined page"
                    .admin__menu
                        .admin__lang#langSelector
                            .admin__lang-active
                                p #{lang === 'fr' ? "Francais" : "English"}
                                img(src=`/images/${lang === "en" ? 'en.jpg' : 'fr.webp'}`)
                            .admin__lang-panel
                                .lang(onclick="changeLanguage('fr')")
                                    p French
                                    img(src="/images/fr.webp")
                                .lang(onclick="changeLanguage('en')")
                                    p English
                                    img(src="/images/en.jpg")
                        .admin__profile
                            .admin__profile-image
                                img(src=user.profilePicture)
                            .admin__profile-name= user.fullName.split(" ")
                            if user.isPremium
                                .admin__profile-premium--icon.flex-c
                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffe600"><path d="M200-160v-80h560v80H200Zm0-140-51-321q-2 0-4.5.5t-4.5.5q-25 0-42.5-17.5T80-680q0-25 17.5-42.5T140-740q25 0 42.5 17.5T200-680q0 7-1.5 13t-3.5 11l125 56 125-171q-11-8-18-21t-7-28q0-25 17.5-42.5T480-880q25 0 42.5 17.5T540-820q0 15-7 28t-18 21l125 171 125-56q-2-5-3.5-11t-1.5-13q0-25 17.5-42.5T820-740q25 0 42.5 17.5T880-680q0 25-17.5 42.5T820-620q-2 0-4.5-.5t-4.5-.5l-51 321H200Zm68-80h424l26-167-105 46-133-183-133 183-105-46 26 167Zm212 0Z"/></svg>
                    #openMenu.flex-c
                        svg(xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3")
                            path(d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z")
                .main-wrapper
                    block content
        +dialog()
        script(src="/js/layouts/admin.js" type="module")
        
        block scripts

        script.
            
            const COMPANY_ID = !{company ? `"${company._id}"` : "null"};



            