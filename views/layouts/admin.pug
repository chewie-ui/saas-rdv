        script.
            (function(){try{var t=localStorage.getItem('branshee-theme');if(t==='dark')document.documentElement.setAttribute('data-theme','dark');}catch(e){}})();
        //- ── Messages du fondateur (superadmin → utilisateur) — popup centré ──
        style.
            .am-overlay {
                position: fixed; inset: 0; z-index: 4000;
                display: flex; align-items: center; justify-content: center;
                padding: 20px;
                background: rgba(15, 23, 42, .55);
                backdrop-filter: blur(4px);
                animation: amFade .2s ease;
            }
            @keyframes amFade { from { opacity: 0; } to { opacity: 1; } }
            .am-modal {
                position: relative;
                width: 440px; max-width: 100%;
                background: var(--am-card, #fff);
                border: 1px solid var(--am-border, #e2e8f0);
                border-radius: 20px;
                box-shadow: 0 24px 60px rgba(0,0,0,.28);
                overflow: hidden;
                animation: amPop .34s cubic-bezier(.16,1,.3,1);
            }
            @keyframes amPop { from { opacity: 0; transform: translateY(14px) scale(.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
            .am-modal__accent { height: 5px; background: var(--am-accent, #2563eb); }
            .am-modal__inner { padding: 26px 26px 22px; text-align: center; }
            .am-modal__icon { width: 60px; height: 60px; margin: 4px auto 16px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 30px; background: var(--am-icon-bg, #eff6ff); border: 1px solid var(--am-border, #e2e8f0); }
            .am-modal__from { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--am-accent, #2563eb); margin-bottom: 8px; }
            .am-modal__title { font-size: 19px; font-weight: 800; color: var(--am-title, #0f172a); letter-spacing: -.02em; margin-bottom: 10px; line-height: 1.25; }
            .am-modal__text { font-size: 14px; line-height: 1.6; color: var(--am-text, #475569); white-space: pre-wrap; word-break: break-word; }
            .am-modal__actions { display: flex; flex-direction: column; gap: 10px; margin-top: 22px; }
            .am-modal__cta { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 12px 18px; border-radius: 11px; font-size: 14px; font-weight: 700; text-decoration: none; color: #fff; background: var(--am-accent, #2563eb); transition: filter .15s; }
            .am-modal__cta:hover { filter: brightness(1.08); }
            .am-modal__ok { padding: 12px 18px; border-radius: 11px; font-size: 14px; font-weight: 700; cursor: pointer; border: 1.5px solid var(--am-border, #e2e8f0); background: transparent; color: var(--am-title, #0f172a); transition: background .15s; }
            .am-modal__ok--solo { color: #fff; background: var(--am-accent, #2563eb); border-color: transparent; }
            .am-modal__ok:hover { background: var(--am-hover, rgba(0,0,0,.04)); }
            .am-modal__ok--solo:hover { background: var(--am-accent, #2563eb); filter: brightness(1.08); }
            .am-modal__close { position: absolute; top: 14px; right: 14px; width: 30px; height: 30px; border: none; background: rgba(0,0,0,.05); color: var(--am-text, #94a3b8); cursor: pointer; border-radius: 9px; display: flex; align-items: center; justify-content: center; transition: background .15s, color .15s; z-index: 2; }
            .am-modal__close:hover { background: rgba(0,0,0,.1); color: var(--am-title, #0f172a); }
            .am-modal__count { font-size: 11.5px; color: var(--am-text, #94a3b8); margin-top: 14px; opacity: .8; }
            .am-modal--info     { --am-border:#bfdbfe; --am-icon-bg:#eff6ff; --am-title:#0f172a; --am-text:#475569; --am-accent:#2563eb; }
            .am-modal--tip      { --am-border:#e9d5ff; --am-icon-bg:#faf5ff; --am-title:#0f172a; --am-text:#475569; --am-accent:#9333ea; }
            .am-modal--success  { --am-border:#bbf7d0; --am-icon-bg:#f0fdf4; --am-title:#0f172a; --am-text:#475569; --am-accent:#16a34a; }
            .am-modal--warning  { --am-border:#fde68a; --am-icon-bg:#fffbeb; --am-title:#0f172a; --am-text:#475569; --am-accent:#d97706; }
            .am-modal--security { --am-border:#fecaca; --am-icon-bg:#fef2f2; --am-title:#0f172a; --am-text:#475569; --am-accent:#dc2626; }
            :root[data-theme="dark"] .am-modal { --am-card:#141b2d; --am-hover:rgba(255,255,255,.06); }
            :root[data-theme="dark"] .am-modal__close { background: rgba(255,255,255,.07); }
            :root[data-theme="dark"] .am-modal__close:hover { background: rgba(255,255,255,.14); }
            :root[data-theme="dark"] .am-modal--info     { --am-border:#1e3a5f; --am-icon-bg:#0f1f38; --am-title:#f1f5f9; --am-text:#a3b4cc; --am-accent:#3b82f6; }
            :root[data-theme="dark"] .am-modal--tip      { --am-border:#3b2758; --am-icon-bg:#1e1233; --am-title:#f1f5f9; --am-text:#c3a8e0; --am-accent:#a855f7; }
            :root[data-theme="dark"] .am-modal--success  { --am-border:#1c4530; --am-icon-bg:#0d2417; --am-title:#f1f5f9; --am-text:#8fceaa; --am-accent:#22c55e; }
            :root[data-theme="dark"] .am-modal--warning  { --am-border:#4d3a14; --am-icon-bg:#2a1e08; --am-title:#f1f5f9; --am-text:#d6b876; --am-accent:#f59e0b; }
            :root[data-theme="dark"] .am-modal--security { --am-border:#5a2020; --am-icon-bg:#2a1010; --am-title:#f1f5f9; --am-text:#e0a0a0; --am-accent:#ef4444; }
        block links
    if isImpersonating
        style.
            body { padding-top: 44px !important; }
            .impersonation-bar { position:fixed;top:0;left:0;right:0;z-index:99999;background:#f97316;color:#fff;padding:0 18px;height:44px;display:flex;align-items:center;justify-content:space-between;font-size:13px;font-weight:600;box-shadow:0 2px 12px rgba(0,0,0,.18);gap:12px; }
            .impersonation-bar__left { display:flex;align-items:center;gap:8px; }
            .impersonation-bar__exit { display:inline-flex;align-items:center;padding:5px 13px;border-radius:7px;border:1.5px solid rgba(255,255,255,.5);color:#fff;font-size:12px;font-weight:700;text-decoration:none;transition:background .15s;white-space:nowrap; }
            .impersonation-bar__exit:hover { background:rgba(255,255,255,.15); }
            body { outline:3px solid #f97316;outline-offset:-3px; }

    body
        if isImpersonating
            .impersonation-bar
                .impersonation-bar__left
                    if isImpersonating.mode === 'supervised'
                        span 👁
                        span Supervision active — Compte de&nbsp;
                        strong= isImpersonating.userEmail
                    else
                        span 🔒
                        span Accès discret — Compte de&nbsp;
                        strong= isImpersonating.userEmail
                a.impersonation-bar__exit(href="/superadmin/exit-impersonation") Quitter ✕

        div.layout(class=moduleMode ? 'layout--module' : '')
            if !moduleMode
                include ../common/sidebar
            .main
                .admin-nav
                    #openMenu.flex-c
                        svg(xmlns="http://www.w3.org/2000/svg" height="22" viewBox="0 -960 960 960" width="22" fill="currentColor")
                            path(d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z")
                    //- Les contrôleurs passent un `title` optimisé pour l'onglet du
                    //- navigateur (« Collaborateurs — BranShee »). Dans la barre du
                    //- haut, la marque n'apporte rien : on la retire à l'affichage.
                    h2.admin-nav__title= String(title || pageName || "Undefined page").replace(/\s*[—–-]\s*BranShee.*$/i, '')
                    .admin-nav__actions
                        -
                            var navCtaMap = {
                                'Appointment':   { label: t.sidebar.new_appointment || 'New appointment', href: '/appointment/new' },
                            }
                            var navCta = navCtaMap[pageName]
                            var calendarUrl = currentCompany ? ('/' + (currentCompany.slug || currentCompany._id)) : '/'
                            var calendarFullUrl = 'https://www.branshee.com' + calendarUrl
                        if pageName === 'Appointment'
                            button.sm-btn.sm-btn--ghost#shareCalendarBtn(type="button" data-url=calendarFullUrl title=t.sidebar.share_calendar || 'Share calendar')
                                svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                                    path(d="M680-80q-50 0-85-35t-35-85q0-6 3-28L282-392q-16 15-37 23.5t-45 8.5q-50 0-85-35t-35-85q0-50 35-85t85-35q24 0 45 8.5t37 23.5l281-164q-2-7-2.5-13.5T560-760q0-50 35-85t85-35q50 0 85 35t35 85q0 50-35 85t-85 35q-24 0-45-8.5T598-672L317-508q2 7 2.5 13.5t.5 14.5q0 8-.5 14.5T317-452l281 164q16-15 37-23.5t45-8.5q50 0 85 35t35 85q0 50-35 85t-85 35Z")
                                span= t.sidebar.share_calendar || 'Share'
                            button.sm-btn.sm-btn--ghost#syncAgendaBtn(type="button" title="Synchroniser avec mon agenda")
                                svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                                    path(d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Zm0 0v-80 80Zm80 240v-80h400v80H280Zm0 160v-80h280v80H280Z")
                                span Sync agenda
                            button.sm-btn.sm-btn--primary#newApptBtn(type="button")
                                svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                                    path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                                span= t.sidebar.new_appointment || 'New appointment'
                        else if navCta
                            a.sm-btn.sm-btn--primary(href=navCta.href)
                                svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                                    path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                                span= navCta.label
                if monthlyLimitReached
                    .limit-toast#limitToast
                        button.limit-toast__close#limitToastClose(type="button" title="Fermer")
                            svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                path(d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z")
                        .limit-toast__icon
                            svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                                path(d="m40-120 440-760 440 760H40Zm138-80h604L480-720 178-200Zm302-40q17 0 28.5-11.5T520-280q0-17-11.5-28.5T480-320q-17 0-28.5 11.5T440-280q0 17 11.5 28.5T480-240Zm-40-120h80v-200h-80v200Zm40-100Z")
                        .limit-toast__body
                            strong Vous n'avez plus de crédit ce mois-ci
                            span Limite de #{monthlyBookingsLimit} rendez-vous atteinte — vos clients ne peuvent plus réserver.
                            a.limit-toast__cta(href="/subscription") Passer au Pro →
                    script.
                        (function() {
                            var toast = document.getElementById('limitToast');
                            var closeBtn = document.getElementById('limitToastClose');
                            if (!toast || !closeBtn) return;
                            // Reste visible sur TOUTES les pages tant qu'il n'est pas fermé —
                            // une fois fermé, on s'en souvient pour le reste de la session de
                            // navigation (réapparaît à la prochaine session si toujours plein).
                            if (sessionStorage.getItem('bs_limit_toast_dismissed') === '1') {
                                toast.style.display = 'none';
                                return;
                            }
                            closeBtn.addEventListener('click', function() {
                                toast.style.display = 'none';
                                sessionStorage.setItem('bs_limit_toast_dismissed', '1');
                            });
                        })();
                .main-wrapper
                    //- Avertissement fin d'essai/octroi — visible uniquement si
                    //- l'accès expire bientôt ET qu'aucun moyen de paiement par
                    //- défaut n'est enregistré (sinon rien à faire pour l'user).
                    if showTrialWarning
                        style.
                            .trial-warn { display:flex; align-items:center; gap:14px; background:#fff7ed; border:1px solid #fed7aa; border-radius:14px; padding:14px 18px; margin-bottom:18px; }
                            .trial-warn__ic { color:#c2410c; font-size:26px; flex:none; }
                            .trial-warn__body { flex:1; min-width:0; }
                            .trial-warn__title { display:block; font-size:14px; font-weight:700; color:#9a3412; }
                            .trial-warn__sub { display:block; font-size:12.5px; color:#b45309; line-height:1.5; margin-top:2px; }
                            .trial-warn__cta { flex:none; display:inline-block; background:#c2410c; color:#fff; text-decoration:none; font-size:13px; font-weight:600; padding:9px 16px; border-radius:9px; white-space:nowrap; }
                            .trial-warn__cta:hover { background:#9a3412; color:#fff; }
                            @media (max-width:600px){ .trial-warn{flex-wrap:wrap} .trial-warn__cta{width:100%;text-align:center} }
                        .trial-warn
                            span.material-symbols-outlined.trial-warn__ic schedule
                            .trial-warn__body
                                strong.trial-warn__title
                                    if daysLeft === 0
                                        | Votre accès premium expire aujourd'hui
                                    else
                                        | Il vous reste #{daysLeft} jour#{daysLeft > 1 ? 's' : ''} d'accès premium
                                span.trial-warn__sub
                                    | Ajoutez un moyen de paiement pour ne pas perdre l'accès à vos fonctionnalités#{trialExpiryDate ? " — expire le " + new Date(trialExpiryDate).toLocaleDateString('fr-FR') : ''}.
                            a.trial-warn__cta(href="/subscription") Voir les plans
                    block content
        +dialog()

