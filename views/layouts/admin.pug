
include ../templates/modals/dialog.pug

doctype html
html(lang="fr")
    head
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(charset="UTF-8")
        title= title || 'BranShee Admin'
        link(rel="shortcut icon", href="/images/icon.svg", type="image/x-icon")
        link(rel="stylesheet", href="/css/import.css")
        link(rel="stylesheet", href="/css/layouts/admin.css")
        //- Anti-flash : applique le thème AVANT le rendu
        script.
            (function(){try{var t=localStorage.getItem('branshee-theme');if(t==='dark')document.documentElement.setAttribute('data-theme','dark');}catch(e){}})();
        block links
    body
        div.layout
            include ../common/sidebar
            .main
                .admin-nav
                    #openMenu.flex-c
                        svg(xmlns="http://www.w3.org/2000/svg" height="22" viewBox="0 -960 960 960" width="22" fill="currentColor")
                            path(d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z")
                    h2.admin-nav__title= title || pageName || "Undefined page"
                    .admin-nav__actions
                        -
                            var navCtaMap = {
                                'Appointment':   { label: t.sidebar.new_appointment || 'New appointment', href: '/appointment/new' },
                                'History':       { label: t.sidebar.export          || 'Export',          href: '#export-history' },
                            }
                            var navCta = navCtaMap[pageName]
                            var calendarUrl = currentCompany ? ('/' + (currentCompany.slug || currentCompany._id)) : '/'
                            var calendarFullUrl = 'https://www.branshee.com' + calendarUrl
                        if pageName === 'Appointment'
                            button.sm-btn.sm-btn--ghost#shareCalendarBtn(type="button" data-url=calendarFullUrl title=t.sidebar.share_calendar || 'Share calendar')
                                svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                                    path(d="M680-80q-50 0-85-35t-35-85q0-6 3-28L282-392q-16 15-37 23.5t-45 8.5q-50 0-85-35t-35-85q0-50 35-85t85-35q24 0 45 8.5t37 23.5l281-164q-2-7-2.5-13.5T560-760q0-50 35-85t85-35q50 0 85 35t35 85q0 50-35 85t-85 35q-24 0-45-8.5T598-672L317-508q2 7 2.5 13.5t.5 14.5q0 8-.5 14.5T317-452l281 164q16-15 37-23.5t45-8.5q50 0 85 35t35 85q0 50-35 85t-85 35Z")
                                span= t.sidebar.share_calendar || 'Share'
                            a.sm-btn.sm-btn--primary(href=calendarUrl target="_blank")
                                svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                                    path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                                span= t.sidebar.new_appointment || 'New appointment'
                        else if navCta
                            a.sm-btn.sm-btn--primary(href=navCta.href)
                                svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                                    path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                                span= navCta.label
                .main-wrapper
                    block content
        +dialog()
        script(src="/js/layouts/admin.js" type="module")
        script(src="/js/theme.js")
        
        block scripts

        script.
            const COMPANY_ID = !{company ? `"${company._id}"` : "null"};
            window.__t = !{JSON.stringify(t.js)};
            (function() {
                var btn = document.getElementById('shareCalendarBtn');
                if (!btn) return;
                btn.addEventListener('click', function() {
                    var url = btn.dataset.url;
                    navigator.clipboard.writeText(url).then(function() {
                        var span = btn.querySelector('span');
                        var orig = span.textContent;
                        span.textContent = '✓ Copié !';
                        setTimeout(function() { span.textContent = orig; }, 2000);
                    });
                });
            })();



            