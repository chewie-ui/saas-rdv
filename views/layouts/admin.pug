                    script.
                        (function() {
                            var toast = document.getElementById('limitToast');
                            var closeBtn = document.getElementById('limitToastClose');
                            if (!toast || !closeBtn) return;
                            // Reste visible sur TOUTES les pages tant qu'il n'est pas fermé —
                            // une fois fermé, on s'en souvient pour le reste de la session de
                            // navigation (réapparaît à la prochaine session si toujours plein).
                            if (sessionStorage.getItem('bs_limit_toast_dismissed') === '1') {
                                toast.style.display = 'none';
                                return;
                            }
                            closeBtn.addEventListener('click', function() {
                                toast.style.display = 'none';
                                sessionStorage.setItem('bs_limit_toast_dismissed', '1');
                            });
                        })();
