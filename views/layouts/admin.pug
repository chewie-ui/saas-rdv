        script(src="/js/layouts/admin.js" type="module")
        //- Composant partagé : habille tout <select data-ds-select> (voir ds.css)
        script(src="/js/components/ds-select.js")
        script(src="/js/components/admin/guided-tour.js")
        script(src="/js/theme.js")
        script(src="/socket.io/socket.io.js")
        script.
            window.__userId = !{user ? JSON.stringify(String(user._id)) : 'null'};
            window.__companyId = !{(company || currentCompany) ? JSON.stringify(String((company || currentCompany)._id)) : 'null'};

            // ── Badge "non lu" (uniquement sur le bouton du widget flottant) ─────
            (function() {
                var widgetBadge = document.getElementById('supportWidgetBadge');
                function render(count) {
                    if (!widgetBadge) return;
                    if (count > 0) { widgetBadge.textContent = count > 99 ? '99+' : count; widgetBadge.style.display = ''; }
                    else { widgetBadge.style.display = 'none'; }
                }
                window.__refreshSupportBadge = function() {
                    fetch('/support/chat/unread-count').then(function(r) { return r.json(); }).then(function(d) { render(d.unread || 0); }).catch(function() {});
                };
                window.__refreshSupportBadge();
            })();

            // ── Connexion socket unique pour toute la page (badge + widget) ──────
            try {
                var socket = io();
                window.__supportSocket = socket;
                socket.on('connect', function() {
                    if (window.__userId) socket.emit('support:joinUser', window.__userId);
                });
                socket.on('support:newMessage', function() { window.__refreshSupportBadge(); });
                document.dispatchEvent(new Event('support:socketReady'));

                // ── Supervision : demande de l'admin ────────────────────────────
                socket.on('supervision:request', function(data) {
                    var modal = document.getElementById('__supervisionModal');
                    if (!modal) return;
                    modal.__token = data.token;
                    modal.style.display = 'flex';
                });
                // ── Supervision : admin connecté → reload pour que la barre server-rendered s'affiche ──
                socket.on('supervision:started', function() {
                    window.location.reload();
                });
                // ── Admin en supervision : rejoindre la room superadmin ──────────
                if (!{JSON.stringify(!!(isImpersonating && isImpersonating.mode === 'supervised'))}) {
                    socket.emit('support:joinAdmin');
                    socket.on('supervision:closed-by-user', function() {
                        window.location.href = '/superadmin/exit-impersonation';
                    });
                }
                // ── Supervision : terminée par l'admin ──────────────────────────
                socket.on('supervision:ended', function() {
                    var bar = document.getElementById('__supervisionBar');
                    if (bar) {
                        bar.innerHTML = '<span style="margin-right:8px">✅</span><span>La supervision est terminée.</span>';
                        setTimeout(function() { window.location.reload(); }, 2000);
                    } else {
                        // Affiche une notif brève si la barre n'est pas visible
                        var notif = document.createElement('div');
                        notif.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:99999;background:#1f2937;color:#fff;padding:12px 18px;border-radius:10px;font-size:13px;font-weight:600;box-shadow:0 4px 16px rgba(0,0,0,.2)';
                        notif.textContent = '✅ La supervision est terminée.';
                        document.body.appendChild(notif);
                        setTimeout(function() { notif.remove(); }, 3000);
                    }
                });
            } catch (e) {}

            // ── Widget de chat flottant ──────────────────────────────────────────
            (function() {
                var widget   = document.getElementById('supportWidget');
                var btn      = document.getElementById('supportWidgetBtn');
                var closeBtn = document.getElementById('supportWidgetClose');
                var panel    = document.getElementById('supportWidgetPanel');
                var box      = document.getElementById('supportWidgetMessages');
                var input    = document.getElementById('supportWidgetInput');
                var sendBtn  = document.getElementById('supportWidgetSend');
                if (!widget || !btn || !box || !input || !sendBtn) return;

                var iconChat  = widget.querySelector('.support-widget__icon--chat');
                var iconClose = widget.querySelector('.support-widget__icon--close');
                var loaded = false;
                var chatClosed = false;

                function escapeHtml(s) { return s.replace(/</g, '&lt;'); }
                function fmtTime(iso) {
                    var d = new Date(iso);
                    return d.toLocaleDateString('fr-FR', {day:'2-digit', month:'2-digit'}) + ' ' + d.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
                }
                function msgHtml(m) {
                    return '<div class="support-chat__msg support-chat__msg--' + m.sender + '">' +
                        escapeHtml(m.text) +
                        '<span class="support-chat__msg-time">' + fmtTime(m.createdAt) + '</span></div>';
                }
                function renderMessages(messages) {
                    if (!messages.length) {
                        box.innerHTML = '<div class="support-chat__empty">Aucun message pour l\'instant — posez votre question !</div>';
                        return;
                    }
                    box.innerHTML = messages.map(msgHtml).join('');
                    box.scrollTop = box.scrollHeight;
                }
                function appendMessage(m) {
                    var empty = box.querySelector('.support-chat__empty');
                    if (empty) empty.remove();
                    box.insertAdjacentHTML('beforeend', msgHtml(m));
                    box.scrollTop = box.scrollHeight;
                }
                function showHint() {
                    if (box.querySelector('.support-chat__hint')) return;
                    box.insertAdjacentHTML('beforeend', '<div class="support-chat__hint">💬 Message envoyé — on vous répond le plus vite possible !</div>');
                    box.scrollTop = box.scrollHeight;
                }

                function showClosedNotice() {
                    chatClosed = true;
                    input.disabled = true;
                    sendBtn.disabled = true;
                    if (box.querySelector('.support-chat__closed')) return;
                    box.insertAdjacentHTML('beforeend',
                        '<div class="support-chat__closed">' +
                        '<p>La conversation a été fermée par l\'administrateur.</p>' +
                        '<div class="support-chat__stars" data-rated="0">' +
                        [1,2,3,4,5].map(function(n) { return '<button type="button" class="support-chat__star" data-star="' + n + '">★</button>'; }).join('') +
                        '</div>' +
                        '<div class="support-chat__rate-thanks" style="display:none">Merci pour votre retour !</div>' +
                        '<button type="button" class="support-chat__restart">🔄 Démarrer une nouvelle conversation</button>' +
                        '</div>'
                    );
                    box.scrollTop = box.scrollHeight;
                }

                function restartChat() {
                    chatClosed = false;
                    input.disabled = false;
                    sendBtn.disabled = false;
                    loaded = false;
                    box.innerHTML = '<div class="support-chat__loading">Chargement…</div>';
                    loadMessages();
                }

                // Délégation : étoiles de notation + relance (créés dynamiquement)
                box.addEventListener('click', function(e) {
                    var star = e.target.closest('.support-chat__star');
                    if (star) {
                        var starsEl = star.parentElement;
                        var value = Number(star.dataset.star);
                        starsEl.querySelectorAll('.support-chat__star').forEach(function(s) {
                            s.classList.toggle('is-active', Number(s.dataset.star) <= value);
                        });
                        starsEl.dataset.rated = '1';
                        fetch('/support/chat/rate', {
                            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rating: value })
                        }).catch(function() {});
                        var thanks = starsEl.parentElement.querySelector('.support-chat__rate-thanks');
                        if (thanks) thanks.style.display = '';
                        return;
                    }
                    var restartBtn = e.target.closest('.support-chat__restart');
                    if (restartBtn) restartChat();
                });

                function loadMessages() {
                    fetch('/support/chat').then(function(r) { return r.json(); }).then(function(d) {
                        if (d.success) renderMessages(d.messages);
                        loaded = true;
                    }).catch(function() {
                        box.innerHTML = '<div class="support-chat__empty">Erreur de chargement.</div>';
                    });
                }

                function openWidget() {
                    widget.classList.add('is-open');
                    if (iconChat) iconChat.style.display = 'none';
                    if (iconClose) iconClose.style.display = '';
                    // On lit la conversation en l'ouvrant → plus besoin du badge.
                    var widgetBadge = document.getElementById('supportWidgetBadge');
                    if (widgetBadge) widgetBadge.style.display = 'none';
                    if (!loaded) loadMessages();
                }
                function closeWidget() {
                    widget.classList.remove('is-open');
                    if (iconChat) iconChat.style.display = '';
                    if (iconClose) iconClose.style.display = 'none';
                }
                window.openSupportChat = openWidget;

                btn.addEventListener('click', function() {
                    widget.classList.contains('is-open') ? closeWidget() : openWidget();
                });
                if (closeBtn) closeBtn.addEventListener('click', closeWidget);

                function send() {
                    if (chatClosed) return;
                    var text = input.value.trim();
                    if (!text) return;
                    sendBtn.disabled = true;
                    fetch('/support/chat', {
                        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text })
                    }).then(function(r) { return r.json(); }).then(function(d) {
                        sendBtn.disabled = false;
                        if (d.success) {
                            input.value = '';
                            appendMessage({ sender: 'user', text: text, createdAt: new Date().toISOString() });
                            showHint();
                        }
                    }).catch(function() { sendBtn.disabled = false; });
                }
                sendBtn.addEventListener('click', send);
                input.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
                });

                function bindRealtime(socket) {
                    socket.on('support:newMessage', function(payload) {
                        if (!widget.classList.contains('is-open')) return;
                        var hint = box.querySelector('.support-chat__hint');
                        if (hint) hint.remove();
                        if (payload && payload.text) appendMessage(payload);
                        else loadMessages();
                    });
                    socket.on('support:chatClosed', function() {
                        showClosedNotice();
                    });
                }
                if (window.__supportSocket) bindRealtime(window.__supportSocket);
                else document.addEventListener('support:socketReady', function() { bindRealtime(window.__supportSocket); }, { once: true });
            })();
        
        block scripts

        //- ── Modal supervision (demande de l'admin) ─────────────────────────────
        #__supervisionModal(style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:99998;align-items:center;justify-content:center;padding:16px;")
            div(style="background:#fff;border-radius:18px;padding:28px;max-width:400px;width:100%;box-shadow:0 24px 48px rgba(0,0,0,.22);")
                div(style="display:flex;align-items:center;gap:10px;margin-bottom:16px")
                    div(style="width:42px;height:42px;border-radius:50%;background:#fff7ed;border:1px solid #fed7aa;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0") 👁
                    div
                        p(style="font-size:15px;font-weight:700;color:#111;margin:0") Demande de supervision
                        p(style="font-size:12px;color:#6b7280;margin:0") BranShee Admin
                p(style="font-size:13.5px;color:#374151;line-height:1.55;margin:0 0 20px") Un administrateur BranShee demande l'accès à votre compte pour vous assister. Vous pouvez accepter ou refuser cette demande.
                div(style="display:flex;gap:8px")
                    button#__supervisionAccept(type="button" style="flex:1;padding:10px;border-radius:10px;border:none;background:#f97316;color:#fff;font-weight:700;font-size:14px;cursor:pointer;font-family:inherit") ✓ Autoriser
                    button#__supervisionDecline(type="button" style="flex:1;padding:10px;border-radius:10px;border:1px solid #e5e7eb;background:#f9fafb;color:#4b5563;font-weight:600;font-size:14px;cursor:pointer;font-family:inherit") ✕ Refuser

        //- ── Barre de supervision active (server-rendered côté client uniquement) ──
        //- isImpersonating = côté admin qui supervise → ne pas afficher la barre client
        if isBeingSupervised && !isImpersonating
            #__supervisionBar(style="position:fixed;bottom:0;left:0;right:0;z-index:99997;background:#f97316;color:#fff;padding:10px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:13px;font-weight:600;box-shadow:0 -2px 12px rgba(0,0,0,.15);")
                span 👁&nbsp; Un administrateur BranShee consulte actuellement votre compte et procède à des modifications.
                button#__supervisionCloseBtn(type="button" style="background:rgba(255,255,255,.2);border:1.5px solid rgba(255,255,255,.5);color:#fff;font-size:12px;font-weight:700;padding:5px 13px;border-radius:7px;cursor:pointer;white-space:nowrap;font-family:inherit;") Fermer la supervision ✕
        else if !isImpersonating
            #__supervisionBar(style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:99997;background:#f97316;color:#fff;padding:10px 20px;align-items:center;justify-content:space-between;gap:12px;font-size:13px;font-weight:600;box-shadow:0 -2px 12px rgba(0,0,0,.15);")

        script.
            // ── Fermeture de supervision par l'utilisateur ──────────────────────
            (function() {
                var closeBtn = document.getElementById('__supervisionCloseBtn');
                if (!closeBtn) return;
                closeBtn.addEventListener('click', function() {
                    closeBtn.disabled = true;
                    closeBtn.textContent = '⏳…';
                    fetch('/api/supervision/close', { method: 'POST' })
                        .then(function() {
                            var bar = document.getElementById('__supervisionBar');
                            if (bar) bar.innerHTML = '<span>✅ Supervision fermée.</span>';
                            setTimeout(function() { window.location.reload(); }, 1500);
                        })
                        .catch(function() { closeBtn.disabled = false; closeBtn.textContent = 'Fermer la supervision ✕'; });
                });
            })();

        script.
            // ── Supervision modal interactions ──────────────────────────────────
            (function() {
                var modal   = document.getElementById('__supervisionModal');
                var acceptBtn = document.getElementById('__supervisionAccept');
                var declineBtn = document.getElementById('__supervisionDecline');
                if (!modal || !acceptBtn || !declineBtn) return;

                function respond(action) {
                    var token = modal.__token;
                    if (!token) return;
                    modal.style.display = 'none';
                    acceptBtn.disabled = declineBtn.disabled = true;
                    fetch('/api/supervision/respond', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ token: token, action: action }),
                    }).catch(function() {});
                    acceptBtn.disabled = declineBtn.disabled = false;
                }

                acceptBtn.addEventListener('click', function() { respond('accept'); });
                declineBtn.addEventListener('click', function() { respond('decline'); });
            })();

        script.
            const COMPANY_ID = !{(company || currentCompany) ? `"${(company || currentCompany)._id}"` : "null"};
            window.__t = !{JSON.stringify(t.js)};
            (function() {
                var btn = document.getElementById('shareCalendarBtn');
                if (!btn) return;
                btn.addEventListener('click', function() {
                    var url = btn.dataset.url;
                    navigator.clipboard.writeText(url).then(function() {
                        var span = btn.querySelector('span');
                        var orig = span.textContent;
                        span.textContent = '✓ Copié !';
                        setTimeout(function() { span.textContent = orig; }, 2000);
                    });
                });
            })();

            // ── Sync Agenda popup ────────────────────────────────────────────
            (function() {
                var syncBtn     = document.getElementById('syncAgendaBtn');
                var overlay     = document.getElementById('syncPopupOverlay');
                var closeBtn    = document.getElementById('syncPopupClose');
                var feedUrlInput= document.getElementById('syncFeedUrl');
                var copyBtn     = document.getElementById('syncCopyUrl');
                var syncApple   = document.getElementById('syncApple');
                var syncOutlook = document.getElementById('syncOutlook');
                var feedUrl     = null;

                if (!syncBtn) return;

                // Charger le token feed (une fois)
                async function loadFeedUrl() {
                    if (feedUrl) return feedUrl;
                    try {
                        var res  = await fetch('/api/calendar-feed-token');
                        var data = await res.json();
                        feedUrl  = data.feedUrl;
                        return feedUrl;
                    } catch(e) { return null; }
                }

                syncBtn.addEventListener('click', async function() {
                    overlay.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                    var url = await loadFeedUrl();
                    if (!url) { feedUrlInput.placeholder = 'Erreur — rechargez la page'; return; }

                    feedUrlInput.value = url;

                    var webcalUrl = url.replace(/^https?:\/\//, 'webcal://');

                    // Apple Calendar — webcal:// ouvre directement Calendrier sur macOS/iOS
                    var ua = navigator.userAgent || '';
                    var isApple = /iPhone|iPad|iPod/i.test(ua) || (/Macintosh/i.test(ua) && !/Windows/i.test(ua));
                    if (isApple) {
                        syncApple.href = webcalUrl;
                        syncApple.removeAttribute('target');
                    } else {
                        // Sur Windows/Android : cacher Apple Calendar
                        var appleEl = syncApple.closest('.sync-opt') || syncApple;
                        appleEl.style.display = 'none';
                    }

                    // Outlook Web — abonnement via URL (Outlook.com prend webcal)
                    syncOutlook.href = 'https://outlook.live.com/calendar/0/addfromweb?url=' + encodeURIComponent(webcalUrl) + '&name=BranShee+Agenda';
                });

                // Copier l'URL
                if (copyBtn) {
                    copyBtn.addEventListener('click', function() {
                        if (!feedUrlInput.value) return;
                        navigator.clipboard.writeText(feedUrlInput.value).then(function() {
                            var origTitle = copyBtn.title;
                            copyBtn.style.color = '#16a34a';
                            copyBtn.title = 'Copié !';
                            setTimeout(function() { copyBtn.style.color = ''; copyBtn.title = origTitle; }, 2000);
                        });
                    });
                }

                function closePopup() { overlay.style.display = 'none'; document.body.style.overflow = ''; }
                if (closeBtn) closeBtn.addEventListener('click', closePopup);
                if (overlay)  overlay.addEventListener('click', function(e) { if (e.target === overlay) closePopup(); });
                document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && overlay.style.display !== 'none') closePopup(); });
            })();


        //- ── Messages du fondateur (superadmin → utilisateur) — popup centré ──
        script.
            (function() {
                if (!window.__userId) return;

                var ICONS = { info: 'ℹ️', tip: '💡', success: '✅', warning: '⚠️', security: '🔒' };
                var FROM  = { info: 'Message de BranShee', tip: 'Conseil BranShee', success: 'Bonne nouvelle', warning: 'Important', security: 'Sécurité de votre compte' };

                var queue = [];      // messages en attente d'affichage
                var shownIds = {};   // déjà vus ce chargement
                var current = null;  // overlay actuellement affiché

                function esc(s) {
                    return String(s == null ? '' : s)
                        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;');
                }
                function safeUrl(u) {
                    u = String(u || '').trim();
                    if (/^https?:\/\//i.test(u) || u.charAt(0) === '/') return u;
                    return '';
                }

                function closeCurrent(id) {
                    if (!current) return;
                    var ov = current;
                    current = null;
                    ov.style.transition = 'opacity .18s';
                    ov.style.opacity = '0';
                    setTimeout(function() { ov.remove(); showNext(); }, 180);
                    if (id) fetch('/account/my-messages/' + id + '/dismiss', { method: 'POST' }).catch(function() {});
                }

                function showNext() {
                    if (current || !queue.length) return;
                    var m = queue.shift();
                    var id = String(m._id);
                    var type = ['info','tip','success','warning','security'].indexOf(m.type) >= 0 ? m.type : 'info';
                    var url = safeUrl(m.ctaUrl);
                    var hasCta = m.ctaLabel && url;
                    var remaining = queue.length; // messages restants après celui-ci

                    var overlay = document.createElement('div');
                    overlay.className = 'am-overlay';
                    overlay.innerHTML =
                        '<div class="am-modal am-modal--' + type + '" role="dialog" aria-modal="true">' +
                            '<div class="am-modal__accent"></div>' +
                            '<button class="am-modal__close" type="button" aria-label="Fermer">' +
                                '<svg viewBox="0 -960 960 960" height="17" width="17" fill="currentColor"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>' +
                            '</button>' +
                            '<div class="am-modal__inner">' +
                                '<div class="am-modal__icon">' + (ICONS[type] || 'ℹ️') + '</div>' +
                                '<div class="am-modal__from">' + esc(FROM[type] || 'Message') + '</div>' +
                                '<div class="am-modal__title">' + esc(m.title) + '</div>' +
                                '<div class="am-modal__text">' + esc(m.body) + '</div>' +
                                '<div class="am-modal__actions">' +
                                    (hasCta ? '<a class="am-modal__cta" href="' + esc(url) + '">' + esc(m.ctaLabel) + ' →</a>' : '') +
                                    '<button class="am-modal__ok' + (hasCta ? '' : ' am-modal__ok--solo') + '" type="button">' + (remaining ? 'Suivant' : 'J\'ai compris') + '</button>' +
                                '</div>' +
                                (remaining ? '<div class="am-modal__count">' + (remaining + 1) + ' message' + (remaining ? 's' : '') + ' — ' + remaining + ' restant' + (remaining > 1 ? 's' : '') + '</div>' : '') +
                            '</div>' +
                        '</div>';

                    overlay.querySelector('.am-modal__close').addEventListener('click', function() { closeCurrent(id); });
                    overlay.querySelector('.am-modal__ok').addEventListener('click', function() { closeCurrent(id); });
                    // Clic sur le fond assombri → fermer (marque comme lu).
                    overlay.addEventListener('click', function(e) { if (e.target === overlay) closeCurrent(id); });

                    overlay.__msgId = id;
                    document.body.appendChild(overlay);
                    current = overlay;
                }

                function enqueue(messages) {
                    (messages || []).forEach(function(m) {
                        var id = String(m._id);
                        if (shownIds[id]) return;
                        shownIds[id] = true;
                        queue.push(m);
                    });
                    showNext();
                }

                function load() {
                    fetch('/account/my-messages')
                        .then(function(r) { return r.json(); })
                        .then(function(d) { enqueue(d.messages || []); })
                        .catch(function() {});
                }

                // Fermeture au clavier (Échap) sur le popup courant.
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape' && current) closeCurrent(current.__msgId);
                });

                load();
                // Rafraîchissement live via le socket partagé (émis par le superadmin).
                function hook() {
                    if (window.__supportSocket) {
                        window.__supportSocket.on('adminMessage:new', load);
                        return true;
                    }
                    return false;
                }
                if (!hook()) document.addEventListener('support:socketReady', hook);
            })();
