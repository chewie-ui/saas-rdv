include ../common/pwa

- var _title       = title || 'BranShee — Prise de rendez-vous en ligne'
- var _desc        = metaDescription || 'BranShee est la plateforme de prise de rendez-vous en ligne pour les professionnels : coaches, coiffeurs, thérapeutes, et plus encore. Agenda en ligne gratuit et simple.'
- var _ogImage     = ogImage || 'https://www.branshee.com/images/og-cover.jpg'
- var _canonical   = canonical || ('https://www.branshee.com' + (typeof reqPath !== 'undefined' ? reqPath : ''))
- var _ogType      = ogType || 'website'
- var _lang        = lang || 'fr'

doctype html
html(lang=_lang)
    head
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(charset="UTF-8")

        //- Google tag (GA4 + Google Ads)
        script(async src="https://www.googletagmanager.com/gtag/js?id=G-PZR5994GKD")
        script.
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-PZR5994GKD');
            gtag('config', 'AW-18287595473');
        include ../includes/gads-conversion
        include ../includes/clarity

        //- Primary SEO
        title= _title
        meta(name="description" content=_desc)
        meta(name="robots" content="index, follow")
        link(rel="canonical" href=_canonical)

        //- Hreflang (multilingual)
        link(rel="alternate" hreflang="fr" href=_canonical)
        link(rel="alternate" hreflang="x-default" href=_canonical)

        //- Open Graph (Facebook, LinkedIn, WhatsApp…)
        meta(property="og:type" content=_ogType)
        meta(property="og:title" content=_title)
        meta(property="og:description" content=_desc)
        meta(property="og:image" content=_ogImage)
        meta(property="og:image:width" content="1200")
        meta(property="og:image:height" content="630")
        meta(property="og:url" content=_canonical)
        meta(property="og:site_name" content="BranShee")
        meta(property="og:locale" content=(_lang === 'en' ? 'en_US' : _lang === 'nl' ? 'nl_NL' : 'fr_FR'))

        //- Twitter Card
        meta(name="twitter:card" content="summary_large_image")
        meta(name="twitter:title" content=_title)
        meta(name="twitter:description" content=_desc)
        meta(name="twitter:image" content=_ogImage)
        meta(name="twitter:site" content="@branshee")

        //- Preconnect pour la performance
        link(rel="preconnect" href="https://kit.fontawesome.com")
        link(rel="dns-prefetch" href="https://kit.fontawesome.com")
        //- Préchargement police principale pour LCP mobile
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin="")

        //- Favicons. Le `?v=` est indispensable : le logo a changé le 02/07 et
        //- Safari garde son cache d'icônes très longtemps sur une URL identique.
        //- L'incrémenter à chaque changement de logo.
        link(rel="icon" href="/images/icon.svg?v=2" type="image/svg+xml")
        link(rel="icon" href="/favicon.ico?v=2" sizes="32x32")
        link(rel="apple-touch-icon" href="/images/icon-maskable-512.png?v=3")
        link(rel="stylesheet", href="/css/import.css")
        +pwaHead()
        link(rel="stylesheet", href="/css/layouts/index.css")
        script(src="https://kit.fontawesome.com/be29c06db4.js" crossorigin="anonymous")
        //- Anti-flash : applique le thème AVANT le rendu
        script.
            (function(){try{var t=localStorage.getItem('branshee-theme');if(t==='dark')document.documentElement.setAttribute('data-theme','dark');}catch(e){}})();
        //- JSON-LD : WebSite + SearchAction (sitelinks search box) + Organization
        block jsonld
            script(type="application/ld+json").
                {
                  "@context": "https://schema.org",
                  "@type": "WebSite",
                  "name": "BranShee",
                  "url": "https://www.branshee.com",
                  "description": "Plateforme de prise de rendez-vous en ligne pour les professionnels indépendants.",
                  "potentialAction": {
                    "@type": "SearchAction",
                    "target": {
                      "@type": "EntryPoint",
                      "urlTemplate": "https://www.branshee.com/search?name={search_term_string}"
                    },
                    "query-input": "required name=search_term_string"
                  }
                }
            //- "sameAs" est volontairement vide : les deux profils qui y figuraient
            //- étaient faux (linkedin.com/company/branshee répond 404, et
            //- instagram.com/branshee est le compte personnel d'un tiers, pas la
            //- marque). Une URL morte ou étrangère dans "sameAs" décrédibilise
            //- l'entité auprès de Google — exactement le problème qu'on essaie de
            //- corriger, puisqu'il corrige déjà « branshee » en « banshee ».
            //- N'y remettre que des profils officiels réellement vérifiés.
            script(type="application/ld+json").
                {
                  "@context": "https://schema.org",
                  "@type": "Organization",
                  "name": "BranShee",
                  "legalName": "BranShee",
                  "alternateName": ["Branshee", "branshee"],
                  "brand": {
                    "@type": "Brand",
                    "name": "BranShee"
                  },
                  "slogan": "Votre agenda en ligne — simple, rapide, professionnel",
                  "url": "https://www.branshee.com",
                  "logo": {
                    "@type": "ImageObject",
                    "url": "https://www.branshee.com/images/icon.png",
                    "width": 512,
                    "height": 512,
                    "caption": "BranShee logo"
                  },
                  "image": "https://www.branshee.com/images/icon.svg",
                  "description": "BranShee est la plateforme de prise de rendez-vous en ligne pour les professionnels indépendants : coaches, coiffeurs, thérapeutes, masseurs, tatoueurs et plus encore.",
                  "foundingDate": "2024",
                  "areaServed": ["FR", "BE", "LU", "CH"],
                  "knowsAbout": ["prise de rendez-vous en ligne", "agenda professionnel", "gestion de clients", "réservation en ligne"],
                  "sameAs": []
                }

        block links
    body
    
        include ../common/topbar

        block content


        block scripts

        include ../common/footer

        script(src="/js/import.js")
        script(src="/js/theme.js")
        script(src="/js/pageview-beacon.js")

        script.
            const COMPANY_ID = !{company ? `"${company._id}"` : "null"};
            window.__t = !{JSON.stringify(t.js)};
        +pwaInstall()
