
- var _title       = title || 'BranShee — Réservation en ligne'
- var _desc        = metaDescription || 'BranShee est la plateforme de prise de rendez-vous en ligne pour les professionnels : coaches, coiffeurs, thérapeutes, et plus encore. Gérez vos réservations simplement.'
- var _ogImage     = ogImage || 'https://www.branshee.com/images/og-cover.jpg'
- var _canonical   = canonical || ('https://www.branshee.com' + (typeof reqPath !== 'undefined' ? reqPath : ''))
- var _ogType      = ogType || 'website'

doctype html
html(lang=lang || "fr")
    head
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(charset="UTF-8")

        //- Primary SEO
        title= _title
        meta(name="description" content=_desc)
        meta(name="robots" content="index, follow")
        link(rel="canonical" href=_canonical)

        //- Open Graph (Facebook, LinkedIn, WhatsApp…)
        meta(property="og:type" content=_ogType)
        meta(property="og:title" content=_title)
        meta(property="og:description" content=_desc)
        meta(property="og:image" content=_ogImage)
        meta(property="og:url" content=_canonical)
        meta(property="og:site_name" content="BranShee")
        meta(property="og:locale" content=(lang === 'en' ? 'en_US' : lang === 'nl' ? 'nl_NL' : 'fr_FR'))

        //- Twitter Card
        meta(name="twitter:card" content="summary_large_image")
        meta(name="twitter:title" content=_title)
        meta(name="twitter:description" content=_desc)
        meta(name="twitter:image" content=_ogImage)

        link(rel="shortcut icon", href="/images/icon.svg", type="image/x-icon")
        link(rel="stylesheet", href="/css/import.css")
        link(rel="stylesheet", href="/css/layouts/index.css")
        script(src="https://kit.fontawesome.com/be29c06db4.js" crossorigin="anonymous")
        //- Anti-flash : applique le thème AVANT le rendu
        script.
            (function(){try{var t=localStorage.getItem('branshee-theme');if(t==='dark')document.documentElement.setAttribute('data-theme','dark');}catch(e){}})();
        //- JSON-LD structured data (default: Organization)
        block jsonld
            script(type="application/ld+json").
                {
                  "@context": "https://schema.org",
                  "@type": "Organization",
                  "name": "BranShee",
                  "url": "https://www.branshee.com",
                  "logo": "https://www.branshee.com/images/icon.svg",
                  "description": "Plateforme de prise de rendez-vous en ligne pour les professionnels.",
                  "sameAs": []
                }

        block links
    body
    
        include ../common/topbar

        block content


        block scripts

        include ../common/footer

        script(src="/js/import.js")
        script(src="/js/theme.js")

