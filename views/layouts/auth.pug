- var _title = title || 'BranShee — Réservation en ligne'

doctype html
html(lang=lang || "fr")
    head
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(charset="UTF-8")
        title= _title
        meta(name="robots" content="noindex, nofollow")

        //- Google tag (GA4 + Google Ads)
        script(async src="https://www.googletagmanager.com/gtag/js?id=G-PZR5994GKD")
        script.
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-PZR5994GKD');
            gtag('config', 'AW-18287595473');
        include ../includes/gads-conversion
        include ../includes/clarity

        //- Favicons. Le `?v=` est indispensable : le logo a changé le 02/07 et
        //- Safari garde son cache d'icônes très longtemps sur une URL identique.
        //- L'incrémenter à chaque changement de logo.
        link(rel="icon" href="/images/icon.svg?v=2" type="image/svg+xml")
        link(rel="icon" href="/favicon.ico?v=2" sizes="32x32")
        link(rel="apple-touch-icon" href="/images/icon.png?v=2")
        link(rel="stylesheet", href="/css/import.css")
        link(rel="stylesheet", href="/css/layouts/auth.css")

        //- Anti-flash: apply theme BEFORE render
        script.
            (function(){try{var t=localStorage.getItem('branshee-theme');if(t==='dark')document.documentElement.setAttribute('data-theme','dark');}catch(e){}})();

        block links

    body.auth-body

        block content

        block scripts

        script(src="/js/import.js")
        script(src="/js/theme.js")
        script(src="/js/pageview-beacon.js")
        script.
            const COMPANY_ID = !{company ? `"${company._id}"` : "null"};
            window.__t = !{JSON.stringify(t ? t.js : {})};
