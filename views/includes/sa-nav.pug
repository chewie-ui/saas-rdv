//- Shared superadmin navigation bar
//- Expects: saPage (string) — active page key
//- Keys: 'users' | 'logs' | 'promo' | 'links' | 'boost' | 'referrals' | 'features'
nav.sa-topbar
    .sa-topbar__brand
        .sa-topbar__mark SA
        span.sa-topbar__name Superadmin
    .sa-topbar__links
        a.sa-topbar__link(href="/superadmin" class=saPage === 'users' ? 'active' : '') 👥 Utilisateurs
        a.sa-topbar__link(href="/superadmin/logs" class=saPage === 'logs' ? 'active' : '') 📊 Logs
        a.sa-topbar__link(href="/superadmin/promo-codes" class=saPage === 'promo' ? 'active' : '') 🎟 Promos
        a.sa-topbar__link(href="/superadmin/access-links" class=saPage === 'links' ? 'active' : '') 🔗 Liens
        a.sa-topbar__link(href="/superadmin/boost" class=saPage === 'boost' ? 'active' : '') ⭐ Boost
        a.sa-topbar__link(href="/superadmin/referrals" class=saPage === 'referrals' ? 'active' : '') 🎁 Parrainage
        a.sa-topbar__link(href="/superadmin/features" class=saPage === 'features' ? 'active' : '') 🚧 Pages
        a.sa-topbar__link(href="/superadmin/support-editor" class=saPage === 'support' ? 'active' : '') 📝 Support
    a.sa-topbar__logout(href="/superadmin/logout") Déconnexion
