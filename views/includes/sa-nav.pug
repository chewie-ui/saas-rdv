//- Shared superadmin navigation bar
//- Expects: saPage (string) — active page key
//- Keys: 'users' | 'logs' | 'promo' | 'links' | 'boost' | 'referrals' | 'features' | 'chat' | 'support'
nav.sa-topbar
    .sa-topbar__brand
        .sa-topbar__mark SA
        span.sa-topbar__name Superadmin
    .sa-topbar__links
        a.sa-topbar__link(href="/superadmin" class=saPage === 'users' ? 'active' : '') 👥 Utilisateurs
        a.sa-topbar__link(href="/superadmin/logs" class=saPage === 'logs' ? 'active' : '') 📊 Logs
        a.sa-topbar__link(href="/superadmin/promo-codes" class=saPage === 'promo' ? 'active' : '') 🎟 Promos
        a.sa-topbar__link(href="/superadmin/access-links" class=saPage === 'links' ? 'active' : '') 🔗 Liens
        a.sa-topbar__link(href="/superadmin/boost" class=saPage === 'boost' ? 'active' : '') ⭐ Boost
        a.sa-topbar__link(href="/superadmin/referrals" class=saPage === 'referrals' ? 'active' : '') 🎁 Parrainage
        a.sa-topbar__link(href="/superadmin/features" class=saPage === 'features' ? 'active' : '') 🚧 Pages
        a.sa-topbar__link(href="/superadmin/support-chat" class=saPage === 'chat' ? 'active' : '')
            span 💬 Chat
            span.sa-chat-badge#saChatBadge(style="display:none")
        a.sa-topbar__link(href="/superadmin/support-editor" class=saPage === 'support' ? 'active' : '') 📝 Support
    a.sa-topbar__logout(href="/superadmin/logout") Déconnexion

script(src="/socket.io/socket.io.js")
script.
    (function() {
        var badge = document.getElementById('saChatBadge');
        function refreshBadge() {
            if (!badge) return;
            fetch('/superadmin/support-chat-unread-total').then(function(r) { return r.json(); }).then(function(d) {
                var count = d.unread || 0;
                if (count > 0) { badge.textContent = count > 99 ? '99+' : count; badge.style.display = ''; }
                else { badge.style.display = 'none'; }
            }).catch(function() {});
        }
        refreshBadge();
        // Connexion socket partagée par toutes les pages superadmin
        // (window.__saSocket) — rejoint explicitement la room "superadmin".
        try {
            var socket = io();
            window.__saSocket = socket;
            socket.on('connect', function() { socket.emit('support:joinAdmin'); });
            socket.on('support:newMessage', refreshBadge);
        } catch (e) {}
    })();
