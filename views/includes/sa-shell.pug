//- Barre latérale du panel superadmin.
//- Attend : saPage — clé de la page active.
//- Clés : dashboard | users | estab | reports | logs | promo | boost
//-        referrals | links | messages | chat | support | features
aside.sa-side#saSide
    a.sa-brand(href="/superadmin")
        span.sa-brand__mark SA
        span.sa-brand__name Superadmin

    .sa-side__group
        .sa-side__label Pilotage
        a.sa-link(href="/superadmin/tableau-de-bord" class=saPage === 'dashboard' ? 'is-active' : '')
            span.material-symbols-outlined monitoring
            span Tableau de bord

    .sa-side__group
        .sa-side__label Personnes
        a.sa-link(href="/superadmin" class=saPage === 'users' ? 'is-active' : '')
            span.material-symbols-outlined group
            span Utilisateurs
        a.sa-link(href="/superadmin/establishments" class=saPage === 'estab' ? 'is-active' : '')
            span.material-symbols-outlined storefront
            span Établissements

    .sa-side__group
        .sa-side__label Modération
        a.sa-link(href="/superadmin/signalements" class=saPage === 'reports' ? 'is-active' : '')
            span.material-symbols-outlined flag
            span Signalements
            span.sa-link__badge#saReportBadge(style="display:none")
        a.sa-link(href="/superadmin/metiers" class=saPage === 'jobTitles' ? 'is-active' : '')
            span.material-symbols-outlined work
            span Métiers
        //- « history » et non « monitoring » : cette dernière est désormais
        //- celle du tableau de bord, et deux entrées au même pictogramme
        //- deviennent indiscernables du coin de l'œil.
        a.sa-link(href="/superadmin/logs" class=saPage === 'logs' ? 'is-active' : '')
            span.material-symbols-outlined history
            span Logs

    .sa-side__group
        .sa-side__label Croissance
        a.sa-link(href="/superadmin/promo-codes" class=saPage === 'promo' ? 'is-active' : '')
            span.material-symbols-outlined confirmation_number
            span Codes promo
        a.sa-link(href="/superadmin/boost" class=saPage === 'boost' ? 'is-active' : '')
            span.material-symbols-outlined trending_up
            span Boost
        a.sa-link(href="/superadmin/referrals" class=saPage === 'referrals' ? 'is-active' : '')
            span.material-symbols-outlined redeem
            span Parrainage
        a.sa-link(href="/superadmin/access-links" class=saPage === 'links' ? 'is-active' : '')
            span.material-symbols-outlined link
            span Liens d'accès

        //- Blog public : c'est un levier d'acquisition, d'où sa place ici et
        //- non dans « Communication » (qui parle aux utilisateurs déjà inscrits).
        a.sa-link(href="/superadmin/blog" class=saPage === 'blog' ? 'is-active' : '')
            span.material-symbols-outlined article
            span Blog
        a.sa-link(href="/superadmin/acquisition" class=saPage === 'acquisition' ? 'is-active' : '')
            span.material-symbols-outlined insights
            span Acquisition

    .sa-side__group
        .sa-side__label Communication
        a.sa-link(href="/superadmin/messages" class=saPage === 'messages' ? 'is-active' : '')
            span.material-symbols-outlined campaign
            span Messages
        a.sa-link(href="/superadmin/support-chat" class=saPage === 'chat' ? 'is-active' : '')
            span.material-symbols-outlined chat
            span Chat support
            span.sa-link__badge#saChatBadge(style="display:none")
        a.sa-link(href="/superadmin/support-editor" class=saPage === 'support' ? 'is-active' : '')
            span.material-symbols-outlined edit_note
            span Articles support
        a.sa-link(href="/superadmin/features" class=saPage === 'features' ? 'is-active' : '')
            span.material-symbols-outlined toggle_on
            span Pages & features

    .sa-side__foot
        a.sa-link(href="/superadmin/logout")
            span.material-symbols-outlined logout
            span Déconnexion
