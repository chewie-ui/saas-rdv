-
  var _theme = site.theme || {}
  var _sections = (site.sections || []).filter(function(s){ return s.enabled; }).sort(function(a,b){ return a.order - b.order; })
  var primaryColor = _theme.primaryColor || '#6c47d0'
  var bgColor = _theme.bgColor || '#ffffff'
  var textColor = _theme.textColor || '#0f0f1a'
  var fontFamily = _theme.fontFamily || 'Inter'
  var roundnessMap = { sharp: '4px', soft: '12px', pill: '24px' }
  var radius = roundnessMap[_theme.roundness] || '12px'
  var seoTitle = (site.seo && site.seo.title) ? site.seo.title : (company.name || 'Notre établissement')
  var seoDesc = (site.seo && site.seo.description) ? site.seo.description : 'Réservez votre rendez-vous en ligne.'
  var gFont = fontFamily.replace(/ /g, '+')
  var softColor = 'rgba(' + parseInt(primaryColor.slice(1,3),16) + ',' + parseInt(primaryColor.slice(3,5),16) + ',' + parseInt(primaryColor.slice(5,7),16) + ',.09)'
  var navSections = _sections.filter(function(s){ return ['services','booking','about','contact'].includes(s.type); })
  var _elementStylesMap = _sections.reduce(function(acc, s) {
    if (s.data && s.data.elementStyles) {
      Object.keys(s.data.elementStyles).forEach(function(field) {
        acc[s.id + ':' + field] = s.data.elementStyles[field]
      })
    }
    return acc
  }, {})
  function sectionCustomStyle(data) {
    var d = data || {}
    var parts = []
    if (d.bgColor) parts.push('background-color:' + d.bgColor)
    if (d.textColor) parts.push('color:' + d.textColor)
    if (d.sectionBgImage) {
      parts.push("background-image:url('" + d.sectionBgImage.replace(/'/g, "\\'") + "')")
      parts.push('background-size:cover')
      parts.push('background-position:center')
    }
    return parts.join(';')
  }

doctype html
html(lang="fr")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= seoTitle
    meta(name="description" content=seoDesc)
    if isPreview
      meta(name="robots" content="noindex, nofollow")
    else
      meta(name="robots" content="index, follow")
    link(rel="icon" href="/images/icon.svg" type="image/svg+xml")
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(rel="stylesheet" href=`https://fonts.googleapis.com/css2?family=${gFont}:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap`)
    link(rel="stylesheet" href="/css/public/site.css")
    style.
      :root {
        --sp: !{primaryColor};
        --sp-bg: !{bgColor};
        --sp-text: !{textColor};
        --sp-radius: !{radius};
        --sp-font: '!{fontFamily}', -apple-system, BlinkMacSystemFont, sans-serif;
        --sp-soft: !{softColor};
        --sp-border: color-mix(in srgb, !{primaryColor} 20%, #e0e0e0);
        --sp-dark: #0f0f1a;
        --sp-muted: #6b7280;
        --sp-surface: #f8f9fb;
        --sp-nav-h: 68px;
      }

  body(class=isPreview ? 'is-preview' : '' data-site-template=site.theme.siteTemplate || '1')
    if isPreview
      .site-preview-bar
        span 👁 Mode aperçu —
        a(href="/mon-site") Retour à l'éditeur

    //- ── Navigation ────────────────────────────────────────────────────────
    -
      var navIcons = {
        services:     '<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
        booking:      '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
        about:        '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
        gallery:      '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>',
        contact:      '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>',
        testimonials: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
        faq:          '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
        stats:        '<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>',
        cta:          '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.6 3.5 2 2 0 0 1 3.58 1.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
        hero:         '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>'
      }
      var navLabels = { services: 'Services', booking: 'Réserver', about: 'À propos', contact: 'Contact', gallery: 'Galerie', testimonials: 'Avis', faq: 'FAQ', stats: 'Chiffres', cta: 'Offre' }
    nav.site-nav(id="site-nav")
      .site-nav__progress#navProgress
      .site-nav__inner
        a.site-nav__logo(href="#top")
          if site.logoUrl
            img(src=site.logoUrl alt=company.name height="34")
          else
            span.site-nav__name= company.name || 'Mon établissement'
        .site-nav__links
          each s in navSections
            -
              var label = (s.data && s.data.title) ? s.data.title : (navLabels[s.type] || s.type)
              var icon = navIcons[s.type] || ''
            a.site-nav__link(href=`#${s.id}` data-spy=s.id)
              if icon
                svg.site-nav__link-icon(viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")!= icon
              span= label
        a.site-nav__cta(href="#booking") Prendre rendez-vous
        button.site-nav__burger(type="button" aria-label="Menu" id="navBurger")
          span
          span
          span

    //- ── Sections ──────────────────────────────────────────────────────────
    each section in _sections

      //- HERO
      if section.type === 'hero'
        -
          var d = section.data || {}
          var hasBg = !!(d.bgImage)
          var heroLayout = d.heroLayout || 'full'
          var heroTextAlign = d.textAlign || 'center'
          var overlayOp = d.overlayOpacity !== undefined ? parseInt(d.overlayOpacity) : 48
        section.s-hero(id=section.id class=`s-hero--${heroLayout}` style=sectionCustomStyle(d))
          if heroLayout !== 'minimal'
            if hasBg
              .s-hero__bg(style=`background-image:url('${d.bgImage}')`)
            else
              .s-hero__bg.s-hero__bg--gradient
            .s-hero__overlay(style=`background:rgba(0,0,0,${(overlayOp/100).toFixed(2)})`)
          .s-hero__content(class=heroTextAlign === 'left' ? 's-hero__content--left' : '')
            h1.s-hero__title(data-editable=isPreview ? section.id + ':title' : null)= d.title || 'Votre établissement'
            if d.subtitle
              p.s-hero__subtitle(data-editable=isPreview ? section.id + ':subtitle' : null)= d.subtitle
            .s-hero__actions
              a.s-hero__cta(href="#booking" data-editable=isPreview ? section.id + ':ctaText' : null)= d.ctaText || 'Prendre rendez-vous'
              if heroLayout !== 'minimal'
                a.s-hero__secondary(href="#about") En savoir plus

      //- SERVICES
      else if section.type === 'services'
        -
          var d = section.data || {}
          var items = services || []
        section.s-services(id=section.id style=sectionCustomStyle(d))
          .site-container
            .s-section-header
              h2.s-section-title(data-editable=isPreview ? section.id + ':title' : null)= d.title || 'Nos prestations'
              if d.subtitle
                p.s-section-sub(data-editable=isPreview ? section.id + ':subtitle' : null)= d.subtitle
            if items.length
              .s-services__grid
                each item in items
                  .s-service-card
                    if item.image
                      img.s-service-card__img(src=item.image alt=item.name loading="lazy")
                    else
                      .s-service-card__placeholder
                        svg(viewBox="0 -960 960 960" width="36" height="36" fill="currentColor")
                          path(d="M420-80v-200l-92 92-56-56 172-172 172 172-56 56-92-92v200h-48ZM160-440v-48l280-160 280 160v48H160Zm280-60ZM200-520v-200h80v154l200-114 200 114v-154h80v200L440-374 200-520Zm80 0v-56l160-90 160 90v56L440-576 280-520Z")
                    .s-service-card__body
                      h3.s-service-card__name= item.name || ''
                      if item.description
                        p.s-service-card__desc= item.description
                      .s-service-card__meta
                        if item.price
                          span.s-service-card__price= item.price + ' €'
                        if item.duration
                          span.s-service-card__duration= item.duration + ' min'
            else
              .s-services__empty Aucun service disponible pour le moment.

      //- BOOKING
      else if section.type === 'booking'
        -
          var d = section.data || {}
          var isCompactBooking = d.embedMode === 'compact'
          var bookingSrc = `/${companySlug}?embedded=1` + (isCompactBooking ? '&sections=' : '')
        section.s-booking(id=section.id class=isCompactBooking ? 's-booking--compact' : '' style=sectionCustomStyle(d))
          .site-container
            .s-section-header
              h2.s-section-title(data-editable=isPreview ? section.id + ':title' : null)= d.title || 'Réservez en ligne'
              if d.subtitle
                p.s-section-sub(data-editable=isPreview ? section.id + ':subtitle' : null)= d.subtitle
            .s-booking__frame-wrap
              iframe.s-booking__frame(
                src=bookingSrc
                title="Prise de rendez-vous"
                loading="lazy"
                allowfullscreen
              )

      //- ABOUT
      else if section.type === 'about'
        -
          var d = section.data || {}
          var hasImg = !!(d.image)
          var aboutLayout = d.layout || 'default'
          var aboutClass = !hasImg ? 's-about__inner--no-img' : (aboutLayout === 'reverse' ? 's-about__inner--reverse' : aboutLayout === 'centered' ? 's-about__inner--centered' : '')
          var aboutValues = d.values || []
        section.s-about(id=section.id style=sectionCustomStyle(d))
          .site-container
            .s-about__inner(class=aboutClass)
              if hasImg
                .s-about__img-wrap
                  img.s-about__img(src=d.image alt=d.title || 'À propos' loading="lazy")
              .s-about__text
                if d.subtitle
                  p.s-about__subtitle(data-editable=isPreview ? section.id + ':subtitle' : null)= d.subtitle
                h2.s-section-title(data-editable=isPreview ? section.id + ':title' : null)= d.title || 'À propos de nous'
                div.s-about__body(data-editable=isPreview ? section.id + ':text' : null)!= d.text || ''
                if aboutValues.length
                  .s-about__values
                    each v in aboutValues
                      .s-about__value
                        if v.icon
                          span.s-about__value-icon= v.icon
                        h4.s-about__value-title= v.title || ''
                        if v.desc
                          p.s-about__value-desc= v.desc

      //- GALLERY
      else if section.type === 'gallery'
        -
          var d = section.data || {}
          var imgs = (d.images || []).filter(function(i){ return i && i.url; })
          var galCols = d.columns || '3'
        if imgs.length || isPreview
          section.s-gallery(id=section.id style=sectionCustomStyle(d))
            .site-container
              .s-section-header
                h2.s-section-title(data-editable=isPreview ? section.id + ':title' : null)= d.title || 'Notre galerie'
              if imgs.length
                .s-gallery__grid(class=galCols !== '3' ? 's-gallery__grid--' + galCols : '')
                  each img in imgs
                    .s-gallery__item(onclick=`openLightbox('${img.url}','${(img.caption||'').replace(/'/g,"\\'")}')`)
                      img.s-gallery__img(src=img.url alt=img.caption || '' loading="lazy")
                      if img.caption
                        .s-gallery__caption= img.caption
              else
                .s-gallery__empty.s-gallery__empty--preview Ajoutez des photos dans l'éditeur.

      //- TESTIMONIALS
      else if section.type === 'testimonials'
        -
          var d = section.data || {}
          var useBranshee = d.source === 'branshee'
          var titems = useBranshee ? [] : (d.items || [])
          var bsReviews = useBranshee ? (reviews || []).slice(0, 9) : []
        if titems.length || bsReviews.length || useBranshee || isPreview
          section.s-testimonials(id=section.id style=sectionCustomStyle(d))
            .site-container
              .s-section-header
                h2.s-section-title(data-editable=isPreview ? section.id + ':title' : null)= d.title || 'Avis clients'
                if useBranshee && reviewCount > 0
                  .s-testimonials__score
                    .s-testimonial-card__stars
                      each star in [1,2,3,4,5]
                        span(class=star <= Math.round(avgRating) ? 's-star--on' : 's-star--off') ★
                    span= avgRating.toFixed(1) + ' (' + reviewCount + ' avis)'
              if useBranshee
                if bsReviews.length
                  .s-testimonials__grid
                    each r in bsReviews
                      .s-testimonial-card
                        .s-testimonial-card__stars
                          each star in [1,2,3,4,5]
                            span(class=star <= (r.rating || 5) ? 's-star--on' : 's-star--off') ★
                        p.s-testimonial-card__text= '"' + (r.comment || '') + '"'
                        .s-testimonial-card__author= r.clientName || 'Client'
                else
                  .s-testimonials__empty Aucun avis pour le moment. Soyez le premier à en laisser un !
                a.s-testimonials__cta(href=`/${companySlug}#avis`) Laisser un avis →
              else if titems.length
                .s-testimonials__grid
                  each t in titems
                    -
                      var trating = t.rating || 5
                    .s-testimonial-card
                      .s-testimonial-card__stars
                        each star in [1,2,3,4,5]
                          span(class=star <= trating ? 's-star--on' : 's-star--off') ★
                      p.s-testimonial-card__text= '"' + (t.text || '') + '"'
                      .s-testimonial-card__author= t.name || 'Client'
              else
                .s-testimonials__empty Ajoutez des avis clients dans l'éditeur.

      //- FAQ
      else if section.type === 'faq'
        -
          var d = section.data || {}
          var fitems = d.items || []
        if fitems.length || isPreview
          section.s-faq(id=section.id style=sectionCustomStyle(d))
            .site-container
              .s-section-header
                h2.s-section-title(data-editable=isPreview ? section.id + ':title' : null)= d.title || 'FAQ'
              if fitems.length
                .s-faq__list
                  each fitem in fitems
                    .s-faq__item
                      button.s-faq__q(type="button")
                        span= fitem.question
                        svg.s-faq__arrow(viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                          polyline(points="6 9 12 15 18 9")
                      .s-faq__a
                        p= fitem.answer
              else
                .s-faq__empty Ajoutez des questions dans l'éditeur.

      //- STATS
      else if section.type === 'stats'
        -
          var d = section.data || {}
          var sitems = (d.items || []).filter(function(i){ return i && (i.number || i.label); })
        if sitems.length || isPreview
          section.s-stats(id=section.id style=sectionCustomStyle(d))
            .site-container
              .s-section-header
                h2.s-section-title(data-editable=isPreview ? section.id + ':title' : null)= d.title || 'Nos chiffres clés'
              if sitems.length
                .s-stats__grid
                  each si in sitems
                    .s-stat-item
                      if si.icon
                        span.s-stat-item__icon= si.icon
                      p.s-stat-item__number= si.number || '0'
                      p.s-stat-item__label= si.label || ''
              else
                .s-stats__empty Ajoutez vos chiffres clés dans l'éditeur.

      //- CTA BANNER
      else if section.type === 'cta'
        -
          var d = section.data || {}
          var ctaBg = d.bg || 'primary'
        section.s-cta-banner(id=section.id class='s-cta-banner--' + ctaBg style=sectionCustomStyle(d))
          .s-cta-banner__inner
            h2.s-cta-banner__title(data-editable=isPreview ? section.id + ':title' : null)= d.title || 'Prêt à réserver ?'
            if d.text
              p.s-cta-banner__text(data-editable=isPreview ? section.id + ':text' : null)= d.text
            if d.buttonText
              a.s-cta-banner__btn(href=d.buttonUrl || '#booking' data-editable=isPreview ? section.id + ':buttonText' : null)= d.buttonText

      //- CONTACT
      else if section.type === 'contact'
        -
          var d = section.data || {}
        section.s-contact(id=section.id style=sectionCustomStyle(d))
          .site-container
            .s-section-header
              h2.s-section-title(style="color:#fff" data-editable=isPreview ? section.id + ':title' : null)= d.title || 'Nous contacter'
            .s-contact__body
              .s-contact__grid
                if d.phone
                  .s-contact__item
                    .s-contact__icon
                      svg(viewBox="0 -960 960 960" width="20" height="20" fill="currentColor")
                        path(d="M798-120q-125 0-247-54.5T329-329Q225-433 170.5-555T116-802q0-18 12-30t30-12h162q14 0 25 9.5t13 22.5l26 140q2 16-1 27t-11 19l-97 98q20 37 47.5 71.5T382-386q31 31 65 57.5t72 48.5l94-94q9-9 23.5-13.5T670-390l138 28q14 4 23 14.5t9 23.5v162q0 18-12 30t-30 12Z")
                    .s-contact__detail
                      span.s-contact__label Téléphone
                      a.s-contact__value(href=`tel:${d.phone}`)= d.phone
                if d.email
                  .s-contact__item
                    .s-contact__icon
                      svg(viewBox="0 -960 960 960" width="20" height="20" fill="currentColor")
                        path(d="M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h640q33 0 56.5 23.5T880-720v480q0 33-23.5 56.5T800-160H160Zm320-280L160-640v400h640v-400L480-440Zm0-80 320-200H160l320 200ZM160-640v-80 480-400Z")
                    .s-contact__detail
                      span.s-contact__label Email
                      a.s-contact__value(href=`mailto:${d.email}`)= d.email
                if d.address
                  .s-contact__item
                    .s-contact__icon
                      svg(viewBox="0 -960 960 960" width="20" height="20" fill="currentColor")
                        path(d="M480-480q33 0 56.5-23.5T560-560q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 33 23.5 56.5T480-480Zm0 294q122-112 181-203.5T720-552q0-109-69.5-178.5T480-800q-101 0-170.5 69.5T240-552q0 71 59 162.5T480-186Zm0 106Q319-217 239.5-334.5T160-552q0-150 96.5-239T480-880q127 0 223.5 89T800-552q0 100-79.5 217.5T480-80Zm0-480Z")
                    .s-contact__detail
                      span.s-contact__label Adresse
                      span.s-contact__value= d.address
              .s-cf-wrap
                h3.s-cf-title Envoyer un message
                form.s-cf-form(data-slug=site.slug)
                  .s-cf-row
                    .s-cf-field
                      label.s-cf-label Nom
                      input.s-cf-input(type="text" name="name" placeholder="Votre nom" required)
                    .s-cf-field
                      label.s-cf-label Email
                      input.s-cf-input(type="email" name="email" placeholder="votre@email.com" required)
                  .s-cf-field
                    label.s-cf-label Message
                    textarea.s-cf-input.s-cf-textarea(name="message" rows="4" placeholder="Votre message..." required)
                  button.s-cf-submit(type="submit") Envoyer
                  .s-cf-feedback.s-cf-feedback--ok(style="display:none") ✓ Message envoyé, nous vous répondrons rapidement !
                  .s-cf-feedback.s-cf-feedback--err(style="display:none") Une erreur est survenue. Veuillez réessayer.

    //- ── Lightbox ──────────────────────────────────────────────────────────
    #sp-lightbox.sp-lightbox(onclick="closeLightbox(event)")
      span.sp-lightbox__close(onclick="document.getElementById('sp-lightbox').classList.remove('open')") ✕
      img.sp-lightbox__img(id="spLightImg" src="" alt="")
      p.sp-lightbox__cap(id="spLightCap")

    //- ── Footer ────────────────────────────────────────────────────────────
    -
      var _soc = site.social || {}
      var _hasSocial = _soc.instagram || _soc.facebook || _soc.tiktok || _soc.whatsapp || _soc.linkedin || _soc.youtube
    footer.site-footer
      .site-container
        .site-footer__inner
          .site-footer__brand
            span.site-footer__name= company.name || 'Mon établissement'
            span.site-footer__copy © #{new Date().getFullYear()} — Tous droits réservés
          if _hasSocial
            .site-footer__social
              if _soc.instagram
                a.s-soc(href=_soc.instagram target="_blank" rel="noopener noreferrer" title="Instagram")
                  svg(viewBox="0 0 24 24" width="20" height="20" fill="currentColor")
                    path(d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z")
