            __elementStyles[el.dataset.editable] = Object.assign({}, styles);
          });
          window.parent.postMessage({ type: 'bk:styleElementBulk', field: field, styles: styles, sectionIds: sectionIds }, '*');
        }

        function syncPanel() {
          if (!elStyleCurrent) return;
          var st = __elementStyles[elStyleCurrent.dataset.editable] || {};
          var cs = window.getComputedStyle(elStyleCurrent);
          // Couleurs
          elPanel.querySelector('[data-prop="color"]').value = st.color || rgbToHex(cs.color) || '#000000';
          elPanel.querySelector('[data-prop="bg"]').value = st.bg || rgbToHex(cs.backgroundColor) || '#ffffff';
          // Curseurs (taille, interligne, espacement, marge)
          function setRange(prop, fallback) {
            var range = elPanel.querySelector('[data-prop="' + prop + '"]');
            if (!range) return;
            var stored = st[prop];
            var num;
            if (stored !== undefined && stored !== '') num = parseFloat(stored);
            else num = fallback;
            if (isNaN(num)) num = fallback;
            range.value = num;
            var unit = range.dataset.unit || '';
            var readout = elPanel.querySelector('[data-prop-val="' + prop + '"]');
            if (readout) readout.textContent = num + unit;
          }
          setRange('fontSize', parseInt(cs.fontSize, 10) || 16);
          setRange('lineHeight', 1.4);
          setRange('letterSpacing', parseFloat(cs.letterSpacing) || 0);
          setRange('padding', 0);
          setRange('borderRadius', parseInt(cs.borderRadius, 10) || 0);
          setRange('borderWidth', parseInt(st.borderWidth, 10) || 0);
          elPanel.querySelector('[data-prop="borderColor"]').value = st.borderColor || rgbToHex(cs.borderColor) || '#000000';
          // Épaisseur
          var weight = String(st.fontWeight || cs.fontWeight || '400');
          elPanel.querySelectorAll('[data-prop="fontWeight"] button').forEach(function(b) {
            b.classList.toggle('active', b.dataset.val === weight);
          });
          // Alignement
          var align = st.textAlign || cs.textAlign || 'left';
          if (align === 'start') align = 'left';
          elPanel.querySelectorAll('[data-prop="textAlign"] button').forEach(function(b) {
            b.classList.toggle('active', b.dataset.val === align);
          });
          // Bascules (italique, majuscules)
          elPanel.querySelectorAll('.s-el-panel__toggle').forEach(function(btn) {
            var current = st[btn.dataset.prop] || cs[btn.dataset.prop];
            btn.classList.toggle('active', current === btn.dataset.on);
          });
          // Boutons "réinitialiser cette valeur" : visibles seulement si la
          // propriété a été personnalisée sur cet élément.
          elPanel.querySelectorAll('.s-el-rst').forEach(function(b) {
            b.style.display = (st[b.dataset.resetProp] !== undefined) ? 'inline-flex' : 'none';
          });
        }

        function rgbToHex(rgb) {
          if (!rgb) return null;
          if (rgb.charAt(0) === '#') return rgb;
          var m = rgb.match(/\d+/g);
          if (!m || m.length < 3) return null;
          if (m.length >= 4 && Number(m[3]) === 0) return null; // transparent
          return '#' + m.slice(0, 3).map(function(n) { return ('0' + parseInt(n, 10).toString(16)).slice(-2); }).join('');
        }

        elStyleBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          if (!elStyleCurrent) return;
          syncPanel();
          elPanel.style.display = 'block';
          // Ancré à droite de l'aperçu, SOUS la barre "Mode aperçu" (fixe,
          // z-index élevé) qui masquait sinon le haut du panneau. top + bottom
          // fixent la hauteur → le panneau défile en interne (overflow CSS) et
          // reste toujours entièrement accessible, où que soit l'élément.
          var bar = document.querySelector('.site-preview-bar');
          var topOffset = (bar ? bar.offsetHeight : 0) + 8;
          elPanel.style.top = topOffset + 'px';
          elPanel.style.left = 'auto';
          elPanel.style.right = '10px';
          elPanel.style.bottom = '10px';
        });

        // Couleurs
        elPanel.querySelectorAll('input[type="color"]').forEach(function(input) {
          input.addEventListener('input', function() { pushStyle(input.dataset.prop, input.value); });
        });
        elPanel.querySelector('.s-el-panel__clearbg').addEventListener('click', function() {
          pushStyle('bg', 'transparent');
        });
        // Curseurs (taille, interligne, espacement, marge) — un seul gestionnaire
        elPanel.querySelectorAll('.s-el-panel__range').forEach(function(range) {
          range.addEventListener('input', function() {
            var prop = range.dataset.prop;
            var unit = range.dataset.unit || '';
            var val = range.value + unit;
            var readout = elPanel.querySelector('[data-prop-val="' + prop + '"]');
            if (readout) readout.textContent = val;
            pushStyle(prop, val);
          });
        });
        // Segments (épaisseur, alignement)
        elPanel.querySelectorAll('.s-el-panel__seg').forEach(function(seg) {
          seg.querySelectorAll('button').forEach(function(b) {
            b.addEventListener('click', function() {
              seg.querySelectorAll('button').forEach(function(x){ x.classList.remove('active'); });
              b.classList.add('active');
              pushStyle(seg.dataset.prop, b.dataset.val);
            });
          });
        });
        // Bascules (italique, majuscules)
        elPanel.querySelectorAll('.s-el-panel__toggle').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var on = !btn.classList.contains('active');
            btn.classList.toggle('active', on);
            pushStyle(btn.dataset.prop, on ? btn.dataset.on : btn.dataset.off);
          });
        });
        // Réinitialiser une propriété (petit ↺ par ligne)
        elPanel.querySelectorAll('.s-el-rst').forEach(function(b) {
          b.addEventListener('click', function(ev) {
            ev.preventDefault();
            ev.stopPropagation();
            pushReset(b.dataset.resetProp);
          });
        });
        // Appliquer à tous les éléments similaires
        elPanel.querySelector('.s-el-panel__applyall').addEventListener('click', applyToAllSimilar);
        // Réinitialiser tout (cet élément)
        elPanel.querySelector('.s-el-style-reset').addEventListener('click', function() {
          if (!elStyleCurrent) return;
          STYLE_PROPS.forEach(function(p) { applyElStyle(elStyleCurrent, p, ''); });
          delete __elementStyles[elStyleCurrent.dataset.editable];
          var parts = elStyleCurrent.dataset.editable.split(':');
          window.parent.postMessage({ type: 'bk:styleElement', sectionId: parts[0], field: parts[1], prop: 'reset', value: null }, '*');
          syncPanel();
        });

        document.addEventListener('click', function(e) {
          if (e.target.closest('.s-el-panel') || e.target.closest('.s-el-style-btn')) return;
          elPanel.style.display = 'none';
        });
      }
      // Remplacement d'image depuis l'aperçu — survolez une image (fond du
      // hero, photo "À propos"), cliquez "Changer l'image", choisissez un
      // fichier : il est uploadé puis appliqué en direct et renvoyé à l'éditeur
      // (bk:edit) qui met à jour la donnée de la section et sauvegarde.
      if (document.body.classList.contains('is-preview')) {
        var imgFileInput = document.createElement('input');
        imgFileInput.type = 'file';
        imgFileInput.accept = 'image/*';
        imgFileInput.style.display = 'none';
        document.body.appendChild(imgFileInput);
        var imgEditCurrent = null;

        document.querySelectorAll('[data-img-edit]').forEach(function(el) {
          var host = el.tagName === 'IMG' ? el.parentElement : (el.closest('section') || el.parentElement);
          if (!host) return;
          if (window.getComputedStyle(host).position === 'static') host.style.position = 'relative';
          host.classList.add('bk-img-host');
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 's-img-edit-btn';
          btn.innerHTML = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg><span>Changer l\'image</span>';
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            imgEditCurrent = el;
            el.__imgBtn = btn;
            imgFileInput.click();
          });
          host.appendChild(btn);
        });

        imgFileInput.addEventListener('change', async function() {
          var file = imgFileInput.files[0];
          if (!file || !imgEditCurrent) return;
          var el = imgEditCurrent;
          var btn = el.__imgBtn;
          var label = btn ? btn.querySelector('span') : null;
          if (label) label.textContent = 'Envoi…';
          if (btn) btn.classList.add('is-loading');
          try {
            var fd = new FormData();
            fd.append('image', file);
            var r = await fetch('/mon-site/upload-image', { method: 'POST', body: fd });
            var d = await r.json();
            if (d && d.success && d.url) {
              if (el.tagName === 'IMG') {
                el.src = d.url;
              } else {
                el.style.backgroundImage = "url('" + d.url + "')";
                el.classList.remove('s-hero__bg--gradient');
              }
              var parts = el.dataset.imgEdit.split(':');
              if (parts[1] === '__gallery') {
                // Image de galerie : mise à jour d'un élément du tableau images[]
                window.parent.postMessage({ type: 'bk:setGalleryImage', sectionId: parts[0], index: Number(el.dataset.imgIndex), url: d.url }, '*');
              } else {
                window.parent.postMessage({ type: 'bk:edit', sectionId: parts[0], field: parts[1], value: d.url }, '*');
              }
            } else {
              alert((d && d.error) || "Échec de l'envoi de l'image.");
            }
          } catch (err) {
            alert('Erreur réseau pendant l\'envoi.');
          }
          if (label) label.textContent = "Changer l'image";
          if (btn) btn.classList.remove('is-loading');
          imgFileInput.value = '';
          imgEditCurrent = null;
        });
      }
      // Contact form
      document.querySelectorAll('.s-cf-form').forEach(function(form) {
        form.addEventListener('submit', async function(e) {
          e.preventDefault();
          var btn = form.querySelector('.s-cf-submit');
          var ok  = form.querySelector('.s-cf-feedback--ok');
          var err = form.querySelector('.s-cf-feedback--err');
          ok.style.display = 'none';
          err.style.display = 'none';
          btn.disabled = true;
          btn.textContent = 'Envoi…';
          try {
            var r = await fetch('/s/' + form.dataset.slug + '/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name: form.querySelector('[name="name"]').value,
                email: form.querySelector('[name="email"]').value,
                message: form.querySelector('[name="message"]').value,
              })
            });
            var data = await r.json();
            if (data.success) { form.reset(); ok.style.display = ''; }
            else err.style.display = '';
          } catch(ex) { err.style.display = ''; }
          btn.disabled = false;
          btn.textContent = 'Envoyer';
        });
      });

      // Apparition fluide au défilement (site publié uniquement — désactivé en
      // mode aperçu pour ne pas gêner l'édition, et si l'utilisateur préfère
      // réduire les animations). Sécurisé : si ce code ne s'exécute pas, tout
      // reste visible (l'état masqué dépend de la classe js-reveal).
      (function() {
        if (document.body.classList.contains('is-preview')) return;
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var sel = '.s-section-header, .s-service-card, .s-testimonial-card, .s-stat-item, .s-about__inner, .s-gallery__item, .s-faq__item, .s-cta-banner__inner, .s-contact__item, .s-booking__frame-wrap';
        var targets = Array.prototype.slice.call(document.querySelectorAll(sel));
        if (!targets.length) return;
        document.body.classList.add('js-reveal');
        var io = new IntersectionObserver(function(entries) {
          entries.forEach(function(en) {
            if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        targets.forEach(function(el, i) {
          el.classList.add('sp-reveal');
          // léger décalage en cascade pour les grilles de cartes
          el.style.transitionDelay = (Math.min(i % 4, 3) * 60) + 'ms';
          io.observe(el);
        });
      })();
