    script.
      // Styles enregistrés par élément (couleur du texte / fond), appliqués
      // que ce soit dans l'aperçu ou sur le site publié.
      var __elementStyles = !{JSON.stringify(_elementStylesMap)};
      document.querySelectorAll('[data-editable]').forEach(function(el) {
        var st = __elementStyles[el.dataset.editable];
        if (!st) return;
        if (st.color) el.style.color = st.color;
        if (st.bg) el.style.backgroundColor = st.bg;
      });

      var nav = document.getElementById('site-nav');
      var navProgress = document.getElementById('navProgress');
      var spyLinks = Array.from(document.querySelectorAll('.site-nav__link[data-spy]'));
      var spySections = spyLinks.map(function(a){ return document.getElementById(a.dataset.spy); }).filter(Boolean);

      function updateNav() {
        var sy = window.scrollY;
        // scrolled class
        nav.classList.toggle('scrolled', sy > 60);
        // progress bar
        if (navProgress) {
          var max = document.documentElement.scrollHeight - window.innerHeight;
          navProgress.style.width = max > 0 ? (Math.min(100, sy / max * 100)).toFixed(1) + '%' : '0%';
        }
        // scroll spy
        if (spySections.length) {
          var navH = nav.offsetHeight + 20;
          var active = null;
          spySections.forEach(function(sec) {
            if (sec.getBoundingClientRect().top <= navH) active = sec.id;
          });
          spyLinks.forEach(function(a) { a.classList.toggle('active', a.dataset.spy === active); });
        }
      }
      window.addEventListener('scroll', updateNav, { passive: true });
      updateNav();
      // Mobile burger
      var burger = document.getElementById('navBurger');
      var navLinks = document.querySelector('.site-nav__links');
      if (burger && navLinks) {
        burger.addEventListener('click', function() {
          navLinks.classList.toggle('open');
        });
        // Close on link click
        navLinks.querySelectorAll('a').forEach(function(a) {
          a.addEventListener('click', function() { navLinks.classList.remove('open'); });
        });
      }
      // Auto-resize booking iframe
      window.addEventListener('message', function(e) {
        if (e.data && e.data.type === 'branshee:height') {
          var fr = document.querySelector('.s-booking__frame');
          if (fr) fr.style.height = (e.data.height + 40) + 'px';
        }
      });
      // Lightbox
      function openLightbox(src, cap) {
        var lb = document.getElementById('sp-lightbox');
        document.getElementById('spLightImg').src = src;
        document.getElementById('spLightCap').textContent = cap || '';
        lb.classList.add('open');
      }
      function closeLightbox(e) {
        if (e.target.id === 'sp-lightbox') document.getElementById('sp-lightbox').classList.remove('open');
      }
      // FAQ accordion
      document.querySelectorAll('.s-faq__q').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var item = btn.closest('.s-faq__item');
          var wasOpen = item.classList.contains('open');
          document.querySelectorAll('.s-faq__item.open').forEach(function(i){ i.classList.remove('open'); });
          if (!wasOpen) item.classList.add('open');
        });
      });
      // Section options button (preview only) — hover a section, click the gear
      // to jump to its style options (colors, background image...) in the editor.
      if (document.body.classList.contains('is-preview')) {
        document.querySelectorAll('section[id]').forEach(function(sec) {
          var optBtn = document.createElement('button');
          optBtn.type = 'button';
          optBtn.className = 's-section-opt-btn';
          optBtn.title = 'Options de cette section';
          optBtn.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>';
          optBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            window.parent.postMessage({ type: 'bk:openSection', sectionId: sec.id }, '*');
          });
          sec.appendChild(optBtn);
        });
      }
      // Inline text editing (preview only)
      if (document.body.classList.contains('is-preview')) {
        document.querySelectorAll('[data-editable]').forEach(function(el) {
          el.addEventListener('click', function(e) {
            if (el.contentEditable === 'true') return;
            e.preventDefault();
            e.stopPropagation();
            var original = el.textContent;
            el.contentEditable = 'true';
            el.focus();
            var range = document.createRange();
            range.selectNodeContents(el);
            var sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
            function commit() {
              if (el.contentEditable !== 'true') return;
              el.contentEditable = 'false';
              var parts = el.dataset.editable.split(':');
              var isRich = parts[1] === 'text';
              window.parent.postMessage({ type: 'bk:edit', sectionId: parts[0], field: parts[1], value: isRich ? el.innerHTML : el.textContent.trim() }, '*');
            }
            el.addEventListener('blur', commit, { once: true });
            el.addEventListener('keydown', function onKey(ev) {
              if (ev.key === 'Enter' && !ev.shiftKey && el.dataset.editable && el.dataset.editable.split(':')[1] !== 'text') { ev.preventDefault(); el.removeEventListener('keydown', onKey); el.blur(); }
              if (ev.key === 'Escape') { if (el.dataset.editable && el.dataset.editable.split(':')[1] === 'text') { el.innerHTML = original; } else { el.textContent = original; } el.removeEventListener('keydown', onKey); el.blur(); }
            });
          });
        });
      }
      // Per-element quick color popover (preview only) — hover a text/button,
      // click the palette icon to set its own text/background color.
      if (document.body.classList.contains('is-preview')) {
        var elStyleBtn = document.createElement('button');
        elStyleBtn.type = 'button';
        elStyleBtn.className = 's-el-style-btn';
        elStyleBtn.title = 'Couleur de cet élément';
        elStyleBtn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5"></circle><circle cx="17.5" cy="10.5" r=".5"></circle><circle cx="8.5" cy="7.5" r=".5"></circle><circle cx="6.5" cy="12.5" r=".5"></circle><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.5-.7 1.5-1.5 0-.4-.2-.8-.4-1.1-.2-.3-.4-.7-.4-1.1 0-.8.7-1.5 1.5-1.5H16c3.3 0 6-2.7 6-6 0-4.4-4.5-8-11-8Z"></path></svg>';
        elStyleBtn.style.display = 'none';
        document.body.appendChild(elStyleBtn);

        var elStylePopover = document.createElement('div');
        elStylePopover.className = 's-el-style-popover';
        elStylePopover.innerHTML =
          '<label>Texte<input type="color" data-prop="color"></label>' +
          '<label>Fond<input type="color" data-prop="bg"></label>' +
          '<button type="button" class="s-el-style-reset">Réinitialiser</button>';
        elStylePopover.style.display = 'none';
        document.body.appendChild(elStylePopover);

        var elStyleCurrent = null;

        function positionNear(target, el) {
          var r = target.getBoundingClientRect();
          el.style.top = Math.max(6, r.top - 6) + 'px';
          el.style.left = Math.min(window.innerWidth - 40, r.right + 6) + 'px';
        }

        var elStyleHideTimer = null;
        function cancelElStyleHide() { clearTimeout(elStyleHideTimer); }
        function scheduleElStyleHide() {
          clearTimeout(elStyleHideTimer);
          elStyleHideTimer = setTimeout(function() {
            if (elStylePopover.style.display === 'flex') return;
            elStyleBtn.style.display = 'none';
          }, 300);
        }

        document.querySelectorAll('[data-editable]').forEach(function(el) {
          el.addEventListener('mouseenter', function() {
            if (el.contentEditable === 'true') return;
            cancelElStyleHide();
            elStyleCurrent = el;
            positionNear(el, elStyleBtn);
            elStyleBtn.style.display = 'flex';
          });
          el.addEventListener('mouseleave', scheduleElStyleHide);
        });
        elStyleBtn.addEventListener('mouseenter', cancelElStyleHide);
        elStyleBtn.addEventListener('mouseleave', scheduleElStyleHide);

        elStyleBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          if (!elStyleCurrent) return;
          var st = __elementStyles[elStyleCurrent.dataset.editable] || {};
          elStylePopover.querySelector('[data-prop="color"]').value = st.color || '#000000';
          elStylePopover.querySelector('[data-prop="bg"]').value = st.bg || '#ffffff';
          positionNear(elStyleCurrent, elStylePopover);
          elStylePopover.style.display = 'flex';
        });

        elStylePopover.querySelectorAll('input[type="color"]').forEach(function(input) {
          input.addEventListener('input', function() {
            if (!elStyleCurrent) return;
            var prop = input.dataset.prop;
            if (prop === 'color') elStyleCurrent.style.color = input.value;
            else elStyleCurrent.style.backgroundColor = input.value;
            var parts = elStyleCurrent.dataset.editable.split(':');
            window.parent.postMessage({ type: 'bk:styleElement', sectionId: parts[0], field: parts[1], prop: prop, value: input.value }, '*');
          });
        });
        elStylePopover.querySelector('.s-el-style-reset').addEventListener('click', function() {
          if (!elStyleCurrent) return;
          elStyleCurrent.style.color = '';
          elStyleCurrent.style.backgroundColor = '';
          var parts = elStyleCurrent.dataset.editable.split(':');
          window.parent.postMessage({ type: 'bk:styleElement', sectionId: parts[0], field: parts[1], prop: 'reset', value: null }, '*');
          elStylePopover.style.display = 'none';
        });

        document.addEventListener('click', function(e) {
          if (e.target.closest('.s-el-style-popover') || e.target.closest('.s-el-style-btn')) return;
          elStylePopover.style.display = 'none';
        });
      }
      // Contact form
      document.querySelectorAll('.s-cf-form').forEach(function(form) {
        form.addEventListener('submit', async function(e) {
          e.preventDefault();
          var btn = form.querySelector('.s-cf-submit');
          var ok  = form.querySelector('.s-cf-feedback--ok');
          var err = form.querySelector('.s-cf-feedback--err');
          ok.style.display = 'none';
          err.style.display = 'none';
          btn.disabled = true;
          btn.textContent = 'Envoi…';
          try {
            var r = await fetch('/s/' + form.dataset.slug + '/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name: form.querySelector('[name="name"]').value,
                email: form.querySelector('[name="email"]').value,
                message: form.querySelector('[name="message"]').value,
              })
            });
            var data = await r.json();
            if (data.success) { form.reset(); ok.style.display = ''; }
            else err.style.display = '';
          } catch(ex) { err.style.display = ''; }
          btn.disabled = false;
          btn.textContent = 'Envoyer';
        });
      });
