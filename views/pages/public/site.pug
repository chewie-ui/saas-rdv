            var range = document.createRange();
            range.selectNodeContents(el);
            var sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
            function commit() {
              if (el.contentEditable !== 'true') return;
              el.contentEditable = 'false';
              var parts = el.dataset.editable.split(':');
              var isRich = parts[1] === 'text';
              window.parent.postMessage({ type: 'bk:edit', sectionId: parts[0], field: parts[1], value: isRich ? el.innerHTML : el.textContent.trim() }, '*');
            }
            el.addEventListener('blur', commit, { once: true });
            el.addEventListener('keydown', function onKey(ev) {
              if (ev.key === 'Enter' && !ev.shiftKey && el.dataset.editable && el.dataset.editable.split(':')[1] !== 'text') { ev.preventDefault(); el.removeEventListener('keydown', onKey); el.blur(); }
              if (ev.key === 'Escape') { if (el.dataset.editable && el.dataset.editable.split(':')[1] === 'text') { el.innerHTML = original; } else { el.textContent = original; } el.removeEventListener('keydown', onKey); el.blur(); }
            });
          });
        });
      }
      // Panneau de réglages par élément (aperçu uniquement) — survolez un
      // titre / texte / bouton, cliquez l'icône réglages pour changer sa
      // couleur, son fond, sa taille, son épaisseur, son alignement et son
      // style. Chaque changement est appliqué en direct et renvoyé à l'éditeur
      // (bk:styleElement) qui le persiste dans elementStyles.
      if (document.body.classList.contains('is-preview')) {
        var elStyleBtn = document.createElement('button');
        elStyleBtn.type = 'button';
        elStyleBtn.className = 's-el-style-btn';
        elStyleBtn.title = 'Réglages de cet élément';
        elStyleBtn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg>';
        elStyleBtn.style.display = 'none';
        document.body.appendChild(elStyleBtn);

        var elPanel = document.createElement('div');
        elPanel.className = 's-el-panel';
        // Petit bouton de réinitialisation par propriété (n'apparaît que si la
        // propriété a été modifiée — géré dans syncPanel).
        function rst(prop) {
          return '<button type="button" class="s-el-rst" data-reset-prop="' + prop + '" title="Réinitialiser cette valeur">↺</button>';
        }
        function rangeField(label, prop, unit, min, max, step) {
          return '<div class="s-el-panel__field"><span class="s-el-panel__label"><span>' + label + '</span>' +
            '<span class="s-el-panel__lr"><b data-prop-val="' + prop + '">' + min + unit + '</b>' + rst(prop) + '</span></span>' +
            '<input type="range" class="s-el-panel__range" data-prop="' + prop + '" data-unit="' + unit + '" min="' + min + '" max="' + max + '" step="' + step + '"></div>';
        }
        function segField(label, prop, buttons) {
          return '<div class="s-el-panel__field"><span class="s-el-panel__label"><span>' + label + '</span>' + rst(prop) + '</span>' +
            '<div class="s-el-panel__seg" data-prop="' + prop + '">' + buttons + '</div></div>';
        }
        elPanel.innerHTML =
          '<div class="s-el-panel__row">' +
            '<label class="s-el-panel__color">Texte<input type="color" data-prop="color">' + rst('color') + '</label>' +
            '<label class="s-el-panel__color">Fond<input type="color" data-prop="bg"><button type="button" class="s-el-panel__clearbg" title="Fond transparent">✕</button>' + rst('bg') + '</label>' +
          '</div>' +
          rangeField('Taille', 'fontSize', 'px', 11, 80, 1) +
          segField('Épaisseur', 'fontWeight',
            '<button type="button" data-val="400">Normal</button><button type="button" data-val="600">Semi</button><button type="button" data-val="800">Gras</button>') +
          segField('Alignement', 'textAlign',
            '<button type="button" data-val="left" title="Gauche">⬅</button><button type="button" data-val="center" title="Centre">⬍</button><button type="button" data-val="right" title="Droite">➡</button>') +
          rangeField('Interligne', 'lineHeight', '', 1, 2.4, 0.05) +
          rangeField('Espacement', 'letterSpacing', 'px', -2, 8, 0.5) +
          rangeField('Marge intérieure', 'padding', 'px', 0, 48, 2) +
          '<div class="s-el-panel__field s-el-panel__field--inline"><span class="s-el-panel__label"><span>Style</span></span>' +
            '<div class="s-el-panel__toggles">' +
              '<button type="button" class="s-el-panel__toggle" data-prop="fontStyle" data-on="italic" data-off="normal" title="Italique"><i>I</i></button>' +
              '<button type="button" class="s-el-panel__toggle" data-prop="textTransform" data-on="uppercase" data-off="none" title="Majuscules"><b style="font-style:normal;font-size:11px">AA</b></button>' +
            '</div></div>' +
          '<div class="s-el-panel__sep">Bordure</div>' +
          rangeField('Arrondi', 'borderRadius', 'px', 0, 40, 1) +
          rangeField('Épaisseur', 'borderWidth', 'px', 0, 8, 1) +
          '<div class="s-el-panel__row"><label class="s-el-panel__color">Couleur<input type="color" data-prop="borderColor">' + rst('borderColor') + '</label></div>' +
          '<button type="button" class="s-el-panel__applyall"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Appliquer à tous les éléments similaires</span></button>' +
          '<button type="button" class="s-el-style-reset">Tout réinitialiser</button>';
        elPanel.style.display = 'none';
        document.body.appendChild(elPanel);

        var elStyleCurrent = null;

        function positionNear(target, el, isPanel) {
