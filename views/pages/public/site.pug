    script.
      // Styles enregistrés par élément (couleur, fond, taille, épaisseur,
      // alignement, style), appliqués aussi bien dans l'aperçu que sur le
      // site publié. Un seul point d'application (applyElStyle) réutilisé au
      // chargement ET en direct quand on modifie dans le panneau de réglages.
      var __elementStyles = !{JSON.stringify(_elementStylesMap)};
      function applyElStyle(el, prop, value) {
        if (!el) return;
        var v = (value === null || value === undefined) ? '' : value;
        switch (prop) {
          case 'color':         el.style.color = v; break;
          case 'bg':            el.style.backgroundColor = v; break;
          case 'fontSize':      el.style.fontSize = v; break;
          case 'fontWeight':    el.style.fontWeight = v; break;
          case 'textAlign':     el.style.textAlign = v; break;
          case 'fontStyle':     el.style.fontStyle = v; break;
          case 'letterSpacing': el.style.letterSpacing = v; break;
          case 'lineHeight':    el.style.lineHeight = v; break;
          case 'textTransform': el.style.textTransform = v; break;
          case 'padding':       el.style.padding = v; break;
          case 'borderRadius':  el.style.borderRadius = v; break;
          case 'borderWidth':   el.style.borderWidth = v; el.style.borderStyle = (v && v !== '0px') ? 'solid' : ''; break;
          case 'borderColor':   el.style.borderColor = v; break;
        }
      }
      document.querySelectorAll('[data-editable]').forEach(function(el) {
        var st = __elementStyles[el.dataset.editable];
        if (!st) return;
        Object.keys(st).forEach(function(prop) { applyElStyle(el, prop, st[prop]); });
      });

      var nav = document.getElementById('site-nav');
      var navProgress = document.getElementById('navProgress');
      var spyLinks = Array.from(document.querySelectorAll('.site-nav__link[data-spy]'));
      var spySections = spyLinks.map(function(a){ return document.getElementById(a.dataset.spy); }).filter(Boolean);

      function updateNav() {
        var sy = window.scrollY;
        // scrolled class
        nav.classList.toggle('scrolled', sy > 60);
        // progress bar
        if (navProgress) {
          var max = document.documentElement.scrollHeight - window.innerHeight;
          navProgress.style.width = max > 0 ? (Math.min(100, sy / max * 100)).toFixed(1) + '%' : '0%';
        }
        // scroll spy
        if (spySections.length) {
          var navH = nav.offsetHeight + 20;
          var active = null;
          spySections.forEach(function(sec) {
            if (sec.getBoundingClientRect().top <= navH) active = sec.id;
          });
          spyLinks.forEach(function(a) { a.classList.toggle('active', a.dataset.spy === active); });
        }
      }
      window.addEventListener('scroll', updateNav, { passive: true });
      updateNav();
      // Mobile burger
      var burger = document.getElementById('navBurger');
      var navLinks = document.querySelector('.site-nav__links');
      if (burger && navLinks) {
        burger.addEventListener('click', function() {
          navLinks.classList.toggle('open');
        });
        // Close on link click
        navLinks.querySelectorAll('a').forEach(function(a) {
          a.addEventListener('click', function() { navLinks.classList.remove('open'); });
        });
      }
      // Auto-resize booking iframe
      window.addEventListener('message', function(e) {
        if (e.data && e.data.type === 'branshee:height') {
          var fr = document.querySelector('.s-booking__frame');
          if (fr) fr.style.height = (e.data.height + 40) + 'px';
        }
      });
      // Lightbox
      function openLightbox(src, cap) {
        var lb = document.getElementById('sp-lightbox');
        document.getElementById('spLightImg').src = src;
        document.getElementById('spLightCap').textContent = cap || '';
        lb.classList.add('open');
      }
      function closeLightbox(e) {
        if (e.target.id === 'sp-lightbox') document.getElementById('sp-lightbox').classList.remove('open');
      }
      // FAQ accordion
      document.querySelectorAll('.s-faq__q').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var item = btn.closest('.s-faq__item');
          var wasOpen = item.classList.contains('open');
          document.querySelectorAll('.s-faq__item.open').forEach(function(i){ i.classList.remove('open'); });
          if (!wasOpen) item.classList.add('open');
        });
      });
      // Section options button (preview only) — hover a section, click the gear
      // to jump to its style options (colors, background image...) in the editor.
      if (document.body.classList.contains('is-preview')) {
        document.querySelectorAll('section[id]').forEach(function(sec) {
          var optBtn = document.createElement('button');
          optBtn.type = 'button';
          optBtn.className = 's-section-opt-btn';
          optBtn.title = 'Options de cette section';
          optBtn.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>';
          optBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            window.parent.postMessage({ type: 'bk:openSection', sectionId: sec.id }, '*');
          });
          sec.appendChild(optBtn);
        });
      }
      // Inline text editing (preview only)
      if (document.body.classList.contains('is-preview')) {
        document.querySelectorAll('[data-editable]').forEach(function(el) {
          el.addEventListener('click', function(e) {
            if (el.contentEditable === 'true') return;
            e.preventDefault();
            e.stopPropagation();
            var original = el.textContent;
            el.contentEditable = 'true';
