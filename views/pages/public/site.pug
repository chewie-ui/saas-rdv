              if _soc.linkedin
                a.s-soc(href=_soc.linkedin target="_blank" rel="noopener noreferrer" title="LinkedIn")
                  svg(viewBox="0 0 24 24" width="20" height="20" fill="currentColor")
                    path(d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z")
              if _soc.youtube
                a.s-soc(href=_soc.youtube target="_blank" rel="noopener noreferrer" title="YouTube")
                  svg(viewBox="0 0 24 24" width="20" height="20" fill="currentColor")
                    path(d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z")
          a.site-footer__powered(href="https://www.branshee.com" target="_blank" rel="noopener noreferrer")
            | Propulsé par&nbsp;
            strong BranShee

    script.
      var nav = document.getElementById('site-nav');
      window.addEventListener('scroll', function() {
        nav.classList.toggle('scrolled', window.scrollY > 60);
      }, { passive: true });
      // Init scrolled if not at top
      if (window.scrollY > 60) nav.classList.add('scrolled');
      // Mobile burger
      var burger = document.getElementById('navBurger');
      var navLinks = document.querySelector('.site-nav__links');
      if (burger && navLinks) {
        burger.addEventListener('click', function() {
          navLinks.classList.toggle('open');
        });
        // Close on link click
        navLinks.querySelectorAll('a').forEach(function(a) {
          a.addEventListener('click', function() { navLinks.classList.remove('open'); });
        });
      }
      // Auto-resize booking iframe
      window.addEventListener('message', function(e) {
        if (e.data && e.data.type === 'branshee:height') {
          var fr = document.querySelector('.s-booking__frame');
          if (fr) fr.style.height = (e.data.height + 40) + 'px';
        }
      });
      // Lightbox
      function openLightbox(src, cap) {
        var lb = document.getElementById('sp-lightbox');
        document.getElementById('spLightImg').src = src;
        document.getElementById('spLightCap').textContent = cap || '';
        lb.classList.add('open');
      }
      function closeLightbox(e) {
        if (e.target.id === 'sp-lightbox') document.getElementById('sp-lightbox').classList.remove('open');
      }
      // FAQ accordion
      document.querySelectorAll('.s-faq__q').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var item = btn.closest('.s-faq__item');
          var wasOpen = item.classList.contains('open');
          document.querySelectorAll('.s-faq__item.open').forEach(function(i){ i.classList.remove('open'); });
          if (!wasOpen) item.classList.add('open');
        });
      });
      // Contact form
      document.querySelectorAll('.s-cf-form').forEach(function(form) {
        form.addEventListener('submit', async function(e) {
          e.preventDefault();
          var btn = form.querySelector('.s-cf-submit');
          var ok  = form.querySelector('.s-cf-feedback--ok');
          var err = form.querySelector('.s-cf-feedback--err');
          ok.style.display = 'none';
          err.style.display = 'none';
          btn.disabled = true;
          btn.textContent = 'Envoi…';
          try {
            var r = await fetch('/s/' + form.dataset.slug + '/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name: form.querySelector('[name="name"]').value,
                email: form.querySelector('[name="email"]').value,
                message: form.querySelector('[name="message"]').value,
              })
            });
            var data = await r.json();
            if (data.success) { form.reset(); ok.style.display = ''; }
            else err.style.display = '';
          } catch(ex) { err.style.display = ''; }
          btn.disabled = false;
          btn.textContent = 'Envoyer';
        });
      });
