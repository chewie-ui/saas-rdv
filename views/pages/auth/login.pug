extends ../../layouts/auth

block content
    .auth-split

        //- ── Left: brand art panel ─────────────────────────────────
        .auth-art
            a.auth-art__logo(href="/")
                img.auth-art__logo-mark(src="/images/icon.svg" alt="BranShee")
                span BranShee

            .auth-art__body
                .auth-art__headline Run your bookings on autopilot. Spend more time on your clients.
                .auth-art__stats
                    .auth-art__stat
                        //- Le caractère « < » doit être échappé : du texte brut commençant
                        //- par « < » produit du HTML invalide (<div>< 10 min</div>), que le
                        //- navigateur interprète mal et affiche en double / sans style.
                        .auth-art__stat-num= '< 10 min'
                        .auth-art__stat-label to go live
                    .auth-art__stat
                        .auth-art__stat-num 0 call
                        .auth-art__stat-label needed to book
                    .auth-art__stat
                        .auth-art__stat-num 24/7
                        .auth-art__stat-label automatic bookings

            .auth-art__foot © BranShee · Brussels

        //- ── Right: form panel ─────────────────────────────────────
        .auth-form-panel
            .auth-form-inner
                h1= t.auth.login_title
                p.auth-sub= t.auth.login_desc

                .auth-error#loginError(style=error ? '' : 'display:none')
                    if error === t.auth.error_invalid_credentials
                        = error
                        br
                        span= t.auth.no_account + ' '
                        a(href="/register")= t.auth.register_link
                    else
                        = error || ''

                //- Google SSO
                a.auth-social-btn(href="/auth/google")
                    svg(width="16" height="16" viewBox="0 0 48 48")
                        path(fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8a12 12 0 1 1 0-24c3.1 0 5.8 1.2 7.9 3l5.7-5.7A20 20 0 1 0 24 44c11 0 20-9 20-20 0-1.3-.1-2.6-.4-3.9z")
                        path(fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3l5.7-5.7A20 20 0 0 0 6.3 14.7z")
                        path(fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2A12 12 0 0 1 12.7 28L6.2 33A20 20 0 0 0 24 44z")
                        path(fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z")
                    span Continuer avec Google

                .auth-divider-row
                    hr
                    span OR
                    hr

                form(action="/login" method="POST" novalidate)
                    .auth-field
                        label.auth-label= t.auth.email
                        input.auth-input(
                            type="email"
                            name="email"
                            placeholder="you@studio.com"
                            autocomplete="email"
                            required
                        )

                    .auth-field
                        .auth-label-row
                            label.auth-label= t.auth.password
                            a(href="/forgot-password")= t.auth.forgot_link
                        input.auth-input(
                            type="password"
                            name="password"
                            placeholder="••••••••"
                            autocomplete="current-password"
                            required
                        )

                    button.sm-btn.sm-btn--full.sm-btn--primary(type="submit")
                        span= t.auth.login_btn

                .auth-bottom-link
                    = t.auth.no_account + ' '
                    a(href="/register")= t.auth.register_link

block scripts
    script(src="/js/components/topbar.js")
    script.
        (function() {
            var form      = document.querySelector('form[action="/login"]');
            var errBox    = document.getElementById('loginError');
            var emailInput = form ? form.querySelector('input[name="email"]') : null;
            var submitBtn = form ? form.querySelector('button[type="submit"]') : null;

            function showError(msg, el) {
                if (errBox) {
                    errBox.textContent = msg;
                    errBox.style.display = 'block';
                    errBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
                if (el) { el.classList.add('auth-input--error'); el.focus(); }
            }

            // Email/mot de passe incorrect couvre aussi bien "mauvais mot de
            // passe" que "ce compte n'existe pas" (volontairement, pour ne
            // pas révéler quels emails sont inscrits) — mais un visiteur qui
            // n'a simplement pas encore de compte doit comprendre que c'est
            // ça le problème, pas juste réessayer son mot de passe en boucle.
            function showCredentialsError(msg) {
                if (!errBox) return;
                errBox.innerHTML = '';
                errBox.appendChild(document.createTextNode(msg));
                errBox.appendChild(document.createElement('br'));
                var hint = document.createElement('span');
                hint.textContent = !{JSON.stringify(t.auth.no_account)} + ' ';
                var link = document.createElement('a');
                link.href = '/register';
                link.textContent = !{JSON.stringify(t.auth.register_link)};
                hint.appendChild(link);
                errBox.appendChild(hint);
                errBox.style.display = 'block';
                errBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            if (form && submitBtn) {
                var origLabel = submitBtn.querySelector('span') ? submitBtn.querySelector('span').textContent : submitBtn.textContent;

                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    if (errBox) errBox.style.display = 'none';
                    if (emailInput) emailInput.classList.remove('auth-input--error');

                    var email = emailInput ? emailInput.value.trim() : '';
                    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                        showError(!{JSON.stringify(t.auth.error_invalid_email)}, emailInput);
                        return;
                    }

                    submitBtn.disabled = true;
                    var span = submitBtn.querySelector('span');
                    if (span) span.textContent = '…'; else submitBtn.textContent = '…';

                    fetch('/login', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'fetch'
                        },
                        body: new URLSearchParams(new FormData(form)).toString()
                    })
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (data.success) {
                            window.location.href = data.redirect || '/appointment';
                        } else if (data.error === !{JSON.stringify(t.auth.error_invalid_credentials || "Email ou mot de passe incorrect.")}) {
                            showCredentialsError(data.error);
                            submitBtn.disabled = false;
                            if (span) span.textContent = origLabel; else submitBtn.textContent = origLabel;
                        } else {
                            showError(data.error || 'Une erreur est survenue.');
                            submitBtn.disabled = false;
                            if (span) span.textContent = origLabel; else submitBtn.textContent = origLabel;
                        }
                    })
                    .catch(function() {
                        showError('Erreur réseau. Veuillez réessayer.');
                        submitBtn.disabled = false;
                        if (span) span.textContent = origLabel; else submitBtn.textContent = origLabel;
                    });
                });
            }
        })();
