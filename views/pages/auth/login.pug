extends ../../layouts/index

block links 
    link(rel="stylesheet", href="/css/components/index/auth.index.css")
block content
    .content-wrapper
        .auth-wrapper
            .auth-image       
                img(src='/images/auth-bg.png' alt="Men writing on computer")
                .image-content
            .auth-form.flex
                .auth-form__container
                    .form-body.flex.col
                        .form-title.flex.col
                            h1= t.auth.login_title
                            p= t.auth.login_desc
                        form.form-fields.flex.col(action="/login" method="POST")
                            .field-container.flex.col
                                p= t.auth.email
                                input.input(placeholder="Email" type="text" name="email")
                            .field-container.flex.col
                                p= t.auth.password
                                input.input(placeholder="**************" type="password" name="password")
                                a(href="/forgot-password")= t.auth.forgot_link
                            button(type="submit")
                                span= t.auth.login_btn
                        .no-acc.flex= t.auth.no_account
                            a(href="/register")= t.auth.register_link
                        if error
                            p.xs-comment.error= error
block scripts       
    script(src="/js/components/topbar.js")
