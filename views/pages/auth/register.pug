extends ../../layouts/auth

block links
    link(rel="stylesheet", href="/css/layouts/auth-register.css")
    style.
        /* ── Wizard steps ─────────────────────────────────────────── */
        .reg-step { display:none; }
        .reg-step.active { display:block; }

        /* ── Progress bar ─────────────────────────────────────────── */
        .reg-progress { display:flex; align-items:center; gap:0; margin-bottom:28px; }
        .reg-progress__step { display:flex; align-items:center; gap:8px; flex:1; }
        .reg-progress__dot {
            width:28px; height:28px; border-radius:50%;
            border:2px solid #e5e7eb; background:#fff;
            font-size:12px; font-weight:700; color:#9ca3af;
            display:flex; align-items:center; justify-content:center;
            flex-shrink:0; transition:all .2s;
        }
        .reg-progress__dot.done { background:#15803d; border-color:#15803d; color:#fff; }
        .reg-progress__dot.current { background:#fff; border-color:#15803d; color:#15803d; }
        .reg-progress__label { font-size:12px; font-weight:500; color:#9ca3af; transition:color .2s; white-space:nowrap; }
        .reg-progress__label.current { color:#15803d; font-weight:600; }
        .reg-progress__label.done { color:#374151; }
        .reg-progress__line { flex:1; height:2px; background:#e5e7eb; margin:0 8px; transition:background .2s; }
        .reg-progress__line.done { background:#15803d; }

        /* Sur mobile, 4 labels en nowrap ne tiennent pas dans la largeur —
           ça faisait déborder toute la page horizontalement. On ne garde que
           le label de l'étape en cours, plus compact. */
        @media (max-width:480px) {
            .reg-progress__label { display:none; }
            .reg-progress__label.current { display:inline; font-size:11.5px; }
            .reg-progress__dot { width:24px; height:24px; font-size:11px; }
            .reg-progress__line { margin:0 4px; }
        }

        /* ── Nav buttons ──────────────────────────────────────────── */
        .reg-nav { display:flex; gap:10px; margin-top:4px; }
        .reg-back { flex:0 0 auto; background:none; border:1.5px solid #e5e7eb; border-radius:9px; padding:0 16px; height:38px; font-size:14px; font-weight:600; color:#6b7280; cursor:pointer; transition:border-color .15s,color .15s; }
        .reg-back:hover { border-color:#374151; color:#374151; }
        .reg-next { flex:1; }

        /* ── Misc ─────────────────────────────────────────────────── */
        .auth-ref-row { position:relative; display:flex; align-items:center; gap:8px; }
        .auth-ref-row .auth-input { flex:1; }
        .auth-ref-status { font-size:12px; font-weight:600; white-space:nowrap; flex-shrink:0; }
        .auth-ref-status.ok  { color:var(--accent,#16a34a); }
        .auth-ref-status.err { color:#dc2626; }
        .pwd-rules { display:flex; flex-direction:column; gap:4px; margin-top:8px; padding:10px 12px; background:var(--surface,#f5f4f1); border-radius:8px; }
        .pwd-rule { display:flex; align-items:center; gap:7px; font-size:12.5px; color:var(--text-muted,#6b7280); transition:color .15s; }
        .pwd-rule__dot { font-size:10px; }
        .pwd-rule.ok { color:var(--accent,#16a34a); font-weight:600; }
        .pwd-rule.bad { color:#dc2626; }
        .auth-pwd-wrap { position:relative; display:flex; align-items:center; }
        .auth-pwd-wrap .auth-input { flex:1; padding-right:40px; }
        .auth-pwd-toggle { position:absolute; right:10px; background:none; border:none; cursor:pointer; color:var(--text-muted,#9ca3af); padding:4px; display:flex; align-items:center; transition:color .15s; border-radius:4px; }
        .auth-pwd-toggle:hover { color:var(--text-primary,#111); }
        .auth-label-opt { color:var(--text-muted,#9ca3af); font-weight:400; font-size:12px; }
        .auth-plan-badge { display:inline-flex; align-items:center; gap:7px; background:#f0fdf4; border:1.5px solid #bbf7d0; border-radius:10px; padding:9px 14px; font-size:13px; font-weight:700; color:#15803d; margin-bottom:8px; width:100%; box-sizing:border-box; }
        .auth-plan-badge svg { stroke:#15803d; flex-shrink:0; }
        .auth-promo-badge { display:inline-flex; align-items:center; gap:6px; background:#fffbeb; border:1.5px solid #fde68a; border-radius:10px; padding:7px 13px; font-size:12.5px; font-weight:600; color:#92400e; margin-bottom:14px; width:100%; box-sizing:border-box; }
        .auth-promo-badge svg { stroke:#d97706; flex-shrink:0; }
        .auth-promo-badge strong { color:#b45309; }
        .reg-step-title { font-size:15px; font-weight:600; color:#374151; margin:0 0 18px; }
        .reg-substep-title { display:flex; align-items:center; gap:12px; }
        .reg-substep-title .reg-back { margin:0; }

        /* ── Étape 0 : intention ──────────────────────────────────── */
        .intent-grid { display:flex; flex-direction:column; gap:10px; margin-bottom:18px; }
        .intent-card {
            display:flex; align-items:center; gap:12px;
            border:1.5px solid #e5e7eb; border-radius:12px; padding:14px 16px;
            cursor:pointer; transition:border-color .15s, background .15s;
        }
        .intent-card:hover { border-color:#bbf7d0; background:#f8fdfa; }
        .intent-card input[type="radio"] { accent-color:var(--accent,#16a34a); width:17px; height:17px; flex-shrink:0; }
        .intent-card__body { display:flex; flex-direction:column; gap:2px; }
        .intent-card__label { font-size:14px; font-weight:600; color:#1f2937; }
        .intent-card__sub { font-size:12.5px; color:#6b7280; }
        .intent-card.is-selected { border-color:#15803d; background:#f0fdf4; }

block content
    .auth-split

        //- ── Panneau gauche décoratif ───────────────────────────────
        .auth-art
            a.auth-art__logo(href="/")
                img.auth-art__logo-mark(src="/images/icon.svg" alt="BranShee")
                span BranShee

            .auth-art__body
                .auth-art__headline
                    | Votre agenda en ligne,&nbsp;
                    br
                    | prêt en 5 minutes.
                .auth-art__stats
                    .auth-art__stat
                        .auth-art__stat-num 0 appel
                        .auth-art__stat-label pour réserver
                    .auth-art__stat
                        .auth-art__stat-num 24/7
                        .auth-art__stat-label réservations auto
                    .auth-art__stat
                        .auth-art__stat-num Gratuit
                        .auth-art__stat-label pour commencer

            .auth-art__foot © BranShee · Bruxelles

        //- ── Panneau droit : formulaire ────────────────────────────
        .auth-form-panel
            .auth-form-inner
                h1#regTitle= t.auth.register_title || 'Créez votre compte'
                p.auth-sub#regDesc= t.auth.register_desc || 'Pour gérer votre établissement ou pour réserver vos rendez-vous — un seul compte BranShee.'

                //- Barre de progression
                .reg-progress#regProgress
                    .reg-progress__step
                        .reg-progress__dot.current#dot0 1
                        span.reg-progress__label.current#lbl0 Intention
                    .reg-progress__line#line0
                    .reg-progress__step
                        .reg-progress__dot#dot1 2
                        span.reg-progress__label#lbl1 Profil
                    .reg-progress__line#line1
                    .reg-progress__step
                        .reg-progress__dot#dot2 3
                        span.reg-progress__label#lbl2 Mot de passe
                    .reg-progress__line#line2
                    .reg-progress__step
                        .reg-progress__dot#dot3 4
                        span.reg-progress__label#lbl3 Finaliser

                .auth-error#registerError(style="display:none")

                //- Formulaire (tout dans un seul form, soumis à l'étape 3)
                form.auth-register-form#registerForm(action="/register" method="POST")

                    //- ══ ÉTAPE 0 : Intention ═══════════════════════════════
                    .reg-step.active#step0
                        input(type="hidden" name="accountIntent" id="accountIntentInput")
                        input(type="hidden" name="proMode" id="proModeInput")
                        input(type="hidden" name="joinCompanyId" id="joinCompanyIdInput")

                        //- ── Sous-vue A : choix principal ───────────────
                        #intentMain
                            #intentGrid.intent-grid
                                label.intent-card(data-intent="pro")
                                    input(type="radio" name="accountIntentRadio" value="pro")
                                    .intent-card__body
                                        span.intent-card__label Gérer mon établissement
                                        span.intent-card__sub Coiffeur, coach, thérapeute... vous recevez des clients
                                label.intent-card(data-intent="client")
                                    input(type="radio" name="accountIntentRadio" value="client")
                                    .intent-card__body
                                        span.intent-card__label Prendre des rendez-vous
                                        span.intent-card__sub Vous réservez chez des professionnels
                                label.intent-card(data-intent="undecided")
                                    input(type="radio" name="accountIntentRadio" value="undecided")
                                    .intent-card__body
                                        span.intent-card__label Je ne sais pas encore
                                        span.intent-card__sub Vous pourrez choisir plus tard

                            .reg-nav
                                button.sm-btn.sm-btn--primary.sm-btn--full.reg-next(type="button" id="next0" disabled) Continuer →

                        //- ── Sous-vue B : créer ou rejoindre un établissement ──
                        #intentProMode(style="display:none")
                            .reg-step-title.reg-substep-title
                                button.reg-back(type="button" id="backProMode") ←
                                span Comment souhaitez-vous gérer votre établissement ?

                            #proModeGrid.intent-grid
                                label.intent-card(data-promode="create")
                                    input(type="radio" name="proModeRadio" value="create")
                                    .intent-card__body
                                        span.intent-card__label Créer mon établissement
                                        span.intent-card__sub Vous êtes le seul ou le premier compte de l'équipe
                                label.intent-card(data-promode="join")
                                    input(type="radio" name="proModeRadio" value="join")
                                    .intent-card__body
                                        span.intent-card__label Rejoindre un établissement
                                        span.intent-card__sub Une équipe existe déjà sur BranShee (plan Business)

                            .reg-nav
                                button.sm-btn.sm-btn--primary.sm-btn--full.reg-next(type="button" id="next0b" disabled) Continuer →

                    //- ══ ÉTAPE 1 : Profil ══════════════════════════════════
                    .reg-step#step1

                        //- Google SSO uniquement à l'étape 1
                        a.auth-social-btn#googleSsoBtn(href="/auth/google")
                            svg(width="16" height="16" viewBox="0 0 48 48")
                                path(fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8a12 12 0 1 1 0-24c3.1 0 5.8 1.2 7.9 3l5.7-5.7A20 20 0 1 0 24 44c11 0 20-9 20-20 0-1.3-.1-2.6-.4-3.9z")
                                path(fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3l5.7-5.7A20 20 0 0 0 6.3 14.7z")
                                path(fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2A12 12 0 0 1 12.7 28L6.2 33A20 20 0 0 0 24 44z")
                                path(fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z")
                            span Continuer avec Google

                        .auth-divider-row
                            hr
                            span OR
                            hr

                        .auth-field
                            label.auth-label= t.auth.full_name || 'Nom complet'
                            input.auth-input#nameInput(
                                type="text"
                                name="fullname"
                                placeholder="Léa Bernard"
                                autocomplete="name"
                            )

                        .auth-field
                            label.auth-label= t.auth.work_email || 'Email professionnel'
                            input.auth-input#emailInput(
                                type="email"
                                name="email"
                                placeholder="lea@studio.com"
                                autocomplete="email"
                            )

                        .reg-nav
                            button.reg-back(type="button" id="back1") ←
                            button.sm-btn.sm-btn--primary.sm-btn--full.reg-next(type="button" id="next1") Continuer →

                    //- ══ ÉTAPE 2 : Mot de passe ════════════════════════════
                    .reg-step#step2

                        .auth-field
                            label.auth-label= t.auth.password || 'Mot de passe'
                            .auth-pwd-wrap
                                input.auth-input(
                                    type="password"
                                    name="password"
                                    id="pwdField"
                                    placeholder="••••••••"
                                    autocomplete="new-password"
                                )
                                button.auth-pwd-toggle(type="button" id="pwdToggle" tabindex="-1" aria-label="Afficher le mot de passe")
                                    svg#pwdEyeIcon(viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                        path(d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z")
                                        circle(cx="12" cy="12" r="3")

                        .auth-field
                            label.auth-label= t.auth.confirm_pwd2 || 'Confirmer le mot de passe'
                            .auth-pwd-wrap
                                input.auth-input(
                                    type="password"
                                    name="conformPassword"
                                    id="confirmPwdField"
                                    placeholder="••••••••"
                                    autocomplete="new-password"
                                )
                                button.auth-pwd-toggle(type="button" id="confirmPwdToggle" tabindex="-1" aria-label="Afficher le mot de passe")
                                    svg(viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                        path(d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z")
                                        circle(cx="12" cy="12" r="3")

                        .pwd-rules#pwdRules
                            .pwd-rule#ruleLen
                                span.pwd-rule__dot
                                span 8 caractères
                            .pwd-rule#ruleNum
                                span.pwd-rule__dot
                                span 1 chiffre
                            .pwd-rule#ruleSym
                                span.pwd-rule__dot
                                span 1 caractère spécial

                        .reg-nav
                            button.reg-back(type="button" id="back2") ←
                            button.sm-btn.sm-btn--primary.sm-btn--full.reg-next(type="button" id="next2") Continuer →

                    //- ══ ÉTAPE 3 : Métier + finaliser ══════════════════════
                    .reg-step#step3

                        //- Badges plan/promo uniquement à la dernière étape
                        if pendingPlan === 'pro' || pendingPlan === 'business'
                            .auth-plan-badge
                                svg(viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                                    polyline(points="20 6 9 17 4 12")
                                = pendingPlan === 'business' ? 'Plan Business · 1 mois gratuit inclus' : 'Plan Pro · 1 mois gratuit inclus'
                            if pendingPromo
                                .auth-promo-badge
                                    svg(viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                                        path(d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z")
                                        line(x1="7" y1="7" x2="7.01" y2="7")
                                    | Code promo&nbsp;
                                    strong= pendingPromo
                                    | &nbsp;— 1er mois offert 🎁

                        .auth-field#businessTypeField
                            label.auth-label Votre métier / secteur
                            .auth-service-wrap
                                input.auth-input.service-input(
                                    type="text"
                                    id="serviceInput"
                                    placeholder="Ex: Coiffeur, Coach..."
                                    autocomplete="off"
                                )
                                input(type="hidden" name="businessType" id="businessTypeInput")
                                .auth-service-dropdown#serviceDropdown
                            p.auth-field-hint#businessTypeHint Ce métier n'est pas dans la liste conseillée, mais c'est noté !

                        .auth-field#joinCompanyField(style="display:none")
                            label.auth-label Établissement à rejoindre
                            .auth-service-wrap
                                input.auth-input.service-input(
                                    type="text"
                                    id="joinCompanyInput"
                                    placeholder="Nom de l'établissement..."
                                    autocomplete="off"
                                )
                                .auth-service-dropdown#joinCompanyDropdown
                            p.auth-join-hint(style="font-size:12px;color:var(--text-muted,#9ca3af);margin-top:6px") Seuls les établissements en plan Business apparaissent ici. Le propriétaire devra approuver votre demande.

                        .auth-field
                            label.auth-label
                                | Code parrain&nbsp;
                                span.auth-label-opt (optionnel)
                            .auth-ref-row
                                input.auth-input#refCodeInput(
                                    type="text"
                                    name="refCode"
                                    placeholder="Ex: SOPHIE-A3F2"
                                    autocomplete="off"
                                    style="text-transform:uppercase;letter-spacing:.02em;font-size:14px;"
                                )
                                span.auth-ref-status#refStatus

                        label.auth-check-row
                            input(type="checkbox" name="terms" id="termsCheck" style="accent-color:var(--accent)")
                            span.auth-check-text
                                | J'accepte les&nbsp;
                                a(href="/conditions-utilisation" target="_blank") CGU
                                | &nbsp;et la&nbsp;
                                a(href="/confidentialite" target="_blank") Politique de confidentialité
                                | .

                        .reg-nav
                            button.reg-back(type="button" id="back3") ←
                            button.sm-btn.sm-btn--primary.sm-btn--full.reg-next(type="submit" id="submitBtn") Créer mon compte →

                -
                    var _loginHref = '/login'
                    var _lparams = []
                    if (typeof pendingPlan !== 'undefined' && pendingPlan) _lparams.push('plan=' + pendingPlan)
                    if (typeof pendingPromo !== 'undefined' && pendingPromo) _lparams.push('promo=' + pendingPromo)
                    if (_lparams.length) _loginHref += '?' + _lparams.join('&')
                .auth-bottom-link
                    | Vous avez déjà un compte ?&nbsp;
                    a(href=_loginHref) Connectez-vous

block scripts
    script(src="/js/components/topbar.js")
    script.
        const __services = !{JSON.stringify(services)};
        const __regCopy = {
            pro:       { title: !{JSON.stringify(t.auth.register_title_pro || t.auth.register_title)}, desc: !{JSON.stringify(t.auth.register_desc_pro || t.auth.register_desc)} },
            client:    { title: !{JSON.stringify(t.auth.register_title_client || t.auth.register_title)}, desc: !{JSON.stringify(t.auth.register_desc_client || t.auth.register_desc)} },
            undecided: { title: !{JSON.stringify(t.auth.register_title)}, desc: !{JSON.stringify(t.auth.register_desc)} },
        };
        (function() {

            /* ── State ────────────────────────────────────────────── */
            var currentStep = 0;

            var steps  = [
                document.getElementById('step0'),
                document.getElementById('step1'),
                document.getElementById('step2'),
                document.getElementById('step3')
            ];
            var dots   = [
                document.getElementById('dot0'),
                document.getElementById('dot1'),
                document.getElementById('dot2'),
                document.getElementById('dot3')
            ];
            var lbls   = [
                document.getElementById('lbl0'),
                document.getElementById('lbl1'),
                document.getElementById('lbl2'),
                document.getElementById('lbl3')
            ];
            var lines  = [
                document.getElementById('line0'),
                document.getElementById('line1'),
                document.getElementById('line2')
            ];

            function goTo(n) {
                steps[currentStep].classList.remove('active');
                currentStep = n;
                steps[currentStep].classList.add('active');
                updateProgress();
                // Focus 1er input de l'étape
                var first = steps[currentStep].querySelector('input:not([type=hidden]):not([type=checkbox])');
                if (first) setTimeout(function(){ first.focus(); }, 60);
            }

            function updateProgress() {
                for (var i = 0; i <= 3; i++) {
                    dots[i].className = 'reg-progress__dot';
                    lbls[i].className = 'reg-progress__label';
                    if (i < currentStep)       { dots[i].classList.add('done');    lbls[i].classList.add('done'); }
                    else if (i === currentStep) { dots[i].classList.add('current'); lbls[i].classList.add('current'); }
                }
                // Lignes colorées si étape suivante atteinte
                if (lines[0]) lines[0].className = 'reg-progress__line' + (currentStep > 0 ? ' done' : '');
                if (lines[1]) lines[1].className = 'reg-progress__line' + (currentStep > 1 ? ' done' : '');
                if (lines[2]) lines[2].className = 'reg-progress__line' + (currentStep > 2 ? ' done' : '');
            }

            /* ── Validation étape 1 ───────────────────────────────── */
            var nameInput  = document.getElementById('nameInput');
            var emailInput = document.getElementById('emailInput');
            var errBox     = document.getElementById('registerError');

            function showError(msg, el) {
                if (errBox) { errBox.textContent = msg; errBox.style.display = 'block'; }
                if (el) { el.classList.add('auth-input--error'); el.focus(); }
            }
            function clearErrors() {
                if (errBox) errBox.style.display = 'none';
                document.querySelectorAll('.auth-input--error').forEach(function(e){ e.classList.remove('auth-input--error'); });
            }

            /* ── Étape 0 : intention ──────────────────────────────── */
            var intentInput  = document.getElementById('accountIntentInput');
            var intentCards  = document.querySelectorAll('#intentGrid .intent-card');
            var intentMainView    = document.getElementById('intentMain');
            var intentProModeView = document.getElementById('intentProMode');
            var proModeCards = document.querySelectorAll('#proModeGrid .intent-card');
            var proModeInput = document.getElementById('proModeInput');
            var next0        = document.getElementById('next0');
            var next0b       = document.getElementById('next0b');
            var backProModeBtn = document.getElementById('backProMode');
            var businessTypeField = document.getElementById('businessTypeField');
            var joinCompanyField  = document.getElementById('joinCompanyField');
            var joinCompanyIdInput = document.getElementById('joinCompanyIdInput');
            var googleSsoBtn = document.getElementById('googleSsoBtn');

            function showIntentMain() {
                intentProModeView.style.display = 'none';
                intentMainView.style.display = '';
            }
            function showIntentProMode() {
                intentMainView.style.display = 'none';
                intentProModeView.style.display = '';
            }

            function updateNext0State() {
                next0.disabled = !(intentInput.value === 'client' || intentInput.value === 'undecided');
            }
            function updateNext0bState() {
                next0b.disabled = !proModeInput.value;
            }

            function selectIntent(value) {
                var match = null;
                intentCards.forEach(function(c) {
                    c.classList.remove('is-selected');
                    if (c.dataset.intent === value) match = c;
                });
                if (!match) return;
                match.classList.add('is-selected');
                match.querySelector('input[type="radio"]').checked = true;
                intentInput.value = value;
                // Le titre/sous-titre du formulaire s'adapte à l'intention —
                // avant, un visiteur "client" (juste réserver un RDV) voyait
                // toujours "Créez votre compte admin... gérer votre activité
                // et inviter votre équipe", ce qui n'a aucun sens pour lui et
                // est une cause plausible d'abandon en cours d'inscription.
                var copy = __regCopy[value] || __regCopy.undecided;
                var titleEl = document.getElementById('regTitle');
                var descEl  = document.getElementById('regDesc');
                if (titleEl) titleEl.textContent = copy.title;
                if (descEl)  descEl.textContent  = copy.desc;
                if (value === 'pro') {
                    // Ouvre directement la sous-étape créer/rejoindre, au lieu
                    // d'empiler les 2 choix sous les 3 cartes principales.
                    showIntentProMode();
                } else {
                    proModeInput.value = '';
                    proModeCards.forEach(function(c) { c.classList.remove('is-selected'); });
                }
                updateNext0State();
            }

            function selectProMode(value) {
                proModeCards.forEach(function(c) {
                    c.classList.remove('is-selected');
                    if (c.dataset.promode === value) c.classList.add('is-selected');
                });
                proModeInput.value = value;
                updateNext0bState();
            }

            intentCards.forEach(function(card) {
                card.addEventListener('click', function() { selectIntent(card.dataset.intent); });
            });
            proModeCards.forEach(function(card) {
                card.addEventListener('click', function() { selectProMode(card.dataset.promode); });
            });
            backProModeBtn.addEventListener('click', function() { clearErrors(); showIntentMain(); });

            // Pré-sélection si on arrive avec ?intent=... (ex: lien "Espace
            // client" du menu) — l'utilisateur garde la main pour changer.
            var urlIntent = new URLSearchParams(window.location.search).get('intent');
            if (urlIntent && ['pro','client','undecided'].includes(urlIntent)) selectIntent(urlIntent);

            next0.addEventListener('click', function() {
                clearErrors();
                if (!intentInput.value || intentInput.value === 'pro') { showError('Veuillez faire un choix pour continuer.'); return; }
                if (businessTypeField) businessTypeField.style.display = 'none';
                if (joinCompanyField)  joinCompanyField.style.display  = 'none';
                // Transmet l'intention choisie au bouton Google (lue côté
                // serveur après l'aller-retour OAuth, cf. routes/auth.js).
                if (googleSsoBtn) googleSsoBtn.href = '/auth/google?intent=' + intentInput.value;
                goTo(1);
            });

            next0b.addEventListener('click', function() {
                clearErrors();
                if (!proModeInput.value) { showError('Veuillez choisir créer ou rejoindre.'); return; }
                // Le métier n'est demandé que pour un compte "pro" qui crée ;
                // la recherche d'établissement seulement pour qui rejoint.
                var isCreate = proModeInput.value === 'create';
                var isJoin   = proModeInput.value === 'join';
                if (businessTypeField) businessTypeField.style.display = isCreate ? '' : 'none';
                if (joinCompanyField)  joinCompanyField.style.display  = isJoin   ? '' : 'none';
                if (googleSsoBtn) googleSsoBtn.href = '/auth/google?intent=pro';
                goTo(1);
            });

            document.getElementById('back1').addEventListener('click', function(){ clearErrors(); goTo(0); });

            document.getElementById('next1').addEventListener('click', function() {
                clearErrors();
                var name  = nameInput  ? nameInput.value.trim()  : '';
                var email = emailInput ? emailInput.value.trim() : '';
                if (!name)  { showError('Veuillez entrer votre nom.', nameInput); return; }
                if (/[<>]/.test(name)) { showError(!{JSON.stringify(t.auth.error_invalid_name)}, nameInput); return; }
                if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                    showError('Veuillez entrer une adresse email valide.', emailInput); return;
                }
                goTo(2);
            });

            /* ── Validation étape 2 ───────────────────────────────── */
            var pwdField        = document.getElementById('pwdField');
            var confirmPwdField = document.getElementById('confirmPwdField');

            // Règles mot de passe
            var ruleLen = document.getElementById('ruleLen');
            var ruleNum = document.getElementById('ruleNum');
            var ruleSym = document.getElementById('ruleSym');

            function checkPwdRules(v) {
                var touched = v.length > 0;
                [[ruleLen, v.length >= 8], [ruleNum, /[0-9]/.test(v)], [ruleSym, /[^a-zA-Z0-9]/.test(v)]].forEach(function(p){
                    p[0].className = 'pwd-rule' + (p[1] ? ' ok' : (touched ? ' bad' : ''));
                });
            }
            if (pwdField) {
                pwdField.addEventListener('input', function(){ checkPwdRules(this.value); checkPwdMatch(); });
                checkPwdRules('');
            }

            function checkPwdMatch() {
                if (!confirmPwdField) return;
                confirmPwdField.classList.remove('auth-input--match','auth-input--mismatch');
                if (!confirmPwdField.value) return;
                confirmPwdField.classList.add(confirmPwdField.value === pwdField.value ? 'auth-input--match' : 'auth-input--mismatch');
            }
            if (confirmPwdField) confirmPwdField.addEventListener('input', function(){ confirmPwdField.classList.remove('auth-input--error'); checkPwdMatch(); });

            document.getElementById('back2').addEventListener('click', function(){ clearErrors(); goTo(1); });

            document.getElementById('next2').addEventListener('click', function() {
                clearErrors();
                var pwd     = pwdField        ? pwdField.value        : '';
                var confirm = confirmPwdField  ? confirmPwdField.value : '';
                if (pwd.length < 8)                       { showError('8 caractères minimum.', pwdField); return; }
                if (!/[0-9]/.test(pwd))                   { showError('Le mot de passe doit contenir au moins un chiffre.', pwdField); return; }
                if (!/[^a-zA-Z0-9]/.test(pwd))            { showError('Le mot de passe doit contenir au moins un caractère spécial.', pwdField); return; }
                if (pwd !== confirm)                       { showError('Les mots de passe ne correspondent pas.', confirmPwdField); return; }
                goTo(3);
            });

            /* ── Show/hide mot de passe ──────────────────────────── */
            [['pwdField','pwdToggle','pwdEyeIcon'],['confirmPwdField','confirmPwdToggle',null]].forEach(function(pair) {
                var inp = document.getElementById(pair[0]);
                var btn = document.getElementById(pair[1]);
                if (!inp || !btn) return;
                var eyeSvg = pair[2] ? document.getElementById(pair[2]) : btn.querySelector('svg');
                btn.addEventListener('click', function() {
                    var show = inp.type === 'password';
                    inp.type = show ? 'text' : 'password';
                    if (eyeSvg) {
                        eyeSvg.innerHTML = show
                            ? '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>'
                            : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
                    }
                });
            });

            /* ── Dropdown métier (étape 3) ────────────────────────── */
            var svcInput   = document.getElementById('serviceInput');
            var svcHidden  = document.getElementById('businessTypeInput');
            var svcDropdown = document.getElementById('serviceDropdown');
            var svcHint    = document.getElementById('businessTypeHint');

            function normalize(str) { return str.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); }

            // Un métier tapé à la main (absent de la liste conseillée) reste accepté :
            // on le mémorise quand même dans le champ caché, on avertit juste en orange.
            function markCustom(isCustom) {
                svcInput.classList.toggle('service-input--custom', isCustom);
                if (svcHint) svcHint.classList.toggle('is-visible', isCustom);
            }

            function renderList(items) {
                svcDropdown.innerHTML = '';
                if (!items.length) { svcDropdown.style.display = 'none'; return; }
                items.forEach(function(item) {
                    var li = document.createElement('div');
                    li.className = 'auth-service-item';
                    li.textContent = item;
                    li.addEventListener('mousedown', function(e) {
                        e.preventDefault();
                        svcInput.value  = item;
                        svcHidden.value = item;
                        svcDropdown.style.display = 'none';
                        svcInput.classList.add('service-input--selected');
                        svcInput.classList.remove('service-input--invalid');
                        markCustom(false);
                    });
                    svcDropdown.appendChild(li);
                });
                svcDropdown.style.display = 'block';
            }

            if (svcInput) {
                svcInput.addEventListener('input', function() {
                    svcHidden.value = '';
                    svcInput.classList.remove('service-input--selected','service-input--invalid');
                    markCustom(false);
                    var q = normalize(svcInput.value.trim());
                    if (!q) { svcDropdown.style.display = 'none'; return; }
                    renderList(__services.filter(function(s){ return normalize(s).includes(q); }).slice(0,8));
                });
                svcInput.addEventListener('focus', function() {
                    var q = normalize(svcInput.value.trim());
                    if (q) renderList(__services.filter(function(s){ return normalize(s).includes(q); }).slice(0,8));
                });
                svcInput.addEventListener('blur', function() {
                    // Immédiat (pas dans le setTimeout ci-dessous) : sinon un clic
                    // direct sur "Continuer" juste après la saisie pourrait soumettre
                    // avant que la valeur ne soit acceptée, et bloquer à tort.
                    var typed = svcInput.value.trim();
                    // Rien sélectionné dans la liste mais du texte tapé : on
                    // l'accepte quand même (non bloquant), juste signalé en orange.
                    if (typed && !svcHidden.value) {
                        svcHidden.value = typed;
                        markCustom(true);
                    }
                    setTimeout(function() { svcDropdown.style.display = 'none'; }, 160);
                });
            }

            /* ── Recherche d'établissement à rejoindre (étape 3) ──── */
            var joinInput     = document.getElementById('joinCompanyInput');
            var joinHidden     = joinCompanyIdInput;
            var joinDropdown   = document.getElementById('joinCompanyDropdown');
            var joinSearchTimer = null;

            function renderJoinList(companies) {
                joinDropdown.innerHTML = '';
                if (!companies.length) {
                    var empty = document.createElement('div');
                    empty.className = 'auth-service-item';
                    empty.style.color = '#9ca3af';
                    empty.textContent = 'Aucun établissement Business trouvé.';
                    joinDropdown.appendChild(empty);
                    joinDropdown.style.display = 'block';
                    return;
                }
                companies.forEach(function(c) {
                    var li = document.createElement('div');
                    li.className = 'auth-service-item';
                    li.textContent = c.name + (c.businessType ? ' — ' + c.businessType : '');
                    li.addEventListener('mousedown', function(e) {
                        e.preventDefault();
                        joinInput.value  = c.name;
                        joinHidden.value = c.id;
                        joinDropdown.style.display = 'none';
                        joinInput.classList.add('service-input--selected');
                    });
                    joinDropdown.appendChild(li);
                });
                joinDropdown.style.display = 'block';
            }

            function fetchJoinCompanies(q) {
                fetch('/api/joinable-companies?q=' + encodeURIComponent(q))
                    .then(function(r) { return r.json(); })
                    .then(function(data) { renderJoinList(data.companies || []); })
                    .catch(function() { joinDropdown.style.display = 'none'; });
            }

            if (joinInput) {
                // Au focus (champ vide) : propose quelques établissements par
                // défaut, plutôt qu'un menu vide tant qu'on n'a rien tapé.
                joinInput.addEventListener('focus', function() {
                    if (!joinInput.value.trim()) fetchJoinCompanies('');
                });
                joinInput.addEventListener('input', function() {
                    joinHidden.value = '';
                    joinInput.classList.remove('service-input--selected');
                    clearTimeout(joinSearchTimer);
                    var q = joinInput.value.trim();
                    joinSearchTimer = setTimeout(function() { fetchJoinCompanies(q); }, 300);
                });
                joinInput.addEventListener('blur', function() {
                    setTimeout(function() { joinDropdown.style.display = 'none'; }, 160);
                });
            }

            /* ── Code parrain ─────────────────────────────────────── */
            var refInput  = document.getElementById('refCodeInput');
            var refStatus = document.getElementById('refStatus');
            var refTimer  = null;

            var urlRef = new URLSearchParams(window.location.search).get('ref');
            if (urlRef && refInput) { refInput.value = urlRef.toUpperCase(); validateRef(urlRef); }

            function validateRef(code) {
                if (!code) { refStatus.textContent = ''; refStatus.className = 'auth-ref-status'; return; }
                refStatus.textContent = '…';
                fetch('/api/check-ref?code=' + encodeURIComponent(code.toUpperCase()))
                    .then(function(r){ return r.json(); })
                    .then(function(d){
                        refStatus.textContent = d.valid ? ('✓ ' + (d.name||'Valide')) : '✗ Invalide';
                        refStatus.className = 'auth-ref-status ' + (d.valid ? 'ok' : 'err');
                    })
                    .catch(function(){ refStatus.textContent=''; refStatus.className='auth-ref-status'; });
            }
            if (refInput) {
                refInput.addEventListener('input', function() {
                    var v = this.value.trim().toUpperCase(); this.value = v;
                    clearTimeout(refTimer);
                    if (!v) { refStatus.textContent=''; refStatus.className='auth-ref-status'; return; }
                    refTimer = setTimeout(function(){ validateRef(v); }, 500);
                });
            }

            /* ── Navigation étape 3 ───────────────────────────────── */
            document.getElementById('back3').addEventListener('click', function(){ clearErrors(); goTo(2); });

            /* ── Soumission finale ────────────────────────────────── */
            var form      = document.getElementById('registerForm');
            var submitBtn = document.getElementById('submitBtn');

            form.addEventListener('submit', function(e) {
                e.preventDefault();
                clearErrors();

                // Valider métier — seulement pour un compte "pro" qui crée. Un métier
                // absent de la liste conseillée est accepté (signalé en orange plus
                // haut) ; seul un champ complètement vide bloque la suite.
                if (intentInput.value === 'pro' && proModeInput.value === 'create' && !svcHidden.value) {
                    svcInput.classList.add('service-input--invalid');
                    showError('Veuillez indiquer votre métier.');
                    svcInput.focus();
                    return;
                }
                // Valider établissement à rejoindre — seulement pour un "pro" qui rejoint
                if (intentInput.value === 'pro' && proModeInput.value === 'join' && !joinCompanyIdInput.value) {
                    joinInput.classList.add('service-input--invalid');
                    showError('Veuillez choisir un établissement dans la liste.');
                    joinInput.focus();
                    return;
                }
                // Valider CGU
                var terms = document.getElementById('termsCheck');
                if (terms && !terms.checked) {
                    showError('Veuillez accepter les CGU pour continuer.');
                    return;
                }

                var body = new URLSearchParams(new FormData(form)).toString();
                submitBtn.disabled = true;
                submitBtn.textContent = '…';

                fetch('/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'fetch' },
                    body: body
                })
                .then(function(r){ return r.json(); })
                .then(function(data) {
                    if (data.success) {
                        window.location.href = data.redirect || '/appointment';
                    } else {
                        submitBtn.disabled = false; submitBtn.textContent = 'Créer mon compte →';
                        // Afficher l'erreur et revenir à l'étape concernée
                        var low = (data.error||'').toLowerCase();
                        if (/email|e-mail|adresse/.test(low))              { goTo(1); showError(data.error, emailInput); }
                        else if (/nom/.test(low))                           { goTo(1); showError(data.error, nameInput); }
                        else if (/mots? de passe|password|correspond/.test(low)) { goTo(2); showError(data.error, pwdField); }
                        else                                                { showError(data.error||'Une erreur est survenue.'); }
                    }
                })
                .catch(function() {
                    submitBtn.disabled = false; submitBtn.textContent = 'Créer mon compte →';
                    showError('Erreur réseau. Veuillez réessayer.');
                });
            });

            // Touche Entrée → passer à l'étape suivante
            document.addEventListener('keydown', function(e) {
                if (e.key !== 'Enter') return;
                if (currentStep === 0) {
                    if (intentProModeView.style.display !== 'none') { if (!next0b.disabled) { e.preventDefault(); next0b.click(); } }
                    else { if (!next0.disabled) { e.preventDefault(); next0.click(); } }
                }
                else if (currentStep === 1) { e.preventDefault(); document.getElementById('next1').click(); }
                else if (currentStep === 2) { e.preventDefault(); document.getElementById('next2').click(); }
            });

        })();
