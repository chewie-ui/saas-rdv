extends ../../layouts/auth

block links
    link(rel="stylesheet", href="/css/layouts/auth-register.css")

block content
    .auth-register-page
        .auth-register-inner

            //- ── Logo + heading ─────────────────────────────────────
            .auth-register-top
                a.auth-art__logo(href="/")
                    img.auth-art__logo-mark(src="/images/icon.svg" alt="BranShee")
                    span BranShee
                h1= t.auth.register_title
                p.auth-sub= t.auth.register_desc

            if error
                .auth-error= error

            //- ── Google SSO ────────────────────────────────────────
            a.auth-social-btn(href="/auth/google")
                svg(width="16" height="16" viewBox="0 0 48 48")
                    path(fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8a12 12 0 1 1 0-24c3.1 0 5.8 1.2 7.9 3l5.7-5.7A20 20 0 1 0 24 44c11 0 20-9 20-20 0-1.3-.1-2.6-.4-3.9z")
                    path(fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3l5.7-5.7A20 20 0 0 0 6.3 14.7z")
                    path(fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2A12 12 0 0 1 12.7 28L6.2 33A20 20 0 0 0 24 44z")
                    path(fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z")
                span Continue with Google

            .auth-divider-row
                hr
                span OR
                hr

            //- ── Card form ─────────────────────────────────────────
            .auth-register-card
                form.auth-register-form(action="/register" method="POST")

                    //- Name row
                    .auth-register-row
                        .auth-field
                            label.auth-label= t.auth.full_name || 'Full name'
                            input.auth-input(
                                type="text"
                                name="fullname"
                                placeholder="Léa Bernard"
                                autocomplete="name"
                                required
                            )

                    //- Email
                    .auth-field
                        label.auth-label= t.auth.work_email || 'Email'
                        input.auth-input(
                            type="email"
                            name="email"
                            placeholder="lea@studio.com"
                            autocomplete="email"
                            required
                        )

                    //- Business type
                    .auth-field
                        label.auth-label Votre métier / secteur
                        .auth-service-wrap
                            input.auth-input.service-input(
                                type="text"
                                id="serviceInput"
                                placeholder="Ex: Coiffeur, Coach..."
                                autocomplete="off"
                            )
                            input(type="hidden" name="businessType" id="businessTypeInput")
                            .auth-service-dropdown#serviceDropdown

                    //- Password
                    .auth-field
                        label.auth-label= t.auth.password
                        input.auth-input(
                            type="password"
                            name="password"
                            placeholder="••••••••"
                            autocomplete="new-password"
                            required
                        )

                    //- Confirm password
                    .auth-field
                        label.auth-label= t.auth.confirm_pwd2
                        input.auth-input(
                            type="password"
                            name="conformPassword"
                            placeholder="••••••••"
                            autocomplete="new-password"
                            required
                        )

                    //- Terms
                    label.auth-check-row
                        input(type="checkbox" name="terms" required style="accent-color:var(--accent)")
                        span.auth-check-text
                            | I agree to the
                            a(href="/conditions-utilisation") Terms
                            |  and
                            a(href="/confidentialite") Privacy Policy
                            | .

                    button.auth-submit(type="submit")= t.auth.continue

            .auth-bottom-link
                = t.auth.already_account + ' '
                a(href="/login")= t.auth.login_link

block scripts
    script(src="/js/components/topbar.js")
    script.
        const __services = !{JSON.stringify(services)};
        (function() {
            const input = document.getElementById('serviceInput');
            const hidden = document.getElementById('businessTypeInput');
            const dropdown = document.getElementById('serviceDropdown');
            if (!input || !dropdown) return;

            function normalize(str) {
                return str.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
            }

            function renderList(items) {
                dropdown.innerHTML = '';
                if (items.length === 0) { dropdown.style.display = 'none'; return; }
                items.forEach(function(item) {
                    var li = document.createElement('div');
                    li.className = 'auth-service-item';
                    li.textContent = item;
                    li.addEventListener('mousedown', function(e) {
                        e.preventDefault();
                        input.value = item;
                        hidden.value = item;
                        dropdown.style.display = 'none';
                        input.classList.add('service-input--selected');
                    });
                    dropdown.appendChild(li);
                });
                dropdown.style.display = 'block';
            }

            input.addEventListener('input', function() {
                var q = normalize(input.value.trim());
                hidden.value = input.value.trim();
                if (!q) { dropdown.style.display = 'none'; return; }
                renderList(__services.filter(function(s){ return normalize(s).includes(q); }).slice(0, 8));
            });

            input.addEventListener('focus', function() {
                var q = normalize(input.value.trim());
                if (q) renderList(__services.filter(function(s){ return normalize(s).includes(q); }).slice(0, 8));
            });

            input.addEventListener('blur', function() {
                setTimeout(function() { dropdown.style.display = 'none'; }, 150);
            });
        })();
