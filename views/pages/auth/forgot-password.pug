extends ../../layouts/auth

block links
    style.
        .fp-steps { display:flex; gap:6px; margin-bottom:28px; align-items:center; }
        .fp-step { display:flex; align-items:center; gap:7px; font-size:12.5px; font-weight:600; color:var(--text-muted,#9ca3af); white-space:nowrap; }
        .fp-step.is-active { color:var(--accent,#16a34a); }
        .fp-step__dot { width:22px; height:22px; border-radius:50%; border:2px solid currentColor; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:800; flex-shrink:0; transition:all .2s; }
        .fp-step.is-active .fp-step__dot { background:var(--accent,#16a34a); border-color:var(--accent,#16a34a); color:#fff; }
        .fp-step.is-done   .fp-step__dot { background:var(--success-pale); border-color:var(--success-pale); color:var(--accent,#16a34a); }
        .fp-sep { flex:1; height:2px; background:var(--border-light,#e5e7eb); border-radius:99px; }
        .fp-sep.is-done { background:var(--accent,#16a34a); }
        .fp-panel { display:none; flex-direction:column; gap:16px; }
        .fp-panel.is-active { display:flex; }
        .fp-code-row { display:flex; gap:8px; justify-content:center; }
        .fp-code-box { width:44px; height:52px; text-align:center; font-size:1.4rem; font-weight:800; border:2px solid var(--border-light,#e5e7eb); border-radius:10px; outline:none; background:#fff; color:var(--ink,#111); transition:border-color .15s; font-family:monospace; }
        .fp-code-box:focus { border-color:var(--accent,#16a34a); }
        .fp-code-box.is-error { border-color:#ef4444; animation:shake .3s; }
        @keyframes shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }
        .fp-status { font-size:12.5px; min-height:16px; text-align:center; }
        .fp-status.ok { color:var(--accent,#16a34a); }
        .fp-status.err { color:#dc2626; }
        .fp-resend { font-size:12px; color:var(--text-muted,#9ca3af); text-align:center; }
        .fp-resend button { background:none; border:none; color:var(--accent,#16a34a); font-weight:600; cursor:pointer; font-size:12px; padding:0; font-family:inherit; }
        .fp-resend button:disabled { color:var(--text-muted,#9ca3af); cursor:default; }
        .fp-success { display:flex; flex-direction:column; align-items:center; gap:12px; text-align:center; padding:16px 0; }
        .fp-success__icon { width:56px; height:56px; border-radius:50%; background:var(--success-pale); display:flex; align-items:center; justify-content:center; font-size:26px; }
        .fp-success h2 { font-size:18px; font-weight:700; color:var(--ink,#111); margin:0; }
        .fp-success p { font-size:13.5px; color:var(--text-muted,#6b7280); margin:0; }

block content
    .auth-split

        //- ── Panneau gauche ────────────────────────────────────────
        .auth-art
            a.auth-art__logo(href="/")
                img.auth-art__logo-mark(src="/images/icon.svg" alt="BranShee")
                span BranShee
            .auth-art__body
                .auth-art__headline Récupérez votre compte en quelques secondes.
                .auth-art__stats
                    .auth-art__stat
                        .auth-art__stat-num 3
                        .auth-art__stat-label étapes
                    .auth-art__stat
                        .auth-art__stat-num &lt; 1 min
                        .auth-art__stat-label pour le code
                    .auth-art__stat
                        .auth-art__stat-num 100%
                        .auth-art__stat-label sécurisé
            .auth-art__foot © BranShee

        //- ── Formulaire ────────────────────────────────────────────
        .auth-form-panel
            .auth-form-inner

                //- Indicateur d'étapes
                .fp-steps
                    .fp-step.is-active(data-step="1")
                        .fp-step__dot 1
                        span Email
                    .fp-sep#sep1
                    .fp-step(data-step="2")
                        .fp-step__dot 2
                        span Code
                    .fp-sep#sep2
                    .fp-step(data-step="3")
                        .fp-step__dot 3
                        span Nouveau mot de passe

                //- ── Étape 1 ─────────────────────────────────────
                .fp-panel.is-active#fpPanel1
                    div
                        h1(style="font-size:1.35rem;font-weight:800;color:var(--ink,#111);letter-spacing:-.02em;margin:0 0 6px") Mot de passe oublié
                        p.auth-sub(style="margin:0") Entrez votre email, nous vous enverrons un code à 6 chiffres.
                    .auth-field
                        label.auth-label Adresse email
                        input.auth-input#fpEmail(type="email" placeholder="vous@exemple.com" autocomplete="email" autofocus)
                    .fp-status#fpStatus1
                    button.sm-btn.sm-btn--primary.sm-btn--full#fpSendCode(type="button") Envoyer le code →

                //- ── Étape 2 ─────────────────────────────────────
                .fp-panel#fpPanel2
                    div
                        h1(style="font-size:1.35rem;font-weight:800;color:var(--ink,#111);letter-spacing:-.02em;margin:0 0 6px") Entrez le code
                        p.auth-sub#fpEmailDisplay(style="margin:0") Code envoyé à votre adresse email.
                    .fp-code-row
                        each n in [1,2,3,4,5,6]
                            input.fp-code-box(type="tel" maxlength="1" inputmode="numeric" pattern="[0-9]")
                    .fp-status#fpStatus2
                    button.sm-btn.sm-btn--primary.sm-btn--full#fpVerifyCode(type="button") Vérifier le code
                    .fp-resend
                        | Pas reçu ?&nbsp;
                        button#fpResendBtn(type="button" disabled) Renvoyer le code

                //- ── Étape 3 ─────────────────────────────────────
                .fp-panel#fpPanel3
                    div
                        h1(style="font-size:1.35rem;font-weight:800;color:var(--ink,#111);letter-spacing:-.02em;margin:0 0 6px") Nouveau mot de passe
                        p.auth-sub(style="margin:0") Choisissez un mot de passe d'au moins 8 caractères.
                    .auth-field
                        label.auth-label Nouveau mot de passe
                        input.auth-input#fpNewPwd(type="password" placeholder="••••••••" autocomplete="new-password")
                    .auth-field
                        label.auth-label Confirmer
                        input.auth-input#fpConfirmPwd(type="password" placeholder="••••••••" autocomplete="new-password")
                    .fp-status#fpStatus3
                    button.sm-btn.sm-btn--primary.sm-btn--full#fpSavePwd(type="button") Enregistrer

                //- ── Succès ──────────────────────────────────────
                .fp-panel#fpPanelSuccess
                    .fp-success
                        .fp-success__icon ✅
                        h2 Mot de passe mis à jour !
                        p Vous pouvez maintenant vous connecter avec votre nouveau mot de passe.
                    a.sm-btn.sm-btn--primary.sm-btn--full(href="/login" style="text-decoration:none;") Se connecter

                .auth-bottom-link(style="margin-top:8px")
                    a(href="/login") ← Retour à la connexion

block scripts
    script.
        (function() {
            var emailVal = '';
            var emailInput   = document.getElementById('fpEmail');
            var sendBtn      = document.getElementById('fpSendCode');
            var verifyBtn    = document.getElementById('fpVerifyCode');
            var savePwdBtn   = document.getElementById('fpSavePwd');
            var resendBtn    = document.getElementById('fpResendBtn');
            var codeBoxes    = Array.from(document.querySelectorAll('.fp-code-box'));

            function goToStep(n) {
                [1,2,3].forEach(function(s) {
                    var panel = document.getElementById('fpPanel' + s);
                    var step  = document.querySelector('[data-step="' + s + '"]');
                    var sep   = document.getElementById('sep' + (s < 3 ? s : 2));
                    if (panel) panel.classList.toggle('is-active', s === n);
                    if (step) {
                        step.classList.toggle('is-active', s === n);
                        step.classList.toggle('is-done', s < n);
                        step.querySelector('.fp-step__dot').textContent = s < n ? '✓' : String(s);
                    }
                });
                if (n > 1) document.getElementById('sep1') && document.getElementById('sep1').classList.add('is-done');
                if (n > 2) document.getElementById('sep2') && document.getElementById('sep2').classList.add('is-done');
            }

            function setStatus(id, msg, type) {
                var el = document.getElementById(id);
                if (el) { el.textContent = msg; el.className = 'fp-status ' + (type||''); }
            }
            function setLoading(btn, on) { btn.disabled = on; btn.style.opacity = on ? '.6' : ''; }

            // ── Étape 1 : Envoyer le code ───────────────────────────────
            sendBtn.addEventListener('click', async function() {
                var email = (emailInput.value||'').trim();
                if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                    setStatus('fpStatus1','Adresse email invalide.','err'); emailInput.focus(); return;
                }
                emailVal = email;
                setLoading(sendBtn, true);
                setStatus('fpStatus1','Envoi en cours…','');
                var r = await fetch('/forgot-password/verify-code',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({value:email})});
                var d = await r.json();
                setLoading(sendBtn, false);
                if (d.success) {
                    var disp = document.getElementById('fpEmailDisplay');
                    if (disp) disp.textContent = 'Code envoyé à ' + email + '. Vérifiez votre boîte de réception.';
                    goToStep(2);
                    setTimeout(function(){ codeBoxes[0] && codeBoxes[0].focus(); }, 150);
                    // Activer le bouton "Renvoyer" après 30s
                    setTimeout(function(){ if(resendBtn) resendBtn.disabled = false; }, 30000);
                } else {
                    setStatus('fpStatus1','Aucun compte trouvé avec cet email.','err');
                }
            });
            emailInput && emailInput.addEventListener('keydown', function(e){ if(e.key==='Enter') sendBtn.click(); });

            // ── Auto-avance dans les cases du code ──────────────────────
            codeBoxes.forEach(function(box, idx) {
                box.addEventListener('input', function(){
                    this.value = this.value.replace(/[^0-9]/g,'').slice(-1);
                    if (this.value && idx < codeBoxes.length-1) codeBoxes[idx+1].focus();
                    if (getCode().length === 6) verifyBtn.click();
                });
                box.addEventListener('keydown', function(e){
                    if (e.key==='Backspace' && !this.value && idx > 0) codeBoxes[idx-1].focus();
                    if (e.key==='Enter') verifyBtn.click();
                });
                box.addEventListener('paste', function(e){
                    var paste = (e.clipboardData||window.clipboardData).getData('text').replace(/\D/g,'');
                    if (paste.length >= 6) {
                        e.preventDefault();
                        codeBoxes.forEach(function(b,i){ b.value = paste[i]||''; });
                        codeBoxes[5].focus();
                        setTimeout(function(){ verifyBtn.click(); }, 100);
                    }
                });
            });
            function getCode(){ return codeBoxes.map(function(b){ return b.value; }).join(''); }

            // ── Étape 2 : Vérifier le code ──────────────────────────────
            verifyBtn.addEventListener('click', async function() {
                var code = getCode();
                if (code.length < 6) { codeBoxes.forEach(function(b){ b.classList.add('is-error'); }); setStatus('fpStatus2','Entrez les 6 chiffres.','err'); return; }
                setLoading(verifyBtn, true); setStatus('fpStatus2','Vérification…','');
                var r = await fetch('/forgot-password/check-code',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({code:parseInt(code)})});
                var d = await r.json();
                setLoading(verifyBtn, false);
                if (d.success) {
                    goToStep(3);
                    setTimeout(function(){ var pw = document.getElementById('fpNewPwd'); pw && pw.focus(); }, 150);
                } else {
                    codeBoxes.forEach(function(b){ b.classList.add('is-error'); b.value=''; });
                    codeBoxes[0].focus();
                    setStatus('fpStatus2','Code incorrect. Vérifiez votre email.','err');
                }
            });

            // ── Renvoyer ─────────────────────────────────────────────────
            resendBtn && resendBtn.addEventListener('click', async function() {
                this.disabled = true; this.textContent = 'Envoi…';
                await fetch('/forgot-password/verify-code',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({value:emailVal})});
                codeBoxes.forEach(function(b){ b.value=''; b.classList.remove('is-error'); });
                codeBoxes[0].focus();
                setStatus('fpStatus2','✓ Nouveau code envoyé.','ok');
                var self = this;
                setTimeout(function(){ self.disabled=false; self.textContent='Renvoyer le code'; }, 30000);
            });

            // ── Étape 3 : Nouveau mot de passe ──────────────────────────
            savePwdBtn.addEventListener('click', async function() {
                var pwd  = (document.getElementById('fpNewPwd').value||'');
                var conf = (document.getElementById('fpConfirmPwd').value||'');
                if (pwd.length < 8) { setStatus('fpStatus3','Minimum 8 caractères.','err'); return; }
                if (pwd !== conf)   { setStatus('fpStatus3','Les mots de passe ne correspondent pas.','err'); return; }
                setLoading(savePwdBtn, true); setStatus('fpStatus3','Enregistrement…','');
                var r = await fetch('/forgot-password/new-password',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:pwd,email:emailVal})});
                var d = await r.json();
                setLoading(savePwdBtn, false);
                if (d.success) {
                    [1,2,3].forEach(function(s){
                        var p = document.getElementById('fpPanel'+s);
                        if (p) p.classList.remove('is-active');
                    });
                    var suc = document.getElementById('fpPanelSuccess');
                    if (suc) suc.classList.add('is-active');
                } else {
                    setStatus('fpStatus3','Erreur. Recommencez depuis le début.','err');
                }
            });
            document.getElementById('fpNewPwd') && document.getElementById('fpNewPwd').addEventListener('keydown', function(e){ if(e.key==='Enter') savePwdBtn.click(); });
            document.getElementById('fpConfirmPwd') && document.getElementById('fpConfirmPwd').addEventListener('keydown', function(e){ if(e.key==='Enter') savePwdBtn.click(); });
        })();
