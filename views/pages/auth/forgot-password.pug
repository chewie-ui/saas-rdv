extends ../../layouts/index

block links 
    link(rel="stylesheet", href="/css/components/index/auth.index.css")
block content
    .content-wrapper
        .auth-wrapper
            .auth-image       
                img(src='/images/auth-bg.png' alt="Men writing on computer")
                .image-content
            .auth-form.flex
                .auth-form__container
                    .form-body.flex.col.first-form
                        .form-title.flex.col
                            h1= t.auth.forgot_title
                            p= t.auth.forgot_desc
                        .form-fields.flex.col
                            .field-container.flex.col
                                p= t.auth.email
                                input.input(placeholder="Email" id="forgotPwdEmail" type="text")
                            button.btn(id="forgotPwdSendCode").sec= t.auth.send_code
                        if error
                            p.xs-comment.error= error
    template#secondFormTemplate
        .form-body.flex.col.second-form
            .form-title.flex.col
                h1= t.auth.enter_code_title
                p= t.auth.enter_code_desc
            .form-fields.flex.col
                .field-container.flex.col
                    p= t.auth.digital_code
                    input.input(placeholder="000000" id="digitalCode" type="text")
                button.btn(id="checkDigitalCode").sec= t.auth.confirm
            p.xs-comment.error.none.small-txt.danger

    template#thirdFormTemplate
        .form-body.flex.col.third-form
            .form-title.flex.col
                h1= t.auth.new_pwd_title
                p= t.auth.new_pwd_desc
            .form-fields.flex.col
                .field-container.flex.col
                    p= t.auth.new_pwd
                    input.input(placeholder=t.auth.new_pwd id="password" type="text")
                .field-container.flex.col
                    p= t.auth.confirm_pwd
                    input.input(placeholder=t.auth.confirm_pwd id="conformPassword" type="text")
                button.btn(id="checkPasswords").sec= t.auth.change_pwd_btn
            p.xs-comment.error.none.small-txt.danger
block scripts
    script(src="/js/layouts/forgot-password.js")
    script(src="/js/components/topbar.js")