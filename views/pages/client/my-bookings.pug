extends ../../layouts/index

block links
    link(rel="stylesheet", href="/css/layouts/my-bookings.css")

block content
    .my-bookings
        .my-bookings__hero
            .container
                h1 Mes rendez-vous
                p Retrouvez tous vos rendez-vous en entrant votre adresse email.

        .my-bookings__container.container

            //- Formulaire email
            .my-bookings__form-wrapper(class=bookings ? 'has-results' : '')
                form.my-bookings__form(method="POST" action="/mes-rdv")
                    .form-row
                        input.input(
                            type="email"
                            name="email"
                            placeholder="Votre adresse email"
                            value=email || ''
                            required
                            autocomplete="email"
                        )
                        button.btn(type="submit")
                            svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                                path(d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z")
                            span Rechercher

                if error
                    .my-bookings__error
                        p= error

            //- Résultats
            if bookings
                if bookings.upcoming.length === 0 && bookings.past.length === 0
                    .my-bookings__empty
                        svg(xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="currentColor")
                            path(d="M224.62-120q-27.62 0-46.12-18.5Q160-157 160-184.62v-510.76q0-27.62 18.5-46.12Q197-760 224.62-760h70.76v-89.23h43.08V-760h286.16v-89.23h40V-760h70.76q27.62 0 46.12 18.5Q800-723 800-695.38v510.76q0 27.62-18.5 46.12Q763-120 735.38-120H224.62Z")
                        p Aucun rendez-vous trouvé pour <strong>#{email}</strong>.
                        p Vérifiez l'adresse email utilisée lors de la réservation.

                else
                    //- Rendez-vous à venir
                    if bookings.upcoming.length > 0
                        .my-bookings__section
                            .section__header
                                svg(xmlns="http://www.w3.org/2000/svg" height="22px" viewBox="0 -960 960 960" width="22px" fill="currentColor")
                                    path(d="m612-292 56-56-128-128v-184h-80v216l152 152ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                                h2 À venir (#{bookings.upcoming.length})

                            .my-bookings__cards
                                each b in bookings.upcoming
                                    .booking-card.booking-card--upcoming
                                        .booking-card__date
                                            .date__day= new Date(b.date).toLocaleDateString('fr-FR', {weekday: 'short'})
                                            .date__num= new Date(b.date).getDate()
                                            .date__month= new Date(b.date).toLocaleDateString('fr-FR', {month: 'short'})
                                        .booking-card__info
                                            .booking-card__pro
                                                if b.company && b.company.fullName
                                                    p.pro__name= b.company.fullName
                                                else
                                                    p.pro__name Professionnel
                                            .booking-card__time
                                                svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                                    path(d="m612-292 56-56-128-128v-184h-80v216l152 152ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                                                span #{b.startTime} — #{b.endTime}
                                            .booking-card__badge.confirmed Confirmé
                                        .booking-card__actions
                                            a.btn.btn--ghost.btn--sm(href=`/cancel-booking/${b._id}?token=${b.cancelToken}` onclick="return confirm('Annuler ce rendez-vous ?')")
                                                svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                                    path(d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z")
                                                span Annuler

                    //- Historique passé
                    if bookings.past.length > 0
                        .my-bookings__section
                            .section__header
                                svg(xmlns="http://www.w3.org/2000/svg" height="22px" viewBox="0 -960 960 960" width="22px" fill="currentColor")
                                    path(d="M480-120q-138 0-240.5-91.5T122-440h82q14 104 92.5 172T480-200q117 0 198.5-81.5T760-480q0-117-81.5-198.5T480-760q-69 0-129 32t-101 88h110v80H120v-240h80v94q51-64 124.5-99T480-840q75 0 140.5 28.5t114 77q48.5 48.5 77 114T840-480q0 75-28.5 140.5t-77 114q-48.5 48.5-114 77T480-120Z")
                                h2 Historique (#{bookings.past.length})

                            .my-bookings__cards
                                each b in bookings.past
                                    .booking-card.booking-card--past(class=b.status === 'canceled' ? 'booking-card--canceled' : '')
                                        .booking-card__date
                                            .date__day= new Date(b.date).toLocaleDateString('fr-FR', {weekday: 'short'})
                                            .date__num= new Date(b.date).getDate()
                                            .date__month= new Date(b.date).toLocaleDateString('fr-FR', {month: 'short'})
                                        .booking-card__info
                                            .booking-card__pro
                                                if b.company && b.company.fullName
                                                    p.pro__name= b.company.fullName
                                                else
                                                    p.pro__name Professionnel
                                            .booking-card__time
                                                svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                                    path(d="m612-292 56-56-128-128v-184h-80v216l152 152ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                                                span #{b.startTime} — #{b.endTime}
                                            .booking-card__badge(class=b.status === 'canceled' ? 'canceled' : 'past')
                                                = b.status === 'canceled' ? 'Annulé' : 'Passé'
