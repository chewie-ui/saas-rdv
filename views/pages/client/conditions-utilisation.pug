    .legal-page
        .legal-page__hero
            .container
                h1.legal-page__title Conditions générales d'utilisation
                p.legal-page__meta Dernière mise à jour : 1er janvier 2025 — BranShee, Belgique

        .legal-page__body.container
            .legal-toc
                h2 Sommaire
                ol
                    li: a(href="#objet") Objet et champ d'application
                    li: a(href="#acces") Accès à la plateforme
                    li: a(href="#compte") Création de compte
                    li: a(href="#services") Description des services
                    li: a(href="#rdv") Prise de rendez-vous
                    li: a(href="#abonnement") Abonnements et tarifs
                    li: a(href="#obligations") Obligations des utilisateurs
                    li: a(href="#propriete") Propriété intellectuelle
                    li: a(href="#responsabilite") Limitation de responsabilité
