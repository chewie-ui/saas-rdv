extends ../../layouts/index

block links
    link(rel="stylesheet", href="/css/layouts/legal.css")

block content
    br
    br
    br
    br
    br
    .legal-page
        .legal-page__hero
            .container
                h1.legal-page__title Politique de confidentialité
                p.legal-page__meta Dernière mise à jour : 1er janvier 2026 — BranShee, Belgique

        .legal-page__body.container
            .legal-toc
                h2 Sommaire
                ol
                    li: a(href="#responsable") Responsable du traitement
                    li: a(href="#donnees") Données collectées
                    li: a(href="#finalites") Finalités et base légale
                    li: a(href="#conservation") Durée de conservation
                    li: a(href="#droits") Vos droits (RGPD)
                    li: a(href="#partage") Partage des données
                    li: a(href="#securite") Sécurité
                    li: a(href="#cookies") Cookies
                    li: a(href="#mineurs") Mineurs
                    li: a(href="#contact") Contact et réclamations

            section#responsable.legal-section
                h2 1. Responsable du traitement
                p BranShee est le responsable du traitement de vos données personnelles au sens du Règlement (UE) 2016/679 (RGPD).
                .legal-box
                    p #[strong BranShee]
                    p Belgique
                    p Email : #[a(href="mailto:privacy@gymio.be") privacy@gymio.be]
                    p Site : #[a(href="https://gymio.be" target="_blank") gymio.be]

            section#donnees.legal-section
                h2 2. Données collectées
                p Dans le cadre de l'utilisation de la plateforme BranShee, nous collectons les catégories de données suivantes :

                h3 2.1 Données fournies directement
                ul
                    li #[strong Compte utilisateur] : nom, prénom, adresse e-mail, mot de passe (chiffré), numéro de téléphone.
                    li #[strong Prise de rendez-vous] : nom, prénom, e-mail, téléphone, message, date et heure du rendez-vous.
                    li #[strong Profil coach] : nom, prénom, e-mail, biographie, localisation, disponibilités, tarifs.
                    li #[strong Paiement] : les données bancaires sont traitées exclusivement par notre prestataire de paiement certifié (Stripe). BranShee ne stocke aucune donnée de carte bancaire.

                h3 2.2 Données collectées automatiquement
                ul
                    li Adresse IP, type de navigateur, système d'exploitation.
                    li Pages visitées, durée de session, actions effectuées sur la plateforme.
                    li Données de connexion et journaux d'accès (logs).

                h3 2.3 Données provenant de tiers
                ul
                    li Si vous choisissez de connecter votre compte Google Calendar, nous accédons aux tokens OAuth nécessaires à la synchronisation des rendez-vous. Ces tokens sont stockés de manière sécurisée et ne sont utilisés qu'à cette fin.

            section#finalites.legal-section
                h2 3. Finalités et base légale (RGPD)

                .legal-table-wrapper
                    table.legal-table
                        thead
                            tr
                                th Finalité
                                th Base légale (Art. 6 RGPD)
                        tbody
                            tr
                                td Création et gestion de votre compte
                                td Exécution d'un contrat (Art. 6.1.b)
                            tr
                                td Prise et gestion des rendez-vous
                                td Exécution d'un contrat (Art. 6.1.b)
                            tr
                                td Envoi d'e-mails de confirmation et rappel
                                td Exécution d'un contrat (Art. 6.1.b)
                            tr
                                td Facturation et gestion des abonnements
                                td Obligation légale (Art. 6.1.c)
                            tr
                                td Amélioration de la plateforme et statistiques
                                td Intérêt légitime (Art. 6.1.f)
                            tr
                                td Envoi d'e-mails marketing (newsletter)
                                td Consentement (Art. 6.1.a)
                            tr
                                td Synchronisation Google Calendar
                                td Consentement (Art. 6.1.a)

            section#conservation.legal-section
                h2 4. Durée de conservation
                ul
                    li #[strong Données de compte actif] : conservées pendant toute la durée de la relation contractuelle.
                    li #[strong Données de rendez-vous] : 3 ans à compter de la date du rendez-vous (prescription civile belge).
                    li #[strong Données de facturation] : 7 ans (obligation légale comptable belge).
                    li #[strong Logs et données de connexion] : 12 mois maximum.
                    li #[strong Compte inactif] : les données sont supprimées après 2 ans d'inactivité, après notification préalable par e-mail.
                p Après expiration de ces délais, vos données sont supprimées ou anonymisées de manière irréversible.

            section#droits.legal-section
                h2 5. Vos droits (RGPD)
                p Conformément au RGPD et à la loi belge du 30 juillet 2018, vous disposez des droits suivants :

                .legal-rights-grid
                    .legal-right
                        h3 Droit d'accès
                        p Obtenir une copie de toutes vos données personnelles que nous détenons.
                    .legal-right
                        h3 Droit de rectification
                        p Corriger des données inexactes ou incomplètes vous concernant.
                    .legal-right
                        h3 Droit à l'effacement
                        p Demander la suppression de vos données (« droit à l'oubli »), sous réserve des obligations légales.
                    .legal-right
                        h3 Droit à la limitation
                        p Restreindre temporairement le traitement de vos données dans certains cas.
                    .legal-right
                        h3 Droit à la portabilité
                        p Recevoir vos données dans un format structuré et lisible par machine.
                    .legal-right
                        h3 Droit d'opposition
                        p Vous opposer à un traitement basé sur notre intérêt légitime ou à des fins de marketing direct.

                p Pour exercer vos droits, contactez-nous à #[a(href="mailto:privacy@gymio.be") privacy@gymio.be]. Nous répondons dans un délai de #[strong 30 jours].

            section#partage.legal-section
                h2 6. Partage des données
                p BranShee ne vend pas vos données personnelles. Nous pouvons partager vos données avec :
                ul
                    li #[strong Coachs inscrits sur la plateforme] : dans le cadre strict de la gestion des rendez-vous que vous avez pris avec eux.
                    li #[strong Stripe] : prestataire de paiement sécurisé, pour la gestion des abonnements et transactions.
                    li #[strong Google] : si vous activez la synchronisation Google Calendar (sur la base de votre consentement explicite).
                    li #[strong Hébergeur et prestataires techniques] : dans le cadre de l'exploitation de l'infrastructure, soumis à des accords de traitement des données (DPA) conformes au RGPD.
                    li #[strong Autorités compétentes] : si la loi l'exige ou en cas d'urgence pour protéger des droits et des personnes.
                p Aucun transfert de données en dehors de l'Espace Économique Européen n'est effectué sans garanties appropriées (clauses contractuelles types de la Commission européenne).

            section#securite.legal-section
                h2 7. Sécurité
                p Nous mettons en œuvre des mesures techniques et organisationnelles appropriées pour protéger vos données :
                ul
                    li Chiffrement des mots de passe (bcrypt).
                    li Communications chiffrées via HTTPS/TLS.
                    li Tokens OAuth stockés de manière sécurisée.
                    li Accès aux données limité au personnel autorisé.
                    li Sauvegardes régulières et plan de continuité.
                p En cas de violation de données susceptible d'engendrer un risque élevé pour vos droits, vous serez notifié dans les meilleurs délais conformément à l'Article 34 du RGPD.

            section#cookies.legal-section
                h2 8. Cookies
                p BranShee utilise des cookies essentiels au fonctionnement de la plateforme :
                .legal-table-wrapper
                    table.legal-table
                        thead
                            tr
                                th Cookie
                                th Finalité
                                th Durée
                        tbody
                            tr
                                td #[code connect.sid]
                                td Session utilisateur (authentification)
                                td Session
                            tr
                                td #[code saymiro-theme]
                                td Préférence de thème (clair/sombre)
                                td 1 an (localStorage)
                p Nous n'utilisons pas de cookies publicitaires ou de tracking tiers. Si nous introduisons de nouveaux cookies, nous vous en informerons et demanderons votre consentement le cas échéant.

            section#mineurs.legal-section
                h2 9. Mineurs
                p La plateforme BranShee est réservée aux personnes âgées de 16 ans ou plus. Nous ne collectons pas sciemment de données personnelles concernant des mineurs de moins de 16 ans. Si vous avez connaissance qu'un mineur nous a fourni des données sans consentement parental, contactez-nous à #[a(href="mailto:privacy@gymio.be") privacy@gymio.be].

            section#contact.legal-section
                h2 10. Contact et réclamations
                p Pour toute question relative à la présente politique ou pour exercer vos droits, contactez notre délégué à la protection des données :
                .legal-box
                    p #[strong Email] : #[a(href="mailto:privacy@gymio.be") privacy@gymio.be]
                    p #[strong Objet de l'e-mail] : « Demande RGPD — [votre nom] »

                p Si vous estimez que vos droits ne sont pas respectés, vous pouvez introduire une réclamation auprès de l'Autorité de protection des données belge (APD) :
                .legal-box
                    p #[strong Autorité de protection des données (APD)]
                    p Rue de la Presse 35, 1000 Bruxelles
                    p #[a(href="https://www.autoriteprotectiondonnees.be" target="_blank") www.autoriteprotectiondonnees.be]
                    p Tél : +32 2 274 48 00

            .legal-footer-nav
                a.btn.secondary(href="/conditions-utilisation") Conditions d'utilisation
                a.btn.secondary(href="/") Retour à l'accueil
