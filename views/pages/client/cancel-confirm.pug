-
    var _dateStr = booking.date ? new Date(booking.date).toLocaleDateString('fr-FR', { weekday:'long', day:'2-digit', month:'long', year:'numeric' }) : ''

doctype html
html(lang="fr")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Annuler votre rendez-vous — BranShee
        //- Cette page ne modifie RIEN. L'annulation ne se produit qu'après un
        //- POST explicite via le bouton ci-dessous — jamais au simple chargement
        //- du lien (les aperçus de liens des messageries préchargent les URL et
        //- déclenchaient sinon des annulations, voire des prélèvements, fantômes).
        meta(name="robots" content="noindex, nofollow")
        style.
            body { margin:0; background:#f8fafc; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; }
            .cw { min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:32px 16px; }
            .card { background:#fff; border:1px solid #e5e7eb; border-radius:18px; padding:36px 32px; max-width:440px; width:100%; text-align:center; box-shadow:0 4px 24px rgba(0,0,0,.07); }
            .logo { display:inline-flex; align-items:center; gap:8px; text-decoration:none; margin-bottom:28px; }
            .logo img { width:34px; height:34px; border-radius:9px; }
            .logo span { font-size:15px; font-weight:700; color:#1e2923; }
            .icon { width:56px; height:56px; background:#fff7ed; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 18px; }
            .icon svg { stroke:#ea580c; }
            h1 { font-size:20px; font-weight:700; color:#111827; margin:0 0 8px; }
            .sub { font-size:14px; color:#6b7280; line-height:1.6; margin:0 0 22px; }
            .details { background:#f9fafb; border:1px solid #eef1f4; border-radius:12px; padding:16px 18px; text-align:left; margin-bottom:20px; }
            .details .svc { font-size:15px; font-weight:700; color:#111827; margin:0 0 4px; }
            .details .dt { font-size:13.5px; color:#4b5563; margin:0; text-transform:capitalize; }
            .fee { display:flex; align-items:flex-start; gap:9px; background:#fef2f2; border:1px solid #fecaca; border-radius:10px; padding:12px 14px; font-size:13px; font-weight:600; color:#b91c1c; margin-bottom:20px; text-align:left; line-height:1.5; }
            .fee svg { stroke:#b91c1c; flex-shrink:0; margin-top:1px; }
            .actions { display:flex; flex-direction:column; gap:10px; }
            .btn-danger { display:inline-flex; align-items:center; justify-content:center; gap:7px; background:#dc2626; color:#fff; padding:13px 24px; border:none; border-radius:10px; font-size:14.5px; font-weight:700; font-family:inherit; cursor:pointer; box-shadow:0 1px 3px rgba(220,38,38,.3); transition:background .15s; }
            .btn-danger:hover { background:#b91c1c; }
            .btn-danger:disabled { opacity:.6; cursor:wait; }
            .keep { display:inline-block; color:#374151; padding:11px 24px; border-radius:9px; text-decoration:none; font-size:14px; font-weight:600; }
            .keep:hover { text-decoration:underline; }
            .back { display:inline-block; background:#f3f4f6; color:#374151; padding:11px 24px; border-radius:9px; text-decoration:none; font-size:14px; font-weight:600; border:1px solid #e5e7eb; }

    body
        .cw
            a.logo(href="/")
                img(src="/images/icon.svg" alt="")
                span BranShee

            .card
                if alreadyCanceled
                    .icon
                        svg(viewBox="0 0 24 24" width="26" height="26" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                            circle(cx="12" cy="12" r="10")
                            line(x1="15" y1="9" x2="9" y2="15")
                            line(x1="9" y1="9" x2="15" y2="15")
                    h1 Rendez-vous déjà annulé
                    p.sub Ce rendez-vous a déjà été annulé. Aucune action supplémentaire n'est nécessaire.
                    a.back(href="/") ← Accueil
                else
                    .icon
                        svg(viewBox="0 0 24 24" width="26" height="26" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                            path(d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z")
                            line(x1="12" y1="9" x2="12" y2="13")
                            line(x1="12" y1="17" x2="12.01" y2="17")
                    h1 Annuler ce rendez-vous ?
                    p.sub Confirmez ci-dessous pour annuler définitivement votre rendez-vous.

                    .details
                        if booking.serviceName
                            p.svc= booking.serviceName
                        p.dt #{_dateStr} · #{booking.startTime}#{booking.endTime ? ' – ' + booking.endTime : ''}

                    if feeInfo
                        .fee
                            svg(viewBox="0 0 24 24" width="16" height="16" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                circle(cx="12" cy="12" r="10")
                                line(x1="12" y1="8" x2="12" y2="12")
                                line(x1="12" y1="16" x2="12.01" y2="16")
                            span Des frais d'annulation de #{feeInfo.amount} € (#{feeInfo.pct}%) seront prélevés sur votre carte, conformément à la politique de l'établissement.

                    form.actions(method="POST" action=`/cancel-booking/${booking._id}?token=${token}`)
                        button.btn-danger(type="submit")
                            svg(viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                polyline(points="3 6 5 6 21 6")
                                path(d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2")
                            | Confirmer l'annulation
                        a.keep(href="/") Garder mon rendez-vous
