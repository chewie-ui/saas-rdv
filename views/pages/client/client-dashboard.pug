block scripts
    script.
        (function() {
            var overlay = document.getElementById('cancelModalOverlay');
            var modal   = document.getElementById('cancelModal');
            var info    = document.getElementById('cancelModalInfo');
            var warning = document.getElementById('cancelModalWarning');
            var warnTxt = document.getElementById('cancelModalWarningText');
            var confirmBtn = document.getElementById('cancelModalConfirm');
            var closeBtn   = document.getElementById('cancelModalClose');

            function hoursUntil(dateStr, timeStr) {
                var d = new Date(dateStr);
                var parts = (timeStr || '00:00').split(':');
                d.setHours(parseInt(parts[0]), parseInt(parts[1]), 0, 0);
                return (d - Date.now()) / 3600000;
            }

            document.querySelectorAll('.js-cancel-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var href  = btn.dataset.href;
                    var name  = btn.dataset.name;
                    var date  = btn.dataset.date;
                    var time  = btn.dataset.time;
                    var rule  = btn.dataset.rule;
                    var price = parseFloat(btn.dataset.price) || 0;

                    // Recalculate hours from raw date/time (use data-href to extract booking id, but date/time is enough)
                    // We need the raw ISO date — re-fetch from the data attributes
                    var rawDate = btn.closest('.dash-card') ? btn.closest('.dash-card').dataset.bookingDate : null;
                    var hours = rawDate ? hoursUntil(rawDate, time) : 999;

                    // Build info text
                    info.innerHTML = '<strong>' + name + '</strong><br>' + date + ' à ' + time;

                    // Build warning
                    warning.style.display = 'none';
                    if (rule !== 'free' && price > 0) {
                        var fee = 0;
                        var msg = '';
                        if (rule === 'full_12h' && hours < 12) {
                            fee = price;
                            msg = '⚠️ Annulation moins de 12h avant le RDV — <strong>100 % du montant (' + price.toFixed(2) + ' €) sera prélevé</strong> conformément à la politique de l\'établissement.';
                        } else if ((rule === 'half_24h' || rule === 'full_12h') && hours < 24) {
                            fee = price * 0.5;
                            msg = '⚠️ Annulation moins de 24h avant le RDV — <strong>50 % du montant (' + fee.toFixed(2) + ' €) sera prélevé</strong> conformément à la politique de l\'établissement.';
                        }
                        if (msg) {
                            warnTxt.innerHTML = msg;
                            warning.style.display = 'flex';
                        }
                    }

                    confirmBtn.href = href;
                    overlay.style.display = 'flex';
                });
            });

            if (closeBtn) closeBtn.addEventListener('click', function() { overlay.style.display = 'none'; });
            if (overlay)  overlay.addEventListener('click', function(e) { if (e.target === overlay) overlay.style.display = 'none'; });

            // ── Copier l'adresse de l'établissement ─────────────────────
            function fallbackCopyText(text) {
                var ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                try { document.execCommand('copy'); } catch (_) {}
                ta.remove();
            }

            // ── Popup "Ajouter à l'agenda" ──────────────────────────────
            (function() {
                var calOverlay   = document.getElementById('calPopupOverlay');
                var calClose     = document.getElementById('calPopupClose');
                var calEventEl   = document.getElementById('calPopupEvent');
                var calGoogle    = document.getElementById('calOptGoogle');
                var calApple     = document.getElementById('calOptApple');
                var calOutlook   = document.getElementById('calOptOutlook');

                // Masquer Apple Calendar sur tout ce qui n'est pas macOS ou iOS
                // (sur PC Windows/Linux/Android → téléchargement inutile)
                var ua = navigator.userAgent || '';
                var isAppleDevice = /iPhone|iPad|iPod/i.test(ua) || (
                    /Macintosh/i.test(ua) && navigator.maxTouchPoints > 0
                ) || /Mac OS X/i.test(ua) && !/Android/i.test(ua) && !/Windows/i.test(ua);
                if (!isAppleDevice && calApple) calApple.style.display = 'none';

                function pad(n) { return String(n).padStart(2,'0'); }
                function toICSStamp(iso) {
                    // ISO → YYYYMMDDTHHmmssZ  (Stripe/UTC)
                    return iso.replace(/[-:]/g,'').replace(/\.\d{3}/,'').replace('T','T');
                }
                function generateICS(title, start, end, location, description) {
                    var uid = 'branshee-' + Date.now() + '@branshee.com';
                    var now = toICSStamp(new Date().toISOString());
                    var s   = toICSStamp(start);
                    var e   = toICSStamp(end);
                    return [
                        'BEGIN:VCALENDAR',
                        'VERSION:2.0',
                        'PRODID:-//BranShee//FR',
                        'CALSCALE:GREGORIAN',
                        'METHOD:PUBLISH',
                        'BEGIN:VEVENT',
                        'UID:' + uid,
                        'DTSTAMP:' + now,
                        'DTSTART:' + s,
                        'DTEND:' + e,
                        'SUMMARY:' + title.replace(/\n/g,' '),
                        'DESCRIPTION:' + (description || '').replace(/\n/g,'\\n'),
                        'LOCATION:' + (location || '').replace(/\n/g,' '),
                        'BEGIN:VALARM',
                        'ACTION:DISPLAY',
                        'DESCRIPTION:Rappel',
                        'TRIGGER:-PT1H',
                        'END:VALARM',
                        'END:VEVENT',
                        'END:VCALENDAR'
                    ].join('\r\n');
                }
                function openCalPopup(btn) {
                    var gcal     = btn.dataset.gcal;
                    var title    = btn.dataset.title    || 'Rendez-vous';
                    var start    = btn.dataset.start;
                    var end      = btn.dataset.end;
                    var location = btn.dataset.location || '';
                    var details  = btn.dataset.details  || '';
                    // Formatage de la date/heure pour l'aperçu
                    var sDate = new Date(start);
                    var opts  = { weekday:'long', day:'numeric', month:'long' };
                    var dateStr = sDate.toLocaleDateString('fr-FR', opts);
                    var timeStr = pad(sDate.getUTCHours()) + 'h' + pad(sDate.getUTCMinutes());
                    calEventEl.innerHTML = '<strong>' + title + '</strong>' + dateStr + ' à ' + timeStr + (location ? '<br>📍 ' + location : '');
                    // Google Calendar — URL directe
                    calGoogle.href = gcal;
                    calGoogle.removeAttribute('download');

                    // Apple Calendar — data URI sans download
                    // Sur iOS/macOS → ouvre Calendrier directement (aucun téléchargement)
                    // Sur Windows/Android → affiche le texte brut (acceptable)
                    var ics = generateICS(title, start, end, location, details);
                    calApple.href = 'data:text/calendar;charset=utf-8,' + encodeURIComponent(ics);
                    calApple.removeAttribute('download');

                    // Outlook Web — URL Outlook Live (comme Google Calendar, aucun fichier)
                    var startFmt = start.replace(/\.\d{3}Z$/, '').replace('Z','');
                    var endFmt   = end.replace(/\.\d{3}Z$/, '').replace('Z','');
                    calOutlook.href = 'https://outlook.live.com/calendar/0/action/compose'
                        + '?subject='   + encodeURIComponent(title)
                        + '&startdt='   + encodeURIComponent(startFmt)
                        + '&enddt='     + encodeURIComponent(endFmt)
                        + '&body='      + encodeURIComponent(details)
                        + '&location='  + encodeURIComponent(location)
                        + '&allday=false&path=%2Fcalendar%2Faction%2Fcompose&rru=addevent';
                    calOutlook.removeAttribute('download');
                    calOverlay.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                }
                function closeCalPopup() {
                    calOverlay.style.display = 'none';
                    document.body.style.overflow = '';
                }
                document.querySelectorAll('.js-add-cal').forEach(function(btn) {
                    btn.addEventListener('click', function() { openCalPopup(btn); });
                });
                if (calClose)   calClose.addEventListener('click', closeCalPopup);
                if (calOverlay) calOverlay.addEventListener('click', function(e) {
                    if (e.target === calOverlay) closeCalPopup();
                });
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape' && calOverlay && calOverlay.style.display !== 'none') closeCalPopup();
                });
            })();

            document.querySelectorAll('.js-copy-address').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var address = btn.dataset.address || '';
                    var span = btn.querySelector('span');

                    function showCopied() {
                        if (!span) return;
                        var orig = span.textContent;
                        span.textContent = '✓ Adresse copiée';
                        btn.disabled = true;
                        setTimeout(function() {
                            span.textContent = orig;
                            btn.disabled = false;
                        }, 2000);
                    }

                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(address).then(showCopied).catch(function() {
                            fallbackCopyText(address);
                            showCopied();
                        });
                    } else {
                        fallbackCopyText(address);
                        showCopied();
                    }
                });
            });
        })();
