extends ../../layouts/client

block links
    link(rel="stylesheet", href="/css/layouts/client-dashboard.css")

block content
    -
        function jourLong(d) { return new Date(d).toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' }); }
        function jourCourt(d) { return new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }); }
        var nbUp = bookings.upcoming.length;
        var nbPast = bookings.past.length;
        var nbAvis = (myReviews && myReviews.length) || 0;

    .ec-page
        //- ── En-tête ─────────────────────────────────────────────────────────
        //- Une salutation nommée plutôt qu'un simple compteur : c'est l'espace
        //- personnel du client, pas un tableau de bord d'administration.
        -
            //- Prénom seul : « Bonjour Quentin Rennies » sonne comme un
            //- publipostage. On coupe au premier espace, et on retombe sur un
            //- bonjour neutre si le nom manque.
            var _prenom = ((client && client.fullName) || '').trim().split(/\s+/)[0] || ''
        .ec-head
            .ec-head__txt
                p.ec-head__eyebrow Espace client
                h1.ec-head__title
                    if _prenom
                        = 'Bonjour ' + _prenom
                    else
                        | Bonjour
                p.ec-head__sub
                    if nbUp > 0
                        = nbUp > 1 ? `${nbUp} rendez-vous à venir.` : '1 rendez-vous à venir.'
                        |  Vous pouvez l'annuler depuis sa fiche.
                    else if nbPast > 0
                        = `Aucun rendez-vous à venir · ${nbPast} passé${nbPast > 1 ? 's' : ''}.`
                    else
                        | Aucun rendez-vous pour l'instant. Trouvez un professionnel près de chez vous.
            a.sm-btn.sm-btn--primary.ec-head__cta(href="/search")
                span.material-symbols-outlined(style="font-size:18px") add
                span Prendre rendez-vous

        //- ── Bannière « Devenez pro » ───────────────────────────────────────
        if canCreateEstablishment
            a.ec-pro(href="/demarrer")
                span.ec-pro__ic
                    span.material-symbols-outlined storefront
                .ec-pro__txt
                    span.ec-pro__badge Nouveau
                    span.ec-pro__title Vous êtes un professionnel ?
                    span.ec-pro__sub Créez votre page de réservation, vos clients réservent seuls 24h/24. Gratuit, en 1 minute.
                span.material-symbols-outlined.ec-pro__arrow chevron_right

        //- ── Navigation commune (onglets) ───────────────────────────────────
        .ds-tabs(role="tablist")
            button.ds-tab.is-active(type="button" role="tab" data-ec-tab="rdv")
                | Rendez-vous
                if nbUp > 0
                    span.ds-tab__count= nbUp
            button.ds-tab(type="button" role="tab" data-ec-tab="hist")
                | Historique
                if nbPast > 0
                    span.ds-tab__count= nbPast
            button.ds-tab(type="button" role="tab" data-ec-tab="avis")
                | Avis
                if nbAvis > 0
                    span.ds-tab__count= nbAvis

        //- ══ Onglet : Rendez-vous à venir (belles cartes) ═══════════════════
        .ds-panel.is-active#panel-rdv
            if nbUp > 0
                .ec-cards
                    each b in bookings.upcoming
                        -
                            var addrFull = [b.companyAddr, b.companyZip, b.companyCity].filter(Boolean).join(', ')
                            var mapsUrl = b.companyLat && b.companyLon
                                ? `https://www.google.com/maps?q=${b.companyLat},${b.companyLon}`
                                : addrFull ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addrFull)}` : null
                            var gcalStart = new Date(b.date)
                            var sp = (b.startTime || '00:00').split(':')
                            gcalStart.setHours(parseInt(sp[0], 10) || 0, parseInt(sp[1], 10) || 0, 0, 0)
                            var gcalEnd = new Date(b.date)
                            var ep = (b.endTime || b.startTime || '00:00').split(':')
                            gcalEnd.setHours(parseInt(ep[0], 10) || 0, parseInt(ep[1], 10) || 0, 0, 0)
                            function toGCalStamp(d) { return d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z' }
                            var gcalTitle = 'RDV — ' + b.companyName + (b.serviceName ? ' (' + b.serviceName + ')' : '')
                            var gcalDetails = 'Rendez-vous réservé via BranShee' + (b.employeeName ? ' avec ' + b.employeeName : '') + '.'
                            var gcalUrl = 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=' + encodeURIComponent(gcalTitle) + '&dates=' + toGCalStamp(gcalStart) + '/' + toGCalStamp(gcalEnd) + '&details=' + encodeURIComponent(gcalDetails) + '&location=' + encodeURIComponent(addrFull || b.companyName)
                            var _validPhone = function(v) { return v && v !== 'on' && /[\d+]/.test(v) }
                            var _validUrl = function(v) { return v && /^https?:\/\//.test(v) }
                        .ec-card.ec-card--next(data-booking-date=new Date(b.date).toISOString())
                            .ec-card__top
                                //- Pastille de date : le jour et l'heure sont ce
                                //- qu'on vient vérifier ici. La photo du salon les
                                //- reléguait au second plan — on la garde plus bas,
                                //- dans la ligne d'identité.
                                -
                                    var _d = new Date(b.date);
                                    var _jj = _d.toLocaleDateString('fr-FR', { weekday: 'short' }).replace(/\.$/, '');
                                .ec-date
                                    span.ec-date__wd= _jj
                                    span.ec-date__n= _d.getDate()
                                    span.ec-date__h= b.startTime
                                .ec-card__id
                                    .ec-card__head
                                        span.ec-card__pro= b.companyName
                                        //- Un rendez-vous à venir non annulé EST
                                        //- confirmé : le dire évite au client de se
                                        //- demander s'il doit rappeler.
                                        if b.status !== 'canceled'
                                            span.ec-chip-ok Confirmé
                                        if b.companyType
                                            span.ec-card__type= b.companyType
                                    if b.serviceName
                                        span.ec-card__svc
                                            span.material-symbols-outlined sell
                                            span= b.serviceName
                                .ec-when
                                    span.material-symbols-outlined event
                                    .ec-when__txt
                                        span.ec-when__d= jourLong(b.date)
                                        span.ec-when__t= `${b.startTime} — ${b.endTime}`
                            .ec-card__info
                                if b.employeeName
                                    .ec-meta
                                        span.material-symbols-outlined person
                                        span= b.employeeName
                                if addrFull
                                    .ec-meta
                                        span.material-symbols-outlined location_on
                                        span= addrFull
                                if _validPhone(b.companyPhone)
                                    a.ec-meta.ec-meta--link(href=`tel:${b.companyPhone.replace(/[^\d+]/g, '')}`)
                                        span.material-symbols-outlined call
                                        span= b.companyPhone
                                if b.companyEmail && b.companyEmail.indexOf('@') !== -1
                                    a.ec-meta.ec-meta--link(href=`mailto:${b.companyEmail}`)
                                        span.material-symbols-outlined mail
                                        span= b.companyEmail
                                if _validUrl(b.companyWebsite)
                                    a.ec-meta.ec-meta--link(href=b.companyWebsite target="_blank" rel="noopener")
                                        span.material-symbols-outlined language
                                        span= b.companyWebsite.replace(/^https?:\/\//, '').replace(/\/$/, '')
                            .ec-card__foot
                                if b.companySlug
                                    a.sm-btn.sm-btn--primary(href=`/${b.companySlug}`)
                                        span.material-symbols-outlined(style="font-size:16px") event_available
                                        span Réserver à nouveau
                                if mapsUrl
                                    a.sm-btn.sm-btn--ghost(href=mapsUrl target="_blank" rel="noopener")
                                        span.material-symbols-outlined(style="font-size:16px") location_on
                                        span Voir l'adresse
                                button.sm-btn.sm-btn--ghost.js-add-cal(
                                    type="button"
                                    data-gcal=gcalUrl
                                    data-title=gcalTitle
                                    data-start=gcalStart.toISOString()
                                    data-end=gcalEnd.toISOString()
                                    data-location=(addrFull || b.companyName || '')
                                    data-details=gcalDetails
                                )
                                    span.material-symbols-outlined(style="font-size:16px") calendar_add_on
                                    span Ajouter à l'agenda
                                //- Déplacer plutôt qu'annuler-puis-reréserver :
                                //- entre les deux, le créneau repartait au
                                //- public et se faisait souvent reprendre.
                                button.sm-btn.sm-btn--ghost.js-move-btn(
                                    type="button"
                                    data-id=String(b._id)
                                    data-token=b.cancelToken
                                    data-name=b.companyName
                                    data-service=(b.serviceName || '')
                                    data-current=`${jourLong(b.date)} à ${b.startTime}`
                                )
                                    span.material-symbols-outlined(style="font-size:16px") event_repeat
                                    span Déplacer
                                button.sm-btn.sm-btn--danger.js-cancel-btn.ec-card__cancel(
                                    type="button"
                                    data-href=`/cancel-booking/${b._id}?token=${b.cancelToken}`
                                    data-name=b.companyName
                                    data-date=jourLong(b.date)
                                    data-time=b.startTime
                                    data-rule=b.cancellationRule
                                    data-price=(b.payment && b.payment.amount ? b.payment.amount : 0)
                                )
                                    span.material-symbols-outlined(style="font-size:16px") close
                                    span Annuler
            else
                .ec-empty
                    span.ec-empty__ic
                        span.material-symbols-outlined event_upcoming
                    p.ec-empty__title Aucun rendez-vous à venir
                    p.ec-empty__sub Prenez rendez-vous en quelques clics avec un professionnel.
                    a.sm-btn.sm-btn--primary(href="/search")
                        span.material-symbols-outlined(style="font-size:18px") search
                        span Trouver un professionnel

        //- ══ Onglet : Historique ════════════════════════════════════════════
        .ds-panel#panel-hist
            if nbPast > 0
                //- Une LISTE et non un tableau à cinq colonnes : sur un
                //- historique, la seule question est « quand, chez qui, quoi ».
                //- Les deux actions étaient enfouies sous un menu « ⋮ » — elles
                //- sont désormais visibles, ce qui retire un clic à la seule
                //- chose qu'on vient y faire.
                .ec-hist
                    each b in bookings.past
                        -
                            var estAnnule = b.status === 'canceled'
                            var dejaAvis = reviewedCompanyIds && reviewedCompanyIds.includes(String(b.company))
                            var prix = b.payment && b.payment.amount ? b.payment.amount : null
                        .ec-hist__row(class=estAnnule ? 'is-canceled' : '')
                            span.ec-hist__date= jourCourt(b.date)
                            .ec-hist__who
                                span.ec-hist__pro= b.companyName
                                if estAnnule
                                    span.ec-hist__chip Annulé
                            span.ec-hist__svc
                                if b.serviceName
                                    = b.serviceName
                                if b.serviceName && prix
                                    |  ·
                                if prix
                                    = ' ' + prix + ' €'
                            .ec-hist__act
                                //- Un avis ne se laisse qu'une fois, et jamais
                                //- sur un rendez-vous annulé — on n'y est pas allé.
                                if b.companySlug && !dejaAvis && !estAnnule
                                    a.ec-hist__btn(href=`/${b.companySlug}#avis`) Laisser un avis
                                else if dejaAvis
                                    span.ec-hist__done Avis déposé
                                if b.companySlug && !estAnnule
                                    a.ec-hist__btn.ec-hist__btn--again(href=`/${b.companySlug}`) Reprendre rdv
            else
                .ec-empty
                    span.ec-empty__ic
                        span.material-symbols-outlined history
                    p.ec-empty__title Aucun rendez-vous passé
                    p.ec-empty__sub Votre historique de rendez-vous apparaîtra ici.

        //- ══ Onglet : Avis ══════════════════════════════════════════════════
        .ds-panel#panel-avis
            if nbAvis > 0
                .ds-table-wrap
                    table.ds-table.ec-table
                        thead
                            tr
                                th Professionnel
                                th Note
                                th Commentaire
                                th.ds-th--right
                        tbody
                            each r in myReviews
                                tr
                                    td
                                        .ds-person
                                            img.ds-person__img(src=r.companyPhoto alt=r.companyName)
                                            .ds-person__txt
                                                span.ds-person__name= r.companyName
                                    td
                                        .ec-stars
                                            - for (var s = 1; s <= 5; s++)
                                                span.material-symbols-outlined(class=s <= r.rating ? 'is-on' : '') star
                                    td
                                        if r.comment
                                            span.ec-comment "#{r.comment}"
                                        else
                                            span.ec-dash —
                                    td.ds-td--actions
                                        a.ds-ico(href=`/${r.companySlug}#avis` title="Voir l'établissement")
                                            span.material-symbols-outlined open_in_new
            else
                .ec-empty
                    span.ec-empty__ic
                        span.material-symbols-outlined reviews
                    p.ec-empty__title Aucun avis pour l'instant
                    p.ec-empty__sub Après votre prochain rendez-vous, partagez votre expérience !

    //- ── Popup « Ajouter à l'agenda » ───────────────────────────────────────
    .cal-popup-overlay#calPopupOverlay(style="display:none")
        .cal-popup#calPopup
            .cal-popup__header
                span.cal-popup__title
                    span.material-symbols-outlined(style="font-size:20px;vertical-align:-4px;margin-right:6px") calendar_add_on
                    | Ajouter à l'agenda
                button.cal-popup__close#calPopupClose(type="button" aria-label="Fermer")
                    span.material-symbols-outlined close
            .cal-popup__event#calPopupEvent
            .cal-popup__options
                a.cal-opt#calOptGoogle(href="#" target="_blank" rel="noopener")
                    .cal-opt__icon.cal-opt__icon--google
                        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="24" height="24")
                            path(fill="#EA4335" d="M24 9.5c3.1 0 5.8 1.1 8 2.9l6-6C34.5 3.1 29.6 1 24 1 14.8 1 7 6.7 3.7 14.7l7 5.4C12.4 14 17.7 9.5 24 9.5z")
                            path(fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.4c-.5 2.8-2.1 5.1-4.4 6.7l7 5.4c4.1-3.8 6.5-9.4 6.5-16.1z")
                            path(fill="#FBBC05" d="M10.7 28.6C10.3 27.4 10 26.2 10 25s.3-2.4.7-3.5l-7-5.4C2.6 18.6 2 21.7 2 25s.6 6.4 1.7 9.2l7-5.6z")
                            path(fill="#34A853" d="M24 47c5.6 0 10.3-1.8 13.7-5l-7-5.4c-1.9 1.3-4.3 2-6.7 2-6.3 0-11.6-4.3-13.3-10l-7 5.4C7 40.3 14.8 47 24 47z")
                    .cal-opt__text
                        strong Google Calendar
                        span Synchronisez avec Gmail
                a.cal-opt#calOptApple(href="#" download="rdv-branshee.ics")
                    .cal-opt__icon.cal-opt__icon--apple
                        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor")
                            path(d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z")
                    .cal-opt__text
                        strong Apple Calendar
                        span iPhone · Mac · iPad
                a.cal-opt#calOptOutlook(href="#" target="_blank" rel="noopener")
                    .cal-opt__icon.cal-opt__icon--outlook
                        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="24" height="24")
                            path(fill="#1565C0" d="M29 8H44a1 1 0 011 1v30a1 1 0 01-1 1H29V8z")
                            path(fill="#1E88E5" d="M5 8H29V40H5z")
                            path(fill="#fff" d="M17 16c-3.3 0-6 2.7-6 6s2.7 6 6 6 6-2.7 6-6-2.7-6-6-6zm0 10c-2.2 0-4-1.8-4-4s1.8-4 4-4 4 1.8 4 4-1.8 4-4 4z")
                            path(fill="#fff" d="M33 18h-2v4h-4v2h4v4h2v-4h4v-2h-4z")
                    .cal-opt__text
                        strong Outlook
                        span Outlook.com · Microsoft 365

    //- ── Boîte de report ────────────────────────────────────────────────────
    //- Réutilise l'habillage `.cancel-modal-*` déjà stylé plutôt que d'ouvrir
    //- un troisième vocabulaire de modale sur la même page.
    .cancel-modal-overlay#moveOverlay(style="display:none")
        .cancel-modal#moveModal
            h3.cancel-modal__title Déplacer le rendez-vous
            p.cancel-modal__info#moveInfo
            .mv-field
                label.mv-label(for="moveDate") Nouvelle date
                input.mv-date#moveDate(type="date")
            p.mv-status#moveStatus Choisissez une date pour voir les créneaux libres.
            .mv-slots#moveSlots
            .cancel-modal__actions
                button.sm-btn.sm-btn--primary#moveConfirm(type="button" disabled) Confirmer le déplacement
                button.sm-btn.sm-btn--ghost#moveClose(type="button") Annuler

    //- ── Modal annulation ───────────────────────────────────────────────────
    .cancel-modal-overlay#cancelModalOverlay(style="display:none")
        .cancel-modal#cancelModal
            .cancel-modal__icon
                span.material-symbols-outlined(style="font-size:26px") error
            h3.cancel-modal__title Annuler ce rendez-vous ?
            .cancel-modal__info#cancelModalInfo
            .cancel-modal__warning#cancelModalWarning(style="display:none")
                span.material-symbols-outlined(style="font-size:16px") warning
                span#cancelModalWarningText
            .cancel-modal__actions
                a.sm-btn.sm-btn--danger#cancelModalConfirm(href="#") Oui, annuler
                button.sm-btn.sm-btn--ghost#cancelModalClose(type="button") Garder mon RDV

block scripts
    script(src="/js/layouts/client/move-booking.js" defer)
    script.
        (function() {
            /* ── Onglets ─────────────────────────────────────────────────── */
            var tabs   = Array.prototype.slice.call(document.querySelectorAll('.ds-tab[data-ec-tab]'));
            var panels = { rdv: document.getElementById('panel-rdv'), hist: document.getElementById('panel-hist'), avis: document.getElementById('panel-avis') };
            function showTab(key) {
                tabs.forEach(function(t){ t.classList.toggle('is-active', t.dataset.ecTab === key); });
                Object.keys(panels).forEach(function(k){ if (panels[k]) panels[k].classList.toggle('is-active', k === key); });
            }
            tabs.forEach(function(t){ t.addEventListener('click', function(){ showTab(t.dataset.ecTab); }); });
            /* Ouvre l'onglet Avis si on arrive avec #avis */
            if (location.hash === '#avis') showTab('avis');

            /* ── Menus « ⋮ » ─────────────────────────────────────────────── */
            document.addEventListener('click', function(e) {
                var btn = e.target.closest('[data-ec-menu]');
                var ouverts = document.querySelectorAll('.ds-menu.is-open');
                if (!btn) { ouverts.forEach(function(m){ m.classList.remove('is-open'); }); return; }
                e.stopPropagation();
                var menu = btn.closest('.ds-menu');
                var etait = menu.classList.contains('is-open');
                ouverts.forEach(function(m){ m.classList.remove('is-open'); });
                if (!etait) menu.classList.add('is-open');
            });

            /* ── Modal annulation ────────────────────────────────────────── */
            var overlay = document.getElementById('cancelModalOverlay');
            var info    = document.getElementById('cancelModalInfo');
            var warning = document.getElementById('cancelModalWarning');
            var warnTxt = document.getElementById('cancelModalWarningText');
            var confirmBtn = document.getElementById('cancelModalConfirm');
            var closeBtn   = document.getElementById('cancelModalClose');

            function hoursUntil(dateStr, timeStr) {
                var d = new Date(dateStr);
                var parts = (timeStr || '00:00').split(':');
                d.setHours(parseInt(parts[0]), parseInt(parts[1]), 0, 0);
                return (d - Date.now()) / 3600000;
            }

            document.querySelectorAll('.js-cancel-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var menu = btn.closest('.ds-menu'); if (menu) menu.classList.remove('is-open');
                    var href  = btn.dataset.href;
                    var name  = btn.dataset.name;
                    var date  = btn.dataset.date;
                    var time  = btn.dataset.time;
                    var rule  = btn.dataset.rule;
                    var price = parseFloat(btn.dataset.price) || 0;
                    var rowEl = btn.closest('[data-booking-date]');
                    var rawDate = rowEl ? rowEl.dataset.bookingDate : null;
                    var hours = rawDate ? hoursUntil(rawDate, time) : 999;

                    info.innerHTML = '<strong>' + name + '</strong><br>' + date + ' à ' + time;

                    warning.style.display = 'none';
                    if (rule !== 'free' && price > 0) {
                        var msg = '';
                        if (rule === 'full_12h' && hours < 12) {
                            msg = 'Annulation moins de 12h avant le RDV — <strong>100 % du montant (' + price.toFixed(2) + ' €) sera prélevé</strong> conformément à la politique de l\'établissement.';
                        } else if ((rule === 'half_24h' || rule === 'full_12h') && hours < 24) {
                            msg = 'Annulation moins de 24h avant le RDV — <strong>50 % du montant (' + (price * 0.5).toFixed(2) + ' €) sera prélevé</strong> conformément à la politique de l\'établissement.';
                        }
                        if (msg) { warnTxt.innerHTML = msg; warning.style.display = 'flex'; }
                    }

                    confirmBtn.dataset.action = href;
                    overlay.style.display = 'flex';
                });
            });

            if (confirmBtn) confirmBtn.addEventListener('click', function(e) {
                e.preventDefault();
                var action = confirmBtn.dataset.action;
                if (!action) return;
                confirmBtn.textContent = 'Annulation…';
                confirmBtn.style.pointerEvents = 'none';
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = action;
                document.body.appendChild(form);
                form.submit();
            });

            if (closeBtn) closeBtn.addEventListener('click', function() { overlay.style.display = 'none'; });
            if (overlay)  overlay.addEventListener('click', function(e) { if (e.target === overlay) overlay.style.display = 'none'; });

            /* ── Popup « Ajouter à l'agenda » ────────────────────────────── */
            (function() {
                var calOverlay = document.getElementById('calPopupOverlay');
                var calClose   = document.getElementById('calPopupClose');
                var calEventEl = document.getElementById('calPopupEvent');
                var calGoogle  = document.getElementById('calOptGoogle');
                var calApple   = document.getElementById('calOptApple');
                var calOutlook = document.getElementById('calOptOutlook');

                var ua = navigator.userAgent || '';
                var isAppleDevice = /iPhone|iPad|iPod/i.test(ua) || (/Macintosh/i.test(ua) && navigator.maxTouchPoints > 0) || /Mac OS X/i.test(ua) && !/Android/i.test(ua) && !/Windows/i.test(ua);
                if (!isAppleDevice && calApple) calApple.style.display = 'none';

                function pad(n) { return String(n).padStart(2,'0'); }
                function toICSStamp(iso) { return iso.replace(/[-:]/g,'').replace(/\.\d{3}/,'').replace('T','T'); }
                function generateICS(title, start, end, location, description) {
                    var uid = 'branshee-' + Date.now() + '@branshee.com';
                    return ['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//BranShee//FR','CALSCALE:GREGORIAN','METHOD:PUBLISH','BEGIN:VEVENT','UID:'+uid,'DTSTAMP:'+toICSStamp(new Date().toISOString()),'DTSTART:'+toICSStamp(start),'DTEND:'+toICSStamp(end),'SUMMARY:'+title.replace(/\n/g,' '),'DESCRIPTION:'+(description||'').replace(/\n/g,'\\n'),'LOCATION:'+(location||'').replace(/\n/g,' '),'BEGIN:VALARM','ACTION:DISPLAY','DESCRIPTION:Rappel','TRIGGER:-PT1H','END:VALARM','END:VEVENT','END:VCALENDAR'].join('\r\n');
                }
                function openCalPopup(btn) {
                    var menu = btn.closest('.ds-menu'); if (menu) menu.classList.remove('is-open');
                    var gcal = btn.dataset.gcal, title = btn.dataset.title || 'Rendez-vous', start = btn.dataset.start, end = btn.dataset.end, location = btn.dataset.location || '', details = btn.dataset.details || '';
                    var sDate = new Date(start);
                    var dateStr = sDate.toLocaleDateString('fr-FR', { weekday:'long', day:'numeric', month:'long' });
                    var timeStr = pad(sDate.getUTCHours()) + 'h' + pad(sDate.getUTCMinutes());
                    calEventEl.innerHTML = '<strong>' + title + '</strong>' + dateStr + ' à ' + timeStr + (location ? '<br>📍 ' + location : '');
                    calGoogle.href = gcal; calGoogle.removeAttribute('download');
                    var ics = generateICS(title, start, end, location, details);
                    calApple.href = 'data:text/calendar;charset=utf-8,' + encodeURIComponent(ics); calApple.removeAttribute('download');
                    var startFmt = start.replace(/\.\d{3}Z$/, '').replace('Z',''), endFmt = end.replace(/\.\d{3}Z$/, '').replace('Z','');
                    calOutlook.href = 'https://outlook.live.com/calendar/0/action/compose?subject=' + encodeURIComponent(title) + '&startdt=' + encodeURIComponent(startFmt) + '&enddt=' + encodeURIComponent(endFmt) + '&body=' + encodeURIComponent(details) + '&location=' + encodeURIComponent(location) + '&allday=false&path=%2Fcalendar%2Faction%2Fcompose&rru=addevent';
                    calOutlook.removeAttribute('download');
                    calOverlay.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                }
                function closeCalPopup() { calOverlay.style.display = 'none'; document.body.style.overflow = ''; }
                document.querySelectorAll('.js-add-cal').forEach(function(btn) { btn.addEventListener('click', function() { openCalPopup(btn); }); });
                if (calClose)   calClose.addEventListener('click', closeCalPopup);
                if (calOverlay) calOverlay.addEventListener('click', function(e) { if (e.target === calOverlay) closeCalPopup(); });
                document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && calOverlay && calOverlay.style.display !== 'none') closeCalPopup(); });
            })();
        })();
