extends ../../layouts/client

block links
    link(rel="stylesheet", href="/css/layouts/client-dashboard.css")

block content

    //- ── En-tête ─────────────────────────────────────────────────
    .dash-header
        .dash-header__left
            h1 Mes rendez-vous
            if bookings.upcoming.length > 0
                p.dash-header__sub #{bookings.upcoming.length} à venir · #{bookings.past.length} passé#{bookings.past.length > 1 ? 's' : ''}
            else
                p.dash-header__sub Aucun rendez-vous à venir
        a.sm-btn.sm-btn--primary.dash-header__cta(href="/")
            svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                path(d="M440-280h80v-240h-80v240Zm40-320q17 0 28.5-11.5T520-640q0-17-11.5-28.5T480-680q-17 0-28.5 11.5T440-640q0 17 11.5 28.5T480-600Zm0 520q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
            span Réserver

    //- ── État vide ───────────────────────────────────────────────
    if bookings.upcoming.length === 0 && bookings.past.length === 0
        .dash-empty
            svg(xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px")
                path(d="M224.62-120q-27.62 0-46.12-18.5Q160-157 160-184.62v-510.76q0-27.62 18.5-46.12Q197-760 224.62-760h70.76v-89.23h43.08V-760h286.16v-89.23h40V-760h70.76q27.62 0 46.12 18.5Q800-723 800-695.38v510.76q0 27.62-18.5 46.12Q763-120 735.38-120H224.62Z")
            p Aucun rendez-vous trouvé
            p Prenez votre premier rendez-vous en quelques clics.
            a.sm-btn.sm-btn--primary(href="/") Trouver un professionnel

    //- ── Section À venir ─────────────────────────────────────────
    if bookings.upcoming.length > 0
        .dash-section
            .dash-section__title
                svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                    path(d="m612-292 56-56-128-128v-184h-80v216l152 152ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                h2 À venir
                span.dash-section__count= bookings.upcoming.length
            .dash-cards
                each b in bookings.upcoming
                    .dash-card.dash-card--upcoming
                        //- Photo de l'établissement
                        .dash-card__cover
                            img(
                                src=b.company ? (b.company.businessPicture || b.company.profilePicture || '/images/no-user.webp') : '/images/no-user.webp'
                                alt=b.company ? (b.company.businessName || b.company.fullName) : 'Professionnel'
                            )
                            span.dash-card__status-dot
                        //- Infos
                        .dash-card__body
                            .dash-card__top
                                .dash-card__pro= b.company ? (b.company.businessName || b.company.fullName) : 'Professionnel'
                                if b.company && b.company.businessType
                                    span.dash-card__biz-type= b.company.businessType
                                if b.company && b.company.description
                                    p.dash-card__desc= b.company.description.length > 80 ? b.company.description.slice(0, 80) + '…' : b.company.description
                            .dash-card__meta
                                .dash-card__meta-row
                                    svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                        path(d="M200-640h560v-80H200v80Zm0 0v-80 80Zm0 560q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T800-120H200Zm0-80h560v-400H200v400Z")
                                    span= new Date(b.date).toLocaleDateString('fr-FR', {weekday: 'long', day: 'numeric', month: 'long'})
                                .dash-card__meta-row
                                    svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                        path(d="m612-292 56-56-128-128v-184h-80v216l152 152ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                                    span= `${b.startTime} — ${b.endTime}`
                        //- Actions
                        .dash-card__actions
                            if b.companySlug
                                a.sm-btn.sm-btn--ghost.dash-card__see-btn(href=`/${b.companySlug}`)
                                    svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                        path(d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z")
                                    span Voir l'établissement
                            a.sm-btn.sm-btn--danger-ghost(
                                href=`/cancel-booking/${b._id}?token=${b.cancelToken}`
                                onclick="return confirm('Annuler ce rendez-vous ?')"
                            )
                                svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                    path(d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z")
                                span Annuler

    //- ── Section Historique ───────────────────────────────────────
    if bookings.past.length > 0
        .dash-section
            .dash-section__title
                svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                    path(d="M480-120q-138 0-240.5-91.5T122-440h82q14 104 92.5 172T480-200q117 0 198.5-81.5T760-480q0-117-81.5-198.5T480-760q-69 0-129 32t-101 88h110v80H120v-240h80v94q51-64 124.5-99T480-840q75 0 140.5 28.5t114 77q48.5 48.5 77 114T840-480q0 75-28.5 140.5t-77 114q-48.5 48.5-114 77T480-120Z")
                h2 Historique
                span.dash-section__count= bookings.past.length
            .dash-cards
                each b in bookings.past
                    .dash-card(class=b.status === 'canceled' ? 'dash-card--canceled' : '')
                        .dash-card__cover
                            img(
                                src=b.company ? (b.company.businessPicture || b.company.profilePicture || '/images/no-user.webp') : '/images/no-user.webp'
                                alt=b.company ? (b.company.businessName || b.company.fullName) : 'Professionnel'
                            )
                        .dash-card__body
                            .dash-card__top
                                .dash-card__pro= b.company ? (b.company.businessName || b.company.fullName) : 'Professionnel'
                                if b.company && b.company.businessType
                                    span.dash-card__biz-type= b.company.businessType
                            .dash-card__meta
                                .dash-card__meta-row
                                    svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                        path(d="M200-640h560v-80H200v80Zm0 0v-80 80Zm0 560q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T800-120H200Zm0-80h560v-400H200v400Z")
                                    span= new Date(b.date).toLocaleDateString('fr-FR', {day: 'numeric', month: 'long', year: 'numeric'})
                                .dash-card__meta-row
                                    svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                        path(d="m612-292 56-56-128-128v-184h-80v216l152 152ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                                    span= `${b.startTime} — ${b.endTime}`
                            span.dash-badge(class=b.status === 'canceled' ? 'dash-badge--canceled' : 'dash-badge--past')
                                = b.status === 'canceled' ? 'Annulé' : 'Passé'
                        if b.companySlug && b.status !== 'canceled'
                            .dash-card__actions
                                a.sm-btn.sm-btn--ghost.dash-card__see-btn(href=`/${b.companySlug}`)
                                    svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                        path(d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z")
                                    span Réserver à nouveau
