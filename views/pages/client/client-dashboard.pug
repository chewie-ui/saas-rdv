extends ../../layouts/client

block links
    link(rel="stylesheet", href="/css/layouts/client-dashboard.css")

block content

    //- ── En-tête ─────────────────────────────────────────────────
    .dash-header
        .dash-header__left
            h1 Mes rendez-vous
            if bookings.upcoming.length > 0
                p.dash-header__sub #{bookings.upcoming.length} à venir · #{bookings.past.length} passé#{bookings.past.length > 1 ? 's' : ''}
            else
                p.dash-header__sub Aucun rendez-vous à venir
        a.sm-btn.sm-btn--primary.dash-header__cta(href="/")
            svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                path(d="M440-280h80v-240h-80v240Zm40-320q17 0 28.5-11.5T520-640q0-17-11.5-28.5T480-680q-17 0-28.5 11.5T440-640q0 17 11.5 28.5T480-600Zm0 520q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
            span Réserver

    //- ── État vide ───────────────────────────────────────────────
    if bookings.upcoming.length === 0 && bookings.past.length === 0
        .dash-empty
            svg(xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px")
                path(d="M224.62-120q-27.62 0-46.12-18.5Q160-157 160-184.62v-510.76q0-27.62 18.5-46.12Q197-760 224.62-760h70.76v-89.23h43.08V-760h286.16v-89.23h40V-760h70.76q27.62 0 46.12 18.5Q800-723 800-695.38v510.76q0 27.62-18.5 46.12Q763-120 735.38-120H224.62Z")
            p Aucun rendez-vous trouvé
            p Prenez votre premier rendez-vous en quelques clics.
            a.sm-btn.sm-btn--primary(href="/") Trouver un professionnel

    //- ── Section À venir ─────────────────────────────────────────
    if bookings.upcoming.length > 0
        .dash-section
            .dash-section__title
                svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                    path(d="m612-292 56-56-128-128v-184h-80v216l152 152ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                h2 À venir
                span.dash-section__count= bookings.upcoming.length
            .dash-cards
                each b in bookings.upcoming
                    .dash-card.dash-card--upcoming(data-booking-date=new Date(b.date).toISOString())
                        //- Photo de l'établissement
                        .dash-card__cover
                            img(src=b.companyPhoto alt=b.companyName)
                            span.dash-card__status-dot
                        //- Infos
                        .dash-card__body
                            .dash-card__top
                                .dash-card__pro= b.companyName
                                if b.companyType
                                    span.dash-card__biz-type= b.companyType
                            .dash-card__meta
                                if b.serviceName
                                    .dash-card__meta-row
                                        svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                            path(d="M160-120v-480l320-240 320 240v480H560v-280H400v280H160Z")
                                        span= b.serviceName
                                if b.employeeName
                                    .dash-card__meta-row
                                        svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                            path(d="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 128.5-46.5T480-440q66 0 132.5 15.5T741-378q29 15 46.5 43.5T805-272v112H160Z")
                                        span= b.employeeName
                                .dash-card__meta-row
                                    svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                        path(d="M200-640h560v-80H200v80Zm0 0v-80 80Zm0 560q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T800-120H200Zm0-80h560v-400H200v400Z")
                                    span= new Date(b.date).toLocaleDateString('fr-FR', {weekday: 'long', day: 'numeric', month: 'long'})
                                .dash-card__meta-row
                                    svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                        path(d="m612-292 56-56-128-128v-184h-80v216l152 152ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                                    span= `${b.startTime} — ${b.endTime}`
                                -
                                    var addrFull = [b.companyAddr, b.companyZip, b.companyCity].filter(Boolean).join(', ')
                                    var mapsUrl = b.companyLat && b.companyLon
                                        ? `https://www.google.com/maps?q=${b.companyLat},${b.companyLon}`
                                        : addrFull ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addrFull)}` : null
                                    var gcalStart = new Date(b.date)
                                    var gcalStartParts = (b.startTime || '00:00').split(':')
                                    gcalStart.setHours(parseInt(gcalStartParts[0], 10) || 0, parseInt(gcalStartParts[1], 10) || 0, 0, 0)
                                    var gcalEnd = new Date(b.date)
                                    var gcalEndParts = (b.endTime || b.startTime || '00:00').split(':')
                                    gcalEnd.setHours(parseInt(gcalEndParts[0], 10) || 0, parseInt(gcalEndParts[1], 10) || 0, 0, 0)
                                    function toGCalStamp(d) { return d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z' }
                                    var gcalTitle = 'RDV — ' + b.companyName + (b.serviceName ? ' (' + b.serviceName + ')' : '')
                                    var gcalDetails = 'Rendez-vous réservé via BranShee' + (b.employeeName ? ' avec ' + b.employeeName : '') + '.'
                                    var gcalUrl = 'https://calendar.google.com/calendar/render?action=TEMPLATE'
                                        + '&text=' + encodeURIComponent(gcalTitle)
                                        + '&dates=' + toGCalStamp(gcalStart) + '/' + toGCalStamp(gcalEnd)
                                        + '&details=' + encodeURIComponent(gcalDetails)
                                        + '&location=' + encodeURIComponent(addrFull || b.companyName)
                                if addrFull
                                    .dash-card__meta-row.dash-card__meta-row--addr
                                        svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                            path(d="M480-480q33 0 56.5-23.5T560-560q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 33 23.5 56.5T480-480Zm0 294q122-112 181-203.5T720-560q0-117-75.5-188.5T480-820q-89 0-164.5 71.5T240-560q0 71 59 162.5T480-186Z")
                                        span.dash-card__addr= addrFull
                                -
                                    var _validPhone = function(v) { return v && v !== 'on' && /[\d+]/.test(v) }
                                    var _validUrl   = function(v) { return v && /^https?:\/\//.test(v) }
                                    var _hasContact = _validPhone(b.companyPhone) || (b.companyEmail && b.companyEmail.indexOf('@') !== -1) || _validUrl(b.companyWebsite)
                            //- ── Coordonnées de l'établissement ──────────────────────────
                            //- Toujours visible : affiche téléphone/email/site quand ils
                            //- existent, ou un lien "Voir la fiche" quand rien n'est
                            //- renseigné ("il faut que on voit les informations de
                            //- l'établissement … il faut tout les infos quoi").
                            .dash-card__contact
                                if _validPhone(b.companyPhone)
                                    a.dash-card__contact-row(href=`tel:${b.companyPhone.replace(/[^\d+]/g, '')}`)
                                        svg(viewBox="0 0 24 24" height="14" width="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                            path(d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z")
                                        span= b.companyPhone
                                if b.companyEmail && b.companyEmail.indexOf('@') !== -1
                                    a.dash-card__contact-row(href=`mailto:${b.companyEmail}`)
                                        svg(viewBox="0 0 24 24" height="14" width="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                            path(d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z")
                                            polyline(points="22,6 12,13 2,6")
                                        span= b.companyEmail
                                if _validUrl(b.companyWebsite)
                                    a.dash-card__contact-row(href=b.companyWebsite target="_blank" rel="noopener")
                                        svg(viewBox="0 0 24 24" height="14" width="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                            circle(cx="12" cy="12" r="10")
                                            line(x1="2" y1="12" x2="22" y2="12")
                                            path(d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z")
                                        span= b.companyWebsite.replace(/^https?:\/\//, '').replace(/\/$/, '')
                                //- Fallback quand aucune coordonnée n'est renseignée.
                                if !_hasContact && !addrFull && b.companySlug
                                    a.dash-card__no-contact(href=`/${b.companySlug}`)
                                        svg(viewBox="0 -960 960 960" height="13" width="13" fill="currentColor")
                                            path(d="M440-280h80v-240h-80v240Zm40-320q17 0 28.5-11.5T520-640q0-17-11.5-28.5T480-680q-17 0-28.5 11.5T440-640q0 17 11.5 28.5T480-600Zm0 520q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                                        | Coordonnées non renseignées — voir la fiche
                        //- Actions
                        .dash-card__actions
                            if b.companySlug
                                a.sm-btn.sm-btn--primary(href=`/${b.companySlug}`)
                                    svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                        path(d="M200-640h560v-80H200v80Zm0 0v-80 80Zm0 560q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T800-120H200Zm0-80h560v-400H200v400Z")
                                    span Réserver
                            //- Bouton "Voir l'adresse" uniquement quand une adresse
                            //- ou position GPS est disponible ("à droite ajoute un
                            //- bouton si y a l'adresse genre Voir l'adresse").
                            if mapsUrl
                                a.sm-btn.sm-btn--ghost(href=mapsUrl target="_blank" rel="noopener" title="Ouvrir dans Google Maps")
                                    svg(viewBox="0 0 24 24" height="14" width="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                        path(d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z")
                                        circle(cx="12" cy="10" r="3")
                                    span 📍 Voir l'adresse
                            button.sm-btn.sm-btn--ghost.js-add-cal(
                                type="button"
                                title="Ajouter à l'agenda"
                                data-gcal=gcalUrl
                                data-title=gcalTitle
                                data-start=gcalStart.toISOString()
                                data-end=gcalEnd.toISOString()
                                data-location=(addrFull || b.companyName || '')
                                data-details=gcalDetails
                            )
                                svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                    path(d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Zm280 200h80v80h80v80h-80v80h-80v-80h-80v-80h80v-80Z")
                                span Ajouter à l'agenda
                            button.sm-btn.sm-btn--danger.js-cancel-btn(
                                type="button"
                                data-href=`/cancel-booking/${b._id}?token=${b.cancelToken}`
                                data-name=b.companyName
                                data-date=new Date(b.date).toLocaleDateString('fr-FR', {weekday:'long', day:'numeric', month:'long'})
                                data-time=b.startTime
                                data-rule=b.cancellationRule
                                data-price=(b.payment && b.payment.amount ? b.payment.amount : 0)
                            )
                                svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                    path(d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z")
                                span Annuler

    //- ── Section Historique ───────────────────────────────────────
    if bookings.past.length > 0
        .dash-section
            .dash-section__title
                svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                    path(d="M480-120q-138 0-240.5-91.5T122-440h82q14 104 92.5 172T480-200q117 0 198.5-81.5T760-480q0-117-81.5-198.5T480-760q-69 0-129 32t-101 88h110v80H120v-240h80v94q51-64 124.5-99T480-840q75 0 140.5 28.5t114 77q48.5 48.5 77 114T840-480q0 75-28.5 140.5t-77 114q-48.5 48.5-114 77T480-120Z")
                h2 Historique
                span.dash-section__count= bookings.past.length
            .dash-cards
                each b in bookings.past
                    .dash-card(class=b.status === 'canceled' ? 'dash-card--canceled' : '')
                        .dash-card__cover
                            img(src=b.companyPhoto alt=b.companyName)
                        .dash-card__body
                            .dash-card__top
                                .dash-card__pro= b.companyName
                                if b.companyType
                                    span.dash-card__biz-type= b.companyType
                            .dash-card__meta
                                if b.serviceName
                                    .dash-card__meta-row
                                        svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                            path(d="M160-120v-480l320-240 320 240v480H560v-280H400v280H160Z")
                                        span= b.serviceName
                                .dash-card__meta-row
                                    svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                        path(d="M200-640h560v-80H200v80Zm0 0v-80 80Zm0 560q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T800-120H200Zm0-80h560v-400H200v400Z")
                                    span= new Date(b.date).toLocaleDateString('fr-FR', {day: 'numeric', month: 'long', year: 'numeric'})
                                .dash-card__meta-row
                                    svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                        path(d="m612-292 56-56-128-128v-184h-80v216l152 152ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                                    span= `${b.startTime} — ${b.endTime}`
                            span.dash-badge(class=b.status === 'canceled' ? 'dash-badge--canceled' : 'dash-badge--past')
                                = b.status === 'canceled' ? 'Annulé' : 'Passé'
                        if b.companySlug
                            .dash-card__actions
                                if b.status !== 'canceled'
                                    a.sm-btn.sm-btn--ghost(href=`/${b.companySlug}`)
                                        svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                            path(d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z")
                                        span Réserver à nouveau
                                - var alreadyReviewed = reviewedCompanyIds && reviewedCompanyIds.includes(String(b.company))
                                if !alreadyReviewed
                                    a.sm-btn.sm-btn--soft(href=`/${b.companySlug}#avis`)
                                        svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                            path(d="m233-120 65-281L80-590l288-25 112-265 112 265 288 25-218 189 65 281-247-149-247 149Z")
                                        span Laisser un avis
                                else
                                    span.dash-badge.dash-badge--reviewed ✓ Avis déposé

    //- ── Section Mes avis (toujours visible pour que l'ancre #avis fonctionne)
    .dash-section#avis
        .dash-section__title
            svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                path(d="m233-120 65-281L80-590l288-25 112-265 112 265 288 25-218 189 65 281-247-149-247 149Z")
            h2 Mes avis
            if myReviews && myReviews.length > 0
                span.dash-section__count= myReviews.length
        if myReviews && myReviews.length > 0
            .dash-reviews-list
                each r in myReviews
                    .dash-review-card
                        .dash-review-card__left
                            img.dash-review-card__photo(src=r.companyPhoto alt=r.companyName)
                            .dash-review-card__info
                                span.dash-review-card__name= r.companyName
                                .dash-review-card__stars
                                    - for (var s = 1; s <= 5; s++)
                                        svg(viewBox="0 0 20 20" width="13" height="13" fill=s <= r.rating ? '#f59e0b' : 'none' stroke="#f59e0b" stroke-width="1.5")
                                            path(d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z")
                                if r.comment
                                    p.dash-review-card__comment "#{r.comment}"
                        a.dash-review-card__link(href=`/${r.companySlug}#avis`)
                            svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                path(d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z")
        else
            .dash-empty-reviews
                svg(xmlns="http://www.w3.org/2000/svg" height="36px" viewBox="0 -960 960 960" width="36px" fill="currentColor")
                    path(d="m233-120 65-281L80-590l288-25 112-265 112 265 288 25-218 189 65 281-247-149-247 149Z")
                p Vous n'avez pas encore laissé d'avis.
                p.dash-empty-reviews__sub Après votre prochain rendez-vous, partagez votre expérience !

    //- ── Popup "Ajouter à l'agenda" ───────────────────────────────────────
    .cal-popup-overlay#calPopupOverlay(style="display:none")
        .cal-popup#calPopup
            .cal-popup__header
                span.cal-popup__title 📅 Ajouter à l'agenda
                button.cal-popup__close#calPopupClose(type="button" aria-label="Fermer")
                    svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                        path(d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z")
            .cal-popup__event#calPopupEvent
            .cal-popup__options
                a.cal-opt#calOptGoogle(href="#" target="_blank" rel="noopener")
                    .cal-opt__icon.cal-opt__icon--google
                        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="24" height="24")
                            path(fill="#EA4335" d="M24 9.5c3.1 0 5.8 1.1 8 2.9l6-6C34.5 3.1 29.6 1 24 1 14.8 1 7 6.7 3.7 14.7l7 5.4C12.4 14 17.7 9.5 24 9.5z")
                            path(fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.4c-.5 2.8-2.1 5.1-4.4 6.7l7 5.4c4.1-3.8 6.5-9.4 6.5-16.1z")
                            path(fill="#FBBC05" d="M10.7 28.6C10.3 27.4 10 26.2 10 25s.3-2.4.7-3.5l-7-5.4C2.6 18.6 2 21.7 2 25s.6 6.4 1.7 9.2l7-5.6z")
                            path(fill="#34A853" d="M24 47c5.6 0 10.3-1.8 13.7-5l-7-5.4c-1.9 1.3-4.3 2-6.7 2-6.3 0-11.6-4.3-13.3-10l-7 5.4C7 40.3 14.8 47 24 47z")
                            path(fill="none" d="M2 2h44v44H2z")
                    .cal-opt__text
                        strong Google Calendar
                        span Synchronisez avec Gmail
                a.cal-opt#calOptApple(href="#" download="rdv-branshee.ics")
                    .cal-opt__icon.cal-opt__icon--apple
                        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor")
