extends ../../layouts/index

block links
    link(rel="stylesheet", href="/css/layouts/404.css")

block content
    .error-404
        .error-404__wrapper
            .error-404__big-404 404
            .error-404__title
                h2= t.not_found.title
                if message
                    p.description= message
                else 
                    p.description= t.not_found.desc
            .error-404__body
                //- .error-404__search-wrapper
                //-     input.input(placeholder="Search companies...")
                //-     button.btn.secondary Search
                .error-404__search-actions
                    button.secondary(onclick="history.back()")
                        span= t.not_found.back
                    a(href='/').btn
                        span= t.not_found.home
block scripts       
    script(src="/js/layouts/index.js" type="module")