extends ../../layouts/index

include ../../templates/modals/dialog.pug

block jsonld
    script(type="application/ld+json").
        {
          "@context": "https://schema.org",
          "@type": "SoftwareApplication",
          "name": "BranShee",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web",
          "url": "https://www.branshee.com",
          "description": "BranShee est la plateforme de prise de rendez-vous en ligne pour les professionnels.",
          "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
        }
    script(type="application/ld+json").
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            { "@type": "Question", "name": "Comment prendre rendez-vous sur BranShee ?",
              "acceptedAnswer": { "@type": "Answer", "text": "Recherchez un professionnel, consultez ses disponibilités et réservez en quelques clics." } },
            { "@type": "Question", "name": "BranShee est-il gratuit ?",
              "acceptedAnswer": { "@type": "Answer", "text": "Oui, la prise de rendez-vous est entièrement gratuite pour les clients." } }
          ]
        }

block links
    link(rel="stylesheet", href="/css/layouts/client/landing-page.css")
    link(rel="stylesheet", href="/css/templates/dialog.css")

block content
    - var lp = t.landing

    main.lp

        //- ── HERO ──────────────────────────────────────────────────────
        section.lp__hero
            .lp__hero-inner.container

                //- Trust badge
                .lp__trust
                    span.lp__trust-dot
                    span= lp.trust

                //- Headline
                h1.lp__h1
                    | #{lp.h1_1}&nbsp;
                    span.lp__word#lpWord= lp.words[0]
                    br
                    | #{lp.h1_2}

                //- Subtitle
                p.lp__sub= lp.sub_1 + ' ' + lp.sub_2

                //- Search bar
                .lp__searchbar
                    .lp__sf#sfName
                        svg.lp__sf-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            circle(cx="11" cy="11" r="8")
                            line(x1="21" y1="21" x2="16.65" y2="16.65")
                        input#inputName(
                            type="text"
                            placeholder=lp.search_name_ph
                            autocomplete="off"
                            value=searchName || ""
                        )
                        .lp__dropdown#menuNames

                    .lp__sf-sep

                    .lp__sf#sfLocation
                        svg.lp__sf-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            path(d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z")
                            circle(cx="12" cy="10" r="3")
                        input#inputLocation(
                            type="text"
                            placeholder=lp.search_loc_ph
                            autocomplete="off"
                            value=searchLocation || ""
                        )
                        .lp__dropdown#menuLocations

                    button#searchBtn.sm-btn.sm-btn--primary.lp__search-btn= lp.search_btn

                //- Category quick-filters
                .lp__cats
                    each cat in lp.cats
                        button.lp__cat(data-cat=cat.key class=(cat.key === 'all' ? 'lp__cat--active' : ''))= cat.label

        //- ── BODY (sidebar + cards) ────────────────────────────────────
        .lp__body.container

            //- Sidebar (desktop only)
            aside.lp__sidebar
                .lp__sb-group
                    span.lp__sb-label= lp.filter_label
                    each cat in lp.cats
                        button.lp__sb-item(data-cat=cat.key class=(cat.key === 'all' ? 'active' : ''))
                            span= cat.label
                            if cat.key === 'all'
                                span.lp__sb-count= coachs ? coachs.length : 0

                .lp__sb-group
                    span.lp__sb-label= lp.distance_label
                    .lp__range-wrap
                        input.lp__range#distanceRange(type="range" min="5" max="100" value="100")
                        span.lp__range-val#distanceVal 100 km

            //- Cards
            .lp__main
                if coachs && coachs.length
                    .lp__results-hd
                        p.lp__results-count
                            span#visibleCount= coachs.length
                            |  #{lp.results}

                if !coachs || coachs.length === 0
                    .lp__empty
                        svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="40" height="40")
                            circle(cx="11" cy="11" r="8")
                            line(x1="21" y1="21" x2="16.65" y2="16.65")
                        p= lp.empty
                else
                    .lp__cards#lpCards
                        each coach in coachs
                            - var roundedRating = Math.round((coach.avgRating || 0) * 10) / 10
                            a.lp__card(
                                href=`/${coach.slug || coach._id}`
                                data-type=(coach.owner.businessType || '').toLowerCase()
                            )
                                .lp__card-photo
                                    img(
                                        src=coach.owner.businessPicture || coach.owner.profilePicture || '/images/no-user.webp'
                                        alt=coach.owner.businessName || coach.owner.fullName
                                        loading="lazy"
                                    )
                                    if coach.reviewCount > 0
                                        .lp__card-rating-badge
                                            svg(viewBox="0 0 20 20" fill="currentColor" width="11" height="11")
                                                path(d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z")
                                            span= roundedRating.toFixed(1)
                                .lp__card-body
                                    .lp__card-head
                                        span.lp__card-name= coach.owner.businessName || coach.owner.fullName
                                        if coach.owner.verified
                                            span.lp__card-verified
                                                svg(viewBox="0 0 20 20" fill="currentColor" width="14" height="14")
                                                    path(fill-rule="evenodd" d="M16.403 12.652a3 3 0 0 0 0-5.304 3 3 0 0 0-3.75-3.751 3 3 0 0 0-5.305 0 3 3 0 0 0-3.751 3.75 3 3 0 0 0 0 5.305 3 3 0 0 0 3.75 3.751 3 3 0 0 0 5.305 0 3 3 0 0 0 3.751-3.75Zm-2.546-4.46a.75.75 0 0 0-1.214-.883l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd")
                                                | Vérifié
                                    .lp__card-meta
                                        if coach.owner.businessType
                                            span= coach.owner.businessType
                                        if coach.owner.location && coach.owner.location.city
                                            span.lp__sep ·
                                            span= coach.owner.location.city
                                    if coach.reviewCount > 0
                                        .lp__card-stars
                                            - for (var s = 1; s <= 5; s++)
                                                svg(viewBox="0 0 20 20" width="13" height="13" fill=s <= Math.round(coach.avgRating) ? 'currentColor' : 'none' stroke="currentColor" stroke-width="1.5")
                                                    path(d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z")
                                            span.lp__card-review-count= `(${coach.reviewCount} avis)`
                                    if coach.owner.description
                                        p.lp__card-desc= coach.owner.description.length > 100 ? coach.owner.description.slice(0, 100) + '…' : coach.owner.description
                                .lp__card-cta
                                    span.lp__book-btn= lp.book_btn

    +dialog()

block scripts
    script.
        window.__lpWords = !{JSON.stringify(t.landing.words)};
        window.__services = !{JSON.stringify(services)};
    script(src="/js/layouts/client/landing-page.js" type="module")
    script(src='/js/templates/dialog.js' type="module")
