extends ../../layouts/index

include ../../templates/modals/dialog.pug

block jsonld
    script(type="application/ld+json").
        {
          "@context": "https://schema.org",
          "@type": "SoftwareApplication",
          "name": "BranShee",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web",
          "url": "https://www.branshee.com",
          "description": "BranShee est la plateforme de prise de rendez-vous en ligne pour les professionnels indépendants : agenda en ligne, calendrier de réservation, gestion des clients.",
          "featureList": [
            "Prise de rendez-vous en ligne 24h/24",
            "Agenda en ligne pour professionnels",
            "Calendrier de réservation partageable",
            "Rappels automatiques par email",
            "Paiement en ligne intégré",
            "Gestion des employés et services"
          ],
          "screenshot": "https://www.branshee.com/images/og-cover.jpg",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "EUR",
            "description": "Gratuit pour les clients. Offre pro disponible pour les professionnels."
          }
        }
    script(type="application/ld+json").
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Comment prendre rendez-vous en ligne avec BranShee ?",
              "acceptedAnswer": { "@type": "Answer", "text": "Cherchez un professionnel par nom ou ville sur BranShee.com, consultez ses disponibilités en temps réel et réservez en quelques clics. Aucune inscription requise pour les clients." }
            },
            {
              "@type": "Question",
              "name": "BranShee est-il gratuit ?",
              "acceptedAnswer": { "@type": "Answer", "text": "Oui, la prise de rendez-vous en ligne est entièrement gratuite pour les clients. Pour les professionnels, BranShee propose une formule gratuite pour commencer, et des offres premium avec plus de fonctionnalités." }
            },
            {
              "@type": "Question",
              "name": "Quel type de professionnels peut-on trouver sur BranShee ?",
              "acceptedAnswer": { "@type": "Answer", "text": "BranShee permet de réserver en ligne avec des coiffeurs, coaches sportifs, masseurs, thérapeutes, tatoueurs, nail artists, yoga instructeurs et de nombreux autres professionnels indépendants." }
            },
            {
              "@type": "Question",
              "name": "Comment créer un agenda en ligne pour mon activité avec BranShee ?",
              "acceptedAnswer": { "@type": "Answer", "text": "Inscrivez-vous gratuitement sur BranShee, créez votre page professionnelle, configurez vos services, horaires et disponibilités. Partagez ensuite votre lien de réservation avec vos clients. Votre agenda en ligne est prêt en moins de 5 minutes." }
            },
            {
              "@type": "Question",
              "name": "BranShee est-il une bonne alternative à Calendly ou Planity ?",
              "acceptedAnswer": { "@type": "Answer", "text": "Oui. BranShee est une alternative française à Calendly, Planity ou SimplyBook spécialement conçue pour les indépendants et petites équipes. Il propose un calendrier de réservation en ligne, la gestion des employés, les paiements et les rappels automatiques." }
            },
            {
              "@type": "Question",
              "name": "Peut-on recevoir des paiements en ligne via BranShee ?",
              "acceptedAnswer": { "@type": "Answer", "text": "Oui, BranShee intègre le paiement en ligne via Stripe pour les professionnels en formule premium. Les clients peuvent payer au moment de la réservation, et les professionnels reçoivent les fonds directement." }
            }
          ]
        }

block links
    link(rel="stylesheet", href="/css/layouts/client/landing-page.css")
    link(rel="stylesheet", href="/css/templates/dialog.css")

block content
    - var lp = t.landing

    main.lp

        //- ── HERO ──────────────────────────────────────────────────────
        section.lp__hero
            .lp__hero-inner.container

                //- Trust badge
                .lp__trust
                    span.lp__trust-dot
                    span= lp.trust

                //- Headline — H1 SEO : mots-clés en dur + animation JS par-dessus
                //- Google lit le texte statique, l'animation reste pour les visiteurs
                h1.lp__h1
                    | BranShee —&nbsp;
                    span.lp__word#lpWord prise de rendez-vous en ligne
                    br
                    | pour tous les professionnels.

                //- Subtitle
                p.lp__sub BranShee est la plateforme de prise de rendez-vous en ligne pour les professionnels indépendants : coiffeurs, coaches, thérapeutes, tatoueurs et bien d'autres. Créez votre agenda en ligne gratuitement.

                //- Search bar
                .lp__searchbar
                    .lp__sf#sfName
                        svg.lp__sf-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            circle(cx="11" cy="11" r="8")
                            line(x1="21" y1="21" x2="16.65" y2="16.65")
                        input#inputName(
                            type="text"
                            placeholder=lp.search_name_ph
                            autocomplete="off"
                            value=searchName || ""
                        )
                        .lp__dropdown#menuNames

                    .lp__sf-sep

                    .lp__sf#sfLocation
                        svg.lp__sf-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            path(d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z")
                            circle(cx="12" cy="10" r="3")
                        input#inputLocation(
                            type="text"
                            placeholder=lp.search_loc_ph
                            autocomplete="off"
                            value=searchLocation || ""
                        )
                        .lp__dropdown#menuLocations

                    button#searchBtn.sm-btn.sm-btn--primary.lp__search-btn= lp.search_btn

                //- Category quick-filters
                .lp__cats
                    each cat in lp.cats
                        button.lp__cat(data-cat=cat.key class=(cat.key === 'all' ? 'lp__cat--active' : ''))= cat.label

        //- ── PRO CTA BANNER (moved to bottom — see end of file) ───────

        //- ── BODY (sidebar + cards) ────────────────────────────────────
        .lp__body.container

            //- Sidebar (desktop only)
            aside.lp__sidebar
                .lp__sb-group
                    span.lp__sb-label= lp.filter_label
                    each cat in lp.cats
                        button.lp__sb-item(data-cat=cat.key class=(cat.key === 'all' ? 'active' : ''))
                            span= cat.label
                            if cat.key === 'all'
                                span.lp__sb-count= coachs ? coachs.length : 0

                .lp__sb-group
                    span.lp__sb-label= lp.distance_label
                    .lp__range-wrap
                        input.lp__range#distanceRange(type="range" min="5" max="100" value="100")
                        span.lp__range-val#distanceVal 100 km

            //- Cards
            .lp__main
                if coachs && coachs.length
                    .lp__results-hd
                        p.lp__results-count
                            span#visibleCount= coachs.length
                            |  #{lp.results}

                if !coachs || coachs.length === 0
                    .lp__empty
                        svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="40" height="40")
                            circle(cx="11" cy="11" r="8")
                            line(x1="21" y1="21" x2="16.65" y2="16.65")
                        p= lp.empty
                else
                    .lp__cards#lpCards
                        each coach in coachs
                            - var roundedRating = Math.round((coach.avgRating || 0) * 10) / 10
                            a.lp__card(
                                href=`/${coach.slug || coach._id}`
                                data-type=(coach.owner.businessType || '').toLowerCase()
                            )
                                .lp__card-photo
                                    img(
                                        src=coach.owner.businessPicture || coach.owner.profilePicture || '/images/no-user.webp'
                                        alt=coach.owner.businessName || coach.owner.fullName
                                        loading="lazy"
                                    )
                                    if coach.reviewCount > 0
                                        .lp__card-rating-badge
                                            svg(viewBox="0 0 20 20" fill="currentColor" width="11" height="11")
                                                path(d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z")
                                            span= roundedRating.toFixed(1)
                                .lp__card-body
                                    .lp__card-head
                                        span.lp__card-name= coach.owner.businessName || coach.owner.fullName
                                        if coach.owner.verified
                                            span.lp__card-verified
                                                svg(viewBox="0 0 20 20" fill="currentColor" width="14" height="14")
                                                    path(fill-rule="evenodd" d="M16.403 12.652a3 3 0 0 0 0-5.304 3 3 0 0 0-3.75-3.751 3 3 0 0 0-5.305 0 3 3 0 0 0-3.751 3.75 3 3 0 0 0 0 5.305 3 3 0 0 0 3.75 3.751 3 3 0 0 0 5.305 0 3 3 0 0 0 3.751-3.75Zm-2.546-4.46a.75.75 0 0 0-1.214-.883l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd")
                                                | Vérifié
                                    .lp__card-meta
                                        if coach.owner.businessType
                                            span= coach.owner.businessType
                                        if coach.owner.location && coach.owner.location.city
                                            span.lp__sep ·
                                            span= coach.owner.location.city
                                    if coach.reviewCount > 0
                                        .lp__card-stars
                                            - for (var s = 1; s <= 5; s++)
                                                svg(viewBox="0 0 20 20" width="13" height="13" fill=s <= Math.round(coach.avgRating) ? 'currentColor' : 'none' stroke="currentColor" stroke-width="1.5")
                                                    path(d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z")
                                            span.lp__card-review-count= `(${coach.reviewCount} avis)`
                                    if coach.owner.description
                                        p.lp__card-desc= coach.owner.description.length > 100 ? coach.owner.description.slice(0, 100) + '…' : coach.owner.description
                                .lp__card-cta
                                    span.lp__book-btn= lp.book_btn

    //- ── PRO CTA BANNER (en bas) ───────────────────────────────────────
    section.lp__pro-banner
            .lp__pro-inner.container
                .lp__pro-left
                    .lp__pro-badge
                        svg(width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                            rect(x="3" y="4" width="18" height="18" rx="2")
                            line(x1="16" y1="2" x2="16" y2="6")
                            line(x1="8" y1="2" x2="8" y2="6")
                            line(x1="3" y1="10" x2="21" y2="10")
                        span Agenda en ligne
                    h2.lp__pro-title Créez votre page de réservation #[span.lp__pro-accent en 2 minutes]
                    p.lp__pro-sub Partagez un lien, recevez des réservations 24h/24 — sans appel, sans agenda papier.
                    .lp__pro-features
                        .lp__pro-feat
                            .lp__pro-feat-icon
                                svg(width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                                    polyline(points="20 6 9 17 4 12")
                            span Gratuit pour commencer
                        .lp__pro-feat
                            .lp__pro-feat-icon
                                svg(width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                                    circle(cx="12" cy="12" r="10")
                                    polyline(points="12 6 12 12 16 14")
                            span Disponibilités en temps réel
                        .lp__pro-feat
                            .lp__pro-feat-icon
                                svg(width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                                    rect(x="1" y="4" width="22" height="16" rx="2")
                                    line(x1="1" y1="10" x2="23" y2="10")
                            span Paiement en ligne intégré
                        .lp__pro-feat
                            .lp__pro-feat-icon
                                svg(width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                                    path(d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z")
                                    polyline(points="22,6 12,12 2,6")
                            span Rappels automatiques par email
                    .lp__pro-actions
                        a.sm-btn.sm-btn--white(href="/register?plan=pro&billing=monthly")
                            | Commencer gratuitement
                            svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                                line(x1="5" y1="12" x2="19" y2="12")
                                polyline(points="12 5 19 12 12 19")
                        span.lp__pro-note Aucune carte bancaire requise

                .lp__pro-right
                    .lp__pro-mockup
                        .lp__pro-mock-head
                            .lp__pro-mock-dot
                            .lp__pro-mock-dot
                            .lp__pro-mock-dot
                        .lp__pro-mock-body
                            .lp__pro-mock-avatar
                                svg(width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#1a7a4a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
                                    path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
                                    circle(cx="12" cy="7" r="4")
                            .lp__pro-mock-name Spa Harmony
                            .lp__pro-mock-type Massage · Bien-être
                            .lp__pro-mock-divider
                            .lp__pro-mock-row
                                span Lundi 9 juin
                                .lp__pro-mock-slots
                                    span.lp__pro-mock-slot 09:00
                                    span.lp__pro-mock-slot.active 10:30
                                    span.lp__pro-mock-slot 14:00
                            .lp__pro-mock-btn
                                | Réserver
                                svg(width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left:6px")
                                    line(x1="5" y1="12" x2="19" y2="12")
                                    polyline(points="12 5 19 12 12 19")

    +dialog()

block scripts
    script.
        window.__lpWords = !{JSON.stringify(t.landing.words)};
        window.__services = !{JSON.stringify(services)};
    script(src="/js/layouts/client/landing-page.js" type="module")
    script(src='/js/templates/dialog.js' type="module")
