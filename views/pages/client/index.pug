extends ../../layouts/booking

block jsonld
    - var _bizName    = (coach && (coach.businessName || coach.fullName)) || 'BranShee Pro'
    - var _bizDesc    = (coach && coach.description) || ('Réservez en ligne avec ' + _bizName + ' sur BranShee.')
    - var _bizImg     = (coach && (coach.businessPicture || coach.profilePicture)) || ''
    - var _bizCity    = (coach && coach.location && coach.location.city) || ''
    - var _bizAddr    = (coach && coach.location && coach.location.address) || ''
    - var _bizZip     = (coach && coach.location && coach.location.zip) ? String(coach.location.zip) : ''
    - var _bizCountry = (coach && coach.location && coach.location.country) || 'BE'
    - var _bizPhone   = (coach && (coach.phonePro || coach.phone)) || ''
    - var _bizUrl     = 'https://www.branshee.com/' + (company ? (company.slug || String(company._id)) : '')
    - var _hasRating  = (typeof reviewCount !== 'undefined' && reviewCount > 0)
    - var _svcPrices  = services && services.length ? services.filter(function(s){return s.price>0}).map(function(s){return s.price}) : []
    - var _minPrice   = _svcPrices.length ? Math.min.apply(null, _svcPrices) : 0
    - var _maxPrice   = _svcPrices.length ? Math.max.apply(null, _svcPrices) : 0
    script(type="application/ld+json").
        {
          "@context": "https://schema.org",
          "@type": "LocalBusiness",
          "name": "!{_bizName.replace(/"/g,'\\\"')}",
          "description": "!{_bizDesc.replace(/"/g,'\\\"').replace(/\n/g,' ')}",
          "image": "!{_bizImg}",
          "url": "!{_bizUrl}",
          "telephone": "!{_bizPhone}",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "!{_bizAddr.replace(/"/g,'\\\"')}",
            "addressLocality": "!{_bizCity.replace(/"/g,'\\\"')}",
            "postalCode": "!{_bizZip}",
            "addressCountry": "!{_bizCountry}"
          },
          "makesOffer": {
            "@type": "Offer",
            "url": "!{_bizUrl}",
            "description": "Réservation en ligne disponible 24h/24"
          }
          !{_hasRating ? (',\n          "aggregateRating": { "@type": "AggregateRating", "ratingValue": "' + (Math.round(avgRating * 10)/10) + '", "reviewCount": "' + reviewCount + '", "bestRating": "5", "worstRating": "1" }') : ''}
          !{(_minPrice > 0 && _maxPrice > 0) ? (',\n          "priceRange": "' + _minPrice + '€ – ' + _maxPrice + '€"') : ''}
        }

block content
    -
        var cs          = (coach && coach.calendarSettings) ? coach.calendarSettings : {}
        var accentColor = cs.accentColor || '#22c55e'
        var accentText  = cs.accentText  || '#ffffff'

        // Compute soft accent (rgba) server-side from hex
        function hexToRgb(hex) {
            if (!hex || hex.length < 7) return '34,197,94';
            return parseInt(hex.slice(1,3),16)+','+parseInt(hex.slice(3,5),16)+','+parseInt(hex.slice(5,7),16);
        }
        var accentRgb = hexToRgb(accentColor)

        var bizName    = (coach && (coach.businessName || coach.fullName)) || 'BranShee'
        var bizType    = (coach && coach.businessType) || ''
        var bizStreet  = (coach && coach.location && coach.location.address) || ''
        var bizCity    = (coach && coach.location && coach.location.city)    || ''
        var bizZip     = (coach && coach.location && coach.location.zip)     || ''
        var bizAddress = [bizStreet, bizCity].filter(Boolean).join(', ')
        var bizPic     = coach && (coach.businessPicture || coach.profilePicture) ? (coach.businessPicture || coach.profilePicture) : null
        var initials   = bizName.split(' ').map(function(w){return w[0]||'';}).slice(0,2).join('').toUpperCase()

        // Google Maps link — priorité : gmapUrl stocké, puis coordonnées, puis adresse
        var _googleMapsUrl = ''
        if (coach && coach.location) {
            if (coach.location.gmapUrl && /^https?:\/\//.test(coach.location.gmapUrl)) {
                _googleMapsUrl = coach.location.gmapUrl
            } else if (coach.location.lat && coach.location.lon) {
                _googleMapsUrl = 'https://maps.google.com/?q=' + coach.location.lat + ',' + coach.location.lon
            } else if (bizStreet || bizCity) {
                _googleMapsUrl = 'https://maps.google.com/?q=' + encodeURIComponent([bizStreet, bizCity, bizZip].filter(Boolean).join(', '))
            }
        }

        // Adresse affichée (texte complet si une seule ligne, sinon composée)
        var _displayAddress = ''
        if (coach && coach.location) {
            if (coach.location.address && coach.location.city && coach.location.address.toLowerCase().includes(coach.location.city.toLowerCase())) {
                // L'adresse contient déjà la ville (enregistrée comme adresse complète)
                _displayAddress = coach.location.address
            } else {
                _displayAddress = [coach.location.address, coach.location.city].filter(Boolean).join(', ')
            }
        }

        // Google Maps embed — priorité : iframeUrl (adresse texte), puis coordonnées
        var _mapEmbedSrc = ''
        if (coach && coach.location) {
            if (coach.location.iframeUrl) {
                _mapEmbedSrc = coach.location.iframeUrl
            } else if (coach.location.lat && coach.location.lon) {
                _mapEmbedSrc = 'https://maps.google.com/maps?q=' + coach.location.lat + ',' + coach.location.lon + '&output=embed&hl=fr&z=16'
            } else if (_displayAddress) {
                _mapEmbedSrc = 'https://maps.google.com/maps?q=' + encodeURIComponent(_displayAddress) + '&output=embed&hl=fr&z=16'
            }
        }
        var showMap   = cs.showSectionMap   !== false && _mapEmbedSrc !== ''
        var showHours = cs.showSectionHours !== false && company && company.schedule && company.schedule.length > 0
        // NB : calculé ici (et non plus loin, près de la galerie) car la boucle
        // `each _sec in _secOrder` ci-dessous teste `showGallery` — avec `var`,
        // la déclaration est "hoistée" en tête de fonction mais l'affectation ne
        // l'est pas, donc si on ne calculait `showGallery` qu'après la boucle,
        // sa valeur valait `undefined` au moment du test et la section galerie
        // ne s'affichait jamais sur la page publique.
        var showGallery = cs.showSectionGallery === true && gallery && gallery.length > 0

    if cs.customFontUrl
        link(rel="stylesheet" href=cs.customFontUrl)

    -
        var _fontMap = {
            'Inter':            "'Inter', system-ui, -apple-system, sans-serif",
            'Poppins':          "'Poppins', system-ui, sans-serif",
            'Lato':             "'Lato', system-ui, sans-serif",
            'Montserrat':       "'Montserrat', system-ui, sans-serif",
            'Playfair Display': "'Playfair Display', Georgia, serif",
            'Nunito':           "'Nunito', system-ui, sans-serif"
        };
        var _fontVal = _fontMap[cs.font] || _fontMap['Inter'];
        if (cs.customFontFamily) {
            _fontVal = "'" + cs.customFontFamily + "', " + _fontVal;
        }
        var _radMap = {
            'none': { xs:'0px',  sm:'0px',  md:'0px',  lg:'0px',  xl:'0px',  pill:'0px'   },
            'sm':   { xs:'4px',  sm:'6px',  md:'8px',  lg:'10px', xl:'14px', pill:'999px' },
            'md':   { xs:'6px',  sm:'8px',  md:'12px', lg:'16px', xl:'24px', pill:'999px' },
            'lg':   { xs:'8px',  sm:'12px', md:'18px', lg:'24px', xl:'36px', pill:'999px' }
        };
        var _R = _radMap[cs.borderRadius] || _radMap['md'];
        var _bdMap = {
            'none':   { color:'transparent', strong:'transparent' },
            'subtle': { color:'#e3e8e4',     strong:'#c8d4ca'     },
            'medium': { color:'#c4cfc6',     strong:'#9aab9d'     },
            'strong': { color:'#8a9e8d',     strong:'#4d6651'     }
        };
        var _BD = _bdMap[cs.borderStyle] || _bdMap['subtle'];
        var _shMap = {
            'none':   { xs:'none', sm:'none', md:'none', lg:'none' },
            'subtle': { xs:'0 1px 2px rgba(15,23,25,0.04)', sm:'0 1px 3px rgba(15,23,25,0.06),0 1px 2px rgba(15,23,25,0.04)', md:'0 4px 12px rgba(15,23,25,0.08),0 2px 4px rgba(15,23,25,0.04)', lg:'0 12px 32px rgba(15,23,25,0.12),0 4px 8px rgba(15,23,25,0.05)' },
            'medium': { xs:'0 1px 4px rgba(0,0,0,0.10)',    sm:'0 2px 6px rgba(0,0,0,0.12)',    md:'0 6px 18px rgba(0,0,0,0.14)',    lg:'0 16px 40px rgba(0,0,0,0.16)' },
            'strong': { xs:'0 2px 6px rgba(0,0,0,0.18)',    sm:'0 4px 12px rgba(0,0,0,0.22)',   md:'0 10px 28px rgba(0,0,0,0.26)',   lg:'0 24px 56px rgba(0,0,0,0.30)' }
        };
        var _SH = _shMap[cs.shadowStyle] || _shMap['subtle'];
    style.
        :root {
            --bk-accent:        #{accentColor};
            --bk-accent-text:   #{accentText};
            --bk-accent-soft:   rgba(#{accentRgb}, 0.10);
            --bk-accent-border: rgba(#{accentRgb}, 0.35);
            --bk-accent-ink:    #{accentColor};
            --bk-bg:      #{cs.pageBg   || '#f7f8f7'};
            --bk-surface: #{cs.calBg    || '#ffffff'};
            --bk-day-bg:  #{cs.dayBg    || '#ffffff'};
            --bk-day-text:#{cs.dayText  || '#111111'};
            --bk-btn-bg:  #{cs.btnBg    || '#111111'};
            --bk-btn-text:#{cs.btnText  || '#ffffff'};
            --bk-font:    !{_fontVal};
            --bk-r-xs:    #{_R.xs};
            --bk-r-sm:    #{_R.sm};
            --bk-r-md:    #{_R.md};
            --bk-r-lg:    #{_R.lg};
            --bk-r-xl:    #{_R.xl};
            --bk-r-pill:  #{_R.pill};
            --bk-border:        !{_BD.color};
            --bk-border-strong: !{_BD.strong};
            --bk-shadow-xs: !{_SH.xs};
            --bk-shadow-sm: !{_SH.sm};
            --bk-shadow-md: !{_SH.md};
            --bk-shadow-lg: !{_SH.lg};
        }

    //- ── Top bar ────────────────────────────────────────────────────────────
    header.bk-top
        a.bk-brand(href="/")
            .bk-brand__mark B
            span.bk-brand__name BranShee
        .bk-top__right
            if visitorIsAdmin
                a.bk-sign-btn(href="/appointment") Dashboard
            else if clientUser
                a.bk-sign-btn(href="/espace-client")
                    svg(width="14" height="14" viewBox="0 -960 960 960" fill="currentColor")
                        path(d="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 129-46.5T480-440q68 0 135 15.5T744-378q29 15 46.5 43.5T808-272v112H160Z")
                    | Espace client
            else
                a.bk-sign-btn(href="/client/login") Se connecter

    //- ── Main ───────────────────────────────────────────────────────────────
    main.bk-main
        .bk-inner

            //- ── Company header ─────────────────────────────────────────────
            .bk-head
                .bk-cover
                    if bizPic
                        img(src=bizPic alt=bizName)
                    else
                        span= initials
                .bk-head__info
                    h1.bk-head__name= bizName
                    if bizType || bizAddress
                        p.bk-head__meta
                            if bizType
                                span= bizType
                            if bizType && bizAddress
                                |  ·
                            if bizAddress
                                if _googleMapsUrl
                                    a.bk-head__addr-link(href=_googleMapsUrl target="_blank" rel="noopener")
                                        svg(xmlns="http://www.w3.org/2000/svg" height="12px" viewBox="0 -960 960 960" width="12px" fill="currentColor")
                                            path(d="M480-480q33 0 56.5-23.5T560-560q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 33 23.5 56.5T480-480Zm0 294q122-112 181-203.5T720-552q0-109-69.5-178.5T480-800q-101 0-170.5 69.5T240-552q0 71 59 162.5T480-186Z")
                                        = bizAddress
                                else
                                    span= bizAddress
                    .bk-head__pills
                        if isOpenToday
                            span.bk-pill.bk-pill--accent Ouvert aujourd'hui
                        -
                            var _showSocials = coach && (coach.isPremium || (coach.calendarSettings && coach.calendarSettings.showSocials !== false))
                            var _validPhone  = function(v) { return v && v !== 'on' && /[\d+]/.test(v) }
                            var _validUrl    = function(v) { return v && /^https?:\/\//.test(v) }
                        if _showSocials
                            if coach.emailPro && coach.emailPro.indexOf('@') !== -1
                                button.bk-pill.bk-pill--social.bk-pill--copy(type="button" data-copy=coach.emailPro title="Copier l'email")= coach.emailPro
                            if _validPhone(coach.phonePro)
                                button.bk-pill.bk-pill--social.bk-pill--copy(type="button" data-copy=coach.phonePro title="Copier le téléphone")= coach.phonePro
                            if _validUrl(coach.instagramLink)
                                a.bk-pill.bk-pill--social(href=coach.instagramLink target="_blank" rel="noopener") Instagram
                            if _validUrl(coach.facebookLink)
                                a.bk-pill.bk-pill--social(href=coach.facebookLink target="_blank" rel="noopener") Facebook
                            if coach.whatsappLink
                                - var _waHref = /^https?:\/\//.test(coach.whatsappLink) ? coach.whatsappLink : 'https://wa.me/' + coach.whatsappLink.replace(/\D/g,'')
                                a.bk-pill.bk-pill--social(href=_waHref target="_blank" rel="noopener") WhatsApp
                            if _validUrl(coach.website)
                                a.bk-pill.bk-pill--social(href=coach.website target="_blank" rel="noopener") Site web

            //- ── Guide réservation ──────────────────────────────────────────
            .bk-booking-guide
                svg(xmlns="http://www.w3.org/2000/svg" height="15px" viewBox="0 -960 960 960" width="15px" fill="currentColor" aria-hidden="true")
                    path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Zm-20 200v-240l160 120-160 120Z")
                span Réservez votre rendez-vous — choisissez un service pour commencer

            //- ── Stepper ────────────────────────────────────────────────────
            nav.bk-stepper#bkStepper

            //- ── Step pane (JS-rendered) ────────────────────────────────────
            #bkPane

            //- ── Sections dans l'ordre défini par l'admin ────────────────────
            -
                var _secOrder = (cs && cs.sectionOrder && cs.sectionOrder.length) ? cs.sectionOrder : ['about','location','hours','gallery','reviews']
            each _sec in _secOrder
                if _sec === 'location' && (showMap || (_displayAddress && _displayAddress.trim()))
                    .bk-location-card
                        h2.bk-location-card__title
                            svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                path(d="M480-480q33 0 56.5-23.5T560-560q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 33 23.5 56.5T480-480Zm0 294q122-112 181-203.5T720-552q0-109-69.5-178.5T480-800q-101 0-170.5 69.5T240-552q0 71 59 162.5T480-186Zm0 106Q319-217 239.5-334.5T160-552q0-150 96.5-239T480-880q127 0 223.5 89T800-552q0 100-79.5 217.5T480-80Z")
                            | Localisation
                        if _displayAddress && _displayAddress.trim()
                            .bk-location-card__addr
                                svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                    path(d="M480-480q33 0 56.5-23.5T560-560q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 33 23.5 56.5T480-480Zm0 294q122-112 181-203.5T720-552q0-109-69.5-178.5T480-800q-101 0-170.5 69.5T240-552q0 71 59 162.5T480-186Z")
                                span= _displayAddress
                                .bk-location-card__actions
                                    button.bk-copy-addr(
                                        type="button"
                                        title="Copier l'adresse"
                                        data-addr=_displayAddress
                                    )
                                        svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                            path(d="M360-240q-33 0-56.5-23.5T280-320v-480q0-33 23.5-56.5T360-880h360q33 0 56.5 23.5T800-800v480q0 33-23.5 56.5T720-240H360Zm0-80h360v-480H360v480ZM200-80q-33 0-56.5-23.5T120-160v-560h80v560h440v80H200Zm160-240v-480 480Z")
                                        span Copier
                                    if _googleMapsUrl
                                        a.bk-location-card__gmaps(href=_googleMapsUrl target="_blank" rel="noopener")
                                            | Ouvrir dans Maps
                                            svg(xmlns="http://www.w3.org/2000/svg" height="11px" viewBox="0 -960 960 960" width="11px" fill="currentColor")
                                                path(d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z")
                        if showMap
                            .bk-map-wrap.bk-location-card__map
                                iframe(src=_mapEmbedSrc style="border:0;width:100%;height:280px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade")

                else if _sec === 'hours' && showHours
                    .bk-hours-card
                        h2.bk-hours-card__title
                            svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-400 127 127-57 57-110-110v-214h80v140Z")
                            | Horaires d'ouverture
                        .bk-hours-grid
                            -
                                var dayNames = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi']
                                var sortedSched = [1,2,3,4,5,6,0].map(function(d){ return company.schedule.find(function(s){ return s.weekdayIndex === d; }); }).filter(Boolean)
                            each entry in sortedSched
                                .bk-hours-row(class=entry.dayOff ? 'bk-hours-row--off' : '')
                                    span.bk-hours-row__day= dayNames[entry.weekdayIndex]
                                    span.bk-hours-row__val
                                        if entry.dayOff
                                            | Fermé
                                        else if entry.workingHours && entry.workingHours.length
                                            = entry.workingHours.map(function(h){ return h.start + ' - ' + h.end; }).join(' · ')
                                        else
                                            | Fermé

                else if _sec === 'about' && coach && (coach.aboutHtml || coach.description) && cs.showSectionAbout !== false
                    -
                        var _hasRichAbout = !!(coach.aboutHtml && coach.aboutHtml.trim())
                        var _aboutPlainLen = _hasRichAbout
                            ? coach.aboutHtml.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().length
                            : (coach.description || '').length
                    .bk-about-card
                        h2.bk-about-card__title
                            svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                path(d="M440-280h80v-240h-80v240Zm40-320q17 0 28.5-11.5T520-640q0-17-11.5-28.5T480-680q-17 0-28.5 11.5T440-640q0 17 11.5 28.5T480-600Zm0 520q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                            | À propos
                        if _hasRichAbout
                            .bk-about-card__text.bk-about-card__text--rich#bkAboutText!= coach.aboutHtml
                        else
                            p.bk-about-card__text#bkAboutText= coach.description
                        if _aboutPlainLen > 220
                            button.bk-about-card__toggle#bkAboutToggle(type="button")
                                span Voir plus
                                svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                    path(d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z")

                else if _sec === 'gallery' && showGallery
                    .bk-info-section
                        h2.bk-info-section__title
                            svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                path(d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Zm0-80h560v-560H200v560Zm40-80h480L570-480 450-320l-90-120-120 160Zm-40 80v-560 560Z")
                            | Galerie
                        if cs.galleryLayout === 'carousel'
                            .bk-gallery-carousel-wrap
                                .bk-gallery-carousel#bkGalleryCarousel
                                    each photo, gi in gallery
                                        .bk-gallery-carousel__item
                                            .bk-gallery-item(data-index=gi role="button" tabindex="0" title="Agrandir")
                                                img(src=photo alt="Photo de l'établissement" loading="lazy")
                                if gallery.length > 1
                                    button.bk-gallery-carousel__nav.bk-gallery-carousel__nav--prev#bkGalCarPrev(type="button" aria-label="Photo précédente")
                                        svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                            path(d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z")
                                    button.bk-gallery-carousel__nav.bk-gallery-carousel__nav--next#bkGalCarNext(type="button" aria-label="Photo suivante")
                                        svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                            path(d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z")
                        else
                            .bk-gallery-grid
                                each photo, gi in gallery
                                    .bk-gallery-item(data-index=gi role="button" tabindex="0" title="Agrandir")
                                        img(src=photo alt="Photo de l'établissement" loading="lazy")

    //- ── Sticky cart (JS-rendered) ──────────────────────────────────────────
    #bkCart

    //- ── Avis (toujours en dernier — ancre #avis) ───────────────────────────
    section.bk-reviews#avis
        .bk-inner
            .bk-reviews__header
                h2.bk-reviews__title
