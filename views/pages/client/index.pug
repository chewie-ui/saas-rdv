extends ../../layouts/booking

block jsonld
    //- Nom/photo de l'ÉTABLISSEMENT d'abord (source de vérité depuis le
    //- multi-établissements) ; le compte propriétaire n'est qu'un repli.
    - var _bizName    = (company && company.name) || (coach && (coach.businessName || coach.fullName)) || 'BranShee Pro'
    - var _bizDesc    = (coach && estab.description) || ('Réservez en ligne avec ' + _bizName + ' sur BranShee.')
    - var _bizImg     = (company && company.photo) || (coach && (coach.businessPicture || coach.profilePicture)) || ''
    - var _bizCity    = (coach && estab.location && estab.location.city) || ''
    - var _bizAddr    = (coach && estab.location && estab.location.address) || ''
    - var _bizZip     = (coach && estab.location && estab.location.zip) ? String(estab.location.zip) : ''
    - var _bizCountry = (coach && estab.location && estab.location.country) || 'BE'
    //- Pas de repli sur coach.phone : le helper d'identité l'applique déjà, et
    //- uniquement pour l'établissement d'origine. Ici, il exposait le téléphone
    //- perso du patron sur la fiche de son second établissement.
    - var _bizPhone   = estab.phonePro || ''
    - var _bizUrl     = 'https://www.branshee.com/' + (company ? (company.slug || String(company._id)) : '')
    - var _hasRating  = (typeof reviewCount !== 'undefined' && reviewCount > 0)
    - var _svcPrices  = services && services.length ? services.filter(function(s){return s.price>0}).map(function(s){return s.price}) : []
    - var _minPrice   = _svcPrices.length ? Math.min.apply(null, _svcPrices) : 0
    - var _maxPrice   = _svcPrices.length ? Math.max.apply(null, _svcPrices) : 0
    script(type="application/ld+json").
        {
          "@context": "https://schema.org",
          "@type": "LocalBusiness",
          "name": "!{_bizName.replace(/"/g,'\\\"')}",
          "description": "!{_bizDesc.replace(/"/g,'\\\"').replace(/\n/g,' ')}",
          "image": "!{_bizImg}",
          "url": "!{_bizUrl}",
          "telephone": "!{_bizPhone}",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "!{_bizAddr.replace(/"/g,'\\\"')}",
            "addressLocality": "!{_bizCity.replace(/"/g,'\\\"')}",
            "postalCode": "!{_bizZip}",
            "addressCountry": "!{_bizCountry}"
          },
          "makesOffer": {
            "@type": "Offer",
            "url": "!{_bizUrl}",
            "description": "Réservation en ligne disponible 24h/24"
          }
          !{_hasRating ? (',\n          "aggregateRating": { "@type": "AggregateRating", "ratingValue": "' + (Math.round(avgRating * 10)/10) + '", "reviewCount": "' + reviewCount + '", "bestRating": "5", "worstRating": "1" }') : ''}
          !{(_minPrice > 0 && _maxPrice > 0) ? (',\n          "priceRange": "' + _minPrice + '€ – ' + _maxPrice + '€"') : ''}
        }

block content
    -
        var cs          = (coach && coach.calendarSettings) ? coach.calendarSettings : {}
        var accentColor = cs.accentColor || '#22c55e'
        var accentText  = cs.accentText  || '#ffffff'

        // Compute soft accent (rgba) server-side from hex
        function hexToRgb(hex) {
            if (!hex || hex.length < 7) return '34,197,94';
            return parseInt(hex.slice(1,3),16)+','+parseInt(hex.slice(3,5),16)+','+parseInt(hex.slice(5,7),16);
        }
        var accentRgb = hexToRgb(accentColor)

        // Couleurs de disponibilité du calendrier (vert/orange/rouge perso)
        var dayAvailableColor = cs.dayAvailableColor || '#16a34a'
        var dayBusyColor      = cs.dayBusyColor      || '#ea580c'
        var dayFullColor      = cs.dayFullColor      || '#ef4444'
        var dayAvailableRgb   = hexToRgb(dayAvailableColor)
        var dayBusyRgb        = hexToRgb(dayBusyColor)
        var dayFullRgb        = hexToRgb(dayFullColor)

        var bizName    = (company && company.name) || (coach && (coach.businessName || coach.fullName)) || 'BranShee'
        var bizType    = (company && company.businessType) || (coach && coach.businessType) || ''
        var bizStreet  = (coach && estab.location && estab.location.address) || ''
        var bizCity    = (coach && estab.location && estab.location.city)    || ''
        var bizZip     = (coach && estab.location && estab.location.zip)     || ''
        var bizAddress = [bizStreet, bizCity].filter(Boolean).join(', ')
        var bizPic     = (company && company.photo) || (coach && (coach.businessPicture || coach.profilePicture)) || null
        var initials   = bizName.split(' ').map(function(w){return w[0]||'';}).slice(0,2).join('').toUpperCase()

        // Google Maps link — priorité : gmapUrl stocké, puis coordonnées, puis adresse
        var _googleMapsUrl = ''
        if (coach && estab.location) {
            if (estab.location.gmapUrl && /^https?:\/\//.test(estab.location.gmapUrl)) {
                _googleMapsUrl = estab.location.gmapUrl
            } else if (estab.location.lat && estab.location.lon) {
                _googleMapsUrl = 'https://maps.google.com/?q=' + estab.location.lat + ',' + estab.location.lon
            } else if (bizStreet || bizCity) {
                _googleMapsUrl = 'https://maps.google.com/?q=' + encodeURIComponent([bizStreet, bizCity, bizZip].filter(Boolean).join(', '))
            }
        }

        // Adresse affichée (texte complet si une seule ligne, sinon composée)
        var _displayAddress = ''
        if (coach && estab.location) {
            if (estab.location.address && estab.location.city && estab.location.address.toLowerCase().includes(estab.location.city.toLowerCase())) {
                // L'adresse contient déjà la ville (enregistrée comme adresse complète)
                _displayAddress = estab.location.address
            } else {
                _displayAddress = [estab.location.address, estab.location.city].filter(Boolean).join(', ')
            }
        }

        // Google Maps embed — priorité : iframeUrl (adresse texte), puis coordonnées
        var _mapEmbedSrc = ''
        if (coach && estab.location) {
            if (estab.location.iframeUrl) {
                _mapEmbedSrc = estab.location.iframeUrl
            } else if (estab.location.lat && estab.location.lon) {
                _mapEmbedSrc = 'https://maps.google.com/maps?q=' + estab.location.lat + ',' + estab.location.lon + '&output=embed&hl=fr&z=16'
            } else if (_displayAddress) {
                _mapEmbedSrc = 'https://maps.google.com/maps?q=' + encodeURIComponent(_displayAddress) + '&output=embed&hl=fr&z=16'
            }
        }
        var showMap   = cs.showSectionMap   !== false && _mapEmbedSrc !== ''
        // Le bouton « Carte » de Personnaliser pilote TOUTE la section Localisation.
        // Avant, la section restait affichée dès qu'une adresse existait (même
        // carte désactivée) : on se retrouvait avec un bloc entier alors que
        // l'adresse figure déjà, en une ligne, dans l'en-tête de la page.
        var showLocation = cs.showSectionMap !== false && (showMap || (_displayAddress && _displayAddress.trim()))
        var showHours = cs.showSectionHours !== false && company && company.schedule && company.schedule.length > 0
        // NB : calculé ici (et non plus loin, près de la galerie) car la boucle
        // `each _sec in _secOrder` ci-dessous teste `showGallery` — avec `var`,
        // la déclaration est "hoistée" en tête de fonction mais l'affectation ne
        // l'est pas, donc si on ne calculait `showGallery` qu'après la boucle,
        // sa valeur valait `undefined` au moment du test et la section galerie
        // ne s'affichait jamais sur la page publique.
        var showGallery = cs.showSectionGallery === true && gallery && gallery.length > 0

    if cs.customFontUrl
        link(rel="stylesheet" href=cs.customFontUrl)

    -
        var _fontMap = {
            'Inter':            "'Inter', system-ui, -apple-system, sans-serif",
            'Poppins':          "'Poppins', system-ui, sans-serif",
            'Lato':             "'Lato', system-ui, sans-serif",
            'Montserrat':       "'Montserrat', system-ui, sans-serif",
            'Playfair Display': "'Playfair Display', Georgia, serif",
            'Nunito':           "'Nunito', system-ui, sans-serif"
        };
        var _fontVal = _fontMap[cs.font] || _fontMap['Inter'];
        if (cs.customFontFamily) {
            _fontVal = "'" + cs.customFontFamily + "', " + _fontVal;
        }
        var _radMap = {
            'none': { xs:'0px',  sm:'0px',  md:'0px',  lg:'0px',  xl:'0px',  pill:'0px'   },
            'sm':   { xs:'4px',  sm:'6px',  md:'8px',  lg:'10px', xl:'14px', pill:'999px' },
            'md':   { xs:'6px',  sm:'8px',  md:'12px', lg:'16px', xl:'24px', pill:'999px' },
            'lg':   { xs:'8px',  sm:'12px', md:'18px', lg:'24px', xl:'36px', pill:'999px' }
        };
        var _R = _radMap[cs.borderRadius] || _radMap['md'];
        var _bdMap = {
            'none':   { color:'transparent', strong:'transparent' },
            'subtle': { color:'#e3e8e4',     strong:'#c8d4ca'     },
            'medium': { color:'#c4cfc6',     strong:'#9aab9d'     },
            'strong': { color:'#8a9e8d',     strong:'#4d6651'     }
        };
        var _BD = _bdMap[cs.borderStyle] || _bdMap['subtle'];
        var _shMap = {
            'none':   { xs:'none', sm:'none', md:'none', lg:'none' },
            'subtle': { xs:'0 1px 2px rgba(15,23,25,0.04)', sm:'0 1px 3px rgba(15,23,25,0.06),0 1px 2px rgba(15,23,25,0.04)', md:'0 4px 12px rgba(15,23,25,0.08),0 2px 4px rgba(15,23,25,0.04)', lg:'0 12px 32px rgba(15,23,25,0.12),0 4px 8px rgba(15,23,25,0.05)' },
            'medium': { xs:'0 1px 4px rgba(0,0,0,0.10)',    sm:'0 2px 6px rgba(0,0,0,0.12)',    md:'0 6px 18px rgba(0,0,0,0.14)',    lg:'0 16px 40px rgba(0,0,0,0.16)' },
            'strong': { xs:'0 2px 6px rgba(0,0,0,0.18)',    sm:'0 4px 12px rgba(0,0,0,0.22)',   md:'0 10px 28px rgba(0,0,0,0.26)',   lg:'0 24px 56px rgba(0,0,0,0.30)' }
        };
        var _SH = _shMap[cs.shadowStyle] || _shMap['subtle'];

        // Couleurs optionnelles (jour sélectionné / survol / bouton survol) —
        // vide = pas injecté du tout, pour laisser le fallback CSS (var(--a,
        // var(--b))) suivre automatiquement accent / teintes de dispo.
        // isHexColor() : on n'injecte dans le <style> que des valeurs qui
        // ressemblent vraiment à une couleur — ces champs viennent d'un
        // <input type="color">, mais on ne fait jamais confiance à une valeur
        // stockée pour l'écrire telle quelle dans une feuille de style.
        function isHexColor(v) { return typeof v === 'string' && /^#[0-9a-fA-F]{3,8}$/.test(v); }

        var rootVars = {
            '--bk-accent':        accentColor,
            '--bk-accent-text':   accentText,
            '--bk-accent-soft':   'rgba(' + accentRgb + ', 0.10)',
            '--bk-accent-border': 'rgba(' + accentRgb + ', 0.35)',
            '--bk-accent-ink':    accentColor,
            '--bk-bg':      cs.pageBg || '#f7f8f7',
            '--bk-surface': cs.calBg  || '#ffffff',
            '--bk-day-bg':  cs.dayBg  || '#ffffff',
            '--bk-day-available-color': dayAvailableColor,
            '--bk-day-available-bg':    'rgba(' + dayAvailableRgb + ', 0.08)',
            '--bk-day-available-bg-hover': 'rgba(' + dayAvailableRgb + ', 0.16)',
            '--bk-day-busy-color': dayBusyColor,
            '--bk-day-busy-bg':    'rgba(' + dayBusyRgb + ', 0.10)',
            '--bk-day-busy-bg-hover': 'rgba(' + dayBusyRgb + ', 0.18)',
            '--bk-day-full-color': dayFullColor,
            '--bk-day-full-bg':    'rgba(' + dayFullRgb + ', 0.08)',
            '--bk-font':    _fontVal,
            '--bk-r-xs':    _R.xs,
            '--bk-r-sm':    _R.sm,
            '--bk-r-md':    _R.md,
            '--bk-r-lg':    _R.lg,
            '--bk-r-xl':    _R.xl,
            '--bk-r-pill':  _R.pill,
            '--bk-border':        _BD.color,
            '--bk-border-strong': _BD.strong,
            '--bk-shadow-xs': _SH.xs,
            '--bk-shadow-sm': _SH.sm,
            '--bk-shadow-md': _SH.md,
            '--bk-shadow-lg': _SH.lg
        };
        if (isHexColor(cs.daySelectedBg))   rootVars['--bk-day-selected-bg']   = cs.daySelectedBg;
        if (isHexColor(cs.daySelectedText)) rootVars['--bk-day-selected-text'] = cs.daySelectedText;
        if (isHexColor(cs.dayHoverBg))      rootVars['--bk-day-hover-bg']      = cs.dayHoverBg;
        if (isHexColor(cs.btnHoverBg)) {
            rootVars['--bk-btn-hover-bg']      = cs.btnHoverBg;
            rootVars['--bk-btn-hover-opacity'] = '1';
        }
        var rootCss = ':root{' + Object.keys(rootVars).map(function (k) {
            return k + ':' + rootVars[k] + ';';
        }).join('') + '}';
    style!= rootCss

    //- ── Top bar ────────────────────────────────────────────────────────────
    header.bk-top
        a.bk-brand(href="/")
            img.bk-brand__mark(src="/images/icon.svg" alt="" width="28" height="28")
            span.bk-brand__name BranShee
        .bk-top__right
            //- Installer l'app — cette page a sa propre barre, elle ne reçoit donc
            //- pas le bouton de la topbar partagée. Masqué par le JS tant que
            //- l'installation n'est pas réellement possible.
            button.bk-sign-btn.bk-install-btn(type="button" hidden data-pwa-install aria-label="Installer l'application" title="Installer l'application")
                svg(width="15" height="15" viewBox="0 -960 960 960" fill="currentColor")
                    path(d="M480-320 280-520l56-58 104 104v-326h80v326l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z")

            //- Connecté AVEC établissement : accès à son espace client ET à son
            //- établissement (comptes unifiés). Sinon : juste l'espace client,
            //- ou « Se connecter » pour un visiteur anonyme.
            //- Libellés dans un <span> et non en texte nu : sur téléphone, marque
            //- + deux boutons libellés dépassent largement la largeur de l'écran
            //- et le second bouton était coupé net par le bord. Le CSS masque ces
            //- spans sous 560px — il ne reste que l'icône, `title` donne le sens.
            if visitorIsAdmin
                a.bk-sign-btn(href="/espace-client" title="Espace client")
                    svg(width="14" height="14" viewBox="0 -960 960 960" fill="currentColor")
                        path(d="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 129-46.5T480-440q68 0 135 15.5T744-378q29 15 46.5 43.5T808-272v112H160Z")
                    span.bk-sign-btn__t Espace client
                a.bk-sign-btn.bk-sign-btn--primary(href="/appointment" title="Établissement")
                    svg(width="14" height="14" viewBox="0 -960 960 960" fill="currentColor")
                        path(d="M160-120v-660l320-180 320 180v660H560v-200H400v200H160Zm240-360h80v-80h-80v80Zm-160 0h80v-80h-80v80Zm320 0h80v-80h-80v80Z")
                    span.bk-sign-btn__t Établissement
            else if clientUser
                a.bk-sign-btn(href="/espace-client" title="Espace client")
                    svg(width="14" height="14" viewBox="0 -960 960 960" fill="currentColor")
                        path(d="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 129-46.5T480-440q68 0 135 15.5T744-378q29 15 46.5 43.5T808-272v112H160Z")
                    span.bk-sign-btn__t Espace client
                //- Déconnexion : cette barre n'en avait aucune. Sur un poste
                //- partagé, la session restait ouverte sans moyen visible de
                //- la fermer depuis la page de réservation.
                a.bk-sign-btn.bk-install-btn(href="/logout" title="Déconnexion" aria-label="Déconnexion")
                    svg(width="15" height="15" viewBox="0 -960 960 960" fill="currentColor")
                        path(d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h280v80H200Zm440-160-55-58 102-102H360v-80h327L585-622l55-58 200 200-200 200Z")
            else
                //- Retiré par index.js quand la page est encadrée dans le site
                //- d'un professionnel : la connexion n'y aboutit pas (cookie
                //- tiers bloqué), et un bouton qui ne peut pas tenir sa
                //- promesse vaut moins que pas de bouton du tout. Le serveur,
                //- lui, ne sait pas qu'il est dans une iframe — d'où le
                //- repère plutôt qu'une condition Pug.
                a.bk-sign-btn#bkHeaderSignIn(href="/login") Se connecter

    //- ── Main ───────────────────────────────────────────────────────────────
    main.bk-main
        .bk-inner

            //- ── Company header ─────────────────────────────────────────────
            .bk-head
                .bk-cover
                    if bizPic
                        img(src=bizPic alt=bizName)
                    else
                        span= initials
                .bk-head__info
                    h1.bk-head__name= bizName
                    if bizType || bizAddress
                        p.bk-head__meta
                            if bizType
                                span= bizType
                            if bizType && bizAddress
                                |  ·
                            if bizAddress
                                if _googleMapsUrl
                                    a.bk-head__addr-link(href=_googleMapsUrl target="_blank" rel="noopener")
                                        svg(xmlns="http://www.w3.org/2000/svg" height="12px" viewBox="0 -960 960 960" width="12px" fill="currentColor")
                                            path(d="M480-480q33 0 56.5-23.5T560-560q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 33 23.5 56.5T480-480Zm0 294q122-112 181-203.5T720-552q0-109-69.5-178.5T480-800q-101 0-170.5 69.5T240-552q0 71 59 162.5T480-186Z")
                                        = bizAddress
                                else
                                    span= bizAddress
                    .bk-head__pills
                        if isOpenToday
                            span.bk-pill.bk-pill--accent Ouvert aujourd'hui
                        -
                            var _showSocials = coach && (coach.isPremium || (coach.calendarSettings && coach.calendarSettings.showSocials !== false))
                            var _validPhone  = function(v) { return v && v !== 'on' && /[\d+]/.test(v) }
                            var _validUrl    = function(v) { return v && /^https?:\/\//.test(v) }
                        if _showSocials
                            if estab.emailPro && estab.emailPro.indexOf('@') !== -1
                                button.bk-pill.bk-pill--social.bk-pill--copy(type="button" data-copy=estab.emailPro title="Copier l'email")= estab.emailPro
                            if _validPhone(estab.phonePro)
                                button.bk-pill.bk-pill--social.bk-pill--copy(type="button" data-copy=estab.phonePro title="Copier le téléphone")= estab.phonePro
                            if _validUrl(estab.instagramLink)
                                a.bk-pill.bk-pill--social(href=estab.instagramLink target="_blank" rel="noopener") Instagram
                            if _validUrl(estab.facebookLink)
                                a.bk-pill.bk-pill--social(href=estab.facebookLink target="_blank" rel="noopener") Facebook
                            if estab.whatsappLink
                                - var _waHref = /^https?:\/\//.test(estab.whatsappLink) ? estab.whatsappLink : 'https://wa.me/' + estab.whatsappLink.replace(/\D/g,'')
                                a.bk-pill.bk-pill--social(href=_waHref target="_blank" rel="noopener") WhatsApp
                            if _validUrl(estab.website)
                                a.bk-pill.bk-pill--social(href=estab.website target="_blank" rel="noopener") Site web

            //- ── Guide réservation ──────────────────────────────────────────
            .bk-booking-guide
                svg(xmlns="http://www.w3.org/2000/svg" height="15px" viewBox="0 -960 960 960" width="15px" fill="currentColor" aria-hidden="true")
                    path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Zm-20 200v-240l160 120-160 120Z")
                span Réservez votre rendez-vous — choisissez un service pour commencer

            //- ── Stepper ────────────────────────────────────────────────────
            nav.bk-stepper#bkStepper

            //- ── Step pane (JS-rendered) ────────────────────────────────────
            #bkPane

            //- ── Sections dans l'ordre défini par l'admin ────────────────────
            -
                var _secOrder = (cs && cs.sectionOrder && cs.sectionOrder.length) ? cs.sectionOrder : ['about','location','hours','gallery','reviews']
            each _sec in _secOrder
                if _sec === 'location' && showLocation
                    .bk-location-card
                        h2.bk-location-card__title
                            svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                path(d="M480-480q33 0 56.5-23.5T560-560q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 33 23.5 56.5T480-480Zm0 294q122-112 181-203.5T720-552q0-109-69.5-178.5T480-800q-101 0-170.5 69.5T240-552q0 71 59 162.5T480-186Zm0 106Q319-217 239.5-334.5T160-552q0-150 96.5-239T480-880q127 0 223.5 89T800-552q0 100-79.5 217.5T480-80Z")
                            | Localisation
                        if _displayAddress && _displayAddress.trim()
                            .bk-location-card__addr
                                svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                    path(d="M480-480q33 0 56.5-23.5T560-560q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 33 23.5 56.5T480-480Zm0 294q122-112 181-203.5T720-552q0-109-69.5-178.5T480-800q-101 0-170.5 69.5T240-552q0 71 59 162.5T480-186Z")
                                span= _displayAddress
                                .bk-location-card__actions
                                    button.bk-copy-addr(
                                        type="button"
                                        title="Copier l'adresse"
                                        data-addr=_displayAddress
                                    )
                                        svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
