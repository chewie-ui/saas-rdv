                                svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" class=(si <= Math.round(avgRating) ? 'filled' : ''))
                                    path(d="m233-120 65-281L80-580l288-25 112-265 112 265 288 25-218 179 65 281-247-149-247 149Z")
