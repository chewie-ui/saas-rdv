extends ../../layouts/booking

block jsonld
    - var _bizName = (coach && (coach.businessName || coach.fullName)) || 'BranShee Pro'
    - var _bizDesc = (coach && coach.description) || ''
    - var _bizImg  = (coach && (coach.businessPicture || coach.profilePicture)) || ''
    - var _bizCity = (coach && coach.location && coach.location.city) || ''
    - var _bizAddr = (coach && coach.location && coach.location.street) || ''
    - var _bizZip  = (coach && coach.location && coach.location.zip) ? String(coach.location.zip) : ''
    - var _bizUrl  = 'https://www.saymiro.com/' + (company ? String(company._id) : '')
    script(type="application/ld+json").
        {
          "@context": "https://schema.org",
          "@type": "LocalBusiness",
          "name": "!{_bizName}",
          "description": "!{_bizDesc}",
          "image": "!{_bizImg}",
          "url": "!{_bizUrl}",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "!{_bizAddr}",
            "addressLocality": "!{_bizCity}",
            "postalCode": "!{_bizZip}",
            "addressCountry": "FR"
          }
        }

block content
    -
        var cs          = (coach && coach.calendarSettings) ? coach.calendarSettings : {}
        var accentColor = cs.accentColor || '#22c55e'
        var accentText  = cs.accentText  || '#ffffff'

        // Compute soft accent (rgba) server-side from hex
        function hexToRgb(hex) {
            if (!hex || hex.length < 7) return '34,197,94';
            return parseInt(hex.slice(1,3),16)+','+parseInt(hex.slice(3,5),16)+','+parseInt(hex.slice(5,7),16);
        }
        var accentRgb = hexToRgb(accentColor)

        var bizName    = (coach && (coach.businessName || coach.fullName)) || 'BranShee'
        var bizType    = (coach && coach.businessType) || ''
        var bizStreet  = (coach && coach.location && coach.location.street) || ''
        var bizCity    = (coach && coach.location && coach.location.city)   || ''
        var bizAddress = [bizStreet, bizCity].filter(Boolean).join(', ')
        var bizPic     = coach && (coach.businessPicture || coach.profilePicture) ? (coach.businessPicture || coach.profilePicture) : null
        var initials   = bizName.split(' ').map(function(w){return w[0]||'';}).slice(0,2).join('').toUpperCase()

    style.
        :root {
            --bk-accent:      #{accentColor};
            --bk-accent-text: #{accentText};
            --bk-accent-soft: rgba(#{accentRgb}, 0.10);
            --bk-accent-border: rgba(#{accentRgb}, 0.35);
            --bk-accent-ink:  #{accentColor};
        }

    //- ── Top bar ────────────────────────────────────────────────────────────
    header.bk-top
        a.bk-brand(href="/")
            .bk-brand__mark B
            span.bk-brand__name BranShee
        .bk-top__right
            if clientUser
                a.bk-sign-btn(href="/client/dashboard") Mon espace
            else
                a.bk-sign-btn(href="/login") Se connecter

    //- ── Main ───────────────────────────────────────────────────────────────
    main.bk-main
        .bk-inner

            //- ── Company header ─────────────────────────────────────────────
            .bk-head
                .bk-cover
                    if bizPic
                        img(src=bizPic alt=bizName)
                    else
                        span= initials
                .bk-head__info
                    h1.bk-head__name= bizName
                    if bizType || bizAddress
                        p.bk-head__meta
                            if bizType
                                span= bizType
                            if bizType && bizAddress
                                |  ·
                            if bizAddress
                                span= bizAddress
                    .bk-head__pills
                        if coach && coach.isPremium
                            span.bk-pill.bk-pill--accent Ouvert aujourd'hui
                        span.bk-pill Réservation en ligne

            //- ── Stepper ────────────────────────────────────────────────────
            nav.bk-stepper#bkStepper

            //- ── Step pane (JS-rendered) ────────────────────────────────────
            #bkPane

    //- ── Sticky cart (JS-rendered) ──────────────────────────────────────────
    #bkCart

block scripts
    script.
        window.__services  = !{servicesJson  || '[]'};
        window.__employees = !{employeesJson || '[]'};
    if clientUser
        script.
            window.__clientUser = !{JSON.stringify(clientUser)};
    script(src="/js/layouts/index.js" type="module")
