                    span Pour laisser un avis,&nbsp;
                    a.bk-review-login__link(href=`/login?returnTo=${encodeURIComponent('/' + (company.slug || company._id))}`) connectez-vous

            //- ── Liste des avis ─────────────────────────────────────────────
            if reviews && reviews.length > 0
                .bk-review-list#bkReviewList
                    each review in reviews
