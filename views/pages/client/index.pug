            city:        (coach && estab.location && estab.location.city)        ? estab.location.city        : '',
            serviceType: (coach && estab.location && estab.location.serviceType) ? estab.location.serviceType : 'sur_place',
            //- Nom de l'établissement (déjà résolu plus haut, repli compte
            //- inclus) : utilisé par les messages d'erreur et le titre de
            //- l'événement Google Agenda côté client.
            businessName: _bizName
        }
    if prepaymentConfig && prepaymentConfig.stripeActive && stripePublishableKey && (prepaymentConfig.enabled || (prepaymentConfig.cancellationRule && prepaymentConfig.cancellationRule !== 'free'))
        script(src="https://js.stripe.com/v3/")
    -
        // Textes personnalisés du parcours de réservation — JSON.stringify
        // échappe déjà les guillemets, mais pas un éventuel "</script>" dans
        // le texte libre, qui couperait la balise <script> côté navigateur.
        // On échappe donc aussi "<" avant d'injecter.
        function jsonForScript(v) { return JSON.stringify(v).replace(/</g, '\\u003c'); }
        var bkTexts = {
            calendarHelp: cs.textCalendarHelp || '',
            slotHeading:  cs.textSlotHeading  || '',
            timezone:     cs.textTimezone     || ''
        };
    script.
        window.__services       = !{servicesJson  || '[]'};
        window.__employees      = !{employeesJson || '[]'};
        window.__companyInfo    = !{JSON.stringify(_companyInfo)};
        //- Catégories de l'ÉTABLISSEMENT affiché, pas du compte propriétaire :
        //- un patron avec deux établissements affichait les mêmes catégories
        //- sur les deux pages publiques. Repli sur le compte pour les
        //- établissements créés avant la bascule (cf. migration).
        window.__categoriesMeta = !{JSON.stringify((company && company.categories && company.categories.length ? company.categories : cs.categories) || [])};
        window.__bookingCategoryStyle = !{JSON.stringify((company && company.bookingCategoryStyle) || cs.bookingCategoryStyle || 'pills')};
        window.__prepayment     = !{JSON.stringify(prepaymentConfig || { enabled: false, required: false })};
        window.__stripeKey      = '!{stripePublishableKey || ""}';
        window.__bookingQuestion = !{JSON.stringify((company && company.bookingQuestion) || { enabled: false, question: '', newLabel: '', existingLabel: '' })};
        //- Questionnaire unifié (nouveau multi-questions, ou ancien converti) — pilote le filtrage des services côté client.
        window.__questionnaire  = !{questionnaireJson || '{"enabled":false,"questions":[]}'};
        window.__bkTexts        = !{jsonForScript(bkTexts)};
        //- Téléphone obligatoire (Personnaliser > Réservation). `!== false` :
        //- sur une fiche antérieure au réglage, le champ est absent — et le
        //- défaut voulu est « obligatoire ».
        window.__phoneRequired  = !{JSON.stringify((cs && cs.phoneRequired) !== false)};
    if clientUser
        script.
            window.__clientUser = !{JSON.stringify(clientUser)};
    script(src="/js/layouts/index.js" type="module")
    script.
        // ── About "Voir plus / Voir moins" ────────────────────────────────────
        (function() {
            var toggle = document.getElementById('bkAboutToggle');
            var text   = document.getElementById('bkAboutText');
            if (!toggle || !text) return;
            var open = false;

            function setLabel() {
                toggle.querySelector('span').textContent = open ? 'Voir moins' : 'Voir plus';
                toggle.querySelector('svg').style.transform = open ? 'rotate(180deg)' : '';
            }

            if (text.classList.contains('bk-about-card__text--rich')) {
                // Texte enrichi (HTML) : on ne peut pas découper le balisage —
                // on s'appuie sur un clamp CSS (line-clamp) que l'on bascule.
                text.classList.add('bk-about-card__text--short');
                toggle.addEventListener('click', function() {
                    open = !open;
                    text.classList.toggle('bk-about-card__text--short', !open);
                    setLabel();
                });
            } else {
                // Texte brut : on découpe simplement la chaîne
                var full  = text.textContent;
                var SHORT = 220;
                text.textContent = full.slice(0, SHORT) + '…';
                text.classList.add('bk-about-card__text--short');
                toggle.addEventListener('click', function() {
                    open = !open;
                    text.textContent = open ? full : full.slice(0, SHORT) + '…';
                    text.classList.toggle('bk-about-card__text--short', !open);
                    setLabel();
                });
            }
        })();
    script.
        // ── Embed iframe : masquer les sections via ?sections=booking,profile,... ──
        (function() {
            var params = new URLSearchParams(window.location.search);
            if (!params.has('sections')) return;
            var selected = params.get('sections').split(',').map(function(s){ return s.trim(); }).filter(Boolean);
            var SECTION_SELECTORS = {
                profile:  '.bk-head',
                reviews:  'section.bk-reviews, .bk-reviews',
                about:    '.bk-about-card, .bk-info-section, .bk-location-card',
                hours:    '.bk-hours-card'
            };
            var hiddenCss = '';
            Object.keys(SECTION_SELECTORS).forEach(function(key) {
                if (selected.indexOf(key) === -1) {
                    hiddenCss += SECTION_SELECTORS[key] + ' { display:none !important; }\n';
                }
            });
            if (hiddenCss) {
                var style = document.createElement('style');
                style.textContent = hiddenCss;
                document.head.appendChild(style);
            }

            // ── Mode embed : on retire le header (bouton "Se connecter")          ──
            // ── et on remplace par un petit badge "Propulsé par BranShee"         ──
            // ── + on supprime les hauteurs/marges forcées pour éviter le scroll   ──
            document.documentElement.classList.add('bk-embed');
            document.body.classList.add('bk-embed');

            var top = document.querySelector('.bk-top');
            if (top) top.remove();

            var _embedBizUrl = !{JSON.stringify(_bizUrl || 'https://www.branshee.com')};
            var badge = document.createElement('a');
            badge.className = 'bk-embed-badge';
            badge.href = _embedBizUrl + '?utm_source=embed&utm_medium=iframe';
            badge.target = '_blank';
            badge.rel = 'noopener';
            //- URL absolue : ce badge est injecté dans l'iframe du widget sur
            //- un site TIERS, donc "/images/icon.svg" relatif pointerait vers
            //- le domaine de l'hébergeur au lieu de branshee.com.
            badge.innerHTML = '<img class="bk-embed-badge__mark" src="https://www.branshee.com/images/icon.svg" alt="" width="18" height="18"><span>Ouvrir dans un nouvel onglet ↗</span>';
            document.body.appendChild(badge);

            // ── Titre personnalisé au-dessus du calendrier ──
            var embedTitle = !{JSON.stringify((cs && cs.embedTitle) || '')};
            if (embedTitle) {
                var titleEl = document.createElement('h1');
                titleEl.className = 'bk-embed-title';
                titleEl.textContent = embedTitle;
                var main = document.querySelector('.bk-main');
                if (main) main.insertBefore(titleEl, main.firstChild);
            }

            // ── Police personnalisée ──
            var embedFontUrl    = !{JSON.stringify((cs && cs.embedFontUrl) || '')};
            var embedFontFamily = !{JSON.stringify((cs && cs.embedFontFamily) || '')};
            if (embedFontUrl) {
                var fontLink = document.createElement('link');
                fontLink.rel = 'stylesheet';
                fontLink.href = embedFontUrl;
                document.head.appendChild(fontLink);
            }
            if (embedFontFamily) {
                var fontStyle = document.createElement('style');
                fontStyle.textContent = 'body.bk-embed, body.bk-embed * { font-family: ' + embedFontFamily + ', var(--bk-font) !important; }';
                document.head.appendChild(fontStyle);
            }
        })();
    script.
        // ── Auto-redimensionnement de l'iframe d'intégration ───────────────────
        // Quand la page de réservation est chargée dans une iframe sur un site
        // tiers, elle mesure sa propre hauteur et l'envoie au script du code
        // d'intégration (voir « Personnaliser › Intégration »). Sans ça, l'iframe
        // garde sa hauteur initiale : sur un écran peu haut, le bas du tunnel
        // (bouton « Continuer », créneaux…) est coupé et impossible à atteindre.
        (function () {
            if (window.self === window.top) return; // pas dans une iframe

            // Mode embed → hauteur auto. Indispensable pour la mesure : sinon le
            // <html>/<body> hérite de la hauteur de l'iframe et la valeur boucle.
            document.documentElement.classList.add('bk-embed');
            document.body.classList.add('bk-embed');

            var derniere = 0;
            var enAttente = false;

            function mesurer() {
                // On mesure sur le <body> uniquement : le scrollHeight du <html>
                // ne descend jamais sous la hauteur courante de l'iframe (il est
                // « plafonné » à la fenêtre), ce qui empêcherait de rétrécir et
                // pourrait faire dériver la hauteur de +N px à chaque tick.
                var b = document.body;
                if (!b) return 0;
                return Math.max(b.scrollHeight, b.offsetHeight, Math.ceil(b.getBoundingClientRect().height));
            }

            function envoyer() {
                enAttente = false;
                var haut = mesurer();
                // Seuil de 2px : évite un aller-retour permanent sur des écarts
                // d'arrondi sub-pixel (et donc une boucle avec le parent).
                if (!haut || Math.abs(haut - derniere) < 2) return;
                derniere = haut;
                try {
                    window.parent.postMessage({ type: 'branshee-resize', height: haut }, '*');
                } catch (e) {}
            }

            function planifier() {
                if (enAttente) return;
                enAttente = true;
                // setTimeout plutôt que requestAnimationFrame : dans une iframe
                // occultée, le navigateur throttle rAF (parfois ~1 img/s), ce qui
                // retarderait le recalcul de hauteur d'une seconde ou plus.
                setTimeout(envoyer, 16);
            }

            // Déclencheurs : chargement complet, redimensionnement, polices, et
            // tout changement de contenu (étapes du tunnel, créneaux qui
            // s'ouvrent, questionnaire…).
            window.addEventListener('load', planifier);
            window.addEventListener('resize', planifier);
            if (document.fonts && document.fonts.ready) document.fonts.ready.then(planifier);

            if (window.ResizeObserver) {
                new ResizeObserver(planifier).observe(document.body);
            }
            if (window.MutationObserver) {
                new MutationObserver(planifier).observe(document.body, {
                    childList: true, subtree: true, attributes: true, characterData: true
                });
            }

            // Filet de sécurité les premières secondes, le temps que les images
            // et les polices finissent de se charger.
            [0, 120, 350, 700, 1200, 2500].forEach(function (t) { setTimeout(planifier, t); });
        })();
    script.
        document.querySelectorAll('.bk-pill--copy').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var val = btn.dataset.copy;
                if (!val) return;
                navigator.clipboard.writeText(val).then(function() {
                    var orig = btn.textContent;
                    btn.textContent = 'Copié !';
                    btn.style.background = 'var(--bk-accent-soft)';
                    btn.style.borderColor = 'var(--bk-accent-border)';
                    btn.style.color = 'var(--bk-accent-ink)';
                    setTimeout(function() {
                        btn.textContent = orig;
                        btn.style.background = '';
                        btn.style.borderColor = '';
                        btn.style.color = '';
                    }, 1500);
                });
            });
        });
    script.
        // ── Copier l'adresse ──────────────────────────────────────────────────
        document.querySelectorAll('.bk-copy-addr').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var addr = btn.dataset.addr || btn.closest('.bk-location-card__addr').querySelector('span').textContent;
                if (!addr) return;
                var doFeedback = function() {
                    var origHtml = btn.innerHTML;
                    btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor"><path d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z"/></svg><span>Copié !</span>';
                    btn.classList.add('copied');
                    setTimeout(function() { btn.innerHTML = origHtml; btn.classList.remove('copied'); }, 1800);
                };
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(addr).then(doFeedback).catch(doFeedback);
                } else {
                    var ta = document.createElement('textarea');
                    ta.value = addr; ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none;';
                    document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
                    doFeedback();
                }
            });
        });
    script.
        // ── Système d'avis ────────────────────────────────────────────────────
        (function() {
            var COMPANY_ID = '!{company._id}';

            // ── Étoiles interactives ─────────────────────────────────────────
            var starInput  = document.getElementById('bkStarInput');
            var ratingVal  = document.getElementById('bkRatingVal');
            if (starInput) {
                var stars = starInput.querySelectorAll('svg');
                function paintStars(n) {
                    stars.forEach(function(s, i) { s.classList.toggle('filled', i < n); });
                }
                stars.forEach(function(star, idx) {
                    star.addEventListener('mouseenter', function() { paintStars(idx + 1); });
                    star.addEventListener('mouseleave', function() { paintStars(Number(ratingVal.value)); });
                    star.addEventListener('click', function() {
                        ratingVal.value = idx + 1;
                        paintStars(idx + 1);
                    });
                });
            }

            // ── Soumettre l'avis ─────────────────────────────────────────────
            var submitBtn  = document.getElementById('bkReviewSubmit');
            var statusEl   = document.getElementById('bkReviewStatus');
            var commentEl  = document.getElementById('bkReviewComment');
            if (submitBtn) {
                submitBtn.addEventListener('click', async function() {
                    var rating = Number(ratingVal ? ratingVal.value : 0);
                    if (!rating) { if(statusEl){ statusEl.textContent = 'Choisissez une note.'; statusEl.style.color='#b45309'; } return; }
                    submitBtn.disabled = true;
                    submitBtn.textContent = '...';
                    if (statusEl) statusEl.textContent = '';
                    try {
                        var res  = await fetch('/reviews/' + COMPANY_ID, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ rating: rating, comment: commentEl ? commentEl.value : '' })
                        });
                        var data = await res.json();
                        if (data.success) {
                            window.location.reload();
                        } else {
                            if (statusEl) { statusEl.textContent = data.error || 'Erreur.'; statusEl.style.color = '#b91c1c'; }
                            submitBtn.disabled = false;
                            submitBtn.textContent = "Publier l'avis";
                        }
                    } catch(e) {
                        if (statusEl) { statusEl.textContent = 'Erreur réseau.'; statusEl.style.color = '#b91c1c'; }
                        submitBtn.disabled = false;
                        submitBtn.textContent = "Publier l'avis";
                    }
                });
            }

            // ── Petite modale de confirmation (remplace window.confirm) ──────
            function bkConfirm(message) {
                return new Promise(function(resolve) {
                    var overlay = document.createElement('div');
                    overlay.className = 'bk-confirm-overlay';
                    overlay.innerHTML =
                        '<div class="bk-confirm-card" role="alertdialog" aria-modal="true">' +
                            '<div class="bk-confirm-icon">' +
                                '<svg width="22" height="22" viewBox="0 -960 960 960" fill="currentColor"><path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/></svg>' +
                            '</div>' +
                            '<p class="bk-confirm-msg"></p>' +
                            '<div class="bk-confirm-actions">' +
                                '<button type="button" class="bk-confirm-btn bk-confirm-btn--ghost" data-act="cancel">Annuler</button>' +
                                '<button type="button" class="bk-confirm-btn bk-confirm-btn--danger" data-act="ok">Supprimer</button>' +
                            '</div>' +
                        '</div>';
                    overlay.querySelector('.bk-confirm-msg').textContent = message;
                    document.body.appendChild(overlay);

                    function close(result) { overlay.remove(); resolve(result); }
                    overlay.addEventListener('click', function(e) { if (e.target === overlay) close(false); });
                    overlay.querySelector('[data-act="cancel"]').addEventListener('click', function() { close(false); });
                    overlay.querySelector('[data-act="ok"]').addEventListener('click', function() { close(true); });
                    document.addEventListener('keydown', function onKey(e) {
                        if (e.key === 'Escape') { close(false); document.removeEventListener('keydown', onKey); }
                    });
                });
            }

            // ── Signaler un avis ─────────────────────────────────────────────
            // Accessible à tout le monde, connecté ou non. Le professionnel qui
            // consulte sa propre page voit le même bouton : sa demande sera
            // simplement étiquetée « demande du pro » côté modération.
            (function () {
                var modale  = document.getElementById('bkReportModal');
                if (!modale) return;
                var boiteErr = document.getElementById('bkReportErr');
                var champ   = document.getElementById('bkReportMsg');
                var envoyer = document.getElementById('bkReportSend');
                var ecranForm = document.getElementById('bkReportForm');
                var ecranFin  = document.getElementById('bkReportDone');
                var texteFin  = document.getElementById('bkReportDoneMsg');
                var avisId  = null;

                function ouvrir(id) {
                    avisId = id;
                    champ.value = '';
                    boiteErr.style.display = 'none';
                    envoyer.disabled = false;
                    envoyer.textContent = 'Envoyer le signalement';
                    // Toujours repartir du formulaire : la modale peut avoir été
                    // laissée sur l'écran de confirmation d'un signalement précédent.
                    ecranForm.style.display = '';
                    ecranFin.style.display = 'none';
                    var premier = document.querySelector('input[name="bkReportReason"][value="insulting"]');
                    if (premier) premier.checked = true;
                    modale.style.display = 'flex';
                }
                function fermer() { modale.style.display = 'none'; avisId = null; }

                document.querySelectorAll('.js-report').forEach(function (btn) {
                    btn.addEventListener('click', function () { ouvrir(btn.dataset.id); });
                });
                document.getElementById('bkReportCancel').addEventListener('click', fermer);
                document.getElementById('bkReportClose').addEventListener('click', fermer);
                document.getElementById('bkReportOk').addEventListener('click', fermer);
                document.getElementById('bkReportOverlay').addEventListener('click', fermer);
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && modale.style.display === 'flex') fermer();
                });

                envoyer.addEventListener('click', function () {
                    if (!avisId) return;
                    var choisi = document.querySelector('input[name="bkReportReason"]:checked');
                    envoyer.disabled = true;
                    envoyer.textContent = 'Envoi…';
                    boiteErr.style.display = 'none';
                    fetch('/reviews/' + COMPANY_ID + '/' + avisId + '/report', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reason: choisi ? choisi.value : 'other', message: champ.value })
                    })
                        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
                        .then(function (res) {
                            if (!res.ok || !res.d.success) throw new Error(res.d.error || 'Erreur.');
                            // Le bouton de la ligne devient un accusé de réception.
                            var btn = document.querySelector('.js-report[data-id="' + avisId + '"]');
                            if (btn) { btn.textContent = 'Signalé'; btn.disabled = true; btn.style.color = '#9ca3af'; }
                            // Confirmation dans la modale, pas dans une alerte du
                            // navigateur (qui affiche « localhost:3000 indique… »).
                            texteFin.textContent = res.d.message || 'Merci. Notre équipe l\'examinera sous peu.';
                            ecranForm.style.display = 'none';
                            ecranFin.style.display = 'block';
                        })
                        .catch(function (e) {
                            boiteErr.textContent = e.message || 'Erreur réseau.';
                            // Chaîne vide et non 'block' : on rend la main au CSS,
                            // qui met la boîte d'erreur en flex (icône + texte).
                            boiteErr.style.display = '';
                            envoyer.disabled = false;
                            envoyer.textContent = 'Envoyer le signalement';
                        });
                });
            })();

            // ── Supprimer son avis ───────────────────────────────────────────
            document.querySelectorAll('.bk-review-delete').forEach(function(btn) {
                btn.addEventListener('click', async function() {
                    if (!(await bkConfirm('Voulez-vous vraiment supprimer votre avis ?'))) return;
                    var id = btn.dataset.id;
                    btn.disabled = true;
                    try {
                        var res = await fetch('/reviews/' + COMPANY_ID + '/' + id, { method: 'DELETE' });
                        var data = await res.json();
                        if (data.success) {
                            var card = btn.closest('.bk-review-card');
                            if (card) card.remove();
                            window.location.reload();
                        } else {
                            alert(data.error || 'Erreur.');
                            btn.disabled = false;
                        }
                    } catch(e) { btn.disabled = false; }
                });
            });
        })();

    //- ── Lightbox galerie ─────────────────────────────────────────────────────
    if showGallery
        script.
            (function() {
                var photos   = !{JSON.stringify(gallery || [])};
                var lb       = document.getElementById('bkLightbox');
                var lbImg    = document.getElementById('bkLbImg');
                var lbCounter= document.getElementById('bkLbCounter');
                var lbClose  = document.getElementById('bkLbClose');
                var lbPrev   = document.getElementById('bkLbPrev');
                var lbNext   = document.getElementById('bkLbNext');
                var lbOverlay= document.getElementById('bkLbOverlay');
                var current  = 0;

                function open(idx) {
                    current = ((idx % photos.length) + photos.length) % photos.length;
                    lbImg.src = photos[current];
                    lbImg.alt = 'Photo ' + (current + 1);
                    lbCounter.textContent = (current + 1) + ' / ' + photos.length;
                    lb.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                }

                function close() {
                    lb.style.display = 'none';
                    document.body.style.overflow = '';
                }

                // Ouvrir au clic sur une image
                document.querySelectorAll('.bk-gallery-item').forEach(function(item) {
                    item.addEventListener('click', function() {
                        open(parseInt(this.dataset.index) || 0);
                    });
                    item.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(parseInt(this.dataset.index) || 0); }
                    });
                });

                if (lbClose)  lbClose.addEventListener('click', close);
                if (lbOverlay)lbOverlay.addEventListener('click', close);
                if (lbPrev)   lbPrev.addEventListener('click', function() { open(current - 1); });
                if (lbNext)   lbNext.addEventListener('click', function() { open(current + 1); });

                // Clavier
                document.addEventListener('keydown', function(e) {
                    if (lb.style.display === 'none') return;
                    if (e.key === 'Escape')     close();
                    if (e.key === 'ArrowLeft')  open(current - 1);
                    if (e.key === 'ArrowRight') open(current + 1);
                });

                // Swipe tactile
                var startX = 0;
                if (lb) {
                    lb.addEventListener('touchstart', function(e) { startX = e.touches[0].clientX; }, { passive: true });
                    lb.addEventListener('touchend', function(e) {
                        var dx = e.changedTouches[0].clientX - startX;
                        if (Math.abs(dx) > 50) dx < 0 ? open(current + 1) : open(current - 1);
                    });
                }
            })();

    //- ── Navigation du carrousel galerie (si activé) ──────────────────────────
    if showGallery && cs.galleryLayout === 'carousel'
        script.
            (function() {
                var track = document.getElementById('bkGalleryCarousel');
                var prev  = document.getElementById('bkGalCarPrev');
                var next  = document.getElementById('bkGalCarNext');
                if (!track) return;

                function step() {
                    var item = track.querySelector('.bk-gallery-carousel__item');
                    var gap  = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || '10') || 10;
                    return item ? (item.getBoundingClientRect().width + gap) : (track.clientWidth * 0.8);
                }

                if (prev) prev.addEventListener('click', function() { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
                if (next) next.addEventListener('click', function() { track.scrollBy({ left:  step(), behavior: 'smooth' }); });
            })();
