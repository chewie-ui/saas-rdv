extends ../../layouts/booking

block jsonld
    - var _bizName = (coach && (coach.businessName || coach.fullName)) || 'BranShee Pro'
    - var _bizDesc = (coach && coach.description) || ''
    - var _bizImg  = (coach && (coach.businessPicture || coach.profilePicture)) || ''
    - var _bizCity = (coach && coach.location && coach.location.city) || ''
    - var _bizAddr = (coach && coach.location && coach.location.address) || ''
    - var _bizZip  = (coach && coach.location && coach.location.zip) ? String(coach.location.zip) : ''
    - var _bizUrl  = 'https://www.branshee.com/' + (company ? (company.slug || String(company._id)) : '')
    script(type="application/ld+json").
        {
          "@context": "https://schema.org",
          "@type": "LocalBusiness",
          "name": "!{_bizName}",
          "description": "!{_bizDesc}",
          "image": "!{_bizImg}",
          "url": "!{_bizUrl}",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "!{_bizAddr}",
            "addressLocality": "!{_bizCity}",
            "postalCode": "!{_bizZip}",
            "addressCountry": "FR"
          }
        }

block content
    -
        var cs          = (coach && coach.calendarSettings) ? coach.calendarSettings : {}
        var accentColor = cs.accentColor || '#22c55e'
        var accentText  = cs.accentText  || '#ffffff'

        // Compute soft accent (rgba) server-side from hex
        function hexToRgb(hex) {
            if (!hex || hex.length < 7) return '34,197,94';
            return parseInt(hex.slice(1,3),16)+','+parseInt(hex.slice(3,5),16)+','+parseInt(hex.slice(5,7),16);
        }
        var accentRgb = hexToRgb(accentColor)

        var bizName    = (coach && (coach.businessName || coach.fullName)) || 'BranShee'
        var bizType    = (coach && coach.businessType) || ''
        var bizStreet  = (coach && coach.location && coach.location.address) || ''
        var bizCity    = (coach && coach.location && coach.location.city)    || ''
        var bizZip     = (coach && coach.location && coach.location.zip)     || ''
        var bizAddress = [bizStreet, bizCity].filter(Boolean).join(', ')
        var bizPic     = coach && (coach.businessPicture || coach.profilePicture) ? (coach.businessPicture || coach.profilePicture) : null
        var initials   = bizName.split(' ').map(function(w){return w[0]||'';}).slice(0,2).join('').toUpperCase()

        // Google Maps link (lien cliquable)
        var _googleMapsUrl = ''
        if (coach && coach.location) {
            if (coach.location.lat && coach.location.lon) {
                _googleMapsUrl = 'https://maps.google.com/?q=' + coach.location.lat + ',' + coach.location.lon
            } else if (bizStreet || bizCity) {
                _googleMapsUrl = 'https://maps.google.com/?q=' + encodeURIComponent([bizStreet, bizCity, bizZip].filter(Boolean).join(', '))
            }
        }

        // Google Maps embed (iframe) — doit être calculé ICI avant la carte de localisation
        var _mapEmbedSrc = ''
        if (coach && coach.location) {
            if (coach.location.iframeUrl) {
                _mapEmbedSrc = coach.location.iframeUrl
            } else if (coach.location.lat && coach.location.lon) {
                _mapEmbedSrc = 'https://maps.google.com/maps?q=' + coach.location.lat + ',' + coach.location.lon + '&output=embed&hl=fr&z=15'
            } else if (bizStreet || bizCity) {
                _mapEmbedSrc = 'https://maps.google.com/maps?q=' + encodeURIComponent([bizStreet, bizCity, bizZip].filter(Boolean).join(', ')) + '&output=embed&hl=fr&z=15'
            }
        }
        var showMap   = cs.showSectionMap   !== false && _mapEmbedSrc !== ''
        var showHours = cs.showSectionHours !== false && company && company.schedule && company.schedule.length > 0

    style.
        :root {
            --bk-accent:      #{accentColor};
            --bk-accent-text: #{accentText};
            --bk-accent-soft: rgba(#{accentRgb}, 0.10);
            --bk-accent-border: rgba(#{accentRgb}, 0.35);
            --bk-accent-ink:  #{accentColor};
        }

    //- ── Top bar ────────────────────────────────────────────────────────────
    header.bk-top
        a.bk-brand(href="/")
            .bk-brand__mark B
            span.bk-brand__name BranShee
        .bk-top__right
            if clientUser
                a.bk-sign-btn(href="/espace-client") Mon espace
            else
                a.bk-sign-btn(href="/client/login") Se connecter

    //- ── Main ───────────────────────────────────────────────────────────────
    main.bk-main
        .bk-inner

            //- ── Company header ─────────────────────────────────────────────
            .bk-head
                .bk-cover
                    if bizPic
                        img(src=bizPic alt=bizName)
                    else
                        span= initials
                .bk-head__info
                    h1.bk-head__name= bizName
                    if bizType || bizAddress
                        p.bk-head__meta
                            if bizType
                                span= bizType
                            if bizType && bizAddress
                                |  ·
                            if bizAddress
                                if _googleMapsUrl
                                    a.bk-head__addr-link(href=_googleMapsUrl target="_blank" rel="noopener")
                                        svg(xmlns="http://www.w3.org/2000/svg" height="12px" viewBox="0 -960 960 960" width="12px" fill="currentColor")
                                            path(d="M480-480q33 0 56.5-23.5T560-560q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 33 23.5 56.5T480-480Zm0 294q122-112 181-203.5T720-552q0-109-69.5-178.5T480-800q-101 0-170.5 69.5T240-552q0 71 59 162.5T480-186Z")
                                        = bizAddress
                                else
                                    span= bizAddress
                    .bk-head__pills
                        if isOpenToday
                            span.bk-pill.bk-pill--accent Ouvert aujourd'hui
                        span.bk-pill Réservation en ligne
                        if coach && coach.isPremium
                            if coach.emailPro && coach.emailPro !== 'on'
                                button.bk-pill.bk-pill--social.bk-pill--copy(type="button" data-copy=coach.emailPro title="Copier l'email")= coach.emailPro
                            if coach.phonePro && coach.phonePro !== 'on'
                                button.bk-pill.bk-pill--social.bk-pill--copy(type="button" data-copy=coach.phonePro title="Copier le téléphone")= coach.phonePro
                            if coach.instagramLink
                                a.bk-pill.bk-pill--social(href=coach.instagramLink target="_blank" rel="noopener") Instagram
                            if coach.facebookLink
                                a.bk-pill.bk-pill--social(href=coach.facebookLink target="_blank" rel="noopener") Facebook
                            if coach.whatsappLink
                                a.bk-pill.bk-pill--social(href=coach.whatsappLink target="_blank" rel="noopener") WhatsApp
                            if coach.website
                                a.bk-pill.bk-pill--social(href=coach.website target="_blank" rel="noopener") Site web

            //- ── Stepper ────────────────────────────────────────────────────
            nav.bk-stepper#bkStepper

            //- ── Step pane (JS-rendered) ────────────────────────────────────
            #bkPane

            //- ── Localisation ───────────────────────────────────────────────
            if showMap || (bizAddress && bizAddress.trim())
                .bk-location-card
                    h2.bk-location-card__title
                        svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                            path(d="M480-480q33 0 56.5-23.5T560-560q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 33 23.5 56.5T480-480Zm0 294q122-112 181-203.5T720-552q0-109-69.5-178.5T480-800q-101 0-170.5 69.5T240-552q0 71 59 162.5T480-186Zm0 106Q319-217 239.5-334.5T160-552q0-150 96.5-239T480-880q127 0 223.5 89T800-552q0 100-79.5 217.5T480-80Z")
                        | Localisation
                    if bizAddress && bizAddress.trim()
                        .bk-location-card__addr
                            svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                path(d="M480-480q33 0 56.5-23.5T560-560q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 33 23.5 56.5T480-480Zm0 294q122-112 181-203.5T720-552q0-109-69.5-178.5T480-800q-101 0-170.5 69.5T240-552q0 71 59 162.5T480-186Z")
                            span= bizAddress
                            if _googleMapsUrl
                                a.bk-location-card__gmaps(href=_googleMapsUrl target="_blank" rel="noopener")
                                    | Ouvrir dans Maps
                                    svg(xmlns="http://www.w3.org/2000/svg" height="11px" viewBox="0 -960 960 960" width="11px" fill="currentColor")
                                        path(d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z")
                    if showMap
                        .bk-map-wrap.bk-location-card__map
                            iframe(src=_mapEmbedSrc style="border:0;width:100%;height:280px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade")

            //- ── Horaires ───────────────────────────────────────────────────
            if showHours
                .bk-hours-card
                    h2.bk-hours-card__title
                        svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                            path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-400 127 127-57 57-110-110v-214h80v140Z")
                        | Horaires d'ouverture
                    .bk-hours-grid
                        -
                            var dayNames = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi']
                            var sortedSched = [1,2,3,4,5,6,0].map(function(d){ return company.schedule.find(function(s){ return s.weekdayIndex === d; }); }).filter(Boolean)
                        each entry in sortedSched
                            .bk-hours-row(class=entry.dayOff ? 'bk-hours-row--off' : '')
                                span.bk-hours-row__day= dayNames[entry.weekdayIndex]
                                span.bk-hours-row__val
                                    if entry.dayOff
                                        | Fermé
                                    else if entry.workingHours && entry.workingHours.length
                                        = entry.workingHours.map(function(h){ return h.start + ' - ' + h.end; }).join(' · ')
                                    else
                                        | Fermé

            //- ── À propos ───────────────────────────────────────────────────
            if coach && coach.description && cs.showSectionAbout !== false
                .bk-about-card
                    h2.bk-about-card__title
                        svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                            path(d="M440-280h80v-240h-80v240Zm40-320q17 0 28.5-11.5T520-640q0-17-11.5-28.5T480-680q-17 0-28.5 11.5T440-640q0 17 11.5 28.5T480-600Zm0 520q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                        | À propos
                    p.bk-about-card__text#bkAboutText= coach.description
                    if coach.description.length > 220
                        button.bk-about-card__toggle#bkAboutToggle(type="button")
                            span Voir plus
                            svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                path(d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z")

    //- ── Sticky cart (JS-rendered) ──────────────────────────────────────────
    #bkCart

    //- ── Avis ───────────────────────────────────────────────────────────────
    section.bk-reviews
        .bk-inner
            .bk-reviews__header
                h2.bk-reviews__title
                    svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                        path(d="m233-120 65-281L80-580l288-25 112-265 112 265 288 25-218 179 65 281-247-149-247 149Z")
                    | Avis clients
                if reviewCount > 0
                    .bk-reviews__score
                        .bk-stars.bk-stars--display
                            - for (var si = 1; si <= 5; si++)
                                svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" class=(si <= Math.round(avgRating) ? 'filled' : ''))
                                    path(d="m233-120 65-281L80-580l288-25 112-265 112 265 288 25-218 179 65 281-247-149-247 149Z")
                        span.bk-reviews__avg= avgRating.toFixed(1)
                        span.bk-reviews__count (#{reviewCount} avis)

            //- ── Formulaire (client connecté + pas encore posté) ────────────
            if clientSession && !hasReviewed
                .bk-review-form#bkReviewForm
                    .bk-review-form__header
                        img.bk-review-form__avatar(src=clientSession.profilePicture alt=clientSession.fullName)
                        span.bk-review-form__name= clientSession.fullName
                    .bk-stars.bk-stars--input#bkStarInput
                        - for (var i = 1; i <= 5; i++)
                            svg(xmlns="http://www.w3.org/2000/svg" height="28px" viewBox="0 -960 960 960" width="28px" data-value=i)
                                path(d="m233-120 65-281L80-580l288-25 112-265 112 265 288 25-218 179 65 281-247-149-247 149Z")
                    input(type="hidden" id="bkRatingVal" value="0")
                    textarea.bk-review-form__text#bkReviewComment(placeholder="Partagez votre expérience (optionnel)" rows="3" maxlength="800")
                    .bk-review-form__actions
                        button.bk-review-form__submit#bkReviewSubmit(type="button") Publier l'avis
                        span.bk-review-form__status#bkReviewStatus
            else if !clientSession
                .bk-review-login
                    svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                        path(d="m233-120 65-281L80-580l288-25 112-265 112 265 288 25-218 179 65 281-247-149-247 149Z")
                    span Pour laisser un avis,&nbsp;
                    a.bk-review-login__link(href="/client/login") connectez-vous à votre compte client
            else if hasReviewed
                p.bk-review-done
                    svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                        path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm-56-240 226-226-57-57-169 169-85-85-57 57 142 142Z")
                    | Vous avez déjà publié un avis pour cet établissement.

            //- ── Liste des avis ─────────────────────────────────────────────
            if reviews && reviews.length > 0
                .bk-review-list#bkReviewList
                    each review in reviews
                        .bk-review-card(data-id=String(review._id))
                            .bk-review-card__top
                                img.bk-review-card__avatar(src=review.clientPicture alt=review.clientName)
                                .bk-review-card__meta
                                    span.bk-review-card__name= review.clientName
                                    .bk-stars.bk-stars--display.bk-stars--sm
                                        - for (var rs = 1; rs <= 5; rs++)
                                            svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" class=(rs <= review.rating ? 'filled' : ''))
                                                path(d="m233-120 65-281L80-580l288-25 112-265 112 265 288 25-218 179 65 281-247-149-247 149Z")
                                .bk-review-card__date= new Date(review.createdAt).toLocaleDateString('fr-FR', {day:'2-digit', month:'short', year:'numeric'})
                            if review.comment
                                p.bk-review-card__comment= review.comment
                            if clientSession && String(review.client) === clientSession._id
                                button.bk-review-delete(type="button" data-id=String(review._id)) Supprimer mon avis
            else
                p.bk-reviews__empty Aucun avis pour le moment. Soyez le premier à donner votre opinion !

    //- ── Galerie (section séparée) ──────────────────────────────────────────
    -
        var showGallery = cs.showSectionGallery === true && gallery && gallery.length > 0

    if showGallery
        section.bk-info
            .bk-inner

                if showGallery
                    .bk-info-section
                        h2.bk-info-section__title
                            svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                path(d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Zm0-80h560v-560H200v560Zm40-80h480L570-480 450-320l-90-120-120 160Zm-40 80v-560 560Z")
                            | Galerie
                        .bk-gallery-grid
                            each photo in gallery
                                .bk-gallery-item
                                    img(src=photo alt="Photo de l'établissement" loading="lazy")


block scripts
    -
        var _companyInfo = {
            address:     (coach && coach.location && coach.location.address)     ? coach.location.address     : '',
            city:        (coach && coach.location && coach.location.city)        ? coach.location.city        : '',
            serviceType: (coach && coach.location && coach.location.serviceType) ? coach.location.serviceType : 'sur_place'
        }
    script.
        window.__services       = !{servicesJson  || '[]'};
        window.__employees      = !{employeesJson || '[]'};
        window.__companyInfo    = !{JSON.stringify(_companyInfo)};
        window.__categoriesMeta = !{JSON.stringify(cs.categories || [])};
    if clientUser
        script.
            window.__clientUser = !{JSON.stringify(clientUser)};
    script(src="/js/layouts/index.js" type="module")
    script.
        // ── About "Voir plus / Voir moins" ────────────────────────────────────
        (function() {
            var toggle = document.getElementById('bkAboutToggle');
            var text   = document.getElementById('bkAboutText');
            if (!toggle || !text) return;
            var full    = text.textContent;
            var SHORT   = 220;
            var open    = false;
            text.textContent = full.slice(0, SHORT) + '…';
            text.classList.add('bk-about-card__text--short');
            toggle.addEventListener('click', function() {
                open = !open;
                text.textContent = open ? full : full.slice(0, SHORT) + '…';
                text.classList.toggle('bk-about-card__text--short', !open);
                toggle.querySelector('span').textContent = open ? 'Voir moins' : 'Voir plus';
                toggle.querySelector('svg').style.transform = open ? 'rotate(180deg)' : '';
            });
        })();
    script.
        document.querySelectorAll('.bk-pill--copy').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var val = btn.dataset.copy;
                if (!val) return;
                navigator.clipboard.writeText(val).then(function() {
                    var orig = btn.textContent;
                    btn.textContent = 'Copié !';
                    btn.style.background = 'var(--bk-accent-soft)';
                    btn.style.borderColor = 'var(--bk-accent-border)';
                    btn.style.color = 'var(--bk-accent-ink)';
                    setTimeout(function() {
                        btn.textContent = orig;
                        btn.style.background = '';
                        btn.style.borderColor = '';
                        btn.style.color = '';
                    }, 1500);
                });
            });
        });
    script.
        // ── Système d'avis ────────────────────────────────────────────────────
        (function() {
            var COMPANY_ID = '!{company._id}';

            // ── Étoiles interactives ─────────────────────────────────────────
            var starInput  = document.getElementById('bkStarInput');
            var ratingVal  = document.getElementById('bkRatingVal');
            if (starInput) {
                var stars = starInput.querySelectorAll('svg');
                function paintStars(n) {
                    stars.forEach(function(s, i) { s.classList.toggle('filled', i < n); });
                }
                stars.forEach(function(star, idx) {
                    star.addEventListener('mouseenter', function() { paintStars(idx + 1); });
                    star.addEventListener('mouseleave', function() { paintStars(Number(ratingVal.value)); });
                    star.addEventListener('click', function() {
                        ratingVal.value = idx + 1;
                        paintStars(idx + 1);
                    });
                });
            }

            // ── Soumettre l'avis ─────────────────────────────────────────────
            var submitBtn  = document.getElementById('bkReviewSubmit');
            var statusEl   = document.getElementById('bkReviewStatus');
            var commentEl  = document.getElementById('bkReviewComment');
            if (submitBtn) {
                submitBtn.addEventListener('click', async function() {
                    var rating = Number(ratingVal ? ratingVal.value : 0);
                    if (!rating) { if(statusEl){ statusEl.textContent = 'Choisissez une note.'; statusEl.style.color='#b45309'; } return; }
                    submitBtn.disabled = true;
                    submitBtn.textContent = '...';
                    if (statusEl) statusEl.textContent = '';
                    try {
                        var res  = await fetch('/reviews/' + COMPANY_ID, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ rating: rating, comment: commentEl ? commentEl.value : '' })
                        });
                        var data = await res.json();
                        if (data.success) {
                            window.location.reload();
                        } else {
                            if (statusEl) { statusEl.textContent = data.error || 'Erreur.'; statusEl.style.color = '#b91c1c'; }
                            submitBtn.disabled = false;
                            submitBtn.textContent = "Publier l'avis";
                        }
                    } catch(e) {
                        if (statusEl) { statusEl.textContent = 'Erreur réseau.'; statusEl.style.color = '#b91c1c'; }
                        submitBtn.disabled = false;
                        submitBtn.textContent = "Publier l'avis";
                    }
                });
            }

            // ── Supprimer son avis ───────────────────────────────────────────
            document.querySelectorAll('.bk-review-delete').forEach(function(btn) {
                btn.addEventListener('click', async function() {
                    if (!confirm('Supprimer votre avis ?')) return;
                    var id = btn.dataset.id;
                    btn.disabled = true;
                    try {
                        var res = await fetch('/reviews/' + COMPANY_ID + '/' + id, { method: 'DELETE' });
                        var data = await res.json();
                        if (data.success) {
                            var card = btn.closest('.bk-review-card');
                            if (card) card.remove();
                            window.location.reload();
                        } else {
                            alert(data.error || 'Erreur.');
                            btn.disabled = false;
                        }
                    } catch(e) { btn.disabled = false; }
                });
            });
        })();
