-
    //- Nom de l'ÉTABLISSEMENT d'abord (repli compte pour les fiches historiques)
    var _bizName = (company && company.name) || (coach && (coach.businessName || coach.fullName)) || 'BranShee'
    var _bizSlug = company ? (company.slug || String(company._id)) : null

doctype html
html(lang="fr")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Rendez-vous annulé — BranShee
        link(rel="stylesheet" href="/css/layouts/client-booking.css")
        style.
            body { margin:0; background:#f8fafc; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; }
            .cancel-wrap { min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:32px 16px; }
            .cancel-card { background:#fff; border:1px solid #e5e7eb; border-radius:18px; padding:40px 36px; max-width:440px; width:100%; text-align:center; box-shadow:0 4px 24px rgba(0,0,0,.07); }
            .cancel-logo { display:inline-flex; align-items:center; gap:8px; text-decoration:none; margin-bottom:32px; }
            .cancel-logo__mark { width:34px; height:34px; border-radius:9px; }
            .cancel-logo__name { font-size:15px; font-weight:700; color:#1e2923; }
            .cancel-icon { width:60px; height:60px; background:#fef2f2; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 20px; }
            .cancel-icon svg { stroke:#ef4444; }
            .cancel-title { font-size:20px; font-weight:700; color:#111827; margin:0 0 10px; }
            .cancel-sub { font-size:14px; color:#6b7280; line-height:1.6; margin:0 0 24px; }
            .cancel-refund { display:flex; align-items:center; gap:8px; background:var(--success-pale); border:1px solid var(--bs-green-border); border-radius:10px; padding:12px 16px; font-size:13px; font-weight:600; color:var(--accent); margin-bottom:24px; text-align:left; }
            .cancel-refund svg { stroke:var(--accent); flex-shrink:0; }
            .cancel-back { display:inline-block; background:#f3f4f6; color:#374151; padding:11px 24px; border-radius:9px; text-decoration:none; font-size:14px; font-weight:600; border:1px solid #e5e7eb; transition:background .15s; }
            .cancel-back:hover { background:#e5e7eb; }

    body
        .cancel-wrap
            a.cancel-logo(href="/")
                img.cancel-logo__mark(src="/images/icon.svg" alt="" width="34" height="34")
                span.cancel-logo__name BranShee

            .cancel-card
                .cancel-icon
                    svg(viewBox="0 0 24 24" width="28" height="28" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                        circle(cx="12" cy="12" r="10")
                        line(x1="15" y1="9" x2="9" y2="15")
                        line(x1="9" y1="9" x2="15" y2="15")

                h1.cancel-title Rendez-vous annulé

                p.cancel-sub
                    | Votre rendez-vous chez&nbsp;
                    strong= _bizName
                    | &nbsp;a bien été annulé.
                    br
                    | Vous recevrez une confirmation par email.

                if chargeResult && chargeResult.refunded
                    .cancel-refund
                        svg(viewBox="0 0 24 24" width="16" height="16" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            polyline(points="20 6 9 17 4 12")
                        if chargeResult.pct === 100
                            span Remboursement complet de #{chargeResult.amount} € initié.
                        else
                            span Remboursement de #{chargeResult.amount} € initié (#{chargeResult.pct}% remboursé).

                if chargeResult && chargeResult.charged
                    .cancel-refund(style="background:#fef2f2; border-color:#fecaca; color:#b91c1c;")
                        svg(viewBox="0 0 24 24" width="16" height="16" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke:#b91c1c;")
                            circle(cx="12" cy="12" r="10")
                            line(x1="12" y1="8" x2="12" y2="12")
                            line(x1="12" y1="16" x2="12.01" y2="16")
                        if chargeResult.pct === 100
                            span Des frais d'annulation de #{chargeResult.amount} € (100%) ont été prélevés sur votre carte.
                        else
                            span Des frais d'annulation de #{chargeResult.amount} € (#{chargeResult.pct}%) ont été prélevés sur votre carte.

                if chargeResult && chargeResult.charged === false && chargeResult.error
                    .cancel-refund(style="background:#fef2f2; border-color:#fecaca; color:#b91c1c;")
                        svg(viewBox="0 0 24 24" width="16" height="16" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke:#b91c1c;")
                            circle(cx="12" cy="12" r="10")
                            line(x1="12" y1="8" x2="12" y2="12")
                            line(x1="12" y1="16" x2="12.01" y2="16")
                        span Le prélèvement des frais d'annulation a échoué. L'établissement pourra vous contacter.

                if chargeResult && chargeResult.charged === false && !chargeResult.error
                    .cancel-refund
                        svg(viewBox="0 0 24 24" width="16" height="16" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            polyline(points="20 6 9 17 4 12")
                        span Aucun frais ne vous sera prélevé.

                if _bizSlug
                    a.cancel-back(href=`/${_bizSlug}`) ← Reprendre un rendez-vous
                else
                    a.cancel-back(href="/") ← Accueil
