extends ../../layouts/index

//- Homepage pro — page de conversion (trafic Ads + SEO).
//- Tout le contenu vit dans t.pro_landing (locales/*.json) ; les prix affichés
//- dans la copy (19 €, 15 €/39 € annuel) doivent rester synchronisés avec
//- t.subscription si les tarifs changent un jour.

//- "append" (et non "block jsonld") : on garde les schémas WebSite +
//- Organization du layout — la home est LA page où ils comptent pour Google.
block append jsonld
    -
        //- .replace(< → <) : si une traduction contient un jour "</script>",
        //- le JSON-LD inline casserait silencieusement tout le HTML de la home.
        var _ldSafe = function (obj) { return JSON.stringify(obj).replace(/</g, "\\u003c"); };
        var _pageLd = {
            "@context": "https://schema.org",
            "@type": "WebPage",
            "name": t.pro_landing.meta_title || "BranShee",
            "url": canonical || "https://www.branshee.com/",
            "description": t.pro_landing.meta_desc || "",
            "inLanguage": lang || "fr",
            "isPartOf": { "@type": "WebSite", "name": "BranShee", "url": "https://www.branshee.com" }
        };
        var _faqLd = {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": (t.pro_landing.faq.items || []).map(function (it) {
                return { "@type": "Question", "name": it.q, "acceptedAnswer": { "@type": "Answer", "text": it.a } };
            })
        };
        var _appLd = {
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "BranShee",
            "applicationCategory": "BusinessApplication",
            "operatingSystem": "Web",
            "url": "https://www.branshee.com",
            "description": t.pro_landing.meta_desc || "",
            "inLanguage": lang || "fr",
            "featureList": (t.pro_landing.included.items || []).map(function (it) { return it.title; }),
            "offers": {
                "@type": "AggregateOffer",
                "lowPrice": "0",
                "highPrice": "49",
                "priceCurrency": "EUR",
                "offerCount": "3"
            }
        };
    script(type="application/ld+json")!= _ldSafe(_pageLd)
    script(type="application/ld+json")!= _ldSafe(_faqLd)
    script(type="application/ld+json")!= _ldSafe(_appLd)

block links
    link(rel="stylesheet", href="/css/layouts/landing-page.css")

block content
    - var pl = t.pro_landing

    .pro-lp

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 1. HERO — prix dans le titre, zéro friction
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-hero
            .container
                .pro-hero__inner

                    .pro-hero__left
                        .pro-badge
                            span.pro-badge__dot
                            = pl.hero.badge
                        h1.pro-h1
                            = pl.hero.title_1
                            br
                            em= pl.hero.title_2
                        p.pro-sub= pl.hero.sub
                        .pro-actions
                            a.sm-btn.sm-btn--primary(href="/register")= pl.hero.cta_free
                            a.sm-btn.sm-btn--ghost(href="/register?plan=pro&billing=monthly")= pl.hero.cta_pro
                        p.pro-hero__card-note= pl.hero.card_note
                        .pro-pricing-note
                            span= pl.hero.price_anchor_pre + ' '
                            strong= pl.hero.price_anchor_strong
                            span= ' ' + pl.hero.price_anchor_post
                        .pro-micro
                            span
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                    path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                = pl.hero.check_1
                            span
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                    path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                = pl.hero.check_2
                            span
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                    path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                = pl.hero.check_3

                        if t.landing && t.landing.cats
                            .lp__cats
                                each cat in t.landing.cats
                                    if cat.key !== 'all'
                                        span.lp__cat= cat.label

                        a.pro-hero__alt-link(href="/search")
                            svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="13" height="13")
                                path(d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Zm0 0v-80 80Z")
                            = pl.hero.alt_link

                    //- Mockup calendrier (UI démo, non traduit sauf pastilles)
                    .pro-hero__right
                        .pro-mock
                            .pro-mock__price-pill= pl.hero.mock_pill
                            .pro-mock__bar
                                span.dot-r
                                span.dot-y
                                span.dot-g
                            .pro-mock__grid
                                .pro-mock__head-cell GMT
                                .pro-mock__head-cell Lun 17
                                .pro-mock__head-cell Mar 18
                                .pro-mock__head-cell.today Mer 19
                                .pro-mock__head-cell Jeu 20
                                .pro-mock__head-cell Ven 21
                                .pro-mock__time 09:00
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--soft Sara M.
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__time 10:00
                                .pro-mock__slot
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--amber Pierre L.
                                .pro-mock__slot.today-col
                                    .pro-mock__event.pro-mock__event--solid Sara M.
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__time 11:00
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                    .pro-mock__event.pro-mock__event--solid Benjamin
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--soft Camille
                                .pro-mock__slot
                                .pro-mock__time 12:00
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                .pro-mock__slot
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--solid Joachim
                                .pro-mock__time 13:00
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                    .pro-mock__event.pro-mock__event--solid Léa P.
                                .pro-mock__slot
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--blue Iris V.

                            .pro-mock__toast
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="12" height="12")
                                    path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                span= pl.hero.mock_toast

                            .pro-mock__notif
                                .pro-mock__notif-head
                                    .pro-mock__notif-av BG
                                    div
                                        .pro-mock__notif-title
                                            if lang === 'en'
                                                | New booking
                                            else if lang === 'de'
                                                | Neue Buchung
                                            else if lang === 'es'
                                                | Nueva reserva
                                            else if lang === 'it'
                                                | Nuova prenotazione
                                            else if lang === 'nl'
                                                | Nieuwe boeking
                                            else
                                                | Nouveau rendez-vous
                                        .pro-mock__notif-time
                                            if lang === 'en'
                                                | 2 min ago
                                            else if lang === 'de'
                                                | Vor 2 Min.
                                            else if lang === 'es'
                                                | Hace 2 min
                                            else if lang === 'it'
                                                | 2 min fa
                                            else if lang === 'nl'
                                                | 2 min geleden
                                            else
                                                | Il y a 2 min
                                .pro-mock__notif-body
                                    strong Benjamin G.
                                    //- Un "|" vide ne produit AUCUN espace en Pug
                                    = " "
                                    if lang === 'en'
                                        | booked Color refresh
                                    else if lang === 'de'
                                        | hat Farbauffrischung gebucht
                                    else if lang === 'es'
                                        | reservó Retoque de color
                                    else if lang === 'it'
                                        | ha prenotato Ritocco colore
                                    else if lang === 'nl'
                                        | boekte Kleurbehandeling
                                    else
                                        | a réservé Soin colorant
                                .pro-mock__notif-pills
                                    //- Cohérent avec la grille : Benjamin est le mercredi 19 à 11:00
                                    .pro-mock__pill Mer 19 · 11:00
                                    .pro-mock__pill.pro-mock__pill--green 90 €

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 2. COMPARAISON — « Faites le calcul »
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-compare
            .container
                h2.pro-h2.pro-compare__title= pl.compare.title
                .pro-compare__grid
                    each card, ci in pl.compare.cards
                        .pro-compare-card(class=ci === 2 ? 'pro-compare-card--win' : '')
                            h3.pro-compare-card__name= card.name
                            .pro-compare-card__price= card.price
                            p.pro-compare-card__desc= card.desc
                p.pro-compare__conclusion= pl.compare.conclusion
                .pro-compare__actions
                    a.pro-compare__link(href="#tarifs")= pl.compare.cta

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 3. STATS — 4 chiffres honnêtes (produit, pas clients)
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-stats
            .container
                .pro-stats__grid
                    each stat in pl.stats
                        .pro-stat
                            .pro-stat__n= stat.n
                            .pro-stat__l= stat.l
                            .pro-stat__s= stat.s

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 4. LA PILE D'OUTILS REMPLACÉE
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-stack
            .container
                .pro-sec-hd
                    h2.pro-h2
                        = pl.stack.title
                        br
                        em= pl.stack.title_em
                    p.pro-desc= pl.stack.intro
                .pro-stack__grid
                    each item in pl.stack.items
                        .pro-stack-card
                            .pro-stack-card__old= item.old
                            p.pro-stack-card__new= item.now
                .pro-stack__final
                    img.pro-stack__final-mark(src="/images/icon.svg" alt="" width="40" height="40")
                    .pro-stack__final-body
                        .pro-stack__final-name BranShee
                        p.pro-stack__final-desc= pl.stack.final_desc
                    a.sm-btn.sm-btn--soft(href="/register")= pl.stack.cta

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 5. FONCTIONNALITÉS — 3 rangées alternées
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-funcs
            .container
                .pro-sec-hd
                    .pro-pill= pl.funcs_hd.pill
                    h2.pro-h2
                        = pl.funcs_hd.title + ' '
                        em= pl.funcs_hd.title_em
                each row, index in pl.funcs
                    .pro-func(class=index % 2 !== 0 ? 'pro-func--flip' : '')
                        .pro-func__text
                            .pro-func__tag= row.tag
                            h3.pro-func__title= row.title
                            p.pro-func__desc= row.desc
                            ul.pro-func__bullets
                                each item in row.items
                                    li= item
                            if row.roi
                                .pro-func__roi
                                    svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="16" height="16")
                                        path(d="m233-120 65-281L80-590l288-25 112-265 112 265 288 25-218 189 65 281-247-149-247 149Z")
                                    span= row.roi
                            .pro-func__actions
                                a.sm-btn.sm-btn--primary(href=row.cta_href)= row.cta
                        .pro-func__visual
                            img.pro-func__img(src=row.image alt=row.title loading="lazy" width="560" height="420")

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 6. TOUT EST INCLUS — grille de 12
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-features.pro-features--included
            .container
                .pro-sec-hd
                    .pro-pill= pl.included.pill
                    h2.pro-h2
                        = pl.included.title + ' '
                        em= pl.included.title_em
                    p.pro-desc= pl.included.intro
                -
