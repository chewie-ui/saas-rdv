                        .pro-honest__log-title
                            svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="16" height="16")
                                path(d="m422-232 207-248H469l29-227-185 267h139l-30 208ZM320-80l40-280H160l360-520h80l-40 320h240L400-80h-80Zm151-390Z")
                            = pl.honest.changelog_title
                        each entry in pl.honest.changelog
                            .pro-honest__entry
                                .pro-honest__entry-dot
                                .pro-honest__entry-body
                                    .pro-honest__entry-head
                                        strong= entry.title
                                        if entry.badge
                                            span.pro-honest__badge= entry.badge
                                    p= entry.desc
                .pro-honest__guarantees
                    each g in pl.honest.guarantees
                        .pro-honest__g
                            svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="18" height="18")
                                path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                            div
                                .pro-honest__g-title= g.title
                                p.pro-honest__g-desc= g.desc

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 9. TARIFS — 3 plans réels (#tarifs)
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-pricing#tarifs
            .container
                .pro-sec-hd
                    .pro-pill= pl.pricing.pill
                    h2.pro-h2= pl.pricing.title
                    p.pro-desc= pl.pricing.desc

                .pro-plans
                    .pro-plan
                        h3.pro-plan__name= t.subscription.plan_1
                        p.pro-plan__desc= pl.pricing.plan_1_tagline
                        .pro-plan__price
                            span.pro-plan__price-n= t.subscription.price_1
                        .pro-plan__price-hint= pl.pricing.plan_1_price_sub
                        ul.pro-plan__features
                            each feature in pl.pricing.plan_1_features
                                li
                                    svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                        path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                    span= feature
                        a.sm-btn.sm-btn--soft.pro-plan__cta(href="/register")= pl.pricing.plan_1_cta
                        p.pro-plan__note= pl.pricing.plan_1_note

                    .pro-plan.pro-plan--featured
                        .pro-plan__badge= pl.pricing.popular
                        h3.pro-plan__name= t.subscription.plan_2
                        p.pro-plan__desc= pl.pricing.plan_2_tagline
                        .pro-plan__price
                            span.pro-plan__price-n= t.subscription.price_2
                            span.pro-plan__price-s= t.subscription.price_2_sub
                        .pro-plan__price-hint= pl.pricing.plan_2_price_hint
                        ul.pro-plan__features
                            each feature in pl.pricing.plan_2_features
                                li
                                    svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                        path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                    span= feature
                        a.sm-btn.sm-btn--primary.pro-plan__cta(href="/register?plan=pro&billing=monthly")= pl.pricing.plan_2_cta
                        p.pro-plan__note= pl.pricing.plan_2_note

                    .pro-plan
                        h3.pro-plan__name= t.subscription.plan_3
                        p.pro-plan__desc= pl.pricing.plan_3_tagline
                        .pro-plan__price
                            span.pro-plan__price-n= t.subscription.price_3
                            span.pro-plan__price-s= t.subscription.price_3_sub
                        .pro-plan__price-hint= pl.pricing.plan_3_price_hint
                        ul.pro-plan__features
                            each feature in pl.pricing.plan_3_features
                                li
                                    svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                        path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                    span= feature
                        a.sm-btn.sm-btn--soft.pro-plan__cta(href="/register?plan=business&billing=monthly")= pl.pricing.plan_3_cta

                p.pro-pricing__note
                    svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                        path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm0-80h480v-400H240v400Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80Z")
                    = pl.pricing.note

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 10. MÉTIERS — longue traîne SEO
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-jobs
            .container
                .pro-sec-hd
                    .pro-pill= pl.jobs.pill
                    h2.pro-h2
                        = pl.jobs.title + ' '
                        em= pl.jobs.title_em
                .pro-jobs__grid
                    each job in pl.jobs.items
                        .pro-job
                            h3.pro-job__name= job.name
                            p.pro-job__desc= job.desc
                p.pro-jobs__closing= pl.jobs.closing
                .pro-jobs__actions
                    a.sm-btn.sm-btn--primary(href="/register")= pl.jobs.cta

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 11. FAQ — 10 questions anti-objections
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-faq.faq.padding-d
            .container
                .faq__container
                    .faq__title
                        h2= pl.faq.title
                        p= pl.faq.sub
                    .faq__body
                        each item, idx in pl.faq.items
                            .faq__question(class=idx === 0 ? 'open' : '')
                                .faq__answer-container
                                    .faq__answer= item.q
                                    .faq__icon.flex-c
                                        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24")
                                            path(d="M0 0h24v24H0V0z" fill="none")
                                            path(d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6-6-6z")
                                .faq__response= item.a

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 12. CTA FINAL — renversement du risque
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-cta
            .container
                .pro-cta__brand
                    img.pro-cta__mark(src="/images/icon.svg" alt="" width="32" height="32")
                    .pro-cta__name BranShee
                h2.pro-cta__h2
                    = pl.cta.title
                    br
                    span= pl.cta.title_em
                p.pro-cta__sub= pl.cta.desc
                .pro-cta__actions
                    a.sm-btn.sm-btn--primary(href="/register")= pl.cta.btn_1
                    a.sm-btn.sm-btn--ghost(href="/register?plan=pro&billing=monthly")= pl.cta.btn_2
                a.pro-cta__contact(href="/contact")= pl.cta.contact

block scripts
    script(src="/js/layouts/landing-page.js" type="module")
    script(src="/js/layouts/client/landing-page.js" type="module")
