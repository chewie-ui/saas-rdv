        //- 7. COMMENT ÇA MARCHE — 3 étapes
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-hiw#hiw
            .container
                .pro-sec-hd
                    .pro-pill= pl.hiw.pill
                    h2.pro-h2
                        //- " + ' '" garantit l'espace entre les deux segments
                        //- (un "|" vide ne produit pas d'espace en Pug).
                        = pl.hiw.title + ' '
                        em= pl.hiw.title_em
                .pro-hiw__steps
                    each step, idx in pl.hiw.steps
                        .pro-step
                            .pro-step__n= idx + 1
                            h3.pro-step__title= step.title
                            p.pro-step__desc= step.desc
                .pro-hiw__cta
                    a.sm-btn.sm-btn--primary(href="/register")= pl.hiw.cta
                    p.pro-hiw__cta-note= pl.hiw.note

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
