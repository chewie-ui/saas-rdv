extends ../../layouts/index

//- ══════════════════════════════════════════════════════════════════════════
//-  PAGE D'ACCUEIL — page de conversion (trafic Ads + SEO)
//-  ─────────────────────────────────────────────────────────────────────────
//-  Design repris de la maquette « Pour les pros » : titre-promesse, visuel
//-  produit à droite, comparatif avant/après, métiers visés, mise en route en
//-  trois étapes, tarifs, questions fréquentes.
//-
//-  TOUT le texte vient de `t.pro_landing` (locales/*.json, 6 langues). Ne rien
//-  écrire en dur ici : la page est servie en FR/EN/NL/ES/IT/DE, et une chaîne
//-  française codée en clair ne se verrait qu'à la lecture des cinq autres.
//-
//-  Les prix affichés proviennent de utils/tarifs.js (`_tarifs`), même source
//-  que la page des formules et que le calcul du revenu récurrent — un montant
//-  ne peut donc pas diverger entre la vitrine et la facturation.
//- ══════════════════════════════════════════════════════════════════════════

//- "append" (et non "block jsonld") : on garde les schémas WebSite +
//- Organization du layout — la home est LA page où ils comptent pour Google.
block append jsonld
    -
        //- .replace(< → <) : si une traduction contient un jour "</script>",
        //- le JSON-LD inline casserait silencieusement tout le HTML de la home.
        var _ldSafe = function (obj) { return JSON.stringify(obj).replace(/</g, "\\u003c"); };
        var _pageLd = {
            "@context": "https://schema.org",
            "@type": "WebPage",
            "name": t.pro_landing.meta_title || "BranShee",
            "url": canonical || "https://www.branshee.com/",
            "description": t.pro_landing.meta_desc || "",
            "inLanguage": lang || "fr",
            "isPartOf": { "@type": "WebSite", "name": "BranShee", "url": "https://www.branshee.com" }
        };
        var _faqLd = {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": (t.pro_landing.faq.items || []).map(function (it) {
                return { "@type": "Question", "name": it.q, "acceptedAnswer": { "@type": "Answer", "text": it.a } };
            })
        };
        var _appLd = {
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "BranShee",
            "applicationCategory": "BusinessApplication",
            "operatingSystem": "Web",
            "url": "https://www.branshee.com",
            "description": t.pro_landing.meta_desc || "",
            "inLanguage": lang || "fr",
            "featureList": (t.pro_landing.included.items || []).map(function (it) { return it.title; }),
            "offers": {
                "@type": "AggregateOffer",
                "lowPrice": "0",
                "highPrice": String((_tarifs && _tarifs.business && _tarifs.business.mensuel) || 49),
                "priceCurrency": "EUR",
                "offerCount": "3"
            }
        };
    script(type="application/ld+json")!= _ldSafe(_pageLd)
    script(type="application/ld+json")!= _ldSafe(_faqLd)
    script(type="application/ld+json")!= _ldSafe(_appLd)

block links
    //- Material Symbols n'est PAS chargée par layouts/index.pug. Les coches du
    //- comparatif et les chevrons de la FAQ en dépendent : sans cette ligne,
    //- les ligatures s'affichent en toutes lettres (« check », « close »).
    //- `display=block` évite ce même texte brut pendant le chargement.
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block")
    //- landing-page.css reste chargée : elle porte le visuel du planning
    //- (.pro-mock*) réutilisé tel quel dans le hero. home.css apporte les
    //- nouvelles sections, toutes préfixées `hp-` — aucun sélecteur commun,
    //- donc aucune collision de cascade entre les deux feuilles.
    link(rel="stylesheet", href="/css/layouts/landing-page.css")
    link(rel="stylesheet", href="/css/layouts/client/home.css")

block content
    - var pl = t.pro_landing

    .hp

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 1. HERO — la promesse, puis la preuve à droite
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.hp-hero
            .container
                .hp-hero__inner

                    .hp-hero__left
                        p.hp-eyebrow= pl.hero.badge

                        //- Le point final passe en vert. On ne remplace que le
                        //- « . » de fin : si une traduction n'en a pas, rien ne
                        //- change et le titre reste intact.
                        h1.hp-h1!= pl.hero.title_1.replace(/\.\s*$/, '<span class="hp-h1__dot">.</span>')
                        p.hp-sub= pl.hero.sub

                        .hp-cta
                            a.hp-btn.hp-btn--primary(href="/register?intent=pro")= pl.hero.cta_free
                            //- Le second bouton s'adresse à l'autre moitié du
                            //- trafic : celui qui cherche un pro, pas à en
                            //- devenir un. Il part vers la recherche.
                            a.hp-btn.hp-btn--ghost(href="/search")= pl.hero.cta_pro

                        p.hp-trust
                            span= pl.hero.check_1
                            span.hp-trust__sep ·
                            span= pl.hero.check_2
                            span.hp-trust__sep ·
                            span= pl.hero.check_3
                    .pro-hero__right
                        .pro-mock
                            a.pro-mock__price-pill(href="/register?intent=pro")= pl.hero.mock_pill
                            .pro-mock__bar
                                span.dot-r
                                span.dot-y
                                span.dot-g
                            .pro-mock__grid
                                .pro-mock__head-cell GMT
                                .pro-mock__head-cell Lun 17
                                .pro-mock__head-cell Mar 18
                                .pro-mock__head-cell.today Mer 19
                                .pro-mock__head-cell Jeu 20
                                .pro-mock__head-cell Ven 21
                                .pro-mock__time 09:00
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--soft Sara M.
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__time 10:00
                                .pro-mock__slot
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--amber Pierre L.
                                .pro-mock__slot.today-col
                                    .pro-mock__event.pro-mock__event--solid Sara M.
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__time 11:00
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                    .pro-mock__event.pro-mock__event--solid Benjamin
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--soft Camille
                                .pro-mock__slot
                                .pro-mock__time 12:00
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                .pro-mock__slot
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--solid Joachim
                                .pro-mock__time 13:00
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                    .pro-mock__event.pro-mock__event--solid Léa P.
                                .pro-mock__slot
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--blue Iris V.

                            .pro-mock__toast
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="12" height="12")
                                    path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                span= pl.hero.mock_toast

                            .pro-mock__notif
                                .pro-mock__notif-head
                                    .pro-mock__notif-av BG
                                    div
                                        .pro-mock__notif-title
                                            if lang === 'en'
                                                | New booking
                                            else if lang === 'de'
                                                | Neue Buchung
                                            else if lang === 'es'
                                                | Nueva reserva
                                            else if lang === 'it'
                                                | Nuova prenotazione
                                            else if lang === 'nl'
                                                | Nieuwe boeking
                                            else
                                                | Nouveau rendez-vous
                                        .pro-mock__notif-time
                                            if lang === 'en'
                                                | 2 min ago
                                            else if lang === 'de'
                                                | Vor 2 Min.
                                            else if lang === 'es'
                                                | Hace 2 min
                                            else if lang === 'it'
                                                | 2 min fa
                                            else if lang === 'nl'
                                                | 2 min geleden
                                            else
                                                | Il y a 2 min
                                .pro-mock__notif-body
                                    strong Benjamin G.
                                    //- Un "|" vide ne produit AUCUN espace en Pug
                                    = " "
                                    if lang === 'en'
                                        | booked Color refresh
                                    else if lang === 'de'
                                        | hat Farbauffrischung gebucht
                                    else if lang === 'es'
                                        | reservó Retoque de color
                                    else if lang === 'it'
                                        | ha prenotato Ritocco colore
                                    else if lang === 'nl'
                                        | boekte Kleurbehandeling
                                    else
                                        | a réservé Soin colorant
                                .pro-mock__notif-pills
                                    //- Cohérent avec la grille : Benjamin est le mercredi 19 à 11:00
                                    .pro-mock__pill Mer 19 · 11:00
                                    .pro-mock__pill.pro-mock__pill--green 90 €
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 2. AVANT / AVEC — le problème puis sa réponse, côte à côte
        //-    C'est la section qui fait comprendre le produit en dix secondes :
        //-    on ne décrit pas des fonctions, on décrit une journée de travail.
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.hp-switch
            .container
                .hp-switch__grid
                    .hp-panel.hp-panel--before
                        span.hp-panel__pill= pl.switch.before_label
                        ul.hp-panel__list
                            each ligne in pl.switch.before
                                li
                                    span.material-symbols-outlined.hp-panel__ico close
                                    span= ligne
                    .hp-panel.hp-panel--after
                        span.hp-panel__pill= pl.switch.after_label
                        ul.hp-panel__list
                            each ligne in pl.switch.after
                                li
                                    span.material-symbols-outlined.hp-panel__ico check
                                    span= ligne

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 3. MÉTIERS — à qui ça s'adresse
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.hp-trades
            .container
                h2.hp-h2= pl.trades.title
                .hp-trades__grid
                    each metier in pl.trades.items
                        .hp-trade= metier

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 4. MISE EN ROUTE — trois étapes numérotées
        //-    La numérotation encode une vraie séquence : on ne peut pas
        //-    partager son lien avant d'avoir créé son compte.
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.hp-steps
            .container
                h2.hp-h2
                    = pl.hiw.title + ' '
                    span.hp-h2__em= pl.hiw.title_em
                .hp-steps__grid
                    each etape, i in pl.hiw.steps
                        .hp-step
                            span.hp-step__n= '0' + (i + 1)
                            h3.hp-step__t= etape.title
                            p.hp-step__d= etape.desc
                p.hp-steps__note= pl.hiw.note

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 5. CE QUI EST INCLUS
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.hp-incl
            .container
                h2.hp-h2
                    = pl.included.title + ' '
                    span.hp-h2__em= pl.included.title_em
                p.hp-lead= pl.included.intro
                .hp-incl__grid
                    each item in pl.included.items
                        .hp-incl__item
                            span.material-symbols-outlined.hp-incl__ico check
                            div
                                h3.hp-incl__t= item.title
                                if item.desc
                                    p.hp-incl__d= item.desc

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 6. TARIFS — résumé, le détail vit sur la page des formules
        //-    Prix lus dans utils/tarifs.js, jamais écrits en dur.
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.hp-pricing
            .container
                h2.hp-h2= pl.pricing.title
                p.hp-lead= pl.pricing.desc
                .hp-pricing__grid
                    each cle in ['basic', 'pro', 'business']
                        -
                            var f = _tarifs[cle];
                            var estPro = cle === 'pro';
                        .hp-plan(class=estPro ? 'hp-plan--reco' : '')
                            //- Nom et étiquette sur une même ligne, alignés aux
                            //- deux bords : c'est la disposition de la maquette.
                            //- L'étiquette était auparavant en `position:absolute`,
                            //- ce qui obligeait à réserver 84px de marge à droite
                            //- du nom — une valeur qui cassait dès qu'une langue
                            //- allongeait le libellé de la formule.
                            .hp-plan__head
                                h3.hp-plan__name= f.libelle
                                if estPro
                                    span.hp-plan__pill= pl.pricing.badge_popular || '★'
                            p.hp-plan__price
                                if f.mensuel === 0
                                    span.hp-plan__amount= pl.pricing.free_label || '0 €'
                                else
                                    span.hp-plan__amount #{f.mensuel} €
                                    span.hp-plan__per  / #{pl.pricing.per_month || 'mois'}
                            a.hp-btn.hp-btn--block(
                                href="/register?intent=pro"
                                class=estPro ? 'hp-btn--primary' : 'hp-btn--ghost'
                            )= pl.hero.cta_free

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 7. QUESTIONS FRÉQUENTES — mêmes entrées que le JSON-LD FAQPage
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.hp-faq
            .container
                h2.hp-h2= (pl.faq && pl.faq.title) || 'Questions fréquentes'
                .hp-faq__list
                    each item in (pl.faq.items || [])
                        details.hp-faq__item
                            summary.hp-faq__q
                                span= item.q
                                span.material-symbols-outlined.hp-faq__chev expand_more
                            p.hp-faq__a= item.a

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 8. DERNIER APPEL
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.hp-final
            .container
                .hp-final__box
                    h2.hp-final__t= pl.hiw.cta || pl.hero.cta_free
                    p.hp-final__s= pl.hero.sub
                    .hp-cta.hp-cta--center
                        a.hp-btn.hp-btn--light(href="/register?intent=pro")= pl.hero.cta_free
                        a.hp-btn.hp-btn--outline-light(href="/search")= pl.hero.cta_pro
                    p.hp-final__note= pl.hiw.note
