        //-    (remplace les témoignages : pas de faux avis, de la preuve)
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-honest
            .container
                .pro-sec-hd
                    .pro-pill= pl.honest.pill
                    h2.pro-h2
                        = pl.honest.title + ' '
                        em= pl.honest.title_em
                .pro-honest__cols
                    .pro-honest__letter
                        img.pro-honest__mark(src="/images/icon.svg" alt="" width="40" height="40")
                        p= pl.honest.letter_1
                        p= pl.honest.letter_2
                        .pro-honest__sign= pl.honest.letter_sign
