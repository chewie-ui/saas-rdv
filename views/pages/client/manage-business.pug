extends ../../layouts/index

//- Homepage pro — page de conversion (trafic Ads + SEO).
//- Tout le contenu vit dans t.pro_landing (locales/*.json) ; les prix affichés
//- dans la copy (19 €, 15 €/39 € annuel) doivent rester synchronisés avec
//- t.subscription si les tarifs changent un jour.

//- "append" (et non "block jsonld") : on garde les schémas WebSite +
//- Organization du layout — la home est LA page où ils comptent pour Google.
block append jsonld
    -
        //- .replace(< → <) : si une traduction contient un jour "</script>",
        //- le JSON-LD inline casserait silencieusement tout le HTML de la home.
        var _ldSafe = function (obj) { return JSON.stringify(obj).replace(/</g, "\\u003c"); };
        var _pageLd = {
            "@context": "https://schema.org",
            "@type": "WebPage",
            "name": t.pro_landing.meta_title || "BranShee",
            "url": canonical || "https://www.branshee.com/",
            "description": t.pro_landing.meta_desc || "",
            "inLanguage": lang || "fr",
            "isPartOf": { "@type": "WebSite", "name": "BranShee", "url": "https://www.branshee.com" }
        };
        var _faqLd = {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": (t.pro_landing.faq.items || []).map(function (it) {
                return { "@type": "Question", "name": it.q, "acceptedAnswer": { "@type": "Answer", "text": it.a } };
            })
        };
        var _appLd = {
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "BranShee",
            "applicationCategory": "BusinessApplication",
            "operatingSystem": "Web",
            "url": "https://www.branshee.com",
            "description": t.pro_landing.meta_desc || "",
            "inLanguage": lang || "fr",
            "featureList": (t.pro_landing.included.items || []).map(function (it) { return it.title; }),
            "offers": {
                "@type": "AggregateOffer",
                "lowPrice": "0",
                "highPrice": "49",
                "priceCurrency": "EUR",
                "offerCount": "3"
            }
        };
    script(type="application/ld+json")!= _ldSafe(_pageLd)
    script(type="application/ld+json")!= _ldSafe(_faqLd)
    script(type="application/ld+json")!= _ldSafe(_appLd)

block links
    link(rel="stylesheet", href="/css/layouts/landing-page.css")

block content
    - var pl = t.pro_landing

    .pro-lp

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 1. HERO — prix dans le titre, zéro friction
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-hero
            .container
                .pro-hero__inner

                    .pro-hero__left
                        //- Le point final passe en vert (accent) — même effet que
                        //- la maquette validée. Remplace uniquement le "." de fin ;
                        //- si la trad ne finit pas par un point, rien ne change.
                        h1.pro-h1!= pl.hero.title_1.replace(/\.\s*$/, '<span class="pro-h1__dot">.</span>')
                        p.pro-sub= pl.hero.sub
                        .pro-actions
                            a.sm-btn.sm-btn--primary(href="/register?intent=pro")= pl.hero.cta_free
                        .pro-micro
                            span
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                    path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                = pl.hero.check_1
                            span
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                    path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                = pl.hero.check_2
                            span
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                    path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                = pl.hero.check_3
                        a.pro-hero__findpro(href="/search")= pl.hero.findpro

                    //- Mockup calendrier (UI démo, non traduit sauf pastilles)
                    .pro-hero__right
                        .pro-mock
                            a.pro-mock__price-pill(href="/register?intent=pro")= pl.hero.mock_pill
                            .pro-mock__bar
                                span.dot-r
                                span.dot-y
                                span.dot-g
                            .pro-mock__grid
                                .pro-mock__head-cell GMT
                                .pro-mock__head-cell Lun 17
                                .pro-mock__head-cell Mar 18
                                .pro-mock__head-cell.today Mer 19
                                .pro-mock__head-cell Jeu 20
                                .pro-mock__head-cell Ven 21
                                .pro-mock__time 09:00
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--soft Sara M.
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__time 10:00
                                .pro-mock__slot
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--amber Pierre L.
                                .pro-mock__slot.today-col
                                    .pro-mock__event.pro-mock__event--solid Sara M.
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__time 11:00
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                    .pro-mock__event.pro-mock__event--solid Benjamin
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--soft Camille
                                .pro-mock__slot
                                .pro-mock__time 12:00
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                .pro-mock__slot
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--solid Joachim
                                .pro-mock__time 13:00
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                    .pro-mock__event.pro-mock__event--solid Léa P.
                                .pro-mock__slot
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--blue Iris V.

                            .pro-mock__toast
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="12" height="12")
                                    path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                span= pl.hero.mock_toast

                            .pro-mock__notif
                                .pro-mock__notif-head
                                    .pro-mock__notif-av BG
                                    div
                                        .pro-mock__notif-title
                                            if lang === 'en'
                                                | New booking
                                            else if lang === 'de'
                                                | Neue Buchung
                                            else if lang === 'es'
                                                | Nueva reserva
                                            else if lang === 'it'
                                                | Nuova prenotazione
                                            else if lang === 'nl'
                                                | Nieuwe boeking
                                            else
                                                | Nouveau rendez-vous
                                        .pro-mock__notif-time
                                            if lang === 'en'
                                                | 2 min ago
                                            else if lang === 'de'
                                                | Vor 2 Min.
                                            else if lang === 'es'
                                                | Hace 2 min
                                            else if lang === 'it'
                                                | 2 min fa
                                            else if lang === 'nl'
                                                | 2 min geleden
                                            else
                                                | Il y a 2 min
                                .pro-mock__notif-body
                                    strong Benjamin G.
                                    //- Un "|" vide ne produit AUCUN espace en Pug
                                    = " "
                                    if lang === 'en'
                                        | booked Color refresh
                                    else if lang === 'de'
                                        | hat Farbauffrischung gebucht
                                    else if lang === 'es'
                                        | reservó Retoque de color
                                    else if lang === 'it'
                                        | ha prenotato Ritocco colore
                                    else if lang === 'nl'
                                        | boekte Kleurbehandeling
                                    else
                                        | a réservé Soin colorant
                                .pro-mock__notif-pills
                                    //- Cohérent avec la grille : Benjamin est le mercredi 19 à 11:00
                                    .pro-mock__pill Mer 19 · 11:00
                                    .pro-mock__pill.pro-mock__pill--green 90 €

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 3. STATS — 4 chiffres honnêtes (produit, pas clients)
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-stats
            .container
                .pro-stats__grid
                    each stat in pl.stats
                        .pro-stat
                            .pro-stat__n= stat.n
                            .pro-stat__l= stat.l
                            .pro-stat__s= stat.s

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 5. FONCTIONNALITÉS — 3 rangées alternées
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-funcs
            .container
                .pro-sec-hd
                    .pro-pill= pl.funcs_hd.pill
                    h2.pro-h2
                        = pl.funcs_hd.title + ' '
                        em= pl.funcs_hd.title_em
                each row, index in pl.funcs
                    .pro-func(class=index % 2 !== 0 ? 'pro-func--flip' : '')
                        .pro-func__text
                            .pro-func__tag= row.tag
                            h3.pro-func__title= row.title
                            p.pro-func__desc= row.desc
                            ul.pro-func__bullets
                                each item in row.items
                                    li= item
                            if row.roi
                                .pro-func__roi
                                    svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="16" height="16")
                                        path(d="m233-120 65-281L80-590l288-25 112-265 112 265 288 25-218 189 65 281-247-149-247 149Z")
                                    span= row.roi
                            .pro-func__actions
                                a.sm-btn.sm-btn--primary(href=row.cta_href)= row.cta
                        .pro-func__visual
                            img.pro-func__img(src=row.image alt=row.title loading="lazy" width="560" height="420")

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 7. COMMENT ÇA MARCHE — 3 étapes
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-hiw#hiw
            .container
                .pro-sec-hd
                    .pro-pill= pl.hiw.pill
                    h2.pro-h2
                        //- " + ' '" garantit l'espace entre les deux segments
                        //- (un "|" vide ne produit pas d'espace en Pug).
                        = pl.hiw.title + ' '
                        em= pl.hiw.title_em
                .pro-hiw__steps
                    each step, idx in pl.hiw.steps
                        .pro-step
                            .pro-step__n= idx + 1
                            h3.pro-step__title= step.title
                            p.pro-step__desc= step.desc
                .pro-hiw__cta
                    a.sm-btn.sm-btn--primary(href="/register?intent=pro")= pl.hiw.cta
                    p.pro-hiw__cta-note= pl.hiw.note

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 9. TARIFS — 3 plans réels (#tarifs)
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-pricing#tarifs
            .container
                .pro-sec-hd
                    .pro-pill= pl.pricing.pill
                    h2.pro-h2= pl.pricing.title
                    p.pro-desc= pl.pricing.desc

                .pro-plans
                    .pro-plan
                        h3.pro-plan__name= t.subscription.plan_1
                        p.pro-plan__desc= pl.pricing.plan_1_tagline
                        .pro-plan__price
                            span.pro-plan__price-n= t.subscription.price_1
                        .pro-plan__price-hint= pl.pricing.plan_1_price_sub
                        ul.pro-plan__features
                            each feature in pl.pricing.plan_1_features
                                li
                                    svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                        path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                    span= feature
                        a.sm-btn.sm-btn--soft.pro-plan__cta(href="/register?intent=pro")= pl.pricing.plan_1_cta
                        p.pro-plan__note= pl.pricing.plan_1_note

                    .pro-plan.pro-plan--featured
                        .pro-plan__badge= pl.pricing.popular
                        h3.pro-plan__name= t.subscription.plan_2
                        p.pro-plan__desc= pl.pricing.plan_2_tagline
                        .pro-plan__price
                            span.pro-plan__price-n= t.subscription.price_2
                            span.pro-plan__price-s= t.subscription.price_2_sub
                        .pro-plan__price-hint= pl.pricing.plan_2_price_hint
                        ul.pro-plan__features
                            each feature in pl.pricing.plan_2_features
                                li
                                    svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                        path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                    span= feature
                        a.sm-btn.sm-btn--primary.pro-plan__cta(href="/register?intent=pro&plan=pro&billing=monthly")= pl.pricing.plan_2_cta
                        p.pro-plan__note= pl.pricing.plan_2_note

                    .pro-plan
                        h3.pro-plan__name= t.subscription.plan_3
                        p.pro-plan__desc= pl.pricing.plan_3_tagline
                        .pro-plan__price
                            span.pro-plan__price-n= t.subscription.price_3
                            span.pro-plan__price-s= t.subscription.price_3_sub
                        .pro-plan__price-hint= pl.pricing.plan_3_price_hint
                        ul.pro-plan__features
                            each feature in pl.pricing.plan_3_features
                                li
                                    svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                        path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                    span= feature
                        a.sm-btn.sm-btn--soft.pro-plan__cta(href="/register?intent=pro&plan=business&billing=monthly")= pl.pricing.plan_3_cta

                p.pro-pricing__note
                    svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                        path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm0-80h480v-400H240v400Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80Z")
                    = pl.pricing.note

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 11. FAQ — 10 questions anti-objections
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-faq.faq.padding-d
            .container
                .faq__container
                    .faq__title
                        h2= pl.faq.title
                        p= pl.faq.sub
                    .faq__body
                        each item, idx in pl.faq.items
                            .faq__question(class=idx === 0 ? 'open' : '')
                                .faq__answer-container
                                    .faq__answer= item.q
                                    .faq__icon.flex-c
                                        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24")
                                            path(d="M0 0h24v24H0V0z" fill="none")
                                            path(d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6-6-6z")
                                .faq__response= item.a

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- 12. CTA FINAL — renversement du risque
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-cta
            .container
                .pro-cta__brand
                    img.pro-cta__mark(src="/images/icon.svg" alt="" width="32" height="32")
                    .pro-cta__name BranShee
                h2.pro-cta__h2
                    = pl.cta.title
                    br
                    span= pl.cta.title_em
                p.pro-cta__sub= pl.cta.desc
                .pro-cta__actions
                    a.sm-btn.sm-btn--primary(href="/register?intent=pro")= pl.cta.btn_1
                    a.sm-btn.sm-btn--ghost(href="/register?intent=pro&plan=pro&billing=monthly")= pl.cta.btn_2
                a.pro-cta__contact(href="/contact")= pl.cta.contact

        //- Barre d'action collante — mobile uniquement. Le trafic Ads est
        //- surtout mobile et la page est longue : sans ça, le CTA disparaît dès
        //- qu'on scrolle passé le hero. Toujours accessible en bas d'écran.
        a.pro-sticky-cta(href="/register?intent=pro")= pl.hero.cta_free

block scripts
    script(src="/js/layouts/landing-page.js" type="module")
    script(src="/js/layouts/client/landing-page.js" type="module")
