extends ../../layouts/index

block jsonld
    script(type="application/ld+json").
        {
          "@context": "https://schema.org",
          "@type": "WebPage",
          "name": "BranShee — Gérez votre activité et recevez des réservations en ligne",
          "url": "#{canonical || 'https://www.branshee.com/'}",
          "description": "Créez votre page professionnelle sur BranShee et recevez des réservations en ligne 24h/24. Gérez vos rendez-vous, employés et services facilement.",
          "isPartOf": {
            "@type": "WebSite",
            "name": "BranShee",
            "url": "https://www.branshee.com"
          }
        }
    script(type="application/ld+json").
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Comment créer un agenda en ligne pour mon activité avec BranShee ?",
              "acceptedAnswer": { "@type": "Answer", "text": "Inscrivez-vous gratuitement sur BranShee, créez votre page professionnelle, configurez vos services, horaires et disponibilités. Partagez ensuite votre lien de réservation avec vos clients. Votre agenda en ligne est prêt en moins de 5 minutes." }
            },
            {
              "@type": "Question",
              "name": "BranShee est-il gratuit pour les professionnels ?",
              "acceptedAnswer": { "@type": "Answer", "text": "Oui, BranShee propose une formule gratuite pour commencer, sans carte bancaire. Des offres premium avec plus de fonctionnalités sont disponibles, avec un mois d'essai offert et possibilité d'annuler à tout moment." }
            },
            {
              "@type": "Question",
              "name": "Comment mes clients peuvent-ils prendre rendez-vous ?",
              "acceptedAnswer": { "@type": "Answer", "text": "Vos clients réservent directement en ligne 24h/24 via votre page de réservation personnalisée, sans avoir besoin de vous appeler ni de créer de compte." }
            },
            {
              "@type": "Question",
              "name": "BranShee est-il une bonne alternative à Calendly ou Planity ?",
              "acceptedAnswer": { "@type": "Answer", "text": "Oui. BranShee est une alternative française à Calendly, Planity ou SimplyBook spécialement conçue pour les indépendants et petites équipes. Il propose un calendrier de réservation en ligne, la gestion des employés, les paiements et les rappels automatiques." }
            }
          ]
        }

block links
    link(rel="stylesheet", href="/css/layouts/landing-page.css")

block content
    - var pl = t.pro_landing

    .pro-lp

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- HERO
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-hero
            .container
                .pro-hero__inner

                    //- Left — headline + CTA
                    .pro-hero__left
                        .pro-badge
                            span.pro-badge__dot
                            = pl.hero.badge
                        h1.pro-h1
                            = pl.hero.title_1
                            br
                            em= pl.hero.title_2
                        p.pro-sub= t.hero.description
                        //- Un seul bouton bien visible — la page cible des PROFESSIONNELS
                        //- pour du trafic Google Ads payant : un 2ème bouton de même poids
                        //- ("Prendre rendez-vous" → /search, pensé pour des CLIENTS) divisait
                        //- l'attention et envoyait une partie des clics vers le mauvais
                        //- public. Le lien reste disponible mais en simple texte discret,
                        //- pour le rare visiteur qui cherchait en fait à réserver chez
                        //- quelqu'un plutôt qu'à créer son propre compte pro.
                        .pro-actions
                            a.sm-btn.sm-btn--primary(href="/register?plan=pro&billing=monthly") Essai Pro gratuit 1 mois →
                            a.sm-btn.sm-btn--ghost(href="/register") Commencer gratuitement
                        p.pro-hero__card-note
                            | Essai Pro : carte requise, débitée seulement après le 1er mois.&nbsp;
                            | Plan Starter&nbsp;
                            a(href="/register" style="color:inherit;text-decoration:underline") sans carte
                            |  aussi disponible.
                        a.pro-hero__alt-link(href="/search")
                            svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="13" height="13")
                                path(d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Zm0 0v-80 80Z")
                            = pl.hero.cta_booking || 'Prendre rendez-vous'

                        .pro-pricing-note
                            span Gratuit pour commencer ·&nbsp;
                            strong Pro à 19€/mois&nbsp;
                            span après essai · Sans engagement
                        .pro-micro
                            span
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                    path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                = pl.hero.check_1
                            span
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                    path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                = pl.hero.check_2
                            span
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                    path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                = pl.hero.check_3

                        if t.landing && t.landing.cats
                            .lp__cats
                                each cat in t.landing.cats
                                    if cat.key !== 'all'
                                        span.lp__cat= cat.label

                    //- Right — product mockup (UI démo, non traduit)
                    .pro-hero__right
                        .pro-mock
                            .pro-mock__bar
                                span.dot-r
                                span.dot-y
                                span.dot-g
                            .pro-mock__grid
                                .pro-mock__head-cell GMT
                                .pro-mock__head-cell Lun 17
                                .pro-mock__head-cell Mar 18
                                .pro-mock__head-cell.today Mer 19
                                .pro-mock__head-cell Jeu 20
                                .pro-mock__head-cell Ven 21
                                .pro-mock__time 09:00
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--soft Sara M.
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__time 10:00
                                .pro-mock__slot
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--amber Pierre L.
                                .pro-mock__slot.today-col
                                    .pro-mock__event.pro-mock__event--solid Sara M.
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__time 11:00
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                    .pro-mock__event.pro-mock__event--solid Benjamin
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--soft Camille
                                .pro-mock__slot
                                .pro-mock__time 12:00
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                .pro-mock__slot
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--solid Joachim
                                .pro-mock__time 13:00
                                .pro-mock__slot
                                .pro-mock__slot
                                .pro-mock__slot.today-col
                                    .pro-mock__event.pro-mock__event--solid Léa P.
                                .pro-mock__slot
                                .pro-mock__slot
                                    .pro-mock__event.pro-mock__event--blue Iris V.

                            .pro-mock__notif
                                .pro-mock__notif-head
                                    .pro-mock__notif-av BG
                                    div
                                        .pro-mock__notif-title
                                            if lang === 'en'
                                                | New booking
                                            else if lang === 'de'
                                                | Neue Buchung
                                            else if lang === 'es'
                                                | Nueva reserva
                                            else if lang === 'it'
                                                | Nuova prenotazione
                                            else if lang === 'nl'
                                                | Nieuwe boeking
                                            else
                                                | Nouveau rendez-vous
                                        .pro-mock__notif-time
                                            if lang === 'en'
                                                | 2 min ago
                                            else if lang === 'de'
                                                | Vor 2 Min.
                                            else if lang === 'es'
                                                | Hace 2 min
                                            else if lang === 'it'
                                                | 2 min fa
                                            else if lang === 'nl'
                                                | 2 min geleden
                                            else
                                                | Il y a 2 min
                                .pro-mock__notif-body
                                    strong Benjamin G.
                                    |
                                    if lang === 'en'
                                        | booked Color refresh
                                    else if lang === 'de'
                                        | hat Farbauffrischung gebucht
                                    else if lang === 'es'
                                        | reservó Retoque de color
                                    else if lang === 'it'
                                        | ha prenotato Ritocco colore
                                    else if lang === 'nl'
                                        | boekte Kleurbehandeling
                                    else
                                        | a réservé Soin colorant
                                .pro-mock__notif-pills
                                    .pro-mock__pill Mar 19 · 10:30
                                    .pro-mock__pill.pro-mock__pill--green 90 €

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- TRUST STRIP — supprimé
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- Ce bandeau ne contenait plus qu'une seule phrase isolée dans un
        //- grand espace vide ("il manque un truc la non ? car y a juste une
        //- phrase, retire-la je pense pour le moment"). La section
        //- `.pro-stats` juste en dessous porte déjà le même message implicite
        //- (chiffres-clés mis en avant), donc on retire purement et
        //- simplement cette phrase orpheline plutôt que de la laisser flotter.

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- STATS
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-stats
            .container
                .pro-stats__grid
                    each stat in pl.stats
                        .pro-stat
                            .pro-stat__n= stat.n
                            .pro-stat__l= stat.l
                            .pro-stat__s= stat.s

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- FEATURES — 6 boxes
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-features
            .container
                .pro-sec-hd
                    .pro-pill= pl.features.pill
                    h2.pro-h2
                        = pl.features.title
                        br
                        em= pl.features.title_em
                    p.pro-desc= pl.features.desc
                .pro-features__grid
                    each item, idx in t.features.items
                        .pro-feat
                            .pro-feat__icon
                                != item.icon
                            .pro-feat__tag= pl.features.tags[idx]
                            h3.pro-feat__title= item.title
                            p.pro-feat__desc= item.description

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- FUNCTIONALITIES — alternating rows
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-funcs
            .container
                each row, index in t.functionalities.rows
                    .pro-func(class=index % 2 !== 0 ? 'pro-func--flip' : '')
                        .pro-func__text
                            .pro-func__tag= pl.func_tags[index]
                            h3.pro-func__title= row.title
                            p.pro-func__desc= row.description
                            ul.pro-func__bullets
                                each item in row.items
                                    li= item
                            .pro-func__actions
                                a.sm-btn.sm-btn--primary(href="/register?plan=pro&billing=monthly")= row.btn_2
                        .pro-func__visual
                            img.pro-func__img(src=row.image alt=row.title)

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- HOW IT WORKS
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-hiw#hiw
            .container
                .pro-sec-hd
                    .pro-pill= pl.hiw.pill
                    h2.pro-h2
                        //- " + ' '" garantit un espace entre les deux segments —
                        //- un simple "|" vide ne produit pas d'espace en Pug, ce
                        //- qui collait "En ligne en" et "moins de 10 min." (titre
                        //- et <em> de tailles visuellement différentes mais aussi
                        //- mal séparés : "En ligne enmoins de 10 min.").
                        = pl.hiw.title + ' '
                        em= pl.hiw.title_em
                .pro-hiw__steps
                    each step, idx in pl.hiw.steps
                        .pro-step
                            .pro-step__n= idx + 1
                            h3.pro-step__title= step.title
                            p.pro-step__desc= step.desc

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- TESTIMONIALS
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        if pl.tests.items && pl.tests.items.length > 0
            section.pro-tests
                .container
                    .pro-sec-hd
                        .pro-pill= pl.tests.pill
                        h2.pro-h2
                            = pl.tests.title
                            |
                            em= pl.tests.title_em
                    .pro-tests__grid
                        each item, idx in pl.tests.items
                            .pro-test
                                .pro-test__stars
                                    - for(var i=0;i<5;i++)
                                        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="13" height="13")
                                            path(d="m233-80 65-281L80-550l288-25 112-265 112 265 288 25-218 189 65 281-247-149L233-80Z")
                                p.pro-test__quote "#{item.q}"
                                .pro-test__author
                                    .pro-test__av(class="pro-test__av--" + (idx + 1))= item.n.split(' ').map(function(w){return w[0]}).join('')
                                    div
                                        .pro-test__name= item.n
                                        .pro-test__role= item.r

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- PRICING — vrais tarifs affichés ici (pas besoin d'un compte pour
        //- les voir : "Voir les plans" renvoyait avant vers /subscription,
        //- une page admin qui exige d'être connecté → un visiteur Ads tombait
        //- sur un mur de connexion au lieu des prix qu'il venait chercher).
        //- Mêmes données que la page d'abonnement (t.subscription.*), donc
        //- toujours synchronisé avec les vrais tarifs/fonctionnalités.
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-pricing
            .container
                .pro-sec-hd
                    .pro-pill= pl.pricing.label
                    h2.pro-h2= pl.pricing.title
                    p.pro-desc= pl.pricing.desc

                .pro-plans
                    .pro-plan
                        h3.pro-plan__name= t.subscription.plan_1
                        p.pro-plan__desc= t.subscription.plan_1_desc
                        .pro-plan__price
                            span.pro-plan__price-n= t.subscription.price_1
                            span.pro-plan__price-s &nbsp;#{t.subscription.price_1_sub}
                        ul.pro-plan__features
                            each feature in t.subscription.plan_1_features
                                li
                                    svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                        path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                    span= feature
                        a.sm-btn.sm-btn--soft.pro-plan__cta(href="/register")= pl.pricing.cta_2

                    .pro-plan.pro-plan--featured
                        .pro-plan__badge= t.sub_extra.popular || 'Le plus populaire'
                        h3.pro-plan__name= t.subscription.plan_2
                        p.pro-plan__desc= t.subscription.plan_2_desc
                        .pro-plan__price
                            span.pro-plan__price-n= t.subscription.price_2
                            span.pro-plan__price-s= t.subscription.price_2_sub
                        ul.pro-plan__features
                            each feature, fi in t.subscription.plan_2_features
                                if fi < 5
                                    li
                                        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                            path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                        span= feature
                        a.sm-btn.sm-btn--primary.pro-plan__cta(href="/register?plan=pro&billing=monthly")= pl.pricing.cta_2

                    .pro-plan
                        h3.pro-plan__name= t.subscription.plan_3
                        p.pro-plan__desc= t.subscription.plan_3_desc
                        .pro-plan__price
                            span.pro-plan__price-n= t.subscription.price_3
                            span.pro-plan__price-s= t.subscription.price_3_sub
                        ul.pro-plan__features
                            each feature, fi in t.subscription.plan_3_features
                                if fi < 5
                                    li
                                        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                                            path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                        span= feature
                        a.sm-btn.sm-btn--soft.pro-plan__cta(href="/register?plan=business&billing=monthly")= pl.pricing.cta_2

                p.pro-pricing__note
                    svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="14" height="14")
                        path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm0-80h480v-400H240v400Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80Z")
                    | Paiement sécurisé par Stripe

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- FAQ
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-faq.faq.padding-d
            .container
                .faq__container
                    .faq__title
                        h2= t.faq.title
                        p= t.faq.description
                    .faq__body
                        each item, idx in t.faq.items
                            .faq__question(class=idx === 0 ? 'open' : '')
                                .faq__answer-container
                                    .faq__answer= item.q
                                    .faq__icon.flex-c
                                        svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24")
                                            path(d="M0 0h24v24H0V0z" fill="none")
                                            path(d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6-6-6z")
                                .faq__response= item.a

        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        //- FINAL CTA
        //- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        section.pro-cta
            .container
                .pro-cta__brand
                    .pro-cta__mark B
                    .pro-cta__name BranShee
                h2.pro-cta__h2
                    = pl.cta.title
                    br
                    span= pl.cta.title_em
                p.pro-cta__sub= pl.cta.desc
                .pro-cta__actions
                    a.sm-btn.sm-btn--primary(href="/register?plan=pro&billing=monthly")= pl.cta.btn_1
                    a.sm-btn.sm-btn--ghost(href="/contact")= pl.cta.btn_2

block scripts
    script(src="/js/layouts/landing-page.js" type="module")
    script(src="/js/layouts/client/landing-page.js" type="module")
