extends ../../layouts/index

block content
    style.
        .disabled-wrap {
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }
        .disabled-card {
            background: var(--color-white);
            border: 1px solid var(--border-light);
            border-radius: 20px;
            box-shadow: var(--shadow);
            padding: 48px 40px;
            max-width: 440px;
            width: 100%;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }
        .disabled-icon {
            width: 64px;
            height: 64px;
            border-radius: 18px;
            background: #fffbeb;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .disabled-icon svg { fill: #d97706; }
        .disabled-card h1 {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
            letter-spacing: -0.01em;
        }
        .disabled-card p {
            font-size: 15px;
            color: var(--text-secondary);
            line-height: 1.55;
            margin: 0;
        }
        .disabled-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 8px;
            padding: 10px 22px;
            border-radius: 10px;
            background: var(--bg-secondary);
            border: 1px solid var(--border-light);
            color: var(--text-primary);
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.15s;
        }
        .disabled-back:hover { background: var(--border-light); }

    .disabled-wrap
        .disabled-card
            .disabled-icon
                svg(viewBox="0 -960 960 960" height="32" width="32")
                    path(d="M360-320h80v-320h-80v320Zm160 0h80v-320h-80v320ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Z")
            h1 Réservations en pause
            p Ce professionnel a temporairement mis ses réservations en pause.#[br]Revenez un peu plus tard, ou contactez-le directement.
            a.disabled-back(href="/search")
                svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
