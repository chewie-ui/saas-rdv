extends ../../layouts/index

block links
    link(rel="stylesheet", href="/css/layouts/client/landing-page.css")

block content
    .landing__client
        .hero
            .hero__blur
            .hero__container.container
                h1= t.search.hero_title
                p= t.search.hero_subtitle
        .hero__form
            .hero__form-container.container
                .form-group
                    label= t.search.label_name
                    input.input.search-input#inputName(placeholder=t.search.placeholder_name)
                .form-group
                    label= t.search.label_location
                    input.search-input#inputLocation(type="text" placeholder=t.search.placeholder_location).input
                .form__action
                    button.btn.secondary#searchBtn= t.search.btn_search
            .hero__results
            .hero__suggestions.container
                each coach in coachs
                    .suggestions__row
                        .row__avatar
                            img(src=coach.owner.profilePicture || '/images/no-user.webp')
                        .row__informations
                            .informations__left
                                .informations__name
                                    h2= coach.owner.fullName
                                if coach.owner.email
                                    .informations__email
                                        a(href=`mailto:${coach.owner.email}`)= coach.owner.email
                                if coach.owner.phone
                                    .informations__phone
                                        a(href=`tel:${coach.owner.phone}`)= coach.owner.phone
                                .informations__description
                                    p Lorem, ipsum dolor sit amet consectetur adipisicing elit. Provident corrupti amet reiciendis, dicta impedit magnam consequatur. Expedita adipisci modi fugiat ad ea, laborum similique, provident, voluptates illum in maxime. Aliquam?
                                if coach.owner.location
                                    .informations__location
                                        a(href="#") #{coach.owner.location.address} #{coach.owner.location.city} #{coach.owner.location.zip} #{coach.owner.location.country}
                                else
                                    .informations__location
                                        p= t.search.online_service

                            .informations__right
                                .infos__coach
                                    if coach.owner.recommanded
                                        button.hidden.flex-c.recommanded__coach
                                            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M365.39-271.54h215.38q13.54 0 24.58-6.39 11.03-6.38 15.88-18.69l76.31-177.53q2.38-6.16 3.57-11.93 1.2-5.77 1.2-11.15v-25.08q0-12.77-8.23-21t-21-8.23H477.54l23.29-125.97q1.94-9.26-1.06-17.49-3-8.23-9.23-14.46l-18.23-18.23L317.54-560q-6.08 6.24-9.12 14.04-3.03 7.81-3.03 17.5v196.92q0 24.75 17.62 42.37 17.63 17.63 42.38 17.63ZM480.07-100q-78.84 0-148.21-29.92t-120.68-81.21q-51.31-51.29-81.25-120.63Q100-401.1 100-479.93q0-78.84 29.92-148.21t81.21-120.68q51.29-51.31 120.63-81.25Q401.1-860 479.93-860q78.84 0 148.21 29.92t120.68 81.21q51.31 51.29 81.25 120.63Q860-558.9 860-480.07q0 78.84-29.92 148.21t-81.21 120.68q-51.29 51.31-120.63 81.25Q558.9-100 480.07-100Zm-.07-60q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                                    if coach.owner.verified
                                        button.hidden.flex-c.verified__profile 
                                            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M438-351.85 650.15-564l-42.77-42.77L438-437.38l-84.77-84.77-42.77 42.77L438-351.85Zm42 251.08q-129.77-35.39-214.88-152.77Q180-370.92 180-516v-230.15l300-112.31 300 112.31V-516q0 145.08-85.12 262.46Q609.77-136.16 480-100.77Zm0-63.23q104-33 172-132t68-220v-189l-240-89.62L240-705v189q0 121 68 220t172 132Zm0-315.62Z"/></svg>
                                    button.hidden.flex-c.favorite__btn
                                        <svg xmlns="http://www.w3.org/2000/svg" height="35px" viewBox="0 -960 960 960" width="35px" fill="#e3e3e3"><path d="m480-146.93-44.15-39.69q-99.46-90.23-164.5-155.07-65.04-64.85-103.08-115.43-38.04-50.57-53.15-92.27Q100-591.08 100-634q0-85.15 57.42-142.58Q214.85-834 300-834q52.38 0 99 24.5t81 70.27q34.38-45.77 81-70.27 46.62-24.5 99-24.5 85.15 0 142.58 57.42Q860-719.15 860-634q0 42.92-15.12 84.61-15.11 41.7-53.15 92.27-38.04 50.58-102.89 115.43Q624-276.85 524.15-186.62L480-146.93Zm0-81.07q96-86.38 158-148.08 62-61.69 98-107.19t50-80.81q14-35.3 14-69.92 0-60-40-100t-100-40q-47.38 0-87.58 26.88-40.19 26.89-63.65 74.81h-57.54q-23.85-48.31-63.85-75Q347.38-774 300-774q-59.62 0-99.81 40Q160-694 160-634q0 34.62 14 69.92 14 35.31 50 80.81t98 107q62 61.5 158 148.27Zm0-273Z"/></svg>
                                a(href=`/${coach._id}` target="_blank").btn.sec.book__btn= t.search.btn_book

block scripts
    script(src="/js/layouts/client/landing-page.js" type="module")
    