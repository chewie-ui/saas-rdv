extends ../../layouts/index

block links
    link(rel="stylesheet", href="/css/layouts/client/landing-page.css")

block content
    .landing__client
        .hero
            .hero__blur
            .hero__container.container
                h1= t.search.hero_title
                p= t.search.hero_subtitle
        .hero__form
            .hero__form-container.container
                .form-group
                    label= t.search.label_name
                    input.input.search-input#inputName(placeholder=t.search.placeholder_name autocomplete='off')
                .form-group
                    label= t.search.label_location
                    input.search-input#inputLocation(type="text" placeholder=t.search.placeholder_location).input
                .form__action
                    button.sm-btn.sm-btn--ghost#searchBtn= t.search.btn_search
            .search-results.container
                if coachs && coachs.length > 0
                    p.search-results__count #{coachs.length} #{t.search.results_label || 'résultats'}
                .lp__cards
                    each coach in coachs
                        .sm-result-card(data-type=(coach.owner.businessType || '').toLowerCase())
                            .sm-result-card__photo
                                img(src=coach.owner.profilePicture || '/images/no-user.webp' alt=coach.owner.businessName)
                            .sm-result-card__body
                                h2.sm-result-card__name= coach.owner.businessName
                                .sm-result-card__meta
                                    if coach.owner.businessType
                                        span= coach.owner.businessType
                                    if coach.owner.location && coach.owner.location.city
                                        span.lp__sep  ·
                                        span= coach.owner.location.city
                                    else
                                        span.lp__sep  ·
                                        span= t.search.online_service
                                if coach.owner.description
                                    p.sm-result-card__desc= coach.owner.description
                            a.sm-btn.sm-btn--primary(href=`/${coach._id}`)= t.search.btn_book

block scripts
    script(src="/js/layouts/client/landing-page.js" type="module")
    