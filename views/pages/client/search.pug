extends ../../layouts/index

block links
    //- Material Symbols n'est PAS chargée par layouts/index.pug (ni la topbar ni
    //- le footer n'en utilisent). On la charge donc au niveau de cette page
    //- seule, pour ne pas peser sur le LCP de toutes les pages publiques.
    //- `display=block` (comme admin.pug / client.pug) évite d'afficher les
    //- ligatures en texte brut (« search », « location_on ») avant chargement.
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block")
    link(rel="stylesheet", href="/css/layouts/client/search.css")

block content
    -
        var _cats    = (allCategories || []).filter(function(c){ return c.count > 0; })
        var _topCats = _cats.slice(0, 8)
        //- Total RÉEL (toutes pages), fourni par le serveur — pas la longueur
        //- de la page courante, sinon on afficherait « 24 résultats ».
        var _total   = (typeof totalResults !== 'undefined') ? totalResults : (coachs ? coachs.length : 0)
        var _page      = (typeof page !== 'undefined') ? page : 1
        var _totalPages = (typeof totalPages !== 'undefined') ? totalPages : 1
        //- Construit une URL /search en conservant les critères courants.
        function _url(over) {
            var p = {}
            if (searchName) p.name = searchName
            if (searchLocation) p.location = searchLocation
            if (searchCategory) p.category = searchCategory
            Object.assign(p, over || {})
            Object.keys(p).forEach(function (k) { if (!p[k]) delete p[k] })
            var qs = new URLSearchParams(p).toString()
            return '/search' + (qs ? '?' + qs : '')
        }

    main.sx

        //- ═══ HERO + RECHERCHE ═══════════════════════════════════════════════
        section.sx-hero
            .sx-hero__inner
                h1.sx-hero__title
                    | Trouvez et réservez votre pro
                    span.sx-dot .
                p.sx-hero__sub Coiffure, santé, coaching, bien-être… la prise de rendez-vous en ligne, en quelques secondes.

                //- La classe .sx-search doit rester SUR le <form> : closeAll()
                //- ferme les menus via e.target.closest('.sx-search').
                form.sx-search#sxForm(action="/search" method="get" autocomplete="off" role="search")
                    .sx-field
                        span.material-symbols-outlined.sx-field__ic(aria-hidden="true") search
                        input#inputName(type="text" name="name" placeholder="Métier ou spécialité" value=searchName || "" aria-label="Métier ou spécialité")
                        .sx-dd#menuNames
                    .sx-search__sep(aria-hidden="true")
                    .sx-field.sx-field--loc
                        span.material-symbols-outlined.sx-field__ic(aria-hidden="true") location_on
                        input#inputLocation(type="text" name="location" placeholder="Ville ou code postal" value=searchLocation || "" aria-label="Ville ou code postal")
                        //- #geoBtn doit TOUJOURS être rendu : le gestionnaire de
                        //- tri fait geoBtn.click() sans garde de nullité.
                        button.sm-btn.sm-btn--ghost.sx-geo#geoBtn(type="button" title="Utiliser ma position" aria-label="Autour de moi")
                            span.material-symbols-outlined(aria-hidden="true") my_location
                        .sx-dd#menuLocations
                    button.sm-btn.sm-btn--primary.sx-submit#searchBtn(type="submit")
                        span.material-symbols-outlined(aria-hidden="true") search
                        span.sx-submit__t Rechercher

                if _topCats.length
                    .sx-hero__quick
                        span.sx-hero__quick-lbl Populaire
                        each cat in _topCats.slice(0, 6)
                            //- Libellé dans un <span> et non en texte nu : la règle
                            //- d'ellipsis vise `.sx-quick > *`, qui ne matchait donc
                            //- RIEN. Le bouton étant un flex centré, un intitulé long
                            //- débordait des deux côtés et se faisait rogner sans
                            //- points de suspension — illisible sur téléphone.
                            a.sm-btn.sm-btn--ghost.sx-quick(href=`/search?name=${encodeURIComponent(cat.name)}` title=cat.name)
                                span.sx-quick__t= cat.name

        //- ═══ CORPS : filtres + résultats ════════════════════════════════════
        //- Pas de .container ici : .sx-body est un shell fluide (voir CSS), ce
        //- qui évite le palier figé à 800px entre 820 et 1279.
        section.sx-body

            //- Barre d'outils collante : chips catégories + tri, sur UNE rangée
            //- à toutes les largeurs (les chips défilent horizontalement).
            .sx-toolbar
                .sx-toolbar__in
                    //- Liens serveur (et non un filtre JS) : avec la pagination,
                    //- filtrer côté client ne verrait que la page courante.
                    .sx-chips#sxChips
                        a.sx-chip(href=_url({ category: '', page: '' }) class=(!searchCategory ? 'is-active' : ''))
                            span.sx-chip__t Tous
                        each cat in _topCats
                            a.sx-chip(
                                href=_url({ category: cat.name, page: '' })
                                title=cat.name
                                class=(searchCategory && searchCategory.toLowerCase() === cat.name.toLowerCase() ? 'is-active' : '')
                            )
                                span.sx-chip__t= cat.name
                                span.sx-chip__n= cat.count
                    .sx-sort
                        label.sx-sort__lbl(for="sxSort") Trier
                        //- <select> natif : le JS fait sel.value = 'distance'.
                        select#sxSort.ds-select.sx-sort__sel
                            option(value="default") Recommandés
                            option(value="rating") Mieux notés
                            option(value="distance") Plus proches
                            option(value="name") A–Z

            //- En-tête résultats
            .sx-results-hd
                //- .sx-count est en inline-flex avec gap : pas de nœud texte
                //- « espace » à maintenir entre le nombre et le nom commun.
                span.sx-count(aria-live="polite")
                    strong#srpCount= _total
                    span#srpNoun= _total > 1 ? 'résultats' : 'résultat'
                span.sx-geo-status#geoStatus

            //- Résultats
            if !coachs || coachs.length === 0
                .sx-empty
                    span.material-symbols-outlined.sx-empty__ic(aria-hidden="true") search_off
                    p.sx-empty__t Aucun professionnel trouvé
                    p.sx-empty__s Essayez un autre métier, une autre ville, ou explorez toutes les catégories.
                    a.sm-btn.sm-btn--primary(href="/search") Voir tous les professionnels
            else
                //- #srpGrid doit rester le parent DIRECT des .srp-card :
                //- render() réordonne par grid.appendChild(card).
                .sx-list#srpGrid
                    each coach in coachs
                        -
                            var roundedRating = Math.round((coach.avgRating || 0) * 10) / 10
                            //- Nom/photo/métier de l'ÉTABLISSEMENT d'abord : depuis le
                            //- multi-établissements c'est la source de vérité. Le compte
                            //- propriétaire ne sert que de repli pour les fiches anciennes.
                            var photo = coach.photo || coach.owner.businessPicture || coach.owner.profilePicture || '/images/no-user.webp'
                            var name  = coach.name || coach.owner.businessName || coach.owner.fullName || 'Professionnel'
                            var btype = coach.businessType || coach.owner.businessType || ''
                            var city  = coach.owner.location && coach.owner.location.city ? coach.owner.location.city : ''
                            var lat   = coach.owner.location && coach.owner.location.lat  ? coach.owner.location.lat  : ''
                            var lon   = coach.owner.location && coach.owner.location.lon  ? coach.owner.location.lon  : ''
                            var slug  = coach.slug || String(coach._id)
                        a.srp-card(
                            href=`/${slug}`
                            data-type=(btype || '').toLowerCase()
                            data-name=(name).toLowerCase()
                            data-rating=roundedRating
                            data-lat=lat
                            data-lon=lon
                        )
                            .srp-card__thumb
                                //- alt="" : le nom du pro est déjà dans le lien.
                                img.srp-card__img(src=photo alt="" loading="lazy" decoding="async" width="96" height="96")
                            .srp-card__body
                                .srp-card__top
                                    span.srp-card__name= name
                                    if coach.owner.verified
                                        span.material-symbols-outlined.srp-card__verified(title="Profil vérifié") verified
                                    if coach.boostPosition > 0
                                        span.srp-card__badge.srp-card__badge--boost
                                            span.material-symbols-outlined(aria-hidden="true") bolt
                                            | En avant
                                    else if coach.featured
                                        span.srp-card__badge.srp-card__badge--pro Pro
                                //- .srp-card__meta est TOUJOURS rendu, même vide :
                                //- c'est la cible d'injection de .srp-card__dist.
                                .srp-card__meta
                                    if btype
                                        span.srp-card__type= btype
                                    if city
                                        span.srp-card__city
                                            span.material-symbols-outlined(aria-hidden="true") location_on
                                            = city
                                if coach.reviewCount > 0
                                    .srp-card__rating
                                        span.material-symbols-outlined.srp-card__star(aria-hidden="true") star
                                        span.srp-card__rating-val= roundedRating.toFixed(1)
                                        span.srp-card__rating-n (#{coach.reviewCount})
                                else
                                    .srp-card__rating.srp-card__rating--empty Nouveau sur BranShee
                                if coach.owner.description
                                    p.srp-card__desc= coach.owner.description.length > 120 ? coach.owner.description.slice(0, 120) + '…' : coach.owner.description
                            .srp-card__cta
                                span.srp-card__book Réserver
                                span.material-symbols-outlined.srp-card__chev(aria-hidden="true") chevron_right

                //- ── Pagination (liens serveur : tient à n'importe quel volume) ──
                if _totalPages > 1
                    -
                        //- Fenêtre glissante de 5 pages autour de la page courante,
                        //- pour ne jamais afficher 4000 numéros.
                        var _from = Math.max(1, Math.min(_page - 2, _totalPages - 4))
                        var _to   = Math.min(_totalPages, Math.max(_page + 2, 5))
                    nav.sx-pager(aria-label="Pagination")
                        if _page > 1
                            a.sx-pager__nav(href=_url({ page: _page - 1 }) rel="prev" aria-label="Page précédente")
                                span.material-symbols-outlined(aria-hidden="true") chevron_left
                        else
                            span.sx-pager__nav.is-disabled(aria-hidden="true")
                                span.material-symbols-outlined chevron_left

                        if _from > 1
                            a.sx-pager__n(href=_url({ page: 1 })) 1
                            if _from > 2
                                span.sx-pager__gap …

                        - for (var _p = _from; _p <= _to; _p++)
                            if _p === _page
                                span.sx-pager__n.is-current(aria-current="page")= _p
                            else
                                a.sx-pager__n(href=_url({ page: _p }))= _p

                        if _to < _totalPages
                            if _to < _totalPages - 1
                                span.sx-pager__gap …
                            a.sx-pager__n(href=_url({ page: _totalPages }))= _totalPages

                        if _page < _totalPages
                            a.sx-pager__nav(href=_url({ page: _page + 1 }) rel="next" aria-label="Page suivante")
                                span.material-symbols-outlined(aria-hidden="true") chevron_right
                        else
                            span.sx-pager__nav.is-disabled(aria-hidden="true")
                                span.material-symbols-outlined chevron_right
                    p.sx-pager__info Page #{_page} sur #{_totalPages}

block scripts
    script.
        window.__services   = !{JSON.stringify(services || [])};
        window.__categories = !{JSON.stringify((allCategories || []).map(function(c){ return c.name; }))};

    script.
        (function () {
            // ══════════ Autocomplétion (métiers + villes) ══════════
            var inputName = document.getElementById('inputName');
            var menuNames = document.getElementById('menuNames');
            var inputLoc  = document.getElementById('inputLocation');
            var menuLoc   = document.getElementById('menuLocations');

            function norm(s) { return (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); }

            // Suggestions métiers : catégories RÉELLEMENT présentes sur la
            // plateforme d'abord (les plus utiles), puis tous les métiers.
            var CATS = window.__categories || [];
            var SERVICES = window.__services || [];
            var catSet = {};
            CATS.forEach(function (c) { catSet[norm(c)] = true; });
            var SUGGEST = CATS.concat(SERVICES.filter(function (s) { return !catSet[norm(s)]; }));

            function renderDD(menu, items, iconSvg, onPick) {
                menu.innerHTML = '';
                if (!items.length) { menu.classList.remove('is-open'); return; }
                items.forEach(function (it) {
                    var row = document.createElement('div');
                    row.className = 'sx-dd__item';
                    // Le libellé porte .sx-dd__txt : l'icône étant elle-même un
                    // <span>, un sélecteur générique « .sx-dd__item span »
                    // écraserait la mise en forme du libellé.
                    row.innerHTML = iconSvg + '<span class="sx-dd__txt">' + it.replace(/</g, '&lt;') + '</span>';
                    row.addEventListener('mousedown', function (e) { e.preventDefault(); onPick(it); });
                    menu.appendChild(row);
                });
                menu.classList.add('is-open');
            }
            function closeAll() { menuNames.classList.remove('is-open'); menuLoc.classList.remove('is-open'); }

            var ICON_JOB = '<span class="material-symbols-outlined" aria-hidden="true">search</span>';
            var ICON_PIN = '<span class="material-symbols-outlined" aria-hidden="true">location_on</span>';

            // ── Métiers ──
            function suggestJobs() {
                menuLoc.classList.remove('is-open');
                var q = norm(inputName.value.trim());
                var list = q
                    ? SUGGEST.filter(function (s) { return norm(s).indexOf(q) !== -1; }).slice(0, 8)
                    : SUGGEST.slice(0, 8);
                renderDD(menuNames, list, ICON_JOB, function (val) {
                    inputName.value = val;
                    menuNames.classList.remove('is-open');
                    document.getElementById('sxForm').submit();
                });
            }
            inputName.addEventListener('focus', suggestJobs);
            inputName.addEventListener('input', suggestJobs);
            inputName.addEventListener('blur', function () { setTimeout(function () { menuNames.classList.remove('is-open'); }, 160); });

            // ── Villes (Nominatim) ──
            var locTimer;
            inputLoc.addEventListener('input', function () {
                menuNames.classList.remove('is-open');
                clearTimeout(locTimer);
                var val = inputLoc.value.trim();
                if (val.length < 2) { menuLoc.classList.remove('is-open'); return; }
                locTimer = setTimeout(function () {
                    fetch('https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&limit=6&accept-language=fr&q=' + encodeURIComponent(val))
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            var seen = {};
                            var items = (data || []).map(function (el) {
                                var a = el.address || {};
                                var city = a.city || a.town || a.village || a.municipality || (el.display_name || '').split(',')[0];
                                var region = a.state || a.county || '';
                                // Évite le doublon « Ville · Ville » quand la région = la ville
                                if (region && region.toLowerCase() === city.toLowerCase()) region = '';
                                return city ? (city + (region ? ' · ' + region : '')) : null;
                            }).filter(function (x) { if (!x || seen[x]) return false; seen[x] = 1; return true; }).slice(0, 6);
                            renderDD(menuLoc, items, ICON_PIN, function (val) {
                                inputLoc.value = val.split(' · ')[0];
                                menuLoc.classList.remove('is-open');
                            });
                        })
                        .catch(function () { menuLoc.classList.remove('is-open'); });
                }, 320);
            });
            inputLoc.addEventListener('blur', function () { setTimeout(function () { menuLoc.classList.remove('is-open'); }, 160); });
            document.addEventListener('click', function (e) { if (!e.target.closest('.sx-search')) closeAll(); });
        })();

    script.
        (function () {
            // ══════════ Filtres, tri, distance, géoloc ══════════
            var grid     = document.getElementById('srpGrid');
            if (!grid) return;
            var geoStatus = document.getElementById('geoStatus');
            var allCards = Array.from(grid.querySelectorAll('.srp-card'));
            var activeSort = 'default';
            var refLat = null, refLon = null;

            function haversine(la1, lo1, la2, lo2) {
                var R = 6371, dLa = (la2-la1)*Math.PI/180, dLo = (lo2-lo1)*Math.PI/180;
                var a = Math.sin(dLa/2)*Math.sin(dLa/2) + Math.cos(la1*Math.PI/180)*Math.cos(la2*Math.PI/180)*Math.sin(dLo/2)*Math.sin(dLo/2);
                return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
            }
            function computeDistances() {
                allCards.forEach(function (c) {
                    var lat = parseFloat(c.dataset.lat), lon = parseFloat(c.dataset.lon);
                    var old = c.querySelector('.srp-card__dist');
                    if (old) old.remove();
                    if (refLat == null || isNaN(lat) || isNaN(lon) || lat === 0 || lon === 0) { c.dataset.distance = ''; return; }
                    var d = haversine(refLat, refLon, lat, lon);
                    c.dataset.distance = d.toFixed(1);
                    var chip = document.createElement('span');
                    chip.className = 'srp-card__dist';
                    chip.innerHTML = '<span class="material-symbols-outlined" aria-hidden="true">near_me</span>' + (d < 1 ? '< 1 km' : Math.round(d) + ' km');
                    var meta = c.querySelector('.srp-card__meta');
                    if (meta) meta.appendChild(chip);
                });
            }
            function setRef(lat, lon, label) {
                refLat = lat; refLon = lon;
                if (geoStatus) { geoStatus.innerHTML = '<span class="sx-geo-status__pin">◉</span> ' + label; geoStatus.classList.add('is-on'); }
                computeDistances();
                activeSort = 'distance';
                var sel = document.getElementById('sxSort'); if (sel) sel.value = 'distance';
                render();
            }

            // ── Bouton « Autour de moi » ──
            var geoBtn = document.getElementById('geoBtn');
            geoBtn.addEventListener('click', function () {
                if (!navigator.geolocation) { alert("La géolocalisation n'est pas disponible sur ce navigateur."); return; }
                geoBtn.classList.add('is-loading');
                if (geoStatus) { geoStatus.textContent = 'Localisation en cours…'; geoStatus.classList.add('is-on'); }
                navigator.geolocation.getCurrentPosition(
                    function (pos) { geoBtn.classList.remove('is-loading'); geoBtn.classList.add('is-active'); setRef(pos.coords.latitude, pos.coords.longitude, 'Autour de vous'); },
                    function () { geoBtn.classList.remove('is-loading'); if (geoStatus) { geoStatus.textContent = 'Position refusée — activez la localisation.'; } },
                    { enableHighAccuracy: true, timeout: 8000 }
                );
            });

            // Si une ville est déjà recherchée → géocoder pour activer les distances
            //- Idem : « L'Isle-Adam » (apostrophe) cassait le script entier.
            var initLoc = !{JSON.stringify(searchLocation || "")};
            if (initLoc.trim()) {
                fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&q=' + encodeURIComponent(initLoc))
                    .then(function (r) { return r.json(); })
                    .then(function (d) { if (d && d[0]) setRef(parseFloat(d[0].lat), parseFloat(d[0].lon), initLoc); })
                    .catch(function () {});
            }

            // ── Rendu : TRI de la page courante uniquement ──
            // Le filtre par catégorie et le comptage sont désormais faits par
            // le serveur (chips = liens, pagination) : on ne touche plus ni à
            // l'affichage des cartes ni au compteur, sinon on afficherait le
            // nombre d'éléments de la page au lieu du total réel.
            function render() {
                var visible = allCards.slice();
                visible.sort(function (a, b) {
                    if (activeSort === 'rating') return parseFloat(b.dataset.rating||0) - parseFloat(a.dataset.rating||0);
                    if (activeSort === 'name')   return (a.dataset.name||'').localeCompare(b.dataset.name||'');
                    if (activeSort === 'distance') {
                        var da = parseFloat(a.dataset.distance), db = parseFloat(b.dataset.distance);
                        var aOk = !isNaN(da), bOk = !isNaN(db);
                        if (!aOk && !bOk) return 0; if (!aOk) return 1; if (!bOk) return -1;
                        return da - db;
                    }
                    return 0;
                });
                visible.forEach(function (c) { grid.appendChild(c); });
            }

            // ── Tri ──
            var sortSel = document.getElementById('sxSort');
            sortSel.addEventListener('change', function () {
                activeSort = this.value;
                if (activeSort === 'distance' && refLat == null) { geoBtn.click(); return; }
                render();
            });
        })();
