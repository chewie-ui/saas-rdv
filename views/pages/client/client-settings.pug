extends ../../layouts/client

block links
    link(rel="stylesheet", href="/css/layouts/client-settings.css")

block content
    -
        var _okMsg = { profile: 'Profil mis à jour avec succès.', email: 'Adresse email mise à jour.', password: 'Mot de passe modifié avec succès.', language: 'Langue mise à jour avec succès.' };
        var _errMsg = { wrong_password: 'Mot de passe incorrect.', password_mismatch: 'Les mots de passe ne correspondent pas.', password_too_short: 'Le mot de passe doit contenir au moins 8 caractères.', email_taken: 'Cette adresse email est déjà utilisée.', invalid_name: 'Le nom doit contenir au moins 2 caractères.' };

    .st-page
        //- ── Toast feedback ──────────────────────────────────────────────────
        if success && _okMsg[success]
            .st-toast.st-toast--success
                span.material-symbols-outlined check_circle
                span= _okMsg[success]
        else if error
            .st-toast.st-toast--error
                span.material-symbols-outlined error
                span= _errMsg[error] || 'Une erreur est survenue. Veuillez réessayer.'

        //- ── Navigation commune (onglets) ────────────────────────────────────
        .ds-tabs(role="tablist")
            button.ds-tab.is-active(type="button" role="tab" data-st-tab="profil")
                span.material-symbols-outlined person
                | Profil
            button.ds-tab(type="button" role="tab" data-st-tab="securite")
                span.material-symbols-outlined lock
                | Sécurité
            button.ds-tab(type="button" role="tab" data-st-tab="preferences")
                span.material-symbols-outlined tune
                | Préférences
            button.ds-tab(type="button" role="tab" data-st-tab="paiement")
                span.material-symbols-outlined credit_card
                | Paiement

        //- ══ Onglet : Profil ════════════════════════════════════════════════
        .ds-panel.is-active#panel-profil
            //- Photo de profil
            .st-section
                .st-section__head
                    h2.st-section__title Photo de profil
                    p.st-section__sub Elle apparaît auprès des professionnels chez qui vous réservez.
                .st-avatar
                    .st-avatar__img
                        img#avatarPreview(src=client.profilePicture || '/images/no-user.webp' alt="Avatar")
                    .st-avatar__side
                        button.sm-btn.sm-btn--ghost(type="button" id="triggerAvatarUpload")
                            span.material-symbols-outlined(style="font-size:18px") photo_camera
                            span Changer la photo
                        p.st-avatar__hint JPG, PNG, WebP · max 5 Mo
                        input#avatarInput(type="file" name="profilePicture" accept="image/*" style="display:none")

            //- Informations personnelles
            -
                var phoneCountries = [
                    {name:'Belgique', prefix:'+32', flag:'/images/flags/be.png'},
                    {name:'France', prefix:'+33', flag:'/images/flags/fr.png'},
                    {name:'Luxembourg', prefix:'+352', flag:'/images/flags/lu.png'},
                    {name:'Pays-Bas', prefix:'+31', flag:'/images/flags/nl.png'},
                    {name:'Allemagne', prefix:'+49', flag:'/images/flags/de.png'},
                    {name:'Royaume-Uni', prefix:'+44', flag:'/images/flags/gb.png'},
                    {name:'Espagne', prefix:'+34', flag:'/images/flags/es.png'},
                    {name:'Italie', prefix:'+39', flag:'/images/flags/it.png'},
                    {name:'Suisse', prefix:'+41', flag:'/images/flags/ch.png'},
                    {name:'Maroc', prefix:'+212', flag:'/images/flags/ma.png'},
                    {name:'États-Unis', prefix:'+1', flag:'/images/flags/us.png'}
                ];
            form.st-section(action="/espace-client/parametres/profile" method="POST")
                .st-section__head
                    h2.st-section__title Informations personnelles
                    p.st-section__sub Votre nom et vos coordonnées.
                .st-grid
                    .ds-field
                        label.ds-label(for="fullName") Nom complet
                        input#fullName.ds-input(type="text" name="fullName" value=client.fullName placeholder="Jean Dupont" required)
                    .ds-field
                        label.ds-label(for="phoneLocal") Téléphone
                        .phone-input-group
                            .phone-flag-select#phonePrefixWrap
                                button.phone-flag-btn#phonePrefixBtn(type="button" aria-haspopup="listbox" aria-expanded="false")
                                    img.phone-flag-img#phonePrefixFlag(src="/images/flags/be.png" alt="")
                                    span.phone-flag-code#phonePrefixCode +32
                                    span.material-symbols-outlined.phone-flag-caret expand_more
                                ul.phone-flag-menu#phonePrefixMenu(role="listbox")
                                    each c in phoneCountries
                                        li.phone-flag-option(role="option" data-prefix=c.prefix data-flag=c.flag)
                                            img(src=c.flag alt="")
                                            span.phone-flag-option__name= c.name
                                            span.phone-flag-option__code= c.prefix
                            input#phonePrefix(type="hidden" value="+32")
                            input#phoneLocal.ds-input(type="tel" placeholder="470 00 00 00" autocomplete="off" inputmode="numeric")
                            input#phone(type="hidden" name="phone")
                    .ds-field
                        label.ds-label(for="gender") Civilité
                        select#gender.ds-select(name="gender")
                            - var _genders = ['Madame', 'Monsieur', 'Autre']
                            option(value="" selected=!client.gender) — Non précisé —
                            each g in _genders
                                option(value=g selected=(client.gender === g))= g
                    .ds-field
                        label.ds-label(for="birthDate") Date de naissance
                        input#birthDate.ds-input(type="date" name="birthDate" value=client.birthDate || '')
                    .ds-field.st-field--full
                        label.ds-label(for="address") Adresse
                        input#address.ds-input(type="text" name="address" value=client.address || '' placeholder="12 rue des Fleurs")
                    .ds-field
                        label.ds-label(for="postalCode") Code postal
                        input#postalCode.ds-input(type="text" name="postalCode" value=client.postalCode || '' placeholder="1300")
                    .ds-field
                        label.ds-label(for="city") Ville
                        input#city.ds-input(type="text" name="city" value=client.city || '' placeholder="Wavre")
                    .ds-field.st-field--full
                        label.ds-label(for="country") Pays
                        select#country.ds-select(name="country")
                            option(value="" selected=!client.country) — Sélectionnez un pays —
                            each c in phoneCountries
                                option(value=c.name selected=(client.country === c.name))= c.name
                if !isUnifiedAccount
                    .st-toggle
                        .st-toggle__txt
                            span.st-toggle__title Notifications email
                            span.st-toggle__sub Recevoir les confirmations et rappels de rendez-vous par email.
                        label.ds-switch
                            input#emailNotifications(type="checkbox" name="emailNotifications" checked=(client.emailNotifications !== false))
                            span.ds-switch__track
                .st-actions
                    button.sm-btn.sm-btn--primary(type="submit")
                        span.material-symbols-outlined(style="font-size:18px") save
                        span Enregistrer les modifications

        //- ══ Onglet : Sécurité ══════════════════════════════════════════════
        .ds-panel#panel-securite
            //- Adresse email
            form.st-section(action="/espace-client/parametres/email" method="POST")
                .st-section__head
                    h2.st-section__title Adresse email
                    p.st-section__sub
                        | Email actuel :
                        |
                        strong= client.email
                .st-grid
                    .ds-field
                        label.ds-label(for="newEmail") Nouvel email
                        input#newEmail.ds-input(type="email" name="newEmail" placeholder="nouveau@email.com" required)
                    .ds-field
                        label.ds-label(for="passwordConfirmEmail") Mot de passe actuel
                        input#passwordConfirmEmail.ds-input(type="password" name="passwordConfirm" placeholder="Confirmez votre identité" required)
                .st-actions
                    button.sm-btn.sm-btn--primary(type="submit")
                        span.material-symbols-outlined(style="font-size:18px") mail
                        span Changer l'email

            //- Mot de passe
            form.st-section(action="/espace-client/parametres/password" method="POST")
                .st-section__head
                    h2.st-section__title Mot de passe
                    p.st-section__sub Choisissez un mot de passe d'au moins 8 caractères.
                .st-grid
                    .ds-field
                        label.ds-label(for="currentPassword") Mot de passe actuel
                        input#currentPassword.ds-input(type="password" name="currentPassword" placeholder="••••••••" required)
                    .ds-field
                        label.ds-label(for="newPassword") Nouveau mot de passe
                        input#newPassword.ds-input(type="password" name="newPassword" placeholder="min. 8 caractères" required)
                    .ds-field
                        label.ds-label(for="confirmPassword") Confirmer le mot de passe
                        input#confirmPassword.ds-input(type="password" name="confirmPassword" placeholder="••••••••" required)
                .st-actions
                    button.sm-btn.sm-btn--primary(type="submit")
                        span.material-symbols-outlined(style="font-size:18px") lock_reset
                        span Changer le mot de passe

        //- ══ Onglet : Préférences ═══════════════════════════════════════════
        .ds-panel#panel-preferences
            form.st-section(action="/espace-client/parametres/language" method="POST")
                .st-section__head
                    h2.st-section__title Langue de l'interface
                    p.st-section__sub Choisissez la langue dans laquelle vous souhaitez utiliser l'application.
                .st-langs
                    - const prefLangs = [{code:'fr',label:'Français',flag:'/images/fr.webp'},{code:'en',label:'English',flag:'/images/en.jpg'},{code:'nl',label:'Nederlands',flag:'/images/nl.jpg'},{code:'de',label:'Deutsch',flag:'/images/de.png'},{code:'es',label:'Español',flag:'/images/es.jpg'},{code:'it',label:'Italiano',flag:'/images/it.png'}]
                    each l in prefLangs
                        - var _sel = (client.preferredLang === l.code || (!client.preferredLang && l.code === 'fr'))
                        label.st-lang(class=_sel ? 'is-active' : '')
                            input(type="radio" name="lang" value=l.code checked=_sel)
                            img(src=l.flag alt=l.label)
                            span= l.label
                            span.st-lang__check
                                span.material-symbols-outlined check
                .st-actions
                    button.sm-btn.sm-btn--primary(type="submit")
                        span.material-symbols-outlined(style="font-size:18px") save
                        span Enregistrer la langue

        //- ══ Onglet : Paiement ══════════════════════════════════════════════
        .ds-panel#panel-paiement
            .st-section.st-section--last
                .st-section__head
                    h2.st-section__title Moyens de paiement
                    p.st-section__sub Enregistrez une carte pour réserver plus vite et couvrir d'éventuels frais d'annulation. Vos données bancaires sont gérées de façon sécurisée par Stripe — BranShee ne stocke jamais votre numéro de carte.
                .st-cards-empty
                    span.st-cards-empty__ic
                        span.material-symbols-outlined credit_card_off
                    p.st-cards-empty__title Aucune carte enregistrée
                    p.st-cards-empty__sub Ajoutez une carte pour accélérer vos prochaines réservations.
                .st-actions
                    button.sm-btn.sm-btn--primary(type="button" id="addCardBtn")
                        span.material-symbols-outlined(style="font-size:18px") add_card
                        span Ajouter une carte
                p.st-cards-note#addCardNote(style="display:none")
                    span.material-symbols-outlined info
                    span L'enregistrement des cartes arrive très bientôt. En attendant, votre carte vous est demandée directement au moment de réserver.

block scripts
    script(src="/js/utils/image-upload.js")
    script(src="/js/pages/client/client-settings.js")
    script.
        (function() {
            /* ── Onglets ─────────────────────────────────────────────────── */
            var tabs   = Array.prototype.slice.call(document.querySelectorAll('.ds-tab[data-st-tab]'));
            var keys   = ['profil','securite','preferences','paiement'];
            function panel(k){ return document.getElementById('panel-' + k); }
            function showTab(key) {
                if (keys.indexOf(key) === -1) key = 'profil';
                tabs.forEach(function(t){ t.classList.toggle('is-active', t.dataset.stTab === key); });
                keys.forEach(function(k){ var p = panel(k); if (p) p.classList.toggle('is-active', k === key); });
            }
            tabs.forEach(function(t){ t.addEventListener('click', function(){ showTab(t.dataset.stTab); }); });

            /* Ouvre le bon onglet selon le hash / le succès du serveur */
            var hashMap = { compte: 'securite', securite: 'securite', langue: 'preferences', paiement: 'paiement' };
            var successParam = !{JSON.stringify(success || '')};
            var h = (location.hash || '').replace('#','');
            if (hashMap[h]) showTab(hashMap[h]);
            else if (successParam === 'email' || successParam === 'password') showTab('securite');
            else if (successParam === 'language') showTab('preferences');

            /* ── Sélection visuelle des langues ──────────────────────────── */
            document.querySelectorAll('.st-lang input').forEach(function(inp) {
                inp.addEventListener('change', function() {
                    document.querySelectorAll('.st-lang').forEach(function(l){ l.classList.remove('is-active'); });
                    inp.closest('.st-lang').classList.add('is-active');
                });
            });

            /* ── Ajouter une carte (backend à venir) ─────────────────────── */
            var addBtn = document.getElementById('addCardBtn');
            var note   = document.getElementById('addCardNote');
            if (addBtn && note) addBtn.addEventListener('click', function() { note.style.display = 'flex'; });

            /* ── Téléphone : indicatif + numéro (chiffres uniquement) ─────── */
            (function () {
                var prefixes = ['+32','+33','+352','+31','+49','+44','+34','+39','+41','+212','+1'];
                var prefixSel  = document.getElementById('phonePrefix');
                var phoneLocal = document.getElementById('phoneLocal');
                var phoneHidden = document.getElementById('phone');
                if (!prefixSel || !phoneLocal || !phoneHidden) return;

                var stored = !{JSON.stringify(client.phone || '')};
                var detected = '+32', localPart = stored;
                for (var i = 0; i < prefixes.length; i++) {
                    if (stored.indexOf(prefixes[i]) === 0) { detected = prefixes[i]; localPart = stored.slice(prefixes[i].length).trim(); break; }
                }
                prefixSel.value = detected;
                phoneLocal.value = localPart.replace(/[^\d]/g, '');
                phoneHidden.value = stored || '';

                function sync() {
                    var local = phoneLocal.value.replace(/[^\d]/g, '');
                    phoneHidden.value = local ? prefixSel.value + local : '';
                }
                phoneLocal.addEventListener('input', function () {
                    var cleaned = this.value.replace(/[^\d]/g, '');
                    if (this.value !== cleaned) this.value = cleaned;
                    sync();
                });
                prefixSel.addEventListener('change', sync);
                sync();

                /* Sélecteur de drapeau */
                var wrap = document.getElementById('phonePrefixWrap');
                var btn  = document.getElementById('phonePrefixBtn');
                var menu = document.getElementById('phonePrefixMenu');
                var flagImg = document.getElementById('phonePrefixFlag');
                var codeEl  = document.getElementById('phonePrefixCode');
                if (!wrap || !btn || !menu) return;
                function setValue(prefix, flag, dispatch) {
                    prefixSel.value = prefix;
                    if (flag) flagImg.src = flag;
                    codeEl.textContent = prefix;
                    menu.querySelectorAll('.phone-flag-option').forEach(function (o) { o.classList.toggle('is-selected', o.dataset.prefix === prefix); });
                    if (dispatch) sync();
                }
                function close() { menu.classList.remove('is-open'); btn.setAttribute('aria-expanded', 'false'); }
                btn.addEventListener('click', function (e) { e.stopPropagation(); var open = menu.classList.toggle('is-open'); btn.setAttribute('aria-expanded', open ? 'true' : 'false'); });
                menu.querySelectorAll('.phone-flag-option').forEach(function (o) { o.addEventListener('click', function () { setValue(o.dataset.prefix, o.dataset.flag, true); close(); }); });
                document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) close(); });
                var opt = menu.querySelector('.phone-flag-option[data-prefix="' + detected + '"]');
                setValue(detected, opt ? opt.dataset.flag : '/images/flags/be.png', false);
            })();
        })();
