extends ../../layouts/index

block links
    link(rel="stylesheet", href="/css/layouts/client-auth.css")

block content
    .client-auth
        .client-auth__card
            .client-auth__header
                h1 Créer un compte
                p Gérez vos rendez-vous depuis un seul endroit.

            if error
                .client-auth__error= error

            form.client-auth__form(method="POST" action="/client/register")
                .form-group
                    label Nom complet *
                    input.input(type="text" name="fullName" placeholder="Jean Dupont" required autocomplete="name")
                .form-group
                    label Email *
                    input.input(type="email" name="email" placeholder="votre@email.com" required autocomplete="email")
                .form-group
                    label Téléphone (optionnel)
                    input.input(type="tel" name="phone" placeholder="+33 6 12 34 56 78" autocomplete="tel")
                .form-group
                    label Mot de passe *
                    input.input(type="password" name="password" placeholder="8 caractères minimum" required autocomplete="new-password")
                .form-group
                    label Confirmer le mot de passe *
                    input.input(type="password" name="confirmPassword" placeholder="••••••••" required autocomplete="new-password")

                button.btn(type="submit")
                    span Créer mon compte

            .client-auth__footer
                p Déjà un compte ?
                    a(href="/client/login")  Se connecter
