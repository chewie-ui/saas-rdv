extends ../../layouts/index

block links
    link(rel="stylesheet", href="/css/layouts/client-auth.css")

block content
    .client-auth
        .client-auth__card

            //- ── Logo + heading ────────────────────────────────────
            .client-auth__header
                a.client-auth__logo(href="/")
                    img.client-auth__logo-mark(src="/images/icon.svg" alt="BranShee")
                    span BranShee
                h1 Créer un compte
                p Accédez à vos rendez-vous en quelques secondes.

            if error
                .client-auth__error= error

            //- ── Google SSO ────────────────────────────────────────
            a.auth-social-btn(href="/auth/google/client")
                svg(width="16" height="16" viewBox="0 0 48 48")
                    path(fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8a12 12 0 1 1 0-24c3.1 0 5.8 1.2 7.9 3l5.7-5.7A20 20 0 1 0 24 44c11 0 20-9 20-20 0-1.3-.1-2.6-.4-3.9z")
                    path(fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3l5.7-5.7A20 20 0 0 0 6.3 14.7z")
                    path(fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2A12 12 0 0 1 12.7 28L6.2 33A20 20 0 0 0 24 44z")
                    path(fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z")
                span Continuer avec Google

            .client-auth__divider
                hr
                span OU
                hr

            //- ── Registration form ─────────────────────────────────
            form.client-auth__form(method="POST" action="/client/register")
                .form-group
                    label Nom complet
                    input.input(
                        type="text"
                        name="fullName"
                        placeholder="Jean Dupont"
                        required
                        autocomplete="name"
                    )
                .form-group
                    label Email
                    input.input(
                        type="email"
                        name="email"
                        placeholder="votre@email.com"
                        required
                        autocomplete="email"
                    )
                .form-group
                    label Téléphone (optionnel)
                    input.input(
                        type="tel"
                        name="phone"
                        placeholder="+33 6 12 34 56 78"
                        autocomplete="tel"
                    )
                .form-group
                    label Mot de passe
                    input.input(
                        type="password"
                        name="password"
                        placeholder="8 caractères minimum"
                        required
                        autocomplete="new-password"
                        minlength="8"
                    )
                .form-group
                    label Confirmer le mot de passe
                    input.input(
                        type="password"
                        name="confirmPassword"
                        placeholder="••••••••"
                        required
                        autocomplete="new-password"
                    )

                label.client-auth__terms-row
                    input(type="checkbox" name="terms" required style="accent-color:var(--accent)")
                    span.client-auth__terms-text
                        | J'accepte les
                        a(href="/conditions-utilisation")  conditions d'utilisation
                        |  et la
                        a(href="/confidentialite")  politique de confidentialité
                        | .

                button.sm-btn.sm-btn--primary(type="submit")
                    span Créer mon compte

            .client-auth__footer
                p Déjà un compte ?
                    a(href="/client/login")  Se connecter
                p.client-auth__pro-link Vous êtes un professionnel ?
                    a(href="/login")  Connexion pro
