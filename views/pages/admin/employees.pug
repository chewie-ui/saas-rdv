extends ../../layouts/admin

block links
    link(rel="stylesheet" href="/css/layouts/services.css")
    link(rel="stylesheet" href="/css/layouts/employees.css")

block content
    .employees-page
        .employees-page__header
            .employees-page__header-left
                h2= t.employees.title
                p.employees-page__subtitle= t.employees.subtitle
            .employees-page__header-right
                if maxEmployees > 0
                    span.employees-counter#empCounter #{employees.length} / #{maxEmployees}
                if employees.length > 0 && maxEmployees > 0
                    button.sm-btn.sm-btn--ghost#deactivateAllEmpBtn
                        span.material-symbols-outlined block
                        span= t.employees.deactivate_all || 'Désactiver tout'
                    button.sm-btn.sm-btn--soft#activateAllEmpBtn
                        span.material-symbols-outlined check_circle
                        span= t.employees.activate_all || 'Activer tout'


        //- ── Plan limit banner ────────────────────────────────────
        - var empAtLimit = maxEmployees > 0 && employees.length >= maxEmployees
        if currentPlan === 'pro' && maxEmployees > 0
            .plan-gate#employeeLimitBanner(style=!empAtLimit ? 'display:none' : '')
                span.plan-gate__lock 🔒
                .plan-gate__body
                    strong.plan-gate__title Limite Pro atteinte — #{maxEmployees}/#{maxEmployees} employés
                    span.plan-gate__sub Disponible uniquement dans le plan Business.
                a.btn-upgrade-business.plan-gate__cta(href="/subscription") Passer au Business →
        else if currentPlan === 'business' && maxEmployees > 0
            .plan-gate#employeeLimitBanner(style=!empAtLimit ? 'display:none' : '')
                span.plan-gate__lock 🔒
                .plan-gate__body
                    strong.plan-gate__title Limite maximale atteinte — #{maxEmployees}/#{maxEmployees} employés
                    span.plan-gate__sub Vous avez atteint la limite de votre plan Business.

        if employees.length === 0
            .employees-empty
                span.material-symbols-outlined(style=`font-size:48px`) groups
                p= t.employees.empty
                if maxEmployees === 0
                    .plan-gate
                        span.plan-gate__lock 🔒
                        .plan-gate__body
                            strong.plan-gate__title Gestion des employés
                            span.plan-gate__sub Disponible uniquement dans les plans Pro & Business.
                        a.btn-upgrade-pro.plan-gate__cta(href="/subscription") Passer au Pro →

        .employees-list#employeesList
            - var activeIdx = 0
            each emp, empIdx in employees
                -
                    var initials = ((emp.firstName || '?')[0] + (emp.lastName || '?')[0]).toUpperCase()
                    var isOwner = emp.role === 'owner' || emp.isOwner
                    // Un employé est "en surnombre" s'il est actif ET que son rang dépasse la limite
                    if (emp.active) { activeIdx++; }
                    var isOverLimit = maxEmployees > 0 && emp.active && activeIdx > maxEmployees
                .emp-card(
                    data-id=String(emp._id)
                    class=[(!emp.active ? 'emp-card--inactive' : ''), (isOverLimit ? 'emp-card--over-limit' : '')]
                    data-over-limit=isOverLimit ? 'true' : 'false'
                )

                    //- ── Top: avatar + owner badge ─────────────────────
                    .emp-card__top
                        if emp.profilePicture && emp.profilePicture !== '/images/no-user.webp'
                            .emp-card__photo
                                img(src=emp.profilePicture alt=`${emp.firstName} ${emp.lastName}`)
                                label.emp-photo-overlay(for=`photoInput-${emp._id}` title=t.employees.change_photo_title)
                                    span.material-symbols-outlined photo_camera
                                input.emp-photo-input(type="file" id=`photoInput-${emp._id}` accept="image/*" data-id=String(emp._id))
                        else
                            .emp-card__avatar(class=isOwner ? 'emp-card__avatar--primary' : '')= initials
                        if isOwner
                            span.emp-card__badge-owner Owner

                    //- ── Name + role ───────────────────────────────────
                    .emp-card__info
                        .emp-card__name= `${emp.firstName} ${emp.lastName}`
                        if emp.description
                            .emp-card__role= emp.description
                        else if emp.age
                            .emp-card__role #{emp.age} #{t.employees.age_suffix}

                    hr.emp-card__divider

                    //- ── Actions: toggle + edit + delete ───────────────
                    .emp-card__actions
                        if isOverLimit
                            //- Employé en surnombre : badge + bouton swap + supprimer
                            span.emp-over-badge= t.employees.over_limit_badge
                            button.sm-btn.sm-btn--soft.emp-swap-btn(
                                type="button"
                                data-id=String(emp._id)
                                data-name=`${emp.firstName} ${emp.lastName}`
                                title=t.employees.swap_title
                            )= t.employees.swap_btn
                        else
                            label.sa-toggle(title=(emp.active ? t.employees.deactivate : t.employees.activate))
                                input.toggle-emp-active(type="checkbox" checked=emp.active data-id=String(emp._id))
                                .sa-toggle__track
                            button.sm-btn.sm-btn--ghost.edit-emp-btn(
                                data-id=String(emp._id)
                                title=t.employees.modal_edit
                                data-firstname=emp.firstName
                                data-lastname=emp.lastName
                                data-age=(emp.age || '')
                                data-desc=(emp.description || ''))
                                span.material-symbols-outlined edit
                                span= t.employees.modal_edit || 'Modifier'
                        button.delete-emp-btn(data-id=String(emp._id) title=t.employees.delete_title data-confirm=t.employees.delete_confirm)
                            span.material-symbols-outlined(style=`color:#ef4444`) delete

            //- ── Invite card ───────────────────────────────────────────
            button.emp-card.emp-card--invite#addEmpBtn(type="button" class=(maxEmployees === 0) ? 'emp-card--locked-invite' : '')
                .emp-invite__icon
                    if maxEmployees === 0
                        span.material-symbols-outlined lock
                    else
                        span.material-symbols-outlined add
                .emp-invite__title #{t.employees.add_btn || 'Ajouter un employé'}
                if maxEmployees === 0
                    .emp-invite__upgrade
                        a.btn-upgrade-pro(href="/subscription") Passer au Pro
                else if employees.length >= maxEmployees
                    p.emp-invite__desc= t.employees.invite_limit_desc
                else
                    p.emp-invite__desc= t.employees.invite_desc

    //- ── Modal : Créer / Modifier un employé ────────────────────────────────────
    .modal-overlay#empModalOverlay
    .service-modal#empModal
        .service-modal__header
            h3#empModalTitle= t.employees.modal_new
            button.modal-close#closeEmpModal.btn--icon
                span.material-symbols-outlined close
        .service-modal__body
            input(type="hidden" id="empModalId")
            //- Photo upload
            .emp-modal__photo-row
                .emp-modal__photo-preview
                    img#empModalPhotoPreview(src="/images/no-user.webp" alt="Photo")
                .emp-modal__photo-info
                    button.sm-btn.sm-btn--ghost#empModalPhotoBtn
                        span
                            span.material-symbols-outlined photo_camera
                            | #{t.employees.photo_btn}
                    input#empModalPhotoInput(type="file" accept="image/*" style="display:none")
                    p.xs-comment= t.employees.photo_hint
            .field-row
                .field
                    label= t.employees.firstname
                    input.input#empModalFirstName(placeholder="Jean" maxlength="40")
                .field
                    label= t.employees.lastname
                    input.input#empModalLastName(placeholder="Dupont" maxlength="40")
            .field-row
                .field
                    label= t.employees.age
                    input.input#empModalAge(type="number" min="16" max="100" maxlength="3" placeholder="Ex: 28")
            .field
                label= t.employees.desc
                textarea.textarea#empModalDesc(placeholder="Spécialités, expérience..." rows=3 maxlength="300")
        .service-modal__footer
            button.sm-btn.sm-btn--ghost#cancelEmpModal
                span= t.employees.cancel
            button.sm-btn.sm-btn--primary#saveEmpBtn
                span= t.employees.save

    //- Pass data to JS
    script.
        window.__empDeleteConfirm = !{JSON.stringify(t.employees.delete_confirm)};
        window.__empModalNew = !{JSON.stringify(t.employees.modal_new)};
        window.__empModalEdit = !{JSON.stringify(t.employees.modal_edit)};
        window.__maxEmployees = !{maxEmployees || 0};
        window.__empCount = !{employees.length || 0};

block scripts
    script(src="/js/utils/confirm-modal.js")
    script(src="/js/utils/image-upload.js")
    script(src="/js/layouts/employees.js")
    script.
        // ── Swap : activer un employé en surnombre en remplaçant un autre ────────
        document.querySelectorAll('.emp-swap-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var swapId   = this.dataset.id;
                var swapName = this.dataset.name;

                // Collecter les employés actifs dans la limite (pas over-limit)
                var activeCards = Array.from(document.querySelectorAll('.emp-card:not(.emp-card--over-limit):not(.emp-card--inactive):not(.emp-card--invite)'));
                if (!activeCards.length) return;

                // Construire le modal de sélection
                var existing = document.getElementById('__swapModal');
                if (existing) existing.remove();

                var items = activeCards.map(function(card) {
                    var id   = card.dataset.id;
                    var name = card.querySelector('.emp-card__name') ? card.querySelector('.emp-card__name').textContent.trim() : id;
                    return '<label style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:9px;border:1.5px solid var(--border-light);cursor:pointer;transition:border-color .12s,background .12s;">' +
                        '<input type="radio" name="swapTarget" value="' + id + '" style="accent-color:var(--accent)">' +
                        '<span style="font-size:14px;font-weight:600;">' + name + '</span>' +
                        '</label>';
                }).join('');

                var overlay = document.createElement('div');
                overlay.id = '__swapModal';
                overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.45);backdrop-filter:blur(4px);z-index:99999;display:flex;align-items:center;justify-content:center;padding:16px;';
                overlay.innerHTML = '<div style="background:#fff;border-radius:20px;max-width:400px;width:100%;box-shadow:0 24px 48px rgba(0,0,0,.2);padding:28px 28px 24px;display:flex;flex-direction:column;gap:18px;">' +
                    '<div><p style="font-size:16px;font-weight:700;color:var(--ink);margin:0 0 6px">Choisir un remplaçant</p>' +
                    '<p style="font-size:13px;color:var(--text-muted);margin:0">Quel employé actif désactiver pour activer <strong>' + swapName + '</strong> ?</p></div>' +
                    '<div style="display:flex;flex-direction:column;gap:8px;" id="__swapList">' + items + '</div>' +
                    '<div style="display:flex;gap:8px;justify-content:flex-end;">' +
                    '<button id="__swapCancel" style="height:38px;padding:0 18px;border-radius:8px;border:1.5px solid var(--border-medium);background:var(--surface);font-size:13.5px;font-weight:600;cursor:pointer;font-family:inherit;">Annuler</button>' +
                    '<button id="__swapConfirm" style="height:38px;padding:0 18px;border-radius:8px;border:none;background:var(--accent);color:#fff;font-size:13.5px;font-weight:700;cursor:pointer;font-family:inherit;">Confirmer</button>' +
                    '</div></div>';

                document.body.appendChild(overlay);

                overlay.querySelector('#__swapCancel').onclick = function() { overlay.remove(); };
                overlay.addEventListener('click', function(e) { if (e.target === overlay) overlay.remove(); });

                overlay.querySelector('#__swapConfirm').onclick = async function() {
                    var chosen = overlay.querySelector('input[name="swapTarget"]:checked');
                    if (!chosen) { alert('Choisissez un employé à remplacer.'); return; }
                    var deactivateId = chosen.value;

                    this.disabled = true;
                    this.textContent = '…';

                    try {
                        // Désactiver le choix
                        await fetch('/employees/' + deactivateId + '/toggle', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ active: false })
                        });
                        // Activer le surnombre
                        await fetch('/employees/' + swapId + '/toggle', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ active: true })
                        });
                        overlay.remove();
                        window.location.reload();
                    } catch(e) {
                        alert('Erreur lors de l\'échange.');
                        this.disabled = false;
                        this.textContent = 'Confirmer';
                    }
                };
            });
        });
