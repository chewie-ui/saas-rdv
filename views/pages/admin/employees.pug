extends ../../layouts/admin

block links
    link(rel="stylesheet" href="/css/layouts/services.css")
    link(rel="stylesheet" href="/css/layouts/employees.css")

block content
    .employees-page
        .employees-page__header
            .employees-page__header-left
                h2= t.employees.title
                p.employees-page__subtitle= t.employees.subtitle
            .employees-page__header-right
                if employees.length > 0
                    button.btn.secondary#deactivateAllEmpBtn
                        span
                            svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z")
                            | #{t.employees.deactivate_all || 'Désactiver tout'}
                    button.btn#activateAllEmpBtn
                        span
                            svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                path(d="m424-312 282-282-56-56-226 226-114-114-56 56 170 170Zm56 232q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z")
                            | #{t.employees.activate_all || 'Activer tout'}
                button.btn#addEmpBtn
                    span
                        svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                            path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                        | #{t.employees.add_btn}

        if employees.length === 0
            .employees-empty
                svg(xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="currentColor")
                    path(d="M40-160v-112q0-34 17.5-62.5T104-378q62-31 126-46.5T360-440q66 0 130 15.5T616-378q29 15 46.5 43.5T680-272v112H40Zm720 0v-120q0-44-24.5-84.5T666-434q51 6 96 20.5t84 35.5q36 20 55 44.5t19 53.5v120H760ZM360-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113T360-480Zm400-160q0 66-47 113t-113 47q-11 0-28-2.5t-28-5.5q27-32 41.5-71t14.5-81q0-42-14.5-81T544-792q14-5 28-6.5t28-1.5q66 0 113 47t47 113Z")
                p= t.employees.empty

        .employees-list#employeesList
            each emp in employees
                .emp-card(data-id=String(emp._id) class=(!emp.active ? 'emp-card--inactive' : ''))
                    .emp-card__left
                        .emp-card__photo
                            img(src=emp.profilePicture alt=`${emp.firstName} ${emp.lastName}`)
                            label.emp-photo-overlay(for=`photoInput-${emp._id}` title="Changer la photo")
                                svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                    path(d="M480-260q75 0 127.5-52.5T660-440q0-75-52.5-127.5T480-620q-75 0-127.5 52.5T300-440q0 75 52.5 127.5T480-260Zm0-80q-42 0-71-29t-29-71q0-42 29-71t71-29q42 0 71 29t29 71q0 42-29 71T480-340ZM160-120q-33 0-56.5-23.5T80-200v-480q0-33 23.5-56.5T160-760h126l74-80h240l74 80h126q33 0 56.5 23.5T880-680v480q0 33-23.5 56.5T800-120H160Z")
                                input.emp-photo-input(type="file" id=`photoInput-${emp._id}` accept="image/*" data-id=String(emp._id))
                    .emp-card__body
                        .emp-card__name-row
                            h3.emp-card__name= `${emp.firstName} ${emp.lastName}`
                            if emp.age
                                span.badge.badge--age #{emp.age} ans
                        if emp.description
                            p.emp-card__desc= emp.description
                    .emp-card__actions
                        label.sa-toggle(title=(emp.active ? t.employees.deactivate : t.employees.activate))
                            input.toggle-emp-active(type="checkbox" checked=emp.active data-id=String(emp._id))
                            .sa-toggle__track
                        button.btn.btn--icon.edit-emp-btn(data-id=String(emp._id) title=t.employees.modal_edit
                            data-firstname=emp.firstName data-lastname=emp.lastName
                            data-age=(emp.age || '') data-desc=(emp.description || ''))
                            svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                path(d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Z")
                        button.btn.btn--icon.btn--danger.delete-emp-btn(data-id=String(emp._id) title="Supprimer" data-confirm=t.employees.delete_confirm)
                            svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                path(d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-272h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z")

    //- ── Modal : Créer / Modifier un employé ────────────────────────────────────
    .modal-overlay#empModalOverlay
    .service-modal#empModal
        .service-modal__header
            h3#empModalTitle= t.employees.modal_new
            button.modal-close#closeEmpModal.btn--icon
                svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                    path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
        .service-modal__body
            input(type="hidden" id="empModalId")
            //- Photo upload
            .emp-modal__photo-row
                .emp-modal__photo-preview
                    img#empModalPhotoPreview(src="/images/no-user.webp" alt="Photo")
                .emp-modal__photo-info
                    button.btn.secondary.btn--sm#empModalPhotoBtn
                        span
                            svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                path(d="M480-260q75 0 127.5-52.5T660-440q0-75-52.5-127.5T480-620q-75 0-127.5 52.5T300-440q0 75 52.5 127.5T480-260Zm0-80q-42 0-71-29t-29-71q0-42 29-71t71-29q42 0 71 29t29 71q0 42-29 71T480-340ZM160-120q-33 0-56.5-23.5T80-200v-480q0-33 23.5-56.5T160-760h126l74-80h240l74 80h126q33 0 56.5 23.5T880-680v480q0 33-23.5 56.5T800-120H160Z")
                            | #{t.employees.photo_btn}
                    input#empModalPhotoInput(type="file" accept="image/*" style="display:none")
                    p.xs-comment= t.employees.photo_hint
            .field-row
                .field
                    label= t.employees.firstname
                    input.input#empModalFirstName(placeholder="Jean")
                .field
                    label= t.employees.lastname
                    input.input#empModalLastName(placeholder="Dupont")
            .field-row
                .field
                    label= t.employees.age
                    input.input#empModalAge(type="number" min="16" max="100" placeholder="Ex: 28")
            .field
                label= t.employees.desc
                textarea.textarea#empModalDesc(placeholder="Spécialités, expérience..." rows=3)
        .service-modal__footer
            button.btn.secondary#cancelEmpModal
                span= t.employees.cancel
            button.btn#saveEmpBtn
                span= t.employees.save

    //- Pass delete confirm message to JS
    script.
        window.__empDeleteConfirm = !{JSON.stringify(t.employees.delete_confirm)};
        window.__empModalNew = !{JSON.stringify(t.employees.modal_new)};
        window.__empModalEdit = !{JSON.stringify(t.employees.modal_edit)};

block scripts
    script(src="/js/layouts/employees.js")
