extends ../../layouts/admin

block content
    .welcome-page
        .welcome-hero
            .welcome-hero__emoji 🎉
            h1.welcome-hero__title= t.onboarding.hero_title.replace('{name}', user.fullName.split(' ')[0])
            p.welcome-hero__sub On va configurer votre établissement ensemble — on vous montre exactement où cliquer, étape par étape. Ça prend moins de 5 minutes.

        .welcome-cta-group
            button.sm-btn.sm-btn--primary.welcome-cta-main#startTourBtn(type="button")
                span.material-symbols-outlined(style=`font-size:18px`) play_arrow
                | Commencer la visite guidée
            a.welcome-cta-skip(href="/appointment") Plus tard, j'irai directement à mon tableau de bord →

        .welcome-tip
            span.material-symbols-outlined(style=`font-size:16px`) info
            span On vous guidera dans vos disponibilités, vos services, puis la personnalisation de votre page. Vous pourrez ignorer le tutoriel à tout moment.

    style.
        .welcome-page { max-width: 560px; margin: 0 auto; padding: 60px 20px 80px; display: flex; flex-direction: column; gap: 28px; }
        .welcome-hero { text-align: center; }
        .welcome-hero__emoji { font-size: 48px; margin-bottom: 10px; }
        .welcome-hero__title { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 800; color: var(--ink); letter-spacing: -.02em; margin: 0 0 10px; }
        .welcome-hero__sub { font-size: 15px; color: var(--text-muted); margin: 0; line-height: 1.6; }
        .welcome-cta-group { display: flex; flex-direction: column; align-items: center; gap: 12px; }
        .welcome-cta-main { font-size: 16px; padding: 14px 32px; gap: 10px; }
        .welcome-cta-skip { font-size: 13px; color: var(--text-muted); text-decoration: none; }
        .welcome-cta-skip:hover { color: var(--text-primary); text-decoration: underline; }
        .welcome-tip { display: flex; align-items: center; justify-content: center; gap: 7px; font-size: 13px; color: var(--text-muted); background: var(--accent-soft); border: 1px solid var(--accent-border); border-radius: 10px; padding: 10px 16px; text-align: left; }
        .welcome-tip .material-symbols-outlined { color: var(--accent); flex-shrink: 0; }

block scripts
    script.
        document.getElementById('startTourBtn').addEventListener('click', function () {
            if (window.BkTour) window.BkTour.start();
        });
