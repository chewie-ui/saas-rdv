extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/components/admin/book.admin.css")


block content
    -
        // "Passé" doit tenir compte de l'heure, pas juste du jour — sinon un
        // RDV aujourd'hui à 13h reste considéré "à venir" jusqu'au lendemain,
        // et le bouton "Client absent" ne peut jamais apparaître le jour même.
        var isPast = false
        if (client.endTime) {
            var _endParts = client.endTime.split(':').map(Number)
            var _endDt = new Date(client.date)
            _endDt.setHours(_endParts[0], _endParts[1] || 0, 0, 0)
            isPast = _endDt < new Date()
        } else {
            isPast = new Date(client.date) < new Date(new Date().setHours(0,0,0,0))
        }

    .page.page--appointment
        .appointment-header.page--appointment-block.page--block-1
            .appointment-header__top
                .appointment-header__top-name
                    h3 #{t.book_detail.title_prefix}#{client._id}
                .appointment-header__top-actions.flex
                    if !isPremium
                        a.btn-upgrade-pro(href="/subscription") Passer au Pro

                    if isPast
                        span.badge-past= t.book_detail.past

                    if client.status === "confirmed"
                        button.sm-btn.sm-btn--ghost.appointment-action(data-link=`/appointment/${client._id}/cancel` data-method="PATCH" disabled=(grade === 'staff' || !isPremium || isPast))#cancelAppointment
                            span= t.book_detail.cancel
                    button.sm-btn.sm-btn--danger.appointment-action(data-link=`/appointment/${client._id}/delete` data-method="DELETE" disabled=(grade === 'staff' || !isPremium))#deleteAppointment
                        svg(viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            polyline(points="3 6 5 6 21 6")
                            path(d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6")
                        span= t.book_detail.delete
                    if client.status === "confirmed"
                        //- button(data-link=`/appointment/${user._id}/send-reminder`).btn.appointment-action Send reminder
                    else
                        button.sm-btn.sm-btn--ghost.appointment-action(data-link=`/appointment/${client._id}/restore` data-method="PATCH" disabled=(grade === 'staff' || isPast))#restoreAppointment= t.book_detail.restore

                    -
                        var hasOnlinePayment = client.payment && client.payment.method === 'online'
                        var canChargeNoShow = hasOnlinePayment && (client.payment.status === 'authorized' || client.payment.status === 'paid') && (client.payment.stripePaymentMethodId || client.payment.status === 'paid')
                    if isPast && client.status === 'confirmed' && !client.noShow
                        .noshow-wrap
                            button.sm-btn.sm-btn--danger#noShowBtn(type="button")
                                svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                    circle(cx="12" cy="12" r="10")
                                    line(x1="12" y1="8" x2="12" y2="12")
                                    line(x1="12" y1="16" x2="12.01" y2="16")
                                span Client absent
                            .noshow-choices#noShowChoices(style="display:none")
                                p.noshow-choices__title Quelle est la raison de l'absence ?
                                button.sm-btn.sm-btn--soft#noShowValid(type="button" data-reason="valid")
                                    span Raison valable (gratuit)
                                if canChargeNoShow
                                    button.sm-btn.sm-btn--danger#noShowInvalid(type="button" data-reason="invalid" data-amount=(client.payment.amount || 0))
                                        span Raison non valable (encaisser #{client.payment.amount}€)
                                else
                                    button.sm-btn.sm-btn--danger#noShowInvalid(type="button" data-reason="invalid")
                                        span Raison non valable
                                button.sm-btn.sm-btn--ghost#noShowCancel(type="button") Annuler
                    if client.noShow
                        .noshow-badge(class=client.noShowReason === 'invalid' ? 'noshow-badge--charged' : 'noshow-badge--free')
                            svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                circle(cx="12" cy="12" r="10")
                                line(x1="12" y1="8" x2="12" y2="12")
                                line(x1="12" y1="16" x2="12.01" y2="16")
                            span= client.noShowReason === 'invalid' ? 'Client absent — frais prélevés' : 'Client absent — sans frais'

                    //- ── Revue des frais d'annulation prélevés automatiquement (< 24h/12h) ──
                    if client.status === 'canceled' && client.payment && client.payment.status === 'penalty' && !client.payment.cancellationReviewDecision
                        - var penaltyAmt = client.payment.penaltyAmount || client.payment.amount
                        .noshow-wrap
                            button.sm-btn.sm-btn--danger#cancelReviewBtn(type="button")
                                svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                    circle(cx="12" cy="12" r="10")
                                    line(x1="12" y1="8" x2="12" y2="12")
                                    line(x1="12" y1="16" x2="12.01" y2="16")
                                span Frais d'annulation prélevés (#{penaltyAmt}€)
                            .noshow-choices#cancelReviewChoices(style="display:none")
                                p.noshow-choices__title Le client a annulé tardivement, #{penaltyAmt}€ ont été prélevés automatiquement. Raison valable ?
                                button.sm-btn.sm-btn--soft#cancelReviewRefund(type="button")
                                    span Raison valable (rembourser le client)
                                button.sm-btn.sm-btn--danger#cancelReviewKeep(type="button")
                                    span Raison non valable (garder les frais)
                                button.sm-btn.sm-btn--ghost#cancelReviewCancel(type="button") Annuler
                    if client.payment && client.payment.cancellationReviewDecision
                        .noshow-badge(class=client.payment.cancellationReviewDecision === 'refunded' ? 'noshow-badge--free' : 'noshow-badge--charged')
                            svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                circle(cx="12" cy="12" r="10")
                                line(x1="12" y1="8" x2="12" y2="12")
                                line(x1="12" y1="16" x2="12.01" y2="16")
                            span= client.payment.cancellationReviewDecision === 'refunded' ? 'Annulation tardive — frais remboursés' : 'Annulation tardive — frais conservés'

            .appointment-header__bottom.flex.col
                .appointment-header__bottom-col.flex.col
                    .appointment-header__bottom-col-element.flex
                        p.name-element= t.book_detail.date
                        p= client.date.toLocaleDateString("fr-FR")
                .appointment-header__bottom-col.flex.col
                    .appointment-header__bottom-col-element.flex
                        p.name-element= t.book_detail.schedule
                        p #{client.startTime} - #{client.endTime}
                .appointment-header__bottom-col.flex.col
                    .appointment-header__bottom-col-element.flex
                        p.name-element= t.book_detail.status
                        p(class=isPast && client.status === 'confirmed' ? 'status-past' : '') #{client.status.charAt(0).toUpperCase() + client.status.slice(1)}
                if client.serviceName
                    .appointment-header__bottom-col.flex.col
                        .appointment-header__bottom-col-element.flex
                            p.name-element= t.book_detail.service || 'Service'
                            .book-service-badge
                                svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                    path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z")
                                p= client.serviceName
                if employees && employees.length > 0
                    - var currentEmpId = client.employee ? String(client.employee._id) : ''
                    .appointment-header__bottom-col.flex.col
                        .appointment-header__bottom-col-element.flex
                            p.name-element= t.book_detail.employee || 'Employé'
                        .book-emp-change-row
                            select#bookEmpSelect.input.book-emp-select
                                option(value="") — #{t.book_detail.no_employee || 'Aucun employé'} —
                                each emp in employees
                                    - var empId = String(emp._id)
                                    option(value=empId selected=(currentEmpId === empId))= emp.firstName + ' ' + emp.lastName
                            button#bookEmpSave.sm-btn.sm-btn--primary(type="button")
                                span= t.book_detail.save || 'Sauvegarder'
                            span#bookEmpSaved.admin-notes__saved(style="display:none")= t.book_detail.saved || '✓ Sauvegardé'
                else if client.employee
                    .appointment-header__bottom-col.flex.col
                        .appointment-header__bottom-col-element.flex
                            p.name-element= t.book_detail.employee || 'Employé'
                            .book-employee-badge
                                img.book-emp-photo(src=client.employee.profilePicture || '/images/no-user.webp' alt="" aria-hidden="true")
                                p= client.employee.firstName + ' ' + client.employee.lastName
                else if client.employeeName
                    .appointment-header__bottom-col.flex.col
                        .appointment-header__bottom-col-element.flex
                            p.name-element= t.book_detail.employee || 'Employé'
                            .book-employee-badge
                                p= client.employeeName

        if client.formAnswers && client.formAnswers.length > 0
            .appointment-details.appointment-details__form-answers.page--appointment-block.page--block-2
                .appointment-details__header.flex
                    svg(xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3")
                        path(d="M280-600q-17 0-28.5-11.5T240-640q0-17 11.5-28.5T280-680h400q17 0 28.5 11.5T720-640q0 17-11.5 28.5T680-600H280Zm0 160q-17 0-28.5-11.5T240-480q0-17 11.5-28.5T280-520h400q17 0 28.5 11.5T720-480q0 17-11.5 28.5T680-440H280Zm0 160q-17 0-28.5-11.5T240-320q0-17 11.5-28.5T280-360h200q17 0 28.5 11.5T520-320q0 17-11.5 28.5T480-280H280ZM160-80q-33 0-56.5-23.5T80-160v-640q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v640q0 33-23.5 56.5T800-80H160Zm0-80h640v-640H160v640Zm0 0v-640 640Z")
                    h3= t.book_detail.form_answers
                .appointment-details__separator
                .appointment-details__body
                    .form-answers-grid
                        each answer in client.formAnswers
                            .form-answer-row
                                .form-answer-row__question= answer.question
                                .form-answer-row__answer= answer.answer || ('— ' + t.book_detail.no_answer)

        .appointment-details.appointment-details__client.page--appointment-block.page--block-3
            .appointment-details__header.flex
                svg(
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    )
                    path(d="M0 0h24v24H0V0z" fill="none")
                    path(d="M12 6c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2m0 10c2.7 0 5.8 1.29 6 2H6c.23-.72 3.31-2 6-2m0-12C9.79 4 8 5.79 8 8s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 10c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z")
                h3= t.book_detail.client
            .appointment-details__separator
            .appointment-details__body
                .client-details.flex.col
                    .client-details__main.flex
                        .client-details__main-picture
                            - var picSrc = (client.clientRef && client.clientRef.profilePicture) ? client.clientRef.profilePicture : (client.profilePicture ? '/images' + client.profilePicture : '/images/no-user.webp')
                            img(src=picSrc alt="user picture")
                        .client-details__main-locals.flex.col.space-b
                            h4 #{client.surname} #{client.name}
                            p= client.email
                            p= client.phone
                    if client.clientRef
                        .client-account-badge
                            svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                path(d="M234-276q51-39 114-61.5T480-360q69 0 132 22.5T726-276q35-41 54.5-93T800-480q0-133-93.5-226.5T480-800q-133 0-226.5 93.5T160-480q0 59 19.5 111t54.5 93Zm246-164q-59 0-99.5-40.5T340-580q0-59 40.5-99.5T480-720q59 0 99.5 40.5T620-580q0 59-40.5 99.5T480-440Zm0 360q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                            span Compte client lié
                            span.client-account-badge__name= client.clientRef.fullName || client.clientRef.email

        .appointment-details.appointment-details__notes.page--appointment-block.page--block-3
            .appointment-details__header.flex
                svg(xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3")
                    path(d="M120-240v-80h480v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z")
                h3= t.book_detail.notes_client
            .appointment-details__separator
            .appointment-details__body
                p= client.message || '—'

        .appointment-details.appointment-details__admin-notes.page--appointment-block.page--block-3
            .appointment-details__header.flex
                svg(xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3")
                    path(d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z")
                h3= t.book_detail.notes_coach
            .appointment-details__separator
            .appointment-details__body
                textarea#adminNotesInput.textarea(placeholder=t.book_detail.notes_placeholder rows="4")= client.adminNotes || ''
                .admin-notes__actions
                    span#adminNotesSaved.admin-notes__saved(style="display:none")= t.book_detail.saved
                    button.sm-btn.sm-btn--soft#saveAdminNotes
                        span= t.book_detail.save

block scripts
    script(src="/js/layouts/appointment.js" type="module")
    script.
        (function() {
            const bookId = '!{client._id}';

            // ── Admin notes save ──────────────────────────────────────────────
            const textarea = document.getElementById('adminNotesInput');
            const saveBtn = document.getElementById('saveAdminNotes');
            const savedMsg = document.getElementById('adminNotesSaved');

            if (saveBtn && textarea) {
                saveBtn.addEventListener('click', async () => {
                    const res = await fetch(`/appointement/${bookId}/admin-notes`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ adminNotes: textarea.value })
                    });
                    const data = await res.json();
                    if (data.success) {
                        savedMsg.style.display = 'inline';
                        setTimeout(() => { savedMsg.style.display = 'none'; }, 2500);
                    }
                });
            }

            // ── Employee change save ──────────────────────────────────────────
            const empSelect = document.getElementById('bookEmpSelect');
            const empSaveBtn = document.getElementById('bookEmpSave');
            const empSavedMsg = document.getElementById('bookEmpSaved');

            if (empSaveBtn && empSelect) {
                empSaveBtn.addEventListener('click', async () => {
                    const employeeId = empSelect.value || null;
                    const res = await fetch(`/appointement/${bookId}/employee`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ employeeId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        empSavedMsg.style.display = 'inline';
                        setTimeout(() => { empSavedMsg.style.display = 'none'; }, 2500);
                    }
                });
            }

            // ── Marquer une absence (no-show) ───────────────────────────────────
            const noShowBtn     = document.getElementById('noShowBtn');
            const noShowChoices = document.getElementById('noShowChoices');
            const noShowCancel  = document.getElementById('noShowCancel');
            const noShowValid   = document.getElementById('noShowValid');
            const noShowInvalid = document.getElementById('noShowInvalid');

            if (noShowBtn && noShowChoices) {
                noShowBtn.addEventListener('click', () => {
                    noShowBtn.style.display = 'none';
                    noShowChoices.style.display = 'flex';
                });
            }
            if (noShowCancel) {
                noShowCancel.addEventListener('click', () => {
                    noShowChoices.style.display = 'none';
                    noShowBtn.style.display = '';
                });
            }

            async function submitNoShow(reason, btn) {
                const amount = btn.dataset.amount;
                if (reason === 'invalid' && amount) {
                    if (!confirm(`Encaisser ${amount}€ pour absence sans raison valable ?`)) return;
                } else if (reason === 'invalid') {
                    if (!confirm('Marquer cette absence comme non valable ?')) return;
                }

                noShowChoices.querySelectorAll('button').forEach(b => b.disabled = true);
                btn.querySelector('span').textContent = 'Traitement…';

                try {
                    const res  = await fetch(`/appointment/${bookId}/no-show`, {
                        method:  'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body:    JSON.stringify({ reason })
                    });
                    const data = await res.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.error || 'Erreur lors du traitement.');
                        noShowChoices.querySelectorAll('button').forEach(b => b.disabled = false);
                        btn.querySelector('span').textContent = reason === 'invalid'
                            ? (amount ? `Raison non valable (encaisser ${amount}€)` : 'Raison non valable')
                            : 'Raison valable (gratuit)';
                    }
                } catch (e) {
                    alert('Erreur réseau.');
                    noShowChoices.querySelectorAll('button').forEach(b => b.disabled = false);
                }
            }

            if (noShowValid)   noShowValid.addEventListener('click',   () => submitNoShow('valid',   noShowValid));
            if (noShowInvalid) noShowInvalid.addEventListener('click', () => submitNoShow('invalid', noShowInvalid));

            // ── Revue des frais d'annulation prélevés automatiquement ───────────
            const cancelReviewBtn     = document.getElementById('cancelReviewBtn');
            const cancelReviewChoices = document.getElementById('cancelReviewChoices');
            const cancelReviewCancel  = document.getElementById('cancelReviewCancel');
            const cancelReviewRefund  = document.getElementById('cancelReviewRefund');
            const cancelReviewKeep    = document.getElementById('cancelReviewKeep');

            if (cancelReviewBtn && cancelReviewChoices) {
                cancelReviewBtn.addEventListener('click', () => {
                    cancelReviewBtn.style.display = 'none';
                    cancelReviewChoices.style.display = 'flex';
                });
            }
            if (cancelReviewCancel) {
                cancelReviewCancel.addEventListener('click', () => {
                    cancelReviewChoices.style.display = 'none';
                    cancelReviewBtn.style.display = '';
                });
            }

            async function submitCancelReview(decision, btn) {
                if (decision === 'refunded' && !confirm('Rembourser les frais d\'annulation au client ?')) return;
                if (decision === 'kept' && !confirm('Confirmer que l\'établissement conserve les frais d\'annulation ?')) return;

                cancelReviewChoices.querySelectorAll('button').forEach(b => b.disabled = true);
                btn.querySelector('span').textContent = 'Traitement…';

                try {
                    const res  = await fetch(`/appointment/${bookId}/review-cancellation`, {
                        method:  'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body:    JSON.stringify({ decision })
                    });
                    const data = await res.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.error || 'Erreur lors du traitement.');
                        cancelReviewChoices.querySelectorAll('button').forEach(b => b.disabled = false);
                        btn.querySelector('span').textContent = decision === 'refunded'
                            ? 'Raison valable (rembourser le client)'
                            : 'Raison non valable (garder les frais)';
                    }
                } catch (e) {
                    alert('Erreur réseau.');
                    cancelReviewChoices.querySelectorAll('button').forEach(b => b.disabled = false);
                }
            }

            if (cancelReviewRefund) cancelReviewRefund.addEventListener('click', () => submitCancelReview('refunded', cancelReviewRefund));
            if (cancelReviewKeep)   cancelReviewKeep.addEventListener('click',   () => submitCancelReview('kept',     cancelReviewKeep));
        })();
