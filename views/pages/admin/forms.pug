extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/layouts/forms.css")

block content
    .forms-page
        - var formsLocked = (maxQuestions === 0)

        //- ── Page header ────────────────────────────────────────────
        .forms-page__header
            .forms-page__header-left
                h2= t.forms.title
                p.forms-page__subtitle= t.forms.subtitle
            .forms-page__header-right
                .forms-status-badge#formStatusBadge(class=(form && form.active) ? 'forms-status-badge--on' : '')
                    span#formStatusLabel= (form && form.active) ? t.forms.active_label : t.forms.inactive_label
                label.forms-active-toggle
                    input#formActiveToggle(type="checkbox" checked=(form && form.active) disabled=formsLocked)
                    .forms-active-toggle__track
                button.sm-btn.sm-btn--primary#saveFormBtn(type="button" disabled=formsLocked)
                    svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                        path(d="M840-680v480q0 33-23.5 56.5T760-120H200q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h480l160 160Zm-80 34L646-760H200v560h560v-446ZM480-240q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35ZM240-560h360v-160H240v160Zm-40-86v446-560 114Z")
                        span= t.forms.save

        //- ── Aperçu verrouillé (plan Basic) ──────────────────────────
        //- Plan basic : 1 question gratuite visible + upsell banner au-dessus.
        //- Plan sans formulaire (maxQuestions === 0) : aperçu flouté complet.
        if formsLocked
            .forms-lock-banner
                svg(xmlns="http://www.w3.org/2000/svg" height="22px" viewBox="0 -960 960 960" width="22px" fill="currentColor")
                    path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80Z")
                .forms-lock-banner__text
                    strong Fonctionnalité Pro
                    span Les formulaires de pré-réservation sont disponibles à partir du plan Pro — voici un aperçu de ce que vous pourrez configurer une fois abonné·e.
                a.btn-upgrade-pro(href="/subscription") Passer au Pro
        else if currentPlan === 'basic'
            .forms-lock-banner.forms-lock-banner--soft
                svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                    path(d="m40-120 440-760 440 760H40Zm138-80h604L480-720 178-200Zm302-40q17 0 28.5-11.5T520-280q0-17-11.5-28.5T480-320q-17 0-28.5 11.5T440-280q0 17 11.5 28.5T480-240Zm-40-120h80v-200h-80v200Zm40-100Z")
                .forms-lock-banner__text
                    strong Version gratuite — 1 question incluse
                    span Passez au plan Pro pour créer jusqu'à 3 questions et utiliser le formulaire en production.
                a.btn-upgrade-pro(href="/subscription") Passer au Pro

        //- ── Plan limit banner ─────────────────────────────────────
        if maxQuestions > 0
            - var qCount = (form && form.questions) ? form.questions.length : 0
            - var qAtLimit = qCount >= maxQuestions
            if currentPlan === 'basic'
                .plan-limit-banner.plan-limit-banner--upgrade#questionLimitBanner(style=!qAtLimit ? 'display:none' : '')
                    svg.plan-limit-banner__icon(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                        path(d="m40-120 440-760 440 760H40Zm138-80h604L480-720 178-200Zm302-40q17 0 28.5-11.5T520-280q0-17-11.5-28.5T480-320q-17 0-28.5 11.5T440-280q0 17 11.5 28.5T480-240Zm-40-120h80v-200h-80v200Zm40-100Z")
                    .plan-limit-banner__text
                        strong Limite gratuit atteinte — #{maxQuestions}/#{maxQuestions} question
                        span Passez au plan Pro pour créer jusqu'à 3 questions et personnaliser votre formulaire.
                    a.btn-upgrade-pro(href="/subscription") Passer au Pro →
            else if currentPlan === 'pro'
                .plan-limit-banner.plan-limit-banner--upgrade#questionLimitBanner(style=!qAtLimit ? 'display:none' : '')
                    svg.plan-limit-banner__icon(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                        path(d="m40-120 440-760 440 760H40Zm138-80h604L480-720 178-200Zm302-40q17 0 28.5-11.5T520-280q0-17-11.5-28.5T480-320q-17 0-28.5 11.5T440-280q0 17 11.5 28.5T480-240Zm-40-120h80v-200h-80v200Zm40-100Z")
                    .plan-limit-banner__text
                        strong Limite Pro atteinte — #{maxQuestions}/#{maxQuestions} questions
                        span Passez au plan Business pour créer jusqu'à 10 questions dans votre formulaire.
                    a.btn-upgrade-business(href="/subscription") Passer au Business →
            else if currentPlan === 'business'
                .plan-limit-banner.plan-limit-banner--max#questionLimitBanner(style=!qAtLimit ? 'display:none' : '')
                    svg.plan-limit-banner__icon(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                        path(d="M480-280q17 0 28.5-11.5T520-320q0-17-11.5-28.5T480-360q-17 0-28.5 11.5T440-320q0 17 11.5 28.5T480-280Zm-40-160h80v-240h-80v240Zm40 360q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z")
                    .plan-limit-banner__text
                        strong Limite maximale atteinte
                        span Vous avez atteint la limite de #{maxQuestions} questions de votre plan Business.

        //- ── Two-column grid ────────────────────────────────────────
        //- Toujours rendu — y compris pour le plan Basic — afin que
        //- l'utilisateur voie un aperçu (verrouillé/flouté en CSS via
        //- `.forms-grid--locked`) plutôt qu'un bloc entièrement masqué.
        .forms-grid(class=formsLocked ? 'forms-grid--locked' : '')

            //- ── LEFT: Form builder ─────────────────────────────
            .forms-builder-card
                .forms-builder-card__head
                    h3.forms-card-title= t.forms.builder_title
                    if !formsLocked
                        span.forms-autosave
                            svg(xmlns="http://www.w3.org/2000/svg" height="12px" viewBox="0 -960 960 960" width="12px" fill="currentColor")
                                path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                            | Auto-sauvegardé

                .forms-question-list#questionsList

                .forms-builder__empty#emptyState(style=(form && form.questions && form.questions.length > 0) ? "display:none" : "")
                    svg(xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="currentColor")
                        path(d="M160-200v-80h400v80H160Zm0-160v-80h640v80H160Zm0-160v-80h640v80H160Zm0-160v-80h640v80H160Z")
                    p.forms-empty__title= t.forms.empty
                    p.forms-empty__desc= t.forms.empty_desc

                button.forms-add-dashed#addQuestionBtn(type="button" disabled=formsLocked)
                    svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                        path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                    span= t.forms.add_question

            //- ── RIGHT: Live preview ─────────────────────────────
            .forms-preview-card
                .forms-preview-card__head
                    h3.forms-card-title= t.forms.preview_title

                .forms-preview-card__body
                    .forms-preview-phone
                        .forms-preview-phone__inner
                            h3.preview-step-title#previewTitle= t.forms.form_step_title
                            p.preview-step-sub#previewSubtitle= t.forms.form_step_subtitle
                            .preview-phone__questions#previewQuestions
                                //- Rendered by JS
                            button.sm-btn.sm-btn--primary.preview-confirm-btn(disabled)= t.forms.form_next

    //- ── Modal: add / edit question ─────────────────────────────────
    .modal-overlay#modalOverlay
    .forms-modal#questionModal
        .forms-modal__header
            h3#modalTitle= t.forms.add_question
            button.btn--icon.modal-close#closeModalBtn(type="button")
                svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                    path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")

        .forms-modal__body
            .field
                label.forms-modal__label= t.forms.question_label
                input.input#questionLabelInput(type="text" placeholder=t.forms.question_placeholder)

            .field
                label.forms-modal__label= t.forms.question_type
                .forms-type-selector#typeSelector
                    button.forms-type-btn.active(type="button" data-type="text")= t.forms.type_text
                    button.forms-type-btn(type="button" data-type="yes_no")= t.forms.type_yes_no
                    button.forms-type-btn(type="button" data-type="choice")= t.forms.type_choice

            .field#optionsSection(style="display:none")
                label.forms-modal__label= t.forms.options_label
                #optionsList.forms-options-list
                button.sm-btn.sm-btn--ghost#addOptionBtn(type="button")
                    svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                        path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                    span= t.forms.add_option

            label.forms-check-row
                input#questionRequired(type="checkbox")
                span= t.forms.required

        .forms-modal__footer
            button.sm-btn.sm-btn--ghost#cancelModalBtn(type="button")= t.forms.cancel
            button.sm-btn.sm-btn--primary#confirmModalBtn(type="button")= t.forms.confirm

    //- ── Sticky unsaved bar ─────────────────────────────────────────────
    .forms-unsaved-bar#formsUnsavedBar
        .forms-unsaved-bar__left
            svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                path(d="M480-280q17 0 28.5-11.5T520-320q0-17-11.5-28.5T480-360q-17 0-28.5 11.5T440-320q0 17 11.5 28.5T480-280Zm-40-160h80v-240h-80v240Zm40 360q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
            span Modifications non sauvegardées
        button.sm-btn.sm-btn--primary#unsavedSaveBtn(type="button")
            svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                path(d="M840-680v480q0 33-23.5 56.5T760-120H200q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h480l160 160Zm-80 34L646-760H200v560h560v-446ZM480-240q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35ZM240-560h360v-160H240v160Zm-40-86v446-560 114Z")
            span Sauvegarder

    //- Hidden data for JS
    script.
        window.__formData    = !{JSON.stringify(form || { active: false, questions: [] })};
        window.__tForms      = !{JSON.stringify(t.forms)};
        window.__maxQuestions = !{maxQuestions || 0};

block scripts
    script(src="/js/layouts/forms.admin.js" type="module")
