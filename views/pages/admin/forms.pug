extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/layouts/forms.css")

block content
    .forms-page
        - var formsLocked = (maxQuestions === 0)

        //- ── Page header ────────────────────────────────────────────
        .forms-page__header
            .forms-page__header-left
                h2= t.forms.title
                p.forms-page__subtitle= t.forms.subtitle
            .forms-page__header-right
                .forms-status-badge#formStatusBadge(class=(form && form.active) ? 'forms-status-badge--on' : '')
                    span#formStatusLabel= (form && form.active) ? t.forms.active_label : t.forms.inactive_label
                label.forms-active-toggle
                    input#formActiveToggle(type="checkbox" checked=(form && form.active) disabled=formsLocked)
                    .forms-active-toggle__track
                button.sm-btn.sm-btn--primary#saveFormBtn(type="button" disabled=formsLocked)
                    span.material-symbols-outlined(style=`font-size:18px`) save
                    span= t.forms.save

        //- ── Aperçu verrouillé (plan Basic) ──────────────────────────
        //- Plan basic : 1 question gratuite visible + upsell banner au-dessus.
        //- Plan sans formulaire (maxQuestions === 0) : aperçu flouté complet.
        if formsLocked
            .plan-gate
                span.plan-gate__lock 🔒
                .plan-gate__body
                    strong.plan-gate__title Formulaire de pré-réservation
                    span.plan-gate__sub Disponible uniquement dans les plans Pro & Business.
                a.btn-upgrade-pro.plan-gate__cta(href="/subscription") Passer au Pro →
        else if currentPlan === 'basic'
            .plan-gate
                span.plan-gate__lock 🔒
                .plan-gate__body
                    strong.plan-gate__title 1 question incluse (plan gratuit)
                    span.plan-gate__sub Passez au plan Pro pour créer jusqu'à 5 questions.
                a.btn-upgrade-pro.plan-gate__cta(href="/subscription") Passer au Pro →

        //- ── Plan limit banner ─────────────────────────────────────
        if maxQuestions > 0
            - var qCount = (form && form.questions) ? form.questions.length : 0
            - var qAtLimit = qCount >= maxQuestions
            if currentPlan === 'basic'
                .plan-gate#questionLimitBanner(style=!qAtLimit ? 'display:none' : '')
                    span.plan-gate__lock 🔒
                    .plan-gate__body
                        strong.plan-gate__title Limite atteinte — #{maxQuestions}/#{maxQuestions} question
                        span.plan-gate__sub Disponible uniquement dans les plans Pro & Business.
                    a.btn-upgrade-pro.plan-gate__cta(href="/subscription") Passer au Pro →
            else if currentPlan === 'pro'
                .plan-gate#questionLimitBanner(style=!qAtLimit ? 'display:none' : '')
                    span.plan-gate__lock 🔒
                    .plan-gate__body
                        strong.plan-gate__title Limite Pro atteinte — #{maxQuestions}/#{maxQuestions} questions
                        span.plan-gate__sub Disponible uniquement dans le plan Business.
                    a.btn-upgrade-business.plan-gate__cta(href="/subscription") Passer au Business →
            else if currentPlan === 'business'
                .plan-gate#questionLimitBanner(style=!qAtLimit ? 'display:none' : '')
                    span.plan-gate__lock 🔒
                    .plan-gate__body
                        strong.plan-gate__title Limite maximale atteinte — #{maxQuestions}/#{maxQuestions} questions
                        span.plan-gate__sub Vous avez atteint la limite de votre plan Business.

        //- ── Two-column grid ────────────────────────────────────────
        //- Toujours rendu — y compris pour le plan Basic — afin que
        //- l'utilisateur voie un aperçu (verrouillé/flouté en CSS via
        //- `.forms-grid--locked`) plutôt qu'un bloc entièrement masqué.
        .forms-grid(class=formsLocked ? 'forms-grid--locked' : '')

            //- ── LEFT: Form builder ─────────────────────────────
            .forms-builder-card
                .forms-builder-card__head
                    h3.forms-card-title= t.forms.builder_title
                    if !formsLocked
                        span.forms-autosave
                            span.material-symbols-outlined(style=`font-size:12px`) check
                            | Auto-sauvegardé

                .forms-question-list#questionsList

                .forms-builder__empty#emptyState(style=(form && form.questions && form.questions.length > 0) ? "display:none" : "")
                    span.material-symbols-outlined(style=`font-size:40px`) list_alt
                    p.forms-empty__title= t.forms.empty
                    p.forms-empty__desc= t.forms.empty_desc

                button.forms-add-dashed#addQuestionBtn(type="button" disabled=formsLocked)
                    span.material-symbols-outlined(style=`font-size:16px`) add
                    span= t.forms.add_question

            //- ── RIGHT: Live preview ─────────────────────────────
            .forms-preview-card
                .forms-preview-card__head
                    h3.forms-card-title= t.forms.preview_title

                .forms-preview-card__body
                    .forms-preview-phone
                        .forms-preview-phone__inner
                            h3.preview-step-title#previewTitle= t.forms.form_step_title
                            p.preview-step-sub#previewSubtitle= t.forms.form_step_subtitle
                            .preview-phone__questions#previewQuestions
                                //- Rendered by JS
                            button.sm-btn.sm-btn--primary.preview-confirm-btn(disabled)= t.forms.form_next

    //- ── Modal: add / edit question ─────────────────────────────────
    .modal-overlay#modalOverlay
    .forms-modal#questionModal
        .forms-modal__header
            h3#modalTitle= t.forms.add_question
            button.btn--icon.modal-close#closeModalBtn(type="button")
                span.material-symbols-outlined(style=`font-size:20px`) close

        .forms-modal__body
            .field
                label.forms-modal__label= t.forms.question_label
                input.input#questionLabelInput(type="text" placeholder=t.forms.question_placeholder)

            .field
                label.forms-modal__label= t.forms.question_type
                .forms-type-selector#typeSelector
                    button.forms-type-btn.active(type="button" data-type="text")= t.forms.type_text
                    button.forms-type-btn(type="button" data-type="yes_no")= t.forms.type_yes_no
                    button.forms-type-btn(type="button" data-type="choice")= t.forms.type_choice

            .field#optionsSection(style="display:none")
                label.forms-modal__label= t.forms.options_label
                #optionsList.forms-options-list
                button.sm-btn.sm-btn--ghost#addOptionBtn(type="button")
                    span.material-symbols-outlined(style=`font-size:14px`) add
                    span= t.forms.add_option

            label.forms-check-row
                input#questionRequired(type="checkbox")
                span= t.forms.required

        .forms-modal__footer
            button.sm-btn.sm-btn--ghost#cancelModalBtn(type="button")= t.forms.cancel
            button.sm-btn.sm-btn--primary#confirmModalBtn(type="button")= t.forms.confirm

    //- ── Sticky unsaved bar ─────────────────────────────────────────────
    .forms-unsaved-bar#formsUnsavedBar
        .forms-unsaved-bar__left
            span.material-symbols-outlined(style=`font-size:16px`) info
            span Modifications non sauvegardées
        button.sm-btn.sm-btn--primary#unsavedSaveBtn(type="button")
            span.material-symbols-outlined(style=`font-size:16px`) save
            span Sauvegarder

    //- Hidden data for JS
    script.
        window.__formData    = !{JSON.stringify(form || { active: false, questions: [] })};
        window.__tForms      = !{JSON.stringify(t.forms)};
        window.__maxQuestions = !{maxQuestions || 0};

block scripts
    script(src="/js/layouts/forms.admin.js" type="module")
