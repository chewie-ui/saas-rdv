extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/layouts/forms.css")

block content
    .fm-page
        - var formsLocked = (maxQuestions === 0)
        - var qCount = (form && form.questions) ? form.questions.length : 0
        - var isActive = !!(form && form.active)

        section.fm-section
            //- ── En-tête de section ─────────────────────────────────────────
            .fm-section__head
                .fm-section__headtext
                    h2.fm-section__title= t.forms.title
                    p.fm-section__desc= t.forms.subtitle
                button.sm-btn.sm-btn--primary#saveFormBtn(type="button" disabled=formsLocked)
                    span.material-symbols-outlined(style="font-size:18px") save
                    span= t.forms.save

            //- ── Verrous de plan ────────────────────────────────────────────
            if formsLocked
                .fm-gate
                    span.material-symbols-outlined.fm-gate__ic lock
                    .fm-gate__body
                        strong Formulaire de pré-réservation
                        span Disponible dans les plans Pro & Business.
                    a.fm-gate__cta(href="/subscription") Passer au Pro
            else if currentPlan === 'basic'
                .fm-gate
                    span.material-symbols-outlined.fm-gate__ic lock
                    .fm-gate__body
                        strong 1 question incluse (plan gratuit)
                        span Passez au Pro pour créer jusqu'à 5 questions.
                    a.fm-gate__cta(href="/subscription") Passer au Pro

            if maxQuestions > 0
                - var qAtLimit = qCount >= maxQuestions
                .fm-gate.fm-gate--warn#questionLimitBanner(style=!qAtLimit ? 'display:none' : '')
                    span.material-symbols-outlined.fm-gate__ic bolt
                    .fm-gate__body
                        strong= 'Limite atteinte — ' + maxQuestions + '/' + maxQuestions + (maxQuestions > 1 ? ' questions' : ' question')
                        if currentPlan === 'business'
                            span Vous avez atteint la limite maximale de votre plan.
                        else
                            span= currentPlan === 'pro' ? 'Passez au Business pour davantage de questions.' : 'Passez au Pro pour créer jusqu\'à 5 questions.'
                    if currentPlan !== 'business'
                        a.fm-gate__cta(href="/subscription")= currentPlan === 'pro' ? 'Passer au Business' : 'Passer au Pro'

            //- ── Ligne : statut (activé / désactivé) ────────────────────────
            .fm-row#fmStateCard(class=isActive ? 'is-on' : '')
                .fm-row__label
                    | Statut du formulaire
                    p.fm-row__desc Activé, vos clients répondent à vos questions avant de confirmer leur rendez-vous.
                .fm-row__field
                    .fm-status
                        span.fm-status__txt
                            span.fm-status__dot
                            span#fmStateTitle= isActive ? 'Activé — vos clients voient le formulaire' : 'Désactivé — réservation directe'
                        label.fm-switch(for="formActiveToggle")
                            input#formActiveToggle(type="checkbox" checked=isActive disabled=formsLocked)
                            span.fm-switch__track

            //- ── Ligne : questions ──────────────────────────────────────────
            .fm-row.fm-row--top
                .fm-row__label
                    | Questions
                    p.fm-row__desc
                        span= t.forms.empty_desc
                        span.fm-counter#questionsCounter
                .fm-row__field
                    .fm-qlist#questionsList
                    .fm-empty#emptyState(style=(qCount > 0) ? 'display:none' : '')
                        span.fm-empty__ic
                            span.material-symbols-outlined list_alt
                        p.fm-empty__title= t.forms.empty
                    button.fm-add#addQuestionBtn(type="button" disabled=formsLocked)
                        span.material-symbols-outlined(style="font-size:18px") add
                        span= t.forms.add_question

            //- ── Ligne : aperçu client ──────────────────────────────────────
            .fm-row.fm-row--top
                .fm-row__label
                    | Aperçu client
                    p.fm-row__desc Ce que voient vos clients avant de confirmer.
                .fm-row__field
                    .fm-preview__sheet
                        .fm-preview__title#previewTitle= t.forms.form_step_title
                        .fm-preview__sub#previewSubtitle= t.forms.form_step_subtitle
                        .fm-preview__questions#previewQuestions
                        button.fm-preview__btn(disabled)= t.forms.form_next

    //- ── Modale : ajouter / modifier une question ───────────────────────────
    .fm-modal#modalOverlay
        .fm-modal__box
            .fm-modal__head
                h3#modalTitle= t.forms.add_question
                button.fm-modal__x#closeModalBtn(type="button" aria-label="Fermer")
                    span.material-symbols-outlined(style="font-size:20px") close
            .fm-modal__body
                .fm-field
                    label.fm-label= t.forms.question_label
                    input.fm-input#questionLabelInput(type="text" placeholder=t.forms.question_placeholder maxlength="140")
                .fm-field
                    label.fm-label= t.forms.question_type
                    .fm-types#typeSelector
                        button.fm-type.is-active(type="button" data-type="text")
                            span.material-symbols-outlined notes
                            span= t.forms.type_text
                        button.fm-type(type="button" data-type="yes_no")
                            span.material-symbols-outlined rule
                            span= t.forms.type_yes_no
                        button.fm-type(type="button" data-type="choice")
                            span.material-symbols-outlined list
                            span= t.forms.type_choice
                .fm-field#optionsSection(style="display:none")
                    label.fm-label= t.forms.options_label
                    #optionsList.fm-options
                    button.fm-add-opt#addOptionBtn(type="button")
                        span.material-symbols-outlined(style="font-size:16px") add
                        span= t.forms.add_option
                label.fm-req
                    .fm-switch.fm-switch--sm
                        input#questionRequired(type="checkbox")
                        span.fm-switch__track
                    span= t.forms.required
            .fm-modal__foot
                button.sm-btn.sm-btn--ghost#cancelModalBtn(type="button")= t.forms.cancel
                button.sm-btn.sm-btn--primary#confirmModalBtn(type="button")= t.forms.confirm

    //- ── Barre « modifications non sauvegardées » ───────────────────────────
    .fm-unsaved#formsUnsavedBar
        span.material-symbols-outlined(style="font-size:18px") info
        span Modifications non sauvegardées
        button.sm-btn.sm-btn--primary#unsavedSaveBtn(type="button")
            span.material-symbols-outlined(style="font-size:16px") save
            span Sauvegarder

    script.
        window.__formData     = !{JSON.stringify(form || { active: false, questions: [] })};
        window.__tForms       = !{JSON.stringify(t.forms)};
        window.__maxQuestions = !{maxQuestions || 0};

block scripts
    script(src="/js/components/ds-drag.js")
    script(src="/js/layouts/forms.admin.js" type="module")
