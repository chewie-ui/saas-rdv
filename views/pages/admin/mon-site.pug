        // ── Drag & drop section reordering (live animated) ───────────────
        var dragSrc = null;
        var slEl = document.getElementById('sectionsList');

        function animateReorder(moveFn) {
            var items = Array.from(slEl.querySelectorAll('.ms-section-item')).filter(function(it){ return it !== dragSrc; });
            var firstRects = items.map(function(it){ return it.getBoundingClientRect(); });
            moveFn();
            items.forEach(function(it, i) {
                var first = firstRects[i];
                var last = it.getBoundingClientRect();
                var deltaY = first.top - last.top;
                if (deltaY) {
                    it.style.transition = 'none';
                    it.style.transform = 'translateY(' + deltaY + 'px)';
                    requestAnimationFrame(function() {
                        it.style.transition = 'transform 0.22s cubic-bezier(.2,.8,.2,1)';
                        it.style.transform = '';
                    });
                }
            });
        }

        slEl.addEventListener('dragstart', function(e) {
            if (!e.target.closest('.ms-drag-handle')) return;
            dragSrc = e.target.closest('.ms-section-item');
            if (!dragSrc) return;
            dragSrc.classList.add('is-dragging');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', dragSrc.dataset.id);
        });
        slEl.addEventListener('dragover', function(e) {
            if (!dragSrc) return;
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            var over = e.target.closest('.ms-section-item');
            if (!over || over === dragSrc) return;
            var rect = over.getBoundingClientRect();
            var before = e.clientY < rect.top + rect.height / 2;
            var target = before ? over : over.nextElementSibling;
            if (target === dragSrc || dragSrc.nextElementSibling === target) return;
            animateReorder(function() {
                if (before) slEl.insertBefore(dragSrc, over);
                else slEl.insertBefore(dragSrc, over.nextSibling);
            });
        });
        slEl.addEventListener('drop', function(e) {
            e.preventDefault();
            if (!dragSrc) return;
            dragSrc.classList.remove('is-dragging');
            dragSrc = null;
            Array.from(slEl.querySelectorAll('.ms-section-item')).forEach(function(el, i) {
                var sv = getSectionById(el.dataset.id);
                if (sv) sv.order = i;
            });
            state.sections.sort(function(a,b){ return a.order - b.order; });
            markDirty(true);
        });
        slEl.addEventListener('dragend', function() {
            if (dragSrc) dragSrc.classList.remove('is-dragging');
            dragSrc = null;
        });

