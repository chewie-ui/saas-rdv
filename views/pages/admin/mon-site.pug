                booking: '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
                about: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
                gallery: '<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>',
                testimonials: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
                faq: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
                contact: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>'
            };
            var data = defaultData[type] || {};
            state.sections.push({ id: id, type: type, enabled: true, order: maxOrder + 1, data: data });
            var title = data.title || '';
            // Build form content based on type
            var formInner = '<div class="ms-field"><label class="ms-label">Titre de la section</label><input class="ms-input" type="text" data-field="title" value="' + escHtml(title) + '" placeholder="Titre..."></div>';
            if (type === 'gallery') {
                formInner += '<div class="ms-items-list" data-section-id="' + id + '" data-items-type="gallery" data-items-key="images"></div>' +
                  '<div class="ms-add-item-row">' +
                  '<label class="ms-add-upload-btn"><input type="file" accept="image/*" data-add-upload="' + id + '" data-items-type="gallery" style="display:none">' + uploadSvgHtml() + '&nbsp;Uploader</label>' +
                  '<button class="ms-add-url-btn" type="button" data-add-url="' + id + '" data-items-type="gallery">+ Via URL</button>' +
                  '</div>';
            } else if (type === 'testimonials') {
                formInner += '<div class="ms-items-list" data-section-id="' + id + '" data-items-type="testimonials" data-items-key="items"></div>' +
                  '<div class="ms-add-item-row"><button class="ms-add-url-btn" type="button" data-add-item="' + id + '" data-items-type="testimonials">+ Ajouter un avis</button></div>';
            } else if (type === 'faq') {
                formInner += '<div class="ms-items-list" data-section-id="' + id + '" data-items-type="faq" data-items-key="items"></div>' +
                  '<div class="ms-add-item-row"><button class="ms-add-url-btn" type="button" data-add-item="' + id + '" data-items-type="faq">+ Ajouter une question</button></div>';
            }
            var dragH = '<div class="ms-drag-handle" draggable="true" title="Glisser pour réordonner"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="8" x2="20" y2="8"/><line x1="4" y1="14" x2="20" y2="14"/><line x1="4" y1="20" x2="20" y2="20"/></svg></div>';
            var list = document.getElementById('sectionsList');
            var div = document.createElement('div');
            div.className = 'ms-section-item';
            div.dataset.id = id;
            div.innerHTML = '<div class="ms-section-item__hd">' + dragH + '<div class="ms-section-item__icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + (icons[type] || icons.contact) + '</svg></div><span class="ms-section-item__name">' + (labels[type] || type) + '</span><div class="ms-section-item__actions"><button class="ms-icon-btn ms-section-up" type="button" title="Monter"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg></button><button class="ms-icon-btn ms-section-down" type="button" title="Descendre"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button><button class="ms-toggle-btn on" type="button" title="Afficher/masquer"></button><button class="ms-icon-btn ms-section-edit" type="button" title="Modifier"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg></button></div></div><div class="ms-section-form" data-form="' + id + '">' + formInner + '</div>';
            list.appendChild(div);
            markDirty();
        }
