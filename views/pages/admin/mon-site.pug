    script.
        var __site = !{JSON.stringify(site)};
        var __previewUrl = '/mon-site/preview';
        var __saveUrl = '/mon-site/save';
        var __publishUrl = '/mon-site/publish';

        // Ré-attache les modales directement à <body> : évite tout bug de
        // position:fixed cassée par un ancêtre (overflow/transform) du layout admin.
        ['addModal', 'deleteModal', 'applyTplModal'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el) document.body.appendChild(el);
        });

        // ── State ────────────────────────────────────────────────────────
        var state = JSON.parse(JSON.stringify(__site));
        var saveTimer = null;
        var isDirty = false;
        // Les modifications faites DANS l'aperçu (couleur/texte/image d'un
        // élément) sont déjà appliquées en direct dans l'iframe : recharger
        // l'aperçu après leur sauvegarde est inutile ET referme le panneau de
        // réglages. On ne recharge donc l'aperçu que pour les changements
        // "côté éditeur" (ajout de section, thème, mise en page…), signalés par
        // needRefresh. markDirty(fast, true) = édition live → pas de rechargement.
        var needRefresh = false;

        // ── Helpers ──────────────────────────────────────────────────────
        function getSectionById(id) {
            return state.sections.find(function(s){ return s.id === id; });
        }
        function indicatorState(s) {
            var el = document.getElementById('saveIndicator');
            if (!el) return;
            el.className = 'ms-save-indicator ' + s;
            el.textContent = s === 'pending' ? '● Modifié' : s === 'saving' ? 'Sauvegarde...' : s === 'saved' ? '✓ Sauvegardé' : '';
        }
        function markDirty(fast, live) {
            isDirty = true;
            if (!live) needRefresh = true;
            indicatorState('pending');
            clearTimeout(saveTimer);
            saveTimer = setTimeout(doSave, fast ? 150 : 1400);
        }

        // ── Helpers ──────────────────────────────────────────────────────
        function escHtml(s) {
            return String(s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }
        function uploadSvgHtml() {
            return '<span class="material-symbols-outlined">upload</span>';
        }

        function createItemRow(type, data) {
            var row = document.createElement('div');
            row.className = 'ms-item-row';
            var d = data || {};
            if (type === 'gallery') {
                var hasUrl = !!d.url;
                row.innerHTML =
                  '<div class="ms-item-preview">' +
                    '<img class="ms-item-thumb" src="' + escHtml(d.url||'') + '" alt="" loading="lazy"' + (!hasUrl?' style="display:none"':'') + '>' +
                    '<div class="ms-item-no-img"' + (hasUrl?' style="display:none"':'') + '>📷</div>' +
                  '</div>' +
                  '<div class="ms-item-main">' +
                    '<div class="ms-url-row">' +
                      '<input class="ms-input ms-input--sm" type="url" data-item-key="url" value="' + escHtml(d.url||'') + '" placeholder="https://...">' +
                      '<label class="ms-img-upload-btn" title="Uploader">' +
                        '<input type="file" accept="image/*" data-upload-img-field="1" style="display:none">' +
                        uploadSvgHtml() +
                      '</label>' +
                    '</div>' +
                    '<input class="ms-input ms-input--sm" type="text" data-item-key="caption" value="' + escHtml(d.caption||'') + '" placeholder="Légende (optionnel)" style="margin-top:4px">' +
                  '</div>' +
                  '<button class="ms-remove-item" type="button" data-remove="1" title="Supprimer">✕</button>';
            } else if (type === 'testimonials') {
                var rating = d.rating || 5;
                var stars = '';
                for (var i=1;i<=5;i++) { stars += '<button class="ms-star'+(i<=rating?' on':'')+'" type="button" data-rating="'+i+'">★</button>'; }
                row.innerHTML =
                  '<div class="ms-item-main">' +
                    '<input class="ms-input ms-input--sm" type="text" data-item-key="name" value="' + escHtml(d.name||'') + '" placeholder="Nom du client">' +
                    '<div class="ms-rating-row">' + stars + '</div>' +
                    '<textarea class="ms-input ms-input--textarea ms-input--sm" data-item-key="text" rows="2" placeholder="Témoignage...">' + escHtml(d.text||'') + '</textarea>' +
                  '</div>' +
                  '<button class="ms-remove-item" type="button" data-remove="1">✕</button>';
            } else if (type === 'faq') {
                row.innerHTML =
                  '<div class="ms-item-main">' +
                    '<input class="ms-input ms-input--sm" type="text" data-item-key="question" value="' + escHtml(d.question||'') + '" placeholder="Question...">' +
                    '<textarea class="ms-input ms-input--textarea ms-input--sm" data-item-key="answer" rows="2" placeholder="Réponse..." style="margin-top:4px">' + escHtml(d.answer||'') + '</textarea>' +
                  '</div>' +
                  '<button class="ms-remove-item" type="button" data-remove="1">✕</button>';
            } else if (type === 'stats') {
                row.innerHTML =
                  '<div class="ms-item-main" style="display:flex;gap:6px;align-items:flex-start">' +
                    '<input class="ms-input ms-input--sm" type="text" data-item-key="icon" value="' + escHtml(d.icon||'') + '" placeholder="⭐" style="width:54px;flex-shrink:0;font-size:18px;text-align:center">' +
                    '<div style="flex:1;display:flex;flex-direction:column;gap:4px">' +
                      '<input class="ms-input ms-input--sm" type="text" data-item-key="number" value="' + escHtml(d.number||'') + '" placeholder="150+ / 10 ans">' +
                      '<input class="ms-input ms-input--sm" type="text" data-item-key="label" value="' + escHtml(d.label||'') + '" placeholder="Clients satisfaits">' +
                    '</div>' +
                  '</div>' +
                  '<button class="ms-remove-item" type="button" data-remove="1" style="align-self:flex-start">✕</button>';
            } else if (type === 'values') {
                row.innerHTML =
                  '<div class="ms-item-main" style="display:flex;gap:6px;align-items:flex-start">' +
                    '<input class="ms-input ms-input--sm" type="text" data-item-key="icon" value="' + escHtml(d.icon||'') + '" placeholder="✅" style="width:48px;flex-shrink:0;font-size:18px;text-align:center">' +
                    '<div style="flex:1;display:flex;flex-direction:column;gap:4px">' +
                      '<input class="ms-input ms-input--sm" type="text" data-item-key="title" value="' + escHtml(d.title||'') + '" placeholder="Titre de la valeur">' +
                      '<input class="ms-input ms-input--sm" type="text" data-item-key="desc" value="' + escHtml(d.desc||'') + '" placeholder="Description courte (optionnel)">' +
                    '</div>' +
                  '</div>' +
                  '<button class="ms-remove-item" type="button" data-remove="1" style="align-self:flex-start">✕</button>';
            }
            return row;
        }

        function renderItemsList(form, sectionId) {
            var s = getSectionById(sectionId);
            if (!s) return;
            var list = form.querySelector('.ms-items-list');
            if (!list) return;
            var type = list.dataset.itemsType;
            var key = list.dataset.itemsKey;
            var items = (s.data && s.data[key]) || [];
            list.innerHTML = '';
            items.forEach(function(item) { list.appendChild(createItemRow(type, item)); });
            // Marque cette liste comme "rendue" : tant qu'un formulaire n'a pas
            // été ouvert, son .ms-items-list reste vide dans le DOM alors que
            // l'état contient les items (galerie/avis/FAQ… d'un template).
            // syncItemsToState ne doit synchroniser QUE les listes rendues,
            // sinon une sauvegarde (ex: changement de couleur) écraserait ces
            // tableaux avec du vide → perte de données.
            list.dataset.rendered = '1';
        }

        function syncItemsToState() {
            document.querySelectorAll('.ms-items-list').forEach(function(list) {
                if (!list.dataset.rendered) return;
                var sectionId = list.dataset.sectionId;
                var key = list.dataset.itemsKey;
                var type = list.dataset.itemsType;
                var s = getSectionById(sectionId);
                if (!s) return;
                var items = [];
                list.querySelectorAll('.ms-item-row').forEach(function(row) {
                    var item = {};
                    row.querySelectorAll('[data-item-key]').forEach(function(inp) {
                        item[inp.dataset.itemKey] = inp.value;
                    });
                    if (type === 'testimonials') {
                        var lastOn = Array.from(row.querySelectorAll('.ms-star.on')).pop();
                        item.rating = lastOn ? parseInt(lastOn.dataset.rating) : 5;
                    }
                    items.push(item);
                });
                s.data[key] = items;
            });
        }

        function uploadFile(file, callback) {
            var fd = new FormData();
            fd.append('image', file);
            fetch('/mon-site/upload-image', { method: 'POST', body: fd })
                .then(function(r){ return r.json(); })
                .then(function(d){ callback(null, d); })
