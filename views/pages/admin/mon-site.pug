extends ../../layouts/admin

block links
    link(rel="stylesheet" href="/css/layouts/mon-site.css")

block content
    -
        var S = site
        var theme = S.theme || {}
        var siteFullUrl = 'https://www.branshee.com/s/' + S.slug
        var sectionIcons = {
            hero: 'home',
            services: 'list_alt',
            booking: 'calendar_month',
            about: 'person',
            gallery: 'photo_library',
            testimonials: 'star',
            faq: 'help',
            contact: 'mail',
            stats: 'bar_chart',
            cta: 'campaign'
        }
        var sectionLabels = {
            hero: 'Bandeau principal', services: 'Prestations', booking: 'Prise de RDV',
            about: 'À propos', gallery: 'Galerie', testimonials: 'Avis clients',
            faq: 'FAQ', contact: 'Contact', stats: 'Chiffres clés', cta: 'Bannière CTA'
        }

    .ms-editor

        //- ── LEFT PANEL ──────────────────────────────────────────────────
        .ms-panel

            .ms-panel__top
                a.ms-back(href="/panel" title="Retour au tableau de bord")
                    span.material-symbols-outlined arrow_back
                    span Tableau de bord
                .ms-panel__title Éditeur de site
                .ms-tabs
                    button.ms-tab.active(type="button" data-tab="sections")
                        span.material-symbols-outlined view_agenda
                        | Sections
                    button.ms-tab(type="button" data-tab="design")
                        span.material-symbols-outlined palette
                        | Design
                    button.ms-tab(type="button" data-tab="settings")
                        span.material-symbols-outlined settings
                        | Paramètres

            .ms-publish-strip
                .ms-publish-strip__row1
                    .ms-publish-strip__status
                        .ms-dot(id="publishDot" class=S.isPublished ? 'ms-dot--live' : '')
                        span#publishLabel= S.isPublished ? 'En ligne' : 'Hors ligne'
                    span.ms-save-indicator(id="saveIndicator")
                .ms-publish-strip__row2
                    a.sm-btn.sm-btn--ghost.sm-btn--full(id="viewSiteBtn" href=siteUrl target="_blank" rel="noopener" class=S.isPublished ? '' : 'ms-view-btn--disabled' title=S.isPublished ? 'Voir le site' : 'Publiez d\'abord le site')
                        span.material-symbols-outlined visibility
                        | Voir le site
                    button.sm-btn.sm-btn--full(
                        type="button"
                        id="publishBtn"
                        class=S.isPublished ? 'sm-btn--danger' : 'sm-btn--primary'
                    )= S.isPublished ? 'Désactiver' : 'Publier'

            .ms-panel__body

                //- ── TAB SECTIONS ──────────────────────────────────────────
                .ms-pane.active(data-pane="sections")
                    .ms-sections-list(id="sectionsList")
                        each section in S.sections.sort((a,b) => a.order - b.order)
                            .ms-section-item(data-id=section.id class=!section.enabled ? 'is-disabled' : '')
                                .ms-section-item__hd
                                    .ms-drag-handle(draggable="true" title="Glisser pour réordonner")
                                        span.material-symbols-outlined drag_indicator
                                    .ms-section-item__icon
                                        span.material-symbols-outlined= sectionIcons[section.type] || sectionIcons.contact
                                    span.ms-section-item__name(title=sectionLabels[section.type] || section.type)= sectionLabels[section.type] || section.type
                                    .ms-section-item__actions
                                        button.ms-toggle-btn(type="button" class=section.enabled ? 'on' : '' title="Afficher/masquer")
                                        .ms-section-menu-wrap
                                            button.ms-icon-btn.ms-section-menu-btn(type="button" title="Plus d'options")
                                                span.material-symbols-outlined more_vert
                                            .ms-section-menu
                                                button.ms-section-menu__item.ms-section-edit(type="button")
                                                    span.material-symbols-outlined edit
                                                    | Modifier
                                                button.ms-section-menu__item.ms-section-duplicate(type="button")
                                                    span.material-symbols-outlined content_copy
                                                    | Dupliquer
                                                button.ms-section-menu__item.ms-section-menu__item--danger.ms-section-delete(type="button")
                                                    span.material-symbols-outlined delete
                                                    | Supprimer

                                //- Form for each section type
                                .ms-section-form(data-form=section.id)
                                    .ms-style-row
                                        .ms-field.ms-field--color
                                            label.ms-label Fond
                                            .ms-color-field-wrap
                                                input.ms-color-input(type="color" data-field="bgColor" value=section.data.bgColor || '#ffffff')
                                                button.ms-color-reset(type="button" data-reset-field="bgColor" title="Réinitialiser")
                                                    span.material-symbols-outlined close
                                        .ms-field.ms-field--color
                                            label.ms-label Texte
                                            .ms-color-field-wrap
                                                input.ms-color-input(type="color" data-field="textColor" value=section.data.textColor || '#000000')
                                                button.ms-color-reset(type="button" data-reset-field="textColor" title="Réinitialiser")
                                                    span.material-symbols-outlined close
                                    .ms-field
                                        label.ms-label Image de fond (recouvre toute la section)
                                        .ms-url-row
                                            input.ms-input(type="url" data-field="sectionBgImage" value=section.data.sectionBgImage || '' placeholder="https://...")
                                            label.ms-img-upload-btn(title="Uploader")
                                                input(type="file" accept="image/*" data-field-upload="sectionBgImage" data-section-id=section.id style="display:none")
                                                span.material-symbols-outlined upload
                                        p.ms-hint Optionnel — laissez vide pour garder le fond par défaut de cette section.
                                    if section.type === 'hero'
                                        .ms-field
                                            label.ms-label Titre principal
                                            input.ms-input(type="text" data-field="title" value=section.data.title || '' placeholder="Votre titre ici...")
                                        .ms-field
                                            label.ms-label Sous-titre
                                            textarea.ms-input.ms-input--textarea(data-field="subtitle" placeholder="Un texte accrocheur...")= section.data.subtitle || ''
                                        .ms-field
                                            label.ms-label Texte du bouton CTA
                                            input.ms-input(type="text" data-field="ctaText" value=section.data.ctaText || 'Prendre rendez-vous' placeholder="Ex: Réserver maintenant")
                                        .ms-field
                                            label.ms-label Style du bandeau
                                            .ms-layout-btns(data-field="heroLayout")
                                                each ly in [['full','Plein écran'],['compact','Compact'],['minimal','Minimaliste']]
                                                    button.ms-layout-btn(type="button" data-layout=ly[0] class=(section.data.heroLayout || 'full') === ly[0] ? 'active' : '')= ly[1]
                                        .ms-field
                                            label.ms-label Alignement du texte
                                            .ms-layout-btns(data-field="textAlign")
                                                button.ms-layout-btn(type="button" data-layout="center" class=(section.data.textAlign || 'center') === 'center' ? 'active' : '') Centré
                                                button.ms-layout-btn(type="button" data-layout="left" class=(section.data.textAlign || 'center') === 'left' ? 'active' : '') Gauche
                                        .ms-field
                                            label.ms-label Image de fond
                                            .ms-url-row
                                                input.ms-input(type="url" data-field="bgImage" value=section.data.bgImage || '' placeholder="https://...")
                                                label.ms-img-upload-btn(title="Uploader une image")
                                                    input(type="file" accept="image/*" data-field-upload="bgImage" data-section-id=section.id style="display:none")
                                                    span.material-symbols-outlined upload
                                            p.ms-hint Laissez vide pour utiliser le dégradé par défaut.
                                        .ms-field
                                            label.ms-label Assombrissement de l'image
                                            .ms-layout-btns(data-field="overlayOpacity")
                                                each op in [['0','Aucun'],['30','Léger'],['48','Moyen'],['70','Fort']]
                                                    button.ms-layout-btn(type="button" data-layout=op[0] class=String(section.data.overlayOpacity !== undefined ? section.data.overlayOpacity : 48) === op[0] ? 'active' : '')= op[1]
                                            p.ms-hint S'applique sur les styles avec image ou dégradé.

                                    else if section.type === 'services'
                                        .ms-field
                                            label.ms-label Titre de la section
                                            input.ms-input(type="text" data-field="title" value=section.data.title || 'Nos prestations' placeholder="Titre...")
                                        .ms-field
                                            label.ms-label Sous-titre
                                            input.ms-input(type="text" data-field="subtitle" value=section.data.subtitle || '' placeholder="Description courte...")
                                        p.ms-hint Les prestations affichées proviennent de votre catalogue de services. Gérez-les dans
                                            a(href="/services" style="color:var(--accent)") &nbsp;Services&nbsp;↗

                                    else if section.type === 'booking'
                                        .ms-field
                                            label.ms-label Titre de la section
                                            input.ms-input(type="text" data-field="title" value=section.data.title || 'Réservez en ligne' placeholder="Titre...")
                                        .ms-field
                                            label.ms-label Sous-titre
                                            input.ms-input(type="text" data-field="subtitle" value=section.data.subtitle || '' placeholder="Description courte...")
                                        .ms-field
                                            label.ms-label Affichage du widget
                                            .ms-layout-btns(data-field="embedMode")
                                                button.ms-layout-btn(type="button" data-layout="full" class=(section.data.embedMode || 'full') === 'full' ? 'active' : '') Complet
                                                button.ms-layout-btn(type="button" data-layout="compact" class=(section.data.embedMode || 'full') === 'compact' ? 'active' : '') Calendrier seul
                                            p.ms-hint "Calendrier seul" retire le profil, les horaires, la galerie et les avis pour ne garder que les étapes de réservation — utile pour réduire le défilement.
                                        p.ms-hint(style="margin-top:4px") La prise de RDV utilise votre calendrier BranShee — disponibilités et confirmations en temps réel.

                                    else if section.type === 'about'
                                        .ms-field
                                            label.ms-label Titre
                                            input.ms-input(type="text" data-field="title" value=section.data.title || 'À propos de nous' placeholder="Titre...")
                                        .ms-field
                                            label.ms-label Accroche (sous-titre)
                                            input.ms-input(type="text" data-field="subtitle" value=section.data.subtitle || '' placeholder="Ex : Notre histoire, Qui sommes-nous...")
                                        .ms-field
                                            label.ms-label Texte de présentation
                                            .ms-rte-wrap
                                                .ms-rte-toolbar
                                                    button.ms-rte-btn(type="button" data-cmd="h2" title="Grand titre") H2
                                                    button.ms-rte-btn(type="button" data-cmd="h3" title="Petit titre") H3
                                                    .ms-rte-sep
                                                    button.ms-rte-btn(type="button" data-cmd="bold" title="Gras") B
                                                    button.ms-rte-btn(type="button" data-cmd="italic" title="Italique") I
                                                    button.ms-rte-btn(type="button" data-cmd="underline" title="Souligné") U
                                                    .ms-rte-sep
                                                    button.ms-rte-btn(type="button" data-cmd="mark" title="Surligner") ✦
                                                    .ms-rte-sep
                                                    button.ms-rte-btn(type="button" data-cmd="insertUnorderedList" title="Liste à puces") ≡
                                                    button.ms-rte-btn(type="button" data-cmd="insertOrderedList" title="Liste numérotée") 1.
                                                    .ms-rte-sep
                                                    button.ms-rte-btn(type="button" data-cmd="img" title="Insérer une image") 🖼
                                                    button.ms-rte-btn(type="button" data-cmd="removeFormat" title="Effacer la mise en forme" style="margin-left:auto;font-weight:400;opacity:.6") ✕
                                                div.ms-rte(contenteditable="true" data-field="text" data-rte="1" data-placeholder="Présentez votre établissement...")!= section.data.text || ''
                                        .ms-field
                                            label.ms-label Disposition de l'image
                                            .ms-layout-btns(data-field="layout")
                                                button.ms-layout-btn(type="button" data-layout="default" class=(section.data.layout || 'default') === 'default' ? 'active' : '') Image droite
                                                button.ms-layout-btn(type="button" data-layout="reverse" class=(section.data.layout || 'default') === 'reverse' ? 'active' : '') Image gauche
                                                button.ms-layout-btn(type="button" data-layout="centered" class=(section.data.layout || 'default') === 'centered' ? 'active' : '') Centré
                                        .ms-field
                                            label.ms-label Photo
                                            .ms-url-row
                                                input.ms-input(type="url" data-field="image" value=section.data.image || '' placeholder="https://...")
                                                label.ms-img-upload-btn(title="Uploader")
                                                    input(type="file" accept="image/*" data-field-upload="image" data-section-id=section.id style="display:none")
                                                    span.material-symbols-outlined upload
                                            p.ms-hint Optionnel — s'affiche à côté du texte.
                                        p.ms-hint(style="margin:10px 0 6px;font-weight:600;color:var(--ink)") Engagements / Valeurs
                                        p.ms-hint(style="margin-bottom:8px") Ajoutez 2–4 points clés avec icône, titre et description.
                                        .ms-items-list(data-section-id=section.id data-items-type="values" data-items-key="values")
                                        .ms-add-item-row
                                            button.ms-add-url-btn(type="button" data-add-item=section.id data-items-type="values") + Ajouter une valeur

                                    else if section.type === 'contact'
                                        .ms-field
                                            label.ms-label Titre
                                            input.ms-input(type="text" data-field="title" value=section.data.title || 'Nous trouver' placeholder="Titre...")
                                        .ms-field
                                            label.ms-label Téléphone
                                            input.ms-input(type="tel" data-field="phone" value=section.data.phone || '' placeholder="06 00 00 00 00")
                                        .ms-field
                                            label.ms-label Email
                                            input.ms-input(type="email" data-field="email" value=section.data.email || '' placeholder="contact@example.com")
                                        .ms-field
                                            label.ms-label Adresse
                                            input.ms-input(type="text" data-field="address" value=section.data.address || '' placeholder="123 rue de la Paix, Paris")

                                    else if section.type === 'gallery'
                                        .ms-field
                                            label.ms-label Titre de la section
                                            input.ms-input(type="text" data-field="title" value=section.data.title || 'Notre galerie' placeholder="Titre...")
                                        .ms-field
                                            label.ms-label Nombre de colonnes
                                            .ms-layout-btns(data-field="columns")
                                                each c in [['2','2 cols'],['3','3 cols'],['4','4 cols']]
                                                    button.ms-layout-btn(type="button" data-layout=c[0] class=(section.data.columns || '3') === c[0] ? 'active' : '')= c[1]
                                        .ms-items-list(data-section-id=section.id data-items-type="gallery" data-items-key="images")
                                        .ms-add-item-row
                                            label.ms-add-upload-btn
                                                input(type="file" accept="image/*" data-add-upload=section.id data-items-type="gallery" style="display:none")
                                                span.material-symbols-outlined upload
                                                |  Uploader
                                            button.ms-add-url-btn(type="button" data-add-url=section.id data-items-type="gallery") + Via URL

                                    else if section.type === 'testimonials'
                                        .ms-field
                                            label.ms-label Titre de la section
                                            input.ms-input(type="text" data-field="title" value=section.data.title || 'Avis clients' placeholder="Titre...")
                                        .ms-field
                                            label.ms-label Source des avis
                                            .ms-layout-btns(data-field="source")
                                                button.ms-layout-btn(type="button" data-layout="manual" class=(section.data.source || 'manual') === 'manual' ? 'active' : '') Témoignages personnalisés
                                                button.ms-layout-btn(type="button" data-layout="branshee" class=section.data.source === 'branshee' ? 'active' : '') Avis BranShee
                                            p.ms-hint "Avis BranShee" affiche automatiquement les vrais avis clients de votre établissement (notés lors d'une réservation) et propose un lien pour en laisser un — connexion à un compte BranShee requise.
                                        if section.data.source !== 'branshee'
                                            .ms-items-list(data-section-id=section.id data-items-type="testimonials" data-items-key="items")
                                            .ms-add-item-row
                                                button.ms-add-url-btn(type="button" data-add-item=section.id data-items-type="testimonials") + Ajouter un avis

                                    else if section.type === 'faq'
                                        .ms-field
                                            label.ms-label Titre de la section
                                            input.ms-input(type="text" data-field="title" value=section.data.title || 'FAQ' placeholder="Titre...")
                                        .ms-items-list(data-section-id=section.id data-items-type="faq" data-items-key="items")
                                        .ms-add-item-row
                                            button.ms-add-url-btn(type="button" data-add-item=section.id data-items-type="faq") + Ajouter une question

                                    else if section.type === 'stats'
                                        .ms-field
                                            label.ms-label Titre de la section
                                            input.ms-input(type="text" data-field="title" value=section.data.title || 'Nos chiffres clés' placeholder="Titre...")
                                        p.ms-hint(style="margin-bottom:8px") Ajoutez vos chiffres clés — icône (emoji), nombre et label.
                                        .ms-items-list(data-section-id=section.id data-items-type="stats" data-items-key="items")
                                        .ms-add-item-row
                                            button.ms-add-url-btn(type="button" data-add-item=section.id data-items-type="stats") + Ajouter un chiffre

                                    else if section.type === 'cta'
                                        .ms-field
                                            label.ms-label Titre
                                            input.ms-input(type="text" data-field="title" value=section.data.title || 'Prêt à réserver ?' placeholder="Titre accrocheur...")
                                        .ms-field
                                            label.ms-label Texte (optionnel)
                                            textarea.ms-input.ms-input--textarea(data-field="text" rows="2" placeholder="Courte description...")= section.data.text || ''
                                        .ms-field
                                            label.ms-label Texte du bouton
                                            input.ms-input(type="text" data-field="buttonText" value=section.data.buttonText || 'Prendre rendez-vous' placeholder="Ex: Réserver maintenant")
                                        .ms-field
                                            label.ms-label Lien du bouton
                                            input.ms-input(type="text" data-field="buttonUrl" value=section.data.buttonUrl || '#booking' placeholder="#booking ou https://...")
                                        .ms-field
                                            label.ms-label Style du fond
                                            .ms-layout-btns(data-field="bg")
                                                each bg in [['primary','Couleur principale'],['dark','Sombre'],['gradient','Dégradé'],['soft','Doux']]
                                                    button.ms-layout-btn(type="button" data-layout=bg[0] class=(section.data.bg || 'primary') === bg[0] ? 'active' : '')= bg[1]

                                    else
                                        .ms-field
                                            label.ms-label Titre de la section
                                            input.ms-input(type="text" data-field="title" value=(section.data && section.data.title) || '' placeholder="Titre...")

                    .ms-add-section
                        button.ms-add-section__btn(type="button" id="addSectionBtn")
                            span.material-symbols-outlined add
                            | Ajouter une section

                //- ── TAB DESIGN ────────────────────────────────────────────
                .ms-pane(data-pane="design")

                    .ms-design-section
                        .ms-design-section__title Choisissez un modèle
                        p.ms-hint(style="margin:-2px 0 14px") Un site complet, prêt à publier — belles images, textes soignés et réservation intégrée. Appliquez-en un, puis personnalisez tout.
                        .ms-tplgal
                            each tpl in (siteTemplates || [])
                                .ms-tplcard
                                    .ms-tplcard__preview(style=`background:${tpl.thumb.bg}`)
                                        .ms-tplcard__chrome
                                            span
                                            span
                                            span
                                        .ms-tplcard__nav(style=`background:${tpl.thumb.text}`)
                                            span.ms-tplcard__logo(style=`background:${tpl.thumb.accent}`)
                                            .ms-tplcard__navlinks
                                                span(style=`background:${tpl.thumb.bg}`)
                                                span(style=`background:${tpl.thumb.bg}`)
                                                span(style=`background:${tpl.thumb.bg}`)
                                            span.ms-tplcard__navcta(style=`background:${tpl.thumb.accent}`)
                                        .ms-tplcard__hero(style=`background:linear-gradient(140deg, ${tpl.thumb.accent}, ${tpl.thumb.bg})`)
                                            span.ms-tplcard__htitle(style=`background:${tpl.thumb.text}`)
                                            span.ms-tplcard__htitle.is-short(style=`background:${tpl.thumb.text}`)
                                            span.ms-tplcard__hbtn(style=`background:${tpl.thumb.accent}`)
                                        .ms-tplcard__cards
                                            span(style=`background:${tpl.thumb.bg};border-color:${tpl.thumb.accent}33`)
                                            span(style=`background:${tpl.thumb.bg};border-color:${tpl.thumb.accent}33`)
                                            span(style=`background:${tpl.thumb.bg};border-color:${tpl.thumb.accent}33`)
                                        span.ms-tplcard__badge= (tpl.sectionsCount || 0) + ' sections'
                                    .ms-tplcard__body
                                        .ms-tplcard__head
                                            span.ms-tplcard__name= tpl.name
                                            span.ms-tplcard__tag= tpl.tagline
                                        p.ms-tplcard__desc= tpl.description
                                        if tpl.bestFor
                                            .ms-tplcard__bestfor
                                                span.material-symbols-outlined check_circle
                                                span= tpl.bestFor
                                        ul.ms-tplcard__features
                                            each f in (tpl.features || [])
                                                li
                                                    span.material-symbols-outlined done
                                                    = f
                                        .ms-tplcard__actions
                                            button.ms-tplcard__apply(type="button" data-apply-template=tpl.id)
                                                span.material-symbols-outlined auto_awesome
                                                | Appliquer ce modèle

                    .ms-design-section
                        .ms-design-section__title Mise en page
                        .ms-layout-tpl-grid
                            button.ms-layout-tpl-card(type="button" data-layout-tpl="1" class=(S.theme.siteTemplate || '1') === '1' ? 'active' : '')
                                .ms-layout-tpl-card__check
                                    span.material-symbols-outlined check
                                .ms-layout-tpl-card__thumb
                                    .ms-layout-tpl-card__nav(style="background:rgba(0,0,0,.7)")
                                    .ms-layout-tpl-card__hero(style="background:linear-gradient(135deg,#1a0533,#6c47d0);flex:1.8")
                                    .ms-layout-tpl-card__sections
                                        .ms-layout-tpl-card__sec(style="background:#f3f4f6")
                                        .ms-layout-tpl-card__sec(style="background:#fff")
                                span.ms-layout-tpl-card__name
                                    | Moderne
                                    .ms-layout-tpl-card__spinner
                            button.ms-layout-tpl-card(type="button" data-layout-tpl="2" class=(S.theme.siteTemplate || '1') === '2' ? 'active' : '')
                                .ms-layout-tpl-card__check
                                    span.material-symbols-outlined check
                                .ms-layout-tpl-card__thumb
                                    .ms-layout-tpl-card__nav(style="background:#0a0a14")
                                    .ms-layout-tpl-card__hero(style="background:#08080f;flex:1.8;border-left:3px solid #6c47d0")
                                    .ms-layout-tpl-card__sections
                                        .ms-layout-tpl-card__sec(style="background:#fff")
                                        .ms-layout-tpl-card__sec(style="background:#0d0d1e")
                                span.ms-layout-tpl-card__name
                                    | Sombre
                                    .ms-layout-tpl-card__spinner

                    .ms-design-section
                        .ms-design-section__title Templates
                        .ms-template-grid
                            each tpl in [['violet','Violet','#6c47d0','#ffffff'],['minimal','Minimaliste','#0f0f1a','#ffffff'],['elegant','Élégant','#c8973a','#0f0c07'],['nature','Nature','#2d7a4f','#f7faf7'],['ocean','Océan','#0ea5e9','#f0f9ff']]
                                button.ms-template-card(type="button" data-template=tpl[0])
                                    .ms-template-card__preview(style=`background:${tpl[3]}`)
                                        .ms-template-card__accent(style=`background:${tpl[2]}`)
                                        .ms-template-card__lines
                                            span(style=`background:${tpl[2]}`)
                                            span(style=`background:${tpl[2]};opacity:.35`)
                                    span.ms-template-card__name
                                        | #{tpl[1]}
                                        .ms-template-card__spinner

                    .ms-design-section
                        .ms-design-section__title Couleurs
                        .ms-color-row
                            span.ms-color-label Couleur principale
                            .ms-color-swatch
                                .ms-color-preview(id="prevPrimary" style=`background:${theme.primaryColor || '#6c47d0'}`)
                                input(type="color" id="colorPrimary" value=theme.primaryColor || '#6c47d0')
                            input.ms-color-hex(type="text" id="hexPrimary" value=theme.primaryColor || '#6c47d0' maxlength="7")
                        .ms-color-row
