        // direct dans l'iframe ; ici on met à jour l'état et on sauvegarde avec
        // le debounce normal (pas "fast") pour que plusieurs réglages successifs
        // soient regroupés en une seule sauvegarde — sinon l'aperçu se recharge
        // après chaque petit ajustement et referme le panneau.
        window.addEventListener('message', function(e) {
            if (!e.data || e.data.type !== 'bk:styleElement') return;
            var s = getSectionById(e.data.sectionId);
            if (!s) return;
            if (!s.data.elementStyles) s.data.elementStyles = {};
            if (e.data.prop === 'reset') {
                // "Tout réinitialiser" pour cet élément
                delete s.data.elementStyles[e.data.field];
            } else if (e.data.value === null) {
                // Réinitialiser UNE seule propriété (petit ↺)
                if (s.data.elementStyles[e.data.field]) {
                    delete s.data.elementStyles[e.data.field][e.data.prop];
                    if (!Object.keys(s.data.elementStyles[e.data.field]).length) {
                        delete s.data.elementStyles[e.data.field];
                    }
                }
            } else {
                if (!s.data.elementStyles[e.data.field]) s.data.elementStyles[e.data.field] = {};
                s.data.elementStyles[e.data.field][e.data.prop] = e.data.value;
            }
            markDirty(false, true);
        });

        // "Appliquer à tous les éléments similaires" : copie le style de
        // l'élément courant sur tous les éléments du même type (mêmes champs).
        window.addEventListener('message', function(e) {
            if (!e.data || e.data.type !== 'bk:styleElementBulk') return;
            var styles = e.data.styles || {};
            var hasStyles = Object.keys(styles).length > 0;
            (e.data.sectionIds || []).forEach(function(sid) {
                var s = getSectionById(sid);
                if (!s) return;
                if (!s.data.elementStyles) s.data.elementStyles = {};
                if (hasStyles) s.data.elementStyles[e.data.field] = Object.assign({}, styles);
                else delete s.data.elementStyles[e.data.field];
            });
            markDirty(false, true);
        });

