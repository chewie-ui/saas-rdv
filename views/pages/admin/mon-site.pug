            var rendered = list && list.dataset.rendered;
            // Si le formulaire est ouvert/rendu, on capture d'abord ses éventuelles
            // modifications DOM dans l'état (syncItemsToState reconstruit le
            // tableau images[]) AVANT de fixer la nouvelle URL, sinon elle serait
            // écrasée par l'ancienne valeur du DOM.
            if (rendered) syncItemsToState();
            if (!s.data.images[e.data.index]) return;
            s.data.images[e.data.index].url = e.data.url;
            if (rendered) renderItemsList(form, e.data.sectionId);
            markDirty(false, true);
        });
