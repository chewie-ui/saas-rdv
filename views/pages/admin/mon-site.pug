            var wrap = btn.closest('.ms-rte-wrap');
            if (!wrap) return;
            var rte = wrap.querySelector('[data-rte]');
            if (!rte) return;
            rte.focus();
            if (cmd === 'h2') {
                document.execCommand('formatBlock', false, 'H2');
            } else if (cmd === 'h3') {
                document.execCommand('formatBlock', false, 'H3');
            } else if (cmd === 'mark') {
                var sel = window.getSelection();
                if (sel && sel.rangeCount && !sel.isCollapsed) {
                    var range = sel.getRangeAt(0);
                    var mark = document.createElement('mark');
                    try { range.surroundContents(mark); } catch(ex) { document.execCommand('insertHTML', false, '<mark>' + sel.toString() + '</mark>'); }
                    sel.removeAllRanges();
                }
            } else if (cmd === 'img') {
                var imgUrl = prompt('URL de l\'image :');
                if (imgUrl) document.execCommand('insertImage', false, imgUrl);
            } else {
                document.execCommand(cmd, false, null);
            }
            // Sync to state after toolbar action
            setTimeout(function() {
                var form = rte.closest('[data-form]');
                if (!form) return;
                var s = getSectionById(form.dataset.form);
                if (s) { s.data[rte.dataset.field] = rte.innerHTML; markDirty(); }
