extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/layouts/history.css")

block content
    .hist-page

        //- ── Filter bar ──────────────────────────────────────────────
        .hist-filters
            .hist-search
                svg.hist-search__icon(xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="currentColor")
                    path(d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z")
                input#searchClient.hist-search__input(
                    type="text"
                    placeholder=t.hist_page.search
                    autocomplete="off"
                )
                button#clearSearch.hist-search__clear(type="button" style="display:none" title="Effacer la recherche")
                    svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14")
                        line(x1="18" y1="6" x2="6" y2="18")
                        line(x1="6" y1="6" x2="18" y2="18")

            .hist-selects
                select.hist-select#statusFilter
                    option(value="all")= t.hist_page.all_status || 'All status'
                    option(value="confirmed")= t.hist_page.status_confirmed || 'Confirmed'
                    option(value="completed")= t.hist_page.status_completed || 'Completed'
                    option(value="canceled")= t.hist_page.status_canceled || 'Cancelled'
                    option(value="no-show")= t.hist_page.status_noshow || 'No-show'

                select.hist-select#dateFilter
                    option(value="30")= t.hist_page.last_30 || 'Last 30 days'
                    option(value="7")= t.hist_page.last_7 || 'Last 7 days'
                    option(value="90")= t.hist_page.last_90 || 'Last 90 days'
                    option(value="all")= t.hist_page.all_time || 'All time'

                if employees && employees.length
                    select.hist-select#empFilterHist
                        option(value="all")= t.hist_page.all_employees || 'All employees'
                        each emp in employees
                            option(value=String(emp._id)) #{emp.firstName} #{emp.lastName}
                else
                    select.hist-select#empFilterHist
                        option(value="all")= t.hist_page.all_employees || 'All employees'

        //- ── Bannière plan gratuit : rétention 7 jours ───────────────
        if currentPlan === 'basic'
            .hist-free-banner
                svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                    path(d="M480-280q17 0 28.5-11.5T520-320q0-17-11.5-28.5T480-360q-17 0-28.5 11.5T440-320q0 17 11.5 28.5T480-280Zm-40-160h80v-240h-80v240ZM200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Zm0-80h560v-560H200v560Zm0-560v560-560Z")
                span Version gratuite — l'historique est conservé
                strong  7 jours
                span  puis supprimé automatiquement.
                a(href="/subscription") Passer au Pro pour un historique illimité →

        //- ── Desktop table ───────────────────────────────────────────
        .hist-table-wrap
            table.hist-table#histTable
                thead
                    tr
                        th= t.hist.table.name || 'CLIENT'
                        th= t.hist.table.service || 'SERVICE'
                        th= t.hist.table.employee || 'EMPLOYEE'
                        th= t.hist.table.date || 'DATE'
                        th= t.hist.table.duration || 'DURATION'
                        th= t.hist.table.status || 'STATUS'
                        th

                tbody
                    if !history || history.length === 0
                        tr
                            td(colspan="7" style="padding:56px 24px;text-align:center;")
                                .hist-empty
                                    svg(xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="currentColor" style="opacity:.15;margin-bottom:12px;display:block;margin:0 auto 12px")
                                        path(d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Z")
                                    p(style="font-size:14px;font-weight:600;color:var(--text-secondary);margin:0 0 4px") Rien pour l'instant
                                    p(style="font-size:13px;color:var(--text-muted);margin:0") Vos prochains rendez-vous apparaîtront ici une fois confirmés.
                    each h in history
                        - var initials = (h.name||'').charAt(0).toUpperCase() + (h.surname||'').charAt(0).toUpperCase()
                        - var colorIdx = (((h.name||'A').charCodeAt(0) + (h.surname||'A').charCodeAt(0)) % 8)
                        - var d = h.date ? new Date(h.date) : null
                        - var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
                        - var dateStr = d ? months[d.getMonth()] + ' ' + d.getDate() + ', ' + (h.startTime||'') : '-'
                        - var statusKey = (h.status || 'confirmed').toLowerCase()
                        - var pillClass = statusKey === 'canceled' || statusKey === 'cancelled' ? 'cancelled' : statusKey === 'no-show' ? 'no-show' : statusKey === 'completed' ? 'completed' : 'confirmed'
                        - var statusLabel = pillClass === 'confirmed' ? (t.hist_page.status_confirmed||'Confirmed') : pillClass === 'cancelled' ? (t.hist_page.status_canceled||'Cancelled') : pillClass === 'completed' ? (t.hist_page.status_completed||'Completed') : (t.hist_page.status_noshow||'No-show')
                        tr.hist-row(
                            data-id=h._id
                            data-status=statusKey
                            data-employee=(h.employeeId ? String(h.employeeId) : '')
                            data-date=(h.date ? h.date.toISOString().slice(0,10) : '')
                        )
                            td.hist-td.hist-td--client
                                .hist-avatar(class=`av-${colorIdx}`)= initials
                                span.hist-name= (h.name||'') + ' ' + (h.surname||'')
                            td.hist-td= h.serviceName || '-'
                            td.hist-td= h.employeeName || '-'
                            td.hist-td.hist-td--mono= dateStr
                            td.hist-td= h.slotTime ? h.slotTime + ' min' : '-'
                            td.hist-td
                                span(class=`pill pill--${pillClass}`)
                                    span.pill__dot
                                    = statusLabel
                            td.hist-td.hist-td--action
                                a.hist-open-btn(href=`/history/edit/${h._id}`)
                                    | Open
                                    svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="13" height="13")
                                        path(d="M5 12h14M13 6l6 6-6 6")

            //- Pagination
            .hist-pagination
                span.hist-pag-info Page #{currentPage} / #{totalPages}
                .hist-pag-btns
                    if currentPage > 1
                        a.hist-pag-btn(href=`/history?page=${currentPage - 1}`)
                            svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                path(d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z")
                    else
                        span.hist-pag-btn.disabled
                            svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                path(d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z")
                    if currentPage < totalPages
                        a.hist-pag-btn(href=`/history?page=${currentPage + 1}`)
                            svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                path(d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z")
                    else
                        span.hist-pag-btn.disabled
                            svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                path(d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z")

        //- ── Mobile cards ────────────────────────────────────────────
        if !history || history.length === 0
            .hist-empty-mobile.mobile-only(style="text-align:center;padding:48px 24px;")
                p(style="font-size:14px;font-weight:600;color:var(--text-secondary);margin:0 0 4px") Rien pour l'instant
                p(style="font-size:13px;color:var(--text-muted);margin:0") Vos rendez-vous apparaîtront ici.
        .hist-cards.mobile-only
            each h in history
                - var initials = (h.name||'').charAt(0).toUpperCase() + (h.surname||'').charAt(0).toUpperCase()
                - var colorIdx2 = (((h.name||'A').charCodeAt(0) + (h.surname||'A').charCodeAt(0)) % 8)
                - var d2 = h.date ? new Date(h.date) : null
                - var months2 = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
                - var dateStr2 = d2 ? months2[d2.getMonth()] + ' ' + d2.getDate() + ', ' + (h.startTime||'') : '-'
                - var sk2 = (h.status||'confirmed').toLowerCase()
                - var pk2 = sk2 === 'canceled' || sk2 === 'cancelled' ? 'cancelled' : sk2 === 'no-show' ? 'no-show' : sk2 === 'completed' ? 'completed' : 'confirmed'
                - var sl2 = pk2 === 'confirmed' ? (t.hist_page.status_confirmed||'Confirmed') : pk2 === 'cancelled' ? (t.hist_page.status_canceled||'Cancelled') : pk2 === 'completed' ? (t.hist_page.status_completed||'Completed') : (t.hist_page.status_noshow||'No-show')
                .hist-card(data-id=h._id data-status=sk2)
                    .hist-card__top
                        .hist-card__client
                            .hist-avatar(class=`av-${colorIdx2}`)= initials
                            span.hist-card__name= (h.name||'') + ' ' + (h.surname||'')
                        span(class=`pill pill--${pk2}`)
                            span.pill__dot
                            = sl2
                    .hist-card__body
                        if h.serviceName
                            .hist-card__row
                                span.hist-card__lbl Service
                                span= h.serviceName
                        if h.employeeName
                            .hist-card__row
                                span.hist-card__lbl Employee
                                span= h.employeeName
                        .hist-card__row
                            span.hist-card__lbl Date
                            span= dateStr2
                        if h.slotTime
                            .hist-card__row
                                span.hist-card__lbl Duration
                                span= h.slotTime + ' min'
                    .hist-card__footer
                        a.hist-open-btn(href=`/history/edit/${h._id}`)
                            | Open
                            svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="13" height="13")
                                path(d="M5 12h14M13 6l6 6-6 6")

            .hist-pagination
                span.hist-pag-info Page #{currentPage} / #{totalPages}
                .hist-pag-btns
                    if currentPage > 1
                        a.hist-pag-btn(href=`/history?page=${currentPage - 1}`)
                            svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                path(d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z")
                    else
                        span.hist-pag-btn.disabled
                            svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                path(d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z")
                    if currentPage < totalPages
                        a.hist-pag-btn(href=`/history?page=${currentPage + 1}`)
                            svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                path(d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z")
                    else
                        span.hist-pag-btn.disabled
                            svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                path(d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z")

        //- ── Actions panel (kept for delete via JS) ──────────────────
        .history__actions-panel
            .history__actions-row.show
                .row__icon.flex-c
                    svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                        path(d="M480-320q75 0 127.5-52.5T660-500q0-75-52.5-127.5T480-680q-75 0-127.5 52.5T300-500q0 75 52.5 127.5T480-320Zm0-72q-45 0-76.5-31.5T372-500q0-45 31.5-76.5T480-608q45 0 76.5 31.5T588-500q0 45-31.5 76.5T480-392Zm0 192q-134 0-244.5-72.5T61-500q54-137 164.5-209.5T480-782q134 0 244.5 72.5T899-500q-54 137-164.5 209.5T480-200Z")
                .row__text= t.hist_page.view
            .history__actions-row.edit
                .row__icon.flex-c
                    svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                        path(d="M200-200h50l391-391-50-50-391 391v50Zm-60 60v-135l527-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l49 49q12 11 17 26t5 30q0 16-5 30.5T817-647L290-120H140Zm620-571-49-49 49 49Zm-126 77-25-25 50 50-25-25Z")
                .row__text= t.hist.edit
            .history__actions-row.delete
                .row__icon.flex-c
                    svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                        path(d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z")
                .row__text= t.hist.del

block scripts
    script(src="/js/layouts/history.js" type="module")
