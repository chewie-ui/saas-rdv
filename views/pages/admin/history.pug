extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/layouts/history.css")

block content
    .page.page--history
        .history
            .history__container.flex.col
                .history__nav.flex-c.space-b
                    .flex
                    .flex
                        .searchmenu
                            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M779.38-153.85 528.92-404.31q-30 25.54-69 39.54t-78.38 14q-95.92 0-162.58-66.65-66.65-66.66-66.65-162.58 0-95.92 66.65-162.58 66.66-66.65 162.58-66.65 95.92 0 162.58 66.65 66.65 66.66 66.65 162.58 0 41.69-14.77 80.69t-38.77 66.69l250.46 250.47-28.31 28.3ZM381.54-390.77q79.61 0 134.42-54.81 54.81-54.8 54.81-134.42 0-79.62-54.81-134.42-54.81-54.81-134.42-54.81-79.62 0-134.42 54.81-54.81 54.8-54.81 134.42 0 79.62 54.81 134.42 54.8 54.81 134.42 54.81Z"/></svg>
                            input(placeholder=t.hist_page.search id="searchClient")
                            .searchmenu__drop-icon.flex-c
                                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="m322.15-293.08-29.07-29.07L450.92-480 293.08-636.85l29.07-29.07L480-508.08l156.85-157.84 29.07 29.07L508.08-480l157.84 157.85-29.07 29.07L480-450.92 322.15-293.08Z"/></svg>

                //- Desktop table
                table.table__schema.history__table.desktop-table
                    thead
                        tr
                            th= t.hist.table.name
                            th= t.hist.table.email
                            th= t.hist.table.phone
                            th= t.hist.table.date
                            th= t.hist.table.notes
                            th= t.hist.table.status
                            th= t.hist.table.actions
                    tbody
                        each h in history
                            tr(data-id=h._id)
                                td #{h.name} #{h.surname}
                                td #{h.email}
                                td #{h.phone}
                                td #{h.date.toLocaleDateString('fr-FR')} | #{h.startTime}-#{h.endTime}
                                td #{h.message}
                                td(style='padding:8px 1.5rem')
                                    div(class=h.status) #{h.status === 'canceled' ? t.appt.canceled : t.appt.confirmed}
                                td.btn-td.flex-c.j-start
                                    button.btn-icon.flex-c.btn-panel
                                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M480-160q-33 0-56.5-23.5T400-240q0-33 23.5-56.5T480-320q33 0 56.5 23.5T560-240q0 33-23.5 56.5T480-160Zm0-240q-33 0-56.5-23.5T400-480q0-33 23.5-56.5T480-560q33 0 56.5 23.5T560-480q0 33-23.5 56.5T480-400Zm0-240q-33 0-56.5-23.5T400-720q0-33 23.5-56.5T480-800q33 0 56.5 23.5T560-720q0 33-23.5 56.5T480-640Z"/></svg>
                    tfoot
                        tr
                            td
                                .table__schema-pagination.flex-c
                                    .pagination__showing Page #{currentPage} / #{totalPages}
                                    .pagination__btns.flex-c
                                        if currentPage > 1
                                            a(href=`/history?page=${currentPage - 1}`).btn-icon.flex-c
                                                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z"/></svg>
                                        else
                                            span.btn-icon.flex-c.btn-disabled
                                                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e360"><path d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z"/></svg>
                                        if currentPage < totalPages
                                            a(href=`/history?page=${currentPage + 1}`).btn-icon.flex-c
                                                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"/></svg>
                                        else
                                            span.btn-icon.flex-c.btn-disabled
                                                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e360"><path d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"/></svg>

                //- Mobile cards
                .history__cards.mobile-cards
                    each h in history
                        .history__card(data-id=h._id)
                            .history__card-top
                                .history__card-name #{h.name} #{h.surname}
                                div(class=`history__card-status ${h.status}`) #{h.status === 'canceled' ? t.appt.canceled : t.appt.confirmed}
                            .history__card-body
                                .history__card-row
                                    span.history__card-label= t.hist_page.date
                                    span #{h.date.toLocaleDateString('fr-FR')} #{h.startTime}-#{h.endTime}
                                .history__card-row
                                    span.history__card-label= t.hist.table.email
                                    span #{h.email}
                                if h.phone
                                    .history__card-row
                                        span.history__card-label= t.hist_page.phone
                                        span #{h.phone}
                                if h.message
                                    .history__card-row
                                        span.history__card-label= t.hist_page.note
                                        span #{h.message}
                            .history__card-actions
                                button.btn-icon.flex-c.btn-panel
                                    <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#e3e3e3"><path d="M480-160q-33 0-56.5-23.5T400-240q0-33 23.5-56.5T480-320q33 0 56.5 23.5T560-240q0 33-23.5 56.5T480-160Zm0-240q-33 0-56.5-23.5T400-480q0-33 23.5-56.5T480-560q33 0 56.5 23.5T560-480q0 33-23.5 56.5T480-400Zm0-240q-33 0-56.5-23.5T400-720q0-33 23.5-56.5T480-800q33 0 56.5 23.5T560-720q0 33-23.5 56.5T480-640Z"/></svg>

                    .history__cards-pagination.flex-c
                        .pagination__showing Page #{currentPage} / #{totalPages}
                        .pagination__btns.flex-c
                            if currentPage > 1
                                a(href=`/history?page=${currentPage - 1}`).btn-icon.flex-c
                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z"/></svg>
                            else
                                span.btn-icon.flex-c.btn-disabled
                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e360"><path d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z"/></svg>
                            if currentPage < totalPages
                                a(href=`/history?page=${currentPage + 1}`).btn-icon.flex-c
                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"/></svg>
                            else
                                span.btn-icon.flex-c.btn-disabled
                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e360"><path d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"/></svg>

            .history__actions-panel
                .history__actions-row.show
                    .row__icon.flex-c
                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M607.5-372.5Q660-425 660-500t-52.5-127.5Q555-680 480-680t-127.5 52.5Q300-575 300-500t52.5 127.5Q405-320 480-320t127.5-52.5Zm-204-51Q372-455 372-500t31.5-76.5Q435-608 480-608t76.5 31.5Q588-545 588-500t-31.5 76.5Q525-392 480-392t-76.5-31.5ZM214-281.5Q94-363 40-500q54-137 174-218.5T480-800q146 0 266 81.5T920-500q-54 137-174 218.5T480-200q-146 0-266-81.5ZM480-500Zm207.5 160.5Q782-399 832-500q-50-101-144.5-160.5T480-720q-113 0-207.5 59.5T128-500q50 101 144.5 160.5T480-280q113 0 207.5-59.5Z"/></svg>
                    .row__text= t.hist_page.view
                .history__actions-row.edit
                    .row__icon.flex-c
                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M200-200h50.46l409.46-409.46-50.46-50.46L200-250.46V-200Zm-60 60v-135.38l527.62-527.39q9.07-8.24 20.03-12.73 10.97-4.5 23-4.5t23.3 4.27q11.28 4.27 19.97 13.58l48.85 49.46q9.31 8.69 13.27 20 3.96 11.31 3.96 22.62 0 12.07-4.12 23.03-4.12 10.97-13.11 20.04L275.38-140H140Zm620.38-570.15-50.23-50.23 50.23 50.23Zm-126.13 75.9-24.79-25.67 50.46 50.46-25.67-24.79Z"/></svg>
                    .row__text= t.hist.edit
                .history__actions-row.delete
                    .row__icon.flex-c
                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M292.31-140q-29.92 0-51.12-21.19Q220-182.39 220-212.31V-720h-40v-60h180v-35.38h240V-780h180v60h-40v507.69Q740-182 719-161q-21 21-51.31 21H292.31ZM680-720H280v507.69q0 5.39 3.46 8.85t8.85 3.46h375.38q4.62 0 8.46-3.85 3.85-3.84 3.85-8.46V-720ZM376.16-280h59.99v-360h-59.99v360Zm147.69 0h59.99v-360h-59.99v360ZM280-720v520-520Z"/></svg>
                    .row__text= t.hist.del

block scripts
    script(src="/js/layouts/history.js" type="module")
