extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/layouts/history.css")
    link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0")

block content
    .hist-page(data-current-limit=currentLimit data-total-bookings=totalBookings)

        //- ── Free plan banner ────────────────────────────────────
        if currentPlan === 'basic'
            .hist-free-banner
                span.material-symbols-outlined info
                span Version gratuite — l'historique est conservé
                strong  7 jours
                span  puis supprimé automatiquement.
                a(href="/subscription") Passer au Pro pour un historique illimité →

        //- ── Main card ───────────────────────────────────────────
        .hist-card

            //- Card header: title + count + filters
            .hist-card__top
                .hist-card__title-group
                    h2.hist-card__title= t.hist_page.title || 'Historique'
                    span.hist-count-badge #{totalBookings} #{t.hist_page.appointments || 'rendez-vous'}
                .hist-card__filters
                    .hist-search
                        span.hist-search__icon.material-symbols-outlined search
                        input#searchClient.hist-search__input(
                            type="text"
                            placeholder=t.hist_page.search
                            autocomplete="off"
                        )
                        button#clearSearch.hist-search__clear(type="button" style="display:none" title=t.hist_page.clear_search)
                            span.material-symbols-outlined close
                    .hist-selects
                        select.hist-select#statusFilter
                            option(value="all")= t.hist_page.all_status || 'Tous les statuts'
                            option(value="confirmed")= t.hist_page.status_confirmed || 'Confirmé'
                            option(value="completed")= t.hist_page.status_completed || 'Terminé'
                            option(value="canceled")= t.hist_page.status_canceled || 'Annulé'
                            option(value="no-show")= t.hist_page.status_noshow || 'No-show'
                        select.hist-select#dateFilter
                            option(value="30")= t.hist_page.last_30 || '30 derniers jours'
                            option(value="7")= t.hist_page.last_7 || '7 derniers jours'
                            option(value="90")= t.hist_page.last_90 || '90 derniers jours'
                            option(value="all")= t.hist_page.all_time || 'Tout'
                        if employees && employees.length
                            select.hist-select#empFilterHist
                                option(value="all")= t.hist_page.all_employees || 'Tous les employés'
                                each emp in employees
                                    option(value=String(emp._id)) #{emp.firstName} #{emp.lastName}
                        else
                            select.hist-select#empFilterHist
                                option(value="all")= t.hist_page.all_employees || 'Tous les employés'

            //- ── Desktop table ───────────────────────────────────
            .hist-table-wrap
                table.hist-table#histTable
                    thead
                        tr
                            th.hist-th--check
                                input#checkAll(type="checkbox" title="Tout sélectionner")
                            th= t.hist.table.name
                            th= t.hist.table.service
                            th= t.hist.table.employee
                            th= t.hist.table.date
                            th= t.hist.table.duration
                            th= t.hist.table.status
                            th

                    tbody
                        if !history || history.length === 0
                            tr
                                td(colspan="8")
                                    .hist-empty
                                        span.material-symbols-outlined(style="opacity:.12;display:block;margin:0 auto 12px;font-size:40px") history
                                        p.hist-empty__title= t.hist_page.empty_title
                                        p.hist-empty__sub= t.hist_page.empty_subtitle
                        each h in history
                            - var initials = (h.name||'').charAt(0).toUpperCase() + (h.surname||'').charAt(0).toUpperCase()
                            - var colorIdx = (((h.name||'A').charCodeAt(0) + (h.surname||'A').charCodeAt(0)) % 8)
                            - var d = h.date ? new Date(h.date) : null
                            - var dateStr = d ? d.toLocaleDateString(lang, { month: 'short', day: 'numeric' }) + ', ' + (h.startTime||'') : '-'
                            - var statusKey = (h.status || 'confirmed').toLowerCase()
                            - var pillClass = statusKey === 'canceled' || statusKey === 'cancelled' ? 'cancelled' : statusKey === 'no-show' ? 'no-show' : statusKey === 'completed' ? 'completed' : 'confirmed'
                            - var statusLabel = pillClass === 'confirmed' ? (t.hist_page.status_confirmed||'Confirmé') : pillClass === 'cancelled' ? (t.hist_page.status_canceled||'Annulé') : pillClass === 'completed' ? (t.hist_page.status_completed||'Terminé') : (t.hist_page.status_noshow||'No-show')
                            tr.hist-row(
                                data-id=h._id
                                data-status=statusKey
                                data-employee=(h.employeeId ? String(h.employeeId) : '')
                                data-date=(h.date ? h.date.toISOString().slice(0,10) : '')
                            )
                                td.hist-td.hist-td--check
                                    input(type="checkbox" data-id=h._id)
                                - var fullClientName = ((h.name||'') + ' ' + (h.surname||'')).trim()
                                td.hist-td.hist-td--client(title=fullClientName)
                                    .hist-avatar(class=`av-${colorIdx}`)= initials
                                    span.hist-name= fullClientName
                                td.hist-td(title=h.serviceName || '')= h.serviceName || '-'
                                td.hist-td(title=h.employeeName || '')= h.employeeName || '-'
                                td.hist-td= dateStr
                                td.hist-td= h.slotTime ? h.slotTime + ' min' : '-'
                                td.hist-td
                                    span(class=`pill pill--${pillClass}`)
                                        span.pill__dot
                                        = statusLabel
                                td.hist-td.hist-td--action
                                    .hist-row-actions
                                        a.hist-action-btn(href=`/history/edit/${h._id}` title=(t.hist_page.view||'Voir'))
                                            span.material-symbols-outlined edit
                                        button.hist-action-btn.hist-action-btn--danger(type="button" data-del-id=h._id title=(t.hist.del||'Supprimer'))
                                            span.material-symbols-outlined delete

            //- ── Pagination ───────────────────────────────────────
            if totalPages > 0
                .hist-pagination
                    span.hist-pag-info
                        | Page #{currentPage} / #{totalPages}
                    .hist-pag-center
                        //- Prev
                        if currentPage > 1
                            a.hist-pag-btn(href=`/history?page=${currentPage - 1}&limit=${currentLimit}` title="Précédent")
                                span.material-symbols-outlined(style="font-size:16px") chevron_left
                        else
                            span.hist-pag-btn.disabled
                                span.material-symbols-outlined(style="font-size:16px") chevron_left

                        //- Page numbers
                        - var startPg = Math.max(1, currentPage - 2)
                        - var endPg   = Math.min(totalPages, currentPage + 2)

                        if startPg > 1
                            a.hist-pag-btn(href=`/history?page=1&limit=${currentLimit}`) 1
                        if startPg > 2
                            span.hist-pag-dots …

                        - for (var pg = startPg; pg <= endPg; pg++)
                            if pg === currentPage
                                span.hist-pag-btn.is-active= pg
                            else
                                a.hist-pag-btn(href=`/history?page=${pg}&limit=${currentLimit}`)= pg

                        if endPg < totalPages - 1
                            span.hist-pag-dots …
                        if endPg < totalPages
                            a.hist-pag-btn(href=`/history?page=${totalPages}&limit=${currentLimit}`)= totalPages

                        //- Next
                        if currentPage < totalPages
                            a.hist-pag-btn(href=`/history?page=${currentPage + 1}&limit=${currentLimit}` title="Suivant")
                                span.material-symbols-outlined(style="font-size:16px") chevron_right
                        else
                            span.hist-pag-btn.disabled
                                span.material-symbols-outlined(style="font-size:16px") chevron_right

                    span.hist-pag-info #{totalBookings} au total

        //- ── Mobile cards ─────────────────────────────────────────
        if !history || history.length === 0
            .mobile-only(style="text-align:center;padding:48px 24px;")
                p(style="font-size:14px;font-weight:600;color:var(--text-secondary);margin:0 0 4px")= t.hist_page.empty_title
                p(style="font-size:13px;color:var(--text-muted);margin:0")= t.hist_page.empty_subtitle_mobile
        .hist-cards.mobile-only
            each h in history
                - var initials = (h.name||'').charAt(0).toUpperCase() + (h.surname||'').charAt(0).toUpperCase()
                - var colorIdx2 = (((h.name||'A').charCodeAt(0) + (h.surname||'A').charCodeAt(0)) % 8)
                - var d2 = h.date ? new Date(h.date) : null
                - var dateStr2 = d2 ? d2.toLocaleDateString(lang, { month: 'short', day: 'numeric' }) + ', ' + (h.startTime||'') : '-'
                - var sk2 = (h.status||'confirmed').toLowerCase()
                - var pk2 = sk2 === 'canceled' || sk2 === 'cancelled' ? 'cancelled' : sk2 === 'no-show' ? 'no-show' : sk2 === 'completed' ? 'completed' : 'confirmed'
                - var sl2 = pk2 === 'confirmed' ? (t.hist_page.status_confirmed||'Confirmé') : pk2 === 'cancelled' ? (t.hist_page.status_canceled||'Annulé') : pk2 === 'completed' ? (t.hist_page.status_completed||'Terminé') : (t.hist_page.status_noshow||'No-show')
                .hist-card-mobile(data-id=h._id data-status=sk2)
                    .hist-card__top-row
                        .hist-card__client
                            .hist-avatar(class=`av-${colorIdx2}`)= initials
                            span.hist-card__name= (h.name||'') + ' ' + (h.surname||'')
                        span(class=`pill pill--${pk2}`)
                            span.pill__dot
                            = sl2
                    .hist-card__body
                        if h.serviceName
                            .hist-card__row
                                span.hist-card__lbl= t.hist.table.service
                                span= h.serviceName
                        if h.employeeName
                            .hist-card__row
                                span.hist-card__lbl= t.hist.table.employee
                                span= h.employeeName
                        .hist-card__row
                            span.hist-card__lbl= t.hist_page.date
                            span= dateStr2
                        if h.slotTime
                            .hist-card__row
                                span.hist-card__lbl= t.hist.table.duration
                                span= h.slotTime + ' min'
                    .hist-card__footer
                        a.hist-open-btn(href=`/history/edit/${h._id}`)
                            = t.hist_page.view
                            span.material-symbols-outlined(style="font-size:13px") arrow_forward

            if totalPages > 1
                .hist-pagination
                    span.hist-pag-info Page #{currentPage} / #{totalPages}
                    .hist-pag-center
                        if currentPage > 1
                            a.hist-pag-btn(href=`/history?page=${currentPage - 1}&limit=${currentLimit}`)
                                span.material-symbols-outlined(style="font-size:16px") chevron_left
                        else
                            span.hist-pag-btn.disabled
                                span.material-symbols-outlined(style="font-size:16px") chevron_left
                        if currentPage < totalPages
                            a.hist-pag-btn(href=`/history?page=${currentPage + 1}&limit=${currentLimit}`)
                                span.material-symbols-outlined(style="font-size:16px") chevron_right
                        else
                            span.hist-pag-btn.disabled
                                span.material-symbols-outlined(style="font-size:16px") chevron_right

        //- ── Context menu (kept for compatibility) ────────────────
        .history__actions-panel
            .history__actions-row.show
                .row__icon.flex-c
                    span.material-symbols-outlined(style="font-size:18px") visibility
                .row__text= t.hist_page.view
            .history__actions-row.edit
                .row__icon.flex-c
                    span.material-symbols-outlined(style="font-size:18px") edit
                .row__text= t.hist.edit
            .history__actions-row.delete
                .row__icon.flex-c
                    span.material-symbols-outlined(style="font-size:18px") delete
                .row__text= t.hist.del

block scripts
    script(src="/js/layouts/history.js" type="module")
