extends ../../layouts/admin

block links
    link(rel="stylesheet" href="/css/layouts/services.css")
    link(rel="stylesheet" href="/css/layouts/clients.css")

block content
    .clients-page
        .clients-page__header
            .clients-page__header-left
                h2 Dossiers clients
                p.clients-page__subtitle Gardez un historique de chaque client : constats, soins effectués, suivi d'une visite à l'autre.
            .clients-page__header-right
                span.clients-counter#clientsCounter #{clients.length} client#{clients.length === 1 ? '' : 's'}

        form.clients-search#clientsSearchForm(method="GET" action="/clients")
            svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                path(d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z")
            input.clients-search__input#clientsSearchInput(type="text" name="search" placeholder="Rechercher un client par nom, email ou téléphone..." value=search autocomplete="off")
            if search
                a.clients-search__clear(href="/clients") ✕

        if clients.length === 0
            .clients-empty
                svg(xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="currentColor")
                    path(d="M480-481q66 0 113-47t47-113q0-66-47-113t-113-47q-66 0-113 47t-47 113q0 66 47 113t113 47ZM160-160v-94q0-38 19-65t49-41q67-30 128.5-45T480-420q62 0 123 15.5T731.5-360q31 14 49.5 41t18 65v94H160Z")
                if search
                    p Aucun client ne correspond à « #{search} ».
                else
                    p Dès qu'un client aura réservé un rendez-vous, il apparaîtra ici pour que vous puissiez créer son dossier.

        //- Message "aucun résultat" pour le filtrage instantané côté client
        //- (le filtrage serveur ci-dessus gère le 1er chargement / lien partagé).
        .clients-empty#clientsNoLiveResult(style="display:none")
            svg(xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="currentColor")
                path(d="M480-481q66 0 113-47t47-113q0-66-47-113t-113-47q-66 0-113 47t-47 113q0 66 47 113t113 47ZM160-160v-94q0-38 19-65t49-41q67-30 128.5-45T480-420q62 0 123 15.5T731.5-360q31 14 49.5 41t18 65v94H160Z")
            p#clientsNoLiveResultText

        .clients-list#clientsList
            each c in clients
                -
                    var parts = c.fullName.split(' ').filter(Boolean)
                    var initials = ((parts[0] || '?')[0] + ((parts[1] || '')[0] || '')).toUpperCase()
                - var searchBlob = (c.fullName + ' ' + c.email + ' ' + (c.phone || '')).toLowerCase()
                a.client-card(href=`/clients/${encodeURIComponent(c.email)}` data-search=searchBlob)
                    .client-card__top
                        .client-card__avatar= initials
                        if c.entriesCount > 0
                            span.client-card__badge #{c.entriesCount} note#{c.entriesCount === 1 ? '' : 's'}
                        else
                            span.client-card__badge.client-card__badge--empty Aucune note
                    .client-card__name= c.fullName
                    .client-card__detail
                        svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                            path(d="M200-160q-33 0-56.5-23.5T120-240v-480q0-33 23.5-56.5T200-800h560q33 0 56.5 23.5T840-720v480q0 33-23.5 56.5T760-160H200Zm280-280L200-640v400h560v-400L480-440Zm0-80 280-200H200l280 200ZM200-640v-80 480-400Z")
                        span= c.email
                    if c.phone
                        .client-card__detail
                            svg.icon-phone(xmlns="http://www.w3.org/2000/svg" height="14px" width="14px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                path(d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z")
                            span= c.phone
                    .client-card__visits
                        span.client-card__visit
                            strong Dernière visite
                            |  #{c.lastVisit ? new Date(c.lastVisit).toLocaleDateString('fr-FR') : '—'}
                        span.client-card__visit(class=c.nextVisit ? 'client-card__visit--next' : 'client-card__visit--none')
                            strong Prochain RDV
                            |  #{c.nextVisit ? new Date(c.nextVisit).toLocaleDateString('fr-FR') : 'Aucun'}

    script.
        (function() {
            var input    = document.getElementById('clientsSearchInput');
            var list     = document.getElementById('clientsList');
            var counter  = document.getElementById('clientsCounter');
            var noResult = document.getElementById('clientsNoLiveResult');
            var noResultText = document.getElementById('clientsNoLiveResultText');
            var form     = document.getElementById('clientsSearchForm');
            if (!input || !list) return;

            var cards = Array.prototype.slice.call(list.querySelectorAll('.client-card'));

            function filter() {
                var q = input.value.trim().toLowerCase();
                var visible = 0;
                cards.forEach(function(card) {
                    var match = !q || (card.dataset.search || '').indexOf(q) !== -1;
                    card.style.display = match ? '' : 'none';
                    if (match) visible++;
                });
                if (counter) counter.textContent = visible + ' client' + (visible === 1 ? '' : 's');
                if (noResult) {
                    if (q && visible === 0) {
                        if (noResultText) noResultText.textContent = 'Aucun client ne correspond à « ' + input.value.trim() + ' ».';
                        noResult.style.display = '';
                    } else {
                        noResult.style.display = 'none';
                    }
                }
            }

            input.addEventListener('input', filter);
            // Filtrage déjà instantané au clavier — on évite le rechargement de page.
            if (form) form.addEventListener('submit', function(e) { e.preventDefault(); });
            filter();
        })();
