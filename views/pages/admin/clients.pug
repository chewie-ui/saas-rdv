extends ../../layouts/admin

block links
    link(rel="stylesheet" href="/css/layouts/services.css")
    link(rel="stylesheet" href="/css/layouts/clients.css")

block content
    - const canManageClients = !!(permissions && permissions.clients && permissions.clients.manage)
    .clients-page
        .clients-page__header
            .clients-page__header-left
                h2 #{t.clients.page_title} #{clientTermPlural || 'clients'}
                p.clients-page__subtitle #{t.clients.subtitle_pre} #{clientTerm || 'client'} #{t.clients.subtitle_post}
            .clients-page__header-right
                span.clients-counter#clientsCounter #{clients.length} #{clients.length === 1 ? (clientTerm || 'client') : (clientTermPlural || 'clients')}
                a.sm-btn.sm-btn--ghost.clients-blocked-btn(href=(onlyBlocked ? "/clients" : "/clients?blocked=1") class=(onlyBlocked ? 'is-active' : ''))
                    span.material-symbols-outlined(style=`font-size:16px`) block
                    span= onlyBlocked ? `Tous les ${clientTermPlural || 'clients'}` : `${clientTermCap || 'Clients'} bloqués (${blockedCount || 0})`
                if canManageClients
                    button.sm-btn.sm-btn--primary#openNewClientModal(type="button")
                        span.material-symbols-outlined(style=`font-size:16px`) add
                        span= t.clients.add_btn

        form.clients-search#clientsSearchForm(method="GET" action="/clients")
            span.material-symbols-outlined(style=`font-size:18px`) search
            input.clients-search__input#clientsSearchInput(type="text" name="search" placeholder=`${t.clients.search_pre} ${clientTerm || 'client'} ${t.clients.search_post}` value=search autocomplete="off")
            if search
                a.clients-search__clear(href="/clients") ✕

        if clients.length === 0
            .clients-empty
                span.material-symbols-outlined(style=`font-size:48px`) group
                if search
                    p #{t.clients.empty_search_pre} #{clientTerm || 'client'} #{t.clients.empty_search_mid} « #{search} ».
                else
                    p #{t.clients.empty_hint_pre} #{clientTerm || 'client'} #{t.clients.empty_hint_post}

        //- Message "aucun résultat" pour le filtrage instantané côté client
        //- (le filtrage serveur ci-dessus gère le 1er chargement / lien partagé).
        .clients-empty#clientsNoLiveResult(style="display:none")
            span.material-symbols-outlined(style=`font-size:48px`) group
            p#clientsNoLiveResultText

        .clients-list#clientsList
            each c in clients
                -
                    var parts = c.fullName.split(' ').filter(Boolean)
                    var initials = ((parts[0] || '?')[0] + ((parts[1] || '')[0] || '')).toUpperCase()
                - var searchBlob = (c.fullName + ' ' + c.email + ' ' + (c.phone || '')).toLowerCase()
                a.client-card(href=`/clients/${encodeURIComponent(c.email)}` data-search=searchBlob class=(c.blocked ? 'client-card--blocked' : ''))
                    .client-card__top
                        .client-card__avatar= initials
                        if c.blocked
                            span.client-card__badge.client-card__badge--blocked= t.clients.badge_blocked
                        else if c.entriesCount > 0
                            span.client-card__badge #{c.entriesCount} note#{c.entriesCount === 1 ? '' : 's'}
                        else
                            span.client-card__badge.client-card__badge--empty= t.clients.badge_no_notes
                    .client-card__name= c.fullName
                    .client-card__detail
                        span.material-symbols-outlined(style=`font-size:14px`) mail
                        span= c.email
                    if c.phone
                        .client-card__detail
                            span.material-symbols-outlined.icon-phone(style=`font-size:14px`) call
                            span= c.phone
                    .client-card__visits
                        span.client-card__visit
                            strong= t.clients.last_visit
                            |  #{c.lastVisit ? new Date(c.lastVisit).toLocaleDateString('fr-FR') : '—'}
                        span.client-card__visit(class=c.nextVisit ? 'client-card__visit--next' : 'client-card__visit--none')
                            strong= t.clients.next_appt
                            |  #{c.nextVisit ? new Date(c.nextVisit).toLocaleDateString('fr-FR') : t.clients.no_next_appt}

        if canManageClients
            //- ── Modal : créer un dossier client manuellement ────────────────
            .modal-overlay#newClientModalOverlay
            .service-modal#newClientModal
                .service-modal__header
                    h3= t.clients.modal_title
                    button.modal-close#closeNewClientModal(type="button")
                        span.material-symbols-outlined(style=`font-size:20px`) close
                .service-modal__body
                    .field
                        label= t.clients.field_fullname
                        input.input#newClientFullName(type="text" placeholder="Ex: Marie Dupont")
                    .field
                        label= t.clients.field_email
                        input.input#newClientEmail(type="email" placeholder="email@example.com")
                    .field
                        label= t.clients.field_phone
                        input.input#newClientPhone(type="tel" placeholder="+32 456 00 00 00")
                    .field
                        label= t.clients.field_notes
                        textarea.input.textarea#newClientNotes(rows="3" placeholder=t.clients.field_notes_hint)
                    p.clients-modal__error#newClientError(style="display:none")
                .service-modal__footer
                    button.sm-btn.sm-btn--ghost#cancelNewClientModal(type="button")= t.clients.btn_cancel
                    button.sm-btn.sm-btn--primary#saveNewClientBtn(type="button")
                        span= t.clients.btn_create

    script.
        (function() {
            var input    = document.getElementById('clientsSearchInput');
            var list     = document.getElementById('clientsList');
            var counter  = document.getElementById('clientsCounter');
            var noResult = document.getElementById('clientsNoLiveResult');
            var noResultText = document.getElementById('clientsNoLiveResultText');
            var form     = document.getElementById('clientsSearchForm');
            if (!input || !list) return;

            var termSingular = !{JSON.stringify(clientTerm || 'client')};
            var termPlural   = !{JSON.stringify(clientTermPlural || 'clients')};
            var cards = Array.prototype.slice.call(list.querySelectorAll('.client-card'));

            function filter() {
                var q = input.value.trim().toLowerCase();
                var visible = 0;
                cards.forEach(function(card) {
                    var match = !q || (card.dataset.search || '').indexOf(q) !== -1;
                    card.style.display = match ? '' : 'none';
                    if (match) visible++;
                });
                if (counter) counter.textContent = visible + ' ' + (visible === 1 ? termSingular : termPlural);
                if (noResult) {
                    if (q && visible === 0) {
                        if (noResultText) noResultText.textContent = 'Aucun ' + termSingular + ' ne correspond à « ' + input.value.trim() + ' ».';
                        noResult.style.display = '';
                    } else {
                        noResult.style.display = 'none';
                    }
                }
            }

            input.addEventListener('input', filter);
            // Filtrage déjà instantané au clavier — on évite le rechargement de page.
            if (form) form.addEventListener('submit', function(e) { e.preventDefault(); });
            filter();
        })();

        // ── Modal "Nouveau dossier client" ──────────────────────────────────
        (function() {
            var openBtn   = document.getElementById('openNewClientModal');
            var overlay   = document.getElementById('newClientModalOverlay');
            var modal     = document.getElementById('newClientModal');
            var closeBtn  = document.getElementById('closeNewClientModal');
            var cancelBtn = document.getElementById('cancelNewClientModal');
            var saveBtn   = document.getElementById('saveNewClientBtn');
            var errorEl   = document.getElementById('newClientError');
            var nameInput = document.getElementById('newClientFullName');
            var emailInput = document.getElementById('newClientEmail');
            var phoneInput = document.getElementById('newClientPhone');
            var notesInput = document.getElementById('newClientNotes');
            if (!openBtn || !overlay || !modal) return;

            function showError(msg, field) {
                if (errorEl) {
                    errorEl.textContent = msg;
                    errorEl.style.display = '';
                }
                if (field) { field.classList.add('is-invalid'); field.focus(); }
            }

            function clearError() {
                if (errorEl) errorEl.style.display = 'none';
                nameInput.classList.remove('is-invalid');
                emailInput.classList.remove('is-invalid');
            }

            // On efface l'état d'erreur dès que l'utilisateur corrige un champ.
            nameInput.addEventListener('input', clearError);
            emailInput.addEventListener('input', clearError);

            function open() {
                nameInput.value = '';
                emailInput.value = '';
                phoneInput.value = '';
                notesInput.value = '';
                clearError();
                overlay.classList.add('show');
                modal.classList.add('show');
                nameInput.focus();
            }

            function close() {
                overlay.classList.remove('show');
                modal.classList.remove('show');
            }

            openBtn.addEventListener('click', open);
            if (closeBtn) closeBtn.addEventListener('click', close);
            if (cancelBtn) cancelBtn.addEventListener('click', close);
            overlay.addEventListener('click', close);
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && modal.classList.contains('show')) close();
            });

            if (saveBtn) {
                saveBtn.addEventListener('click', async function() {
                    var fullName = nameInput.value.trim();
                    var email = emailInput.value.trim();
                    if (!fullName) { showError('Le nom est obligatoire.', nameInput); return; }
                    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showError('Adresse e-mail invalide.', emailInput); return; }

                    saveBtn.disabled = true;
                    try {
                        var res = await fetch('/clients/create', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                fullName: fullName,
                                email: email,
                                phone: phoneInput.value.trim(),
                                generalInfo: notesInput.value.trim(),
                            }),
                        });
                        var data = await res.json();
                        if (!res.ok || !data.success) {
                            showError(data.error || 'Erreur serveur.');
                            saveBtn.disabled = false;
                            return;
                        }
                        window.location.href = '/clients/' + encodeURIComponent(data.email);
                    } catch (e) {
                        showError('Erreur réseau.');
                        saveBtn.disabled = false;
                    }
                });
            }
        })();
