                #avnCalGrid(style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px")
                p(style="margin:14px 2px 0;font:500 11.5px/1.5 'Plus Jakarta Sans',sans-serif;color:#98a29b") Cliquez les jours à bloquer. Un point vert signale un congé déjà enregistré.
                #avnCalBar(hidden style="margin-top:14px;display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:999px;background:#12a06e")
                    span#avnCalCount(style="flex:1;font:700 13px/1 'Plus Jakarta Sans',sans-serif;color:#fff")
                    button#avnCalClear(type="button" style="width:26px;height:26px;border-radius:50%;border:0;background:rgba(255,255,255,.2);color:#fff;cursor:pointer;font:400 12px/1 'Plus Jakarta Sans',sans-serif") ✕
                    button#avnCalNextStep(type="button" style="height:32px;padding:0 14px;border-radius:999px;border:0;background:#fff;color:#0c5e42;cursor:pointer;font:700 12.5px/1 'Plus Jakarta Sans',sans-serif;white-space:nowrap") Suivant

        //- ═══ MODALE : POUR QUI ═══
        .avn-overlay#avnWhoOv(hidden style="position:fixed;inset:0;z-index:63;background:rgba(8,26,18,.5);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;padding:24px")
            div(style="width:100%;max-width:440px;background:#fff;border-radius:20px;box-shadow:0 40px 80px -30px rgba(8,26,18,.55)")
                div(style="padding:24px 24px 0")
                    h2#avnWhoTitle(style="margin:0;font:800 19px/1.25 'Plus Jakarta Sans',sans-serif;letter-spacing:-.02em;color:#141a17")
                    div(style="margin-top:18px;display:flex;flex-direction:column;gap:9px")
                        button.avn-whoopt(type="button" data-avnwho="all" style=`display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:14px 15px;border-radius:12px;cursor:pointer;border:1.5px solid ${ACCENT};background:#e9f7f0;font:600 13.5px/1 'Plus Jakarta Sans',sans-serif;color:#0c5e42`)
                            span(style=`width:18px;height:18px;flex:none;border-radius:50%;border:1.5px solid ${ACCENT};display:flex;align-items:center;justify-content:center`)
                                span.avn-dot(style=`width:8px;height:8px;border-radius:50%;background:${ACCENT}`)
                            | Tous les employés
                        button.avn-whoopt(type="button" data-avnwho="some" style="display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:14px 15px;border-radius:12px;cursor:pointer;border:1.5px solid #e6eae7;background:#fff;font:600 13.5px/1 'Plus Jakarta Sans',sans-serif;color:#1a201d")
                            span(style="width:18px;height:18px;flex:none;border-radius:50%;border:1.5px solid #cfd6d1;display:flex;align-items:center;justify-content:center")
                                span.avn-dot(style="width:8px;height:8px;border-radius:50%;background:transparent")
                            | Sélectionner des employés
                        #avnWhoList(hidden style="display:flex;flex-direction:column;gap:7px;padding-left:6px")
                            each e in _emps
                                button.avn-whoemp(type="button" data-avnemp=String(e._id) style="display:flex;align-items:center;gap:11px;width:100%;text-align:left;padding:12px 14px;border:0;border-radius:11px;cursor:pointer;background:#f7faf8;font:600 13px/1 'Plus Jakarta Sans',sans-serif;color:#1a201d")
                                    span.avn-check(style="width:18px;height:18px;flex:none;border-radius:6px;border:1.5px solid #d6dade;background:#fff;color:#fff;display:flex;align-items:center;justify-content:center;font:700 10px/1 'Plus Jakarta Sans',sans-serif")
                                    = e.nom
                div(style="margin-top:22px;padding:16px 24px;border-top:1px solid #eef0ee;display:flex;justify-content:space-between;gap:10px")
                    button#avnWhoBack(type="button" style="height:42px;padding:0 16px;border-radius:11px;border:1px solid #e6eae7;background:#fff;cursor:pointer;font:600 12.5px/1 'Plus Jakarta Sans',sans-serif;color:#5f6b64") ← Dates
                    div(style="display:flex;gap:10px")
                        button.avn-btn-ghost(type="button" data-avnclose style="height:42px;padding:0 16px;border-radius:11px;border:1px solid #e6eae7;background:#fff;cursor:pointer;font:600 12.5px/1 'Plus Jakarta Sans',sans-serif;color:#1a201d") Annuler
                        button#avnWhoConfirm(type="button" style="height:42px;padding:0 20px;border-radius:11px;border:0;background:#12a06e;color:#fff;cursor:pointer;font:700 12.5px/1 'Plus Jakarta Sans',sans-serif") Confirmer

        //- ═══ MODALE : SUPPRESSION DE CONGÉ ═══
        .avn-overlay#avnDelOv(hidden style="position:fixed;inset:0;z-index:64;background:rgba(8,26,18,.5);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;padding:24px")
            div(style="width:100%;max-width:400px;background:#fff;border-radius:20px;padding:26px;box-shadow:0 40px 80px -30px rgba(8,26,18,.55)")
                span(style="width:44px;height:44px;border-radius:14px;background:#fbecea;color:#c2554b;display:flex;align-items:center;justify-content:center")
                    svg(width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        path(d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6")
                h2(style="margin:18px 0 0;font:800 19px/1.25 'Plus Jakarta Sans',sans-serif;letter-spacing:-.02em;color:#141a17") Supprimer ce jour de congé ?
                p(style="margin:11px 0 0;font:400 13.5px/1.6 'Plus Jakarta Sans',sans-serif;color:#8c968f")
                    strong#avnDelLabel(style="color:#1a201d")
                    |  redeviendra réservable pour&nbsp;
                    span#avnDelWho
                    | . Les rendez-vous déjà pris ne sont pas affectés.
                div(style="margin-top:22px;display:flex;justify-content:flex-end;gap:10px")
                    button.avn-btn-ghost(type="button" data-avnclose style="height:42px;padding:0 16px;border-radius:11px;border:1px solid #e6eae7;background:#fff;cursor:pointer;font:600 12.5px/1 'Plus Jakarta Sans',sans-serif;color:#1a201d") Annuler
                    button#avnDelConfirm(type="button" style="height:42px;padding:0 18px;border-radius:11px;border:0;background:#c2554b;color:#fff;cursor:pointer;font:700 12.5px/1 'Plus Jakarta Sans',sans-serif") Supprimer

        //- ═══ MODALE : SÉLECTEUR D'HEURE ═══
        .avn-overlay#avnTimeOv(hidden style="position:fixed;inset:0;z-index:65;background:rgba(8,26,18,.5);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;padding:24px")
            div(style="width:100%;max-width:320px;background:#fff;border-radius:20px;box-shadow:0 40px 80px -30px rgba(8,26,18,.55);overflow:hidden")
                div(style="padding:18px 18px 0;display:flex;align-items:center;justify-content:space-between;gap:12px")
                    h2#avnTimeTitle(style="margin:0;font:700 15px/1.2 'Plus Jakarta Sans',sans-serif;letter-spacing:-.02em;color:#141a17")
                    button.avn-x(type="button" data-avnclose style="width:32px;height:32px;border-radius:10px;border:1px solid #e6eae7;background:#fff;cursor:pointer;color:#5f6b64;font:400 14px/1 'Plus Jakarta Sans',sans-serif") ✕
                div(style="padding:14px 18px")
                    input#avnTimeQuery(type="text" placeholder="Tapez une heure — ex : 18 ou 09:30" style=`width:100%;height:44px;padding:0 14px;border:1.5px solid ${ACCENT};border-radius:12px;background:#fff;outline:none;font:500 13.5px/1 'Plus Jakarta Sans',sans-serif;color:#1a201d`)
                #avnTimeList(style="max-height:260px;overflow-y:auto;padding:0 10px 14px")

        script#avnSchedule(type="application/json")!= JSON.stringify(_jours)
        script#avnConges(type="application/json")!= JSON.stringify(_conges)
        script#avnEmployees(type="application/json")!= JSON.stringify(_emps.map(function (e) { return { id: String(e._id), name: e.nom }; }))
        -
            var _cfg = {
                companyId: String(currentCompany._id),
                scheduleMode: scheduleMode,
                selectedEmployeeId: String(selectedEmployeeId || ''),
                canEdit: !!canEditSchedule,
                slotInterval: _pas, slotMode: _slotMode, slotTime: Number(currentSlotTime) || 30,
                bufferBefore: _bufBefore, bufferAfter: _battement,
                leadOn: _leadOn, leadMinutes: _lead,
                horizonDays: _horizon,
                autoConfirm: _autoConfirm, waitlist: _waitlist, overbooking: _overbooking,
                phoneRequired: _phoneRequired,
                sgOn: _sgOn, sgWindow: _sgWindow, sgDays: _sgDays,
                features: { ranges: !!_feat.ranges, buffer: !!_feat.buffer, slotDuration: !!_feat.slotDuration },
            };
        script#avnConfig(type="application/json")!= JSON.stringify(_cfg)

    script(src="/js/layouts/availability-new.js" defer)
