        style.
            /* ── Liste ── */
            .section-order-list {
                display: flex;
                flex-direction: column;
                gap: 0;
                margin-top: 8px;
                position: relative;
            }

            /* ── Item draggable ── */
            .section-order-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                background: var(--surface-card);
                border: 1.5px solid var(--border-light);
                border-radius: 12px;
                margin-bottom: 6px;
                cursor: grab;
                user-select: none;
                transition: box-shadow .18s, border-color .15s, background .12s, transform .12s, opacity .15s;
                position: relative;
            }

            .section-order-item:hover:not(.section-order-item--locked) {
                border-color: var(--border-medium);
                box-shadow: 0 2px 10px rgba(0,0,0,.06);
            }

            /* Item en train d'être glissé */
            .section-order-item.is-dragging {
                opacity: 0;
                pointer-events: none;
            }

            /* Fantôme (clone visuel) */
            .section-order-item.drag-ghost {
                position: fixed;
                z-index: 9999;
                pointer-events: none;
                box-shadow: 0 12px 32px rgba(0,0,0,.18);
                border-color: var(--accent);
                background: var(--surface-card);
                border-radius: 12px;
                opacity: .96;
                transform: rotate(1.2deg) scale(1.02);
                cursor: grabbing;
                transition: none;
            }

            /* Ligne indicatrice de dépôt */
            .section-order-item.drop-before::before,
            .section-order-item.drop-after::after {
                content: '';
                display: block;
                position: absolute;
                left: 12px;
                right: 12px;
                height: 2.5px;
                border-radius: 99px;
                background: var(--accent);
                box-shadow: 0 0 6px rgba(22,163,74,.4);
                z-index: 10;
            }
            .section-order-item.drop-before::before { top: -4px; }
            .section-order-item.drop-after::after   { bottom: -4px; }

            /* Item verrouillé */
            .section-order-item--locked {
                cursor: default;
                background: var(--surface);
                border-style: dashed;
                border-color: var(--border-light);
            }
            .section-order-item--locked:hover { box-shadow: none; border-color: var(--border-light); }

            /* Éléments internes */
            .section-order-item__grip {
                color: var(--text-muted);
                flex-shrink: 0;
                display: flex;
                opacity: .45;
                transition: opacity .15s;
            }
            .section-order-item:hover .section-order-item__grip { opacity: .9; }
            .section-order-item__grip svg  { fill: currentColor; }
            .section-order-item__icon      { fill: var(--accent); flex-shrink: 0; }
            .section-order-item__label     { font-size: 13.5px; font-weight: 600; color: var(--text-primary); flex: 1; }
            .section-order-item__lock      { display:inline-flex; align-items:center; gap:4px; font-size:11px; font-weight:600; color:var(--text-muted); white-space:nowrap; background:var(--surface); border:1px solid var(--border-light); border-radius:99px; padding:2px 8px; }
            .section-order-item__lock svg  { fill: var(--text-muted); }
            .section-order-status          { font-size: 12.5px; min-height: 18px; margin-top: 2px; color: var(--accent); font-weight: 600; transition: opacity .3s; }
        script.
            (function() {
                var list   = document.getElementById('sectionOrderList');
                var status = document.getElementById('sectionOrderStatus');
                if (!list) return;

                var dragged    = null;
                var ghost      = null;
                var offsetX    = 0;
                var offsetY    = 0;

                function getMovable() {
                    return Array.from(list.querySelectorAll('.section-order-item:not(.section-order-item--locked):not(.drag-ghost)'));
                }

                function clearDropIndicators() {
                    list.querySelectorAll('.drop-before,.drop-after').forEach(function(i) {
                        i.classList.remove('drop-before','drop-after');
                    });
                }

                function createGhost(item, e) {
                    var rect = item.getBoundingClientRect();
                    offsetX  = e.clientX - rect.left;
                    offsetY  = e.clientY - rect.top;
                    ghost    = item.cloneNode(true);
                    ghost.classList.add('drag-ghost');
                    ghost.style.width  = rect.width  + 'px';
                    ghost.style.height = rect.height + 'px';
                    ghost.style.left   = (e.clientX - offsetX) + 'px';
                    ghost.style.top    = (e.clientY - offsetY) + 'px';
                    document.body.appendChild(ghost);
                }

                function moveGhost(e) {
                    if (!ghost) return;
                    ghost.style.left = (e.clientX - offsetX) + 'px';
                    ghost.style.top  = (e.clientY - offsetY) + 'px';
                }

                function removeGhost() {
                    if (ghost) { ghost.remove(); ghost = null; }
                }

                function findDropTarget(e) {
                    // Retourne {item, position:'before'|'after'} ou null
                    var items = getMovable();
                    for (var i = 0; i < items.length; i++) {
                        var item = items[i];
                        if (item === dragged) continue;
                        var rect  = item.getBoundingClientRect();
                        var midY  = rect.top + rect.height / 2;
                        if (e.clientY >= rect.top - 8 && e.clientY <= rect.bottom + 8) {
                            return { item: item, pos: e.clientY < midY ? 'before' : 'after' };
                        }
                    }
                    return null;
                }

                getMovable().forEach(function(item) {
                    item.addEventListener('mousedown', function(e) {
                        if (e.button !== 0) return;
                        dragged = this;
                        createGhost(this, e);
                        setTimeout(function() { if (dragged) dragged.classList.add('is-dragging'); }, 0);
                        e.preventDefault();
                    });
                });

                document.addEventListener('mousemove', function(e) {
                    if (!dragged) return;
                    moveGhost(e);
                    clearDropIndicators();
                    var target = findDropTarget(e);
                    if (target) {
                        target.item.classList.add(target.pos === 'before' ? 'drop-before' : 'drop-after');
                    }
                });

                document.addEventListener('mouseup', function(e) {
                    if (!dragged) return;
                    clearDropIndicators();
                    var target = findDropTarget(e);
                    if (target) {
                        if (target.pos === 'before') {
                            list.insertBefore(dragged, target.item);
                        } else {
                            list.insertBefore(dragged, target.item.nextSibling);
                        }
                    }
                    dragged.classList.remove('is-dragging');
                    removeGhost();
                    dragged = null;
                    saveOrder();
                });

                async function saveOrder() {
                    var order = getMovable().map(function(i) { return i.dataset.key; }).filter(Boolean);
                    try {
                        var r = await fetch('/account/section-order', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ order: order })
                        });
                        var d = await r.json();
                        if (d.success && status) {
                            status.style.opacity = '1';
                            status.textContent = '✓ Ordre enregistré';
                            setTimeout(function() { status.style.opacity = '0'; setTimeout(function(){ status.textContent=''; status.style.opacity='1'; }, 300); }, 2000);
                        }
                    } catch(e) {}
                }
            })();

