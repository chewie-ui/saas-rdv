block scripts
    script.
        (function () {

            var DEFAULTS = {
                pageBg:      '#f3f4f6',
                calBg:       '#ffffff',
                accentColor: '#22c55e',
                accentText:  '#ffffff',
                dayBg:       '#ffffff',
                dayText:     '#111111',
                btnBg:       '#111111',
                btnText:     '#ffffff',
                lang:        'fr',
                font:        'Inter',
                showInfo:    true,
                showSocials: true,
                layoutStyle: 'classic',
                pageBgType:  'color',
                pageBgImage: '',
                showSectionAbout:    true,
                showSectionServices: false,
                showSectionTeam:     false
            };

            var settings = Object.assign({}, DEFAULTS, !{JSON.stringify(calendarSettings)});

            var frame     = document.getElementById('previewFrame');
            var pvPage    = document.getElementById('pvPage');
            var pvContent = document.getElementById('pvContent');
            var pvInfo    = document.getElementById('pvInfo');
            var pvSocial  = document.getElementById('pvSocial');
            var pvTitleBar = document.getElementById('pvTitleBar');

            var HEX_RE = new RegExp('^#[0-9A-Fa-f]{6}$');

            var CSS_VAR_MAP = {
                pageBg:      '--pv-page-bg',
                calBg:       '--pv-cal-bg',
                accentColor: '--pv-accent',
                accentText:  '--pv-accent-text',
                dayBg:       '--pv-day-bg',
                dayText:     '--pv-day-text',
                btnBg:       '--pv-btn-bg',
                btnText:     '--pv-btn-text'
            };

            function updateBgPreview() {
                if (settings.pageBgType === 'image' && settings.pageBgImage) {
                    pvPage.style.backgroundImage    = 'url(' + settings.pageBgImage + ')';
                    pvPage.style.backgroundSize     = 'cover';
                    pvPage.style.backgroundPosition = 'center';
                    pvPage.style.removeProperty('background-color');
                } else {
                    pvPage.style.backgroundImage = 'none';
                    pvPage.style.backgroundSize  = '';
                    pvPage.style.removeProperty('background-color');
                    if (frame) frame.style.setProperty('--pv-page-bg', settings.pageBg || DEFAULTS.pageBg);
                }
            }

            function applyLayout(layout) {
                pvContent.dataset.layout = layout;
                // title bar only visible in 'title' layout
                pvTitleBar.style.display = (layout === 'title') ? '' : 'none';
                // in classic, info panel controlled by showInfo toggle
                if (layout === 'classic') {
                    pvInfo.style.display = settings.showInfo ? '' : 'none';
                } else {
                    pvInfo.style.display = 'none';
                }
            }

            function activateBgTab(tabName) {
                document.querySelectorAll('.bg-tab').forEach(function (t) {
                    t.classList.toggle('active', t.dataset.tab === tabName);
                });
                document.querySelectorAll('.bg-panel').forEach(function (p) {
                    p.classList.toggle('hidden', p.dataset.tab !== tabName);
                });
            }

            function applyPreview(key, value) {
                if (!frame) return;
                if (CSS_VAR_MAP[key]) {
                    frame.style.setProperty(CSS_VAR_MAP[key], value);
                    if (key === 'pageBg') updateBgPreview();
                } else if (key === 'layoutStyle') {
                    applyLayout(value);
                } else if (key === 'showInfo') {
                    if (settings.layoutStyle === 'classic') {
                        pvInfo.style.display = value ? '' : 'none';
                    }
                } else if (key === 'showSocials') {
                    pvSocial.style.display = value ? '' : 'none';
                } else if (key === 'font') {
                    pvPage.style.fontFamily = value + ', sans-serif';
                } else if (key === 'pageBgType' || key === 'pageBgImage') {
                    updateBgPreview();
                }
            }

            function initAll() {
                // ── Colors ──────────────────────────────────────────────────
                document.querySelectorAll('.color-row').forEach(function (row) {
                    var key    = row.dataset.key;
                    var swatch = row.querySelector('input[type=color]');
                    var hex    = row.querySelector('.color-hex');
                    var val    = (settings[key] !== undefined ? settings[key] : DEFAULTS[key]) || DEFAULTS[key];

                    swatch.value = val;
                    hex.value    = val;
                    applyPreview(key, val);

                    swatch.addEventListener('input', function () {
                        hex.value     = swatch.value;
                        settings[key] = swatch.value;
                        applyPreview(key, swatch.value);
                    });
                    hex.addEventListener('input', function () {
                        var v = hex.value.trim();
                        if (HEX_RE.test(v)) {
                            swatch.value  = v;
                            settings[key] = v;
                            applyPreview(key, v);
                        }
                    });
                });

                // ── Layout cards ──────────────────────────────────────────────
                var layoutVal   = settings.layoutStyle || 'classic';
                var layoutRadio = document.querySelector('input[name=layoutStyle][value="' + layoutVal + '"]');
                if (layoutRadio) layoutRadio.checked = true;
                applyLayout(layoutVal);

                document.querySelectorAll('input[name=layoutStyle]').forEach(function (radio) {
                    radio.addEventListener('change', function () {
                        settings.layoutStyle = radio.value;
                        applyPreview('layoutStyle', radio.value);
                    });
                });

                // ── Toggles ───────────────────────────────────────────────────
                var showInfoCb    = document.getElementById('toggleShowInfo');
                var showSocialsCb = document.getElementById('toggleShowSocials');

                showInfoCb.checked    = settings.showInfo    !== false;
                showSocialsCb.checked = settings.showSocials !== false;
                applyPreview('showInfo',    showInfoCb.checked);
                applyPreview('showSocials', showSocialsCb.checked);

                showInfoCb.addEventListener('change', function () {
                    settings.showInfo = showInfoCb.checked;
                    applyPreview('showInfo', showInfoCb.checked);
                });
                showSocialsCb.addEventListener('change', function () {
                    settings.showSocials = showSocialsCb.checked;
                    applyPreview('showSocials', showSocialsCb.checked);
                });

                // ── Section toggles ───────────────────────────────────────────
                var sectionAboutCb    = document.getElementById('toggleSectionAbout');
                var sectionServicesCb = document.getElementById('toggleSectionServices');
                var sectionTeamCb     = document.getElementById('toggleSectionTeam');

                sectionAboutCb.checked    = settings.showSectionAbout    !== false;
                sectionServicesCb.checked = !!settings.showSectionServices;
                sectionTeamCb.checked     = !!settings.showSectionTeam;

                sectionAboutCb.addEventListener('change', function () {
                    settings.showSectionAbout = sectionAboutCb.checked;
                });
                sectionServicesCb.addEventListener('change', function () {
                    settings.showSectionServices = sectionServicesCb.checked;
                });
                sectionTeamCb.addEventListener('change', function () {
                    settings.showSectionTeam = sectionTeamCb.checked;
                });

                // ── Font ──────────────────────────────────────────────────────
                var fontSelect  = document.getElementById('fontSelect');
                fontSelect.value = settings.font || 'Inter';
                applyPreview('font', fontSelect.value);
                fontSelect.addEventListener('change', function () {
                    settings.font = fontSelect.value;
                    applyPreview('font', fontSelect.value);
                });

                // ── Background tabs ───────────────────────────────────────────
                document.querySelectorAll('.bg-tab').forEach(function (tab) {
                    tab.addEventListener('click', function () {
                        settings.pageBgType = tab.dataset.tab;
                        activateBgTab(tab.dataset.tab);
                        updateBgPreview();
                    });
                });
                activateBgTab(settings.pageBgType || 'color');

                // ── Background image upload ───────────────────────────────────
                var bgInput    = document.getElementById('bgImageInput');
                var bgArea     = document.getElementById('bgUploadArea');
                var bgPreview  = document.getElementById('bgUploadPreview');
                var removeBgBtn = document.getElementById('removeBgImage');

                if (settings.pageBgImage) {
                    bgPreview.style.backgroundImage    = 'url(' + settings.pageBgImage + ')';
                    bgPreview.style.backgroundSize     = 'cover';
                    bgPreview.style.backgroundPosition = 'center';
                    document.getElementById('bgUploadHint').style.display = 'none';
                    removeBgBtn.style.display = '';
                }

                bgArea.addEventListener('click', function () { bgInput.click(); });
                bgInput.addEventListener('change', function () {
                    var file = bgInput.files[0];
                    if (!file) return;
                    bgArea.classList.add('loading');
                    var fd = new FormData();
                    fd.append('calendarBgImage', file);
                    fetch('/account/calendar-bg-image', { method: 'PATCH', body: fd })
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            bgArea.classList.remove('loading');
                            if (data.success) {
                                settings.pageBgImage = data.path;
                                settings.pageBgType  = 'image';
                                bgPreview.style.backgroundImage    = 'url(' + data.path + ')';
                                bgPreview.style.backgroundSize     = 'cover';
                                bgPreview.style.backgroundPosition = 'center';
                                document.getElementById('bgUploadHint').style.display = 'none';
                                removeBgBtn.style.display = '';
                                activateBgTab('image');
                                updateBgPreview();
                            }
                        })
                        .catch(function () { bgArea.classList.remove('loading'); });
                });

                removeBgBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    settings.pageBgImage = '';
                    settings.pageBgType  = 'color';
                    bgPreview.style.backgroundImage = '';
                    bgPreview.style.backgroundSize  = '';
                    document.getElementById('bgUploadHint').style.display = '';
                    removeBgBtn.style.display = 'none';
                    bgInput.value = '';
                    activateBgTab('color');
                    updateBgPreview();
                });

                // Initial bg preview
                updateBgPreview();
            }

            initAll();

            // ── Save ──────────────────────────────────────────────────────────
            document.getElementById('saveCalendarSettings').addEventListener('click', async function () {
                var btn  = this;
                var span = btn.querySelector('span');
                span.textContent = '...';
                btn.disabled = true;

                var payload = Object.assign({}, settings);

                try {
                    var r    = await fetch('/account/calendar-settings', {
                        method:  'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body:    JSON.stringify(payload)
                    });
                    var data = await r.json();
                    span.textContent = data.success ? '✓ Enregistré' : '✗ Erreur';
                } catch (e) {
                    span.textContent = '✗ Erreur';
                }
                btn.disabled = false;
                setTimeout(function () { span.textContent = '#{t.customize.save}'; }, 2500);
            });

            // ── Reset ─────────────────────────────────────────────────────────
            document.getElementById('resetCalendarSettings').addEventListener('click', function () {
                // Colors
                Object.keys(DEFAULTS).forEach(function (key) {
                    if (key === 'lang' || key === 'showInfo' || key === 'showSocials' ||
                        key === 'layoutStyle' || key === 'pageBgType' || key === 'pageBgImage' || key === 'font' ||
                        key === 'showSectionAbout' || key === 'showSectionServices' || key === 'showSectionTeam') return;
                    settings[key] = DEFAULTS[key];
                    applyPreview(key, DEFAULTS[key]);
                    var row = document.querySelector('.color-row[data-key="' + key + '"]');
                    if (row) {
                        row.querySelector('input[type=color]').value = DEFAULTS[key];
                        row.querySelector('.color-hex').value        = DEFAULTS[key];
                    }
                });
                // Layout
                settings.layoutStyle = 'classic';
                var classicR = document.querySelector('input[name=layoutStyle][value="classic"]');
                if (classicR) classicR.checked = true;
                applyLayout('classic');
                // Toggles
                settings.showInfo    = true;
                settings.showSocials = true;
                document.getElementById('toggleShowInfo').checked    = true;
                document.getElementById('toggleShowSocials').checked = true;
                applyPreview('showSocials', true);
                // Section toggles
                settings.showSectionAbout    = true;
                settings.showSectionServices = false;
                settings.showSectionTeam     = false;
                document.getElementById('toggleSectionAbout').checked    = true;
                document.getElementById('toggleSectionServices').checked = false;
                document.getElementById('toggleSectionTeam').checked     = false;
                // Font
                settings.font = 'Inter';
                document.getElementById('fontSelect').value = 'Inter';
                applyPreview('font', 'Inter');
                // Bg
                settings.pageBgType  = 'color';
                settings.pageBgImage = '';
                var bgPreview = document.getElementById('bgUploadPreview');
                bgPreview.style.backgroundImage = '';
                bgPreview.style.backgroundSize  = '';
                document.getElementById('bgUploadHint').style.display = '';
                document.getElementById('removeBgImage').style.display = 'none';
                document.getElementById('bgImageInput').value = '';
                activateBgTab('color');
                updateBgPreview();
            });

        })();
