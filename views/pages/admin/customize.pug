block scripts
    style.
        /* ── Header & onglets ── */
        .cz-header {
            margin-bottom: 0;
            padding-bottom: 0;
        }
        .cz-header__top {
            padding: 0 0 16px;
        }
        .cz-header__title {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px;
        }
        .cz-header__sub {
            font-size: 13.5px;
            color: var(--text-secondary);
            margin: 0;
        }
        .cz-tabs {
            display: flex;
            gap: 0;
            border-bottom: 1.5px solid var(--border-light);
            margin-bottom: 24px;
        }
        .cz-tab {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 10px 18px;
            background: none;
            border: none;
            border-bottom: 2.5px solid transparent;
            margin-bottom: -1.5px;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-secondary);
            cursor: pointer;
            transition: color 0.15s, border-color 0.15s;
        }
        .cz-tab:hover { color: var(--text-primary); }
        .cz-tab.is-active {
            color: var(--primary, #22c55e);
            border-bottom-color: var(--primary, #22c55e);
            font-weight: 600;
        }
        /* ── Rappels ── */
        .cz-reminder-gate {
            text-align: center;
            padding: 48px 24px;
            background: var(--surface-card);
            border: 1.5px solid var(--border-light);
            border-radius: 16px;
            color: var(--text-secondary);
        }
        .cz-reminder-gate svg { color: var(--text-muted); margin-bottom: 12px; }
        .cz-reminder-gate h3 { font-size: 16px; font-weight: 700; color: var(--text-primary); margin: 0 0 8px; }
        .cz-reminder-gate p  { margin: 0 0 20px; font-size: 14px; }
        .cz-reminder-header-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            background: #f0fdf4;
            border-radius: 9px;
            color: #22c55e;
            margin-right: 12px;
            flex-shrink: 0;
        }
        .info-card__header { display: flex; align-items: flex-start; }
        .cz-reminder-section {
            padding: 18px 22px;
            border-top: 1px solid var(--border-light);
        }
        .cz-reminder-label {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 12px;
        }
        .cz-reminder-label svg { color: var(--text-secondary); }
        .cz-reminder-hint {
            font-size: 12.5px;
            color: var(--text-secondary);
            margin: -6px 0 12px;
            line-height: 1.5;
        }
        /* Boutons délai */
        .cz-delay-options {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .cz-delay-btn {
            padding: 7px 16px;
            border-radius: 100px;
            border: 1.5px solid var(--border-light);
            background: var(--surface-card);
            font-size: 13px;
            font-weight: 500;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.15s;
        }
        .cz-paymethod-options {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .cz-delay-btn:hover { border-color: #22c55e; color: #22c55e; }
        .cz-delay-btn.is-active {
            background: #22c55e;
            border-color: #22c55e;
            color: #fff;
            font-weight: 600;
        }
        /* Textarea message */
        .cz-reminder-msg-wrap { position: relative; }
        .cz-reminder-msg {
            width: 100%;
            box-sizing: border-box;
            padding: 11px 14px;
            border: 1.5px solid var(--border-light);
            border-radius: 10px;
            font-size: 13.5px;
            color: var(--text-primary);
            background: var(--surface-card);
            resize: vertical;
            line-height: 1.5;
            transition: border-color 0.15s, box-shadow 0.15s;
            font-family: inherit;
        }
        .cz-reminder-msg:focus {
            outline: none;
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.1);
        }
        .cz-reminder-msg-count {
            text-align: right;
            font-size: 11.5px;
            color: var(--text-muted);
            margin-top: 5px;
        }
        /* Preview */
        .cz-reminder-preview-section { background: var(--surface-alt, #fafafa); border-radius: 0 0 12px 12px; }
        .cz-reminder-preview {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 16px 20px;
            max-width: 400px;
        }
        .cz-preview-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #1a7a4a;
            color: #fff;
            font-size: 12px;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 100px;
            margin-bottom: 10px;
        }
        .cz-preview-delay {
            font-size: 13px;
            color: #6b7280;
            margin: 0 0 10px;
        }
        .cz-preview-msg-box {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 8px;
            padding: 10px 14px;
        }
        .cz-preview-msg-label {
            font-size: 11px;
            font-weight: 600;
            color: #15803d;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            margin-bottom: 5px;
        }
        .cz-preview-msg-text {
            font-size: 13px;
            color: #1e2923;
            font-style: italic;
            margin: 0;
            line-height: 1.5;
        }
        .cz-reminder-status {
            font-size: 13px;
            color: #22c55e;
            margin-left: 10px;
        }

