    script(src='/js/layouts/customize.js')
    script.
        // ── Gestion des onglets Général / Rappels / Design / Intégration ──────
        (function() {
            var tabs = {
                general:     document.getElementById('czTabGeneral'),
                rappels:     document.getElementById('czTabRappels'),
                design:      document.getElementById('czTabDesign'),
                integration: document.getElementById('czTabIntegration')
            };
            var panels = {
                rappels:     document.getElementById('czPanelRappels'),
                design:      document.getElementById('czPanelDesign'),
                integration: document.getElementById('czPanelIntegration')
            };
            var infoPage = document.querySelector('.info-page');

            // Tous les enfants directs de .info-page qui sont des "general cards"
            function getGeneralEls() {
                return Array.from(infoPage.children).filter(function(el) {
                    return !el.classList.contains('cz-header') &&
                           el.id !== 'czPanelGeneral' &&
                           el.id !== 'czPanelRappels' &&
                           el.id !== 'czPanelDesign' &&
                           el.id !== 'czPanelIntegration';
                });
            }

            var designVisible = false;

            function showTab(name) {
                // Tabs actifs
                Object.keys(tabs).forEach(function(k) {
                    if (tabs[k]) tabs[k].classList.toggle('is-active', k === name);
                });
                // Panels
                Object.keys(panels).forEach(function(k) {
                    if (panels[k]) panels[k].style.display = (k === name) ? 'block' : 'none';
                });
                // Cartes générales
                var showGeneral = (name === 'general');
                getGeneralEls().forEach(function(el) {
                    el.style.display = showGeneral ? '' : 'none';
                });
                // Charger le preview design au premier affichage
                if (name === 'design' && !designVisible) {
                    designVisible = true;
                    document.dispatchEvent(new Event('czDesignVisible'));
                }
                // Rafraîchir l'aperçu d'intégration à chaque affichage de l'onglet
                // (pour refléter les changements de design enregistrés entre-temps)
                if (name === 'integration') {
                    document.dispatchEvent(new Event('czIntegrationVisible'));
                }
            }

            Object.keys(tabs).forEach(function(k) {
                if (tabs[k]) tabs[k].addEventListener('click', function() { showTab(k); });
            });

            // Hash navigation
            var hash = window.location.hash.replace('#', '');
            if (hash && tabs[hash]) showTab(hash);
        })();

    script.
        (function () {
            var __services = !{JSON.stringify(services)};

            // ── Business type autocomplete ────────────────────────────────────
            var btInput   = document.getElementById('businessTypeInput');
            var btDropdown = document.getElementById('businessTypeDropdown');

            function normalize(str) {
                return str.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
            }
            function renderBtList(items) {
                btDropdown.innerHTML = '';
                if (!items.length) { btDropdown.style.display = 'none'; return; }
                items.forEach(function (item) {
                    var div = document.createElement('div');
                    div.className = 'service-dropdown__item';
                    div.textContent = item;
                    div.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                        btInput.value = item;
                        btDropdown.style.display = 'none';
                    });
                    btDropdown.appendChild(div);
                });
                btDropdown.style.display = 'block';
            }
            if (btInput && btDropdown) {
                btInput.addEventListener('input', function () {
                    var q = normalize(btInput.value.trim());
                    if (!q) { btDropdown.style.display = 'none'; return; }
                    renderBtList(__services.filter(function (s) { return normalize(s).includes(q); }).slice(0, 8));
                });
                btInput.addEventListener('focus', function () {
                    var q = normalize(btInput.value.trim());
                    if (q) renderBtList(__services.filter(function (s) { return normalize(s).includes(q); }).slice(0, 8));
                });
                btInput.addEventListener('blur', function () {
                    setTimeout(function () { btDropdown.style.display = 'none'; }, 150);
                });
            }

            // ── Description counter ───────────────────────────────────────────
            var textarea = document.getElementById('descriptionCoach');
            var counter  = document.getElementById('descCount');
            if (textarea && counter) {
                textarea.addEventListener('input', function () {
                    counter.textContent = textarea.value.length + '/500';
                });
            }

            // ── Save business info ────────────────────────────────────────────
            var saveBusinessInfo  = document.getElementById('saveBusinessInfo');
            var businessNameInput = document.getElementById('businessNameInput');
            if (saveBusinessInfo) {
                saveBusinessInfo.addEventListener('click', async function () {
                    var btn          = saveBusinessInfo;
                    var businessName = businessNameInput ? businessNameInput.value.trim() : '';
                    var description  = textarea ? textarea.value.trim() : '';
                    var businessType = btInput ? btInput.value.trim() : '';
                    var res = await fetch('/account/business-info', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ businessName, description, businessType })
                    });
                    var data = await res.json();
                    if (data.success) {
                        var span = btn.querySelector('span');
                        var orig = span.textContent;
                        span.textContent = '✓ Enregistré';
                        btn.disabled = true;
                        setTimeout(function () { span.textContent = orig; btn.disabled = false; }, 2500);
                    }
                });
            }

            // ── Gallery ───────────────────────────────────────────────────────
            var galleryGrid  = document.getElementById('galleryGrid');
            var galleryInput = document.getElementById('galleryFileInput');

            function makeGalleryItemDraggable(item) {
                item.setAttribute('draggable', 'true');
            }

            function reindexGallery() {
                galleryGrid.querySelectorAll('.gallery-item').forEach(function (el, i) {
                    el.dataset.index = i;
                    var delBtn = el.querySelector('.gallery-item__del');
                    if (delBtn) delBtn.dataset.index = i;
                });
            }

            // ── Drag-to-reorder ───────────────────────────────────────────────
            if (galleryGrid) {
                var dragSrc = null;

                galleryGrid.addEventListener('dragstart', function (e) {
                    var item = e.target.closest('.gallery-item');
                    if (!item) return;
                    dragSrc = item;
                    item.classList.add('gallery-item--dragging');
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/plain', item.dataset.index);
                });

                galleryGrid.addEventListener('dragend', function (e) {
                    var item = e.target.closest('.gallery-item');
                    if (item) item.classList.remove('gallery-item--dragging');
                    galleryGrid.querySelectorAll('.gallery-item').forEach(function (el) {
                        el.classList.remove('gallery-item--over');
                    });
                    dragSrc = null;
                });

                galleryGrid.addEventListener('dragover', function (e) {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'move';
                    var target = e.target.closest('.gallery-item');
                    if (!target || target === dragSrc) return;
                    galleryGrid.querySelectorAll('.gallery-item').forEach(function (el) {
                        el.classList.remove('gallery-item--over');
                    });
                    target.classList.add('gallery-item--over');
                });

                galleryGrid.addEventListener('dragleave', function (e) {
                    var target = e.target.closest('.gallery-item');
                    if (target) target.classList.remove('gallery-item--over');
                });

                galleryGrid.addEventListener('drop', async function (e) {
                    e.preventDefault();
                    var target = e.target.closest('.gallery-item');
                    if (!target || !dragSrc || target === dragSrc) return;
                    target.classList.remove('gallery-item--over');

                    // Réorganiser dans le DOM
                    var addBtn = galleryGrid.querySelector('.gallery-add-btn');
                    var items  = Array.from(galleryGrid.querySelectorAll('.gallery-item'));
                    var srcIdx = items.indexOf(dragSrc);
                    var tgtIdx = items.indexOf(target);
                    if (srcIdx < tgtIdx) {
                        galleryGrid.insertBefore(dragSrc, target.nextSibling || addBtn);
                    } else {
                        galleryGrid.insertBefore(dragSrc, target);
                    }

                    reindexGallery();

                    // Sauvegarder le nouvel ordre
                    var newOrder = Array.from(galleryGrid.querySelectorAll('.gallery-item')).map(function (el) {
                        return parseInt(el.dataset.index, 10);
                    });
                    // Reconstruire l'ordre basé sur les src des images
                    var srcs = Array.from(galleryGrid.querySelectorAll('.gallery-item img')).map(function (img) {
                        return img.getAttribute('src');
                    });
                    try {
                        await fetch('/account/gallery/reorder', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ order: srcs })
                        });
                    } catch (_) {}

                    reindexGallery();
                });
            }

            if (galleryInput && galleryGrid) {
                galleryInput.addEventListener('change', async function () {
                    if (!galleryInput.files.length) return;
                    var formData = new FormData();
                    Array.from(galleryInput.files).forEach(function (f) { formData.append('galleryPhotos', f); });
                    var res  = await fetch('/account/gallery', { method: 'PATCH', body: formData });
                    var data = await res.json();
                    if (data.success && data.paths) {
                        data.paths.forEach(function (path) {
                            var idx  = galleryGrid.querySelectorAll('.gallery-item').length;
                            var item = document.createElement('div');
                            item.className = 'gallery-item';
                            item.dataset.index = idx;
                            item.setAttribute('draggable', 'true');
                            item.innerHTML = '<img src="' + path + '" alt="Photo"><button class="gallery-item__del" type="button" data-index="' + idx + '" title="Supprimer"><svg xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor"><path d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z"/></svg></button>';
                            var addBtn = galleryGrid.querySelector('.gallery-add-btn');
                            if (addBtn) galleryGrid.insertBefore(item, addBtn);
                            else galleryGrid.appendChild(item);
                        });
                        galleryInput.value = '';
                    }
                });
                galleryGrid.addEventListener('click', async function (e) {
                    var btn = e.target.closest('.gallery-item__del');
                    if (!btn) return;
                    var idx  = parseInt(btn.dataset.index, 10);
                    var res  = await fetch('/account/gallery/' + idx, { method: 'DELETE' });
                    var data = await res.json();
                    if (data.success) {
                        btn.closest('.gallery-item').remove();
                        reindexGallery();
                    }
                });
            }

            // ── Section visibility toggles ────────────────────────────────────
            var sectionToggleMap = {
                toggleSectionAbout:   'showSectionAbout',
                toggleSectionHours:   'showSectionHours',
                toggleSectionGallery: 'showSectionGallery',
                toggleSectionMap:     'showSectionMap'
            };
            Object.keys(sectionToggleMap).forEach(function (id) {
                var cb = document.getElementById(id);
                if (!cb) return;
                var card = cb.closest('.section-card');
                cb.addEventListener('change', async function () {
                    var fieldName = sectionToggleMap[id];
                    var enabled   = cb.checked;
                    if (card) card.classList.toggle('section-card--off', !enabled);
                    try {
                        await fetch('/account/toggle-section', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ fieldName, enabled })
                        });
                    } catch (_) {}
                });
            });

            // ── Format d'affichage de la galerie (grille / carrousel) ──────────
            var galleryLayoutOpts   = document.getElementById('galleryLayoutOpts');
            var galleryLayoutStatus = document.getElementById('galleryLayoutStatus');
            if (galleryLayoutOpts) {
                galleryLayoutOpts.addEventListener('click', async function (e) {
                    var btn = e.target.closest('.gallery-layout-opt');
                    if (!btn || btn.classList.contains('is-active')) return;
                    var layout = btn.dataset.layout;

                    galleryLayoutOpts.querySelectorAll('.gallery-layout-opt').forEach(function (b) {
                        b.classList.toggle('is-active', b === btn);
                    });

                    if (galleryLayoutStatus) galleryLayoutStatus.textContent = 'Enregistrement…';
                    try {
                        var res  = await fetch('/account/gallery-layout', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ layout: layout })
                        });
                        var data = await res.json();
                        if (galleryLayoutStatus) {
                            galleryLayoutStatus.textContent = data.success ? '✓ Enregistré' : 'Erreur';
                            galleryLayoutStatus.style.color = data.success ? '#22c55e' : '#ef4444';
                            setTimeout(function () { galleryLayoutStatus.textContent = ''; }, 2200);
                        }
                    } catch (_) {
                        if (galleryLayoutStatus) {
                            galleryLayoutStatus.textContent = 'Erreur';
                            galleryLayoutStatus.style.color = '#ef4444';
                        }
                    }
                });
            }


        })();

    //- ── Achat add-on URL personnalisée ──────────────────────────────────────
    script.
        (function() {
            var btn = document.getElementById('buyAddonCustomUrlBtn');
            if (!btn) return;
            btn.addEventListener('click', async function() {
                btn.disabled = true;
                var span = btn.querySelector('span');
                if (span) span.textContent = 'Redirection…';
                try {
                    var r = await fetch('/account/purchase-addon/custom-url', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' }
                    });
                    var d = await r.json();
                    if (d.url) {
                        window.location.href = d.url;
                    } else {
                        alert(d.error || 'Erreur lors de la création du paiement.');
                        btn.disabled = false;
                        if (span) span.textContent = 'Activer — 5€/mois';
                    }
                } catch(e) {
                    alert('Erreur réseau.');
                    btn.disabled = false;
                    if (span) span.textContent = 'Activer — 5€/mois';
                }
            });
        })();

    //- ── Globals pour cz-design.js ──────────────────────────────────────────
    script.
        window.__czCs = !{JSON.stringify(cs)};
        window.__czBookingUrl = !{JSON.stringify(currentCompany ? ('/' + (currentCompany.slug || String(currentCompany._id))) : '')};

    script(src='/js/layouts/cz-design.js')

    //- ── JS Onglet Rappels ───────────────────────────────────────────────────
    script.
        (function() {
            var delayBtns    = document.querySelectorAll('.cz-delay-btn:not(.cz-paymethod-btn)');
            var payBtns      = document.querySelectorAll('.cz-paymethod-btn');
            var msgArea      = document.getElementById('czReminderMsg');
            var msgCount     = document.getElementById('czReminderMsgCount');
            var payNoteArea  = document.getElementById('czPaymentNote');
            var payNoteCount = document.getElementById('czPaymentNoteCount');
            var saveBtn      = document.getElementById('czSaveReminder');
            var saveTxt      = document.getElementById('czSaveReminderText');
            var saveStatus   = document.getElementById('czReminderStatus');
            var previewDelay = document.getElementById('czPreviewDelay');
            var previewBox   = document.getElementById('czPreviewMsgBox');
            var previewMsg   = document.getElementById('czPreviewMsgText');

            var selectedDelay = !{JSON.stringify((calendarSettings && calendarSettings.reminderDelayHours) || 24)};
            var selectedPaymentMethods = !{JSON.stringify((calendarSettings && calendarSettings.reminderPaymentMethods) || [])};

            var delayLabels = { 6:'dans 6 heures', 12:'dans 12 heures', 24:'demain', 48:'dans 2 jours', 72:'dans 3 jours' };

            function updatePreview() {
                if (previewDelay) {
                    previewDelay.innerHTML = 'Votre rendez-vous a lieu <strong>' + (delayLabels[selectedDelay] || 'demain') + '</strong>.';
                }
                var msg = msgArea ? msgArea.value.trim() : '';
                if (previewBox) previewBox.style.display = msg ? 'block' : 'none';
                if (previewMsg) previewMsg.textContent = msg;
            }

            // Boutons délai
            delayBtns.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    delayBtns.forEach(function(b) { b.classList.remove('is-active'); });
                    btn.classList.add('is-active');
                    selectedDelay = parseInt(btn.dataset.hours, 10);
                    updatePreview();
                });
            });

            // Compteur + preview message
            if (msgArea) {
                msgArea.addEventListener('input', function() {
                    if (msgCount) msgCount.textContent = msgArea.value.length;
                    updatePreview();
                });
            }

            // Boutons modes de paiement
            payBtns.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var method = btn.dataset.method;
                    var idx = selectedPaymentMethods.indexOf(method);
                    if (idx === -1) {
                        selectedPaymentMethods.push(method);
                        btn.classList.add('is-active');
                    } else {
                        selectedPaymentMethods.splice(idx, 1);
                        btn.classList.remove('is-active');
                    }
                });
            });

            // Compteur note paiement
            if (payNoteArea) {
                payNoteArea.addEventListener('input', function() {
                    if (payNoteCount) payNoteCount.textContent = payNoteArea.value.length;
                });
            }

            // Save
            if (saveBtn) {
                saveBtn.addEventListener('click', async function() {
                    saveTxt.textContent = 'Enregistrement…';
                    saveBtn.disabled = true;
                    try {
                        var res = await fetch('/account/reminder-settings', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                reminderDelayHours: selectedDelay,
                                reminderMessage: msgArea ? msgArea.value.trim() : '',
                                reminderPaymentMethods: selectedPaymentMethods,
                                reminderPaymentNote: payNoteArea ? payNoteArea.value.trim() : ''
                            })
                        });
                        var data = await res.json();
                        saveTxt.textContent = 'Enregistrer';
                        saveBtn.disabled = false;
                        if (data.success) {
                            if (saveStatus) {
                                saveStatus.textContent = '✓ Enregistré';
                                saveStatus.style.color = '#22c55e';
                                setTimeout(function() { saveStatus.textContent = ''; }, 2500);
                            }
                        } else {
                            if (saveStatus) { saveStatus.textContent = 'Erreur'; saveStatus.style.color = '#ef4444'; }
                        }
                    } catch(_) {
                        saveTxt.textContent = 'Enregistrer';
                        saveBtn.disabled = false;
                        if (saveStatus) { saveStatus.textContent = 'Erreur réseau'; saveStatus.style.color = '#ef4444'; }
                    }
                });
            }

            updatePreview();
        })();

