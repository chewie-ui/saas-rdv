block scripts
    style.
        /* ── Header & onglets ── */
        .cz-header {
            margin-bottom: 0;
            padding-bottom: 0;
        }
        .cz-header__top {
            padding: 0 0 16px;
        }
        .cz-header__title {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px;
        }
        .cz-header__sub {
            font-size: 13.5px;
            color: var(--text-secondary);
            margin: 0;
        }
        .cz-tabs {
            display: flex;
            gap: 0;
            border-bottom: 1.5px solid var(--border-light);
            margin-bottom: 24px;
        }
        .cz-tab {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 10px 18px;
            background: none;
            border: none;
            border-bottom: 2.5px solid transparent;
            margin-bottom: -1.5px;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-secondary);
            cursor: pointer;
            transition: color 0.15s, border-color 0.15s;
        }
        .cz-tab:hover { color: var(--text-primary); }
        .cz-tab.is-active {
            color: var(--primary, #22c55e);
            border-bottom-color: var(--primary, #22c55e);
            font-weight: 600;
        }
        .cz-reminder-header-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            background: #f0fdf4;
            border-radius: 9px;
            color: #22c55e;
            margin-right: 12px;
            flex-shrink: 0;
        }
        .info-card__header { display: flex; align-items: flex-start; }
        .cz-reminder-section {
            padding: 18px 22px;
            border-top: 1px solid var(--border-light);
        }
        .cz-reminder-label {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 12px;
        }
        .cz-reminder-label svg { color: var(--text-secondary); }
        .cz-reminder-hint {
            font-size: 12.5px;
            color: var(--text-secondary);
            margin: -6px 0 12px;
            line-height: 1.5;
        }
        /* Boutons délai */
        .cz-delay-options {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .cz-delay-btn {
            padding: 7px 16px;
            border-radius: 100px;
            border: 1.5px solid var(--border-light);
            background: var(--surface-card);
            font-size: 13px;
            font-weight: 500;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.15s;
        }
        .cz-paymethod-options {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .cz-delay-btn:hover { border-color: #22c55e; color: #22c55e; }
        .cz-delay-btn.is-active {
            background: #22c55e;
            border-color: #22c55e;
            color: #fff;
            font-weight: 600;
        }
        /* Textarea message */
        .cz-reminder-msg-wrap { position: relative; }
        .cz-reminder-msg {
            width: 100%;
            box-sizing: border-box;
            padding: 11px 14px;
            border: 1.5px solid var(--border-light);
            border-radius: 10px;
            font-size: 13.5px;
            color: var(--text-primary);
            background: var(--surface-card);
            resize: vertical;
            line-height: 1.5;
            transition: border-color 0.15s, box-shadow 0.15s;
            font-family: inherit;
        }
        .cz-reminder-msg:focus {
            outline: none;
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.1);
        }
        .cz-reminder-msg-count {
            text-align: right;
            font-size: 11.5px;
            color: var(--text-muted);
            margin-top: 5px;
        }
        /* Preview */
        .cz-reminder-preview-section { background: var(--surface-alt, #fafafa); border-radius: 0 0 12px 12px; }
        .cz-reminder-preview {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 16px 20px;
            max-width: 400px;
        }
        .cz-preview-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #1a7a4a;
            color: #fff;
            font-size: 12px;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 100px;
            margin-bottom: 10px;
        }
        .cz-preview-delay {
            font-size: 13px;
            color: #6b7280;
            margin: 0 0 10px;
        }
        .cz-preview-msg-box {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 8px;
            padding: 10px 14px;
        }
        .cz-preview-msg-label {
            font-size: 11px;
            font-weight: 600;
            color: #15803d;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            margin-bottom: 5px;
        }
        .cz-preview-msg-text {
            font-size: 13px;
            color: #1e2923;
            font-style: italic;
            margin: 0;
            line-height: 1.5;
        }
        .cz-reminder-status {
            font-size: 13px;
            color: #22c55e;
            margin-left: 10px;
        }

        /* ── Responsive tabs ── */
        @media (max-width: 700px) {
            .cz-tabs {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                scrollbar-width: none;
                flex-wrap: nowrap;
            }
            .cz-tabs::-webkit-scrollbar { display: none; }
            .cz-tab {
                padding: 10px 13px;
                font-size: 13px;
                white-space: nowrap;
                flex-shrink: 0;
            }
        }
        @media (max-width: 480px) {
            .cz-tab {
                padding: 9px 10px;
                font-size: 12px;
                gap: 4px;
            }
            .cz-tab svg {
                width: 14px;
                height: 14px;
                flex-shrink: 0;
            }
            .cz-header__title {
                font-size: 18px;
            }
            .cz-tabs {
                margin-bottom: 18px;
            }
        }

    script(src="/js/utils/confirm-modal.js")
    script(src="/js/utils/image-upload.js")
    script(src='/js/layouts/informations.js')
    script(src='/js/layouts/customize.js')
    script.
        // ── Gestion des onglets Général / Rappels / Design / Intégration ──────
        (function() {
            var tabs = {
                general:     document.getElementById('czTabGeneral'),
                rappels:     document.getElementById('czTabRappels'),
                design:      document.getElementById('czTabDesign'),
                integration: document.getElementById('czTabIntegration')
            };
            var panels = {
                rappels:     document.getElementById('czPanelRappels'),
                design:      document.getElementById('czPanelDesign'),
                integration: document.getElementById('czPanelIntegration')
            };
            var infoPage = document.querySelector('.info-page');

            // Tous les enfants directs de .info-page qui sont des "general cards"
            function getGeneralEls() {
                return Array.from(infoPage.children).filter(function(el) {
                    return el.tagName !== 'STYLE' &&
                           el.tagName !== 'SCRIPT' &&
                           !el.classList.contains('cz-header') &&
                           el.id !== 'czPanelGeneral' &&
                           el.id !== 'czPanelRappels' &&
                           el.id !== 'czPanelDesign' &&
                           el.id !== 'czPanelIntegration';
                });
            }

            var designVisible = false;

            function showTab(name) {
                // Tabs actifs
                Object.keys(tabs).forEach(function(k) {
                    if (tabs[k]) tabs[k].classList.toggle('is-active', k === name);
                });
                // Panels
                Object.keys(panels).forEach(function(k) {
                    if (panels[k]) panels[k].style.display = (k === name) ? 'block' : 'none';
                });
                // Cartes générales
                var showGeneral = (name === 'general');
                getGeneralEls().forEach(function(el) {
                    el.style.display = showGeneral ? '' : 'none';
                });
                // Charger le preview design au premier affichage
                if (name === 'design' && !designVisible) {
                    designVisible = true;
                    document.dispatchEvent(new Event('czDesignVisible'));
                }
                // Rafraîchir l'aperçu d'intégration à chaque affichage de l'onglet
                // (pour refléter les changements de design enregistrés entre-temps)
                if (name === 'integration') {
                    document.dispatchEvent(new Event('czIntegrationVisible'));
                }
            }

            Object.keys(tabs).forEach(function(k) {
                if (tabs[k]) tabs[k].addEventListener('click', function() { showTab(k); });
            });

            // Hash navigation
            var hash = window.location.hash.replace('#', '');
            if (hash && tabs[hash]) showTab(hash);
        })();

    script.
        (function () {
            var __services = !{JSON.stringify(services)};

            // ── Business type autocomplete ────────────────────────────────────
            var btInput   = document.getElementById('businessTypeInput');
            var btDropdown = document.getElementById('businessTypeDropdown');
            var btHint    = document.getElementById('businessTypeHint');

            function normalize(str) {
                return str.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
            }
            // Métier absent de la liste conseillée : accepté quand même, juste
            // signalé en orange (ni bloquant, ni corrigé automatiquement).
            function checkBusinessTypeCustom() {
                if (!btInput) return;
                var value = btInput.value.trim();
                var isCustom = !!value && !__services.some(function (s) { return normalize(s) === normalize(value); });
                btInput.classList.toggle('input--warn', isCustom);
                if (btHint) btHint.classList.toggle('is-visible', isCustom);
            }
            function renderBtList(items) {
                btDropdown.innerHTML = '';
                if (!items.length) { btDropdown.style.display = 'none'; return; }
                items.forEach(function (item) {
                    var div = document.createElement('div');
                    div.className = 'service-dropdown__item';
                    div.textContent = item;
                    div.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                        btInput.value = item;
                        btDropdown.style.display = 'none';
                        checkBusinessTypeCustom();
                    });
                    btDropdown.appendChild(div);
                });
                btDropdown.style.display = 'block';
            }
            if (btInput && btDropdown) {
                checkBusinessTypeCustom(); // état initial (valeur déjà enregistrée)
                btInput.addEventListener('input', function () {
                    checkBusinessTypeCustom();
                    var q = normalize(btInput.value.trim());
                    if (!q) { btDropdown.style.display = 'none'; return; }
                    renderBtList(__services.filter(function (s) { return normalize(s).includes(q); }).slice(0, 8));
                });
                btInput.addEventListener('focus', function () {
                    var q = normalize(btInput.value.trim());
                    if (q) renderBtList(__services.filter(function (s) { return normalize(s).includes(q); }).slice(0, 8));
                });
                btInput.addEventListener('blur', function () {
                    setTimeout(function () { btDropdown.style.display = 'none'; }, 150);
                });
            }

            // ── Save business info ────────────────────────────────────────────
            var saveBusinessInfo  = document.getElementById('saveBusinessInfo');
            var businessNameInput = document.getElementById('businessNameInput');
            if (saveBusinessInfo) {
                saveBusinessInfo.addEventListener('click', async function () {
                    var btn          = saveBusinessInfo;
                    var businessName = businessNameInput ? businessNameInput.value.trim() : '';
                    var businessType = btInput ? btInput.value.trim() : '';
                    var res = await fetch('/account/business-info', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ businessName, businessType })
                    });
                    var data = await res.json();
                    if (data.success) {
                        var span = btn.querySelector('span');
                        var orig = span.textContent;
                        span.textContent = '✓ Enregistré';
                        btn.disabled = true;
                        setTimeout(function () { span.textContent = orig; btn.disabled = false; }, 2500);
                    }
                });
            }

            // ── Gallery ───────────────────────────────────────────────────────
            var glInput   = document.getElementById('glFileInput');
            var glUpload  = document.querySelector('.gl-upload');
            var glCountEl = document.getElementById('glCount');
            var glSaved   = document.getElementById('glLayoutSaved');
            var glBody    = document.querySelector('.gl-body');

            function glGetGrid() { return document.getElementById('glGrid'); }
            function glGetEmpty() { return document.getElementById('glEmpty'); }

            function glUpdateCount() {
                var grid = glGetGrid();
                var n = grid ? grid.querySelectorAll('.gl-item').length : 0;
                if (glCountEl) glCountEl.textContent = n;
                if (glUpload) glUpload.style.display = n >= 12 ? 'none' : '';
                var empty = glGetEmpty();
                if (n === 0) {
                    if (!empty && glBody) {
                        var emptyEl = document.createElement('div');
                        emptyEl.className = 'gl-empty';
                        emptyEl.id = 'glEmpty';
                        emptyEl.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" height="32px" viewBox="0 -960 960 960" width="32px" fill="currentColor"><path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Zm0-80h560v-560H200v560Zm40-80h480L570-480 450-320l-90-120-120 160Zm-40 80v-560 560Z"/></svg><p>Aucune photo pour le moment</p><p class="gl-empty__sub">Cliquez sur le bouton ci-dessous pour ajouter vos premières photos.</p>';
                        if (glUpload) glBody.insertBefore(emptyEl, glUpload);
                        else glBody.appendChild(emptyEl);
                    }
                    if (grid) { grid.remove(); }
                } else {
                    if (empty) empty.remove();
                    if (!grid && glBody) {
                        var gridEl = document.createElement('div');
                        gridEl.className = 'gl-photos';
                        gridEl.id = 'glGrid';
                        if (glUpload) glBody.insertBefore(gridEl, glUpload);
                        else glBody.appendChild(gridEl);
                    }
                }
            }

            function glReindex() {
                var grid = glGetGrid();
                if (!grid) return;
                grid.querySelectorAll('.gl-item').forEach(function (el, i) {
                    el.dataset.index = i;
                    var btn = el.querySelector('.gl-item__del');
                    if (btn) btn.dataset.index = i;
                });
            }

            function glMakeItemHTML(path, idx) {
                return '<img class="gl-item__img" src="' + path + '" alt="" loading="lazy">'
                    + '<div class="gl-item__overlay">'
                    + '<button class="gl-item__del" type="button" data-index="' + idx + '" title="Supprimer">'
                    + '<svg xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor"><path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/></svg>'
                    + '</button>'
                    + '<div class="gl-item__drag">'
                    + '<svg xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor"><path d="M360-160q-33 0-56.5-23.5T280-240q0-33 23.5-56.5T360-320q33 0 56.5 23.5T440-240q0 33-23.5 56.5T360-160Zm240 0q-33 0-56.5-23.5T520-240q0-33 23.5-56.5T600-320q33 0 56.5 23.5T680-240q0 33-23.5 56.5T600-160ZM360-400q-33 0-56.5-23.5T280-480q0-33 23.5-56.5T360-560q33 0 56.5 23.5T440-480q0 33-23.5 56.5T360-400Zm240 0q-33 0-56.5-23.5T520-480q0-33 23.5-56.5T600-560q33 0 56.5 23.5T680-480q0 33-23.5 56.5T600-400ZM360-640q-33 0-56.5-23.5T280-720q0-33 23.5-56.5T360-800q33 0 56.5 23.5T440-720q0 33-23.5 56.5T360-640Zm240 0q-33 0-56.5-23.5T520-720q0-33 23.5-56.5T600-800q33 0 56.5 23.5T680-720q0 33-23.5 56.5T600-640Z"/></svg>'
                    + '</div>'
                    + '</div>';
            }

            async function glUploadFiles(files) {
                if (!files || !files.length) return;
                var data;
                try {
                    // BkImageUpload convertit chaque photo (HEIC/iPhone inclus),
                    // la redimensionne, affiche la progression et les erreurs.
                    data = await window.BkImageUpload.uploadImages({
                        url: '/account/gallery',
                        method: 'PATCH',
                        fieldName: 'galleryPhotos',
                        files: files,
                    });
                } catch (err) {
                    if (glInput) glInput.value = '';
                    return;
                }
                if (data.success && data.paths) {
                    data.paths.forEach(function (path) {
                        var grid = glGetGrid();
                        if (!grid) {
                            grid = document.createElement('div');
                            grid.className = 'gl-photos';
                            grid.id = 'glGrid';
                            if (glUpload) glBody.insertBefore(grid, glUpload);
                            else glBody.appendChild(grid);
                        }
                        var idx  = grid.querySelectorAll('.gl-item').length;
                        var item = document.createElement('div');
                        item.className = 'gl-item';
                        item.dataset.index = idx;
                        item.setAttribute('draggable', 'true');
                        item.innerHTML = glMakeItemHTML(path, idx);
                        grid.appendChild(item);
                    });
                    glUpdateCount();
                }
                if (glInput) glInput.value = '';
            }

            // ── Drag-to-reorder (délégué sur .gl-body) ───────────────────────
            if (glBody) {
                var glDragSrc = null;

                glBody.addEventListener('dragstart', function (e) {
                    var item = e.target.closest('.gl-item');
                    if (!item) return;
                    glDragSrc = item;
                    item.classList.add('gl-item--dragging');
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/plain', item.dataset.index);
                });

                glBody.addEventListener('dragend', function (e) {
                    var item = e.target.closest('.gl-item');
                    if (item) item.classList.remove('gl-item--dragging');
                    document.querySelectorAll('.gl-item--over').forEach(function (el) { el.classList.remove('gl-item--over'); });
                    glDragSrc = null;
                });

                glBody.addEventListener('dragover', function (e) {
                    e.preventDefault();
                    var target = e.target.closest('.gl-item');
                    if (!target || target === glDragSrc) return;
                    document.querySelectorAll('.gl-item--over').forEach(function (el) { el.classList.remove('gl-item--over'); });
                    target.classList.add('gl-item--over');
                });

                glBody.addEventListener('dragleave', function (e) {
                    var target = e.target.closest('.gl-item');
                    if (target) target.classList.remove('gl-item--over');
                });

                glBody.addEventListener('drop', async function (e) {
                    var target = e.target.closest('.gl-item');
                    if (!target || !glDragSrc || target === glDragSrc) return;
                    e.preventDefault();
                    target.classList.remove('gl-item--over');
                    var grid = glGetGrid();
                    if (!grid) return;
                    var items  = Array.from(grid.querySelectorAll('.gl-item'));
                    var srcIdx = items.indexOf(glDragSrc);
                    var tgtIdx = items.indexOf(target);
                    if (srcIdx < tgtIdx) grid.insertBefore(glDragSrc, target.nextSibling);
                    else grid.insertBefore(glDragSrc, target);
                    glReindex();
                    var srcs = Array.from(grid.querySelectorAll('.gl-item img')).map(function (img) { return img.getAttribute('src'); });
                    try {
                        await fetch('/account/gallery/reorder', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ order: srcs }) });
                    } catch (_) {}
                    glReindex();
                });

                // ── Supprimer ─────────────────────────────────────────────────
                glBody.addEventListener('click', async function (e) {
                    var btn = e.target.closest('.gl-item__del');
                    if (!btn) return;
                    var idx  = parseInt(btn.dataset.index, 10);
                    var res  = await fetch('/account/gallery/' + idx, { method: 'DELETE' });
                    var data = await res.json();
                    if (data.success) {
                        btn.closest('.gl-item').remove();
                        glReindex();
                        glUpdateCount();
                    }
                });
            }

            // ── Upload via input ──────────────────────────────────────────────
            if (glInput) {
                glInput.addEventListener('change', function () { glUploadFiles(glInput.files); });
            }

            // ── Upload via drag-and-drop sur le bouton ────────────────────────
            if (glUpload) {
                glUpload.addEventListener('dragover', function (e) { e.preventDefault(); glUpload.classList.add('drag-over'); });
                glUpload.addEventListener('dragleave', function () { glUpload.classList.remove('drag-over'); });
                glUpload.addEventListener('drop', async function (e) {
                    e.preventDefault();
                    glUpload.classList.remove('drag-over');
                    glUploadFiles(e.dataTransfer.files);
                });
            }

            // ── Section visibility toggles ────────────────────────────────────
            var sectionToggleMap = {
                toggleSectionAbout:   'showSectionAbout',
                toggleSectionHours:   'showSectionHours',
                toggleSectionGallery: 'showSectionGallery',
                toggleSectionMap:     'showSectionMap'
            };
            Object.keys(sectionToggleMap).forEach(function (id) {
                var cb = document.getElementById(id);
                if (!cb) return;
                var card = cb.closest('.section-card');
                var sectionBody = card ? card.querySelector('.section-body') : null;

                cb.addEventListener('change', async function () {
                    var fieldName = sectionToggleMap[id];
                    var enabled   = cb.checked;
                    var mainEl    = document.querySelector('.main');

                    // Snapshot avant modification DOM
                    var scrollTopBefore    = mainEl ? mainEl.scrollTop    : 0;
                    var scrollHeightBefore = mainEl ? mainEl.scrollHeight : 0;
                    // Position du header de la card dans le viewport (négatif = au-dessus)
                    var cardTopBefore = card ? card.getBoundingClientRect().top : 1;

                    // Appliquer le changement
                    if (sectionBody) sectionBody.style.display = enabled ? '' : 'none';
                    if (card) card.classList.toggle('section-card--off', !enabled);

                    // Si la card était au-dessus du viewport, le contenu ajouté/retiré
                    // est hors de vue : compenser en ajustant scrollTop du delta de hauteur.
                    if (mainEl && cardTopBefore < 0) {
                        mainEl.scrollTop = scrollTopBefore + (mainEl.scrollHeight - scrollHeightBefore);
                    }

                    try {
                        await fetch('/account/toggle-section', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ fieldName, enabled })
                        });
                    } catch (_) {}
                });
            });

            // ── Layout picker ─────────────────────────────────────────────────
            var glLayoutBtns = document.getElementById('glLayoutBtns');
            if (glLayoutBtns) {
                glLayoutBtns.addEventListener('click', async function (e) {
                    var btn = e.target.closest('.gl-layout-btn');
                    if (!btn || btn.classList.contains('is-active')) return;
                    var layout = btn.dataset.layout;
                    glLayoutBtns.querySelectorAll('.gl-layout-btn').forEach(function (b) {
                        b.classList.toggle('is-active', b === btn);
                    });
                    if (glSaved) {
                        glSaved.classList.add('visible');
                        clearTimeout(glSaved._t);
                        glSaved._t = setTimeout(function () { glSaved.classList.remove('visible'); }, 2000);
                    }
                    try {
                        await fetch('/account/gallery-layout', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ layout: layout })
                        });
                    } catch (_) {}
                });
            }


        })();

    //- ── Achat add-on URL personnalisée ──────────────────────────────────────
    script.
        (function() {
            var btn = document.getElementById('buyAddonCustomUrlBtn');
            if (!btn) return;
            btn.addEventListener('click', async function() {
                btn.disabled = true;
                var span = btn.querySelector('span');
                if (span) span.textContent = 'Redirection…';
                try {
                    var r = await fetch('/account/purchase-addon/custom-url', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' }
                    });
                    var d = await r.json();
                    if (d.url) {
                        window.location.href = d.url;
                    } else {
                        await window.alertModal(d.error || 'Erreur lors de la création du paiement.');
                        btn.disabled = false;
                        if (span) span.textContent = 'Activer — 5€/mois';
                    }
                } catch(e) {
                    await window.alertModal('Erreur réseau.');
                    btn.disabled = false;
                    if (span) span.textContent = 'Activer — 5€/mois';
                }
            });
        })();

    //- ── Globals pour cz-design.js ──────────────────────────────────────────
    script.
        window.__czCs = !{JSON.stringify(cs)};
        window.__czBookingUrl = !{JSON.stringify(currentCompany ? ('/' + (currentCompany.slug || String(currentCompany._id))) : '')};

    script(src='/js/layouts/cz-design.js')

    //- ── JS Onglet Rappels ───────────────────────────────────────────────────
    script.
        (function() {
            var delayBtns    = document.querySelectorAll('.cz-delay-btn:not(.cz-paymethod-btn)');
            var payBtns      = document.querySelectorAll('.cz-paymethod-btn');
            var msgArea      = document.getElementById('czReminderMsg');
            var msgCount     = document.getElementById('czReminderMsgCount');
            var payNoteArea  = document.getElementById('czPaymentNote');
            var payNoteCount = document.getElementById('czPaymentNoteCount');
            var saveBtn      = document.getElementById('czSaveReminder');
            var saveTxt      = document.getElementById('czSaveReminderText');
            var saveStatus   = document.getElementById('czReminderStatus');
            var previewDelay = document.getElementById('czPreviewDelay');
            var previewBox   = document.getElementById('czPreviewMsgBox');
            var previewMsg   = document.getElementById('czPreviewMsgText');

            var selectedDelay = !{JSON.stringify((calendarSettings && calendarSettings.reminderDelayHours) || 24)};
            var selectedPaymentMethods = !{JSON.stringify((calendarSettings && calendarSettings.reminderPaymentMethods) || [])};

            var delayLabels = { 6:'dans 6 heures', 12:'dans 12 heures', 24:'demain', 48:'dans 2 jours', 72:'dans 3 jours' };

            function updatePreview() {
                if (previewDelay) {
                    previewDelay.innerHTML = 'Votre rendez-vous a lieu <strong>' + (delayLabels[selectedDelay] || 'demain') + '</strong>.';
                }
                var msg = msgArea ? msgArea.value.trim() : '';
                if (previewBox) previewBox.style.display = msg ? 'block' : 'none';
                if (previewMsg) previewMsg.textContent = msg;
            }

            // Boutons délai
            delayBtns.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    delayBtns.forEach(function(b) { b.classList.remove('is-active'); });
                    btn.classList.add('is-active');
                    selectedDelay = parseInt(btn.dataset.hours, 10);
                    updatePreview();
                });
            });

            // Compteur + preview message
            if (msgArea) {
                msgArea.addEventListener('input', function() {
                    if (msgCount) msgCount.textContent = msgArea.value.length;
                    updatePreview();
                });
            }

            // Boutons modes de paiement
            payBtns.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var method = btn.dataset.method;
                    var idx = selectedPaymentMethods.indexOf(method);
                    if (idx === -1) {
                        selectedPaymentMethods.push(method);
                        btn.classList.add('is-active');
                    } else {
                        selectedPaymentMethods.splice(idx, 1);
                        btn.classList.remove('is-active');
                    }
                });
            });

            // Compteur note paiement
            if (payNoteArea) {
                payNoteArea.addEventListener('input', function() {
                    if (payNoteCount) payNoteCount.textContent = payNoteArea.value.length;
                });
            }

            // Save
            if (saveBtn) {
                saveBtn.addEventListener('click', async function() {
                    saveTxt.textContent = 'Enregistrement…';
                    saveBtn.disabled = true;
                    try {
                        var res = await fetch('/account/reminder-settings', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                reminderDelayHours: selectedDelay,
                                reminderMessage: msgArea ? msgArea.value.trim() : '',
                                reminderPaymentMethods: selectedPaymentMethods,
                                reminderPaymentNote: payNoteArea ? payNoteArea.value.trim() : '',
                                smsRemindersEnabled: document.getElementById('czSmsEnabled') ? document.getElementById('czSmsEnabled').checked : false,
                                smsAllowOverage: document.getElementById('czSmsOverage') ? document.getElementById('czSmsOverage').checked : false
                            })
                        });
                        var data = await res.json();
                        saveTxt.textContent = 'Enregistrer';
                        saveBtn.disabled = false;
                        if (data.success) {
                            if (saveStatus) {
                                saveStatus.textContent = '✓ Enregistré';
                                saveStatus.style.color = '#22c55e';
                                setTimeout(function() { saveStatus.textContent = ''; }, 2500);
                            }
                        } else {
                            if (saveStatus) { saveStatus.textContent = 'Erreur'; saveStatus.style.color = '#ef4444'; }
                        }
                    } catch(_) {
                        saveTxt.textContent = 'Enregistrer';
                        saveBtn.disabled = false;
                        if (saveStatus) { saveStatus.textContent = 'Erreur réseau'; saveStatus.style.color = '#ef4444'; }
                    }
                });
            }

            // Recharge du solde SMS (redirection Stripe Checkout)
            document.querySelectorAll('.cz-sms-topup').forEach(function(btn) {
                btn.addEventListener('click', async function() {
                    btn.disabled = true;
                    try {
                        var r = await fetch('/account/sms-topup', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ pack: btn.dataset.pack }),
                        });
                        var d = await r.json();
                        if (d.url) window.location.href = d.url;
                        else { await window.alertModal(d.error || 'Erreur'); btn.disabled = false; }
                    } catch (e) { await window.alertModal('Erreur réseau'); btn.disabled = false; }
                });
            });

            // Recharge automatique — enregistrer les réglages
            (function() {
                var save = document.getElementById('czSmsArSave');
                if (!save) return;
                var status = document.getElementById('czSmsArStatus');
                save.addEventListener('click', async function() {
                    save.disabled = true;
                    status.textContent = 'Enregistrement...';
                    try {
                        var r = await fetch('/account/sms-autorecharge', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                enabled: document.getElementById('czSmsArEnabled').checked,
                                thresholdEuros: parseInt(document.getElementById('czSmsArThreshold').value, 10),
                                amountEuros: parseInt(document.getElementById('czSmsArAmount').value, 10),
                            }),
                        });
                        var d = await r.json();
                        save.disabled = false;
                        if (d.success) {
                            status.textContent = '✓ Enregistré';
                            status.style.color = '#22c55e';
                            setTimeout(function() { status.textContent = ''; }, 2500);
                        } else { status.textContent = d.error || 'Erreur'; status.style.color = '#ef4444'; }
                    } catch (e) {
                        save.disabled = false;
                        status.textContent = 'Erreur réseau';
                        status.style.color = '#ef4444';
                    }
                });
            })();

            updatePreview();
        })();

    style.
        /* ── Section order list ── */
        .section-order-list {
            display: flex;
            flex-direction: column;
            gap: 0;
            margin-top: 8px;
            position: relative;
        }

        /* ── Item draggable ── */
        .section-order-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            background: var(--surface-card);
            border: 1.5px solid var(--border-light);
            border-radius: 12px;
            margin-bottom: 6px;
            cursor: grab;
            user-select: none;
            transition: box-shadow .18s, border-color .15s, background .12s, transform .12s, opacity .15s;
            position: relative;
        }

        .section-order-item:hover:not(.section-order-item--locked) {
            border-color: var(--border-medium);
            box-shadow: 0 2px 10px rgba(0,0,0,.06);
        }

        /* Item en train d'être glissé */
        .section-order-item.is-dragging {
            opacity: 0;
            pointer-events: none;
        }

        /* Fantôme (clone visuel) */
        .section-order-item.drag-ghost {
            position: fixed;
            z-index: 9999;
            pointer-events: none;
            box-shadow: 0 12px 32px rgba(0,0,0,.18);
            border-color: var(--accent);
            background: var(--surface-card);
            border-radius: 12px;
            opacity: .96;
            transform: rotate(1.2deg) scale(1.02);
            cursor: grabbing;
            transition: none;
        }

        /* Ligne indicatrice de dépôt */
        .section-order-item.drop-before::before,
        .section-order-item.drop-after::after {
            content: '';
            display: block;
            position: absolute;
            left: 12px;
            right: 12px;
            height: 2.5px;
            border-radius: 99px;
            background: var(--accent);
            box-shadow: 0 0 6px rgba(22,163,74,.4);
            z-index: 10;
        }
        .section-order-item.drop-before::before { top: -4px; }
        .section-order-item.drop-after::after   { bottom: -4px; }

        /* Item verrouillé */
        .section-order-item--locked {
            cursor: default;
            background: var(--surface);
            border-style: dashed;
            border-color: var(--border-light);
        }
        .section-order-item--locked:hover { box-shadow: none; border-color: var(--border-light); }

        /* Éléments internes */
        .section-order-item__grip {
            color: var(--text-muted);
            flex-shrink: 0;
            display: flex;
            opacity: .45;
            transition: opacity .15s;
        }
        .section-order-item:hover .section-order-item__grip { opacity: .9; }
        .section-order-item__grip svg  { fill: currentColor; }
        .section-order-item__icon      { fill: var(--accent); flex-shrink: 0; }
        .section-order-item__label     { font-size: 13.5px; font-weight: 600; color: var(--text-primary); flex: 1; }
        .section-order-item__lock      { display:inline-flex; align-items:center; gap:4px; font-size:11px; font-weight:600; color:var(--text-muted); white-space:nowrap; background:var(--surface); border:1px solid var(--border-light); border-radius:99px; padding:2px 8px; }
        .section-order-item__lock svg  { fill: var(--text-muted); }
        .section-order-status          { font-size: 12.5px; min-height: 18px; margin-top: 2px; color: var(--accent); font-weight: 600; transition: opacity .3s; }

    script.
        (function() {
            var list   = document.getElementById('sectionOrderList');
            var status = document.getElementById('sectionOrderStatus');
            if (!list) return;

            var dragged    = null;
            var ghost      = null;
            var offsetX    = 0;
            var offsetY    = 0;

            function getMovable() {
                return Array.from(list.querySelectorAll('.section-order-item:not(.section-order-item--locked):not(.drag-ghost)'));
            }

            function clearDropIndicators() {
                list.querySelectorAll('.drop-before,.drop-after').forEach(function(i) {
                    i.classList.remove('drop-before','drop-after');
                });
            }

            function createGhost(item, e) {
                var rect = item.getBoundingClientRect();
                offsetX  = e.clientX - rect.left;
                offsetY  = e.clientY - rect.top;
                ghost    = item.cloneNode(true);
                ghost.classList.add('drag-ghost');
                ghost.style.width  = rect.width  + 'px';
                ghost.style.height = rect.height + 'px';
                ghost.style.left   = (e.clientX - offsetX) + 'px';
                ghost.style.top    = (e.clientY - offsetY) + 'px';
                document.body.appendChild(ghost);
            }

            function moveGhost(e) {
                if (!ghost) return;
                ghost.style.left = (e.clientX - offsetX) + 'px';
                ghost.style.top  = (e.clientY - offsetY) + 'px';
            }

            function removeGhost() {
                if (ghost) { ghost.remove(); ghost = null; }
            }

            function findDropTarget(e) {
                var items = getMovable();
                for (var i = 0; i < items.length; i++) {
                    var item = items[i];
                    if (item === dragged) continue;
                    var rect  = item.getBoundingClientRect();
                    var midY  = rect.top + rect.height / 2;
                    if (e.clientY >= rect.top - 8 && e.clientY <= rect.bottom + 8) {
                        return { item: item, pos: e.clientY < midY ? 'before' : 'after' };
                    }
                }
                return null;
            }

            getMovable().forEach(function(item) {
                item.addEventListener('mousedown', function(e) {
                    if (e.button !== 0) return;
                    dragged = this;
                    createGhost(this, e);
                    setTimeout(function() { if (dragged) dragged.classList.add('is-dragging'); }, 0);
                    e.preventDefault();
                });
            });

            document.addEventListener('mousemove', function(e) {
                if (!dragged) return;
                moveGhost(e);
                clearDropIndicators();
                var target = findDropTarget(e);
                if (target) {
                    target.item.classList.add(target.pos === 'before' ? 'drop-before' : 'drop-after');
                }
            });

            document.addEventListener('mouseup', function(e) {
                if (!dragged) return;
                clearDropIndicators();
                var target = findDropTarget(e);
                if (target) {
                    if (target.pos === 'before') {
                        list.insertBefore(dragged, target.item);
                    } else {
                        list.insertBefore(dragged, target.item.nextSibling);
                    }
                }
                dragged.classList.remove('is-dragging');
                removeGhost();
                dragged = null;
                saveOrder();
            });

            async function saveOrder() {
                var order = getMovable().map(function(i) { return i.dataset.key; }).filter(Boolean);
                try {
                    var r = await fetch('/account/section-order', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ order: order })
                    });
                    var d = await r.json();
                    if (d.success && status) {
                        status.style.opacity = '1';
                        status.textContent = '✓ Ordre enregistré';
                        setTimeout(function() { status.style.opacity = '0'; setTimeout(function(){ status.textContent=''; status.style.opacity='1'; }, 300); }, 2000);
                    }
                } catch(e) {}
            }
        })();


    //- ── Jolis menus déroulants (Pays / Langues) ──────────────────────────────
    //- Le <select> natif reste dans le DOM et garde la valeur : la sauvegarde
    //- (informations.js) continue de lire .value et .selectedOptions sans
    //- aucun changement. On ne fait que l'habiller.
    script.
        (function () {
            function flagImg(src) {
                var img = document.createElement('img');
                img.className = 'psel__flag';
                img.src = src;
                img.alt = '';
                return img;
            }

            function buildPrettySelect(sel) {
                if (!sel || sel.dataset.psel === '1') return;
                sel.dataset.psel = '1';
                var multi = sel.multiple;

                var wrap = document.createElement('div');
                wrap.className = 'psel' + (multi ? ' psel--multi' : '');
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'psel__btn';
                btn.innerHTML = '<span class="psel__label"></span><span class="material-symbols-outlined psel__chev">expand_more</span>';
                var menu = document.createElement('div');
                menu.className = 'psel__menu';

                sel.parentNode.insertBefore(wrap, sel);
                wrap.appendChild(btn);
                wrap.appendChild(menu);
                wrap.appendChild(sel);          // le natif reste dedans, masqué par le CSS
                sel.classList.add('psel__native');

                Array.prototype.forEach.call(sel.options, function (opt, i) {
                    if (opt.disabled && opt.value === '') return;   // placeholder
                    var it = document.createElement('div');
                    it.className = 'psel__opt';
                    it.dataset.index = i;
                    it.innerHTML = '<span class="psel__opt-txt"></span><span class="material-symbols-outlined psel__check">check</span>';
                    it.querySelector('.psel__opt-txt').textContent = opt.textContent.trim();
                    if (opt.dataset.flag) it.insertBefore(flagImg(opt.dataset.flag), it.firstChild);
                    menu.appendChild(it);
                });

                function placeholder() {
                    var ph = sel.querySelector('option[value=""]');
                    return ph ? ph.textContent.trim() : 'Sélectionner…';
                }
                function sync() {
                    var chosen = Array.prototype.filter.call(sel.options, function (o) { return o.selected && o.value; });
                    var lbl = wrap.querySelector('.psel__label');
                    lbl.textContent = '';
                    if (!chosen.length) {
                        lbl.textContent = placeholder();
                        lbl.classList.add('is-empty');
                    } else {
                        lbl.classList.remove('is-empty');
                        chosen.forEach(function (o, i) {
                            if (i) lbl.appendChild(document.createTextNode(', '));
                            if (o.dataset.flag) lbl.appendChild(flagImg(o.dataset.flag));
                            lbl.appendChild(document.createTextNode(o.textContent.trim()));
                        });
                    }
                    menu.querySelectorAll('.psel__opt').forEach(function (it) {
                        it.classList.toggle('is-selected', sel.options[+it.dataset.index].selected);
                    });
                }
                function close() { wrap.classList.remove('is-open'); }

                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    document.querySelectorAll('.psel.is-open').forEach(function (w) { if (w !== wrap) w.classList.remove('is-open'); });
                    wrap.classList.toggle('is-open');
                });
                menu.addEventListener('click', function (e) {
                    var it = e.target.closest('.psel__opt');
                    if (!it) return;
                    var opt = sel.options[+it.dataset.index];
                    if (multi) {
                        opt.selected = !opt.selected;       // coche / décoche
                    } else {
                        sel.value = opt.value;
                        close();
                    }
                    sel.dispatchEvent(new Event('change', { bubbles: true }));
                    sync();
                });
                document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) close(); });

                sync();
            }

            ['locCountryInput', 'locLangInput'].forEach(function (id) {
                buildPrettySelect(document.getElementById(id));
            });

            // « Autre pays… » : champ libre pour les pays absents de la liste.
            var countrySel   = document.getElementById('locCountryInput');
            var countryOther = document.getElementById('locCountryOtherInput');
            if (countrySel && countryOther) {
                countrySel.addEventListener('change', function () {
                    var other = countrySel.value === 'OTHER';
                    countryOther.style.display = other ? '' : 'none';
                    if (other) countryOther.focus();
                    else countryOther.value = '';
                });
            }
        })();
