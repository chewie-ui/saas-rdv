extends ../../layouts/admin

block links
    link(rel="stylesheet" href="/css/layouts/informations.css")
    link(rel="stylesheet" href="/css/layouts/customize.css")

block content
    - var cs = calendarSettings || {}

    .info-page

        .info-page__header
            h2 Personnaliser votre page
            p.info-page__subtitle Gérez votre établissement, votre URL, vos réseaux sociaux et les sections de votre page publique.

        //- ── Profil de l'établissement ──────────────────────────────────────────
        .info-card
            .info-card__header.info-card__header--with-cb
                .info-card__header__left
                    h3 Profil de l'établissement
                    p.info-card__desc Ces informations sont affichées en haut de votre page de réservation.
                label.section-cb-label(for="toggleSectionAbout" title="Afficher la description « À propos » sur la page publique")
                    input#toggleSectionAbout.toggle-cb(type="checkbox" checked=cs.showSectionAbout !== false)
                    span.section-pill À propos
            .biz-row
                .biz-photo-col
                    .biz-photo-preview
                        if user.businessPicture
                            img#businessPicPreview(alt="Photo de l'établissement" src=user.businessPicture)
                        else
                            .biz-photo-placeholder#businessPicPreview
                                svg(xmlns="http://www.w3.org/2000/svg" height="32px" viewBox="0 -960 960 960" width="32px" fill="currentColor")
                                    path(d="M160-120q-33 0-56.5-23.5T80-200v-480q0-33 23.5-56.5T160-760h126l74-80h240l74 80h126q33 0 56.5 23.5T880-680v480q0 33-23.5 56.5T800-120H160Zm0-80h640v-480H160v480Zm320-80q-58 0-99-41t-41-99q0-58 41-99t99-41q58 0 99 41t41 99q0 58-41 99t-99 41Zm0-80q25 0 42.5-17.5T540-420q0-25-17.5-42.5T480-480q-25 0-42.5 17.5T420-420q0 25 17.5 42.5T480-360Z")
                    input#businessFileInput(type="file" style="display:none" accept="image/*")
                    button.sm-btn.sm-btn--ghost#uploadBusinessBtn
                        span Photo
                .biz-fields
                    .field
                        label Nom de l'établissement
                        input.input#businessNameInput(
                            type="text"
                            value=user.businessName || ""
                            placeholder="Ex: Salon de Marie"
                        )
                    .field
                        label Description
                        textarea.textarea#descriptionCoach(maxlength=500 placeholder="Décrivez votre activité en quelques mots...")= user.description || ''
                        span.field-hint#descCount #{(user.description || '').length}/500
                    .field
                        label Type d'activité
                        .service-select-wrapper
                            input.input#businessTypeInput(
                                type="text"
                                placeholder="Ex: Coiffeur, Médecin, Coach sportif..."
                                autocomplete="off"
                                value=user.businessType || ""
                            )
                            .service-dropdown#businessTypeDropdown
            .info-card__actions
                button.sm-btn.sm-btn--primary#saveBusinessInfo
                    span Enregistrer

        //- ── À propos (texte enrichi) ────────────────────────────────────────────
        .info-card
            .info-card__header
                h3 À propos
                p.info-card__desc Présentez votre activité en détail — votre histoire, votre approche, ce qui vous distingue. Ce texte enrichi s'affiche dans la section « À propos » de votre page publique.
            .about-editor
                .about-editor__toolbar
                    button.about-editor__btn#aboutBoldBtn(type="button" title="Gras (Ctrl+B)" data-cmd="bold")
                        strong B
                    button.about-editor__btn#aboutItalicBtn(type="button" title="Italique (Ctrl+I)" data-cmd="italic")
                        em I
                    button.about-editor__btn#aboutUnderlineBtn(type="button" title="Souligné (Ctrl+U)" data-cmd="underline")
                        u U
                    span.about-editor__sep
                    button.about-editor__btn#aboutSizeDownBtn(type="button" title="Réduire la taille du texte sélectionné")
                        span A−
                    button.about-editor__btn#aboutSizeUpBtn(type="button" title="Agrandir la taille du texte sélectionné")
                        span A+
                .about-editor__area#aboutEditor(contenteditable="true" data-placeholder="Parlez de votre activité, de votre parcours, de ce qui rend votre établissement unique…")!= user.aboutHtml || ''
                .about-editor__footer
                    span.about-editor__hint 💡 Sélectionnez du texte, puis cliquez sur un bouton pour le mettre en forme.
                    span.field-hint#aboutCount 0/4000
            .info-card__actions
                button.sm-btn.sm-btn--primary#saveAboutBtn
                    span Enregistrer
                span.about-editor__status#aboutStatus

        //- ── Localisation ───────────────────────────────────────────────────────
        .info-card
            .info-card__header.info-card__header--with-cb
                .info-card__header__left
                    h3 Localisation
                    p.info-card__desc Votre adresse est affichée sur la carte de votre page publique.
                .info-card__header__cbs
                    label.section-cb-label(for="toggleSectionMap" title="Afficher la carte sur la page publique")
                        input#toggleSectionMap.toggle-cb(type="checkbox" checked=cs.showSectionMap !== false)
                        span.section-pill Carte
                    label.section-cb-label(for="toggleSectionHours" title="Afficher les horaires sur la page publique")
                        input#toggleSectionHours.toggle-cb(type="checkbox" checked=cs.showSectionHours !== false)
                        span.section-pill Horaires
            .location-layout
                .location-map#mapContainer
                    if user.location && user.location.iframeUrl
                        iframe(src=user.location.iframeUrl style="border:0;width:100%;height:300px;display:block;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade")
                    else
                        iframe(src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2624.9916256937595!2d2.292292615509614!3d48.85837360866272!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47e66e2964e34e2d%3A0x8ddca9ee380ef7e0!2sTour%20Eiffel!5e0!3m2!1sfr!2sfr!4v1680000000000!5m2!1sfr!2sfr" style="border:0;width:100%;height:300px;display:block;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade")
                .location-form
                    input(type="hidden" id="latInput" value=(user.location && user.location.lat) || "")
                    input(type="hidden" id="lonInput" value=(user.location && user.location.lon) || "")

                    //- ── Type de service ────────────────────────────────────
                    .field
                        .radio-group
                            .radio-item
                                input#onlineService(type="radio" name="serviceType" checked=(!(user.location && (user.location.serviceType === 'en_ligne' || user.location.serviceType === 'iframe'))))
                                label(for="onlineService")
                                    span.custom-radio
                                    = t.info.on_site
                            .radio-item
                                input#homeService(type="radio" name="serviceType" checked=(user.location && user.location.serviceType === 'en_ligne'))
                                label(for="homeService")
                                    span.custom-radio
                                    = t.info.online_svc
                            .radio-item
                                input#iframeService(type="radio" name="serviceType" checked=(user.location && user.location.serviceType === 'iframe'))
                                label(for="iframeService")
                                    span.custom-radio
                                    | Ajouter iframe

                    //- ── Champs adresse (mode sur-place) ─────────────────────
                    #locOnSiteFields(style=(user.location && (user.location.serviceType === 'en_ligne' || user.location.serviceType === 'iframe')) ? 'display:none' : '')
                        .loc-simple-block
                            label.loc-simple-label Adresse complète
                            input.input.loc-simple-input#locAddressInput(
                                type="text"
                                placeholder="Ex : Rue des Vallées 7, 1315 Incourt, Belgique"
                                value=(user.location && user.location.address && user.location.city ? (user.location.address + ', ' + (user.location.zip || '') + ' ' + user.location.city).trim() : '') || ""
                                autocomplete="off"
                            )
                            p.loc-simple-hint Entrez l'adresse complète. Elle sera utilisée pour afficher votre position sur la carte.
                        .loc-simple-block
                            label.loc-simple-label
                                | Lien Google Maps&nbsp;
                                span(style="font-weight:400;color:var(--text-muted);font-size:12px;") (optionnel — pour le bouton "Ouvrir dans Maps")
                            input.input.loc-simple-input#locGmapInput(
                                type="text"
                                placeholder="Collez votre lien Google Maps (long ou court maps.app.goo.gl/...)"
                                value=(user.location && user.location.gmapUrl) || ""
                                autocomplete="off"
                            )

                    //- ── Champs service en ligne (pays + langue) ──────────────
                    #locOnlineFields(style=(user.location && user.location.serviceType === 'en_ligne') ? '' : 'display:none')
                        .loc-simple-block
                            label.loc-simple-label Pays
                            select.input.loc-simple-input#locCountryInput
                                option(value="" disabled selected=(!(user.location && user.location.onlineCountry))) — Sélectionnez un pays —
                                option(value="BE" selected=(user.location && user.location.onlineCountry === 'BE')) 🇧🇪 Belgique
                                option(value="FR" selected=(user.location && user.location.onlineCountry === 'FR')) 🇫🇷 France
                                option(value="CH" selected=(user.location && user.location.onlineCountry === 'CH')) 🇨🇭 Suisse
                                option(value="LU" selected=(user.location && user.location.onlineCountry === 'LU')) 🇱🇺 Luxembourg
                                option(value="CA" selected=(user.location && user.location.onlineCountry === 'CA')) 🇨🇦 Canada
                                option(value="MA" selected=(user.location && user.location.onlineCountry === 'MA')) 🇲🇦 Maroc
                                option(value="TN" selected=(user.location && user.location.onlineCountry === 'TN')) 🇹🇳 Tunisie
                                option(value="SN" selected=(user.location && user.location.onlineCountry === 'SN')) 🇸🇳 Sénégal
                                option(value="OTHER" selected=(user.location && user.location.onlineCountry === 'OTHER')) 🌍 Autre
                        .loc-simple-block
                            label.loc-simple-label Langue(s) de travail
                            select.input.loc-simple-input#locLangInput(multiple style="height:auto;min-height:44px;padding:8px 12px;")
                                - var _langs = (user.location && user.location.onlineLangs) || []
                                option(value="fr" selected=_langs.includes('fr')) 🇫🇷 Français
                                option(value="en" selected=_langs.includes('en')) 🇬🇧 Anglais
                                option(value="nl" selected=_langs.includes('nl')) 🇳🇱 Néerlandais
                                option(value="de" selected=_langs.includes('de')) 🇩🇪 Allemand
                                option(value="es" selected=_langs.includes('es')) 🇪🇸 Espagnol
                                option(value="ar" selected=_langs.includes('ar')) 🇸🇦 Arabe
                                option(value="pt" selected=_langs.includes('pt')) 🇵🇹 Portugais
                                option(value="it" selected=_langs.includes('it')) 🇮🇹 Italien
                            p.loc-simple-hint Ctrl+clic (ou Cmd sur Mac) pour sélectionner plusieurs langues.

                    //- ── Champ iframe (mode iframe) ─────────────────────────
                    #locIframeFields(style=(user.location && user.location.serviceType === 'iframe') ? '' : 'display:none')
                        .loc-simple-block
                            label.loc-simple-label Code iframe Google Maps
                            textarea.input.loc-simple-input#locIframeInput(
                                rows="3"
                                placeholder="Collez ici le code <iframe ...> copié depuis Google Maps → Partager → Intégrer une carte"
                                style="resize:vertical;font-size:12px;font-family:monospace;"
                            )= (user.location && user.location.iframeEmbedCode) || ''
                            p.loc-simple-hint
                                | Sur Google Maps : clic droit sur un lieu →&nbsp;
                                strong Partager
                                | &nbsp;→&nbsp;
                                strong Intégrer une carte
                                | &nbsp;→ copiez le code complet.

                    //- Champs cachés compatibilité
                    input(type="hidden" id="latInput" value=(user.location && user.location.lat) || "")
                    input(type="hidden" id="lonInput" value=(user.location && user.location.lon) || "")
                    input(type="hidden" id="streetInput" value=(user.location && user.location.address) || "")
                    input(type="hidden" id="zipInput" value=(user.location && user.location.zip) || "")
                    input(type="hidden" id="cityInput" value=(user.location && user.location.city) || "")
                    input(type="hidden" id="countryInput" value=(user.location && user.location.country) || "")
                    input(type="hidden" id="cityInputOnline")
                    input(type="hidden" id="countryInputOnline")
                    input(type="hidden" id="gmapUrlInput" value=(user.location && user.location.gmapUrl) || "")
                    div#addressInput(style="display:none")
                    div#results(style="display:none")
                    div#fullAddressBlock(style="display:none")
                    div#onlineAddressBlock(style="display:none")
                    div#addressSearchBlock(style="display:none")

                    .info-card__actions(style="margin-top:4px")
                        button.sm-btn.sm-btn--primary#confirmLocation
                            span Confirmer

        //- ── Galerie photos ──────────────────────────────────────────────────────
        .info-card
            .info-card__header.info-card__header--with-cb
                .info-card__header__left
                    h3 Galerie photos
                    p.info-card__desc Ajoutez jusqu'à 12 photos de votre établissement.
                label.section-cb-label(for="toggleSectionGallery" title="Afficher la galerie sur la page publique")
                    input#toggleSectionGallery.toggle-cb(type="checkbox" checked=!!cs.showSectionGallery)
                    span.section-pill Galerie

            //- ── Format d'affichage de la galerie sur la page publique ──────
            //- Aperçus miniatures pour visualiser comment les photos
            //- apparaîtront aux visiteurs (grille classique ou carrousel
            //- défilant) avant même de publier — répond au besoin
            //- "montrer 2-3 formats de présentation, comme un carrousel".
            - var _galleryLayout = cs.galleryLayout || 'grid'
            .gallery-layout-picker
                span.gallery-layout-picker__label Format d'affichage côté visiteur
                .gallery-layout-opts#galleryLayoutOpts
                    button.gallery-layout-opt(type="button" data-layout="grid" class=(_galleryLayout === 'grid' ? 'is-active' : ''))
                        .gallery-layout-opt__preview.gallery-layout-opt__preview--grid
                            span
                            span
                            span
                            span
                        span.gallery-layout-opt__name Grille
                    button.gallery-layout-opt(type="button" data-layout="carousel" class=(_galleryLayout === 'carousel' ? 'is-active' : ''))
                        .gallery-layout-opt__preview.gallery-layout-opt__preview--carousel
                            span
                            span
                            span
                        span.gallery-layout-opt__name Carrousel
                span.gallery-layout-picker__status#galleryLayoutStatus

            .gallery-grid#galleryGrid
                each photo, idx in gallery
                    .gallery-item(data-index=idx draggable="true")
                        img(src=photo alt="Photo " + (idx+1))
                        button.gallery-item__del(type="button" data-index=idx title="Supprimer")
                            svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
                if gallery.length < 12
                    label.gallery-add-btn(for="galleryFileInput")
                        svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                            path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                        span Ajouter
                        input#galleryFileInput(type="file" accept="image/*" multiple style="display:none")

        //- ── URL personnalisée ────────────────────────────────────────────────
        .info-card#partage-lien
            .info-card__header
                h3= t.info.custom_url_title || 'URL personnalisée'
                p.info-card__desc= t.info.custom_url_desc || 'Choisissez une URL unique pour votre page de réservation publique.'
            if !canUseCustomUrl
                .info-addon-gate
                    svg(xmlns="http://www.w3.org/2000/svg" height="28px" viewBox="0 -960 960 960" width="28px" fill="currentColor")
                        path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm0-80h480v-400H240v400Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80ZM240-160v-400 400Z")
                    .info-addon-gate__text
                        strong URL personnalisée — Business
                        if isPro
                            p Incluse dans le plan Business. Disponible également en add-on (+5€/mois).
                        else
                            p Incluse dans le plan Business, ou en add-on (+5€/mois) à partir du plan Pro.
                        .info-addon-gate__preview
                            span.info-addon-gate__preview-dim branshee.com/
                            span.info-addon-gate__preview-slug= (currentCompany && currentCompany.slug) ? currentCompany.slug : (user.businessName ? user.businessName.toLowerCase().replace(/\s+/g, '-') : 'mon-salon')
                    if isPro
                        .addon-btns
                            button.sm-btn.sm-btn--primary#buyAddonCustomUrlBtn(type="button") Activer — 5€/mois
                            a.sm-btn.sm-btn--ghost(href="/subscription") Passer au Business
                    else
                        a.btn-upgrade-pro(href="/subscription") Passer au Pro
            else
                .field
                    label= t.info.custom_url_label || 'Nom d\'URL'
                    .slug-field-wrapper
                        span.slug-prefix branshee.com/
                        input.input#slugInput(
                            type="text"
                            value=(currentCompany && currentCompany.slug ? currentCompany.slug : '')
                            placeholder="mon-salon"
                            autocomplete="off"
                        )
                    .slug-status#slugStatus
                if currentCompany && (currentCompany.slug || currentCompany._id)
                    .slug-share-row
                        .slug-share-url#slugShareUrl= 'branshee.com/' + (currentCompany.slug || String(currentCompany._id))
                        button.sm-btn.sm-btn--ghost#copySlugBtn(type="button")
                            svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                path(d="M360-240q-33 0-56.5-23.5T280-320v-480q0-33 23.5-56.5T360-880h360q33 0 56.5 23.5T800-800v480q0 33-23.5 56.5T720-240H360Zm0-80h360v-480H360v480ZM200-80q-33 0-56.5-23.5T120-160v-560h80v560h440v80H200Zm160-240v-480 480Z")
                            span Copier le lien
                .info-card__actions
                    button.sm-btn.sm-btn--primary#saveSlugBtn
                        span= t.info.custom_url_save || 'Enregistrer l\'URL'

        //- ── Ordre des sections ──────────────────────────────────────────────
        .info-card
            .info-card__header
                h3 Ordre des sections
                p.info-card__desc Glissez les sections pour définir l'ordre d'affichage sur votre page publique.
            -
                var _sectionMeta = {
                    about:    { label: 'À propos',    icon: 'M440-280h80v-240h-80v240Zm40-320q17 0 28.5-11.5T520-640q0-17-11.5-28.5T480-680q-17 0-28.5 11.5T440-640q0 17 11.5 28.5T480-600Z' },
                    location: { label: 'Localisation', icon: 'M480-480q33 0 56.5-23.5T560-560q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 33 23.5 56.5T480-480Zm0 294q122-112 181-203.5T720-552q0-109-69.5-178.5T480-800q-101 0-170.5 69.5T240-552q0 71 59 162.5T480-186Z' },
                    hours:    { label: 'Horaires',    icon: 'M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z' },
                    gallery:  { label: 'Galerie',     icon: 'M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Zm0-80h560v-560H200v560Zm40-80h480L570-480 450-320l-90-120-120 160Z' }
                }
                // Les avis sont toujours en dernier (pas draggable)
                var _order = (sectionOrder || ['about','location','hours','gallery']).filter(function(k){ return k !== 'reviews'; })

            //- Item "Prise de rendez-vous" verrouillé en premier
            .section-order-list#sectionOrderList
                .section-order-item.section-order-item--locked
                    .section-order-item__grip
                        svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor" style="opacity:.2")
                            path(d="M360-160q-33 0-56.5-23.5T280-240q0-33 23.5-56.5T360-320q33 0 56.5 23.5T440-240q0 33-23.5 56.5T360-160Zm240 0q-33 0-56.5-23.5T520-240q0-33 23.5-56.5T600-320q33 0 56.5 23.5T680-240q0 33-23.5 56.5T600-160ZM360-440q-33 0-56.5-23.5T280-520q0-33 23.5-56.5T360-600q33 0 56.5 23.5T440-520q0 33-23.5 56.5T360-440Zm240 0q-33 0-56.5-23.5T520-520q0-33 23.5-56.5T600-600q33 0 56.5 23.5T680-520q0 33-23.5 56.5T600-440ZM360-720q-33 0-56.5-23.5T280-800q0-33 23.5-56.5T360-880q33 0 56.5 23.5T440-800q0 33-23.5 56.5T360-720Zm240 0q-33 0-56.5-23.5T520-800q0-33 23.5-56.5T600-880q33 0 56.5 23.5T680-800q0 33-23.5 56.5T600-720Z")
                    svg.section-order-item__icon(viewBox="0 -960 960 960" height="17" width="17" fill="currentColor")
                        path(d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Z")
                    span.section-order-item__label Prise de rendez-vous
                    span.section-order-item__lock
                        svg(viewBox="0 -960 960 960" height="13" width="13" fill="currentColor")
                            path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80Z")
                        | Toujours en 1er

                each sKey in _order
                    - var sm = _sectionMeta[sKey]
                    if sm
                        .section-order-item(data-key=sKey)
                            .section-order-item__grip
                                svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
