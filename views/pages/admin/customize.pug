extends ../../layouts/admin

block links
    link(rel="stylesheet" href="/css/layouts/informations.css")
    link(rel="stylesheet" href="/css/layouts/customize.css")

block content
    - var cs = calendarSettings || {}

    .info-page

        .info-page__header
            h2 Personnaliser votre page
            p.info-page__subtitle Gérez votre établissement, votre URL, vos réseaux sociaux et les sections de votre page publique.

        //- ── Profil de l'établissement ──────────────────────────────────────────
        .info-card
            .info-card__header.info-card__header--with-cb
                .info-card__header__left
                    h3 Profil de l'établissement
                    p.info-card__desc Ces informations sont affichées en haut de votre page de réservation.
                label.section-cb-label(for="toggleSectionAbout" title="Afficher la description « À propos » sur la page publique")
                    input#toggleSectionAbout.toggle-cb(type="checkbox" checked=cs.showSectionAbout !== false)
                    span.section-pill À propos
            .biz-row
                .biz-photo-col
                    .biz-photo-preview
                        if user.businessPicture
                            img#businessPicPreview(alt="Photo de l'établissement" src=user.businessPicture)
                        else
                            .biz-photo-placeholder#businessPicPreview
                                svg(xmlns="http://www.w3.org/2000/svg" height="32px" viewBox="0 -960 960 960" width="32px" fill="currentColor")
                                    path(d="M160-120q-33 0-56.5-23.5T80-200v-480q0-33 23.5-56.5T160-760h126l74-80h240l74 80h126q33 0 56.5 23.5T880-680v480q0 33-23.5 56.5T800-120H160Zm0-80h640v-480H160v480Zm320-80q-58 0-99-41t-41-99q0-58 41-99t99-41q58 0 99 41t41 99q0 58-41 99t-99 41Zm0-80q25 0 42.5-17.5T540-420q0-25-17.5-42.5T480-480q-25 0-42.5 17.5T420-420q0 25 17.5 42.5T480-360Z")
                    input#businessFileInput(type="file" style="display:none" accept="image/*")
                    button.sm-btn.sm-btn--ghost#uploadBusinessBtn
                        span Photo
                .biz-fields
                    .field
                        label Nom de l'établissement
                        input.input#businessNameInput(
                            type="text"
                            value=user.businessName || ""
                            placeholder="Ex: Salon de Marie"
                        )
                    .field
                        label Description
                        textarea.textarea#descriptionCoach(maxlength=500 placeholder="Décrivez votre activité en quelques mots...")= user.description || ''
                        span.field-hint#descCount #{(user.description || '').length}/500
                    .field
                        label Type d'activité
                        .service-select-wrapper
                            input.input#businessTypeInput(
                                type="text"
                                placeholder="Ex: Coiffeur, Médecin, Coach sportif..."
                                autocomplete="off"
                                value=user.businessType || ""
                            )
                            .service-dropdown#businessTypeDropdown
            .info-card__actions
                button.sm-btn.sm-btn--primary#saveBusinessInfo
                    span Enregistrer

        //- ── Localisation ───────────────────────────────────────────────────────
        .info-card
            .info-card__header.info-card__header--with-cb
                .info-card__header__left
                    h3 Localisation
                    p.info-card__desc Votre adresse est affichée sur la carte de votre page publique.
                .info-card__header__cbs
                    label.section-cb-label(for="toggleSectionMap" title="Afficher la carte sur la page publique")
                        input#toggleSectionMap.toggle-cb(type="checkbox" checked=cs.showSectionMap !== false)
                        span.section-pill Carte
                    label.section-cb-label(for="toggleSectionHours" title="Afficher les horaires sur la page publique")
                        input#toggleSectionHours.toggle-cb(type="checkbox" checked=cs.showSectionHours !== false)
                        span.section-pill Horaires
            .location-layout
                .location-map#mapContainer
                    if user.location && user.location.iframeUrl
                        iframe(src=user.location.iframeUrl style="border:0;width:100%;height:300px;display:block;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade")
                    else
                        iframe(src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2624.9916256937595!2d2.292292615509614!3d48.85837360866272!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47e66e2964e34e2d%3A0x8ddca9ee380ef7e0!2sTour%20Eiffel!5e0!3m2!1sfr!2sfr!4v1680000000000!5m2!1sfr!2sfr" style="border:0;width:100%;height:300px;display:block;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade")
                .location-form
                    input(type="hidden" id="latInput" value=(user.location && user.location.lat) || "")
                    input(type="hidden" id="lonInput" value=(user.location && user.location.lon) || "")

                    //- ── Type de service ────────────────────────────────────
                    .field
                        .radio-group
                            .radio-item
                                input#onlineService(type="radio" name="serviceType" checked=(!(user.location && user.location.serviceType === 'en_ligne')))
                                label(for="onlineService")
                                    span.custom-radio
                                    = t.info.on_site
                            .radio-item
                                input#homeService(type="radio" name="serviceType" checked=(user.location && user.location.serviceType === 'en_ligne'))
                                label(for="homeService")
                                    span.custom-radio
                                    = t.info.online_svc

                    //- ── Sélecteur de méthode ───────────────────────────────
                    .loc-methods#locMethods
                        button.loc-method-btn.active(type="button" data-method="address") Adresse
                        button.loc-method-btn(type="button" data-method="gmap") Lien Google Maps
                        button.loc-method-btn(type="button" data-method="gps") Coordonnées GPS

                    //- ── Méthode 1 : Adresse ────────────────────────────────
                    #locMethodAddress
                        #addressSearchBlock.field
                            label= t.info.search_addr
                            input.input(placeholder=t.info.addr_placeholder id="addressInput" autocomplete="chrome-off")
                            #results.results
                        #fullAddressBlock
                            .field
                                label= t.info.address
                                input.input(id='streetInput' value=(user.location && user.location.address) || "")
                            .field
                                label= t.info.zip
                                input.input(id='zipInput' value=(user.location && user.location.zip) || "")
                            .field
                                label= t.info.city
                                input.input(id='cityInput' value=(user.location && user.location.city) || "")
                            .field
                                label= t.info.country
                                input.input(id='countryInput' value=(user.location && user.location.country) || "")
                        #onlineAddressBlock(style="display:none")
                            .field
                                label= t.info.country
                                input.input(id='countryInputOnline' value=(user.location && user.location.country) || "")
                            .field
                                label= t.info.city_optional
                                input.input(id='cityInputOnline' value=(user.location && user.location.city) || "")

                    //- ── Méthode 2 : Lien Google Maps ───────────────────────
                    #locMethodGmap(style="display:none")
                        .field
                            label Lien Google Maps
                            input.input#gmapUrlInput(
                                type="text"
                                placeholder="https://maps.google.com/?q=... ou https://www.google.com/maps/@..."
                                value=(user.location && user.location.gmapUrl) || ""
                            )
                            p.field-hint Collez le lien copié depuis Google Maps (clic droit → Partager → Copier le lien).
                        p.loc-parse-status#gmapParseStatus

                    //- ── Méthode 3 : Coordonnées GPS ────────────────────────
                    #locMethodGps(style="display:none")
                        .field
                            label Latitude
                            input.input#gpsLatInput(
                                type="number"
                                step="0.000001"
                                placeholder="ex: 48.856600"
                                value=(user.location && user.location.lat) || ""
                            )
                        .field
                            label Longitude
                            input.input#gpsLonInput(
                                type="number"
                                step="0.000001"
                                placeholder="ex: 2.352200"
                                value=(user.location && user.location.lon) || ""
                            )
                        p.field-hint Trouvez vos coordonnées sur Google Maps : clic droit sur le lieu → les coordonnées s'affichent en haut du menu.

                    .info-card__actions(style="margin-top:4px")
                        button.sm-btn.sm-btn--primary#confirmLocation
                            span= t.info.confirm_location

        //- ── Galerie photos ──────────────────────────────────────────────────────
        .info-card
            .info-card__header.info-card__header--with-cb
                .info-card__header__left
                    h3 Galerie photos
                    p.info-card__desc Ajoutez jusqu'à 12 photos de votre établissement.
                label.section-cb-label(for="toggleSectionGallery" title="Afficher la galerie sur la page publique")
                    input#toggleSectionGallery.toggle-cb(type="checkbox" checked=!!cs.showSectionGallery)
                    span.section-pill Galerie
            .gallery-grid#galleryGrid
                each photo, idx in gallery
                    .gallery-item(data-index=idx)
                        img(src=photo alt="Photo " + (idx+1))
                        button.gallery-item__del(type="button" data-index=idx title="Supprimer")
                            svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
                if gallery.length < 12
                    label.gallery-add-btn(for="galleryFileInput")
                        svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                            path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                        span Ajouter
                        input#galleryFileInput(type="file" accept="image/*" multiple style="display:none")

        //- ── URL personnalisée ────────────────────────────────────────────────
        .info-card
            .info-card__header
                h3= t.info.custom_url_title || 'URL personnalisée'
                p.info-card__desc= t.info.custom_url_desc || 'Choisissez une URL unique pour votre page de réservation publique.'
            if !canUseCustomUrl
                .info-addon-gate
                    svg(xmlns="http://www.w3.org/2000/svg" height="28px" viewBox="0 -960 960 960" width="28px" fill="currentColor")
                        path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm0-80h480v-400H240v400Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80ZM240-160v-400 400Z")
                    .info-addon-gate__text
                        strong URL personnalisée — Business
                        if isPro
                            p Incluse dans le plan Business. Disponible également en add-on (+5€/mois).
                        else
                            p Incluse dans le plan Business, ou en add-on (+5€/mois) à partir du plan Pro.
                        .info-addon-gate__preview
                            span.info-addon-gate__preview-dim branshee.com/
                            span.info-addon-gate__preview-slug= (currentCompany && currentCompany.slug) ? currentCompany.slug : (user.businessName ? user.businessName.toLowerCase().replace(/\s+/g, '-') : 'mon-salon')
                    if isPro
                        a.btn-upgrade-business(href="/subscription") Passer au Business
                    else
                        a.btn-upgrade-pro(href="/subscription") Passer au Pro
            else
                .field
                    label= t.info.custom_url_label || 'Nom d\'URL'
                    .slug-field-wrapper
                        span.slug-prefix branshee.com/
                        input.input#slugInput(
                            type="text"
                            value=(currentCompany && currentCompany.slug ? currentCompany.slug : '')
                            placeholder="mon-salon"
                            autocomplete="off"
                        )
                    .slug-status#slugStatus
                if currentCompany && (currentCompany.slug || currentCompany._id)
                    .slug-share-row
                        .slug-share-url#slugShareUrl= 'branshee.com/' + (currentCompany.slug || String(currentCompany._id))
                        button.sm-btn.sm-btn--ghost#copySlugBtn(type="button")
                            svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                path(d="M360-240q-33 0-56.5-23.5T280-320v-480q0-33 23.5-56.5T360-880h360q33 0 56.5 23.5T800-800v480q0 33-23.5 56.5T720-240H360Zm0-80h360v-480H360v480ZM200-80q-33 0-56.5-23.5T120-160v-560h80v560h440v80H200Zm160-240v-480 480Z")
                            span Copier le lien
                .info-card__actions
                    button.sm-btn.sm-btn--primary#saveSlugBtn
                        span= t.info.custom_url_save || 'Enregistrer l\'URL'

        //- ── Réseaux sociaux ─────────────────────────────────────────────────
        .info-card
            .info-card__header
                h3= t.profile.social_title || 'Réseaux sociaux'
                p.info-card__desc= t.info.social_desc || 'Affichez vos coordonnées sur votre page publique.'
            .social-grid
                -
                    var csS = (user.calendarSettings) ? user.calendarSettings : {}
                    var socials = [
                        { name: 'emailPro',      toggle: 'showEmailPro',  logo: 'email-logo.webp',     alt: 'Email',      label: t.profile.social.email_pro,  val: user.emailPro      || '', ph: 'contact@monactivite.com',                   type: 'email' },
                        { name: 'phonePro',      toggle: 'showPhonePro',  logo: 'phone-logo.webp',     alt: 'Téléphone',  label: t.profile.social.phone_pro,  val: user.phonePro      || '', ph: '+32 476 12 34 56',                          type: 'phone' },
                        { name: 'instagramLink', toggle: 'showInstagram', logo: 'instagram-logo.webp', alt: 'Instagram',  label: t.profile.social.instagram,  val: user.instagramLink || '', ph: 'https://instagram.com/moncompte',           type: 'url'   },
                        { name: 'whatsappLink',  toggle: 'showWhatsapp',  logo: 'whatsapp-logo.webp',  alt: 'WhatsApp',   label: t.profile.social.whatsapp,   val: user.whatsappLink  || '', ph: '+32 476 12 34 56 ou https://wa.link/...',    type: 'whatsapp' },
                        { name: 'facebookLink',  toggle: 'showFacebook',  logo: 'facebook-logo.webp',  alt: 'Facebook',   label: t.profile.social.facebook,   val: user.facebookLink  || '', ph: 'https://facebook.com/mapage',               type: 'url'   },
                        { name: 'website',       toggle: 'showWebsite',   logo: 'website-logo.webp',   alt: 'Site Web',   label: t.profile.social.website,    val: user.website       || '', ph: 'https://monsite.com',                       type: 'url'   }
                    ]
                each s in socials
                    -
                        var isOn = (csS[s.toggle] !== false)
                        // Détecter si la valeur actuelle semble invalide (URL attendue mais pas de http)
                        var isInvalidUrl = s.type === 'url' && s.val && !/^https?:\/\//.test(s.val)
                        var isInvalidEmail = s.type === 'email' && s.val && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s.val)
                        var hasCurrentError = isInvalidUrl || isInvalidEmail
                    .social-box(data-name=s.name data-type=s.type class=(!isOn ? 'social-box--hidden' : ''))
                        if !canUseSocial
                            a.btn-upgrade-pro.get__premium(href="/subscription") Passer au Pro
                        label.social-visibility-toggle(title=t.info.toggle_visibility data-toggle=s.toggle)
                            input.social-visibility-toggle__input(
                                type="checkbox"
                                checked=isOn
                                disabled=(!canUseSocial)
                            )
                            span.social-visibility-toggle__track
                                span.social-visibility-toggle__thumb
                        .social-box__logo
                            img(src="/images/logos/" + s.logo alt=s.alt)
                        .social-box__title= s.label
                        .social-box__field
                            input.input(
                                placeholder=s.ph
                                value=s.val
                                disabled=(!canUseSocial)
                                class=(hasCurrentError ? 'input--error' : '')
                            )
                            button.sm-btn.sm-btn--ghost.btn__social-save
                                span= t.avail.save
                        if hasCurrentError
                            .social-box__error ⚠️ Valeur invalide — veuillez entrer #{s.type === 'url' ? 'un lien valide (https://...)' : 'une adresse email valide'}




block scripts
    script(src='/js/layouts/informations.js')
    script.
        (function () {
            var __services = !{JSON.stringify(services)};

            // ── Business type autocomplete ────────────────────────────────────
            var btInput   = document.getElementById('businessTypeInput');
            var btDropdown = document.getElementById('businessTypeDropdown');

            function normalize(str) {
                return str.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
            }
            function renderBtList(items) {
                btDropdown.innerHTML = '';
                if (!items.length) { btDropdown.style.display = 'none'; return; }
                items.forEach(function (item) {
                    var div = document.createElement('div');
                    div.className = 'service-dropdown__item';
                    div.textContent = item;
                    div.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                        btInput.value = item;
                        btDropdown.style.display = 'none';
                    });
                    btDropdown.appendChild(div);
                });
                btDropdown.style.display = 'block';
            }
            if (btInput && btDropdown) {
                btInput.addEventListener('input', function () {
                    var q = normalize(btInput.value.trim());
                    if (!q) { btDropdown.style.display = 'none'; return; }
                    renderBtList(__services.filter(function (s) { return normalize(s).includes(q); }).slice(0, 8));
                });
                btInput.addEventListener('focus', function () {
                    var q = normalize(btInput.value.trim());
                    if (q) renderBtList(__services.filter(function (s) { return normalize(s).includes(q); }).slice(0, 8));
                });
                btInput.addEventListener('blur', function () {
                    setTimeout(function () { btDropdown.style.display = 'none'; }, 150);
                });
            }

            // ── Description counter ───────────────────────────────────────────
            var textarea = document.getElementById('descriptionCoach');
            var counter  = document.getElementById('descCount');
            if (textarea && counter) {
                textarea.addEventListener('input', function () {
                    counter.textContent = textarea.value.length + '/500';
                });
            }

            // ── Save business info ────────────────────────────────────────────
            var saveBusinessInfo  = document.getElementById('saveBusinessInfo');
            var businessNameInput = document.getElementById('businessNameInput');
            if (saveBusinessInfo) {
                saveBusinessInfo.addEventListener('click', async function () {
                    var btn          = saveBusinessInfo;
                    var businessName = businessNameInput ? businessNameInput.value.trim() : '';
                    var description  = textarea ? textarea.value.trim() : '';
                    var businessType = btInput ? btInput.value.trim() : '';
                    var res = await fetch('/account/business-info', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ businessName, description, businessType })
                    });
                    var data = await res.json();
                    if (data.success) {
                        var span = btn.querySelector('span');
                        var orig = span.textContent;
                        span.textContent = '✓ Enregistré';
                        btn.disabled = true;
                        setTimeout(function () { span.textContent = orig; btn.disabled = false; }, 2500);
                    }
                });
            }

            // ── Gallery ───────────────────────────────────────────────────────
            var galleryGrid  = document.getElementById('galleryGrid');
            var galleryInput = document.getElementById('galleryFileInput');
            if (galleryInput && galleryGrid) {
                galleryInput.addEventListener('change', async function () {
                    if (!galleryInput.files.length) return;
                    var formData = new FormData();
                    Array.from(galleryInput.files).forEach(function (f) { formData.append('galleryPhotos', f); });
                    var res  = await fetch('/account/gallery', { method: 'PATCH', body: formData });
                    var data = await res.json();
                    if (data.success && data.paths) {
                        data.paths.forEach(function (path) {
                            var idx  = galleryGrid.querySelectorAll('.gallery-item').length;
                            var item = document.createElement('div');
                            item.className = 'gallery-item';
                            item.dataset.index = idx;
                            item.innerHTML = '<img src="' + path + '" alt="Photo"><button class="gallery-item__del" type="button" data-index="' + idx + '" title="Supprimer"><svg xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor"><path d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z"/></svg></button>';
                            var addBtn = galleryGrid.querySelector('.gallery-add-btn');
                            if (addBtn) galleryGrid.insertBefore(item, addBtn);
                            else galleryGrid.appendChild(item);
                        });
                        galleryInput.value = '';
                    }
                });
                galleryGrid.addEventListener('click', async function (e) {
                    var btn = e.target.closest('.gallery-item__del');
                    if (!btn) return;
                    var idx  = parseInt(btn.dataset.index, 10);
                    var res  = await fetch('/account/gallery/' + idx, { method: 'DELETE' });
                    var data = await res.json();
                    if (data.success) {
                        btn.closest('.gallery-item').remove();
                        galleryGrid.querySelectorAll('.gallery-item').forEach(function (el, i) {
                            el.dataset.index = i;
                            var delBtn = el.querySelector('.gallery-item__del');
                            if (delBtn) delBtn.dataset.index = i;
                        });
                    }
                });
            }

            // ── Section visibility toggles ────────────────────────────────────
            var sectionToggleMap = {
                toggleSectionAbout:   'showSectionAbout',
                toggleSectionHours:   'showSectionHours',
                toggleSectionGallery: 'showSectionGallery',
                toggleSectionMap:     'showSectionMap'
            };
            Object.keys(sectionToggleMap).forEach(function (id) {
                var cb = document.getElementById(id);
                if (!cb) return;
                cb.addEventListener('change', async function () {
                    var fieldName = sectionToggleMap[id];
                    var enabled   = cb.checked;
                    try {
                        await fetch('/account/toggle-section', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ fieldName, enabled })
                        });
                    } catch (_) {}
                });
            });


        })();
