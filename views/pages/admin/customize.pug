extends ../../layouts/admin

block links
    link(rel="stylesheet" href="/css/layouts/informations.css")
    link(rel="stylesheet" href="/css/layouts/customize.css")
    link(rel="stylesheet" href="/css/layouts/cz-design.css")
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&family=Lato:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@400;600;700&family=Nunito:wght@400;500;600;700&display=swap")

block content
    - var cs = calendarSettings || {}

    .info-page.cz-page

        //- ── Header avec onglets ────────────────────────────────────────────────
        .cz-header
            .cz-header__top
                h2.cz-header__title Personnaliser
                p.cz-header__sub Gérez votre page publique, vos rappels et vos sections.
            .cz-tabs
                button.cz-tab.is-active#czTabGeneral(type="button")
                    span.material-symbols-outlined(style="font-size:16px") settings
                    | &nbsp;Général
                button.cz-tab#czTabRappels(type="button")
                    span.material-symbols-outlined(style="font-size:16px") notifications
                    | &nbsp;Rappels
                button.cz-tab#czTabDesign(type="button")
                    span.material-symbols-outlined(style="font-size:16px") palette
                    | &nbsp;Design
                button.cz-tab#czTabIntegration(type="button")
                    span.material-symbols-outlined(style="font-size:16px") link
                    | &nbsp;Intégration

        //- ── PANNEAU GÉNÉRAL ────────────────────────────────────────────────────
        .cz-panel#czPanelGeneral(style="display:none")

        //- ── Profil de l'établissement ──────────────────────────────────────────
        -
            var _noPic  = !user.businessPicture
            var _noName = !user.businessName
            var _missingProfile = _noPic || _noName
            // Message ciblé sur ce qui manque VRAIMENT : afficher « ajoutez une
            // photo et un nom » alors que la photo est déjà là faisait douter.
            var _missingMsg = (_noPic && _noName)
                ? 'Ajoutez une photo et un nom pour que votre page de réservation soit complète et professionnelle.'
                : _noName
                    ? 'Ajoutez le nom de votre établissement pour compléter votre page de réservation.'
                    : 'Ajoutez une photo pour que votre page de réservation soit complète et professionnelle.'
        .info-card
            .info-card__header
                span.info-card__ic
                    span.material-symbols-outlined(style="font-size:19px") storefront
                h3 Profil de l'établissement
                p.info-card__desc Ces informations sont affichées en haut de votre page de réservation.
            //- Toujours rendu (masqué si complet) pour que le JS puisse le
            //- réafficher si l'utilisateur supprime sa photo ou vide le nom.
            .biz-incomplete-banner#bizIncompleteBanner(style=_missingProfile ? '' : 'display:none')
                span.material-symbols-outlined(style="font-size:16px") info
                span#bizIncompleteText= _missingMsg
            .biz-row
                .biz-photo-col
                    .biz-photo-preview(class=!user.businessPicture ? 'biz-photo-preview--empty' : '')
                        if user.businessPicture
                            img#businessPicPreview(alt="Photo de l'établissement" src=user.businessPicture)
                        else
                            .biz-photo-placeholder#businessPicPreview
                                span.material-symbols-outlined(style="font-size:32px") photo_camera
                    input#businessFileInput(type="file" style="display:none" accept="image/*")
                    .biz-photo-btns
                        button.sm-btn.sm-btn--ghost#uploadBusinessBtn
                            span Photo
                        button.sm-btn.sm-btn--ghost.sm-btn--danger#deleteBusinessPicBtn(type="button" style=user.businessPicture ? '' : 'display:none')
                            span Supprimer
                .biz-fields
                    .field
                        label Nom de l'établissement
                        input.input#businessNameInput(
                            type="text"
                            value=user.businessName || ""
                            placeholder="Ex: Salon de Marie"
                            class=!user.businessName ? 'input--warn' : ''
                        )
                    .field
                        label Type d'activité
                        .service-select-wrapper
                            input.input#businessTypeInput(
                                type="text"
                                placeholder="Ex: Coiffeur, Médecin, Coach sportif..."
                                autocomplete="off"
                                value=user.businessType || ""
                            )
                            .service-dropdown#businessTypeDropdown
                        p.field-hint#businessTypeHint Ce métier n'est pas dans la liste conseillée.
            .info-card__actions
                button.sm-btn.sm-btn--primary#saveBusinessInfo
                    span Enregistrer

        //- ── À propos (texte enrichi) ────────────────────────────────────────────
        .info-card.section-card(class=(cs.showSectionAbout === false ? 'section-card--off' : ''))
            .info-card__header.info-card__header--with-cb
                .info-card__header__left
                    span.info-card__ic
                        span.material-symbols-outlined(style="font-size:19px") article
                    h3 À propos
                    p.info-card__desc Présentez votre activité en détail — votre histoire, votre approche, ce qui vous distingue. Ce texte enrichi s'affiche dans la section « À propos » de votre page publique.
                label.section-cb-label(for="toggleSectionAbout" title="Afficher la section « À propos » sur la page publique")
                    input#toggleSectionAbout.toggle-cb(type="checkbox" checked=cs.showSectionAbout !== false)
                    span.section-pill À propos
            .section-off-banner
                span.material-symbols-outlined(style="font-size:16px") visibility_off
                span Cette section est masquée sur votre page publique — les visiteurs ne la verront pas.
            .section-body(style=(cs.showSectionAbout === false ? 'display:none' : ''))
                .about-editor
                    .about-editor__toolbar
                        button.about-editor__btn#aboutBoldBtn(type="button" title="Gras (Ctrl+B)" data-cmd="bold")
                            strong B
                        button.about-editor__btn#aboutItalicBtn(type="button" title="Italique (Ctrl+I)" data-cmd="italic")
                            em I
                        button.about-editor__btn#aboutUnderlineBtn(type="button" title="Souligné (Ctrl+U)" data-cmd="underline")
                            u U
                        span.about-editor__sep
                        button.about-editor__btn#aboutSizeDownBtn(type="button" title="Réduire la taille du texte sélectionné")
                            span A−
                        button.about-editor__btn#aboutSizeUpBtn(type="button" title="Agrandir la taille du texte sélectionné")
                            span A+
                    .about-editor__area#aboutEditor(contenteditable="true" data-placeholder="Parlez de votre activité, de votre parcours, de ce qui rend votre établissement unique…")!= user.aboutHtml || ''
                    .about-editor__footer
                        span.about-editor__hint 💡 Sélectionnez du texte, puis cliquez sur un bouton pour le mettre en forme.
                        span.field-hint#aboutCount 0/4000
                .info-card__actions
                    button.sm-btn.sm-btn--primary#saveAboutBtn
                        span Enregistrer
                    span.about-editor__status#aboutStatus

        //- ── Localisation ───────────────────────────────────────────────────────
        .info-card
            .info-card__header.info-card__header--with-cb
                .info-card__header__left
                    span.info-card__ic
                        span.material-symbols-outlined(style="font-size:19px") location_on
                    h3 Localisation
                    p.info-card__desc Votre adresse est affichée sur la carte de votre page publique.
                .info-card__header__cbs
                    label.section-cb-label(for="toggleSectionMap" title="Afficher la carte sur la page publique")
                        input#toggleSectionMap.toggle-cb(type="checkbox" checked=cs.showSectionMap !== false)
                        span.section-pill Carte
                    label.section-cb-label(for="toggleSectionHours" title="Afficher les horaires sur la page publique")
                        input#toggleSectionHours.toggle-cb(type="checkbox" checked=cs.showSectionHours !== false)
                        span.section-pill Horaires
            .location-layout
                .location-map#mapContainer
                    if user.location && user.location.iframeUrl
                        iframe(src=user.location.iframeUrl style="border:0;width:100%;height:300px;display:block;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade")
                    else
                        iframe(src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2624.9916256937595!2d2.292292615509614!3d48.85837360866272!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47e66e2964e34e2d%3A0x8ddca9ee380ef7e0!2sTour%20Eiffel!5e0!3m2!1sfr!2sfr!4v1680000000000!5m2!1sfr!2sfr" style="border:0;width:100%;height:300px;display:block;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade")
                .location-form
                    input(type="hidden" id="latInput" value=(user.location && user.location.lat) || "")
                    input(type="hidden" id="lonInput" value=(user.location && user.location.lon) || "")

                    //- ── Type de service ────────────────────────────────────
                    .field
                        .radio-group
                            .radio-item
                                input#onlineService(type="radio" name="serviceType" checked=(!(user.location && (user.location.serviceType === 'en_ligne' || user.location.serviceType === 'iframe'))))
                                label(for="onlineService")
                                    span.custom-radio
                                    = t.info.on_site
                            .radio-item
                                input#homeService(type="radio" name="serviceType" checked=(user.location && user.location.serviceType === 'en_ligne'))
                                label(for="homeService")
                                    span.custom-radio
                                    = t.info.online_svc
                            .radio-item
                                input#iframeService(type="radio" name="serviceType" checked=(user.location && user.location.serviceType === 'iframe'))
                                label(for="iframeService")
                                    span.custom-radio
                                    | Ajouter iframe

                    //- ── Champs adresse (mode sur-place) ─────────────────────
                    #locOnSiteFields(style=(user.location && (user.location.serviceType === 'en_ligne' || user.location.serviceType === 'iframe')) ? 'display:none' : '')
                        .loc-simple-block
                            label.loc-simple-label Adresse complète
                            input.input.loc-simple-input#locAddressInput(
                                type="text"
                                placeholder="Ex : Rue des Vallées 7, 1315 Incourt, Belgique"
                                value=(user.location && user.location.address && user.location.city ? (user.location.address + ', ' + (user.location.zip || '') + ' ' + user.location.city).trim() : '') || ""
                                autocomplete="off"
                            )
                            p.loc-simple-hint Entrez l'adresse complète. Elle sera utilisée pour afficher votre position sur la carte.
                        .loc-simple-block
                            label.loc-simple-label
                                | Lien Google Maps&nbsp;
                                span(style="font-weight:400;color:var(--text-muted);font-size:12px;") (optionnel — pour le bouton "Ouvrir dans Maps")
                            input.input.loc-simple-input#locGmapInput(
                                type="text"
                                placeholder="Collez votre lien Google Maps (long ou court maps.app.goo.gl/...)"
                                value=(user.location && user.location.gmapUrl) || ""
                                autocomplete="off"
                            )

                    //- ── Champs service en ligne (pays + langue) ──────────────
                    #locOnlineFields(style=(user.location && user.location.serviceType === 'en_ligne') ? '' : 'display:none')
                        -
                            // Les emojis drapeaux ne s'affichent pas sous Windows (la police
                            // système n'a pas les indicateurs régionaux) : on passe par des
                            // images dans /images/flags.
                            var _countries = [
                                { code: 'BE', name: 'Belgique',    flag: 'be.png' },
                                { code: 'FR', name: 'France',      flag: 'fr.png' },
                                { code: 'CH', name: 'Suisse',      flag: 'ch.png' },
                                { code: 'LU', name: 'Luxembourg',  flag: 'lu.png' },
                                { code: 'NL', name: 'Pays-Bas',    flag: 'nl.png' },
                                { code: 'DE', name: 'Allemagne',   flag: 'de.png' },
                                { code: 'ES', name: 'Espagne',     flag: 'es.png' },
                                { code: 'IT', name: 'Italie',      flag: 'it.png' },
                                { code: 'PT', name: 'Portugal',    flag: 'pt.svg' },
                                { code: 'GB', name: 'Royaume-Uni', flag: 'gb.png' },
                                { code: 'US', name: 'États-Unis',  flag: 'us.png' },
                                { code: 'CA', name: 'Canada',      flag: 'ca.svg' },
                                { code: 'MA', name: 'Maroc',       flag: 'ma.png' },
                                { code: 'TN', name: 'Tunisie',     flag: 'tn.svg' },
                                { code: 'SN', name: 'Sénégal',     flag: 'sn.svg' }
                            ]
                            var _curCountry = (user.location && user.location.onlineCountry) || ''
                            // Un pays hors liste a été saisi à la main : on rouvre le champ libre.
                            var _isOther = !!_curCountry && !_countries.some(function (c) { return c.code === _curCountry })
                        .loc-simple-block
                            label.loc-simple-label Pays
                            select.input.loc-simple-input#locCountryInput
                                option(value="" disabled selected=!_curCountry) — Sélectionnez un pays —
                                each c in _countries
                                    option(value=c.code data-flag='/images/flags/' + c.flag selected=(_curCountry === c.code))= c.name
                                option(value="OTHER" data-flag="/images/flags/_other.svg" selected=_isOther) Autre pays…
                            input.input.loc-simple-input#locCountryOtherInput(
                                type="text"
                                placeholder="Écrivez votre pays"
                                value=_isOther ? _curCountry : ''
                                autocomplete="country-name"
                                style=_isOther ? 'margin-top:8px' : 'display:none;margin-top:8px'
                            )
                        .loc-simple-block
                            label.loc-simple-label Langue(s) de travail
                            select.input.loc-simple-input#locLangInput(multiple style="height:auto;min-height:44px;padding:8px 12px;")
                                - var _langs = (user.location && user.location.onlineLangs) || []
                                -
                                    var _langList = [
                                        { code: 'fr', name: 'Français',    flag: 'fr.png' },
                                        { code: 'en', name: 'Anglais',     flag: 'gb.png' },
                                        { code: 'nl', name: 'Néerlandais', flag: 'nl.png' },
                                        { code: 'de', name: 'Allemand',    flag: 'de.png' },
                                        { code: 'es', name: 'Espagnol',    flag: 'es.png' },
                                        { code: 'it', name: 'Italien',     flag: 'it.png' },
                                        { code: 'pt', name: 'Portugais',   flag: 'pt.svg' },
                                        { code: 'ar', name: 'Arabe',       flag: 'sa.svg' }
                                    ]
                                each l in _langList
                                    option(value=l.code data-flag='/images/flags/' + l.flag selected=_langs.includes(l.code))= l.name
                            p.loc-simple-hint Cliquez pour cocher plusieurs langues.

                    //- ── Champ iframe (mode iframe) ─────────────────────────
                    #locIframeFields(style=(user.location && user.location.serviceType === 'iframe') ? '' : 'display:none')
                        .loc-simple-block
                            label.loc-simple-label Code iframe Google Maps
                            textarea.input.loc-simple-input#locIframeInput(
                                rows="3"
                                placeholder="Collez ici le code <iframe ...> copié depuis Google Maps → Partager → Intégrer une carte"
                                style="resize:vertical;font-size:12px;font-family:monospace;"
                            )= (user.location && user.location.iframeEmbedCode) || ''
                            p.loc-simple-hint
                                | Sur Google Maps : clic droit sur un lieu →&nbsp;
                                strong Partager
                                | &nbsp;→&nbsp;
                                strong Intégrer une carte
                                | &nbsp;→ copiez le code complet.

                    //- Champs cachés compatibilité
                    input(type="hidden" id="latInput" value=(user.location && user.location.lat) || "")
                    input(type="hidden" id="lonInput" value=(user.location && user.location.lon) || "")
                    input(type="hidden" id="streetInput" value=(user.location && user.location.address) || "")
                    input(type="hidden" id="zipInput" value=(user.location && user.location.zip) || "")
                    input(type="hidden" id="cityInput" value=(user.location && user.location.city) || "")
                    input(type="hidden" id="countryInput" value=(user.location && user.location.country) || "")
                    input(type="hidden" id="cityInputOnline")
                    input(type="hidden" id="countryInputOnline")
                    input(type="hidden" id="gmapUrlInput" value=(user.location && user.location.gmapUrl) || "")
                    div#addressInput(style="display:none")
                    div#results(style="display:none")
                    div#fullAddressBlock(style="display:none")
                    div#onlineAddressBlock(style="display:none")
                    div#addressSearchBlock(style="display:none")

                    .info-card__actions(style="margin-top:4px")
                        button.sm-btn.sm-btn--primary#confirmLocation
                            span Confirmer

        //- ── Galerie photos ──────────────────────────────────────────────────────
        .info-card.section-card(class=(!cs.showSectionGallery ? 'section-card--off' : ''))
            .info-card__header.info-card__header--with-cb
                .info-card__header__left
                    span.info-card__ic
                        span.material-symbols-outlined(style="font-size:19px") photo_library
                    h3 Galerie photos
                    p.info-card__desc Ajoutez jusqu'à 12 photos pour illustrer votre espace.
                label.section-cb-label(for="toggleSectionGallery" title="Afficher la galerie sur la page publique")
                    input#toggleSectionGallery.toggle-cb(type="checkbox" checked=!!cs.showSectionGallery)
                    span.section-pill Galerie
            .section-off-banner
                span.material-symbols-outlined(style="font-size:16px") visibility_off
                span Cette section est masquée sur votre page publique — les visiteurs ne la verront pas.

            .gl-body
                - var _galleryLayout = cs.galleryLayout || 'grid'

                //- ── Toolbar : format + compteur ─────────────────────────────
                .gl-toolbar
                    span.gl-toolbar__label Format
                    .gl-layout-btns#glLayoutBtns
                        button.gl-layout-btn(type="button" data-layout="grid" class=(_galleryLayout === 'grid' ? 'is-active' : '') title="Grille uniforme")
                            span.material-symbols-outlined(style="font-size:14px") grid_view
                            span Grille
                        button.gl-layout-btn(type="button" data-layout="masonry" class=(_galleryLayout === 'masonry' ? 'is-active' : '') title="Mosaïque")
                            span.material-symbols-outlined(style="font-size:14px") view_quilt
                            span Mosaïque
                        button.gl-layout-btn(type="button" data-layout="carousel" class=(_galleryLayout === 'carousel' ? 'is-active' : '') title="Carrousel défilant")
                            span.material-symbols-outlined(style="font-size:14px") view_carousel
                            span Carrousel
                    .gl-right
                        span.gl-count
                            span#glCount #{gallery.length}
                            |  / 12
                        span.gl-saved#glLayoutSaved ✓

                //- ── Photos (flex-wrap, pas de CSS Grid) ────────────────────
                if gallery.length > 0
                    .gl-photos#glGrid
                        each photo, idx in gallery
                            .gl-item(data-index=idx draggable="true")
                                img.gl-item__img(src=photo alt="" loading="lazy")
                                .gl-item__overlay
                                    button.gl-item__del(type="button" data-index=idx title="Supprimer")
                                        span.material-symbols-outlined(style="font-size:14px") delete
                                    .gl-item__drag
                                        span.material-symbols-outlined(style="font-size:14px") drag_indicator

                //- ── État vide (sibling, pas dans la grille) ─────────────────
                if gallery.length === 0
                    .gl-empty#glEmpty
                        span.material-symbols-outlined(style="font-size:32px") image
                        p Aucune photo pour le moment
                        p.gl-empty__sub Cliquez sur le bouton ci-dessous pour ajouter vos premières photos.

                //- ── Bouton ajout — toujours visible ────────────────────────
                label.gl-upload(for="glFileInput" style=(gallery.length >= 12 ? 'display:none' : ''))
                    span.material-symbols-outlined(style="font-size:18px") upload
                    span Ajouter des photos
                    input#glFileInput(type="file" accept="image/*" multiple style="display:none")

        //- ── URL personnalisée ────────────────────────────────────────────────
        .info-card#partage-lien
            .info-card__header
                span.info-card__ic
                    span.material-symbols-outlined(style="font-size:19px") link
                h3= t.info.custom_url_title || 'URL personnalisée'
                p.info-card__desc= t.info.custom_url_desc || 'Choisissez une URL unique pour votre page de réservation publique.'
            if !canUseCustomUrl
                .info-addon-gate
                    span.material-symbols-outlined(style="font-size:28px") lock
                    .info-addon-gate__text
                        strong URL personnalisée — Business
                        if isPro
                            p Incluse dans le plan Business. Disponible également en add-on (+5€/mois).
                        else
                            p Incluse dans le plan Business, ou en add-on (+5€/mois) à partir du plan Pro.
                        .info-addon-gate__preview
                            span.info-addon-gate__preview-dim branshee.com/
                            span.info-addon-gate__preview-slug= (currentCompany && currentCompany.slug) ? currentCompany.slug : (user.businessName ? user.businessName.toLowerCase().replace(/\s+/g, '-') : 'mon-salon')
                    if isPro
                        .addon-btns
                            button.sm-btn.sm-btn--primary#buyAddonCustomUrlBtn(type="button") Activer — 5€/mois
                            a.sm-btn.sm-btn--ghost(href="/subscription") Passer au Business
                    else
                        a.btn-upgrade-pro(href="/subscription") Passer au Pro
            else
                .field
                    label= t.info.custom_url_label || 'Nom d\'URL'
                    .slug-field-wrapper
                        span.slug-prefix branshee.com/
                        input.input#slugInput(
                            type="text"
                            value=(currentCompany && currentCompany.slug ? currentCompany.slug : '')
                            placeholder="mon-salon"
                            autocomplete="off"
                        )
                    .slug-status#slugStatus
                if currentCompany && (currentCompany.slug || currentCompany._id)
                    .slug-share-row
                        .slug-share-url#slugShareUrl= 'branshee.com/' + (currentCompany.slug || String(currentCompany._id))
                        button.sm-btn.sm-btn--ghost#copySlugBtn(type="button")
                            span.material-symbols-outlined(style="font-size:14px") content_copy
                            span Copier le lien
                .info-card__actions
                    button.sm-btn.sm-btn--primary#saveSlugBtn
                        span= t.info.custom_url_save || 'Enregistrer l\'URL'

        //- ── Ordre des sections ──────────────────────────────────────────────
        .info-card
            .info-card__header
                span.info-card__ic
                    span.material-symbols-outlined(style="font-size:19px") swap_vert
                h3 Ordre des sections
                p.info-card__desc Glissez les sections pour définir l'ordre d'affichage sur votre page publique.
            -
                var _sectionMeta = {
                    about:    { label: 'À propos',    icon: 'info' },
                    location: { label: 'Localisation', icon: 'location_on' },
                    hours:    { label: 'Horaires',    icon: 'schedule' },
                    gallery:  { label: 'Galerie',     icon: 'image' }
                }
                // Les avis sont toujours en dernier (pas draggable)
                var _order = (sectionOrder || ['about','location','hours','gallery']).filter(function(k){ return k !== 'reviews'; })

            //- Item "Prise de rendez-vous" verrouillé en premier
            .section-order-list#sectionOrderList
                .section-order-item.section-order-item--locked
                    .section-order-item__grip
                        span.material-symbols-outlined(style="font-size:18px;opacity:.2") drag_indicator
                    span.material-symbols-outlined.section-order-item__icon(style="font-size:17px") event
                    span.section-order-item__label Prise de rendez-vous
                    span.section-order-item__lock
                        span.material-symbols-outlined(style="font-size:13px") lock
                        | Toujours en 1er

                each sKey in _order
                    - var sm = _sectionMeta[sKey]
                    if sm
                        .section-order-item(data-key=sKey)
                            .section-order-item__grip
                                span.material-symbols-outlined(style="font-size:18px") drag_indicator
                            span.material-symbols-outlined.section-order-item__icon(style="font-size:17px")= sm.icon
                            span.section-order-item__label= sm.label

                //- Item "Avis clients" verrouillé en dernier
                .section-order-item.section-order-item--locked
                    .section-order-item__grip
                        span.material-symbols-outlined(style="font-size:18px;opacity:.2") drag_indicator
                    span.material-symbols-outlined.section-order-item__icon(style="font-size:17px") star
                    span.section-order-item__label Avis clients
                    span.section-order-item__lock
                        span.material-symbols-outlined(style="font-size:13px") lock
                        | Toujours en dernier

            .section-order-status#sectionOrderStatus

        //- ── Réseaux sociaux ─────────────────────────────────────────────────
        .info-card
            .info-card__header
                span.info-card__ic
                    span.material-symbols-outlined(style="font-size:19px") share
                h3= t.profile.social_title || 'Réseaux sociaux'
                p.info-card__desc= t.info.social_desc || 'Affichez vos coordonnées sur votre page publique.'
            .social-grid
                -
                    var csS = (user.calendarSettings) ? user.calendarSettings : {}
                    var socials = [
                        { name: 'emailPro',      toggle: 'showEmailPro',  logo: 'email-logo.webp',     alt: 'Email',      label: t.profile.social.email_pro,  val: user.emailPro      || '', ph: 'contact@monactivite.com',                   type: 'email' },
                        { name: 'phonePro',      toggle: 'showPhonePro',  logo: 'phone-logo.webp',     alt: 'Téléphone',  label: t.profile.social.phone_pro,  val: user.phonePro      || '', ph: '+32 476 12 34 56',                          type: 'phone' },
                        { name: 'instagramLink', toggle: 'showInstagram', logo: 'instagram-logo.webp', alt: 'Instagram',  label: t.profile.social.instagram,  val: user.instagramLink || '', ph: 'https://instagram.com/moncompte',           type: 'url'   },
                        { name: 'whatsappLink',  toggle: 'showWhatsapp',  logo: 'whatsapp-logo.webp',  alt: 'WhatsApp',   label: t.profile.social.whatsapp,   val: user.whatsappLink  || '', ph: '+32 476 12 34 56 ou https://wa.link/...',    type: 'whatsapp' },
                        { name: 'facebookLink',  toggle: 'showFacebook',  logo: 'facebook-logo.webp',  alt: 'Facebook',   label: t.profile.social.facebook,   val: user.facebookLink  || '', ph: 'https://facebook.com/mapage',               type: 'url'   },
                        { name: 'website',       toggle: 'showWebsite',   logo: 'website-logo.webp',   alt: 'Site Web',   label: t.profile.social.website,    val: user.website       || '', ph: 'https://monsite.com',                       type: 'url'   }
                    ]
                each s in socials
                    -
                        var isOn = (csS[s.toggle] !== false)
                        // Détecter si la valeur actuelle semble invalide (URL attendue mais pas de http)
                        var isInvalidUrl = s.type === 'url' && s.val && !/^https?:\/\//.test(s.val)
                        var isInvalidEmail = s.type === 'email' && s.val && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s.val)
                        var hasCurrentError = isInvalidUrl || isInvalidEmail
                    .social-box(data-name=s.name data-type=s.type class=(!isOn ? 'social-box--hidden' : ''))
                        if !canUseSocial
                            a.btn-upgrade-pro.get__premium(href="/subscription") Passer au Pro
                        label.social-visibility-toggle(title=t.info.toggle_visibility data-toggle=s.toggle)
                            input.social-visibility-toggle__input(
                                type="checkbox"
                                checked=isOn
                                disabled=(!canUseSocial)
                            )
                            span.social-visibility-toggle__track
                                span.social-visibility-toggle__thumb
                        .social-box__logo
                            img(src="/images/logos/" + s.logo alt=s.alt)
                        .social-box__title= s.label
                        .social-box__field
                            input.input(
                                placeholder=s.ph
                                value=s.val
                                disabled=(!canUseSocial)
                                class=(hasCurrentError ? 'input--error' : '')
                            )
                            button.sm-btn.sm-btn--ghost.btn__social-save
                                span= t.avail.save
                        if hasCurrentError
                            .social-box__error ⚠️ Valeur invalide — veuillez entrer #{s.type === 'url' ? 'un lien valide (https://...)' : 'une adresse email valide'}

        //- ── PANNEAU RAPPELS ────────────────────────────────────────────────────
        .cz-panel#czPanelRappels(style="display:none")

            //- Plan gate
            if !isPro
                .plan-gate
                    span.plan-gate__lock 🔒
                    .plan-gate__body
                        strong.plan-gate__title Rappels automatiques
                        span.plan-gate__sub Disponible uniquement dans les plans Pro & Business.
                    a.btn-upgrade-pro.plan-gate__cta(href="/subscription") Passer au Pro →

            else
                .info-card
                    .info-card__header
                        .cz-reminder-header-icon
                            span.material-symbols-outlined(style="font-size:18px") notifications
                        .info-card__header__left
                            span.info-card__ic
                                span.material-symbols-outlined(style="font-size:19px") notifications
                            h3 Rappels automatiques
                            p.info-card__desc Un email est envoyé automatiquement à votre client avant son rendez-vous. Vous pouvez choisir le délai et personnaliser le message.

                    //- ── Délai d'envoi ─────────────────────────────────────────
                    .cz-reminder-section
                        .cz-reminder-label
                            span.material-symbols-outlined(style="font-size:15px") schedule
                            span Envoyer le rappel
                        .cz-delay-options#czDelayOptions
                            - var _delay = cs.reminderDelayHours || 24
                            each opt in [{v:6,l:'6h avant'},{v:12,l:'12h avant'},{v:24,l:'24h avant'},{v:48,l:'48h avant'},{v:72,l:'72h avant'}]
                                button.cz-delay-btn(
                                    type="button"
                                    data-hours=opt.v
                                    class=(_delay === opt.v ? 'is-active' : '')
                                ) #{opt.l}

                    //- ── Message personnalisé ───────────────────────────────────
                    .cz-reminder-section
                        .cz-reminder-label
                            span.material-symbols-outlined(style="font-size:15px") chat
                            span Message personnalisé
                        p.cz-reminder-hint Affiché dans l'email de rappel, dans un encadré "Message de votre prestataire". Laissez vide pour ne rien afficher.
                        .cz-reminder-msg-wrap
                            textarea.cz-reminder-msg#czReminderMsg(
                                placeholder="Ex : Pensez à venir en tenue confortable. En cas d'empêchement, merci de prévenir 24h à l'avance."
                                maxlength="300"
                                rows="4"
                            )= cs.reminderMessage || ''
                            .cz-reminder-msg-count
                                span#czReminderMsgCount= (cs.reminderMessage || '').length
                                | /300

                    //- ── Modes de paiement ─────────────────────────────────────
                    .cz-reminder-section
                        .cz-reminder-label
                            span.material-symbols-outlined(style="font-size:15px") payments
                            span Modes de paiement acceptés
                        p.cz-reminder-hint Indiqués dans l'email de rappel pour informer votre client comment régler le rendez-vous.
                        - var _payMethods = cs.reminderPaymentMethods || []
                        .cz-paymethod-options#czPayMethodOptions
                            each opt in [{v:'carte',l:'Carte bancaire'},{v:'especes',l:'Espèces'},{v:'qr_code',l:'QR code'},{v:'virement',l:'Virement'}]
                                button.cz-delay-btn.cz-paymethod-btn(
                                    type="button"
                                    data-method=opt.v
                                    class=(_payMethods.includes(opt.v) ? 'is-active' : '')
                                ) #{opt.l}
                        .cz-reminder-msg-wrap(style="margin-top:10px;")
                            textarea.cz-reminder-msg#czPaymentNote(
                                placeholder="Ex : Paiement par QR code disponible sur place, lien envoyé par SMS."
                                maxlength="200"
                                rows="2"
                            )= cs.reminderPaymentNote || ''
                            .cz-reminder-msg-count
                                span#czPaymentNoteCount= (cs.reminderPaymentNote || '').length
                                | /200

                    //- ── Rappel SMS ────────────────────────────────────────────
                    .cz-reminder-section
                        .cz-reminder-label
                            span.material-symbols-outlined(style="font-size:15px") sms
                            span Rappel par SMS

                        //- Usage du quota inclus ce mois
                        - var _smsPrice = (smsPriceCents / 100).toFixed(2)
                        p.cz-reminder-hint(style="margin-bottom:6px")
                            | Votre forfait inclut&nbsp;
                            strong= `${smsQuota} SMS/mois`
                            | . Une fois épuisé, comportement au choix ci-dessous.
                        .cz-sms-usage-bar(style="height:8px;border-radius:99px;background:var(--border-light,#e5e7eb);overflow:hidden;margin-bottom:6px")
                            - var _pct = smsQuota > 0 ? Math.min(100, Math.round(smsUsedThisMonth / smsQuota * 100)) : 0
                            .cz-sms-usage-fill(style=`height:100%;width:${_pct}%;background:var(--accent,#1a7a4a);border-radius:99px`)
                        p.cz-reminder-hint(style="margin-bottom:14px")
                            strong= `${smsUsedThisMonth} / ${smsQuota}`
                            | &nbsp;SMS inclus utilisés ce mois-ci

                        //- Choix 1 : rappels par SMS ou par email
                        label.cz-sms-toggle-row(style="display:flex;align-items:center;gap:10px;margin-bottom:6px")
                            input#czSmsEnabled(type="checkbox" checked=calendarSettings.smsRemindersEnabled)
                            span Envoyer les rappels par SMS (sinon par email)
                        p.cz-reminder-hint(style="margin:0 0 16px 30px") Décoché = rappels uniquement par email. Coché = SMS, avec repli email automatique si l'envoi échoue.

                        //- Choix 2 : autoriser le dépassement du forfait
                        label.cz-sms-toggle-row(style="display:flex;align-items:center;gap:10px;margin-bottom:6px")
                            input#czSmsOverage(type="checkbox" checked=calendarSettings.smsAllowOverage)
                            span Continuer en SMS au-delà du forfait (utilise mon solde)
                        p.cz-reminder-hint(style="margin:0 0 16px 30px")
                            | Décoché (défaut) = une fois vos #{smsQuota} SMS inclus épuisés, on passe à l'email — votre solde n'est jamais touché.
                            br
                            | Coché = les SMS continuent, décomptés de votre solde (#{_smsPrice}€/SMS). Solde vide → repli email.

                        //- Solde prépayé + recharge
                        .cz-sms-balance-box(style="padding:14px;background:var(--surface,#f9fafb);border-radius:10px;border:1px solid var(--border-light,#e5e7eb);margin-bottom:12px")
                            .cz-sms-balance-head(style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:4px")
                                span(style="font-weight:600") Solde SMS prépayé
                                strong#czSmsBalance(style="font-size:18px")= `${(smsBalanceCents / 100).toFixed(2)}€`
                            p.cz-reminder-hint(style="margin:0 0 12px")
                                = `Soit ~${Math.floor(smsBalanceCents / smsPriceCents)} SMS supplémentaires. Utilisé uniquement au-delà de votre quota inclus.`
                            .cz-sms-topup-buttons(style="display:flex;gap:6px;flex-wrap:wrap")
                                button.sm-btn.sm-btn--ghost.cz-sms-topup(type="button" data-pack="small") Recharger 10€
                                button.sm-btn.sm-btn--ghost.cz-sms-topup(type="button" data-pack="medium") 20€
                                button.sm-btn.sm-btn--ghost.cz-sms-topup(type="button" data-pack="large") 50€

                        //- Recharge automatique (off-session)
                        .cz-sms-autorecharge-box(style="padding:14px;background:var(--surface,#f9fafb);border-radius:10px;border:1px solid var(--border-light,#e5e7eb)")
                            label(style="display:flex;align-items:center;gap:10px;margin-bottom:8px")
                                input#czSmsArEnabled(type="checkbox" checked=smsAutoRecharge.enabled)
                                span(style="font-weight:600") Recharge automatique
                            p.cz-reminder-hint(style="margin:0 0 12px") Quand le solde passe sous le seuil, on reprélève automatiquement le montant choisi sur votre carte enregistrée. Vous n'êtes jamais à découvert, et jamais facturé après coup.
                            .cz-sms-ar-config(style="display:flex;align-items:center;gap:10px;flex-wrap:wrap")
                                span.cz-reminder-hint(style="margin:0") Si le solde &lt;
                                select#czSmsArThreshold.cz-select(style="padding:6px 8px;border-radius:8px;border:1px solid var(--border-light,#e5e7eb)")
                                    each v in [2,5,10,20]
                                        option(value=v selected=smsAutoRecharge.thresholdEuros === v)= `${v}€`
                                span.cz-reminder-hint(style="margin:0") recharger de
                                select#czSmsArAmount.cz-select(style="padding:6px 8px;border-radius:8px;border:1px solid var(--border-light,#e5e7eb)")
                                    each v in [10,20,50,100]
                                        option(value=v selected=smsAutoRecharge.amountEuros === v)= `${v}€`
                                button.sm-btn.sm-btn--primary#czSmsArSave(type="button") Enregistrer
                                span.cz-reminder-hint#czSmsArStatus(style="margin:0")

                    //- ── Preview ────────────────────────────────────────────────
                    .cz-reminder-section.cz-reminder-preview-section
                        .cz-reminder-label
                            span.material-symbols-outlined(style="font-size:15px") visibility
                            span Aperçu de l'email
                        .cz-reminder-preview#czReminderPreview
                            .cz-preview-badge ⏰&nbsp;Rappel de rendez-vous
                            p.cz-preview-delay#czPreviewDelay dans&nbsp;<strong>24h</strong>
                            .cz-preview-msg-box#czPreviewMsgBox(style="display:none")
                                .cz-preview-msg-label Message de votre prestataire
                                p.cz-preview-msg-text#czPreviewMsgText

                    //- ── Actions ────────────────────────────────────────────────
                    .info-card__actions
                        button.sm-btn.sm-btn--primary#czSaveReminder(type="button")
                            span#czSaveReminderText Enregistrer
                        span.cz-reminder-status#czReminderStatus

        //- ── PANNEAU DESIGN & COULEURS ─────────────────────────────────────────
        .cz-panel#czPanelDesign(style="display:none")
            - var bUrl = currentCompany ? ('/' + (currentCompany.slug || currentCompany._id)) : ''

            .cz-design
                //- ── Colonne contrôles ─────────────────────────────────────────
                .cz-design__controls

                    //- Thèmes — palettes complètes prêtes à l'emploi
                    .cz-ds-card
                        .cz-ds-card__head
                            .cz-ds-card__head-icon
                                span.material-symbols-outlined(style="font-size:16px") auto_awesome
                            p.cz-ds-card__title Thèmes
                        .cz-ds-card__body
                            p(style="font-size:12.5px;color:var(--muted,#6b7280);margin:0 0 12px") Un clic applique une palette complète (couleurs, police, arrondi, ombre) — vous pourrez ensuite tout affiner ci-dessous.
                            #czThemeGrid.cz-theme-grid

                    //- Couleurs principales
                    .cz-ds-card
                        .cz-ds-card__head
                            .cz-ds-card__head-icon
                                span.material-symbols-outlined(style="font-size:16px") colorize
                            p.cz-ds-card__title Couleurs principales
                        .cz-ds-card__body
                            .cz-color-row(data-color="accentColor")
                                .cz-color-row__label
                                    strong Couleur d'accent
                                    | Boutons, highlights
                                .cz-color-picker
                                    .cz-color-picker__swatch(style="background:" + (cs.accentColor || '#22c55e'))
                                    input(type="color" value=(cs.accentColor || '#22c55e') tabindex="-1" aria-hidden="true")
                                    input.cz-color-picker__hex(type="text" value=((cs.accentColor || '#22c55e').toUpperCase()) maxlength="7" spellcheck="false")
                                button.cz-color-reset(type="button" title="Réinitialiser")
                                    span.material-symbols-outlined(style="font-size:14px") refresh

                            .cz-color-row(data-color="accentText")
                                .cz-color-row__label
                                    strong Texte sur accent
                                    | Texte des boutons
                                .cz-color-picker
                                    .cz-color-picker__swatch(style="background:" + (cs.accentText || '#ffffff'))
                                    input(type="color" value=(cs.accentText || '#ffffff') tabindex="-1" aria-hidden="true")
                                    input.cz-color-picker__hex(type="text" value=((cs.accentText || '#ffffff').toUpperCase()) maxlength="7" spellcheck="false")
                                button.cz-color-reset(type="button" title="Réinitialiser")
                                    span.material-symbols-outlined(style="font-size:14px") refresh

                    //- Fond de page & calendrier
                    .cz-ds-card
                        .cz-ds-card__head
                            .cz-ds-card__head-icon
                                span.material-symbols-outlined(style="font-size:16px") wallpaper
                            p.cz-ds-card__title Fond de page & calendrier
                        .cz-ds-card__body
                            .cz-color-row(data-color="pageBg")
                                .cz-color-row__label
                                    strong Fond de la page
                                    | Arrière-plan général
                                .cz-color-picker
                                    .cz-color-picker__swatch(style="background:" + (cs.pageBg || '#f3f4f6'))
                                    input(type="color" value=(cs.pageBg || '#f3f4f6') tabindex="-1" aria-hidden="true")
                                    input.cz-color-picker__hex(type="text" value=((cs.pageBg || '#f3f4f6').toUpperCase()) maxlength="7" spellcheck="false")
                                button.cz-color-reset(type="button" title="Réinitialiser")
                                    span.material-symbols-outlined(style="font-size:14px") refresh

                            .cz-color-row(data-color="calBg")
                                .cz-color-row__label
                                    strong Surface calendrier
                                    | Fond des cartes
                                .cz-color-picker
                                    .cz-color-picker__swatch(style="background:" + (cs.calBg || '#ffffff'))
                                    input(type="color" value=(cs.calBg || '#ffffff') tabindex="-1" aria-hidden="true")
                                    input.cz-color-picker__hex(type="text" value=((cs.calBg || '#ffffff').toUpperCase()) maxlength="7" spellcheck="false")
                                button.cz-color-reset(type="button" title="Réinitialiser")
                                    span.material-symbols-outlined(style="font-size:14px") refresh

                    //- Jours & bouton
                    - var _accFallback  = cs.accentColor || '#22c55e'
                    - var _accTxtFallback = cs.accentText || '#ffffff'
                    - var _availFallback = cs.dayAvailableColor || '#16a34a'
                    .cz-ds-card
                        .cz-ds-card__head
                            .cz-ds-card__head-icon
                                span.material-symbols-outlined(style="font-size:16px") view_agenda
                            p.cz-ds-card__title Jours & bouton
                        .cz-ds-card__body
                            .cz-color-row(data-color="dayBg")
                                .cz-color-row__label
                                    strong Fond des jours
                                    | Cellules du calendrier
                                .cz-color-picker
                                    .cz-color-picker__swatch(style="background:" + (cs.dayBg || '#ffffff'))
                                    input(type="color" value=(cs.dayBg || '#ffffff') tabindex="-1" aria-hidden="true")
                                    input.cz-color-picker__hex(type="text" value=((cs.dayBg || '#ffffff').toUpperCase()) maxlength="7" spellcheck="false")
                                button.cz-color-reset(type="button" title="Réinitialiser")
                                    span.material-symbols-outlined(style="font-size:14px") refresh

                            .cz-color-row(data-color="daySelectedBg")
                                .cz-color-row__label
                                    strong Fond sélection
                                    | Jour sélectionné
                                .cz-color-picker
                                    .cz-color-picker__swatch(style="background:" + (cs.daySelectedBg || _accFallback))
                                    input(type="color" value=(cs.daySelectedBg || _accFallback) tabindex="-1" aria-hidden="true")
                                    input.cz-color-picker__hex(type="text" value=((cs.daySelectedBg || _accFallback).toUpperCase()) maxlength="7" spellcheck="false")
                                button.cz-color-reset(type="button" title="Suivre la couleur d'accent")
                                    span.material-symbols-outlined(style="font-size:14px") refresh

                            .cz-color-row(data-color="daySelectedText")
                                .cz-color-row__label
                                    strong Texte sélection
                                    | Jour sélectionné
                                .cz-color-picker
                                    .cz-color-picker__swatch(style="background:" + (cs.daySelectedText || _accTxtFallback))
                                    input(type="color" value=(cs.daySelectedText || _accTxtFallback) tabindex="-1" aria-hidden="true")
                                    input.cz-color-picker__hex(type="text" value=((cs.daySelectedText || _accTxtFallback).toUpperCase()) maxlength="7" spellcheck="false")
                                button.cz-color-reset(type="button" title="Suivre la couleur d'accent")
                                    span.material-symbols-outlined(style="font-size:14px") refresh

                            .cz-color-row(data-color="dayHoverBg")
                                .cz-color-row__label
                                    strong Survol du jour
                                    | Au passage du curseur
                                .cz-color-picker
                                    .cz-color-picker__swatch(style="background:" + (cs.dayHoverBg || _availFallback))
                                    input(type="color" value=(cs.dayHoverBg || _availFallback) tabindex="-1" aria-hidden="true")
                                    input.cz-color-picker__hex(type="text" value=((cs.dayHoverBg || _availFallback).toUpperCase()) maxlength="7" spellcheck="false")
                                button.cz-color-reset(type="button" title="Revenir au survol automatique")
                                    span.material-symbols-outlined(style="font-size:14px") refresh

                            .cz-color-row(data-color="btnHoverBg")
                                .cz-color-row__label
                                    strong Survol bouton
                                    | Bouton "Réserver"
                                .cz-color-picker
                                    .cz-color-picker__swatch(style="background:" + (cs.btnHoverBg || _accFallback))
                                    input(type="color" value=(cs.btnHoverBg || _accFallback) tabindex="-1" aria-hidden="true")
                                    input.cz-color-picker__hex(type="text" value=((cs.btnHoverBg || _accFallback).toUpperCase()) maxlength="7" spellcheck="false")
                                button.cz-color-reset(type="button" title="Revenir au survol automatique")
                                    span.material-symbols-outlined(style="font-size:14px") refresh

                    //- Textes du parcours de réservation
                    .cz-ds-card
                        .cz-ds-card__head
                            .cz-ds-card__head-icon
                                span.material-symbols-outlined(style="font-size:16px") text_fields
                            p.cz-ds-card__title Textes
                        .cz-ds-card__body
                            .field
                                label.bk-label Aide au-dessus du calendrier
                                input.input#czTextCalendarHelp(
                                    type="text"
                                    maxlength="160"
                                    placeholder="Choisissez une date sur le calendrier puis un créneau horaire."
                                    value=(cs.textCalendarHelp || '')
                                )
                            .field(style="margin-top:12px")
                                label.bk-label Titre de l'étape créneau
                                input.input#czTextSlotHeading(
                                    type="text"
                                    maxlength="160"
                                    placeholder="Choisissez votre créneau"
                                    value=(cs.textSlotHeading || '')
                                )
                            .field(style="margin-top:12px")
                                label.bk-label Fuseau horaire affiché
                                input.input#czTextTimezone(
                                    type="text"
                                    maxlength="160"
                                    placeholder="Heure de Bruxelles (GMT+1)."
                                    value=(cs.textTimezone || '')
                                )
                            p(style="font-size:12px;color:var(--muted,#6b7280);margin:10px 0 0") Laissez vide pour garder le texte par défaut.

                    //- Disponibilité des jours (vert/orange/rouge)
                    .cz-ds-card
                        .cz-ds-card__head
                            .cz-ds-card__head-icon
                                span.material-symbols-outlined(style="font-size:16px") event_available
                            p.cz-ds-card__title Disponibilité des jours
                        .cz-ds-card__body
                            .cz-color-row(data-color="dayAvailableColor")
                                .cz-color-row__label
                                    strong Jour disponible
                                    | Au moins un créneau libre
                                .cz-color-picker
                                    .cz-color-picker__swatch(style="background:" + (cs.dayAvailableColor || '#16a34a'))
                                    input(type="color" value=(cs.dayAvailableColor || '#16a34a') tabindex="-1" aria-hidden="true")
                                    input.cz-color-picker__hex(type="text" value=((cs.dayAvailableColor || '#16a34a').toUpperCase()) maxlength="7" spellcheck="false")
                                button.cz-color-reset(type="button" title="Réinitialiser")
                                    span.material-symbols-outlined(style="font-size:14px") refresh

                            .cz-color-row(data-color="dayBusyColor")
                                .cz-color-row__label
                                    strong Jour bien rempli
                                    | 50% des créneaux pris ou plus
                                .cz-color-picker
                                    .cz-color-picker__swatch(style="background:" + (cs.dayBusyColor || '#ea580c'))
                                    input(type="color" value=(cs.dayBusyColor || '#ea580c') tabindex="-1" aria-hidden="true")
                                    input.cz-color-picker__hex(type="text" value=((cs.dayBusyColor || '#ea580c').toUpperCase()) maxlength="7" spellcheck="false")
                                button.cz-color-reset(type="button" title="Réinitialiser")
                                    span.material-symbols-outlined(style="font-size:14px") refresh

                            .cz-color-row(data-color="dayFullColor")
                                .cz-color-row__label
                                    strong Jour complet
