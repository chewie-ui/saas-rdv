extends ../../layouts/admin

block links
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Poppins:wght@400;600&family=Roboto:wght@400;600&family=Montserrat:wght@400;600&family=Lato:wght@400;700&family=Nunito:wght@400;600&family=Raleway:wght@400;600&family=Open+Sans:wght@400;600&family=Playfair+Display:wght@400;600&display=swap")
    link(rel="stylesheet" href="/css/layouts/customize.css")

block content
    .customize-layout
        .customize-panel

            //- ── Section 1 : Mise en page ──────────────────────────────────
            .customize-section
                .customize-section__header
                    h3= t.customize.layout_section
                .customize-section__body

                    .layout-cards
                        label.layout-card(for="layout-classic" title=t.customize.layout_classic)
                            input#layout-classic(type="radio" name="layoutStyle" value="classic")
                            .layout-card__diagram
                                .lc-col.lc-info
                                .lc-col.lc-cal
                                .lc-col.lc-sched
                            span= t.customize.layout_classic
                        label.layout-card(for="layout-centered" title=t.customize.layout_centered)
                            input#layout-centered(type="radio" name="layoutStyle" value="centered")
                            .layout-card__diagram.lc-centered-diag
                                .lc-cal-wide
                                .lc-sched-thin
                            span= t.customize.layout_centered
                        label.layout-card(for="layout-title" title=t.customize.layout_title)
                            input#layout-title(type="radio" name="layoutStyle" value="title")
                            .layout-card__diagram.lc-title-diag
                                .lc-title-bar
                                .lc-row
                                    .lc-cal-sm
                                    .lc-sched-sm
                            span= t.customize.layout_title

                    .toggle-row
                        span= t.customize.show_info
                        label.toggle-switch(for="toggleShowInfo")
                            input#toggleShowInfo(type="checkbox")
                            .toggle-track
                                .toggle-thumb

                    .toggle-row
                        span= t.customize.show_socials
                        label.toggle-switch(for="toggleShowSocials")
                            input#toggleShowSocials(type="checkbox")
                            .toggle-track
                                .toggle-thumb

                    .field-row
                        span= t.customize.font
                        select#fontSelect.input.font-select
                            option(value="Inter") Inter
                            option(value="Poppins") Poppins
                            option(value="Roboto") Roboto
                            option(value="Montserrat") Montserrat
                            option(value="Lato") Lato
                            option(value="Nunito") Nunito
                            option(value="Raleway") Raleway
                            option(value="Open Sans") Open Sans
                            option(value="Playfair Display") Playfair Display

            //- ── Section 2 : Arrière-plan ──────────────────────────────────
            .customize-section
                .customize-section__header
                    h3= t.customize.bg_section
                .customize-section__body.bg-body
                    .bg-tabs
                        button.bg-tab.active(data-tab="color" type="button")= t.customize.bg_color
                        button.bg-tab(data-tab="image" type="button")= t.customize.bg_image
                    .bg-panel(data-tab="color")
                        .color-row(data-key="pageBg")
                            .color-row__label
                                span= t.customize.page_bg
                            .color-row__inputs
                                input.color-swatch(type="color")
                                input.color-hex.input(type="text" maxlength=7 placeholder="#f3f4f6")
                    .bg-panel.hidden(data-tab="image")
                        .bg-upload-area#bgUploadArea
                            input#bgImageInput(type="file" accept="image/*" style="display:none")
                            .bg-upload-preview#bgUploadPreview
                                span#bgUploadHint= t.customize.upload_hint
                        button.sm-btn.sm-btn--ghost#removeBgImage(type="button" style="display:none")= t.customize.remove_image

            //- ── Section 3 : Couleurs ──────────────────────────────────────
            .customize-section
                .customize-section__header
                    h3= t.customize.colors_section
                .customize-section__body.color-list
                    .color-row(data-key="calBg")
                        .color-row__label
                            span= t.customize.cal_bg
                        .color-row__inputs
                            input.color-swatch(type="color")
                            input.color-hex.input(type="text" maxlength=7 placeholder="#ffffff")
                    .color-row(data-key="accentColor")
                        .color-row__label
                            span= t.customize.accent_color
                        .color-row__inputs
                            input.color-swatch(type="color")
                            input.color-hex.input(type="text" maxlength=7 placeholder="#22c55e")
                    .color-row(data-key="accentText")
                        .color-row__label
                            span= t.customize.accent_text
                        .color-row__inputs
                            input.color-swatch(type="color")
                            input.color-hex.input(type="text" maxlength=7 placeholder="#ffffff")
                    .color-row(data-key="dayBg")
                        .color-row__label
                            span= t.customize.day_bg
                        .color-row__inputs
                            input.color-swatch(type="color")
                            input.color-hex.input(type="text" maxlength=7 placeholder="#ffffff")
                    .color-row(data-key="dayText")
                        .color-row__label
                            span= t.customize.day_text
                        .color-row__inputs
                            input.color-swatch(type="color")
                            input.color-hex.input(type="text" maxlength=7 placeholder="#111111")
                    .color-row(data-key="btnBg")
                        .color-row__label
                            span= t.customize.btn_bg
                        .color-row__inputs
                            input.color-swatch(type="color")
                            input.color-hex.input(type="text" maxlength=7 placeholder="#111111")
                    .color-row(data-key="btnText")
                        .color-row__label
                            span= t.customize.btn_text
                        .color-row__inputs
                            input.color-swatch(type="color")
                            input.color-hex.input(type="text" maxlength=7 placeholder="#ffffff")

            //- ── Section 4 : Sections de la page ──────────────────────────
            .customize-section
                .customize-section__header
                    h3 Sections de la page
                .customize-section__body

                    .toggle-row
                        .toggle-row__label
                            span À propos
                            small.toggle-row__hint Carte, horaires, adresse
                        label.toggle-switch(for="toggleSectionAbout")
                            input#toggleSectionAbout(type="checkbox")
                            .toggle-track
                                .toggle-thumb

                    .toggle-row
                        .toggle-row__label
                            span Services
                            small.toggle-row__hint Liste de vos prestations
                        label.toggle-switch(for="toggleSectionServices")
                            input#toggleSectionServices(type="checkbox")
                            .toggle-track
                                .toggle-thumb

                    .toggle-row
                        .toggle-row__label
                            span Équipe
                            small.toggle-row__hint Vos employés
                        label.toggle-switch(for="toggleSectionTeam")
                            input#toggleSectionTeam(type="checkbox")
                            .toggle-track
                                .toggle-thumb

            //- ── Actions ───────────────────────────────────────────────────
            .customize-actions
                button.sm-btn.sm-btn--ghost#resetCalendarSettings(type="button")
                    span= t.customize.reset
                button.sm-btn.sm-btn--primary#saveCalendarSettings(type="button")
                    span= t.customize.save

        //- ── Preview ───────────────────────────────────────────────────────
        .customize-preview
            .customize-section
                .customize-section__header
                    h3= t.customize.preview
                .customize-section__body.preview-body
                    .preview-frame#previewFrame
                        .pv-page#pvPage
                            .pv-title-bar#pvTitleBar
                                span.pv-biz-name Votre activité
                            .pv-content#pvContent
                                .pv-info#pvInfo
                                    .pv-info__top
                                        .pv-avatar
