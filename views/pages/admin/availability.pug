extends ../../layouts/admin

include ../../templates/calendar

block links
    link(rel="stylesheet", href="/css/components/admin/availability.admin.css")
    link(rel="stylesheet", href="/css/components/index/calendar.index.css")

block content
    - const weekday = [t.days.sunday, t.days.monday, t.days.tuesday, t.days.wednesday, t.days.thursday, t.days.friday, t.days.saturday]
    - const sortedSchedule = [...currentCompany.schedule].sort((a, b) => { const order = i => i === 0 ? 7 : i; return order(a.weekdayIndex) - order(b.weekdayIndex); })
    - const activeDays = sortedSchedule.filter(d => !d.dayOff && d.workingHours && d.workingHours.length > 0)

    .avail-page

        .avail-layout

            //- ── LEFT: main column ───────────────────────────────────
            .avail-main

                //- Weekly schedule card
                .avail-card
                    .avail-card__hd
                        span.avail-card__title= t.avail.t1
                        span.avail-tz= t.avail.timezone_note
                    .avail-rows.body-weekly-hour
                        each day in sortedSchedule
                            .avail-day-row.row-weekday(class=day.dayOff ? 'day-off' : '')
                                //- Toggle
                                label.avail-switch
                                    input.input-weekday(
                                        type="checkbox"
                                        data-weekday-index=day.weekdayIndex
                                        data-company=currentCompany._id
                                        checked=!day.dayOff
                                    )
                                    span.avail-switch__track
                                        span.avail-switch__thumb

                                //- Day name
                                span.avail-day-name= weekday[day.weekdayIndex]

                                //- Time slots
                                .avail-day-times.weekly-hour__time
                                    if day.dayOff
                                        span.avail-dash —
                                        span.avail-dash —
                                        span.avail-dash —
                                    else if day.workingHours && day.workingHours.length > 0
                                        each slot, index in day.workingHours
                                            .time-slot.flex-c(data-weekday-index=day.weekdayIndex)
                                                .start-hour.slot-hour
                                                    .avail-time-box.hour-container.start-hour-(data-hours="start")= slot.start || "09:00"
                                                    .panel-availability
                                                        each hour in hours
                                                            .hour= hour
                                                span.avail-sep —
                                                .end-hour.slot-hour
                                                    .avail-time-box.hour-container.end-hour-(data-hours="end")= slot.end || "18:00"
                                                    .panel-availability
                                                        each hour in hours
                                                            .hour= hour
                                                if index > 0
                                                    button.avail-del-slot.delete-time-slot(type="button" data-id=slot._id title="Remove")
                                                        svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                                            path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
                                    else
                                        .time-slot.flex-c(data-weekday-index=day.weekdayIndex)
                                            .start-hour.slot-hour
                                                .avail-time-box.hour-container.start-hour-(data-hours="start") 09:00
                                                .panel-availability
                                                    each hour in hours
                                                        .hour= hour
                                            span.avail-sep —
                                            .end-hour.slot-hour
                                                .avail-time-box.hour-container.end-hour-(data-hours="end") 18:00
                                                .panel-availability
                                                    each hour in hours
                                                        .hour= hour

                                //- Actions
                                .avail-day-actions
                                    if !day.dayOff
                                        if availFeatures && availFeatures.ranges
                                            button.avail-range-btn.option-add-plage(type="button")
                                                svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                                    path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                                                | Range
                                        else
                                            a.avail-range-btn.avail-range-btn--locked(href="/subscription" title="Fonctionnalité Pro")
                                                svg(viewBox="0 -960 960 960" height="13" width="13" fill="currentColor")
                                                    path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80Z")
                                                | Range

                //- Days off card
                .avail-card
                    .avail-card__hd
                        span.avail-card__title= t.avail.t3
                        button.avail-add-btn#addDaysOffBtn(type="button")
                            svg(viewBox="0 -960 960 960" height="15" width="15" fill="currentColor")
                                path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                            | #{t.avail.btn1}

                    #holidaysBody.avail-days-grid
                        if daysOff && daysOff.dates
                            each day in daysOff.dates
                                - var d = new Date(day.date)
                                - var dMonths = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
                                - var dDays = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat']
                                - var dateLabel = dDays[d.getDay()] + ', ' + dMonths[d.getMonth()] + ' ' + d.getDate()
                                .avail-doff-card.days-off__row(data-date=day)
                                    .avail-doff-top.day-card__top
                                        .avail-doff-date
                                            span.avail-doff-date-label= dateLabel
                                        button.avail-doff-del.days-off__button.delete-btn.flex-c(title=t.avail.delete_day)
                                            svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                                                path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
                                    .avail-doff-body.days-off__schedule.flex-c
                                        if day.workingHours && day.workingHours.length > 0 && day.workingHours[0].start
                                            .time-slot.flex-c
                                                .start-hour.slot-hour
                                                    .avail-time-box.hour-container.start-hour-(data-hours="start")= day.workingHours[0].start
                                                    .panel-availability
                                                        each hour in hours
                                                            .hour= hour
                                                span.avail-sep —
                                                .end-hour.slot-hour
                                                    .avail-time-box.hour-container.end-hour-(data-hours="end")= day.workingHours[0].end
                                                    .panel-availability
                                                        each hour in hours
                                                            .hour= hour
                                                button.avail-del-slot.delete-time-slot(type="button" title=t.avail.remove_schedule)
                                                    svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                                        path(d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z")
                                        else
                                            .avail-doff-type All day
                                    if day.label
                                        p.avail-doff-note= day.label
                                    .avail-doff-emps
                                        if day.employees && day.employees.length > 0
                                            each emp in day.employees
                                                span.emp-chip= emp.firstName + ' ' + emp.lastName
                                        else
                                            span.emp-chip.emp-chip--all Tous
                                    .day-card__footer
                                        button.avail-doff-addtime.days-off__button.schedule-btn.flex-c(title=t.avail.add_schedule)
                                            svg(viewBox="0 -960 960 960" height="13" width="13" fill="currentColor")
                                                path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                                            span= t.avail.add_schedule

                    if !availFeatures || !availFeatures.ranges
                        .avail-lock-banner.avail-lock-banner--soft
                            svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                path(d="M480-280q17 0 28.5-11.5T520-320q0-17-11.5-28.5T480-360q-17 0-28.5 11.5T440-320q0 17 11.5 28.5T480-280Zm-40-160h80v-240h-80v240ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z")
                            span 1 congé inclus — passez au Pro pour en définir plusieurs
                            a.btn-upgrade-pro(href="/subscription") Passer au Pro

                //- Regroupement des rendez-vous ("smart grouping")
                .avail-card.sg-card
                    .avail-card__hd
                        .sg-card__title-row
                            svg.sg-card__icon(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                path(d="M160-200v-80h80v80h-80Zm160 0v-280h80v280h-80Zm160 0v-440h80v440h-80Zm160 0v-160h80v160h-80ZM160-560v-80h640v80H160Zm0-200v-80h640v80H160Z")
                            span.avail-card__title Regroupement des rendez-vous
                        label.sa-toggle
                            input#sgEnabled(type="checkbox" checked=smartGrouping.enabled)
                            .sa-toggle__track
                    p.avail-card__sub
                        | Idéal quand vous démarrez avec peu de #{clientTermPlural || 'clients'} : si quelqu'un réserve à 9h et un autre à 18h, toute votre journée se retrouve "bloquée" pour rien. Activez ceci pour mettre en avant, sur la page de réservation, les créneaux proches de vos RDV déjà confirmés — les autres restent réservables mais sont repliés sous "Voir plus d'horaires".
                    #sgWindowRow(style=(smartGrouping.enabled ? '' : 'display:none'))
                        .sg-window-label Regrouper les créneaux dans une fenêtre de
                        .sg-window-pills#sgWindowPills
                            each h in [1, 2, 3, 4, 6]
                                button.sg-window-pill(type="button" data-hours=h class=(Number(smartGrouping.windowHours) === h ? 'active' : ''))= h + 'h'
                        .sg-window-label Uniquement ces jours #[span.xs-comment  (aucun coché = tous les jours)]
                        .sg-window-pills#sgWeekdayPills
                            - var sgDayDefs = [{ label: 'Lun', dow: 1 }, { label: 'Mar', dow: 2 }, { label: 'Mer', dow: 3 }, { label: 'Jeu', dow: 4 }, { label: 'Ven', dow: 5 }, { label: 'Sam', dow: 6 }, { label: 'Dim', dow: 0 }]
                            each d in sgDayDefs
                                button.sg-window-pill(type="button" data-day=d.dow class=(smartGrouping.weekdays && smartGrouping.weekdays.includes(d.dow) ? 'active' : ''))= d.label
                    .sg-example(class=(smartGrouping.enabled ? '' : 'sg-example--off'))
                        .sg-example__row
                            span.sg-example__dot.sg-example__dot--booked
                            span 9h00 — RDV confirmé
                        .sg-example__row
                            span.sg-example__dot.sg-example__dot--reco
                            span Créneaux mis en avant (9h–12h si fenêtre 3h)
                        .sg-example__row
                            span.sg-example__dot.sg-example__dot--extra
                            span Reste disponible, juste replié

                //- Délai minimum de réservation
                -
                    var ltMin   = (minBookingLeadTime && minBookingLeadTime.minutes) || 0
                    var ltUnit  = 'minutes'
                    var ltValue = ltMin
                    if (ltMin > 0 && ltMin % 1440 === 0) { ltUnit = 'days'; ltValue = ltMin / 1440 }
                    else if (ltMin > 0 && ltMin % 60 === 0) { ltUnit = 'hours'; ltValue = ltMin / 60 }
                    var ltPresets = [0, 30, 60, 120, 240, 1440, 2880, 10080]
                    function ltPresetLabel(p) {
                        if (p === 0) return 'Aucun'
                        if (p < 60) return p + ' min'
                        if (p < 1440) return (p / 60) + 'h'
                        return (p / 1440) + 'j'
                    }
                .avail-card.lt-card
                    .avail-card__hd
                        .sg-card__title-row
                            svg.sg-card__icon(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                path(d="M480-480v-240h80v210l180 107-40 67-220-144ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Z")
                            span.avail-card__title Délai minimum de réservation
                        label.sa-toggle
                            input#ltEnabled(type="checkbox" checked=(minBookingLeadTime && minBookingLeadTime.enabled))
                            .sa-toggle__track
                    p.avail-card__sub
                        | Empêche un #{clientTerm || 'client'} de réserver un créneau trop proche dans le temps (ex : réserver à 11h59 un RDV à 12h) — pour vous laisser le temps de vous préparer. Désactivé par défaut.
                    #ltRow(style=((minBookingLeadTime && minBookingLeadTime.enabled) ? '' : 'display:none'))
                        .sg-window-label Aucune réservation moins de
                        .sg-window-pills#ltPresetPills
                            each p in ltPresets
                                button.sg-window-pill(type="button" data-minutes=p class=(ltMin === p ? 'active' : ''))= ltPresetLabel(p)
                        .lt-custom
                            span.lt-custom__label ou personnalisé :
                            input.lt-custom__input#ltValue(type="number" min="0" step="1" value=ltValue)
                            select.lt-custom__unit#ltUnit
                                option(value="minutes" selected=(ltUnit === 'minutes')) minutes
                                option(value="hours" selected=(ltUnit === 'hours')) heures
                                option(value="days" selected=(ltUnit === 'days')) jours
                            span.lt-custom__label avant le créneau

            //- ── RIGHT: sidebar ──────────────────────────────────────
            .avail-side

                //- Slot duration
                .avail-card(class=(!availFeatures || !availFeatures.slotDuration) ? 'avail-card--locked' : '')
                    .avail-card__hd
                        span.avail-card__title= t.avail.t2
                    p.avail-card__sub= t.avail.slot_desc
                    .slot-time-section(class=hasServices ? 'slot-managed' : '')
                        .avail-slot-pills#slotPills
                            each time in timeSlot
                                button.slot-pill(
                                    type="button"
                                    data-time=time
                                    class=(currentSlotTime == time || String(currentSlotTime) === String(time)) ? 'active' : ''
                                )= time + 'm'
                        //- Hidden legacy panel (JS still targets it for fetch)
                        .time-slot__container(style="display:none")
                            .slot-input__container#timeslotPanel
                                .input #{currentSlotTime || "30"}min
                                .panel
                                    each time in timeSlot
                                        .time(data-time=time) #{time}min
                        if hasServices && availFeatures && availFeatures.slotDuration
                            .slot-managed-info
                                svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                    path(d="M440-280h80v-240h-80v240Zm40-320q17 0 28.5-11.5T520-640q0-17-11.5-28.5T480-680q-17 0-28.5 11.5T440-640q0 17 11.5 28.5T480-600Z")
                                span= t.avail.slot_managed_hint
                                button.slot-reenable-btn(type="button")= t.avail.slot_reenable
                    if !availFeatures || !availFeatures.slotDuration
                        .avail-lock-banner
                            svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80Z")
                            span Fonctionnalité Pro
                            a.btn-upgrade-pro(href="/subscription") Passer au Pro

                //- Buffer between bookings
                if !adminFeatures || adminFeatures.buffer_time !== false
                    .avail-card
                        .avail-card__hd
                            span.avail-card__title= t.avail.buffer_title || 'Temps tampon entre les réservations'
                        p.avail-card__sub Bloque automatiquement ce temps avant et/ou après chaque RDV pour vous laisser le temps de vous organiser. Réglez chaque sens indépendamment.
                        .avail-buffer-group
                            .avail-buffer
                                .avail-buffer__label Avant le rendez-vous
                                input.avail-buffer__range#bufferBeforeRange(type="range" min="0" max="120" step="5" value=(bufferBefore || 0))
                                .avail-buffer__row
                                    span 0
                                    span.avail-buffer__val#bufferBeforeVal #{bufferBefore || 0} min
                                    span 120
                            .avail-buffer
                                .avail-buffer__label Après le rendez-vous
                                input.avail-buffer__range#bufferAfterRange(type="range" min="0" max="120" step="5" value=(bufferAfter || 0))
                                .avail-buffer__row
                                    span 0
                                    span.avail-buffer__val#bufferAfterVal #{bufferAfter || 0} min
                                    span 120

                //- Mode de génération des créneaux
                .avail-card
                    .avail-card__hd
                        span.avail-card__title Mode des créneaux proposés
                    p.avail-card__sub Choisissez comment les horaires disponibles sont proposés aux #{clientTermPlural || 'clients'}.
                    .slot-mode-options#slotModeOptions
                        button.slot-mode-option(type="button" data-mode="fixed" class=(slotMode !== 'interval' ? 'active' : ''))
                            span.slot-mode-option__title Selon la durée du service
                            span.slot-mode-option__desc Ex : 9h00, 9h30, 10h00… (selon la durée de chaque prestation)
                        button.slot-mode-option(type="button" data-mode="interval" class=(slotMode === 'interval' ? 'active' : ''))
                            span.slot-mode-option__title Toutes les X minutes
                            span.slot-mode-option__desc Ex : 9h00, 9h10, 9h20… quelle que soit la durée de la prestation
                    .slot-interval-row#slotIntervalRow(style=(slotMode === 'interval' ? '' : 'display:none'))
                        label.slot-interval-label(for="slotIntervalInput") Proposer un créneau toutes les
                        input.input.slot-interval-input#slotIntervalInput(type="number" min="5" max="120" step="5" value=(slotInterval || 30))
                        span minutes

    //- ── Hidden templates / calendar ─────────────────────────────
    #calendarWrapper
    template#plageTemplate
        .time-slot.flex-c
            .start-hour.slot-hour
                .avail-time-box.hour-container.start-hour-(data-hours="start") 09:00
                .panel-availability
                    each hour in hours
                        .hour= hour
            span.avail-sep —
            .end-hour.slot-hour
                .avail-time-box.hour-container.end-hour-(data-hours="end") 18:00
                .panel-availability
                    each hour in hours
                        .hour= hour
            button.avail-del-slot.delete-time-slot(type="button")
                svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                    path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")

    +calendar()

    template#daysOffTemplate
        .days-off__rows
    template#dayOffRow
        .avail-doff-card.days-off__row
            .avail-doff-top.day-card__top
                .avail-doff-date
                    span.avail-doff-date-label
                button.avail-doff-del.days-off__button.delete-btn.flex-c
                    svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                        path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
            .avail-doff-body.days-off__schedule.flex-c
                .avail-doff-type All day
            .avail-doff-emps
            .day-card__footer
                button.avail-doff-addtime.days-off__button.schedule-btn.flex-c
                    svg(viewBox="0 -960 960 960" height="13" width="13" fill="currentColor")
                        path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                    span= t.avail.add_schedule

    //- ── Employee picker modal ───────────────────────────────────
    #empPickerModal.emp-picker(style="display:none")
        .emp-picker__backdrop
        .emp-picker__card
            .emp-picker__hd
                h3.emp-picker__title#empPickerTitle Pour qui est ce congé ?
            .emp-picker__body
                label.emp-picker-opt
                    input#empModeAll(type="radio" name="empMode" value="all" checked)
                    .emp-picker-opt__dot
                    span Tous les employés
                if employees && employees.length > 0
                    label.emp-picker-opt
                        input#empModeSpecific(type="radio" name="empMode" value="specific")
                        .emp-picker-opt__dot
                        span Sélectionner des employés
                    .emp-picker-list#empPickerList
                        each emp in employees
                            label.emp-picker-emp
                                input(type="checkbox" data-id=String(emp._id))
                                .emp-picker-emp__check
                                    svg(viewBox="0 -960 960 960" height="12" width="12" fill="currentColor")
                                        path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                span= emp.firstName + ' ' + emp.lastName
            .emp-picker__ft
                button.emp-picker__cancel#empPickerCancel(type="button") Annuler
                button.emp-picker__confirm#empPickerConfirm(type="button") Confirmer

block scripts
    script.
        window.__employees = !{JSON.stringify(employees || [])};
        window.__availFeatures = !{JSON.stringify(availFeatures || {})};
        window.__daysOffCount = !{(daysOff && daysOff.dates) ? daysOff.dates.length : 0};
    script(src="js/components/admin/availability.admin.js" type="module")
    script(src="js/templates/calendar.js" type="module")
