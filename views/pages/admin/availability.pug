extends ../../layouts/admin

include ../../templates/calendar

block links
    link(rel="stylesheet", href="/css/components/admin/availability.admin.css")
    link(rel="stylesheet", href="/css/components/index/calendar.index.css")

block content
    - const weekday = [t.days.sunday, t.days.monday, t.days.tuesday, t.days.wednesday, t.days.thursday, t.days.friday, t.days.saturday]
    - const weekdayAbbr = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat']
    - const sortedSchedule = [...currentCompany.schedule].sort((a, b) => { const order = i => i === 0 ? 7 : i; return order(a.weekdayIndex) - order(b.weekdayIndex); })
    - const activeDays = sortedSchedule.filter(d => !d.dayOff && d.workingHours && d.workingHours.length > 0)
    - const tzLabel = currentCompany.timezone ? 'GMT+1' : 'GMT+1'

    .avail-page

        .avail-layout

            //- ── LEFT: main column ───────────────────────────────────
            .avail-main

                //- Weekly schedule card
                .avail-card
                    .avail-card__hd
                        span.avail-card__title= t.avail.t1
                        span.avail-tz Times shown in Brussels (#{tzLabel})
                    .avail-rows.body-weekly-hour
                        each day in sortedSchedule
                            .avail-day-row.row-weekday(class=day.dayOff ? 'day-off' : '')
                                //- Toggle
                                label.avail-switch
                                    input.input-weekday(
                                        type="checkbox"
                                        data-weekday-index=day.weekdayIndex
                                        data-company=currentCompany._id
                                        checked=!day.dayOff
                                    )
                                    span.avail-switch__track
                                        span.avail-switch__thumb

                                //- Day name
                                span.avail-day-name= weekday[day.weekdayIndex]

                                //- Time slots
                                .avail-day-times.weekly-hour__time
                                    if day.dayOff
                                        span.avail-dash —
                                        span.avail-dash —
                                        span.avail-dash —
                                    else if day.workingHours && day.workingHours.length > 0
                                        each slot, index in day.workingHours
                                            .time-slot.flex-c(data-weekday-index=day.weekdayIndex)
                                                .start-hour.slot-hour
                                                    .avail-time-box.hour-container.start-hour-(data-hours="start")= slot.start || "09:00"
                                                    .panel-availability
                                                        each hour in hours
                                                            .hour= hour
                                                span.avail-sep —
                                                .end-hour.slot-hour
                                                    .avail-time-box.hour-container.end-hour-(data-hours="end")= slot.end || "18:00"
                                                    .panel-availability
                                                        each hour in hours
                                                            .hour= hour
                                                if index > 0
                                                    button.avail-del-slot.delete-time-slot(type="button" data-id=slot._id title="Remove")
                                                        svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                                            path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
                                    else
                                        .time-slot.flex-c(data-weekday-index=day.weekdayIndex)
                                            .start-hour.slot-hour
                                                .avail-time-box.hour-container.start-hour-(data-hours="start") 09:00
                                                .panel-availability
                                                    each hour in hours
                                                        .hour= hour
                                            span.avail-sep —
                                            .end-hour.slot-hour
                                                .avail-time-box.hour-container.end-hour-(data-hours="end") 18:00
                                                .panel-availability
                                                    each hour in hours
                                                        .hour= hour

                                //- Actions
                                .avail-day-actions
                                    if !day.dayOff
                                        if availFeatures && availFeatures.ranges
                                            button.avail-range-btn.option-add-plage(type="button")
                                                svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                                    path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                                                | Range
                                        else
                                            a.avail-range-btn.avail-range-btn--locked(href="/subscription" title="Fonctionnalité Pro")
                                                svg(viewBox="0 -960 960 960" height="13" width="13" fill="currentColor")
                                                    path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80Z")
                                                | Range

                //- Days off card
                .avail-card(class=(!availFeatures || !availFeatures.ranges) ? 'avail-card--locked' : '')
                    .avail-card__hd
                        span.avail-card__title= t.avail.t3
                        if availFeatures && availFeatures.ranges
                            button.avail-add-btn#addDaysOffBtn(type="button")
                                svg(viewBox="0 -960 960 960" height="15" width="15" fill="currentColor")
                                    path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                                | #{t.avail.btn1}

                    #holidaysBody.avail-days-grid
                        if daysOff && daysOff.dates
                            each day in daysOff.dates
                                - var d = new Date(day.date)
                                - var dMonths = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
                                - var dDays = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat']
                                - var dateLabel = dDays[d.getDay()] + ', ' + dMonths[d.getMonth()] + ' ' + d.getDate()
                                .avail-doff-card.days-off__row(data-date=day)
                                    .avail-doff-top.day-card__top
                                        .avail-doff-date
                                            span.avail-doff-date-label= dateLabel
                                        button.avail-doff-del.days-off__button.delete-btn.flex-c(title=t.avail.delete_day)
                                            svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                                                path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
                                    .avail-doff-body.days-off__schedule.flex-c
                                        if day.workingHours && day.workingHours.length > 0 && day.workingHours[0].start
                                            .time-slot.flex-c
                                                .start-hour.slot-hour
                                                    .avail-time-box.hour-container.start-hour-(data-hours="start")= day.workingHours[0].start
                                                    .panel-availability
                                                        each hour in hours
                                                            .hour= hour
                                                span.avail-sep —
                                                .end-hour.slot-hour
                                                    .avail-time-box.hour-container.end-hour-(data-hours="end")= day.workingHours[0].end
                                                    .panel-availability
                                                        each hour in hours
                                                            .hour= hour
                                                button.avail-del-slot.delete-time-slot(type="button" title=t.avail.remove_schedule)
                                                    svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                                        path(d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z")
                                        else
                                            .avail-doff-type All day
                                    if day.label
                                        p.avail-doff-note= day.label
                                    .avail-doff-emps
                                        if day.employees && day.employees.length > 0
                                            each emp in day.employees
                                                span.emp-chip= emp.firstName + ' ' + emp.lastName
                                        else
                                            span.emp-chip.emp-chip--all Tous
                                    .day-card__footer
                                        button.avail-doff-addtime.days-off__button.schedule-btn.flex-c(title=t.avail.add_schedule)
                                            svg(viewBox="0 -960 960 960" height="13" width="13" fill="currentColor")
                                                path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                                            span= t.avail.add_schedule

                    if !availFeatures || !availFeatures.ranges
                        .avail-lock-banner
                            svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80Z")
                            span Fonctionnalité Pro
                            a.btn-upgrade-pro(href="/subscription") Passer au Pro

            //- ── RIGHT: sidebar ──────────────────────────────────────
            .avail-side

                //- Slot duration
                .avail-card(class=(!availFeatures || !availFeatures.slotDuration) ? 'avail-card--locked' : '')
                    .avail-card__hd
                        span.avail-card__title= t.avail.t2
                    p.avail-card__sub= t.avail.slot_desc || 'Default block size for online bookings.'
                    .slot-time-section(class=hasServices ? 'slot-managed' : '')
                        .avail-slot-pills#slotPills
                            each time in timeSlot
                                button.slot-pill(
                                    type="button"
                                    data-time=time
                                    class=(currentSlotTime == time || String(currentSlotTime) === String(time)) ? 'active' : ''
                                )= time + 'm'
                        //- Hidden legacy panel (JS still targets it for fetch)
                        .time-slot__container(style="display:none")
                            .slot-input__container#timeslotPanel
                                .input #{currentSlotTime || "30"}min
                                .panel
                                    each time in timeSlot
                                        .time(data-time=time) #{time}min
                        if hasServices && availFeatures && availFeatures.slotDuration
                            .slot-managed-info
                                svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                    path(d="M440-280h80v-240h-80v240Zm40-320q17 0 28.5-11.5T520-640q0-17-11.5-28.5T480-680q-17 0-28.5 11.5T440-640q0 17 11.5 28.5T480-600Z")
                                span= t.avail.slot_managed_hint
                                button.slot-reenable-btn(type="button")= t.avail.slot_reenable
                    if !availFeatures || !availFeatures.slotDuration
                        .avail-lock-banner
                            svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80Z")
                            span Fonctionnalité Pro
                            a.btn-upgrade-pro(href="/subscription") Passer au Pro

                //- Buffer between bookings
                .avail-card(class=(!availFeatures || !availFeatures.buffer) ? 'avail-card--locked' : '')
                    .avail-card__hd
                        span.avail-card__title= t.avail.buffer_title || 'Buffer between bookings'
                    .avail-buffer
                        input.avail-buffer__range#bufferRange(
                            type="range"
                            min="0"
                            max="60"
                            step="5"
                            value=currentCompany.bufferTime || 0
                        )
                        .avail-buffer__row
                            span 0
                            span#bufferVal.avail-buffer__val= (currentCompany.bufferTime || 0) + ' min'
                            span 60
                    if !availFeatures || !availFeatures.buffer
                        .avail-lock-banner
                            svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80Z")
                            span Fonctionnalité Pro
                            a.btn-upgrade-pro(href="/subscription") Passer au Pro

                //- Preview this week
                .avail-card
                    .avail-card__hd
                        span.avail-card__title= t.avail.preview_title || 'Preview · this week'
                    .avail-preview
                        if activeDays && activeDays.length
                            each day in activeDays
                                - var startStr = (day.workingHours[0] && day.workingHours[0].start) || '09:00'
                                - var endStr   = (day.workingHours[0] && day.workingHours[0].end)   || '18:00'
                                - var startM = parseInt(startStr.split(':')[0])*60 + parseInt(startStr.split(':')[1])
                                - var endM   = parseInt(endStr.split(':')[0])*60   + parseInt(endStr.split(':')[1])
                                - var pct    = Math.min(100, Math.round((endM - startM) / 720 * 100))
                                .avail-preview-row
                                    span.avail-preview-day= weekdayAbbr[day.weekdayIndex]
                                    .avail-preview-bar
                                        .avail-preview-fill(style=`width:${pct}%`)
                                    span.avail-preview-pct #{pct}%
                        else
                            p.avail-preview-empty No active days

    //- ── Hidden templates / calendar ─────────────────────────────
    #calendarWrapper
    template#plageTemplate
        .time-slot.flex-c
            .start-hour.slot-hour
                .avail-time-box.hour-container.start-hour-(data-hours="start") 09:00
                .panel-availability
                    each hour in hours
                        .hour= hour
            span.avail-sep —
            .end-hour.slot-hour
                .avail-time-box.hour-container.end-hour-(data-hours="end") 18:00
                .panel-availability
                    each hour in hours
                        .hour= hour
            button.avail-del-slot.delete-time-slot(type="button")
                svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                    path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")

    +calendar()

    template#daysOffTemplate
        .days-off__rows
    template#dayOffRow
        .avail-doff-card.days-off__row
            .avail-doff-top.day-card__top
                .avail-doff-date
                    span.avail-doff-date-label
                button.avail-doff-del.days-off__button.delete-btn.flex-c
                    svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                        path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
            .avail-doff-body.days-off__schedule.flex-c
                .avail-doff-type All day
            .avail-doff-emps
            .day-card__footer
                button.avail-doff-addtime.days-off__button.schedule-btn.flex-c
                    svg(viewBox="0 -960 960 960" height="13" width="13" fill="currentColor")
                        path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                    span= t.avail.add_schedule

    //- ── Employee picker modal ───────────────────────────────────
    #empPickerModal.emp-picker(style="display:none")
        .emp-picker__backdrop
        .emp-picker__card
            .emp-picker__hd
                h3.emp-picker__title#empPickerTitle Pour qui est ce congé ?
            .emp-picker__body
                label.emp-picker-opt
                    input#empModeAll(type="radio" name="empMode" value="all" checked)
                    .emp-picker-opt__dot
                    span Tous les employés
                if employees && employees.length > 0
                    label.emp-picker-opt
                        input#empModeSpecific(type="radio" name="empMode" value="specific")
                        .emp-picker-opt__dot
                        span Sélectionner des employés
                    .emp-picker-list#empPickerList
                        each emp in employees
                            label.emp-picker-emp
                                input(type="checkbox" data-id=String(emp._id))
                                .emp-picker-emp__check
                                    svg(viewBox="0 -960 960 960" height="12" width="12" fill="currentColor")
                                        path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                                span= emp.firstName + ' ' + emp.lastName
            .emp-picker__ft
                button.emp-picker__cancel#empPickerCancel(type="button") Annuler
                button.emp-picker__confirm#empPickerConfirm(type="button") Confirmer

block scripts
    script.
        window.__employees = !{JSON.stringify(employees || [])};
    script(src="js/components/admin/availability.admin.js" type="module")
    script(src="js/templates/calendar.js" type="module")
