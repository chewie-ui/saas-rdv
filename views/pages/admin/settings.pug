        style.
            /* ── Promouvoir ── */
            .promo-card--disabled { position:relative; opacity:.55; filter:grayscale(.6); pointer-events:none; user-select:none; }
            .promo-soon-badge { display:inline-block; margin-left:10px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#9a6b00; background:#fff3cd; border:1px solid #ffe69c; border-radius:999px; padding:3px 9px; vertical-align:middle; }
            .promo-link-preview { display:flex; flex-direction:column; gap:6px; margin-bottom:18px; }
            .promo-link-label { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--text-muted,#9ca3af); }
            .promo-link-row { display:flex; align-items:center; gap:8px; background:var(--color-surface-2,#f8fafc); border:1px solid var(--border-light,#e5e7eb); border-radius:10px; padding:10px 14px; }
            .promo-link-val { font-size:12.5px; color:var(--text-secondary,#374151); flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-family:monospace; }
            .promo-link-copy { background:none; border:none; cursor:pointer; color:var(--text-muted,#9ca3af); padding:3px; border-radius:6px; display:flex; transition:color .15s; }
            .promo-link-copy:hover { color:var(--main-color,#16a34a); }
            .promo-networks { display:flex; flex-direction:column; gap:10px; }
            .promo-btn { display:flex; align-items:center; gap:14px; padding:14px 16px; border-radius:14px; text-decoration:none; color:inherit; background:var(--bg-secondary,#f8f9fa); border:1px solid var(--border-light,#e5e7eb); cursor:pointer; transition:border-color .15s, background .15s; width:100%; }
            .promo-btn:hover { background:var(--color-white,#fff); border-color:var(--text-muted,#9ca3af); }
            .promo-btn__icon { width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
            .promo-btn--facebook .promo-btn__icon { background:#1877f2; }
            .promo-btn--x .promo-btn__icon--x { background:#000; }
            .promo-btn--instagram .promo-btn__icon--insta { background: linear-gradient(135deg,#f09433 0%,#e6683c 25%,#dc2743 50%,#cc2366 75%,#bc1888 100%); }
            .promo-btn__text { display:flex; flex-direction:column; gap:1px; text-align:left; }
            .promo-btn__text strong { font-size:14px; font-weight:700; color:var(--text-primary,#111); }
            .promo-btn__text span { font-size:12px; color:var(--text-muted,#6b7280); }

            /* ── Popup Instagram ── */
            .insta-popup { position:fixed; inset:0; background:rgba(0,0,0,.45); backdrop-filter:blur(4px); z-index:9000; display:flex !important; align-items:center; justify-content:center; padding:20px; animation:ipFadeIn .18s ease; }
            @keyframes ipFadeIn { from{opacity:0} to{opacity:1} }
            .insta-popup[style*="none"] { display:none !important; }
            .insta-popup__inner { background:var(--color-white,#fff); border-radius:20px; box-shadow:0 28px 64px rgba(0,0,0,.18); padding:28px 24px 24px; max-width:340px; width:100%; text-align:center; animation:ipSlide .22s cubic-bezier(.34,1.56,.64,1); }
            @keyframes ipSlide { from{transform:translateY(16px);opacity:0} to{transform:translateY(0);opacity:1} }
            .insta-popup__icon { margin:0 auto 12px; }
            .insta-popup__title { font-size:18px; font-weight:800; color:var(--text-primary,#111); margin-bottom:6px; }
            .insta-popup__desc { font-size:13.5px; color:var(--text-secondary,#374151); margin-bottom:18px; line-height:1.5; }
            .insta-popup__steps { display:flex; flex-direction:column; gap:8px; margin-bottom:20px; background:var(--bg-secondary,#f8f9fa); border-radius:12px; padding:14px 16px; text-align:left; }
            .insta-popup__step { display:flex; align-items:center; gap:10px; font-size:13px; color:var(--text-secondary,#374151); }
            .insta-popup__step-n { width:22px; height:22px; border-radius:50%; background:linear-gradient(135deg,#f09433,#bc1888); color:#fff; font-size:11px; font-weight:800; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
            .insta-popup__actions { display:flex; gap:8px; justify-content:center; }
            .insta-popup__btn-open { display:inline-flex; align-items:center; padding:9px 18px; border-radius:10px; background:linear-gradient(135deg,#f09433,#bc1888); color:#fff; font-size:13px; font-weight:700; text-decoration:none; transition:opacity .15s; }
            .insta-popup__btn-open:hover { opacity:.88; }
            .insta-popup__btn-close { background:none; border:1px solid var(--border-light,#e5e7eb); border-radius:10px; padding:9px 16px; font-size:13px; color:var(--text-muted,#9ca3af); cursor:pointer; transition:background .15s; }
            .insta-popup__btn-close:hover { background:var(--bg-secondary,#f8f9fa); }
        script.
            // ── Copier le lien booking ──
            var promoCopyBtn = document.querySelector('.promo-link-copy');
            if (promoCopyBtn) {
                promoCopyBtn.addEventListener('click', function() {
                    var text = this.dataset.copy;
                    navigator.clipboard.writeText(text).then(function() {
                        promoCopyBtn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
                        setTimeout(function() {
                            promoCopyBtn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
                        }, 2000);
                    });
                });
            }

            // ── Instagram : copier légende + popup ──
            var instaBtn = document.querySelector('.promo-btn--instagram');
            var instaPopup = document.getElementById('instaPopup');
            if (instaBtn && instaPopup) {
                instaBtn.addEventListener('click', function() {
                    var url = this.dataset.bookingUrl;
                    var name = this.dataset.proName || 'moi';
                    var caption = '📅 Réservez en ligne avec ' + name + ' !\n\n✨ Simple, rapide, disponible 24h/24 — sans appel téléphonique.\n\n👉 ' + url + '\n\n#rdvenligne #reservation #branshee';
                    navigator.clipboard.writeText(caption).then(function() {
                        instaPopup.style.display = 'flex';
                    }).catch(function() {
                        // fallback si clipboard refusé
                        instaPopup.style.display = 'flex';
                    });
                });
                var closeInsta = instaPopup.querySelector('.insta-popup__btn-close');
                if (closeInsta) closeInsta.addEventListener('click', function() { instaPopup.style.display = 'none'; });
                instaPopup.addEventListener('click', function(e) { if (e.target === instaPopup) instaPopup.style.display = 'none'; });
            }

        //- ── Notifications email ─────────────────────────────────────────────
        .info-card
            .info-card__header
                h3 Notifications par email
                p.info-card__desc Choisissez quand vous souhaitez recevoir des emails de BranShee.
            .notif-list
                .notif-row
                    .notif-row__left
                        .notif-row__icon
                            svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                path(d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9")
                                path(d="M13.73 21a2 2 0 0 1-3.46 0")
                        .notif-row__text
                            .notif-row__title Nouvelle réservation
                            .notif-row__desc Recevez un email à chaque fois qu'un client prend rendez-vous avec vous.
                    label.notif-toggle
                        input#notifNewBooking(
                            type="checkbox"
                            checked=(user.notifications && user.notifications.newBooking !== false)
                        )
                        .notif-toggle__track
            .notif-status#notifStatus
        style.
            .notif-list { display:flex; flex-direction:column; gap:0; }
            .notif-row { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:16px 0; border-bottom:1px solid var(--border-light,#f0f0f0); }
            .notif-row:last-child { border-bottom:none; padding-bottom:0; }
            .notif-row__left { display:flex; align-items:center; gap:14px; }
            .notif-row__icon { width:38px; height:38px; border-radius:10px; background:var(--main-color-pale,#f0fdf4); display:flex; align-items:center; justify-content:center; color:var(--main-color,#16a34a); flex-shrink:0; }
            .notif-row__text { display:flex; flex-direction:column; gap:2px; }
            .notif-row__title { font-size:14px; font-weight:600; color:var(--text-primary,#111); }
            .notif-row__desc { font-size:12.5px; color:var(--text-muted,#6b7280); line-height:1.4; }
            .notif-toggle { position:relative; display:inline-block; width:46px; height:26px; flex-shrink:0; cursor:pointer; }
            .notif-toggle input { opacity:0; width:0; height:0; position:absolute; }
            .notif-toggle__track { position:absolute; inset:0; background:#d1d5db; border-radius:99px; transition:background .2s; }
            .notif-toggle__track::after { content:''; position:absolute; left:3px; top:3px; width:20px; height:20px; background:#fff; border-radius:50%; transition:transform .2s; box-shadow:0 1px 3px rgba(0,0,0,.15); }
            .notif-toggle input:checked + .notif-toggle__track { background:var(--main-color,#16a34a); }
            .notif-toggle input:checked + .notif-toggle__track::after { transform:translateX(20px); }
            .notif-status { font-size:12.5px; margin-top:8px; min-height:18px; color:var(--main-color,#16a34a); }
            .notif-status.error { color:#dc2626; }
        script.
            (function() {
                var cb = document.getElementById('notifNewBooking');
                var st = document.getElementById('notifStatus');
                if (!cb) return;
                cb.addEventListener('change', async function() {
                    try {
                        var r = await fetch('/settings/notifications', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ newBooking: this.checked })
                        });
                        var d = await r.json();
                        if (d.success) {
                            st.className = 'notif-status';
                            st.textContent = this.checked ? '✓ Notifications activées' : '✓ Notifications désactivées';
                        } else {
                            st.className = 'notif-status error';
                            st.textContent = 'Erreur lors de la sauvegarde.';
                        }
                    } catch(e) {
                        st.className = 'notif-status error';
                        st.textContent = 'Erreur réseau.';
                    }
                    setTimeout(function() { st.textContent = ''; }, 3000);
                });
            })();

        //- ── Modes de paiement ───────────────────────────────────────────────
        .info-card
            .info-card__header
                h3 Modes de paiement
                p.info-card__desc Choisissez les modes de paiement que vous proposez à vos clients.

            -
                var scStatus   = (stripeConnect && stripeConnect.status) || 'not_connected'
                var scEmail    = (stripeConnect && stripeConnect.accountEmail) || ''
                var scId       = (stripeConnect && stripeConnect.accountId) || ''
                var scIsActive = scStatus === 'active'
                var prepayOn   = !!(currentCompany && currentCompany.prepayment && currentCompany.prepayment.enabled)
                var prepayReq  = !!(currentCompany && currentCompany.prepayment && currentCompany.prepayment.required)

            //- Banners connect/error (s'affichent si on revient de l'OAuth)
            if stripeConnectSuccess
                .sc-success-banner(style="margin-bottom:16px")
