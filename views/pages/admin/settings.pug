                        .pm-method-expand-body#pmBankDetails(style=(!(acceptedPayments && acceptedPayments.bankTransfer && acceptedPayments.bankTransfer.enabled) ? 'display:none' : ''))
                            .pm-iban-grid
                                .field
                                    label.bk-label= t.settings.pm_bank_iban
                                    input.input#pmIban(
                                        type="text"
                                        placeholder="BE XX XXXX XXXX XXXX"
                                        value=(acceptedPayments && acceptedPayments.bankTransfer ? acceptedPayments.bankTransfer.iban : '')
                                    )
                                .field
                                    label.bk-label= t.settings.pm_bank_bic
                                    input.input#pmBic(
                                        type="text"
                                        placeholder="GEBABEBB"
                                        value=(acceptedPayments && acceptedPayments.bankTransfer ? acceptedPayments.bankTransfer.bic : '')
                                    )
                                .field
                                    label.bk-label= t.settings.pm_bank_name
                                    input.input#pmBankName(
                                        type="text"
                                        placeholder="BNP Paribas, ING…"
                                        value=(acceptedPayments && acceptedPayments.bankTransfer ? acceptedPayments.bankTransfer.bankName : '')
                                    )
                                .field
                                    label.bk-label= t.settings.pm_bank_note
                                    input.input#pmBankNote(
                                        type="text"
                                        placeholder="Mentionner votre nom en communication"
                                        value=(acceptedPayments && acceptedPayments.bankTransfer ? acceptedPayments.bankTransfer.note : '')
                                    )

                    //- ── 5. PayPal ───────────────────────────────────────────────
                    - var ppEnabled = !!(acceptedPayments && acceptedPayments.paypal && acceptedPayments.paypal.enabled)
                    - var ppMe = (acceptedPayments && acceptedPayments.paypal) ? (acceptedPayments.paypal.paypalMe || '') : ''
                    .pm-method-expandable(class=(ppEnabled ? 'is-open' : ''))
                        label.pm-method-row.pm-method-row--top
                            input#pmPaypal(
                                type="checkbox"
                                checked=ppEnabled
