        // ── Tab navigation ────────────────────────────────────────────────────
        (function () {
            var tabs     = document.querySelectorAll('.settings-tab');
            var sections = document.querySelectorAll('.settings-section');
            function activate(targetId) {
                tabs.forEach(function(t){t.classList.remove('is-active');});
                sections.forEach(function(s){s.classList.remove('is-active');});
                var tab = document.querySelector('.settings-tab[data-target="'+targetId+'"]');
                var sec = document.getElementById(targetId);
                if (tab) tab.classList.add('is-active');
                if (sec) sec.classList.add('is-active');
            }
            tabs.forEach(function(tab){
                tab.addEventListener('click', function(){
                    activate(tab.dataset.target);
                    history.replaceState(null, '', '#'+tab.dataset.target);
                });
            });
            var hash = location.hash.replace('#','');
            if (hash && document.getElementById(hash)) activate(hash);
        })();

        // ── Phone prefix picker ───────────────────────────────────────────────
        (function () {
            var prefixes = ['+32','+33','+352','+31','+49','+44','+34','+39','+41','+212','+1'];
            var prefixSel = document.getElementById('phonePrefix');
            var phoneLocal = document.getElementById('phoneLocal');
            var phoneHidden = document.getElementById('phone');
            if (!prefixSel || !phoneLocal || !phoneHidden) return;

            // Parse stored phone to detect prefix
            var stored = !{JSON.stringify(user.phone || '')};
            var detected = '+32';
            var localPart = stored;
            for (var i = 0; i < prefixes.length; i++) {
                if (stored.startsWith(prefixes[i])) {
                    detected = prefixes[i];
                    localPart = stored.slice(prefixes[i].length).trim();
                    break;
                }
            }
            prefixSel.value = detected;
            phoneLocal.value = localPart.replace(/[^\d]/g, '');
            phoneHidden.value = stored || '';

            function sync() {
                var local = phoneLocal.value.replace(/[^\d\s\-]/g, '').trim();
                phoneHidden.value = local ? prefixSel.value + local : '';
                // Trigger saveChanges enable
                var saveBtn = document.getElementById('saveChanges');
                if (saveBtn) saveBtn.disabled = false;
            }
            // Strip any non-digit character immediately as user types
            phoneLocal.addEventListener('input', function() {
                var pos = this.selectionStart;
                var cleaned = this.value.replace(/[^\d]/g, '');
                if (this.value !== cleaned) {
                    this.value = cleaned;
                    try { this.setSelectionRange(pos - 1, pos - 1); } catch(e) {}
                }
                this.style.borderColor = '';
                this.title = '';
                sync();
            });
            prefixSel.addEventListener('change', sync);

            // Validate on blur: must be digits/spaces/dashes, 6-15 chars
            phoneLocal.addEventListener('blur', function() {
                var v = phoneLocal.value.replace(/[\s\-]/g, '');
                if (v && !/^\d{6,15}$/.test(v)) {
                    phoneLocal.style.borderColor = '#ef4444';
                    phoneLocal.title = 'Numéro invalide — chiffres uniquement, 6 à 15 caractères';
                } else {
                    phoneLocal.style.borderColor = '';
                    phoneLocal.title = '';
                }
            });
        })();
