extends ../../layouts/admin

include ../../templates/modals/dialog.pug
include ../../templates/modals/prompt.pug
include ../../templates/change-password.pug
include ../../templates/edit-email.pug

block links
    link(rel="stylesheet", href="/css/layouts/informations.css")
    link(rel="stylesheet", href="/css/layouts/settings.css")
    link(rel="stylesheet", href="/css/templates/dialog.css")
    link(rel="stylesheet", href="/css/templates/change-password.css")
    link(rel="stylesheet", href="/css/templates/edit-email.css")

block content
    .info-page

        .info-page__header
            h2= t.sidebar.a_4 || 'Paramètres'
            p.info-page__subtitle Gérez votre profil, abonnement, sécurité et préférences.

        //- ── Profil personnel ────────────────────────────────────────────────
        .info-card
            .info-card__header
                h3= t.profile.section_title || 'Profil personnel'
            .profile-row
                .profile-photo-col
                    .profile-avatar
                        img(alt="Photo de profil" src=user.profilePicture || "/images/no-user.webp" id="avatarPreview")
                    input#fileInput(type="file" style="display:none" accept="image/*")
                    button.sm-btn.sm-btn--ghost#uploadBtn
                        span= t.profile.upload_photo
                .profile-fields
                    .field
                        label(for="fullname")= t.profile.fullname
                        input#fullname.input(value=user.fullName name="fullName")
                    .field
                        label(for="email")= t.profile.email
                        input#email.input(disabled value=maskEmail name="email")
                        .more#emailOpen= t.profile.edit_email
                    .field
                        label(for="phone")= t.profile.phone
                        input#phone.input(value=user.phone name="phone" placeholder=t.profile.phone)
            .info-card__actions
                button.sm-btn.sm-btn--danger#deleteAccountBtn(type="button")
                    span= t.profile.delete_account
                button.sm-btn.sm-btn--primary#saveChanges
                    span= t.profile.save

        //- ── Mot de passe ────────────────────────────────────────────────────
        .info-card#pwdCard
            .info-card__header
                h3 Mot de passe
                p.info-card__desc Modifiez votre mot de passe de connexion.
            .pwd-fields
                .field
                    label.auth-label Mot de passe actuel
                    input.input#pwdCurrent(type="password" placeholder="••••••••" autocomplete="current-password")
                .field
                    label.auth-label Nouveau mot de passe
                    input.input#pwdNew(type="password" placeholder="••••••••" autocomplete="new-password")
                .field
                    label.auth-label Confirmer le nouveau
                    input.input#pwdConfirm(type="password" placeholder="••••••••" autocomplete="new-password")
            .info-card__actions
                a.pwd-forgot-link(href="/forgot-password") Mot de passe actuel oublié ?
                button.sm-btn.sm-btn--primary#pwdSaveBtn(type="button")
                    span Enregistrer
            .pwd-status#pwdStatus
        style.
            .pwd-fields { display:flex; flex-direction:column; gap:14px; }
            .pwd-forgot-link { font-size:12.5px; color:var(--accent,#16a34a); text-decoration:none; margin-right:auto; }
            .pwd-forgot-link:hover { text-decoration:underline; }
            .pwd-status { font-size:12.5px; padding:0 0 4px; min-height:18px; }
            .pwd-status.ok  { color:var(--accent,#16a34a); }
            .pwd-status.err { color:#dc2626; }
        script.
            (function() {
                var saveBtn   = document.getElementById('pwdSaveBtn');
                var statusEl  = document.getElementById('pwdStatus');
                if (!saveBtn) return;
                saveBtn.addEventListener('click', async function() {
                    var cur  = (document.getElementById('pwdCurrent').value||'').trim();
                    var nw   = (document.getElementById('pwdNew').value||'').trim();
                    var conf = (document.getElementById('pwdConfirm').value||'').trim();
                    statusEl.className = 'pwd-status';
                    if (!cur || !nw || !conf) { statusEl.textContent='Veuillez remplir tous les champs.'; statusEl.className='pwd-status err'; return; }
                    if (nw.length < 8) { statusEl.textContent='Le nouveau mot de passe doit contenir au moins 8 caractères.'; statusEl.className='pwd-status err'; return; }
                    if (nw !== conf)   { statusEl.textContent='Les mots de passe ne correspondent pas.'; statusEl.className='pwd-status err'; return; }
                    saveBtn.disabled = true;
                    var span = saveBtn.querySelector('span');
                    var orig = span ? span.textContent : '';
                    if (span) span.textContent = '…';
                    var r = await fetch('/account/update-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' },
                        body: JSON.stringify({ oldPassword: cur, newPassword: nw })
                    });
                    var d = await r.json();
                    saveBtn.disabled = false;
                    if (span) span.textContent = orig;
                    if (d.success) {
                        statusEl.textContent = '✓ Mot de passe mis à jour.';
                        statusEl.className = 'pwd-status ok';
                        document.getElementById('pwdCurrent').value = '';
                        document.getElementById('pwdNew').value = '';
                        document.getElementById('pwdConfirm').value = '';
                    } else {
                        statusEl.textContent = d.error || 'Mot de passe actuel incorrect.';
                        statusEl.className = 'pwd-status err';
                    }
                });
            })();

        //- ── Votre abonnement ────────────────────────────────────────────────
        .info-card
            .info-card__header
                h3 Votre abonnement
                p.info-card__desc Choisissez la formule qui correspond le mieux à vos besoins.
            .sub-summary
                .sub-summary__row
                    span.sub-summary__label Plan actuel :
                    span.sub-summary__badge(class='sub-badge--' + (currentPlan || 'basic'))
                        = currentPlan === 'business' ? 'Business' : currentPlan === 'pro' ? 'Pro' : 'Starter'
                if isPro && !isExpired
                    .sub-status
                        svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                            path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm-56-240 226-226-57-57-169 169-85-85-57 57 142 142Z")
                        .sub-status__body
                            strong Vous êtes sur le plan #{currentPlan === 'business' ? 'Business' : 'Pro'}
                            span Vous profitez de toutes les fonctionnalités BranShee — merci de votre confiance !
                else if isExpired
                    .sub-status.sub-status--expired
                        svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                            path(d="M480-280q17 0 28.5-11.5T520-320q0-17-11.5-28.5T480-360q-17 0-28.5 11.5T440-320q0 17 11.5 28.5T480-280Zm-40-160h80v-240h-80v240Zm40 360q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                        .sub-status__body
                            strong Abonnement expiré
                            span Réactivez votre abonnement pour retrouver toutes vos fonctionnalités.
                else
                    .sub-status.sub-status--inactive
                        svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                            path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                        .sub-status__body
                            strong Aucun abonnement actif
                            span Passez à un plan payant pour débloquer toutes les fonctionnalités.
            .info-card__actions
                a.sm-btn.sm-btn--ghost(href="/subscription") Gérer mon abonnement

        //- ── Moyens de paiement ──────────────────────────────────────────────
        .info-card
            .info-card__header
                h3 Moyens de paiement
                p.info-card__desc Vos cartes bancaires enregistrées pour le paiement de votre abonnement.
            if paymentMethods && paymentMethods.length > 0
                .pm-list
                    each pm in paymentMethods
                        .pm-item(data-pmid=pm.id class=pm.isDefault ? 'pm-item--default' : '')
                            .pm-item__icon(class='pm-brand--' + pm.brand)
                                = pm.brand.charAt(0).toUpperCase() + pm.brand.slice(1)
                            .pm-item__info
                                span.pm-item__number •••• #{pm.last4}
                                span.pm-item__expiry Expire #{String(pm.expMonth).padStart(2,'0')}/#{String(pm.expYear).slice(-2)}
                            .pm-item__actions
                                if pm.isDefault
                                    span.pm-badge--default
                                        svg(xmlns="http://www.w3.org/2000/svg" height="11px" viewBox="0 -960 960 960" width="11px" fill="currentColor")
                                            path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm-56-240 226-226-57-57-169 169-85-85-57 57 142 142Z")
                                        | Par défaut
                                else
                                    button.pm-btn--set-default(type="button" data-pmid=pm.id) Définir par défaut
                                button.pm-item__del(type="button" data-pmid=pm.id title="Supprimer")
                                    svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                        path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
            else
                p.pm-empty Aucune carte enregistrée.
            .pm-add-wrap
                button.sm-btn.sm-btn--ghost#pmAddBtn(type="button")
                    svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                        path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                    span Ajouter une carte
            .pm-form-wrap#pmFormWrap(style="display:none")
                .pm-form
                    p.pm-form__label Informations de carte
                    #pm-card-element.pm-card-input
                    .pm-form__error#pmCardError
                    .pm-form__actions
                        button.sm-btn.sm-btn--primary#pmConfirmBtn(type="button")
                            span Confirmer
                        button.sm-btn.sm-btn--ghost#pmCancelBtn(type="button") Annuler

        //- ── Historique de paiement ──────────────────────────────────────────
        .info-card
            .info-card__header
                h3 Historique de paiement
                p.info-card__desc Toutes vos factures et paiements passés.
            if invoices && invoices.length > 0
                .inv-table
                    .inv-table__head
                        span Date
                        span Description
                        span Montant
                        span Statut
                        span
                    each inv in invoices
                        -
                            var d = new Date(inv.date * 1000)
                            var dateStr = d.toLocaleDateString('fr-FR', {day:'2-digit', month:'short', year:'numeric'})
                            var statusClass = inv.status === 'paid' ? 'inv-badge--paid' : inv.status === 'open' ? 'inv-badge--open' : 'inv-badge--other'
                            var statusLabel = inv.status === 'paid' ? 'Payé' : inv.status === 'open' ? 'En attente' : inv.status === 'void' ? 'Annulé' : inv.status
                        .inv-row
                            span.inv-row__date= dateStr
                            span.inv-row__desc= inv.description
                            span.inv-row__amount #{inv.amount} #{inv.currency}
                            span
                                span.inv-badge(class=statusClass)= statusLabel
                            span.inv-row__actions
                                if inv.pdfUrl
                                    a.inv-dl-btn(href=inv.pdfUrl target="_blank" rel="noopener" title="Télécharger la facture")
                                        svg(xmlns="http://www.w3.org/2000/svg" height="15px" viewBox="0 -960 960 960" width="15px" fill="currentColor")
                                            path(d="M480-320 280-520l56-58 104 104v-326h80v326l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z")
                                        span PDF
            else
                p.pm-empty Aucun historique de paiement.

        //- ── Authentification à deux facteurs ────────────────────────────────
        .info-card
            .info-card__header
                h3 Authentification à deux facteurs
                p.info-card__desc Protégez votre compte avec Google Authenticator. Une fois activée, un code sera demandé à chaque connexion.

            .settings-2fa

                if twoFAEnabled
                    .twofa-status.twofa-status--on
                        svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round")
                            path(d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z")
                        span 2FA activée — votre compte est protégé

                    .twofa-disable
                        p.twofa-hint Entrez votre code Google Authenticator pour désactiver la protection.
                        .twofa-row
                            .twofa-code-wrap
                                svg.twofa-code-icon(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                    path(d="M80-200v-80h400v80H80Zm0-200v-80h200v80H80Zm0-200v-80h200v80H80Zm736 400L670-336q-22 14-47.5 21t-52.5 7q-75 0-127.5-52.5T390-488q0-75 52.5-127.5T570-668q75 0 127.5 52.5T750-488q0 27-7 52.5T722-388l146 146-52 52ZM570-390q42 0 71-29t29-71q0-42-29-71t-71-29q-42 0-71 29t-29 71q0 42 29 71t71 29Z")
                                input#disableCode.twofa-code-input(
                                    type="tel"
                                    placeholder="123 456"
                                    maxlength="7"
                                    inputmode="numeric"
                                    autocomplete="one-time-code"
                                    pattern="[0-9 ]*"
                                )
                            button.sm-btn.sm-btn--danger#disable2FABtn(type="button") Désactiver
                        .twofa-feedback#disableFeedback

                else
                    .twofa-status.twofa-status--off
                        svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round")
                            path(d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z")
                        span 2FA désactivée

                    .twofa-setup#twoFASetup

                        .twofa-step#step1
                            button.sm-btn.sm-btn--primary#start2FABtn(type="button")
                                svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                                    path(d="M12 5v14M5 12h14")
                                span Configurer la 2FA

                        .twofa-step(id="step2" style="display:none")
                            .twofa-qr-block
                                p.twofa-hint
                                    | 1. Ouvrez&nbsp;
                                    strong Google Authenticator
                                    |  sur votre téléphone
                                p.twofa-hint 2. Scannez ce QR code
                                .twofa-qr-wrap
                                    img#twoFAQR(src="" alt="QR Code 2FA" width="180" height="180")
                                p.twofa-hint.twofa-hint--small Ou entrez ce code manuellement :
                                code.twofa-secret#twoFASecret
                            p.twofa-hint 3. Entrez le code à 6 chiffres affiché dans l'application
                            .twofa-row
                                .twofa-code-wrap
                                    svg.twofa-code-icon(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                        path(d="M80-200v-80h400v80H80Zm0-200v-80h200v80H80Zm0-200v-80h200v80H80Zm736 400L670-336q-22 14-47.5 21t-52.5 7q-75 0-127.5-52.5T390-488q0-75 52.5-127.5T570-668q75 0 127.5 52.5T750-488q0 27-7 52.5T722-388l146 146-52 52ZM570-390q42 0 71-29t29-71q0-42-29-71t-71-29q-42 0-71 29t-29 71q0 42 29 71t71 29Z")
                                    input#enableCode.twofa-code-input(
                                        type="tel"
                                        placeholder="123 456"
                                        maxlength="7"
                                        inputmode="numeric"
                                        autocomplete="one-time-code"
                                        pattern="[0-9 ]*"
                                    )
                                button.sm-btn.sm-btn--primary#enable2FABtn(type="button") Activer
                            .twofa-feedback#enableFeedback

        //- ── Parrainage ──────────────────────────────────────────────────────
        .info-card
            .info-card__header
                h3 🎁 Parrainage
                p.info-card__desc Invitez d'autres professionnels sur BranShee. Pour chaque filleul qui souscrit un abonnement payant, vous gagnez <strong>1 mois gratuit</strong> sur votre abonnement.
            -
                var _refCode  = user.referralCode || ''
                var _refLink  = 'https://www.branshee.com/register?ref=' + _refCode
                var _qrUrl    = 'https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=' + encodeURIComponent(_refLink)
                var _invited  = (user.referral && user.referral.totalInvited)  || 0
                var _paying   = (user.referral && user.referral.totalPaying)   || 0
                var _credit   = (user.referral && user.referral.creditMonths)  || 0
            .referral-wrap
                //- Stats
                .referral-stats
                    .referral-stat
                        .referral-stat__val= _invited
                        .referral-stat__label Inscrits
                    .referral-stat
                        .referral-stat__val= _paying
                        .referral-stat__label Payants
                    .referral-stat.referral-stat--credit
                        .referral-stat__val= _credit
                        .referral-stat__label Mois offerts en attente

                //- Code + lien
                .referral-share
                    .referral-block
                        .referral-label Votre code
                        .referral-code-row
                            span.referral-code= _refCode || '—'
                            button.referral-copy(type="button" data-copy=_refCode title="Copier le code")
                                svg(viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                    rect(x="9" y="9" width="13" height="13" rx="2" ry="2")
                                    path(d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1")
                    .referral-block
                        .referral-label Lien d'invitation
                        .referral-code-row
                            span.referral-link-val= _refLink
                            button.referral-copy(type="button" data-copy=_refLink title="Copier le lien")
                                svg(viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                    rect(x="9" y="9" width="13" height="13" rx="2" ry="2")
                                    path(d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1")

                //- QR Code
                .referral-qr-wrap
                    .referral-label QR Code
                    img.referral-qr(src=_qrUrl alt="QR Code parrainage" loading="lazy")
                    a.referral-qr-dl(href=_qrUrl download="branshee-parrainage-qr.png" target="_blank") ⬇ Télécharger

                .referral-note 💡 Partagez votre code, lien ou QR code. Dès qu'un filleul prend un abonnement payant, votre prochain mois est déduit automatiquement.

        style.
            .referral-wrap { display:flex; flex-direction:column; gap:20px; }
            .referral-stats { display:flex; gap:12px; flex-wrap:wrap; }
            .referral-stat { background:var(--color-surface-2,#f8fafc); border:1px solid var(--border-light,#e5e7eb); border-radius:12px; padding:14px 20px; display:flex; flex-direction:column; gap:3px; min-width:100px; }
            .referral-stat--credit { background:var(--main-color-pale,#f0fdf4); border-color:var(--main-color-border,rgba(34,197,94,.3)); }
            .referral-stat__val { font-size:1.6rem; font-weight:800; color:var(--text-primary,#111); letter-spacing:-0.03em; line-height:1; }
            .referral-stat--credit .referral-stat__val { color:var(--main-color,#16a34a); }
            .referral-stat__label { font-size:11.5px; color:var(--text-muted,#6b7280); font-weight:500; }
            .referral-share { display:flex; gap:12px; flex-wrap:wrap; }
            .referral-block { flex:1; min-width:200px; display:flex; flex-direction:column; gap:6px; }
            .referral-label { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--text-muted,#9ca3af); }
            /* "Votre code" (police 1.1rem en gras) et "Lien d'invitation" (police
               12px normale) n'avaient pas la même hauteur de ligne — les deux
               encadrés ("inputs") paraissaient de tailles différentes
               ("met les memes tailles dinputs"). On fixe une hauteur commune
               pour que les deux boîtes soient identiques quel que soit le
               texte affiché à l'intérieur. */
            .referral-code-row { display:flex; align-items:center; gap:8px; background:var(--color-surface-2,#f8fafc); border:1px solid var(--border-light,#e5e7eb); border-radius:10px; padding:10px 14px; min-height:44px; box-sizing:border-box; }
            .referral-code { font-family:monospace; font-size:1.1rem; font-weight:700; color:var(--text-primary,#111); letter-spacing:.05em; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
            .referral-link-val { font-size:12px; color:var(--text-muted,#6b7280); flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
            .referral-copy { background:none; border:none; cursor:pointer; color:var(--text-muted,#9ca3af); padding:2px; border-radius:6px; transition:color .15s,background .15s; display:flex; align-items:center; flex-shrink:0; }
            .referral-copy:hover { color:var(--main-color,#16a34a); background:var(--main-color-pale,#f0fdf4); }
            .referral-copy.copied { color:var(--main-color,#16a34a); }
            .referral-qr-wrap { display:flex; flex-direction:column; gap:8px; }
            .referral-qr { width:120px; height:120px; border-radius:10px; border:1px solid var(--border-light,#e5e7eb); }
            .referral-qr-dl { font-size:12px; color:var(--main-color,#16a34a); text-decoration:none; width:fit-content; }
            .referral-qr-dl:hover { text-decoration:underline; }
            .referral-note { font-size:12.5px; color:var(--text-muted,#6b7280); line-height:1.5; padding:10px 14px; background:var(--color-surface-2,#f8fafc); border-radius:10px; border:1px solid var(--border-light,#e5e7eb); }
        script.
            document.querySelectorAll('.referral-copy').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var text = this.dataset.copy;
                    if (!text) return;
                    navigator.clipboard.writeText(text).then(function() {
                        btn.classList.add('copied');
                        var orig = btn.innerHTML;
                        btn.innerHTML = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
                        setTimeout(function() { btn.innerHTML = orig; btn.classList.remove('copied'); }, 2000);
                    });
                });
            });

        //- ── Promouvoir ma page ──────────────────────────────────────────────
        -
