extends ../../layouts/admin

include ../../templates/modals/dialog.pug
include ../../templates/modals/prompt.pug
include ../../templates/change-password.pug
include ../../templates/edit-email.pug

block links
    link(rel="stylesheet", href="/css/layouts/informations.css")
    link(rel="stylesheet", href="/css/layouts/settings.css")
    link(rel="stylesheet", href="/css/templates/dialog.css")
    link(rel="stylesheet", href="/css/templates/change-password.css")
    link(rel="stylesheet", href="/css/templates/edit-email.css")

block content
    .info-page

        .info-page__header
            h2= t.sidebar.a_4 || 'Paramètres'
            p.info-page__subtitle= t.settings.subtitle

        //- ── Profil personnel ────────────────────────────────────────────────
        .info-card
            .info-card__header
                h3= t.profile.section_title || 'Profil personnel'
            .profile-row
                .profile-photo-col
                    .profile-avatar
                        img(alt=t.info.avatar_alt src=user.profilePicture || "/images/no-user.webp" id="avatarPreview")
                    input#fileInput(type="file" style="display:none" accept="image/*")
                    button.sm-btn.sm-btn--ghost#uploadBtn
                        span= t.profile.upload_photo
                .profile-fields
                    .field
                        label(for="fullname")= t.profile.fullname
                        input#fullname.input(value=user.fullName name="fullName")
                    .field
                        label(for="email")= t.profile.email
                        input#email.input(disabled value=maskEmail name="email")
                        .more#emailOpen= t.profile.edit_email
                    .field
                        label(for="phone")= t.profile.phone
                        input#phone.input(value=user.phone name="phone" placeholder=t.profile.phone)
            .info-card__actions
                button.sm-btn.sm-btn--danger#deleteAccountBtn(type="button")
                    span= t.profile.delete_account
                button.sm-btn.sm-btn--primary#saveChanges(disabled)
                    span= t.profile.save

        //- ── Votre établissement ─────────────────────────────────────────────
        .info-card#establishmentCard
            .info-card__header
                h3 Votre établissement
            if !currentCompany
                .estab-no-company
                    .estab-no-company__icon
                        svg(viewBox="0 -960 960 960" height="22" width="22" fill="currentColor")
                            path(d="M80-120v-720h400v160h400v560H80Zm80-80h240v-80H160v80Zm0-160h240v-80H160v80Zm0-160h240v-80H160v80Zm0-160h240v-80H160v80Zm320 480h320v-400H480v400Zm80-240v-80h160v80H560Zm0 160v-80h160v80H560Z")
                    .estab-no-company__text
                        if myJoinRequest && myJoinRequest.status === 'pending'
                            p.estab-no-company__title En attente d'approbation
                            p.estab-no-company__desc Votre demande pour rejoindre <strong>#{myJoinRequest.companyName}</strong> est en cours d'examen par le propriétaire.
                        else if myJoinRequest && myJoinRequest.status === 'rejected'
                            p.estab-no-company__title(style="color:#dc2626") Demande refusée
                            p.estab-no-company__desc Votre demande pour rejoindre <strong>#{myJoinRequest.companyName}</strong> a été refusée. Créez votre propre établissement ou rejoignez une autre équipe.
                        else
                            p.estab-no-company__title Aucun établissement
                            p.estab-no-company__desc Créez votre propre établissement ou rejoignez une équipe existante (plan Business).
                        a.sm-btn.sm-btn--primary(href="/etablissement/mes-etablissements")
                            span Gérer mes établissements
            else
                - const _estabName = currentCompany.name || user.businessName || 'Établissement'
                - const _estabInitial = _estabName.charAt(0).toUpperCase()
                - const _estabSlug = currentCompany.slug || String(currentCompany._id)
                .estab-overview
                    .estab-overview__avatar= _estabInitial
                    .estab-overview__info
                        p.estab-overview__name= _estabName
                        .estab-overview__meta
                            if membershipRole !== 'owner'
                                span.estab-member-badge
                                    svg(viewBox="0 -960 960 960" height="12" width="12" fill="currentColor")
                                        path(d="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-94q0-38 19-65t49-41q67-30 128.5-45T480-420q62 0 123 15.5T731.5-360q31 14 49.5 41t18 65v94H160Z")
                                    | #{membershipRole || 'Collaborateur'}
                            else if currentCompany.isPaused
                                span.estab-status-badge.estab-status-badge--paused
                                    span.estab-status-badge__dot
                                    | En pause
                            else
                                span.estab-status-badge.estab-status-badge--active
                                    span.estab-status-badge__dot
                                    | Actif
                            span.estab-overview__slug branshee.com/#{_estabSlug}
                    if membershipRole === 'owner'
                        .estab-overview__actions
                            if currentCompany.isPaused
                                button.sm-btn.sm-btn--primary#resumeCompanyBtn(type="button") Reprendre
                            else
                                button.sm-btn.sm-btn--ghost#pauseCompanyBtn(type="button") Mettre en pause
                if membershipRole === 'owner'
                    a.estab-footer-link(href="/etablissement/mes-etablissements")
                        svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                            path(d="M0-240v-86q0-36 19-67t52-49q57-30 119-46t130-16q68 0 130 16t119 46q33 18 52 49t19 67v86H0Zm640 0v-86q0-36-19.5-67.5T568-441q44 6 89.5 22.5T720-385q24 14 38 35.5t14 49.5v60h-132Zm-440-80h280v-6q0-15-9-26.5t-23-19.5q-44-24-91-36t-97-12q-50 0-97 12t-91 36q-14 8-23 19.5t-9 26.5v6Zm140-200q-50 0-85-35t-35-85q0-50 35-85t85-35q50 0 85 35t35 85q0 50-35 85t-85 35Zm320-40q-18 0-33-3t-29-8q14-21 21.5-46t7.5-53q0-28-7.5-53T568-758q14-5 29-8t33-3q50 0 85 35t35 85q0 50-35 85t-85 35Z")
                        span Gérer mes établissements & collaborateurs
                        svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                            path(d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z")
            p#establishmentStatus(style="display:none;font-size:13px;color:var(--accent);margin-top:4px")
            p#establishmentError(style="display:none;font-size:13px;color:#dc2626;margin-top:4px")

        //- ── Demandes pour rejoindre votre équipe (propriétaire ou délégué
        //- collaborators.manage — cf. settingsInit qui calcule déjà la liste
        //- en conséquence, ce check ne fait que matcher le même critère) ──
        if permissions && permissions.collaborators.manage && pendingJoinRequests && pendingJoinRequests.length
            .info-card#joinRequestsCard
                .info-card__header
                    h3 Demandes pour rejoindre votre équipe
                    p.info-card__desc= pendingJoinRequests.length + ' demande(s) en attente.'
                each reqst in pendingJoinRequests
                    .join-request-row(data-id=reqst.id style="display:flex;align-items:center;gap:12px;padding:10px 0;border-top:1px solid var(--border-light,#e5e7eb)")
                        img(src=reqst.profilePicture alt=reqst.fullName style="width:36px;height:36px;border-radius:50%;object-fit:cover;flex-shrink:0")
                        div(style="flex:1;min-width:0")
                            div(style="font-weight:600;font-size:14px")= reqst.fullName
                            div(style="font-size:12.5px;color:var(--muted,#6b7280)")= reqst.email
                        button.sm-btn.sm-btn--ghost.join-request-reject(type="button" data-id=reqst.id) Refuser
                        button.sm-btn.sm-btn--primary.join-request-accept(type="button" data-id=reqst.id) Accepter

        //- ── Mot de passe ────────────────────────────────────────────────────
        .info-card#pwdCard
            .info-card__header
                h3= t.settings.pwd_title
                p.info-card__desc= t.settings.pwd_desc
            .pwd-fields
                .field
                    label.auth-label= t.settings.pwd_current
                    input.input#pwdCurrent(type="password" placeholder="••••••••" autocomplete="current-password")
                .field
                    label.auth-label= t.settings.pwd_new
                    input.input#pwdNew(type="password" placeholder="••••••••" autocomplete="new-password")
                .field
                    label.auth-label= t.settings.pwd_confirm
                    input.input#pwdConfirm(type="password" placeholder="••••••••" autocomplete="new-password")
            .info-card__actions
                a.pwd-forgot-link(href="/forgot-password")= t.settings.pwd_forgot_link
                button.sm-btn.sm-btn--primary#pwdSaveBtn(type="button")
                    span= t.info.save
            .pwd-status#pwdStatus
        style.
            .pwd-fields { display:flex; flex-direction:column; gap:14px; }
            .pwd-forgot-link { font-size:12.5px; color:var(--accent,#16a34a); text-decoration:none; margin-right:auto; }
            .pwd-forgot-link:hover { text-decoration:underline; }
            .pwd-status { font-size:12.5px; padding:0 0 4px; min-height:18px; }
            .pwd-status.ok  { color:var(--accent,#16a34a); }
            .pwd-status.err { color:#dc2626; }
        script.
            (function() {
                var saveBtn   = document.getElementById('pwdSaveBtn');
                var statusEl  = document.getElementById('pwdStatus');
                if (!saveBtn) return;
                saveBtn.addEventListener('click', async function() {
                    var cur  = (document.getElementById('pwdCurrent').value||'').trim();
                    var nw   = (document.getElementById('pwdNew').value||'').trim();
                    var conf = (document.getElementById('pwdConfirm').value||'').trim();
                    statusEl.className = 'pwd-status';
                    if (!cur || !nw || !conf) { statusEl.textContent=(window.__t && window.__t.pwd_fill_all_fields) || 'Veuillez remplir tous les champs.'; statusEl.className='pwd-status err'; return; }
                    if (nw.length < 8) { statusEl.textContent=(window.__t && window.__t.pwd_min_8) || 'Le nouveau mot de passe doit contenir au moins 8 caractères.'; statusEl.className='pwd-status err'; return; }
                    if (nw !== conf)   { statusEl.textContent=(window.__t && window.__t.pwd_no_match) || 'Les mots de passe ne correspondent pas.'; statusEl.className='pwd-status err'; return; }
                    saveBtn.disabled = true;
                    var span = saveBtn.querySelector('span');
                    var orig = span ? span.textContent : '';
                    if (span) span.textContent = '…';
                    var r = await fetch('/account/update-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' },
                        body: JSON.stringify({ oldPassword: cur, newPassword: nw })
                    });
                    var d = await r.json();
                    saveBtn.disabled = false;
                    if (span) span.textContent = orig;
                    if (d.success) {
                        statusEl.textContent = (window.__t && window.__t.pwd_updated) || '✓ Mot de passe mis à jour.';
                        statusEl.className = 'pwd-status ok';
                        document.getElementById('pwdCurrent').value = '';
                        document.getElementById('pwdNew').value = '';
                        document.getElementById('pwdConfirm').value = '';
                    } else {
                        statusEl.textContent = d.error || (window.__t && window.__t.pwd_wrong_current) || 'Mot de passe actuel incorrect.';
                        statusEl.className = 'pwd-status err';
                    }
                });
            })();

        //- ── Cartes pro (abonnement, paiements, politique d'annulation) ──────
        //- N'ont de sens que pour un établissement (cf. plan d'unification) —
        //- sans ça, leurs boutons mènent vers des routes injectCompany-gated
        //- (ex. /subscription) qui redirigent silencieusement vers "/".
        if currentCompany

            //- ── Votre abonnement ────────────────────────────────────────────
            .info-card
                .info-card__header
                    h3= t.info.sub_title
                    p.info-card__desc= t.info.sub_desc
                .sub-summary
                    .sub-summary__row
                        span.sub-summary__label= t.info.sub_current_plan
                        span.sub-summary__badge(class='sub-badge--' + (currentPlan || 'basic'))
                            = currentPlan === 'business' ? 'Business' : currentPlan === 'pro' ? 'Pro' : 'Starter'
                    if isPro && !isExpired
                        .sub-status
                            svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                                path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm-56-240 226-226-57-57-169 169-85-85-57 57 142 142Z")
                            .sub-status__body
                                strong= t.info.sub_active_title.replace('{plan}', currentPlan === 'business' ? 'Business' : 'Pro')
                                span= t.info.sub_active_desc
                    else if isExpired
                        .sub-status.sub-status--expired
                            svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                                path(d="M480-280q17 0 28.5-11.5T520-320q0-17-11.5-28.5T480-360q-17 0-28.5 11.5T440-320q0 17 11.5 28.5T480-280Zm-40-160h80v-240h-80v240Zm40 360q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                            .sub-status__body
                                strong= t.info.sub_expired_title
                                span= t.info.sub_expired_desc
                    else
                        .sub-status.sub-status--inactive
                            svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                                path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                            .sub-status__body
                                strong= t.info.sub_inactive_title
                                span= t.info.sub_inactive_desc
                .info-card__actions
                    a.sm-btn.sm-btn--ghost(href="/subscription")= t.info.sub_manage_btn

            //- ── Moyens de paiement ──────────────────────────────────────────────
            .info-card
                .info-card__header
                    h3= t.info.pm_title
                    p.info-card__desc= t.info.pm_desc
                if paymentMethods && paymentMethods.length > 0
                    .pm-list
                        each pm in paymentMethods
                            .pm-item(data-pmid=pm.id class=pm.isDefault ? 'pm-item--default' : '')
                                .pm-item__icon(class='pm-brand--' + pm.brand)
                                    = pm.brand.charAt(0).toUpperCase() + pm.brand.slice(1)
                                .pm-item__info
                                    span.pm-item__number •••• #{pm.last4}
                                    span.pm-item__expiry= t.info.pm_expires.replace('{date}', String(pm.expMonth).padStart(2,'0') + '/' + String(pm.expYear).slice(-2))
                                .pm-item__actions
                                    if pm.isDefault
                                        span.pm-badge--default
                                            svg(xmlns="http://www.w3.org/2000/svg" height="11px" viewBox="0 -960 960 960" width="11px" fill="currentColor")
                                                path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm-56-240 226-226-57-57-169 169-85-85-57 57 142 142Z")
                                            = t.info.pm_default_badge
                                    else
                                        button.pm-btn--set-default(type="button" data-pmid=pm.id)= t.info.pm_set_default
                                    button.pm-item__del(type="button" data-pmid=pm.id title=t.info.pm_delete_title)
                                        svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                            path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
                else
                    p.pm-empty= t.info.pm_empty
                .pm-add-wrap
                    button.sm-btn.sm-btn--ghost#pmAddBtn(type="button")
                        svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                            path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                        span= t.info.pm_add_btn
                .pm-form-wrap#pmFormWrap(style="display:none")
                    .pm-form
                        p.pm-form__label= t.info.pm_form_label
                        #pm-card-element.pm-card-input
                        .pm-form__error#pmCardError
                        .pm-form__actions
                            button.sm-btn.sm-btn--primary#pmConfirmBtn(type="button")
                                span= t.info.pm_confirm_btn
                            button.sm-btn.sm-btn--ghost#pmCancelBtn(type="button")= t.info.pm_cancel_btn

            //- ── Historique de paiement ──────────────────────────────────────────
            .info-card
                .info-card__header
                    h3= t.info.inv_title
                    p.info-card__desc= t.info.inv_desc
                if invoices && invoices.length > 0
                    .inv-table
                        .inv-table__head
                            span= t.info.inv_col_date
                            span= t.info.inv_col_desc
                            span= t.info.inv_col_amount
                            span= t.info.inv_col_status
                            span
                        each inv in invoices
                            -
                                var d = new Date(inv.date * 1000)
                                var dateStr = d.toLocaleDateString(lang, {day:'2-digit', month:'short', year:'numeric'})
                                var statusClass = inv.status === 'paid' ? 'inv-badge--paid' : inv.status === 'open' ? 'inv-badge--open' : 'inv-badge--other'
                                var statusLabel = inv.status === 'paid' ? t.info.inv_status_paid : inv.status === 'open' ? t.info.inv_status_pending : inv.status === 'void' ? t.info.inv_status_void : inv.status
                            .inv-row
                                span.inv-row__date= dateStr
                                span.inv-row__desc= inv.description
                                span.inv-row__amount #{inv.amount} #{inv.currency}
                                span
                                    span.inv-badge(class=statusClass)= statusLabel
                                span.inv-row__actions
                                    if inv.pdfUrl
                                        a.inv-dl-btn(href=inv.pdfUrl target="_blank" rel="noopener" title=t.info.inv_dl_title)
                                            svg(xmlns="http://www.w3.org/2000/svg" height="15px" viewBox="0 -960 960 960" width="15px" fill="currentColor")
                                                path(d="M480-320 280-520l56-58 104 104v-326h80v326l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z")
                                            span PDF
                else
                    p.pm-empty= t.info.inv_empty

            //- ── Authentification à deux facteurs ────────────────────────────────
            .info-card
                .info-card__header
                    h3= t.settings.tfa_title
                    p.info-card__desc= t.settings.tfa_desc

                .settings-2fa

                    if twoFAEnabled
                        .twofa-status.twofa-status--on
                            svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round")
                                path(d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z")
                            span= t.settings.tfa_on

                        .twofa-disable
                            p.twofa-hint= t.settings.tfa_disable_hint
                            .twofa-row
                                .twofa-code-wrap
                                    svg.twofa-code-icon(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                        path(d="M80-200v-80h400v80H80Zm0-200v-80h200v80H80Zm0-200v-80h200v80H80Zm736 400L670-336q-22 14-47.5 21t-52.5 7q-75 0-127.5-52.5T390-488q0-75 52.5-127.5T570-668q75 0 127.5 52.5T750-488q0 27-7 52.5T722-388l146 146-52 52ZM570-390q42 0 71-29t29-71q0-42-29-71t-71-29q-42 0-71 29t-29 71q0 42 29 71t71 29Z")
                                    input#disableCode.twofa-code-input(
                                        type="tel"
                                        placeholder="123 456"
                                        maxlength="7"
                                        inputmode="numeric"
                                        autocomplete="one-time-code"
                                        pattern="[0-9 ]*"
                                    )
                                button.sm-btn.sm-btn--danger#disable2FABtn(type="button")= t.settings.tfa_disable_btn
                            .twofa-feedback#disableFeedback

                    else
                        .twofa-status.twofa-status--off
                            svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round")
                                path(d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z")
                            span= t.settings.tfa_off

                        .twofa-setup#twoFASetup

                            .twofa-step#step1
                                button.sm-btn.sm-btn--primary#start2FABtn(type="button")
                                    svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                                        path(d="M12 5v14M5 12h14")
                                    span= t.settings.tfa_setup_btn

                            .twofa-step(id="step2" style="display:none")
                                .twofa-qr-block
                                    p.twofa-hint!= t.settings.tfa_step1_html
                                    p.twofa-hint= t.settings.tfa_step2
                                    .twofa-qr-wrap
                                        img#twoFAQR(src="" alt=t.settings.tfa_qr_alt width="180" height="180")
                                    p.twofa-hint.twofa-hint--small= t.settings.tfa_step2_manual
                                    code.twofa-secret#twoFASecret
                                p.twofa-hint= t.settings.tfa_step3
                                .twofa-row
                                    .twofa-code-wrap
                                        svg.twofa-code-icon(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                            path(d="M80-200v-80h400v80H80Zm0-200v-80h200v80H80Zm0-200v-80h200v80H80Zm736 400L670-336q-22 14-47.5 21t-52.5 7q-75 0-127.5-52.5T390-488q0-75 52.5-127.5T570-668q75 0 127.5 52.5T750-488q0 27-7 52.5T722-388l146 146-52 52ZM570-390q42 0 71-29t29-71q0-42-29-71t-71-29q-42 0-71 29t-29 71q0 42 29 71t71 29Z")
                                        input#enableCode.twofa-code-input(
                                            type="tel"
                                            placeholder="123 456"
                                            maxlength="7"
                                            inputmode="numeric"
                                            autocomplete="one-time-code"
                                            pattern="[0-9 ]*"
                                        )
                                    button.sm-btn.sm-btn--primary#enable2FABtn(type="button")= t.settings.tfa_enable_btn
                                .twofa-feedback#enableFeedback

            //- ── Notifications email ─────────────────────────────────────────────
            .info-card
                .info-card__header
                    h3= t.settings.notif_title
                    p.info-card__desc= t.settings.notif_desc
                .notif-list
                    .notif-row
                        .notif-row__left
                            .notif-row__icon
                                svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                    path(d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9")
                                    path(d="M13.73 21a2 2 0 0 1-3.46 0")
                            .notif-row__text
                                .notif-row__title= t.settings.notif_new_booking_title
                                .notif-row__desc= t.settings.notif_new_booking_desc
                        label.notif-toggle
                            input#notifNewBooking(
                                type="checkbox"
                                checked=(user.notifications && user.notifications.newBooking !== false)
                            )
                            .notif-toggle__track
                .notif-status#notifStatus
            style.
                .notif-list { display:flex; flex-direction:column; gap:0; }
                .notif-row { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:16px 0; border-bottom:1px solid var(--border-light,#f0f0f0); }
                .notif-row:last-child { border-bottom:none; padding-bottom:0; }
                .notif-row__left { display:flex; align-items:center; gap:14px; }
                .notif-row__icon { width:38px; height:38px; border-radius:10px; background:var(--main-color-pale,#f0fdf4); display:flex; align-items:center; justify-content:center; color:var(--main-color,#16a34a); flex-shrink:0; }
                .notif-row__text { display:flex; flex-direction:column; gap:2px; }
                .notif-row__title { font-size:14px; font-weight:600; color:var(--text-primary,#111); }
                .notif-row__desc { font-size:12.5px; color:var(--text-muted,#6b7280); line-height:1.4; }
                .notif-toggle { position:relative; display:inline-block; width:46px; height:26px; flex-shrink:0; cursor:pointer; }
                .notif-toggle input { opacity:0; width:0; height:0; position:absolute; }
                .notif-toggle__track { position:absolute; inset:0; background:#d1d5db; border-radius:99px; transition:background .2s; }
                .notif-toggle__track::after { content:''; position:absolute; left:3px; top:3px; width:20px; height:20px; background:#fff; border-radius:50%; transition:transform .2s; box-shadow:0 1px 3px rgba(0,0,0,.15); }
                .notif-toggle input:checked + .notif-toggle__track { background:var(--main-color,#16a34a); }
                .notif-toggle input:checked + .notif-toggle__track::after { transform:translateX(20px); }
                .notif-status { font-size:12.5px; margin-top:8px; min-height:18px; color:var(--main-color,#16a34a); }
                .notif-status.error { color:#dc2626; }
            script.
                (function() {
                    var cb = document.getElementById('notifNewBooking');
                    var st = document.getElementById('notifStatus');
                    if (!cb) return;
                    cb.addEventListener('change', async function() {
                        try {
                            var r = await fetch('/settings/notifications', {
                                method: 'PATCH',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ newBooking: this.checked })
                            });
                            var d = await r.json();
                            if (d.success) {
                                st.className = 'notif-status';
                                st.textContent = this.checked ? ((window.__t && window.__t.notif_enabled) || '✓ Notifications activées') : ((window.__t && window.__t.notif_disabled) || '✓ Notifications désactivées');
                            } else {
                                st.className = 'notif-status error';
                                st.textContent = (window.__t && window.__t.save_error) || 'Erreur lors de la sauvegarde.';
                            }
                        } catch(e) {
                            st.className = 'notif-status error';
                            st.textContent = (window.__t && window.__t.network_error) || 'Erreur réseau.';
                        }
                        setTimeout(function() { st.textContent = ''; }, 3000);
                    });
                })();

            //- ── Modes de paiement ───────────────────────────────────────────────
            .info-card
                .info-card__header
                    h3= t.settings.pm_modes_title
                    p.info-card__desc= t.settings.pm_modes_desc

                -
                    var prepayOn   = !!(currentCompany && currentCompany.prepayment && currentCompany.prepayment.enabled)
                    var prepayReq  = !!(currentCompany && currentCompany.prepayment && currentCompany.prepayment.required)

                .pm-methods-grid

                    //- ── 1. Paiement à l'avance ──────────────────────────────────
                    .pm-method-expandable(class=(prepayOn ? 'is-open' : ''))
                        label.pm-method-row.pm-method-row--top
                            input#prepayEnabled(type="checkbox" checked=prepayOn)
                            .pm-method-info
                                .pm-method-icon-wrap
                                    svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                                        path(d="M880-720v480q0 33-23.5 56.5T800-160H160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h640q33 0 56.5 23.5T880-720Zm-720 80h640v-80H160v80Zm0 160v240h640v-240H160Zm0 240v-480 480Z")
                                div
                                    .pm-method-label-row
                                        span.pm-method-label= t.settings.pm_online_label
                                        span.pm-method-badge(style="background:#635bff;color:#fff") Sécurisé
                                    span.pm-method-sub Le client paie en ligne au moment de la réservation — aucune configuration requise de votre côté.

                        .pm-method-expand-body#stripeExpandBody(style=(!prepayOn ? 'display:none' : ''))
                            //- Info paiement plateforme
                            .sc-platform-notice
                                svg(width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                    path(d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z")
                                div
                                    strong Paiement via BranShee
                                    span Les paiements sont traités de manière sécurisée par notre plateforme. Vous n'avez aucun compte à créer ni à connecter.

                            //- Toggle obligatoire
                            .prepayment-toggle-row.prepayment-toggle-row--sub(id="prepayRequiredRow")
                                .prepayment-toggle-info
                                    span.prepayment-toggle-label= t.settings.pm_required_label
                                    span.prepayment-toggle-sub= t.settings.pm_required_sub
                                label.sa-toggle-wrap
                                    input#prepayRequired(type="checkbox" checked=prepayReq)
