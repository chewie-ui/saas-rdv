block scripts
    script(src="/js/utils/image-upload.js")
    script(src='/js/layouts/informations.js')
    script(src="https://js.stripe.com/v3/")
    script(src='/js/templates/dialog.js' type="module")
    script(src='/js/templates/edit-email.js')
    script.
        // ── Votre établissement (pause / reprendre / demandes reçues) ───────────
        // Créer/rejoindre un établissement se font désormais depuis /etablissement/
        // mes-etablissements (cf. plan d'unification + multi-établissements).
        (function () {
            var pauseBtn  = document.getElementById('pauseCompanyBtn');
            var resumeBtn = document.getElementById('resumeCompanyBtn');
            var statusEl  = document.getElementById('establishmentStatus');
            var errorEl   = document.getElementById('establishmentError');

            function showStatus(msg) {
                if (errorEl) errorEl.style.display = 'none';
                if (statusEl) { statusEl.textContent = msg; statusEl.style.display = 'block'; }
            }
            function showError(msg) {
                if (statusEl) statusEl.style.display = 'none';
                if (errorEl) { errorEl.textContent = msg; errorEl.style.display = 'block'; }
            }

            if (pauseBtn) {
                pauseBtn.addEventListener('click', async function () {
                    if (!confirm('Mettre votre établissement en pause ? Il ne sera plus visible publiquement, mais rien n\'est supprimé et vous pourrez le reprendre à tout moment.')) return;
                    pauseBtn.disabled = true;
                    try {
                        var res = await fetch('/account/company-pause', { method: 'PATCH' });
                        var data = await res.json();
                        if (data.success) {
                            showStatus('✓ Établissement mis en pause.');
                            setTimeout(function () { location.reload(); }, 900);
                        } else {
                            showError(data.error || 'Erreur lors de la mise en pause.');
                            pauseBtn.disabled = false;
                        }
                    } catch (e) {
                        showError('Erreur réseau.');
                        pauseBtn.disabled = false;
                    }
                });
            }

            if (resumeBtn) {
                resumeBtn.addEventListener('click', async function () {
                    resumeBtn.disabled = true;
                    try {
                        var res = await fetch('/account/company-resume', { method: 'PATCH' });
                        var data = await res.json();
                        if (data.success) {
                            showStatus('✓ Établissement repris.');
                            setTimeout(function () { location.reload(); }, 900);
                        } else {
                            showError(data.error || 'Erreur lors de la reprise.');
                            resumeBtn.disabled = false;
                        }
                    } catch (e) {
                        showError('Erreur réseau.');
                        resumeBtn.disabled = false;
                    }
                });
            }

            // ── Demandes reçues (propriétaire) ──────────────────────────────────
            document.querySelectorAll('.join-request-accept, .join-request-reject').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    var row = btn.closest('.join-request-row');
                    var decision = btn.classList.contains('join-request-accept') ? 'accepted' : 'rejected';
                    row.querySelectorAll('button').forEach(function (b) { b.disabled = true; });
                    try {
                        var res = await fetch('/account/join-requests/' + btn.dataset.id, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ decision: decision }),
                        });
                        var data = await res.json();
                        if (data.success) {
                            row.remove();
                        } else {
                            alert(data.error || 'Erreur.');
                            row.querySelectorAll('button').forEach(function (b) { b.disabled = false; });
                        }
                    } catch (e) {
                        alert('Erreur réseau.');
                        row.querySelectorAll('button').forEach(function (b) { b.disabled = false; });
                    }
                });
            });
        })();

        // ── Payment methods ────────────────────────────────────────────────────
        (function () {
            var STRIPE_KEY = '!{stripePublishableKey}';
            var pmAddBtn   = document.getElementById('pmAddBtn');
            var pmFormWrap = document.getElementById('pmFormWrap');
            var pmConfirmBtn = document.getElementById('pmConfirmBtn');
            var pmCancelBtn  = document.getElementById('pmCancelBtn');
            var pmCardError  = document.getElementById('pmCardError');
            var stripeInstance = null;
            var cardElement    = null;

            document.querySelectorAll('.pm-item__del').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    if (!confirm((window.__t && window.__t.pm_delete_confirm) || 'Supprimer cette carte ?')) return;
                    var pmId = btn.dataset.pmid;
                    btn.disabled = true;
                    try {
                        var res = await fetch('/account/payment-method/' + pmId, { method: 'DELETE' });
                        var data = await res.json();
                        if (data.success) {
                            btn.closest('.pm-item').remove();
                        } else {
                            alert(data.error || (window.__t && window.__t.pm_delete_error) || 'Erreur lors de la suppression.');
                            btn.disabled = false;
                        }
                    } catch (e) { btn.disabled = false; }
                });
            });

            document.querySelectorAll('.pm-btn--set-default').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    var pmId = btn.dataset.pmid;
                    var setDefaultLabel = (window.__t && window.__t.pm_set_default) || 'Définir par défaut';
                    btn.disabled = true;
                    btn.textContent = '...';
                    try {
                        var res  = await fetch('/account/payment-method/' + pmId + '/set-default', { method: 'POST' });
                        var data = await res.json();
                        if (data.success) {
                            document.querySelectorAll('.pm-badge--default').forEach(function (badge) {
                                var oldItem = badge.closest('.pm-item');
                                var actionsEl = badge.parentElement;
                                var newBtn = document.createElement('button');
                                newBtn.className = 'pm-btn--set-default';
                                newBtn.type = 'button';
                                newBtn.dataset.pmid = oldItem.dataset.pmid;
                                newBtn.textContent = setDefaultLabel;
                                actionsEl.replaceChild(newBtn, badge);
                                oldItem.classList.remove('pm-item--default');
                                newBtn.addEventListener('click', arguments.callee);
                            });
                            var actionsEl = btn.parentElement;
                            var badge = document.createElement('span');
                            badge.className = 'pm-badge--default';
                            badge.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" height="11px" viewBox="0 -960 960 960" width="11px" fill="currentColor"><path d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm-56-240 226-226-57-57-169 169-85-85-57 57 142 142Z"/></svg> ' + ((window.__t && window.__t.pm_default_badge) || 'Par défaut');
                            actionsEl.replaceChild(badge, btn);
                            btn.closest('.pm-item').classList.add('pm-item--default');
                        } else {
                            alert(data.error || (window.__t && window.__t.generic_error) || 'Erreur.');
                            btn.disabled = false;
                            btn.textContent = setDefaultLabel;
                        }
                    } catch (e) {
                        btn.disabled = false;
                        btn.textContent = setDefaultLabel;
                    }
                });
            });

            if (pmAddBtn) {
                pmAddBtn.addEventListener('click', async function () {
                    var addLabel = (window.__t && window.__t.pm_add_btn) || 'Ajouter une carte';
                    if (!STRIPE_KEY) {
                        alert((window.__t && window.__t.pm_stripe_missing) || 'Configuration Stripe manquante. Ajoutez STRIPE_PUBLISHABLE_KEY_LOCAL dans votre fichier .env');
                        return;
                    }
                    if (!window.Stripe) {
                        alert((window.__t && window.__t.pm_stripe_not_loaded) || 'Stripe.js n\'est pas chargé. Vérifiez votre connexion internet.');
                        return;
                    }
                    if (pmFormWrap.style.display !== 'none') return;
                    pmAddBtn.disabled = true;
                    pmAddBtn.querySelector('span').textContent = '...';
                    try {
                        var res  = await fetch('/account/payment-method/setup-intent', { method: 'POST' });
                        var data = await res.json();
                        if (!data.clientSecret) throw new Error(data.error || (window.__t && window.__t.pm_setup_error) || 'Erreur');
                        if (!stripeInstance) {
                            stripeInstance = Stripe(STRIPE_KEY);
                            var elements = stripeInstance.elements();
                            cardElement = elements.create('card', {
                                style: { base: { fontSize: '15px', color: '#111', fontFamily: 'Inter, system-ui, sans-serif', '::placeholder': { color: '#aaa' } } }
                            });
                            cardElement.mount('#pm-card-element');
                            cardElement.on('change', function (e) {
                                pmCardError.textContent = e.error ? e.error.message : '';
                            });
                        }
                        pmFormWrap.dataset.secret = data.clientSecret;
                        pmFormWrap.style.display = 'block';
                        pmAddBtn.querySelector('span').textContent = addLabel;
                        pmAddBtn.disabled = false;
                    } catch (e) {
                        pmAddBtn.querySelector('span').textContent = addLabel;
                        pmAddBtn.disabled = false;
                        alert(e.message || (window.__t && window.__t.pm_form_error) || 'Erreur lors de la création du formulaire.');
                    }
                });
            }

            if (pmConfirmBtn) {
                pmConfirmBtn.addEventListener('click', async function () {
                    if (!stripeInstance || !cardElement) return;
                    var secret = pmFormWrap.dataset.secret;
                    var confirmLabel = (window.__t && window.__t.pm_confirm_btn) || 'Confirmer';
                    pmConfirmBtn.disabled = true;
                    pmConfirmBtn.querySelector('span').textContent = '...';
                    pmCardError.textContent = '';
                    try {
                        var result = await stripeInstance.confirmCardSetup(secret, {
                            payment_method: { card: cardElement }
                        });
                        if (result.error) {
                            pmCardError.textContent = result.error.message;
                            pmConfirmBtn.disabled = false;
                            pmConfirmBtn.querySelector('span').textContent = confirmLabel;
                        } else {
                            var newPmId = result.setupIntent.payment_method;
                            try { await fetch('/account/payment-method/' + newPmId + '/set-default', { method: 'POST' }); } catch (e) {}
                            window.location.reload();
                        }
                    } catch (e) {
                        pmCardError.textContent = e.message || (window.__t && window.__t.generic_error) || 'Erreur.';
                        pmConfirmBtn.disabled = false;
                        pmConfirmBtn.querySelector('span').textContent = confirmLabel;
                    }
                });
            }

            if (pmCancelBtn) {
                pmCancelBtn.addEventListener('click', function () {
                    pmFormWrap.style.display = 'none';
                });
            }
        })();

        // ── 2FA ───────────────────────────────────────────────────────────────
        (function () {
            var startBtn   = document.getElementById('start2FABtn');
            var step1      = document.getElementById('step1');
            var step2      = document.getElementById('step2');
            var qrImg      = document.getElementById('twoFAQR');
            var secretEl   = document.getElementById('twoFASecret');
            var enableBtn  = document.getElementById('enable2FABtn');
            var enableCode = document.getElementById('enableCode');
            var enableFb   = document.getElementById('enableFeedback');
            var disableBtn  = document.getElementById('disable2FABtn');
            var disableCode = document.getElementById('disableCode');
            var disableFb   = document.getElementById('disableFeedback');

            function setFeedback(el, msg, ok) {
                if (!el) return;
                el.textContent = msg;
                el.className = 'twofa-feedback ' + (ok ? 'twofa-feedback--ok' : 'twofa-feedback--err');
            }

            if (startBtn) {
                startBtn.addEventListener('click', function () {
                    var setupLabel = (window.__t && window.__t.tfa_setup_btn) || 'Configurer la 2FA';
                    startBtn.disabled = true;
                    startBtn.querySelector('span').textContent = '…';
                    fetch('/account/2fa/setup', { method: 'POST', headers: { 'X-Requested-With': 'fetch' } })
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            if (!d.success) { startBtn.disabled = false; startBtn.querySelector('span').textContent = setupLabel; return; }
                            qrImg.src = d.qrDataUrl;
                            secretEl.textContent = d.secret;
                            step1.style.display = 'none';
                            step2.style.display = 'block';
                        })
                        .catch(function () { startBtn.disabled = false; startBtn.querySelector('span').textContent = setupLabel; });
                });
            }

            if (enableBtn) {
                enableBtn.addEventListener('click', function () {
                    var code = enableCode.value.replace(/\s/g, '');
                    if (code.length < 6) { setFeedback(enableFb, (window.__t && window.__t.tfa_code_required) || 'Entrez un code à 6 chiffres.', false); return; }
                    enableBtn.disabled = true;
                    fetch('/account/2fa/enable', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' },
                        body: JSON.stringify({ code: code })
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (d.success) {
                            setFeedback(enableFb, (window.__t && window.__t.tfa_enabled_success) || '2FA activée avec succès !', true);
                            setTimeout(function () { location.reload(); }, 1200);
                        } else {
                            setFeedback(enableFb, d.error || (window.__t && window.__t.tfa_wrong_code) || 'Code incorrect.', false);
                            enableBtn.disabled = false;
                        }
                    })
                    .catch(function () { setFeedback(enableFb, (window.__t && window.__t.network_error) || 'Erreur réseau.', false); enableBtn.disabled = false; });
                });
            }

            if (disableBtn) {
                disableBtn.addEventListener('click', function () {
                    var code = disableCode.value.replace(/\s/g, '');
                    if (code.length < 6) { setFeedback(disableFb, (window.__t && window.__t.tfa_code_required) || 'Entrez un code à 6 chiffres.', false); return; }
                    disableBtn.disabled = true;
                    fetch('/account/2fa/disable', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' },
                        body: JSON.stringify({ code: code })
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (d.success) {
                            setFeedback(disableFb, (window.__t && window.__t.tfa_disabled_success) || '2FA désactivée.', true);
                            setTimeout(function () { location.reload(); }, 1200);
                        } else {
                            setFeedback(disableFb, d.error || (window.__t && window.__t.tfa_wrong_code) || 'Code incorrect.', false);
                            disableBtn.disabled = false;
                        }
                    })
                    .catch(function () { setFeedback(disableFb, (window.__t && window.__t.network_error) || 'Erreur réseau.', false); disableBtn.disabled = false; });
                });
            }

            // ── Langue ────────────────────────────────────────────────────────
            var langFb = document.getElementById('langFeedback');
            document.querySelectorAll('.lang-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var lang = btn.getAttribute('data-lang');
                    fetch('/account/language', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' },
                        body: JSON.stringify({ lang: lang })
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (d.success) {
                            document.querySelectorAll('.lang-btn').forEach(function (b) { b.classList.remove('lang-btn--active'); });
                            btn.classList.add('lang-btn--active');
                            if (langFb) { langFb.textContent = (window.__t && window.__t.lang_updated) || 'Langue mise à jour.'; langFb.className = 'lang-feedback lang-feedback--ok'; }
                            setTimeout(function () { location.reload(); }, 800);
                        }
                    });
                });
            });

            // ── Modes de paiement ──────────────────────────────────────────────
            (function () {
                var enabledCb      = document.getElementById('prepayEnabled');
                var requiredCb     = document.getElementById('prepayRequired');
                var reqRow         = document.getElementById('prepayRequiredRow');
                var stripeExpand   = document.getElementById('stripeExpandBody');
                var feedback       = document.getElementById('prepayFeedback');
                var errorEl        = document.getElementById('prepayError');
                var pmCash         = document.getElementById('pmCash');
                var pmCardOnSite   = document.getElementById('pmCardOnSite');
                var pmBankTransfer = document.getElementById('pmBankTransfer');
                var pmBankDetails  = document.getElementById('pmBankDetails');
                var pmIban         = document.getElementById('pmIban');
                var pmBic          = document.getElementById('pmBic');
                var pmBankName     = document.getElementById('pmBankName');
                var pmBankNote     = document.getElementById('pmBankNote');
                var pmPaypal       = document.getElementById('pmPaypal');
                var pmPaypalDet    = document.getElementById('pmPaypalDetails');
                var pmPaypalMe     = document.getElementById('pmPaypalMe');
                var pmPaypalPrev   = document.getElementById('pmPaypalPreview');
                var pmQrCode       = document.getElementById('pmQrCode');
                var pmQrDetails    = document.getElementById('pmQrDetails');
                var pmQrNote       = document.getElementById('pmQrNote');
                var pmQrFile       = document.getElementById('pmQrFile');
                var pmQrUploadBtn  = document.getElementById('pmQrUploadBtn');
                var pmQrPreview    = document.getElementById('pmQrPreview');

                // Expand/collapse "Paiement en ligne"
                if (enabledCb) {
                    enabledCb.addEventListener('change', function () {
                        if (stripeExpand) stripeExpand.style.display = enabledCb.checked ? '' : 'none';
                        savePrepay();
                    });
                }

                // Expand/collapse champs IBAN
                if (pmBankTransfer) {
                    pmBankTransfer.addEventListener('change', function () {
                        if (pmBankDetails) pmBankDetails.style.display = pmBankTransfer.checked ? '' : 'none';
                        savePrepay();
                    });
                }

                // Expand/collapse PayPal
                if (pmPaypal) {
                    pmPaypal.addEventListener('change', function () {
                        if (pmPaypalDet) pmPaypalDet.style.display = pmPaypal.checked ? '' : 'none';
                        savePrepay();
                    });
                }

                // Mise à jour de l'aperçu PayPal en temps réel
                if (pmPaypalMe) {
                    pmPaypalMe.addEventListener('input', function () {
                        var username = pmPaypalMe.value.trim().replace(/^https?:\/\/paypal\.me\//i, '');
                        var placeholderName = (window.__t && window.__t.paypal_placeholder_name) || 'votre-nom';
                        var placeholderAmount = (window.__t && window.__t.paypal_placeholder_amount) || 'montant';
                        if (pmPaypalPrev) {
                            pmPaypalPrev.textContent = username
                                ? 'https://paypal.me/' + username + '/{' + placeholderAmount + '}'
                                : 'https://paypal.me/' + placeholderName + '/{' + placeholderAmount + '}';
                        }
                    });
                }

                // Expand/collapse QR code
                if (pmQrCode) {
                    pmQrCode.addEventListener('change', function () {
                        if (pmQrDetails) pmQrDetails.style.display = pmQrCode.checked ? '' : 'none';
                        savePrepay();
                    });
                }

                // Upload de l'image du QR code
                if (pmQrUploadBtn && pmQrFile) {
                    pmQrUploadBtn.addEventListener('click', function () { pmQrFile.click(); });
                    pmQrFile.addEventListener('change', async function () {
                        var file = pmQrFile.files[0];
                        if (!file) return;
                        try {
                            var data = await window.BkImageUpload.uploadImage({
                                url: '/settings/payment-qr-code',
                                method: 'PATCH',
                                fieldName: 'qrCodeImage',
                                file: file,
                            });
                            if (data.path && pmQrPreview) {
                                pmQrPreview.src = data.path;
                                pmQrPreview.style.display = '';
                            }
                        } catch (e) {
                            // L'erreur est déjà affichée à l'écran par BkImageUpload.
                        } finally {
                            pmQrFile.value = '';
                        }
                    });
                }

                if (requiredCb) requiredCb.addEventListener('change', savePrepay);
                [pmCash, pmCardOnSite].forEach(function(el) {
                    if (el) el.addEventListener('change', savePrepay);
                });

                // Débounce pour les champs texte
                var _textTimer;
                [pmIban, pmBic, pmBankName, pmBankNote, pmPaypalMe, pmQrNote].forEach(function(el) {
                    if (el) el.addEventListener('input', function () {
                        clearTimeout(_textTimer);
                        _textTimer = setTimeout(savePrepay, 800);
                    });
                });

                async function savePrepay() {
                    if (feedback) feedback.style.display = 'none';
                    if (errorEl) errorEl.style.display = 'none';
                    try {
                        var r = await fetch('/settings/prepayment', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                enabled:             enabledCb      ? enabledCb.checked      : false,
                                required:            requiredCb     ? requiredCb.checked     : false,
                                cash:                pmCash         ? pmCash.checked         : false,
                                cardOnSite:          pmCardOnSite   ? pmCardOnSite.checked   : false,
                                bankTransferEnabled: pmBankTransfer ? pmBankTransfer.checked : false,
                                iban:                pmIban     ? pmIban.value     : '',
                                bic:                 pmBic      ? pmBic.value      : '',
                                bankName:            pmBankName ? pmBankName.value : '',
                                bankNote:            pmBankNote ? pmBankNote.value : '',
                                paypalEnabled:       pmPaypal   ? pmPaypal.checked   : false,
                                paypalMe:            pmPaypalMe ? pmPaypalMe.value.trim() : '',
                                qrCodeEnabled:       pmQrCode   ? pmQrCode.checked   : false,
                                qrCodeNote:          pmQrNote   ? pmQrNote.value     : '',
                            })
                        });
                        var d = await r.json();
                        if (d.success && feedback) {
                            feedback.style.display = 'block';
                            setTimeout(function () { feedback.style.display = 'none'; }, 2500);
                        } else if (!d.success) {
                            // Le paiement en ligne a été refusé (Stripe pas connecté) —
                            // on décoche pour ne jamais laisser un état "activé" qui ne
                            // marche pas réellement côté réservation client.
                            if (enabledCb && d.error === 'stripe_not_connected') {
                                enabledCb.checked = false;
                                // On laisse la section Stripe dépliée : c'est là que vit
                                // le bouton « Continuer la configuration » dont l'admin a besoin.
                            }
                            if (errorEl) {
                                errorEl.textContent = '⚠ ' + (d.message || d.error || (window.__t && window.__t.save_error) || 'Erreur lors de la sauvegarde.');
                                errorEl.style.display = 'block';
                            }
                        }
                    } catch(e) {}
                }
            })();

            // ── Politique d'annulation ────────────────────────────────────────
            (function () {
                var radios = document.querySelectorAll('input[name="cancelRule"]');
                var fb = document.getElementById('cancelPolicyFeedback');
                radios.forEach(function (r) {
                    r.addEventListener('change', async function () {
                        // Update visual selection
                        document.querySelectorAll('.cp-card').forEach(function(opt) {
                            opt.classList.toggle('is-selected', opt.querySelector('input').checked);
                        });
                        try {
                            var res = await fetch('/settings/cancellation-policy', {
                                method: 'PATCH',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ rule: r.value })
                            });
                            var d = await res.json();
                            if (d.success && fb) {
                                fb.style.display = 'block';
                                setTimeout(function() { fb.style.display = 'none'; }, 2500);
                            }
                        } catch(e) {}
                    });
                });
            })();

        })();
