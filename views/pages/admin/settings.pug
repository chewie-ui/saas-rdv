                            .pm-method-info
                                span.pm-method-icon 📱
                                div
                                    span.pm-method-label= t.settings.pm_qr_label
                                    span.pm-method-sub= t.settings.pm_qr_sub

                        .pm-method-expand-body#pmQrDetails(style=(!qrEnabled ? 'display:none' : ''))
