            .pm-methods-grid

                //- ── 1. Paiement en ligne à l'avance ─────────────────────────
                .pm-method-expandable(class=(prepayOn ? 'is-open' : ''))
                    label.pm-method-row.pm-method-row--top
                        input#prepayEnabled(
                            type="checkbox"
                            checked=prepayOn
                        )
                        .pm-method-info
                            .pm-method-icon-wrap
                                svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                                    path(d="M880-720v480q0 33-23.5 56.5T800-160H160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h640q33 0 56.5 23.5T880-720Zm-720 80h640v-80H160v80Zm0 160v240h640v-240H160Zm0 240v-480 480Z")
                            div
                                .pm-method-label-row
                                    span.pm-method-label Paiement en ligne
                                    span.pm-method-badge Stripe
                                span.pm-method-sub Le client paie par carte lors de la réservation

                    //- Sous-section Stripe (visible si coché)
                    .pm-method-expand-body#stripeExpandBody(style=(!prepayOn ? 'display:none' : ''))

                        //- Stripe Connect
                        .sc-connect-inner
                            if scIsActive
                                .sc-connected-row
                                    .sc-connected-badge
                                        svg(width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5")
                                            polyline(points="20 6 9 17 4 12")
                                        | Stripe connecté
                                    .sc-connected-info
                                        span.sc-connected-email= scEmail || scId
                                        span.sc-connected-id= scId
                                    button.sm-btn.sm-btn--ghost.sm-btn--sm#disconnectStripeBtn(
                                        type="button"
                                        data-confirm="Déconnecter votre compte Stripe ? Les paiements en ligne seront désactivés."
                                    ) Déconnecter
                            else if scStatus === 'pending'
                                .sc-not-connected-inline
                                    p.sc-not-connected-desc
                                        | Votre compte Stripe est en cours de configuration.
                                        br
                                        | Cliquez sur le bouton ci-dessous pour continuer l'activation.
                                    a.sm-btn.sm-btn--primary.sm-btn--sm(href="/settings/stripe-connect") Continuer la configuration →
                                    span(style="display:block;font-size:11px;color:var(--muted,#6b7280);margin-top:8px") Vous serez redirigé vers Stripe, puis revenus ici automatiquement.

                            else
                                .sc-not-connected-inline
                                    p.sc-not-connected-desc
                                        | Connectez votre compte Stripe pour recevoir les paiements directement sur votre compte bancaire.
                                        br
                                        | L'inscription prend 2 minutes — Stripe s'occupe de tout.
                                    a.sm-btn.sm-btn--primary.sm-btn--sm(href="/settings/stripe-connect")
                                        svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:6px;vertical-align:-2px")
                                            path(d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71")
                                            path(d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71")
                                        | Connecter mon compte Stripe
                                    span(style="display:block;font-size:11px;color:var(--muted,#6b7280);margin-top:8px") Vous serez redirigé vers Stripe, puis revenus ici automatiquement.

                        //- Toggle obligatoire
                        .prepayment-toggle-row.prepayment-toggle-row--sub(
                            id="prepayRequiredRow"
                            style=(!scIsActive ? 'opacity:.45;pointer-events:none' : '')
                        )
                            .prepayment-toggle-info
                                span.prepayment-toggle-label Rendre le paiement obligatoire
                                span.prepayment-toggle-sub Si désactivé, le client peut choisir de payer plus tard
                            label.sa-toggle-wrap
                                input#prepayRequired(
                                    type="checkbox"
                                    checked=prepayReq
                                    disabled=(!scIsActive)
                                )
                                .sa-toggle-track

                        //- Politique annulation
                        .prepayment-policy-box.prepayment-policy-box--sm
                            svg(width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                circle(cx="12" cy="12" r="10")
                                polyline(points="12 6 12 12 16 14")
                            div
                                strong Politique d'annulation automatique
                                ul
                                    li Annulation #[strong > 24h] — remboursement complet
                                    li Annulation #[strong < 24h] — 50 % prélevés
                                    li Absence sans annulation — 100 % prélevés

                //- ── 2. Espèces ──────────────────────────────────────────────
                label.pm-method-row
                    input#pmCash(
                        type="checkbox"
                        checked=(acceptedPayments && acceptedPayments.cash)
                    )
                    .pm-method-info
                        span.pm-method-icon 💵
                        div
                            span.pm-method-label Espèces
                            span.pm-method-sub Paiement en liquide sur place

                //- ── 3. Carte bancaire sur place ─────────────────────────────
                label.pm-method-row
                    input#pmCardOnSite(
                        type="checkbox"
                        checked=(acceptedPayments && acceptedPayments.cardOnSite)
                    )
                    .pm-method-info
                        span.pm-method-icon 💳
                        div
                            span.pm-method-label Carte bancaire sur place
                            span.pm-method-sub Terminal de paiement (TPE)

                //- ── 4. Virement IBAN ────────────────────────────────────────
                .pm-method-expandable(class=(acceptedPayments && acceptedPayments.bankTransfer && acceptedPayments.bankTransfer.enabled ? 'is-open' : ''))
                    label.pm-method-row.pm-method-row--top
                        input#pmBankTransfer(
                            type="checkbox"
                            checked=(acceptedPayments && acceptedPayments.bankTransfer && acceptedPayments.bankTransfer.enabled)
                        )
                        .pm-method-info
                            span.pm-method-icon 🏦
                            div
                                span.pm-method-label Virement bancaire (IBAN)
                                span.pm-method-sub Les coordonnées s'afficheront au client

                    .pm-method-expand-body#pmBankDetails(style=(!(acceptedPayments && acceptedPayments.bankTransfer && acceptedPayments.bankTransfer.enabled) ? 'display:none' : ''))
                        .pm-iban-grid
                            .field
                                label.bk-label IBAN
                                input.input#pmIban(
                                    type="text"
                                    placeholder="BE XX XXXX XXXX XXXX"
                                    value=(acceptedPayments && acceptedPayments.bankTransfer ? acceptedPayments.bankTransfer.iban : '')
                                )
                            .field
                                label.bk-label BIC / SWIFT
                                input.input#pmBic(
                                    type="text"
                                    placeholder="GEBABEBB"
                                    value=(acceptedPayments && acceptedPayments.bankTransfer ? acceptedPayments.bankTransfer.bic : '')
                                )
                            .field
                                label.bk-label Nom de la banque
                                input.input#pmBankName(
                                    type="text"
                                    placeholder="BNP Paribas, ING…"
                                    value=(acceptedPayments && acceptedPayments.bankTransfer ? acceptedPayments.bankTransfer.bankName : '')
                                )
                            .field
                                label.bk-label Instructions (optionnel)
                                input.input#pmBankNote(
                                    type="text"
                                    placeholder="Mentionner votre nom en communication"
                                    value=(acceptedPayments && acceptedPayments.bankTransfer ? acceptedPayments.bankTransfer.note : '')
                                )

                //- ── 5. PayPal ───────────────────────────────────────────────
                - var ppEnabled = !!(acceptedPayments && acceptedPayments.paypal && acceptedPayments.paypal.enabled)
                - var ppMe = (acceptedPayments && acceptedPayments.paypal) ? (acceptedPayments.paypal.paypalMe || '') : ''
                .pm-method-expandable(class=(ppEnabled ? 'is-open' : ''))
                    label.pm-method-row.pm-method-row--top
                        input#pmPaypal(
                            type="checkbox"
                            checked=ppEnabled
                        )
                        .pm-method-info
                            span.pm-method-icon 🅿️
                            div
                                span.pm-method-label PayPal
                                span.pm-method-sub Envoi d'un lien PayPal.me au client

                    .pm-method-expand-body#pmPaypalDetails(style=(!ppEnabled ? 'display:none' : ''))
                        .pm-iban-grid
                            .field
                                label.bk-label Nom d'utilisateur PayPal.me
                                .sc-manual-form
                                    span.sc-manual-prefix paypal.me/
                                    input.input#pmPaypalMe(
                                        type="text"
                                        placeholder="votre-nom"
                                        autocomplete="off"
                                        value=ppMe
                                    )
                            .field
                                label.bk-label Aperçu du lien
                                p.pm-paypal-preview(id="pmPaypalPreview" style="font-size:12px;color:var(--muted,#6b7280);margin:4px 0 0")
                                    = ppMe ? 'https://paypal.me/' + ppMe + '/{montant}' : 'https://paypal.me/votre-nom/{montant}'

            p#prepayFeedback(style="display:none;font-size:13px;color:var(--accent);margin-top:14px") ✓ Paramètres sauvegardés

