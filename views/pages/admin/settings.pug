extends ../../layouts/admin

include ../../templates/modals/dialog.pug
include ../../templates/modals/prompt.pug
include ../../templates/change-password.pug
include ../../templates/edit-email.pug

block links
    link(rel="stylesheet", href="/css/layouts/informations.css")
    link(rel="stylesheet", href="/css/layouts/settings.css")
    link(rel="stylesheet", href="/css/components/admin/availability.admin.css")
    link(rel="stylesheet", href="/css/templates/dialog.css")
    link(rel="stylesheet", href="/css/templates/change-password.css")
    link(rel="stylesheet", href="/css/templates/edit-email.css")

block content
    .settings-page

        //- ── Tab bar ───────────────────────────────────────────────────────
        .settings-tabs
            button.settings-tab.is-active(type="button" data-target="stg-profil") Profil
            button.settings-tab(type="button" data-target="stg-securite") Sécurité
            button.settings-tab(type="button" data-target="stg-plan") Plan & Facturation
            if currentCompany
                button.settings-tab(type="button" data-target="stg-paiements") Paiements
            button.settings-tab(type="button" data-target="stg-preferences") Préférences

        //- ══════════════════════════════════════════════════════════════
        //- SECTION — Profil
        //- ══════════════════════════════════════════════════════════════
        #stg-profil.settings-section.is-active

            .settings-section__head.settings-section__head--flex
                .settings-section__headText
                    h2.settings-section__title Profil
                    p.settings-section__desc Votre identité personnelle sur BranShee.
                .settings-section__headActions
                    button.sm-btn.sm-btn--ghost#cancelChanges(type="button")= t.profile.cancel
                    button.sm-btn.sm-btn--primary#saveChanges(disabled)
                        span= t.profile.save

            .stg-form

                //- Photo
                -
                    var _fn = (user.fullName || '').trim();
                    var _sp = _fn.indexOf(' ');
                    var _first = _sp === -1 ? _fn : _fn.slice(0, _sp);
                    var _last  = _sp === -1 ? '' : _fn.slice(_sp + 1);

                //- Nom (prénom + nom)
                .stg-row
                    .stg-row__label
                        | Nom complet
                        p.stg-row__desc Prénom et nom affichés à vos clients.
                    .stg-row__field
                        .stg-name-grid
                            input#firstName.input(value=_first placeholder=t.profile.first_name_ph autocomplete="given-name")
                            input#lastName.input(value=_last placeholder=t.profile.last_name_ph autocomplete="family-name")
                        input#fullname(type="hidden" name="fullName" value=user.fullName)

                //- Email
                .stg-row
                    .stg-row__label
                        | Adresse e-mail
                        p.stg-row__desc Votre identifiant de connexion.
                    .stg-row__field
                        .stg-input-icon
                            span.material-symbols-outlined.stg-input-icon__ic mail
                            input#email.input(disabled value=maskEmail name="email")
                        a.stg-link#emailOpen= t.profile.edit_email

                //- Photo de profil
                .stg-row
                    .stg-row__label
                        | Photo de profil
                        p.stg-row__desc Visible par vos clients et collaborateurs.
                    .stg-row__field
                        .stg-photo
                            img.stg-avatar(src=user.profilePicture || "/images/no-user.webp" id="avatarPreview" alt="avatar")
                            .stg-dropzone#photoDropzone(tabindex="0" role="button")
                                .stg-dropzone__icon
                                    span.material-symbols-outlined cloud_upload
                                p.stg-dropzone__text
                                    span.stg-dropzone__link= t.profile.upload_click
                                    |  #{t.profile.upload_drag}
                                p.stg-dropzone__hint= t.profile.upload_hint
                                input#fileInput(type="file" accept="image/*" hidden)
                                button#uploadBtn(type="button" hidden)

                //- Téléphone
                .stg-row
                    .stg-row__label
                        | Téléphone
                    .stg-row__field
                        -
                            var phoneCountries = [
                                {name:'Belgique', prefix:'+32', flag:'/images/flags/be.png'},
                                {name:'France', prefix:'+33', flag:'/images/flags/fr.png'},
                                {name:'Luxembourg', prefix:'+352', flag:'/images/flags/lu.png'},
                                {name:'Pays-Bas', prefix:'+31', flag:'/images/flags/nl.png'},
                                {name:'Allemagne', prefix:'+49', flag:'/images/flags/de.png'},
                                {name:'Royaume-Uni', prefix:'+44', flag:'/images/flags/gb.png'},
                                {name:'Espagne', prefix:'+34', flag:'/images/flags/es.png'},
                                {name:'Italie', prefix:'+39', flag:'/images/flags/it.png'},
                                {name:'Suisse', prefix:'+41', flag:'/images/flags/ch.png'},
                                {name:'Maroc', prefix:'+212', flag:'/images/flags/ma.png'},
                                {name:'États-Unis', prefix:'+1', flag:'/images/flags/us.png'}
                            ];
                        .phone-input-group
                            .phone-flag-select#phonePrefixWrap
                                button.phone-flag-btn#phonePrefixBtn(type="button" aria-haspopup="listbox" aria-expanded="false")
                                    img.phone-flag-img#phonePrefixFlag(src="/images/flags/be.png" alt="")
                                    span.phone-flag-code#phonePrefixCode +32
                                    span.material-symbols-outlined.phone-flag-caret expand_more
                                ul.phone-flag-menu#phonePrefixMenu(role="listbox")
                                    each c in phoneCountries
                                        li.phone-flag-option(role="option" data-prefix=c.prefix data-flag=c.flag)
                                            img(src=c.flag alt="")
                                            span.phone-flag-option__name= c.name
                                            span.phone-flag-option__code= c.prefix
                            input#phonePrefix(type="hidden" value="+32")
                            input#phoneLocal.input(type="tel" placeholder="456 12 34 56" autocomplete="off" inputmode="numeric")
                            input#phone(type="hidden" name="phone")

                //- Zone danger — suppression de l'ÉTABLISSEMENT courant (pas du
                //- compte) : on est dans les paramètres de l'établissement. La
                //- suppression est douce (données conservées), comme dans
                //- « Mes établissements ».
                if currentCompany
                    .stg-danger-row
                        //- Le nom sert à faire confirmer une SUPPRESSION : afficher
                        //- « cet établissement » au lieu de son nom rendait la
                        //- confirmation beaucoup trop facile à valider distraitement.
                        button.sm-btn.sm-btn--danger#deleteEstabBtn(type="button" data-id=String(currentCompany._id) data-name=(currentCompanyName || 'cet établissement'))
                            span Supprimer l'établissement

            if currentCompany
                //- Pause / réactivation de l'établissement
                .stg-card
                    .stg-card__head
                        p.stg-card__title= t.profile.pause_title
                        p.stg-card__desc= t.profile.pause_desc
                    .stg-card__body
                        .stg-form(style="margin-bottom:0;border:none;border-radius:0")
                            .stg-row(style="border-top:none")
                                .stg-row__label
                                    | #{t.profile.pause_status_label}
                                    p.stg-row__desc
                                        if currentCompany.isPaused
                                            span(style="color:#dc2626;font-weight:600") #{t.profile.pause_status_paused}
                                        else
                                            span(style="color:#16a34a;font-weight:600") #{t.profile.pause_status_active}
                                .stg-row__field
                                    if currentCompany.isPaused
                                        button.sm-btn.sm-btn--primary#toggleCompanyPauseBtn(type="button" data-paused="1")
                                            span= t.profile.pause_resume_btn
                                    else
                                        button.sm-btn.sm-btn--ghost#toggleCompanyPauseBtn(type="button" data-paused="0")
                                            span= t.profile.pause_pause_btn

        //- ══════════════════════════════════════════════════════════════
        //- SECTION — Sécurité
        //- ══════════════════════════════════════════════════════════════
        #stg-securite.settings-section

            .settings-section__head
                h2.settings-section__title Sécurité
                p.settings-section__desc Mot de passe et authentification à deux facteurs.

            //- Mot de passe
            .stg-card
                .stg-card__head
                    p.stg-card__title= t.settings.pwd_title
                    p.stg-card__desc= t.settings.pwd_desc
                .stg-card__body
                    .stg-form(style="margin-bottom:0;border:none;border-radius:0")
                        .stg-row(style="border-top:none")
                            .stg-row__label= t.settings.pwd_current
                            .stg-row__field
                                input.input#pwdCurrent(type="password" placeholder="••••••••" autocomplete="current-password")
                        .stg-row
                            .stg-row__label= t.settings.pwd_new
                            .stg-row__field
                                input.input#pwdNew(type="password" placeholder="••••••••" autocomplete="new-password")
                        .stg-row
                            .stg-row__label= t.settings.pwd_confirm
                            .stg-row__field
                                input.input#pwdConfirm(type="password" placeholder="••••••••" autocomplete="new-password")
                .stg-card__footer
                    a.stg-link(href="/forgot-password" style="margin-right:auto")= t.settings.pwd_forgot_link
                    button.sm-btn.sm-btn--primary#pwdSaveBtn(type="button")
                        span= t.info.save
                p.pwd-status#pwdStatus(style="padding:8px 0;min-height:18px;font-size:12.5px")
            style.
                .pwd-status.ok  { color:var(--accent,#16a34a); }
                .pwd-status.err { color:#dc2626; }
            script.
                (function() {
                    var saveBtn  = document.getElementById('pwdSaveBtn');
                    var statusEl = document.getElementById('pwdStatus');
                    if (!saveBtn) return;
                    saveBtn.addEventListener('click', async function() {
                        var cur  = (document.getElementById('pwdCurrent').value||'').trim();
                        var nw   = (document.getElementById('pwdNew').value||'').trim();
                        var conf = (document.getElementById('pwdConfirm').value||'').trim();
                        statusEl.className = 'pwd-status';
                        if (!cur || !nw || !conf) { statusEl.textContent=(window.__t && window.__t.pwd_fill_all_fields)||'Veuillez remplir tous les champs.'; statusEl.className='pwd-status err'; return; }
                        if (nw.length < 8) { statusEl.textContent=(window.__t && window.__t.pwd_min_8)||'Le mot de passe doit contenir au moins 8 caractères.'; statusEl.className='pwd-status err'; return; }
                        if (nw !== conf)   { statusEl.textContent=(window.__t && window.__t.pwd_no_match)||'Les mots de passe ne correspondent pas.'; statusEl.className='pwd-status err'; return; }
                        saveBtn.disabled = true;
                        var sp = saveBtn.querySelector('span'); var orig = sp ? sp.textContent : '';
                        if (sp) sp.textContent = '…';
                        var r = await fetch('/account/update-password',{ method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'fetch'}, body:JSON.stringify({oldPassword:cur,newPassword:nw}) });
                        var d = await r.json();
                        saveBtn.disabled = false; if (sp) sp.textContent = orig;
                        if (d.success) { statusEl.textContent=(window.__t && window.__t.pwd_updated)||'✓ Mot de passe mis à jour.'; statusEl.className='pwd-status ok'; ['pwdCurrent','pwdNew','pwdConfirm'].forEach(function(id){document.getElementById(id).value='';}); }
                        else { statusEl.textContent=d.error||(window.__t && window.__t.pwd_wrong_current)||'Mot de passe actuel incorrect.'; statusEl.className='pwd-status err'; }
                    });
                })();

            //- 2FA
            if currentCompany
                .stg-card
                    .stg-card__head
                        p.stg-card__title= t.settings.tfa_title
                        p.stg-card__desc= t.settings.tfa_desc
                    .stg-card__body
                        .settings-2fa
                            if twoFAEnabled
                                .twofa-status.twofa-status--on
                                    span.material-symbols-outlined verified_user
                                    span= t.settings.tfa_on
                                .twofa-disable
                                    p.twofa-hint= t.settings.tfa_disable_hint
                                    .twofa-row
                                        .twofa-code-wrap
                                            span.material-symbols-outlined.twofa-code-icon key
                                            input#disableCode.twofa-code-input(type="tel" placeholder="123 456" maxlength="7" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]*")
                                        button.sm-btn.sm-btn--danger#disable2FABtn(type="button")= t.settings.tfa_disable_btn
                                    .twofa-feedback#disableFeedback
                            else
                                .twofa-status.twofa-status--off
                                    span.material-symbols-outlined lock
                                    span= t.settings.tfa_off
                                .twofa-setup#twoFASetup
                                    .twofa-step#step1
                                        button.sm-btn.sm-btn--primary#start2FABtn(type="button")
                                            span.material-symbols-outlined add
                                            span= t.settings.tfa_setup_btn
                                    .twofa-step(id="step2" style="display:none")
                                        .twofa-qr-block
                                            p.twofa-hint!= t.settings.tfa_step1_html
                                            p.twofa-hint= t.settings.tfa_step2
                                            .twofa-qr-wrap
                                                img#twoFAQR(src="" alt=t.settings.tfa_qr_alt width="180" height="180")
                                            p.twofa-hint.twofa-hint--small= t.settings.tfa_step2_manual
                                            code.twofa-secret#twoFASecret
                                        p.twofa-hint= t.settings.tfa_step3
                                        .twofa-row
                                            .twofa-code-wrap
                                                span.material-symbols-outlined.twofa-code-icon key
                                                input#enableCode.twofa-code-input(type="tel" placeholder="123 456" maxlength="7" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]*")
                                            button.sm-btn.sm-btn--primary#enable2FABtn(type="button")= t.settings.tfa_enable_btn
                                        .twofa-feedback#enableFeedback

        //- ══════════════════════════════════════════════════════════════
        //- SECTION — Plan
        //- ══════════════════════════════════════════════════════════════
        #stg-plan.settings-section

            .settings-section__head
                h2.settings-section__title Plan & Facturation
                p.settings-section__desc Votre abonnement et vos informations de facturation.

            if currentCompany
                .stg-card
                    .stg-card__head
                        p.stg-card__title= t.info.sub_title
                        p.stg-card__desc= t.info.sub_desc
                    .stg-card__body
                        .sub-summary
                            .sub-summary__row
                                span.sub-summary__label= t.info.sub_current_plan
                                span.sub-summary__badge(class='sub-badge--' + (currentPlan || 'basic'))
                                    = currentPlan === 'business' ? 'Business' : currentPlan === 'pro' ? 'Pro' : 'Starter'
                            if isPro && !isExpired
                                .sub-status
                                    span.material-symbols-outlined check_circle
                                    .sub-status__body
                                        strong= t.info.sub_active_title.replace('{plan}', currentPlan === 'business' ? 'Business' : 'Pro')
                                        span= t.info.sub_active_desc
                            else if isExpired
                                .sub-status.sub-status--expired
                                    span.material-symbols-outlined error
                                    .sub-status__body
                                        strong= t.info.sub_expired_title
                                        span= t.info.sub_expired_desc
                            else
                                .sub-status.sub-status--inactive
                                    span.material-symbols-outlined radio_button_unchecked
                                    .sub-status__body
                                        strong= t.info.sub_inactive_title
                                        span= t.info.sub_inactive_desc
                    .stg-card__footer
                        a.sm-btn.sm-btn--ghost(href="/subscription")= t.info.sub_manage_btn
            else
                .stg-card
                    .stg-card__body
                        .estab-no-company
                            .estab-no-company__text
                                p.estab-no-company__title Créez d'abord un établissement
                                p.estab-no-company__desc La gestion du plan est disponible une fois votre établissement créé.
                                a.sm-btn.sm-btn--primary(href="/etablissement/mes-etablissements")
                                    span Créer un établissement

            if currentCompany
                //- Cartes Stripe
                .stg-card
                    .stg-card__head
                        p.stg-card__title= t.info.pm_title
                        p.stg-card__desc= t.info.pm_desc
                    .stg-card__body
                        //- Alerte : abonnement payant SANS carte → pas de
                        //- renouvellement automatique. On ne l'affiche pas aux
                        //- comptes gratuits (rien à renouveler).
                        - var _paidPlan = currentPlan && currentPlan !== 'basic' && currentPlan !== 'free'
                        - var _hasCard = paymentMethods && paymentMethods.length > 0
                        if _paidPlan && !_hasCard
                            .ds-alert.ds-alert--warning(style="margin-bottom:16px")
                                span.ds-alert__ic.material-symbols-outlined error
                                .ds-alert__body
                                    p.ds-alert__title Aucune carte enregistrée
                                    p.ds-alert__text Sans moyen de paiement, votre abonnement ne pourra pas se renouveler automatiquement et prendra fin à son échéance. Ajoutez une carte pour conserver votre accès sans interruption.
                                    .ds-alert__actions
                                        button.ds-alert__link.ds-alert__link--strong#noCardAddBtn(type="button") Ajouter une carte maintenant
                        p.pmx-hint= t.info.pm_select_hint
                        if paymentMethods && paymentMethods.length > 0
                            .pm-list.pmx-list
                                each pm in paymentMethods
                                    .pm-item.pmx-card(data-pmid=pm.id class=pm.isDefault ? 'pm-item--default' : '')
                                        .pmx-logo(class='pmx-brand--' + pm.brand)
                                            case pm.brand
                                                when 'visa'
                                                    span.pmx-wm.pmx-wm--visa VISA
                                                when 'mastercard'
                                                    span.pmx-mc
                                                        i.pmx-mc__a
                                                        i.pmx-mc__b
                                                when 'amex'
                                                    span.pmx-wm.pmx-wm--amex AMEX
                                                default
                                                    span.material-symbols-outlined credit_card
                                        .pm-item__info.pmx-info
                                            span.pm-item__number.pmx-number= (t.info.pm_ending || '{brand} se terminant par {last4}').replace('{brand}', pm.brand.charAt(0).toUpperCase() + pm.brand.slice(1)).replace('{last4}', pm.last4)
                                            span.pm-item__expiry.pmx-exp= t.info.pm_expires.replace('{date}', String(pm.expMonth).padStart(2,'0') + '/' + pm.expYear)
                                        .pm-item__actions.pmx-actions
                                            if pm.isDefault
                                                span.pm-badge--default
                                                    span.material-symbols-outlined(style=`font-size:13px`) check_circle
                                                    = t.info.pm_default_badge
                                            else
                                                button.pm-btn--set-default(type="button" data-pmid=pm.id)= t.info.pm_set_default
                                            button.pm-item__del(type="button" data-pmid=pm.id title=t.info.pm_delete_title)
                                                span.material-symbols-outlined delete
                                        span.pmx-radio
                        else
                            p.pm-empty.pmx-empty
                                span.material-symbols-outlined credit_card_off
                                span= t.info.pm_empty
                        button.pmx-add#pmAddBtn(type="button")
                            span.material-symbols-outlined add
                            span.pmx-add__label= t.info.pm_add_new
                        .pm-form-wrap.pmx-form#pmFormWrap(style="display:none")
                            .pmx-form__grid
                                .pmx-field.pmx-field--full
                                    label.pmx-label= t.info.pm_name_label
                                    input.pmx-input#pmCardName(type="text" placeholder=t.info.pm_name_ph autocomplete="cc-name")
                                .pmx-field.pmx-field--full
                                    label.pmx-label= t.info.pm_number_label
                                    .pmx-stripe#pm-card-number
                                .pmx-field
                                    label.pmx-label= t.info.pm_expiry_label
                                    .pmx-stripe#pm-card-expiry
                                .pmx-field
                                    label.pmx-label= t.info.pm_cvv_label
                                    .pmx-stripe#pm-card-cvc
                            .pm-form__error.pmx-error#pmCardError
                            .pmx-form__actions
                                button.sm-btn.sm-btn--primary#pmConfirmBtn(type="button")
                                    span= t.info.pm_confirm_btn
                                button.sm-btn.sm-btn--ghost#pmCancelBtn(type="button")= t.info.pm_cancel_btn

                //- Historique factures
                .stg-card
                    .stg-card__head
                        p.stg-card__title= t.info.inv_title
                        p.stg-card__desc= t.info.inv_desc
                    .stg-card__body
                        if invoices && invoices.length > 0
                            .inv-table
                                .inv-table__head
                                    span= t.info.inv_col_date
                                    span= t.info.inv_col_desc
                                    span= t.info.inv_col_amount
                                    span= t.info.inv_col_status
                                    span
                                each inv in invoices
                                    -
                                        var d = new Date(inv.date * 1000)
                                        var dateStr = d.toLocaleDateString(lang, {day:'2-digit', month:'short', year:'numeric'})
                                        var statusClass = inv.status === 'paid' ? 'inv-badge--paid' : inv.status === 'open' ? 'inv-badge--open' : 'inv-badge--other'
                                        var statusLabel = inv.status === 'paid' ? t.info.inv_status_paid : inv.status === 'open' ? t.info.inv_status_pending : inv.status === 'void' ? t.info.inv_status_void : inv.status
                                    .inv-row
                                        span.inv-row__date= dateStr
                                        span.inv-row__desc= inv.description
                                        span.inv-row__amount #{inv.amount} #{inv.currency}
                                        span
                                            span.inv-badge(class=statusClass)= statusLabel
                                        span.inv-row__actions
                                            if inv.pdfUrl
                                                a.inv-dl-btn(href=inv.pdfUrl target="_blank" rel="noopener" title=t.info.inv_dl_title)
                                                    span.material-symbols-outlined(style=`font-size:15px`) download
                                                    span PDF
                        else
                            p.pm-empty= t.info.inv_empty

        //- ══════════════════════════════════════════════════════════════
        //- SECTION — Paiements
        //- ══════════════════════════════════════════════════════════════
        #stg-paiements.settings-section

            .settings-section__head
                h2.settings-section__title Paiements
                p.settings-section__desc Modes de paiement acceptés et politique d'annulation.

            if currentCompany

                .stg-card
                    .stg-card__head
                        p.stg-card__title= t.settings.pm_modes_title
                        p.stg-card__desc= t.settings.pm_modes_desc
                    .stg-card__body
                        -
                            var prepayOn  = !!(currentCompany && currentCompany.prepayment && currentCompany.prepayment.enabled)
                            var prepayReq = !!(currentCompany && currentCompany.prepayment && currentCompany.prepayment.required)
                        if !isPro
                            .avail-upsell(style="margin-bottom:16px")
                                .avail-upsell__icon
                                    span.material-symbols-outlined lock
                                .avail-upsell__body
                                    strong.avail-upsell__title Modes de paiement
                                    span.avail-upsell__sub Passez au Pro pour activer et configurer vos modes de paiement.
                                    a.avail-upsell__cta(href="/subscription")= t.avail.upgrade_cta
                        div(class=(!isPro ? 'stg-locked-content' : ''))
                            .pm-methods-grid
                                .pm-method-expandable(class=(prepayOn ? 'is-open' : ''))
                                    label.pm-method-row.pm-method-row--top
                                        input#prepayEnabled(type="checkbox" checked=prepayOn)
                                        .pm-method-info
                                            .pm-method-icon-wrap
                                                span.material-symbols-outlined credit_card
                                            div
                                                .pm-method-label-row
                                                    span.pm-method-label= t.settings.pm_online_label
                                                    span.pm-method-badge(style="background:#635bff;color:#fff") Sécurisé
                                                span.pm-method-sub Le client paie en ligne au moment de la réservation.
                                    .pm-method-expand-body#stripeExpandBody(style=(!prepayOn ? 'display:none' : ''))
                                        .sc-platform-notice
                                            span.material-symbols-outlined(style=`font-size:15px`) verified_user
                                            div
                                                strong Paiement via BranShee
                                                span Les paiements sont traités de manière sécurisée par notre plateforme.
                                        .prepayment-toggle-row.prepayment-toggle-row--sub(id="prepayRequiredRow")
                                            .prepayment-toggle-info
                                                span.prepayment-toggle-label= t.settings.pm_required_label
                                                span.prepayment-toggle-sub= t.settings.pm_required_sub
                                            label.sa-toggle-wrap
                                                input#prepayRequired(type="checkbox" checked=prepayReq)
                                                .sa-toggle-track
                                        .prepayment-policy-box.prepayment-policy-box--sm
                                            span.material-symbols-outlined(style=`font-size:13px`) schedule
                                            div
                                                strong= t.settings.cp_auto_title
                                                ul
