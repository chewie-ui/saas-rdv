                hidden.value=prefix;
                if(flag) flagImg.src=flag;
                codeEl.textContent=prefix;
                menu.querySelectorAll('.phone-flag-option').forEach(function(o){ o.classList.toggle('is-selected', o.dataset.prefix===prefix); });
                if(dispatch) hidden.dispatchEvent(new Event('change',{bubbles:true}));
            }
            function close(){ menu.classList.remove('is-open'); btn.setAttribute('aria-expanded','false'); }
            btn.addEventListener('click', function(e){
                e.stopPropagation();
                var open=menu.classList.toggle('is-open');
                btn.setAttribute('aria-expanded', open?'true':'false');
            });
            menu.querySelectorAll('.phone-flag-option').forEach(function(o){
                o.addEventListener('click', function(){ setValue(o.dataset.prefix, o.dataset.flag, true); close(); });
            });
