extends ../../layouts/admin

include ../../templates/modals/dialog.pug
include ../../templates/modals/prompt.pug
include ../../templates/change-password.pug
include ../../templates/edit-email.pug

block links
    link(rel="stylesheet", href="/css/layouts/informations.css")
    link(rel="stylesheet", href="/css/layouts/settings.css")
    link(rel="stylesheet", href="/css/templates/dialog.css")
    link(rel="stylesheet", href="/css/templates/change-password.css")
    link(rel="stylesheet", href="/css/templates/edit-email.css")

block content
    .info-page

        .info-page__header
            h2= t.sidebar.a_4 || 'Paramètres'
            p.info-page__subtitle Gérez votre profil, abonnement, sécurité et préférences.

        //- ── Profil personnel ────────────────────────────────────────────────
        .info-card
            .info-card__header
                h3= t.profile.section_title || 'Profil personnel'
            .profile-row
                .profile-photo-col
                    .profile-avatar
                        img(alt="Photo de profil" src=user.profilePicture || "/images/no-user.webp" id="avatarPreview")
                    input#fileInput(type="file" style="display:none" accept="image/*")
                    button.sm-btn.sm-btn--ghost#uploadBtn
                        span= t.profile.upload_photo
                .profile-fields
                    .field
                        label(for="fullname")= t.profile.fullname
                        input#fullname.input(value=user.fullName name="fullName")
                    .field
                        label(for="email")= t.profile.email
                        input#email.input(disabled value=maskEmail name="email")
                        .more#emailOpen= t.profile.edit_email
                    .field
                        label(for="phone")= t.profile.phone
                        input#phone.input(value=user.phone name="phone" placeholder=t.profile.phone)
                    .field
                        label(for="password")= t.profile.password
                        input#password.input(placeholder="●●●●●●●●●●●" disabled)
                        a.more#passwordOpen(href="/forgot-password")= t.profile.change_pwd
                        .success= success
            .info-card__actions
                button.sm-btn.sm-btn--danger#deleteAccountBtn(type="button")
                    span= t.profile.delete_account
                button.sm-btn.sm-btn--primary#saveChanges
                    span= t.profile.save

        //- ── Votre abonnement ────────────────────────────────────────────────
        .info-card
            .info-card__header
                h3 Votre abonnement
                p.info-card__desc Choisissez la formule qui correspond le mieux à vos besoins.
            .sub-summary
                .sub-summary__row
                    span.sub-summary__label Plan actuel :
                    span.sub-summary__badge(class='sub-badge--' + (currentPlan || 'basic'))
                        = currentPlan === 'business' ? 'Business' : currentPlan === 'pro' ? 'Pro' : 'Starter'
                if isPro && !isExpired
                    .sub-status
                        svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                            path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm-56-240 226-226-57-57-169 169-85-85-57 57 142 142Z")
                        .sub-status__body
                            strong Vous êtes sur le plan #{currentPlan === 'business' ? 'Business' : 'Pro'}
                            span Vous profitez de toutes les fonctionnalités BranShee — merci de votre confiance !
                else if isExpired
                    .sub-status.sub-status--expired
                        svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                            path(d="M480-280q17 0 28.5-11.5T520-320q0-17-11.5-28.5T480-360q-17 0-28.5 11.5T440-320q0 17 11.5 28.5T480-280Zm-40-160h80v-240h-80v240Zm40 360q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                        .sub-status__body
                            strong Abonnement expiré
                            span Réactivez votre abonnement pour retrouver toutes vos fonctionnalités.
                else
                    .sub-status.sub-status--inactive
                        svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                            path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                        .sub-status__body
                            strong Aucun abonnement actif
                            span Passez à un plan payant pour débloquer toutes les fonctionnalités.
            .info-card__actions
                a.sm-btn.sm-btn--ghost(href="/subscription") Gérer mon abonnement

        //- ── Moyens de paiement ──────────────────────────────────────────────
        .info-card
            .info-card__header
                h3 Moyens de paiement
                p.info-card__desc Vos cartes bancaires enregistrées pour le paiement de votre abonnement.
            if paymentMethods && paymentMethods.length > 0
                .pm-list
                    each pm in paymentMethods
                        .pm-item(data-pmid=pm.id class=pm.isDefault ? 'pm-item--default' : '')
                            .pm-item__icon(class='pm-brand--' + pm.brand)
                                = pm.brand.charAt(0).toUpperCase() + pm.brand.slice(1)
                            .pm-item__info
                                span.pm-item__number •••• #{pm.last4}
                                span.pm-item__expiry Expire #{String(pm.expMonth).padStart(2,'0')}/#{String(pm.expYear).slice(-2)}
                            .pm-item__actions
                                if pm.isDefault
                                    span.pm-badge--default
                                        svg(xmlns="http://www.w3.org/2000/svg" height="11px" viewBox="0 -960 960 960" width="11px" fill="currentColor")
                                            path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm-56-240 226-226-57-57-169 169-85-85-57 57 142 142Z")
                                        | Par défaut
                                else
                                    button.pm-btn--set-default(type="button" data-pmid=pm.id) Définir par défaut
                                button.pm-item__del(type="button" data-pmid=pm.id title="Supprimer")
                                    svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                        path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
            else
                p.pm-empty Aucune carte enregistrée.
            .pm-add-wrap
                button.sm-btn.sm-btn--ghost#pmAddBtn(type="button")
                    svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                        path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                    span Ajouter une carte
            .pm-form-wrap#pmFormWrap(style="display:none")
                .pm-form
                    p.pm-form__label Informations de carte
                    #pm-card-element.pm-card-input
                    .pm-form__error#pmCardError
                    .pm-form__actions
                        button.sm-btn.sm-btn--primary#pmConfirmBtn(type="button")
                            span Confirmer
                        button.sm-btn.sm-btn--ghost#pmCancelBtn(type="button") Annuler

        //- ── Historique de paiement ──────────────────────────────────────────
        .info-card
            .info-card__header
                h3 Historique de paiement
                p.info-card__desc Toutes vos factures et paiements passés.
            if invoices && invoices.length > 0
                .inv-table
                    .inv-table__head
                        span Date
                        span Description
                        span Montant
                        span Statut
                        span
                    each inv in invoices
                        -
                            var d = new Date(inv.date * 1000)
                            var dateStr = d.toLocaleDateString('fr-FR', {day:'2-digit', month:'short', year:'numeric'})
                            var statusClass = inv.status === 'paid' ? 'inv-badge--paid' : inv.status === 'open' ? 'inv-badge--open' : 'inv-badge--other'
                            var statusLabel = inv.status === 'paid' ? 'Payé' : inv.status === 'open' ? 'En attente' : inv.status === 'void' ? 'Annulé' : inv.status
                        .inv-row
                            span.inv-row__date= dateStr
                            span.inv-row__desc= inv.description
                            span.inv-row__amount #{inv.amount} #{inv.currency}
                            span
                                span.inv-badge(class=statusClass)= statusLabel
                            span.inv-row__actions
                                if inv.pdfUrl
                                    a.inv-dl-btn(href=inv.pdfUrl target="_blank" rel="noopener" title="Télécharger la facture")
                                        svg(xmlns="http://www.w3.org/2000/svg" height="15px" viewBox="0 -960 960 960" width="15px" fill="currentColor")
                                            path(d="M480-320 280-520l56-58 104 104v-326h80v326l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z")
                                        span PDF
            else
                p.pm-empty Aucun historique de paiement.

        //- ── Authentification à deux facteurs ────────────────────────────────
        .info-card
            .info-card__header
                h3 Authentification à deux facteurs
                p.info-card__desc Protégez votre compte avec Google Authenticator. Une fois activée, un code sera demandé à chaque connexion.

            .settings-2fa

                if twoFAEnabled
                    .twofa-status.twofa-status--on
                        svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round")
                            path(d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z")
                        span 2FA activée — votre compte est protégé

                    .twofa-disable
                        p.twofa-hint Entrez votre code Google Authenticator pour désactiver la protection.
                        .twofa-row
                            .twofa-code-wrap
                                svg.twofa-code-icon(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                    path(d="M80-200v-80h400v80H80Zm0-200v-80h200v80H80Zm0-200v-80h200v80H80Zm736 400L670-336q-22 14-47.5 21t-52.5 7q-75 0-127.5-52.5T390-488q0-75 52.5-127.5T570-668q75 0 127.5 52.5T750-488q0 27-7 52.5T722-388l146 146-52 52ZM570-390q42 0 71-29t29-71q0-42-29-71t-71-29q-42 0-71 29t-29 71q0 42 29 71t71 29Z")
                                input#disableCode.twofa-code-input(
                                    type="tel"
                                    placeholder="123 456"
                                    maxlength="7"
                                    inputmode="numeric"
                                    autocomplete="one-time-code"
                                    pattern="[0-9 ]*"
                                )
                            button.sm-btn.sm-btn--danger#disable2FABtn(type="button") Désactiver
                        .twofa-feedback#disableFeedback

                else
                    .twofa-status.twofa-status--off
                        svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round")
                            path(d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z")
                        span 2FA désactivée

                    .twofa-setup#twoFASetup

                        .twofa-step#step1
                            button.sm-btn.sm-btn--primary#start2FABtn(type="button")
                                svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                                    path(d="M12 5v14M5 12h14")
                                span Configurer la 2FA

                        .twofa-step(id="step2" style="display:none")
                            .twofa-qr-block
                                p.twofa-hint
                                    | 1. Ouvrez&nbsp;
                                    strong Google Authenticator
                                    |  sur votre téléphone
                                p.twofa-hint 2. Scannez ce QR code
                                .twofa-qr-wrap
                                    img#twoFAQR(src="" alt="QR Code 2FA" width="180" height="180")
                                p.twofa-hint.twofa-hint--small Ou entrez ce code manuellement :
                                code.twofa-secret#twoFASecret
                            p.twofa-hint 3. Entrez le code à 6 chiffres affiché dans l'application
                            .twofa-row
                                .twofa-code-wrap
                                    svg.twofa-code-icon(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                        path(d="M80-200v-80h400v80H80Zm0-200v-80h200v80H80Zm0-200v-80h200v80H80Zm736 400L670-336q-22 14-47.5 21t-52.5 7q-75 0-127.5-52.5T390-488q0-75 52.5-127.5T570-668q75 0 127.5 52.5T750-488q0 27-7 52.5T722-388l146 146-52 52ZM570-390q42 0 71-29t29-71q0-42-29-71t-71-29q-42 0-71 29t-29 71q0 42 29 71t71 29Z")
                                    input#enableCode.twofa-code-input(
                                        type="tel"
                                        placeholder="123 456"
                                        maxlength="7"
                                        inputmode="numeric"
                                        autocomplete="one-time-code"
                                        pattern="[0-9 ]*"
                                    )
                                button.sm-btn.sm-btn--primary#enable2FABtn(type="button") Activer
                            .twofa-feedback#enableFeedback

        //- ── Langue principale ───────────────────────────────────────────────
        .info-card#prepaymentCard
            .info-card__header
                h3 Modes de paiement
                p.info-card__desc Choisissez les modes de paiement que vous proposez à vos clients.

            -
                var scStatus   = (stripeConnect && stripeConnect.status) || 'not_connected'
                var scEmail    = (stripeConnect && stripeConnect.accountEmail) || ''
                var scId       = (stripeConnect && stripeConnect.accountId) || ''
                var scIsActive = scStatus === 'active'
                var prepayOn   = !!(currentCompany && currentCompany.prepayment && currentCompany.prepayment.enabled)
                var prepayReq  = !!(currentCompany && currentCompany.prepayment && currentCompany.prepayment.required)

            //- Banners connect/error (s'affichent si on revient de l'OAuth)
            if stripeConnectSuccess
                .sc-success-banner(style="margin-bottom:16px")
                    svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5")
                        polyline(points="20 6 9 17 4 12")
                    | Compte Stripe connecté avec succès !
            if stripeConnectError === 'incomplete'
                .sc-error-banner(style="margin-bottom:16px;background:#fffbeb;border-color:#fbbf24;color:#92400e")
                    svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                        circle(cx="12" cy="12" r="10")
                        line(x1="12" y1="8" x2="12" y2="12")
                        line(x1="12" y1="16" x2="12.01" y2="16")
                    | Configuration Stripe incomplète — veuillez terminer l'activation pour recevoir des paiements.
            else if stripeConnectError
                .sc-error-banner(style="margin-bottom:16px")
                    svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                        circle(cx="12" cy="12" r="10")
                        line(x1="12" y1="8" x2="12" y2="12")
                        line(x1="12" y1="16" x2="12.01" y2="16")
                    | Erreur Stripe : #{stripeConnectError}

            .pm-methods-grid

                //- ── 1. Paiement en ligne à l'avance ─────────────────────────
                .pm-method-expandable(class=(prepayOn ? 'is-open' : ''))
                    label.pm-method-row.pm-method-row--top
                        input#prepayEnabled(
                            type="checkbox"
                            checked=prepayOn
                        )
                        .pm-method-info
                            span.pm-method-icon 💻
                            div
                                span.pm-method-label Paiement en ligne à l'avance
                                span.pm-method-sub Le client paie par carte lors de la réservation

                    //- Sous-section Stripe (visible si coché)
                    .pm-method-expand-body#stripeExpandBody(style=(!prepayOn ? 'display:none' : ''))

                        //- Stripe Connect
                        .sc-connect-inner
                            if scIsActive
                                .sc-connected-row
                                    .sc-connected-badge
                                        svg(width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5")
                                            polyline(points="20 6 9 17 4 12")
                                        | Stripe connecté
                                    .sc-connected-info
                                        span.sc-connected-email= scEmail || scId
                                        span.sc-connected-id= scId
                                    button.sm-btn.sm-btn--ghost.sm-btn--sm#disconnectStripeBtn(
                                        type="button"
                                        data-confirm="Déconnecter votre compte Stripe ? Les paiements en ligne seront désactivés."
                                    ) Déconnecter
                            else if scStatus === 'pending'
                                .sc-not-connected-inline
                                    p.sc-not-connected-desc
                                        | Votre compte Stripe est en cours de configuration.
                                        br
                                        | Cliquez sur le bouton ci-dessous pour continuer l'activation.
                                    a.sm-btn.sm-btn--primary.sm-btn--sm(href="/settings/stripe-connect") Continuer la configuration →
                                    span(style="display:block;font-size:11px;color:var(--muted,#6b7280);margin-top:8px") Vous serez redirigé vers Stripe, puis revenus ici automatiquement.

                            else
                                .sc-not-connected-inline
                                    p.sc-not-connected-desc
                                        | Connectez votre compte Stripe pour recevoir les paiements directement sur votre compte bancaire.
                                        br
                                        | L'inscription prend 2 minutes — Stripe s'occupe de tout.
                                    a.sm-btn.sm-btn--primary.sm-btn--sm(href="/settings/stripe-connect")
                                        svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:6px;vertical-align:-2px")
                                            path(d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71")
                                            path(d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71")
                                        | Connecter mon compte Stripe
                                    span(style="display:block;font-size:11px;color:var(--muted,#6b7280);margin-top:8px") Vous serez redirigé vers Stripe, puis revenus ici automatiquement.

                        //- Toggle obligatoire
                        .prepayment-toggle-row.prepayment-toggle-row--sub(
                            id="prepayRequiredRow"
                            style=(!scIsActive ? 'opacity:.45;pointer-events:none' : '')
                        )
                            .prepayment-toggle-info
                                span.prepayment-toggle-label Rendre le paiement obligatoire
                                span.prepayment-toggle-sub Si désactivé, le client peut choisir de payer plus tard
                            label.sa-toggle-wrap
                                input#prepayRequired(
                                    type="checkbox"
                                    checked=prepayReq
                                    disabled=(!scIsActive)
                                )
                                .sa-toggle-track

                        //- Politique annulation
                        .prepayment-policy-box.prepayment-policy-box--sm
                            svg(width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                circle(cx="12" cy="12" r="10")
                                polyline(points="12 6 12 12 16 14")
                            div
                                strong Politique d'annulation automatique
                                ul
                                    li Annulation #[strong > 24h] — remboursement complet
                                    li Annulation #[strong < 24h] — 50 % prélevés
                                    li Absence sans annulation — 100 % prélevés

                //- ── 2. Espèces ──────────────────────────────────────────────
                label.pm-method-row
                    input#pmCash(
                        type="checkbox"
                        checked=(acceptedPayments && acceptedPayments.cash)
                    )
                    .pm-method-info
                        span.pm-method-icon 💵
                        div
                            span.pm-method-label Espèces
                            span.pm-method-sub Paiement en liquide sur place

                //- ── 3. Carte bancaire sur place ─────────────────────────────
                label.pm-method-row
                    input#pmCardOnSite(
                        type="checkbox"
                        checked=(acceptedPayments && acceptedPayments.cardOnSite)
                    )
                    .pm-method-info
                        span.pm-method-icon 💳
                        div
                            span.pm-method-label Carte bancaire sur place
                            span.pm-method-sub Terminal de paiement (TPE)

                //- ── 4. Virement IBAN ────────────────────────────────────────
                .pm-method-expandable(class=(acceptedPayments && acceptedPayments.bankTransfer && acceptedPayments.bankTransfer.enabled ? 'is-open' : ''))
                    label.pm-method-row.pm-method-row--top
                        input#pmBankTransfer(
                            type="checkbox"
                            checked=(acceptedPayments && acceptedPayments.bankTransfer && acceptedPayments.bankTransfer.enabled)
                        )
                        .pm-method-info
                            span.pm-method-icon 🏦
                            div
                                span.pm-method-label Virement bancaire (IBAN)
                                span.pm-method-sub Les coordonnées s'afficheront au client

                    .pm-method-expand-body#pmBankDetails(style=(!(acceptedPayments && acceptedPayments.bankTransfer && acceptedPayments.bankTransfer.enabled) ? 'display:none' : ''))
                        .pm-iban-grid
                            .field
                                label.bk-label IBAN
                                input.input#pmIban(
                                    type="text"
                                    placeholder="BE XX XXXX XXXX XXXX"
                                    value=(acceptedPayments && acceptedPayments.bankTransfer ? acceptedPayments.bankTransfer.iban : '')
                                )
                            .field
                                label.bk-label BIC / SWIFT
                                input.input#pmBic(
                                    type="text"
                                    placeholder="GEBABEBB"
                                    value=(acceptedPayments && acceptedPayments.bankTransfer ? acceptedPayments.bankTransfer.bic : '')
                                )
                            .field
                                label.bk-label Nom de la banque
                                input.input#pmBankName(
                                    type="text"
                                    placeholder="BNP Paribas, ING…"
                                    value=(acceptedPayments && acceptedPayments.bankTransfer ? acceptedPayments.bankTransfer.bankName : '')
                                )
                            .field
                                label.bk-label Instructions (optionnel)
                                input.input#pmBankNote(
                                    type="text"
                                    placeholder="Mentionner votre nom en communication"
                                    value=(acceptedPayments && acceptedPayments.bankTransfer ? acceptedPayments.bankTransfer.note : '')
                                )

                //- ── 5. PayPal ───────────────────────────────────────────────
                - var ppEnabled = !!(acceptedPayments && acceptedPayments.paypal && acceptedPayments.paypal.enabled)
                - var ppMe = (acceptedPayments && acceptedPayments.paypal) ? (acceptedPayments.paypal.paypalMe || '') : ''
                .pm-method-expandable(class=(ppEnabled ? 'is-open' : ''))
                    label.pm-method-row.pm-method-row--top
                        input#pmPaypal(
                            type="checkbox"
                            checked=ppEnabled
                        )
                        .pm-method-info
                            span.pm-method-icon 🅿️
                            div
                                span.pm-method-label PayPal
                                span.pm-method-sub Envoi d'un lien PayPal.me au client

                    .pm-method-expand-body#pmPaypalDetails(style=(!ppEnabled ? 'display:none' : ''))
                        .pm-iban-grid
                            .field
                                label.bk-label Nom d'utilisateur PayPal.me
                                .sc-manual-form
                                    span.sc-manual-prefix paypal.me/
                                    input.input#pmPaypalMe(
                                        type="text"
                                        placeholder="votre-nom"
                                        autocomplete="off"
                                        value=ppMe
                                    )
                            .field
                                label.bk-label Aperçu du lien
                                p.pm-paypal-preview(id="pmPaypalPreview" style="font-size:12px;color:var(--muted,#6b7280);margin:4px 0 0")
                                    = ppMe ? 'https://paypal.me/' + ppMe + '/{montant}' : 'https://paypal.me/votre-nom/{montant}'

            p#prepayFeedback(style="display:none;font-size:13px;color:var(--accent);margin-top:14px") ✓ Paramètres sauvegardés

        //- ── Politique d'annulation ──────────────────────────────────────────
        .info-card
            .info-card__header
                h3 Politique d'annulation
                p.info-card__desc Définissez les frais appliqués si un client annule tardivement.

            -
                var cancelRule = (currentCompany && currentCompany.cancellationPolicy && currentCompany.cancellationPolicy.rule) || 'free'

            .cancel-policy-options
                label.cancel-policy-opt(class=(cancelRule === 'free' ? 'is-selected' : ''))
                    input(type="radio" name="cancelRule" value="free" checked=(cancelRule === 'free'))
                    .cancel-policy-opt__icon
                        svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            polyline(points="20 6 9 17 4 12")
                    .cancel-policy-opt__body
                        strong Annulation gratuite
                        span Aucun frais, quelle que soit l'heure d'annulation.

                label.cancel-policy-opt(class=(cancelRule === 'half_24h' ? 'is-selected' : ''))
                    input(type="radio" name="cancelRule" value="half_24h" checked=(cancelRule === 'half_24h'))
                    .cancel-policy-opt__icon
                        svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            circle(cx="12" cy="12" r="10")
                            polyline(points="12 6 12 12 16 14")
                    .cancel-policy-opt__body
                        strong 50 % si annulation &lt; 24h
                        span Le client paie la moitié s'il annule moins de 24h avant le RDV.

                label.cancel-policy-opt(class=(cancelRule === 'full_12h' ? 'is-selected' : ''))
                    input(type="radio" name="cancelRule" value="full_12h" checked=(cancelRule === 'full_12h'))
                    .cancel-policy-opt__icon
                        svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            path(d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z")
                            line(x1="12" y1="9" x2="12" y2="13")
                            line(x1="12" y1="17" x2="12.01" y2="17")
                    .cancel-policy-opt__body
                        strong 100 % si &lt; 12h · 50 % si &lt; 24h
                        span Frais progressifs selon le délai d'annulation.

            p#cancelPolicyFeedback(style="display:none;font-size:13px;color:var(--accent);margin-top:12px") ✓ Politique sauvegardée

        .info-card
            .info-card__header
                h3 Langue principale
                p.info-card__desc Choisissez la langue de votre interface d'administration.

            .lang-grid
                - const langs = [{code:'fr',label:'Français',flag:'🇫🇷'},{code:'en',label:'English',flag:'🇬🇧'},{code:'nl',label:'Nederlands',flag:'🇳🇱'},{code:'de',label:'Deutsch',flag:'🇩🇪'},{code:'es',label:'Español',flag:'🇪🇸'},{code:'it',label:'Italiano',flag:'🇮🇹'}]
                each l in langs
                    button.lang-btn(
                        type="button"
                        data-lang=l.code
                        class=(currentLang === l.code ? 'lang-btn--active' : '')
