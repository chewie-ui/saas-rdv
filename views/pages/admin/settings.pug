                        .pm-method-expand-body#pmPaypalDetails(style=(!ppEnabled ? 'display:none' : ''))
                            .pm-iban-grid
                                .field
                                    label.bk-label= t.settings.pm_paypal_username
                                    .sc-manual-form
                                        span.sc-manual-prefix paypal.me/
                                        input.input#pmPaypalMe(
                                            type="text"
                                            placeholder=t.js.paypal_placeholder_name
                                            autocomplete="off"
                                            value=ppMe
                                        )
                                .field
                                    label.bk-label= t.settings.pm_paypal_preview_label
                                    p.pm-paypal-preview(id="pmPaypalPreview" style="font-size:12px;color:var(--muted,#6b7280);margin:4px 0 0")
                                        = ppMe ? 'https://paypal.me/' + ppMe + '/{' + t.js.paypal_placeholder_amount + '}' : 'https://paypal.me/' + t.js.paypal_placeholder_name + '/{' + t.js.paypal_placeholder_amount + '}'

                    //- ── 6. QR code ──────────────────────────────────────────────
                    - var qrEnabled = !!(acceptedPayments && acceptedPayments.qrCode && acceptedPayments.qrCode.enabled)
                    - var qrImage = (acceptedPayments && acceptedPayments.qrCode) ? (acceptedPayments.qrCode.imageUrl || '') : ''
                    - var qrNote = (acceptedPayments && acceptedPayments.qrCode) ? (acceptedPayments.qrCode.note || '') : ''
                    .pm-method-expandable(class=(qrEnabled ? 'is-open' : ''))
                        label.pm-method-row.pm-method-row--top
                            input#pmQrCode(
                                type="checkbox"
                                checked=qrEnabled
