        // ── Pause / réactivation de l'établissement ─────────────────────────
        (function() {
            var btn = document.getElementById('toggleCompanyPauseBtn');
            if (!btn) return;

            btn.addEventListener('click', async function() {
                var isPaused = btn.dataset.paused === '1';
                var confirmed = await window.confirmModal(
                    isPaused ? !{JSON.stringify(t.profile.resume_confirm_title)} : !{JSON.stringify(t.profile.pause_confirm_title)},
                    isPaused ? !{JSON.stringify(t.profile.resume_confirm_desc)} : !{JSON.stringify(t.profile.pause_confirm_desc)},
                    {
                        confirmLabel: isPaused ? !{JSON.stringify(t.profile.resume_confirm_btn)} : !{JSON.stringify(t.profile.pause_confirm_btn)},
                        danger: !isPaused,
                        // Icône cohérente avec l'action (et non la corbeille par défaut)
                        icon: isPaused ? 'play_circle' : 'pause_circle',
                    }
                );
                if (!confirmed) return;

                btn.disabled = true;
                try {
                    var res = await fetch(isPaused ? '/account/company-resume' : '/account/company-pause', { method: 'PATCH' });
                    var data = await res.json();
                    if (data.success) {
                        window.location.reload();
                    } else {
                        await window.alertModal(data.error || !{JSON.stringify(t.profile.pause_error)});
                        btn.disabled = false;
                    }
                } catch (e) {
                    await window.alertModal(!{JSON.stringify(t.profile.pause_error)});
                    btn.disabled = false;
                }
            });
        })();
