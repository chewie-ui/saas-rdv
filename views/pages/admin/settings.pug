                                    circle(cx="12" cy="12" r="10")
                                    polyline(points="12 6 12 12 16 14")
                                div
                                    strong= t.settings.cp_auto_title
                                    ul
                                        li= t.settings.cp_rule_gt24
                                        li= t.settings.cp_rule_lt24
                                        li= t.settings.cp_rule_noshow

                    //- ── 2. Espèces ──────────────────────────────────────────────
                    label.pm-method-row
                        input#pmCash(
                            type="checkbox"
                            checked=(acceptedPayments && acceptedPayments.cash)
                        )
                        .pm-method-info
                            span.pm-method-icon 💵
                            div
                                span.pm-method-label= t.settings.pm_cash_label
                                span.pm-method-sub= t.settings.pm_cash_sub

                    //- ── 3. Carte bancaire sur place ─────────────────────────────
                    label.pm-method-row
                        input#pmCardOnSite(
                            type="checkbox"
                            checked=(acceptedPayments && acceptedPayments.cardOnSite)
                        )
                        .pm-method-info
                            span.pm-method-icon 💳
                            div
                                span.pm-method-label= t.settings.pm_card_onsite_label
                                span.pm-method-sub= t.settings.pm_card_onsite_sub

                    //- ── 4. Virement IBAN ────────────────────────────────────────
                    .pm-method-expandable(class=(acceptedPayments && acceptedPayments.bankTransfer && acceptedPayments.bankTransfer.enabled ? 'is-open' : ''))
                        label.pm-method-row.pm-method-row--top
                            input#pmBankTransfer(
                                type="checkbox"
                                checked=(acceptedPayments && acceptedPayments.bankTransfer && acceptedPayments.bankTransfer.enabled)
                            )
