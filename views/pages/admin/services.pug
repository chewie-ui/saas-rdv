extends ../../layouts/admin

block links
    //- On réutilise le CSS de « Clients » pour la barre d'outils + l'état vide
    //- (rendu identique demandé), le CSS de l'ancienne page pour la modale riche
    //- (palette de couleurs, image, catégories) + un petit CSS propre au tableau.
    link(rel="stylesheet" href="/css/layouts/clients-hub.css")
    link(rel="stylesheet" href="/css/layouts/services.css")
    link(rel="stylesheet" href="/css/layouts/services-v2.css")

block content
    - var _count = (services && services.length) || 0
    - var _max = (typeof maxServices !== 'undefined' && maxServices !== null) ? maxServices : Infinity
    - var _atLimit = (_max === 0) || (isFinite(_max) && _count >= _max)
    -
        // Sérialisation JSON sûre pour <script> inline (échappe </script>, &, U+2028/2029).
        function safeJson(o) { var BS = String.fromCharCode(92); return JSON.stringify(o).replace(new RegExp('[<>&' + String.fromCharCode(0x2028) + String.fromCharCode(0x2029) + ']', 'g'), function (c) { return BS + 'u' + ('000' + c.charCodeAt(0).toString(16)).slice(-4); }); }
        // Données complètes de chaque service, pour pré-remplir la modale d'édition
        // directement sur cette page (aucune redirection vers l'ancienne page).
        var SVC_MAP = {};
        (services || []).forEach(function (s) {
            var sess = (s.sessions || []).map(function (ss) {
                var iso = '';
                try { iso = new Date(ss.date).toISOString().slice(0, 10); } catch (e) {}
                return { date: iso, startTime: ss.startTime || '', endTime: ss.endTime || '' };
            });
            var rules = (s.questionRules || []).map(function (r) {
                return { questionId: String(r.questionId || ''), optionIds: (r.optionIds || []).map(String) };
            });
            SVC_MAP[String(s._id)] = {
                name: s.name || '', description: s.description || '', category: s.category || '',
                price: (s.price !== null && s.price !== undefined) ? s.price : '',
                duration: s.duration || 30, durationMax: s.durationMax || '',
                color: s.color || '#1e7a4e', type: s.type || 'individual',
                capacity: s.capacity || '', active: !!s.active, location: s.location || '',
                image: s.image || '',
                employees: (s.employees || []).map(function (e) { return String(e._id || e); }),
                fee: s.cancellationFee || { enabled: false, type: 'percent', value: '' },
                recurring: s.recurring || { enabled: false, weekdays: [], startTime: '' },
                blocksIndividualBookings: s.blocksIndividualBookings !== false,
                sessions: sess,
                questionRules: rules
            };
        });
        // Questionnaire (questions + réponses avec leurs _id) pour le ciblage.
        var QUESTIONNAIRE = { enabled: !!(questionnaire && questionnaire.enabled), questions: [] };
        ((questionnaire && questionnaire.questions) || []).forEach(function (q) {
            if (!q._id) return; // sans _id stable (question migrée non enregistrée) → pas de ciblage
            QUESTIONNAIRE.questions.push({
                id: String(q._id), question: q.question || '',
                options: (q.options || []).filter(function (o) { return o._id; }).map(function (o) {
                    return { id: String(o._id), label: o.label || '' };
                })
            });
        });
        // Colonnes masquées par l'utilisateur (préférence persistée) — rendu direct.
        var _hiddenCols = (typeof hiddenCols !== 'undefined' && Array.isArray(hiddenCols)) ? hiddenCols : [];
        function _hid(c) { return _hiddenCols.indexOf(c) >= 0; }
    .ch-page
        .ch-head
            span.ch-count #{_count} #{_count > 1 ? 'services' : 'service'}
            if isFinite(_max) && _max > 0
                span.sv2-plan(class=(_atLimit ? 'is-full' : '')) #{_count} / #{_max}

        //- ── Limite du plan atteinte ─────────────────────────────────
        if _atLimit
            .sv2-limit
                span.material-symbols-outlined info
                if _max === 0
                    span Votre plan ne permet pas de créer des services. Passez à un plan supérieur pour en ajouter.
                else
                    span Limite de votre plan atteinte (#{_max} services). Passez à un plan supérieur pour en ajouter davantage.

        - var _q = questionnaire || { enabled: false, questions: [] }

        //- ── Onglets Services / Questionnaire ────────────────────────
        //- Les blocs ci-dessous restent des frères (pas de conteneur par
        //- onglet) : on les marque avec `data-tab` et le JS bascule leur
        //- affichage. Ça évite de ré-indenter tout le tableau des services.
        .ds-tabs(role="tablist")
            button.ds-tab.is-active(type="button" data-svtab="services") Services
            button.ds-tab(type="button" data-svtab="questionnaire") Questionnaire

        //- ── Questionnaire de réservation (multi-questions) ──────────
        .sq-block(class=(_q.enabled ? '' : 'is-off') data-tab="questionnaire")
            .sq-head
                .sq-head__l
                    span.sq-head__ic.material-symbols-outlined quiz
                    div
                        .sq-title Questionnaire de réservation
                        .sq-sub Posez une ou plusieurs questions au client avant qu'il choisisse. Ensuite, ouvrez un service (bouton #[b Modifier]) puis, dans #[b « Afficher ce service pour »], choisissez les réponses qui lui correspondent (ex : « Femme »). « Tous » = visible quelle que soit la réponse.
                label.sq-switch
                    input#sqEnabled(type="checkbox" checked=_q.enabled)
                    span.sq-switch__track
            .sq-body
                .sq-list#sqList
                    each q in (_q.questions || [])
                        .sq-question(data-qid=(q._id || ''))
                            .sq-question__hd
                                input.sq-qinput(type="text" value=q.question placeholder="Votre question… (ex : Êtes-vous déjà venu ?)")
                                button.sq-qdel(type="button" title="Supprimer la question")
                                    span.material-symbols-outlined delete
                            .sq-options
                                each o in (q.options || [])
                                    .sq-optrow(data-oid=(o._id || ''))
                                        input.sq-optinput(type="text" value=o.label placeholder="Réponse…")
                                        button.sq-optdel(type="button" title="Retirer cette réponse")
                                            span.material-symbols-outlined close
                                button.sq-addopt-btn(type="button")
                                    span.material-symbols-outlined add
                                    | Ajouter une réponse
                button.sq-addq#sqAddQ(type="button")
                    span.material-symbols-outlined add
                    | Ajouter une question
                //- Avertissement : réponses qui ne mènent à aucun service actif.
                .sq-warn#sqWarn(hidden)
                .sq-foot
                    span.sq-saveind#sqSaveInd
                    button.sm-btn.sm-btn--primary#sqSave(type="button") Enregistrer le questionnaire

            //- Gabarits clonés par le JS. Une nouvelle question part avec 2 réponses vides.
            template#sqQTpl
                .sq-question(data-qid="")
                    .sq-question__hd
                        input.sq-qinput(type="text" placeholder="Votre question… (ex : Êtes-vous déjà venu ?)")
                        button.sq-qdel(type="button" title="Supprimer la question")
                            span.material-symbols-outlined delete
                    .sq-options
                        .sq-optrow(data-oid="")
                            input.sq-optinput(type="text" placeholder="Réponse…")
                            button.sq-optdel(type="button" title="Retirer cette réponse")
                                span.material-symbols-outlined close
                        .sq-optrow(data-oid="")
                            input.sq-optinput(type="text" placeholder="Réponse…")
                            button.sq-optdel(type="button" title="Retirer cette réponse")
                                span.material-symbols-outlined close
                        button.sq-addopt-btn(type="button")
                            span.material-symbols-outlined add
                            | Ajouter une réponse
            template#sqOptTpl
                .sq-optrow(data-oid="")
                    input.sq-optinput(type="text" placeholder="Réponse…")
                    button.sq-optdel(type="button" title="Retirer cette réponse")
                        span.material-symbols-outlined close

        //- ── Barre d'outils (façon Clients / image de réf.) ──────────
        .ch-toolbar-wrap(data-tab="services")
            .ch-toolbar
                .ch-search
                    span.ch-search__icon.material-symbols-outlined search
                    input#sv2Search.ch-search__input(type="text" placeholder="Rechercher un service…" autocomplete="off")
                .ch-toolbar__actions
                    //- Affichage : colonnes visibles
                    .ch-dd
                        button.ch-tbtn#sv2DispBtn(type="button")
                            span.material-symbols-outlined(style="font-size:18px") grid_view
                            span Affichage
                            span.material-symbols-outlined.ch-tbtn__caret(style="font-size:18px") expand_more
                        .ch-dd__menu#sv2DispMenu(hidden)
                            .ch-dd__label Colonnes affichées
                            label.ch-dd__check
                                input(type="checkbox" data-col="type" checked=!_hid('type'))
                                span Type
                            label.ch-dd__check
                                input(type="checkbox" data-col="emp" checked=!_hid('emp'))
                                span Employé autorisé
                            label.ch-dd__check
                                input(type="checkbox" data-col="dur" checked=!_hid('dur'))
                                span Durée
                            label.ch-dd__check
                                input(type="checkbox" data-col="price" checked=!_hid('price'))
                                span Prix
                            label.ch-dd__check
                                input(type="checkbox" data-col="status" checked=!_hid('status'))
                                span Statut
                    //- Trier
                    .ch-dd
                        button.ch-tbtn#sv2SortBtn(type="button")
                            span.material-symbols-outlined(style="font-size:18px") swap_vert
                            span Trier
                            span.material-symbols-outlined.ch-tbtn__caret(style="font-size:18px") expand_more
                        .ch-dd__menu#sv2SortMenu(hidden)
                            button.ch-dd__opt.is-active(type="button" data-sort="default") Ordre par défaut
                            button.ch-dd__opt(type="button" data-sort="name-asc") Nom (A → Z)
                            button.ch-dd__opt(type="button" data-sort="name-desc") Nom (Z → A)
                            button.ch-dd__opt(type="button" data-sort="price-asc") Prix (croissant)
                            button.ch-dd__opt(type="button" data-sort="price-desc") Prix (décroissant)
                            button.ch-dd__opt(type="button" data-sort="dur-asc") Durée (courte → longue)
                            button.ch-dd__opt(type="button" data-sort="dur-desc") Durée (longue → courte)
                    //- Filtres
                    .ch-dd
                        button.ch-tbtn#sv2FilterBtn(type="button")
                            span.material-symbols-outlined(style="font-size:18px") filter_list
                            span Filtres
                            span.ch-tbtn__badge#sv2FilterBadge(hidden)
                        .ch-dd__menu#sv2FilterMenu(hidden)
                            .ch-dd__label Type
                            label.ch-dd__check
                                input(type="checkbox" data-ftype="service" checked)
                                span Service
                            label.ch-dd__check
                                input(type="checkbox" data-ftype="group" checked)
                                span Cours collectif
                            .ch-dd__label Statut
                            label.ch-dd__check
                                input(type="checkbox" data-fstatus="active" checked)
                                span Actif
                            label.ch-dd__check
                                input(type="checkbox" data-fstatus="inactive" checked)
                                span Inactif
                    .sv2-newwrap
                        button.sm-btn.sm-btn--primary#sv2NewBtn(type="button" disabled=_atLimit title=(_atLimit ? 'Limite de votre plan atteinte' : ''))
                            span.material-symbols-outlined(style="font-size:18px") add
                            span Nouveau
                            span.material-symbols-outlined(style="font-size:18px") expand_more
                        .sv2-newmenu#sv2NewMenu(hidden)
                            button.sv2-newmenu__item(type="button" data-new="service")
                                span.sv2-newmenu__ic.material-symbols-outlined sell
                                span
                                    span.sv2-newmenu__t Service
                                    span.sv2-newmenu__d Prestation individuelle
                            button.sv2-newmenu__item(type="button" data-new="course")
                                span.sv2-newmenu__ic.material-symbols-outlined groups
                                span
                                    span.sv2-newmenu__t Cours collectif
                                    span.sv2-newmenu__d Plusieurs participants, récurrent ou par dates
                            button.sv2-newmenu__item(type="button" data-new="category")
                                span.sv2-newmenu__ic.material-symbols-outlined folder
                                span
                                    span.sv2-newmenu__t Catégorie
                                    span.sv2-newmenu__d Regrouper vos services (ex : Corps, Tête)

        //- ── État vide (IDENTIQUE à la page Clients) ─────────────────
        if !services || services.length === 0
            .ch-empty(data-tab="services")
                span.ch-empty__icon.material-symbols-outlined design_services
                p.ch-empty__title Aucun service
                p.ch-empty__sub Ajoutez votre premier service pour commencer.
                a.sm-btn.sm-btn--primary(href="/services")
                    span.material-symbols-outlined(style="font-size:18px") add
                    span Ajouter un service
        else
            //- ── Tableau des services ────────────────────────────────
            .sv2-table-wrap(data-tab="services")
                table.sv2-table
                    thead
                        tr
                            th.sv2-th--name Service
                            th(data-col="type" style=(_hid('type') ? 'display:none' : null)) Type
                            th(data-col="emp" style=(_hid('emp') ? 'display:none' : null)) Employé autorisé
                            th(data-col="dur" style=(_hid('dur') ? 'display:none' : null)) Durée
                            th(data-col="price" style=(_hid('price') ? 'display:none' : null)) Prix
                            th(data-col="status" style=(_hid('status') ? 'display:none' : null)) Statut
                            th.sv2-th--act Actions
                    tbody#sv2Body
                        -
                            // Groupes = catégories de l'utilisateur, dans leur ordre
                            // (l'ordre du tableau calendarSettings.categories fait foi),
                            // + un groupe final « Sans catégorie » pour les services sans
                            // catégorie ou dont la catégorie a été supprimée.
                            var _groups = (categories || []).map(function (c) { return { name: c.name, icon: c.icon || '', items: [] }; });
                            var _none = { name: '', icon: '', items: [], isNone: true };
                            (services || []).forEach(function (s) {
                                var g = null;
                                for (var i = 0; i < _groups.length; i++) { if (_groups[i].name === s.category) { g = _groups[i]; break; } }
                                (g || _none).items.push(s);
                            });
                            var _allGroups = _groups.concat([_none]);
                        each grp in _allGroups
                            //- Les catégories vides restent affichées (zone de dépôt) ;
                            //- « Sans catégorie » n'apparaît que s'il contient des services.
                            if !grp.isNone || grp.items.length
                                tr.sv2-grouprow(data-cat=grp.name data-icon=grp.icon class=(grp.isNone ? 'sv2-grouprow--none' : ''))
                                    //- La cellule reste une vraie case de tableau (sinon le
                                    //- colspan est ignoré et le trait s'arrête à la 1re colonne) :
                                    //- c'est le div intérieur qui porte la mise en ligne.
                                    td.sv2-groupcell(colspan="7")
                                        .sv2-groupcell__in
                                            if !grp.isNone
                                                span.sv2-move(class="sv2-move--cat")
                                                            button.sv2-move__btn.js-move-up(type="button" title="Monter" aria-label="Monter")
                                                                span.material-symbols-outlined keyboard_arrow_up
                                                            button.sv2-move__btn.js-move-down(type="button" title="Descendre" aria-label="Descendre")
                                                                span.material-symbols-outlined keyboard_arrow_down
                                            else
                                                span.sv2-move.sv2-move--cat.sv2-move--ghost(aria-hidden="true")
                                            if grp.icon
                                                span.sv2-gicon= grp.icon
                                            span.sv2-gname= grp.isNone ? 'Sans catégorie' : grp.name
                                            span.sv2-gcount= grp.items.length
                            each svc in grp.items
                                - var _dur = svc.duration ? (svc.durationMax && svc.durationMax > svc.duration ? (svc.duration + '–' + svc.durationMax + ' min') : (svc.duration + ' min')) : '—'
                                tr.sv2-row(data-id=String(svc._id) data-cat=(svc.category || '') data-name=(svc.name || '').toLowerCase() data-type=(svc.type === 'group' ? 'group' : 'service') data-active=(svc.active ? '1' : '0') data-price=(svc.price !== null && svc.price !== undefined ? svc.price : '') data-dur=(svc.duration || 0) class=(!svc.active ? 'sv2-row--inactive' : ''))
                                    td.sv2-td--name
                                        span.sv2-move(class="")
                                            button.sv2-move__btn.js-move-up(type="button" title="Monter" aria-label="Monter")
                                                span.material-symbols-outlined keyboard_arrow_up
                                            button.sv2-move__btn.js-move-down(type="button" title="Descendre" aria-label="Descendre")
                                                span.material-symbols-outlined keyboard_arrow_down
                                        span.sv2-dot(style=`background:${svc.color || '#1e7a4e'}`)
                                        span.sv2-name= svc.name
                                        if svc.type === 'group'
                                            span.sv2-tag.sv2-tag--group #{svc.capacity} places
                                    td(data-col="type" style=(_hid('type') ? 'display:none' : null))
                                        if svc.type === 'group'
                                            span.sv2-type.sv2-type--group
                                                span.material-symbols-outlined groups
                                                | Cours collectif
                                        else
                                            span.sv2-type
                                                span.material-symbols-outlined sell
                                                | Service
                                    td(data-col="emp" style=(_hid('emp') ? 'display:none' : null))
                                        if svc.employees && svc.employees.length
                                            .sv2-emps
                                                each emp, i in svc.employees
                                                    if i < 5
                                                        - var _ini = (emp.fullName || '?').trim().split(/\s+/).map(function (w) { return w.charAt(0); }).slice(0, 2).join('').toUpperCase()
                                                        if emp.profilePicture
                                                            img.sv2-av(src=`/uploads/profiles/${emp.profilePicture}` alt=emp.fullName title=emp.fullName loading="lazy")
                                                        else
                                                            span.sv2-av.sv2-av--txt(title=emp.fullName)= _ini
                                                if svc.employees.length > 5
                                                    span.sv2-av.sv2-av--more +#{svc.employees.length - 5}
                                        else
                                            span.sv2-all Tous les employés
                                    td.sv2-td--dur(data-col="dur" style=(_hid('dur') ? 'display:none' : null))= _dur
                                    td.sv2-td--price(data-col="price" style=(_hid('price') ? 'display:none' : null))
                                        if svc.price !== null && svc.price !== undefined
                                            = svc.price + '€'
                                        else
                                            = '—'
                                    td(data-col="status" style=(_hid('status') ? 'display:none' : null))
                                        .sv2-statuscell
                                            label.sa-toggle.sv2-toggle(title="Activer / désactiver ce service")
                                                input.sv2-toggle-cb(type="checkbox" checked=svc.active data-id=String(svc._id))
                                                .sa-toggle__track
                                            span.sv2-status(class=svc.active ? 'is-on' : 'is-off')
                                                span.sv2-status__dot
                                                = svc.active ? 'Actif' : 'Inactif'
                                    td.sv2-td--act
                                        button.ds-ico.sv2-edit(type="button" title="Modifier" data-id=String(svc._id) data-type=(svc.type === 'group' ? 'group' : 'service'))
                                            span.material-symbols-outlined edit
                                        button.ds-ico.ds-ico--danger.sv2-del(type="button" title="Supprimer" data-id=String(svc._id) data-name=svc.name data-type=(svc.type || 'individual'))
                                            span.material-symbols-outlined delete
            .ch-empty.ch-empty--search#sv2NoResult(style="display:none")
                span.ch-empty__icon.material-symbols-outlined search_off
                p.ch-empty__title Aucun résultat
                p.ch-empty__sub Aucun service ne correspond à votre recherche.

    //- ══════════ Modale « Nouvelle catégorie » ══════════
    //- Créer une catégorie vide, sans passer par la création d'un service.
    .modal-overlay#catModalOverlay
    .service-modal.service-modal--sm#catModal
        .service-modal__header
            h3 Nouvelle catégorie
            button.modal-close#catModalClose(type="button")
                span.material-symbols-outlined close
        .service-modal__body
            .field
                label Nom de la catégorie
                input.input#catModalName(type="text" placeholder="Ex : Corps, Tête, Visage…" maxlength="40")
            .field
                label Icône #[span.xs-comment (optionnelle)]
                input(type="hidden" id="catModalIcon")
                .cat-icon-picker#catModalPicker
            p.sv2-cat-hint Créez la catégorie, puis glissez vos services dessous — ou choisissez-la dans la fiche d'un service.
        .service-modal__footer
            button.sm-btn#catModalCancel(type="button") Annuler
            button.sm-btn.sm-btn--primary#catModalSave(type="button") Créer la catégorie

    //- ══════════ Modale « Nouveau service » ══════════
    //- Modale « Service » riche (image, catégorie+emoji, palette de couleurs,
    //- ciblage par question, frais) — reprend l'ancienne, inline sur cette page.
    .modal-overlay#serviceModalOverlay
    .service-modal#serviceModal
        .service-modal__header
            h3#serviceModalTitle= t.services.modal_new
            button.modal-close#closeServiceModal(type="button")
                span.material-symbols-outlined close
        .service-modal__body
            input(type="hidden" id="serviceModalId")
            .service-modal__cols
                //- ── Colonne gauche : identité du service ────────────────────
                .service-modal__col
                    .field
                        label= t.services.service_name
                        input.input#serviceModalName(placeholder="Ex : Coupe simple, Massage détente…")
                    .field
                        label Image du service #[span.xs-comment= t.services.img_optional]
                        .svc-img-upload#svcImgUpload
                            img.svc-img-upload__preview#svcImgPreview(src="" alt="" style="display:none")
                            .svc-img-upload__placeholder#svcImgPlaceholder
                                span.material-symbols-outlined(style="font-size:28px;opacity:.35") image
                                p= t.services.img_click
                            input.svc-img-upload__input#svcImgInput(type="file" accept="image/*" style="display:none")
                            button.svc-img-upload__remove#svcImgRemove(type="button" style="display:none")= t.services.img_remove
                    .field
                        label= t.services.service_category
                        select.input#serviceModalCategory
                    #newCategorySection(style="display:none")
                        .field
                            label= t.services.new_category_name
                            input.input#newCategoryName(type="text" placeholder="Ex : Cheveux, Corps, Visage…")
                        .field
                            label= t.services.new_category_icon
                            input(type="hidden" id="newCategoryIconInput")
                            .cat-icon-picker#catIconPicker
                    .field
                        label= t.services.service_desc
                        textarea.textarea#serviceModalDesc(rows=3 placeholder="…")
                    .field-row
                        .field
                            label= t.services.service_price
                            input.input#serviceModalPrice(type="number" min="0" step="0.5" placeholder="Ex : 25")
                        .field
                            label= t.services.service_duration
                            input.input#serviceModalDuration(type="number" min="5" step="5" placeholder="30")
                    .field
                        label.svc-fee-label
                            span= t.services.duration_range_label
                                |
                                span.xs-comment= t.services.duration_range_hint
                            label.sa-toggle
                                input#serviceModalDurationRangeEnabled(type="checkbox")
                                .sa-toggle__track
                        #svcDurationMaxRow(style="display:none")
                            label= t.services.duration_max_label
                            input.input#serviceModalDurationMax(type="number" min="5" step="5" placeholder="Ex : 40")
                    .field
                        label= t.services.color_label
                        input(type="hidden" id="serviceModalColor")
                        .svc-color-picker#svcColorPicker
                //- ── Colonne droite : statut + ciblage + frais ────────────────
                .service-modal__col
                    .field
                        label.svc-fee-label
                            span Statut du service
                            label.sa-toggle
                                input#serviceModalActive(type="checkbox" checked)
                                .sa-toggle__track
                        p.xs-comment#svcActiveHint Service actif — visible et réservable par les clients.
                    .field#svcTargetingField(style="display:none")
                        label Afficher ce service pour
                        p.xs-comment Selon la réponse du client au questionnaire, ce service lui est proposé ou non. « Tous » = visible quelle que soit la réponse.
                        .svc-targeting#svcTargeting
                    .field
                        label.svc-fee-label
                            span= t.services.fee_label
                            label.sa-toggle
                                input#serviceModalFeeEnabled(type="checkbox")
