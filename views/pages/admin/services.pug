extends ../../layouts/admin

block links
    link(rel="stylesheet" href="/css/layouts/services.css")

block content
    - const canManageSvc = !!(permissions && permissions.services && permissions.services.manage)
    .services-page
        .services-page__header
            .services-page__header-left
                h2= t.services.title
                p.services-page__subtitle= t.services.subtitle
            .services-page__header-right
                if maxServices > 0
                    span.services-counter#svcCounter(class=(services.length >= maxServices ? 'services-counter--full' : '')) #{services.length} / #{maxServices}
                if canManageSvc
                    if services.length > 0 && maxServices > 0
                        button.sm-btn.sm-btn--ghost#deactivateAllBtn
                            svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z")
                            span= t.services.deactivate_all || 'Désactiver tout'
                    button.sm-btn.sm-btn--primary#addServiceBtn(disabled=(maxServices === 0 || services.length >= maxServices))
                    if maxServices === 0
                        svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                            path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80Z")
                    else
                        svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                            path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                    span= t.services.add_btn

        //- ── Plan limit banner ────────────────────────────────────
        - var svcAtLimit = maxServices > 0 && services.length >= maxServices
        if currentPlan === 'basic' && maxServices > 0
            .plan-limit-banner.plan-limit-banner--upgrade#serviceLimitBanner(style=!svcAtLimit ? 'display:none' : '')
                svg.plan-limit-banner__icon(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                    path(d="m40-120 440-760 440 760H40Zm138-80h604L480-720 178-200Zm302-40q17 0 28.5-11.5T520-280q0-17-11.5-28.5T480-320q-17 0-28.5 11.5T440-280q0 17 11.5 28.5T480-240Zm-40-120h80v-200h-80v200Zm40-100Z")
                .plan-limit-banner__text
                    strong Limite gratuit atteinte — #{maxServices}/#{maxServices} services
                    span Passez au plan Pro pour créer jusqu'à 10 services, personnaliser votre page et bien plus.
                a.btn-upgrade-pro(href="/subscription") Passer au Pro →
        else if currentPlan === 'pro' && maxServices > 0
            .plan-limit-banner.plan-limit-banner--upgrade#serviceLimitBanner(style=!svcAtLimit ? 'display:none' : '')
                svg.plan-limit-banner__icon(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                    path(d="m40-120 440-760 440 760H40Zm138-80h604L480-720 178-200Zm302-40q17 0 28.5-11.5T520-280q0-17-11.5-28.5T480-320q-17 0-28.5 11.5T440-280q0 17 11.5 28.5T480-240Zm-40-120h80v-200h-80v200Zm40-100Z")
                .plan-limit-banner__text
                    strong Limite Pro atteinte — #{maxServices}/#{maxServices} services
                    span Passez au plan Business pour créer jusqu'à 50 services et développer votre activité.
                a.btn-upgrade-business(href="/subscription") Passer au Business →
        else if currentPlan === 'business' && maxServices > 0
            .plan-limit-banner.plan-limit-banner--max#serviceLimitBanner(style=!svcAtLimit ? 'display:none' : '')
                svg.plan-limit-banner__icon(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                    path(d="M480-280q17 0 28.5-11.5T520-320q0-17-11.5-28.5T480-360q-17 0-28.5 11.5T440-320q0 17 11.5 28.5T480-280Zm-40-160h80v-240h-80v240Zm40 360q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z")
                .plan-limit-banner__text
                    strong Limite maximale atteinte
                    span Vous avez atteint la limite de #{maxServices} services de votre plan Business.

        if services.length === 0
            .services-empty
                svg(xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="currentColor")
                    path(d="M160-120q-33 0-56.5-23.5T80-200v-560q0-33 23.5-56.5T160-840h640q33 0 56.5 23.5T880-760v560q0 33-23.5 56.5T800-120H160Zm0-80h640v-560H160v560Zm80-80h480v-80H240v80Zm0-160h480v-80H240v80Zm0-160h480v-80H240v80Z")
                p= t.services.empty
                if maxServices === 0
                    .plan-lock-hint
                        svg(xmlns="http://www.w3.org/2000/svg" height="13px" viewBox="0 -960 960 960" width="13px" fill="currentColor")
                            path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80Z")
                        span Disponible à partir du plan Pro
                        a.btn-upgrade-pro(href="/subscription") Passer au Pro
                else
                    .plan-lock-hint
                        svg(xmlns="http://www.w3.org/2000/svg" height="13px" viewBox="0 -960 960 960" width="13px" fill="currentColor")
                            path(d="m40-120 440-760 440 760H40Zm138-80h604L480-720 178-200Zm302-40q17 0 28.5-11.5T520-280q0-17-11.5-28.5T480-320q-17 0-28.5 11.5T440-280q0 17 11.5 28.5T480-240Zm-40-120h80v-200h-80v200Zm40-100Z")
                        span Limite gratuit : #{maxServices}/#{maxServices} services
                        a.btn-upgrade-pro(href="/subscription") Passer au Pro

        //- ── Passerelle vers "Cours collectifs" — un service ici reste un
        //- rendez-vous individuel classique. Pour un atelier/cours à plusieurs
        //- dates et places limitées (1/7 19h-20h, 5/7 12h-13h, max 5 places...),
        //- c'est une page dédiée qui gère ça (planning récurrent OU dates
        //- ponctuelles) — sans ce lien, on ne la trouve pas en partant d'ici.
        if !adminFeatures || adminFeatures.group_sessions !== false
            a.svc-gs-banner(href="/group-sessions")
                .svc-gs-banner__icon
                    svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                        path(d="M480-120 200-272v-240L40-600l440-240 440 240v320h-80v-276l-80 44v240L480-120Zm0-332 274-148-274-148-274 148 274 148Zm0 240 200-108v-153l-200 108-200-108v153l200 108Z")
                .svc-gs-banner__text
                    strong Vous proposez plutôt un atelier ou cours collectif ?
                    span Plusieurs participants, une ou plusieurs dates, un nombre de places max — gérez ça dans "Cours collectifs".
                svg.svc-gs-banner__arrow(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                    path(d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z")

        //- ── Question préalable au choix du service ──────────────────────────
        .bq-card
            .bq-card__hd
                .bq-card__title-row
                    svg.bq-card__icon(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                        path(d="M478-240q21 0 35.5-14.5T528-290q0-21-14.5-35.5T478-340q-21 0-35.5 14.5T428-290q0 21 14.5 35.5T478-240Zm-36-154h74q0-33 7.5-52t42.5-52q26-26 41-49.5t15-56.5q0-56-41-86t-97-30q-57 0-92.5 30T342-618l66 26q5-18 22.5-39t53.5-21q32 0 48 17.5t16 38.5q0 20-12 37.5T506-526q-44 39-54 59t-10 73Zm38 314q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Z")
                    span.bq-card__title Question avant le choix du service
                label.sa-toggle
                    input#bqEnabled(type="checkbox" checked=(bookingQuestion && bookingQuestion.enabled))
                    .sa-toggle__track
            p.bq-card__sub
                | Posez une question à vos #{clientTermPlural || 'clients'} avant qu'ils choisissent une prestation (ex : "Est-ce la première fois que vous nous consultez ?"). Sur chaque service, vous pourrez ensuite choisir s'il ne doit s'afficher que pour une des deux réponses — par défaut il reste proposé dans tous les cas.
            - var bq = bookingQuestion || {}
            #bqRow(style=(bq.enabled ? '' : 'display:none'))
                .field
                    label Votre question
                    input.input#bqQuestionInput(type="text" maxlength="200" placeholder="Ex: Est-ce la première fois que vous nous consultez ?" value=bq.question)
                .field-row
                    .field
                        label Libellé réponse "nouveau"
                        input.input#bqNewLabelInput(type="text" maxlength="80" placeholder="Ex: Oui, je suis nouveau" value=bq.newLabel)
                    .field
                        label Libellé réponse "déjà venu"
                        input.input#bqExistingLabelInput(type="text" maxlength="80" placeholder="Ex: Non, j'ai déjà consulté" value=bq.existingLabel)

        .services-list#servicesList
            each svc in services
                -
                    var _catObj = svc.category ? categories.find(function(c){ return c.name === svc.category; }) : null
                    var _catIcon = _catObj && _catObj.icon ? _catObj.icon : ''
                .service-card(data-id=String(svc._id) data-category=svc.category || '' data-type=(svc.type || 'individual') data-capacity=(svc.capacity || '') data-color=(svc.color || '') data-fee-enabled=(svc.cancellationFee && svc.cancellationFee.enabled ? '1' : '0') data-fee-type=(svc.cancellationFee && svc.cancellationFee.type || 'percent') data-fee-value=(svc.cancellationFee && svc.cancellationFee.value !== null && svc.cancellationFee.value !== undefined ? svc.cancellationFee.value : '') data-answer-visibility=(svc.answerVisibility || 'all') data-duration-max=(svc.durationMax || '') data-image=(svc.image || '') class=(!svc.active ? 'service-card--inactive' : ''))
                    .service-card__header
                        .service-card__name-row
                            h3.service-card__name
                                span.service-card__color-dot(style=`background:${svc.color || '#1e7a4e'}`)
                                = svc.name
                            .service-card__badges
                                if svc.category
                                    span.badge.badge--category
                                        if _catIcon
                                            span.badge-cat-icon= _catIcon + ' '
                                        = svc.category
                                if svc.price !== null && svc.price !== undefined
                                    span.badge.badge--price #{svc.price}€
                                span.badge.badge--duration #{svc.durationMax && svc.durationMax > svc.duration ? `${svc.duration}-${svc.durationMax} min` : `${svc.duration} min`}
                                if svc.type === 'group'
                                    span.badge.badge--group #{svc.capacity} places
                                if svc.cancellationFee && svc.cancellationFee.enabled
                                    span.badge.badge--fee
                                        = svc.cancellationFee.type === 'amount' ? `Annulation: ${svc.cancellationFee.value}€` : `Annulation: ${svc.cancellationFee.value}%`
                                if svc.answerVisibility && svc.answerVisibility !== 'all'
                                    span.badge.badge--category(title="Visible uniquement pour cette réponse à la question préalable")
                                        = svc.answerVisibility === 'new' ? ((bookingQuestion && bookingQuestion.newLabel) || 'Nouveau') : ((bookingQuestion && bookingQuestion.existingLabel) || 'Déjà venu')
                        .service-card__actions
                            if canManageSvc
                                label.sa-toggle(title=(svc.active ? t.services.deactivate : t.services.activate))
                                    input.toggle-active(type="checkbox" checked=svc.active data-id=String(svc._id))
                                    .sa-toggle__track
                                button.btn.btn--icon.edit-service-btn(data-id=String(svc._id) title=t.services.modal_edit)
                                    svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                        path(d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z")
                                button.btn.btn--icon.btn--danger.delete-service-btn(data-id=String(svc._id) title="Supprimer")
                                    svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                        path(d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-272h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z")
                    hr.service-card__divider
                    if svc.description
                        p.service-card__desc= svc.description
                    .service-card__employees
                        .service-card__employees-label
                            svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                path(d="M40-160v-112q0-34 17.5-62.5T104-378q62-31 126-46.5T360-440q66 0 130 15.5T616-378q29 15 46.5 43.5T680-272v112H40Zm720 0v-120q0-44-24.5-84.5T666-434q51 6 96 20.5t84 35.5q36 20 55 44.5t19 53.5v120H760ZM360-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113T360-480Zm400-160q0 66-47 113t-113 47q-11 0-28-2.5t-28-5.5q27-32 41.5-71t14.5-81q0-42-14.5-81T544-792q14-5 28-6.5t28-1.5q66 0 113 47t47 113Z")
                            span.service-card__employees-title= t.services.employees_label
                        .service-card__employees-list
                            if svc.employees && svc.employees.length > 0
                                each emp in svc.employees
                                    .emp-chip
                                        - var empName = emp.fullName || ''
                                        img(src=emp.profilePicture alt=empName)
                                        span= empName
                            else
                                span.service-card__employees-none= t.services.employees_all
                        if canManageSvc
                            button.sm-btn.sm-btn--ghost.manage-employees-btn(data-id=String(svc._id) data-name=svc.name)
                                span= t.services.employees_manage

            //- ── Add service card ──────────────────────────────────────────────
            if canManageSvc
                - var atLimit = maxServices === 0 || services.length >= maxServices
                button.svc-card.svc-card--invite#addServiceCardBtn(type="button" class=atLimit ? 'svc-card--locked-invite' : '')
                    .emp-invite__icon
                        if maxServices === 0
                            svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                                path(d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920q83 0 141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm240-120q33 0 56.5-23.5T560-360q0-33-23.5-56.5T480-440q-33 0-56.5 23.5T400-360q0 33 23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35q-50 0-85 35t-35 85v80Z")
                        else
                            svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                                path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                    .emp-invite__title= t.services.add_btn || 'Ajouter un service'
                    if maxServices === 0
                        .emp-invite__upgrade
                            a.btn-upgrade-pro(href="/subscription") Passer au Pro
                    else if services.length >= maxServices
                        p.emp-invite__desc Limite atteinte. Passez à un plan supérieur pour en ajouter.
                    else
                        p.emp-invite__desc Ajoutez un nouveau service proposé à vos clients.

    //- ── Panneau : Gérer les catégories ──────────────────────────────────────
    if categories && categories.length > 0
        .cat-manage-panel#catManagePanel
            .cat-manage-panel__header
                .cat-manage-panel__title
                    svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                        path(d="M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h240l80 80h320q33 0 56.5 23.5T880-640v400q0 33-23.5 56.5T800-160H160Z")
                    span Catégories & affichage
                span.cat-manage-panel__hint Glissez ou utilisez ↑↓ pour réordonner

            //- Style picker
            .cat-style-picker
                button.cat-style-opt#styleOptPills(type="button" data-style="pills")
                    svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                        path(d="M280-400q-83 0-141.5-58.5T80-600q0-83 58.5-141.5T280-800h400q83 0 141.5 58.5T880-600q0 83-58.5 141.5T680-400H280Z")
                    span Pills
                button.cat-style-opt#styleOptAccordion(type="button" data-style="accordion")
                    svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                        path(d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z")
                    span Accordéon
                button.cat-style-opt#styleOptGrid(type="button" data-style="grid")
                    svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                        path(d="M120-120v-240h240v240H120Zm0-360v-240h240v240H120Zm360 360v-240h240v240H480Zm0-360v-240h240v240H480Zm360 360v-240h240v240H840Zm0-360v-240h240v240H840Z")
                    span Sections

            //- Category list (reorderable)
            ul.cat-order-list#catOrderList
                each cat in categories
                    li.cat-order-item(data-name=cat.name)
                        span.cat-order-item__grip
                            svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                path(d="M360-160q-33 0-56.5-23.5T280-240q0-33 23.5-56.5T360-320q33 0 56.5 23.5T440-240q0 33-23.5 56.5T360-160Zm240 0q-33 0-56.5-23.5T520-240q0-33 23.5-56.5T600-320q33 0 56.5 23.5T680-240q0 33-23.5 56.5T600-160ZM360-440q-33 0-56.5-23.5T280-520q0-33 23.5-56.5T360-600q33 0 56.5 23.5T440-520q0 33-23.5 56.5T360-440Zm240 0q-33 0-56.5-23.5T520-520q0-33 23.5-56.5T600-600q33 0 56.5 23.5T680-520q0 33-23.5 56.5T600-440ZM360-720q-33 0-56.5-23.5T280-800q0-33 23.5-56.5T360-880q33 0 56.5 23.5T440-800q0 33-23.5 56.5T360-720Zm240 0q-33 0-56.5-23.5T520-800q0-33 23.5-56.5T600-880q33 0 56.5 23.5T680-800q0 33-23.5 56.5T600-720Z")
                        if cat.icon
                            span.cat-order-item__icon= cat.icon
                        span.cat-order-item__name= cat.name
                        .cat-order-item__btns
                            button.cat-order-btn(type="button" data-dir="up" title="Remonter")
                                svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                                    path(d="m296-345-56-56 240-240 240 240-56 56-184-184-184 184Z")
                            button.cat-order-btn(type="button" data-dir="down" title="Descendre")
                                svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                                    path(d="M480-345 240-585l56-56 184 184 184-184 56 56-240 240Z")
                            button.cat-order-btn.cat-edit-btn(type="button" title="Modifier")
                                svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                                    path(d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z")
                            button.cat-order-btn.cat-delete-btn(type="button" title="Supprimer")
                                svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                                    path(d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-272h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z")

            .cat-manage-panel__footer
                button.sm-btn.sm-btn--primary#saveCatSettingsBtn(type="button")
                    svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                        path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                    span Enregistrer
                span.cat-manage-panel__status#catSaveStatus

    //- ── Modal : Modifier une catégorie ─────────────────────────────────────
    .modal-overlay#editCatModalOverlay
    .service-modal#editCatModal
        .service-modal__header
            h2.service-modal__title Modifier la catégorie
            button.service-modal__close#closeEditCatModal(type="button")
                svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                    path(d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z")
        .service-modal__body
            input(type="hidden" id="editCatOldName")
            .form-group
                label(for="editCatName") Nom de la catégorie
                input.form-input#editCatName(type="text" placeholder="Ex: Coiffure" autocomplete="off")
            .form-group
                label Icône
                input(type="hidden" id="editCatIconInput")
                .cat-icon-picker#editCatIconPicker
        .service-modal__footer
            button.sm-btn.sm-btn--ghost#cancelEditCatModal(type="button") Annuler
            button.sm-btn.sm-btn--primary#saveEditCatBtn(type="button")
                svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                    path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                span Enregistrer

    //- ── Modal : Créer / Modifier un service ──────────────────────────────────
    .modal-overlay#serviceModalOverlay
    .service-modal#serviceModal
        .service-modal__header
            h3#serviceModalTitle= t.services.modal_new
            button.modal-close#closeServiceModal
                svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                    path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
        .service-modal__body
            input(type="hidden" id="serviceModalId")
            .service-modal__cols
                //- ── Colonne gauche : identité du service ────────────────────
                .service-modal__col
                    //- Image optionnelle
                    .field
                        label Image du service #[span.xs-comment  (optionnel)]
                        .svc-img-upload#svcImgUpload
                            img.svc-img-upload__preview#svcImgPreview(src="" alt="" style="display:none")
                            .svc-img-upload__placeholder#svcImgPlaceholder
                                svg(viewBox="0 -960 960 960" height="28" width="28" fill="currentColor" style="opacity:.35")
                                    path(d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-800v560q0 33-23.5 56.5T800-120H200Zm0-80h560v-560H200v560Zm40-80h480L570-480 450-320l-90-120-120 160Zm-40 80v-560 560Z")
                                p Cliquez pour ajouter une image
                            input.svc-img-upload__input#svcImgInput(type="file" accept="image/*" style="display:none")
                            button.svc-img-upload__remove#svcImgRemove(type="button" style="display:none") × Supprimer
                    .field
                        label= t.services.service_name
                        input.input#serviceModalName(placeholder="Ex: Coupe simple, Massage détente...")
                    .field
                        label= t.services.service_category
                        select.input#serviceModalCategory
                            //- Populated by JS from window.__categories
                    #newCategorySection(style="display:none")
                        .field
                            label= t.services.new_category_name
                            input.input#newCategoryName(type="text" placeholder="Ex: Cheveux, Corps, Visage...")
                        .field
                            label= t.services.new_category_icon
                            input(type="hidden" id="newCategoryIconInput")
                            .cat-icon-picker#catIconPicker
                    .field
                        label= t.services.service_desc
                        textarea.textarea#serviceModalDesc(placeholder="..." rows=3)
                    .field-row
                        .field
                            label= t.services.service_price
                            input.input#serviceModalPrice(type="number" min="0" step="0.5" placeholder="Ex: 25")
                        .field
                            label= t.services.service_duration
                            input.input#serviceModalDuration(type="number" min="5" step="5" placeholder="30")
                    .field
                        label.svc-fee-label
                            span Durée approximative #[span.xs-comment  (ex: 30 à 40 min)]
                            label.sa-toggle
                                input#serviceModalDurationRangeEnabled(type="checkbox")
                                .sa-toggle__track
                        #svcDurationMaxRow(style="display:none")
                            label Jusqu'à
                            input.input#serviceModalDurationMax(type="number" min="5" step="5" placeholder="Ex: 40")
                    .field
                        label Couleur (calendrier)
                        input(type="hidden" id="serviceModalColor")
                        .svc-color-picker#svcColorPicker

                //- ── Colonne droite : réservation & frais ─────────────────────
                .service-modal__col
                    .field#svcAnswerVisibilityField(style=((bookingQuestion && bookingQuestion.enabled) ? '' : 'display:none'))
                        label Afficher ce service pour
                        .svc-answer-options#svcAnswerOptions
                            button.svc-answer-opt.is-active(type="button" data-value="all") Tous
                            button.svc-answer-opt(type="button" data-value="new")= (bookingQuestion && bookingQuestion.newLabel) || "Nouveau"
                            button.svc-answer-opt(type="button" data-value="existing")= (bookingQuestion && bookingQuestion.existingLabel) || "Déjà venu"
                    .field
                        label.svc-fee-label
                            span Frais d'annulation personnalisés pour ce service
                            label.sa-toggle
                                input#serviceModalFeeEnabled(type="checkbox")
                                .sa-toggle__track
                        p.xs-comment Remplace la politique d'annulation globale pour ce service uniquement (annulation tardive ou absence non excusée).
                        #svcFeeFields(style="display:none")
                            .svc-fee-type-options#svcFeeTypeOptions
                                button.svc-type-option.is-active(type="button" data-fee-type="percent")
                                    span.svc-type-option__title %
                                    span.svc-type-option__desc Pourcentage du prix
                                button.svc-type-option(type="button" data-fee-type="amount")
                                    span.svc-type-option__title €
                                    span.svc-type-option__desc Montant fixe
                            .field
                                input.input#serviceModalFeeValue(type="number" min="0" step="0.5" placeholder="Ex: 30")
        .service-modal__footer
            button.sm-btn.sm-btn--ghost#cancelServiceModal
                span= t.services.cancel
            button.sm-btn.sm-btn--primary#saveServiceBtn
                span= t.services.save

    //- ── Modal : Gérer les employés d'un service ─────────────────────────────
    .modal-overlay#empModalOverlay
    .service-modal#empModal
        .service-modal__header
            h3#empModalTitle= t.services.employees_modal_title
                |  —
                span#empModalServiceName
            button.modal-close#closeEmpModal.btn--icon
                svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                    path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
        .service-modal__body
            p.xs-comment= t.services.employees_modal_sub
            #empList.emp-select-list
                //- Injecté par JS
        .service-modal__footer
            button.sm-btn.sm-btn--ghost#cancelEmpModal
                span= t.services.cancel
            button.sm-btn.sm-btn--primary#saveEmpBtn
                span= t.services.save

block scripts
    script.
        window.__maxServices    = !{maxServices || 0};
        window.__svcCount       = !{services.length || 0};
        window.__serviceColors  = !{JSON.stringify(services.map(function(s){ return { id: String(s._id), color: s.color || '' }; }))};
        window.__categories     = !{JSON.stringify(categories || [])};
        window.__t_no_category      = !{JSON.stringify(t.services.no_category     || 'Aucune catégorie')};
        window.__t_create_category  = !{JSON.stringify(t.services.create_category || '+ Créer une catégorie')};
        window.__t_new_cat_name     = !{JSON.stringify(t.services.new_category_name || 'Nom de la catégorie')};
        window.__bookingCategoryStyle = !{JSON.stringify(bookingCategoryStyle || 'pills')};
        window.__bookingQuestion = !{JSON.stringify(bookingQuestion || { enabled: false, question: '', options: [] })};
    script(src="/js/utils/confirm-modal.js")
    script(src="/js/layouts/services.js")
