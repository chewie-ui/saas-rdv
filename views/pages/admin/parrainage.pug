extends ../../layouts/admin

block links
    link(rel="stylesheet" href="/css/layouts/informations.css")
    link(rel="stylesheet" href="/css/layouts/parrainage.css")

block content
    .info-page
        .info-page__header
            h2= t.referral.title
            p.info-page__subtitle= t.referral.subtitle

        //- ── Bannière règle ──────────────────────────────────────────────────
        .parrainage-rule-banner
            .parrainage-rule-banner__icon 🎁
            .parrainage-rule-banner__body
                strong.parrainage-rule-banner__title 3 filleuls payants = 2 mois offerts
                span.parrainage-rule-banner__sub Chaque tranche de 3 filleuls qui souscrivent un abonnement Pro vous offre 2 mois gratuits, appliqués directement sur votre abonnement.

        //- ── Comment ça marche ───────────────────────────────────────────────
        .info-card
            .info-card__header
                h3= t.referral.how_title
            .parrainage-how
                .parrainage-how__step
                    .parrainage-how__step__num 1
                    .parrainage-how__step__text= t.referral.step1
                .parrainage-how__step
                    .parrainage-how__step__num 2
                    .parrainage-how__step__text= t.referral.step2
                .parrainage-how__step.parrainage-how__step--accent
                    .parrainage-how__step__num 3
                    .parrainage-how__step__text= t.referral.step3

        //- ── Lien / code / QR ────────────────────────────────────────────────
        .info-card
            .info-card__header
                h3= t.referral.link_title
                p.info-card__desc= t.referral.link_desc
            .parrainage-share
                .parrainage-share__cols
                    .parrainage-field
                        label.parrainage-field__label= t.referral.code_label
                        .parrainage-field__row
                            span.parrainage-field__value#referralCode= referralCode || '—'
                            button.sm-btn.sm-btn--ghost(type="button" data-copy=referralCode title=t.referral.copy_code_title)
                                span.material-symbols-outlined(style=`font-size:15px`) content_copy
                                span= t.referral.copy_btn
                    .parrainage-field
                        label.parrainage-field__label= t.referral.link_label
                        .parrainage-field__row
                            span.parrainage-field__value.parrainage-field__value--link#referralUrl= referralLink
                            button.sm-btn.sm-btn--ghost(type="button" data-copy=referralLink title=t.referral.copy_link_title)
                                span.material-symbols-outlined(style=`font-size:15px`) content_copy
                                span= t.referral.copy_btn

                .parrainage-qr
                    label.parrainage-field__label= t.referral.qr_label
                    img.parrainage-qr__img(src=qrUrl alt=t.referral.qr_alt loading="lazy")
                    a.sm-btn.sm-btn--ghost.sm-btn--full(href=qrUrl download="branshee-parrainage-qr.png" target="_blank")
                        span.material-symbols-outlined(style=`font-size:16px`) download
                        span= t.referral.download_btn

        //- ── Statistiques ────────────────────────────────────────────────────
        .info-card
            .info-card__header
                h3= t.referral.stats_title
            .parrainage-stats
                .parrainage-stat
                    .parrainage-stat__value= referral.totalInvited || 0
                    .parrainage-stat__label= t.referral.stat_invited
                .parrainage-stat
                    .parrainage-stat__value= referral.totalPaying || 0
                    .parrainage-stat__label= t.referral.stat_paying
                .parrainage-stat.parrainage-stat--accent
                    .parrainage-stat__value= referral.creditMonths || 0
                    .parrainage-stat__label= t.referral.stat_months

        //- ── Filleuls ─────────────────────────────────────────────────────────
        .info-card
            .info-card__header
                h3= t.referral.referrals_title
            if filleuls && filleuls.length
                table.parrainage-table
                    thead
                        tr
                            th= t.referral.col_name
                            th= t.referral.col_email
                            th= t.referral.col_signup_date
                            th= t.referral.col_status
                    tbody
                        each f in filleuls
                            - var dt = new Date(f.createdAt)
                            - var dateStr = dt.toLocaleDateString(lang, {day:'2-digit', month:'short', year:'numeric'})
                            tr
                                td= f.fullName || '—'
                                td= f.email || '—'
                                td= dateStr
                                td
                                    if f.referralPaidCounted
                                        span.parrainage-badge.parrainage-badge--paying= t.referral.status_paying
                                    else
                                        span.parrainage-badge.parrainage-badge--free= t.referral.status_free
            else
                .parrainage-empty= t.referral.empty

        //- ── Réclamer ─────────────────────────────────────────────────────────
        -
            var totalPaying = (referral && referral.totalPaying) || 0;
            var creditMonths = (referral && referral.creditMonths) || 0;
            var claimable = Math.max(0, Math.floor(totalPaying / 3) * 2 - creditMonths);
            var claimableMonthsText = (claimable > 1 ? t.referral.claimable_many : t.referral.claimable_one).replace('{n}', claimable);
            var claimBtnText = claimable > 1 ? t.referral.claim_btn_many.replace('{n}', claimable) : t.referral.claim_btn_one.replace('{n}', claimable);

        .info-card
            .info-card__header
                h3= t.referral.claim_title
            .parrainage-claim
                .parrainage-claim__info
                    if claimable > 0
                        p!= t.referral.claimable_html.replace('{months}', claimableMonthsText)
                    else
                        p= t.referral.no_credit
                button.sm-btn.sm-btn--primary#claimBtn(type="button" disabled=claimable <= 0)
                    span= claimable > 0 ? claimBtnText : t.referral.claim_btn

    script.
        window.__t_referral = !{JSON.stringify(t.referral)};
        (function() {
            var T = window.__t_referral || {};

            // Copy code / link
            document.querySelectorAll('[data-copy]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var text = btn.dataset.copy;
                    if (!text) return;
                    navigator.clipboard.writeText(text).then(function() {
                        var span = btn.querySelector('span');
                        var orig = span ? span.textContent : null;
                        if (span) span.textContent = T.copied || '✓ Copié !';
                        btn.classList.add('is-copied');
                        setTimeout(function() {
                            if (span && orig) span.textContent = orig;
                            btn.classList.remove('is-copied');
                        }, 2000);
                    });
                });
            });

            // Claim reward
            var claimBtn = document.getElementById('claimBtn');
            if (claimBtn && !claimBtn.disabled) {
                claimBtn.addEventListener('click', async function() {
                    var span = claimBtn.querySelector('span');
                    claimBtn.disabled = true;
                    if (span) span.textContent = '...';
                    try {
                        var res = await fetch('/parrainage/claim', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
                        var data = await res.json();
                        if (data.success) {
                            if (span) span.textContent = T.claim_success || '✓ Mois offert appliqué !';
                            setTimeout(function() { window.location.reload(); }, 1500);
                        } else {
                            if (span) span.textContent = data.error || T.claim_error || 'Erreur';
                            claimBtn.disabled = false;
                        }
                    } catch (e) {
                        if (span) span.textContent = T.claim_network_error || 'Erreur réseau';
                        claimBtn.disabled = false;
                    }
                });
            }
        })();
