extends ../../layouts/admin

block links
    link(rel="stylesheet" href="/css/layouts/services.css")
    link(rel="stylesheet" href="/css/layouts/clients.css")

block content
    - const canManageClients = !!(permissions && permissions.clients && permissions.clients.manage)
    -
        var parts = client.fullName.split(' ').filter(Boolean)
        var initials = ((parts[0] || '?')[0] + ((parts[1] || '')[0] || '')).toUpperCase()

    .dossier-page
        a.dossier-back#dossierBackLink(href="/clients")
            span.material-symbols-outlined arrow_back
            span= t.dossier.back_link || ('Tous les ' + (clientTermPlural || 'clients'))

        .dossier-header
            .dossier-header__id
                .dossier-header__avatar= initials
                .dossier-header__info
                    h2
                        = client.fullName
                        if dossier.blocked
                            span.dossier-blocked-badge= t.dossier.blocked_badge
                    .dossier-header__contact
                        span
                            span.material-symbols-outlined mail
                            = client.email
                        if client.phone
                            span
                                span.material-symbols-outlined phone
                                = client.phone
            .dossier-header__stats
                .dossier-stat
                    .dossier-stat__n= confirmedCount
                    .dossier-stat__l= t.dossier.stat_appointments
                if lastVisit
                    .dossier-stat
                        .dossier-stat__n= new Date(lastVisit.date).toLocaleDateString('fr-FR')
                        .dossier-stat__l= t.dossier.stat_last_visit
                if nextVisit
                    .dossier-stat.dossier-stat--next
                        .dossier-stat__n= new Date(nextVisit.date).toLocaleDateString('fr-FR')
                        .dossier-stat__l= t.dossier.stat_next_appt
            .dossier-header__actions
                if canManageClients
                    if dossier.blocked
                        button.sm-btn.sm-btn--ghost#unblockClientBtn(type="button")
                            span.material-symbols-outlined lock_open
                            span= t.dossier.btn_unblock || ('Débloquer ce ' + (clientTerm || 'client'))
                    else
                        button.sm-btn.sm-btn--danger#blockClientBtn(type="button")
                            span.material-symbols-outlined block
                            span= t.dossier.btn_block || ('Bloquer ce ' + (clientTerm || 'client'))

        .dossier-layout
            //- ── Colonne principale : chronologie des notes ──────────────────
            .dossier-main
                .dossier-main__header
                    h3= t.dossier.section_follow_up || ('Suivi du ' + (clientTerm || 'client'))
                    if canManageClients
                        button.sm-btn.sm-btn--primary#addEntryBtn
                            span.material-symbols-outlined add
                            span= t.dossier.btn_new_note

                #timelineList.dossier-timeline
                    if entries.length === 0
                        .dossier-timeline__empty
                            span.material-symbols-outlined(style=`font-size:40px`) sticky_note_2
                            p= t.dossier.empty_notes || ('Aucune note encore pour ce ' + (clientTerm || 'client') + '.')
                            p.dossier-timeline__empty-sub= t.dossier.empty_notes_hint
                    each entry in entries
                        .timeline-entry(data-id=String(entry._id) data-note=entry.note data-todo=entry.todo data-date=new Date(entry.date).toISOString().slice(0,10))
                            .timeline-entry__rail
                                .timeline-entry__dot
                            .timeline-entry__card
                                .timeline-entry__head
                                    span.timeline-entry__date= new Date(entry.date).toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
                                    if canManageClients
                                        .timeline-entry__actions
                                            button.timeline-entry__btn.edit-entry-btn(title="Modifier")
                                                span.material-symbols-outlined(style=`font-size:15px`) edit
                                            button.timeline-entry__btn.timeline-entry__btn--danger.delete-entry-btn(title="Supprimer")
                                                span.material-symbols-outlined(style=`font-size:15px`) delete
                                p.timeline-entry__note= entry.note
                                if entry.todo
                                    .timeline-entry__todo
                                        span.material-symbols-outlined checklist
                                        span
                                            strong= t.dossier.todo_label + ' '
                                            = entry.todo

            //- ── Colonne latérale : infos générales + historique RDV ─────────
            .dossier-side
                .section__container.dossier-general
                    h3= t.dossier.section_general_info
                    p.xs-comment= t.dossier.general_info_hint
                    textarea.textarea#generalInfoInput(rows=6 placeholder="Ex: Douleur lombaire chronique depuis 2022, allergie au latex...")= dossier.generalInfo
                    .dossier-general__footer
                        button.sm-btn.sm-btn--primary#saveGeneralBtn(disabled)= t.dossier.btn_save
                        span#generalSaveStatus.dossier-general__status

                .section__container.dossier-history
                    h3= t.dossier.section_history
                    if bookings.length === 0
                        p.xs-comment= t.dossier.no_bookings
                    else
                        ul.booking-mini-list
                            each b in bookings.slice(0, 10)
                                - var pm = (b.payment && b.payment.method) || 'none'
                                li.booking-mini-item(data-id=String(b._id))
                                    .booking-mini-item__row
                                        span.booking-mini-item__service(title=b.serviceName || 'Rendez-vous')= b.serviceName || 'Rendez-vous'
                                        span.booking-mini-item__status(class=`booking-mini-item__status--${b.status}`)= b.status === 'canceled' ? t.dossier.status_canceled : t.dossier.status_confirmed
                                    .booking-mini-item__row.booking-mini-item__row--meta
                                        span.booking-mini-item__date= new Date(b.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })
                                        .booking-mini-item__meta-right
                                            span.booking-mini-item__price= (b.payment && b.payment.amount) ? `${b.payment.amount}€` : '—'
                                            select.booking-mini-item__payment(data-id=String(b._id) title="Moyen de paiement de cette séance")
                                                option(value="none" selected=(pm === 'none'))= t.dossier.payment_method_placeholder
                                                option(value="cash" selected=(pm === 'cash'))= t.dossier.pay_cash
                                                option(value="on_site" selected=(pm === 'on_site'))= t.dossier.pay_card_on_site
                                                option(value="bank_transfer" selected=(pm === 'bank_transfer'))= t.dossier.pay_bank_transfer
                                                option(value="paypal" selected=(pm === 'paypal'))= t.dossier.pay_paypal
                                                option(value="online" selected=(pm === 'online'))= t.dossier.pay_online

    //- ── Modal : Nouvelle / Modifier une note ─────────────────────────────────
    .modal-overlay#entryModalOverlay
    .service-modal#entryModal
        .service-modal__header
            h3#entryModalTitle= t.dossier.modal_new_note_title
            button.modal-close#closeEntryModal
                span.material-symbols-outlined close
        .service-modal__body
            input(type="hidden" id="entryModalId")
            .field
                label= t.dossier.modal_field_date
                input.input#entryModalDate(type="date")
            .field
                label= t.dossier.modal_field_note
                textarea.textarea#entryModalNote(rows=4 placeholder="Ex: Douleur à l'épaule droite, mobilité réduite. Massage + étirements ciblés.")
            .field
                label
                    = t.dossier.modal_field_todo
                    span.auth-label-opt &nbsp;(#{t.dossier.modal_field_optional})
                textarea.textarea#entryModalTodo(rows=2 placeholder="Ex: Continuer le renforcement, revoir la posture assise.")
        .service-modal__footer
            button.sm-btn.sm-btn--ghost#cancelEntryModal= t.dossier.btn_cancel
            button.sm-btn.sm-btn--primary#saveEntryBtn= t.dossier.btn_save_entry

    script.
        window.__dossierId = !{JSON.stringify(String(dossier._id))};

block scripts
    script(src="/js/utils/confirm-modal.js")
    script(src="/js/layouts/client-dossier.js")
