extends ../../layouts/admin

include ../../templates/modals/dialog.pug
include ../../templates/modals/prompt.pug

block links
    link(rel="stylesheet", href="/css/layouts/informations.css")
    link(rel="stylesheet", href="/css/templates/dialog.css")

block content
    .info-page

        .info-page__header
            h2= t.profile.title || 'Informations générales'
            p.info-page__subtitle= t.info.page_subtitle || 'Gérez votre profil et les informations de votre établissement.'

        //- ── Profil personnel ─────────────────────────────────────────────────
        .info-card
            .info-card__header
                h3= t.profile.section_title || 'Profil personnel'
            .profile-row
                .profile-photo-col
                    .profile-avatar
                        img(alt="Photo de profil" src=user.profilePicture || "/images/no-user.webp" id="avatarPreview")
                    input#fileInput(type="file" style="display:none" accept="image/*")
                    button.btn.secondary.btn--sm#uploadBtn
                        span= t.profile.upload_photo
                .profile-fields
                    .field
                        label(for="fullname")= t.profile.fullname
                        input#fullname.input(value=user.fullName name="fullName")
                    .field
                        label(for="email")= t.profile.email
                        input#email.input(disabled value=maskEmail name="email")
                        .more#emailOpen= t.profile.edit_email
                    .field
                        label(for="phone")= t.profile.phone
                        input#phone.input(value=user.phone name="phone" placeholder=t.profile.phone)
                    .field
                        label(for="password")= t.profile.password
                        input#password.input(placeholder="●●●●●●●●●●●" disabled)
                        a.more#passwordOpen(href="/forgot-password")= t.profile.change_pwd
                        .success= success
            .info-card__actions
                button.btn.danger#deleteAccountBtn(type="button")
                    span= t.profile.delete_account
                button.btn#saveChanges
                    span= t.profile.save

        //- ── URL personnalisée ────────────────────────────────────────────────
        .info-card
            .info-card__header
                h3= t.info.custom_url_title || 'URL personnalisée'
                p.info-card__desc= t.info.custom_url_desc || 'Choisissez une URL unique pour votre page de réservation publique.'
            .field
                label= t.info.custom_url_label || 'Nom d\'URL'
                .slug-field-wrapper
                    span.slug-prefix branshee.com/
                    input.input#slugInput(
                        type="text"
                        value=(currentCompany && currentCompany.slug ? currentCompany.slug : '')
                        placeholder="mon-salon"
                        autocomplete="off"
                    )
                .slug-status#slugStatus
            if currentCompany && (currentCompany.slug || currentCompany._id)
                .slug-share-row
                    .slug-share-url#slugShareUrl= 'branshee.com/' + (currentCompany.slug || String(currentCompany._id))
                    button.btn.secondary.btn--sm#copySlugBtn(type="button")
                        svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                            path(d="M360-240q-33 0-56.5-23.5T280-320v-480q0-33 23.5-56.5T360-880h360q33 0 56.5 23.5T800-800v480q0 33-23.5 56.5T720-240H360Zm0-80h360v-480H360v480ZM200-80q-33 0-56.5-23.5T120-160v-560h80v560h440v80H200Zm160-240v-480 480Z")
                        span Copier le lien
            .info-card__actions
                button.btn#saveSlugBtn
                    span= t.info.custom_url_save || 'Enregistrer l\'URL'

        //- ── Informations entreprise ──────────────────────────────────────────
        .info-card
            .info-card__header
                h3= t.info.business_section_title
            .biz-row
                .biz-photo-col
                    .biz-photo-preview
                        if user.businessPicture
                            img#businessPicPreview(alt="Photo établissement" src=user.businessPicture)
                        else
                            .biz-photo-placeholder#businessPicPreview
                                svg(xmlns="http://www.w3.org/2000/svg" height="32px" viewBox="0 -960 960 960" width="32px" fill="currentColor")
                                    path(d="M160-120q-33 0-56.5-23.5T80-200v-480q0-33 23.5-56.5T160-760h126l74-80h240l74 80h126q33 0 56.5 23.5T880-680v480q0 33-23.5 56.5T800-120H160Zm0-80h640v-480H160v480Zm320-80q-58 0-99-41t-41-99q0-58 41-99t99-41q58 0 99 41t41 99q0 58-41 99t-99 41Zm0-80q25 0 42.5-17.5T540-420q0-25-17.5-42.5T480-480q-25 0-42.5 17.5T420-420q0 25 17.5 42.5T480-360Z")
                    input#businessFileInput(type="file" style="display:none" accept="image/*")
                    button.btn.secondary.btn--sm#uploadBusinessBtn
                        span= t.info.business_photo
                .biz-fields
                    .field
                        label= t.info.business_name
                        input.input#businessNameInput(
                            type="text"
                            value=user.businessName || ""
                            placeholder=t.info.business_name_placeholder
                        )
                    .field
                        label= t.info.business_desc_label
                        textarea.textarea#descriptionCoach(maxlength=500 placeholder=t.info.business_desc_placeholder)= user.description || ''
                        span.field-hint#descCount #{(user.description || '').length}/500
                    .field
                        label= t.info.business_type_label
                        .service-select-wrapper
                            input.input#businessTypeInput(
                                type="text"
                                placeholder="Ex: Coiffeur, Médecin, Coach sportif..."
                                autocomplete="off"
                                value=user.businessType || ""
                            )
                            .service-dropdown#businessTypeDropdown
            .info-card__actions
                button.btn#saveBusinessInfo
                    span= t.info.business_save

        //- ── Localisation ─────────────────────────────────────────────────────
        .info-card
            .info-card__header
                h3= t.info.location_title
            .location-layout
                .location-map#mapContainer
                    if user.location && user.location.iframeUrl
                        iframe(src=user.location.iframeUrl style="border:0;width:100%;min-height:300px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade")
                    else
                        iframe(src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1299500.656531456!2d3.147172292480064!3d50.495334442699736!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c17d64edf39797%3A0x47ebf2b439e60ff2!2sBelgique!5e0!3m2!1sfr!2sbe!4v1775722964111!5m2!1sfr!2sbe" style="border:0;width:100%;min-height:300px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade")
                .location-form
                    input(type="hidden" id="latInput")
                    input(type="hidden" id="lonInput")
                    .field
                        .radio-group
                            .radio-item
                                input#onlineService(type="radio" name="serviceType" checked=(user.location && user.location.serviceType !== 'en_ligne'))
                                label(for="onlineService")
                                    span.custom-radio
                                    = t.info.on_site
                            .radio-item
                                input#homeService(type="radio" name="serviceType" checked=(user.location && user.location.serviceType === 'en_ligne'))
                                label(for="homeService")
                                    span.custom-radio
                                    = t.info.online_svc
                    #addressSearchBlock.field
                        label= t.info.search_addr
                        input.input(placeholder=t.info.addr_placeholder id="addressInput" autocomplete="chrome-off")
                        #results.results
                    #fullAddressBlock
                        .field
                            label= t.info.address
                            input.input(id='streetInput' value=(user.location && user.location.address) || "")
                        .field
                            label= t.info.zip
                            input.input(id='zipInput' value=(user.location && user.location.zip) || "")
                        .field
                            label= t.info.city
                            input.input(id='cityInput' value=(user.location && user.location.city) || "")
                        .field
                            label= t.info.country
                            input.input(id='countryInput' value=(user.location && user.location.country) || "")
                    #onlineAddressBlock(style="display:none")
                        .field
                            label= t.info.country
                            input.input(id='countryInputOnline' value=(user.location && user.location.country) || "")
                        .field
                            label= t.info.city_optional
                            input.input(id='cityInputOnline' value=(user.location && user.location.city) || "")
                    .info-card__actions(style="margin-top:4px")
                        button.btn#confirmLocation
                            span= t.info.confirm_location

        //- ── Réseaux sociaux ──────────────────────────────────────────────────
        .info-card
            .info-card__header
                h3= t.profile.social_title || 'Réseaux sociaux'
                p.info-card__desc= t.info.social_desc || 'Affichez vos coordonnées sur votre page publique.'
            .social-grid
                -
                    var cs = (user.calendarSettings) ? user.calendarSettings : {}
                    var socials = [
                        { name: 'emailPro',       toggle: 'showEmailPro',  logo: 'email-logo.webp',     alt: 'Email logo',     label: t.profile.social.email_pro,   val: user.emailPro       || '' },
                        { name: 'phonePro',       toggle: 'showPhonePro',  logo: 'phone-logo.webp',     alt: 'Phone logo',     label: t.profile.social.phone_pro,   val: user.phonePro       || '' },
                        { name: 'instagramLink',  toggle: 'showInstagram', logo: 'instagram-logo.webp', alt: 'Instagram logo', label: t.profile.social.instagram,   val: user.instagramLink  || '' },
                        { name: 'whatsappLink',   toggle: 'showWhatsapp',  logo: 'whatsapp-logo.webp',  alt: 'Whatsapp logo',  label: t.profile.social.whatsapp,    val: user.whatsappLink   || '' },
                        { name: 'facebookLink',   toggle: 'showFacebook',  logo: 'facebook-logo.webp',  alt: 'Facebook logo',  label: t.profile.social.facebook,    val: user.facebookLink   || '' },
                        { name: 'website',        toggle: 'showWebsite',   logo: 'website-logo.webp',   alt: 'Website logo',   label: t.profile.social.website,     val: user.website        || '' }
                    ]
                each s in socials
                    -
                        var isOn = (cs[s.toggle] !== false)
                    .social-box(data-name=s.name class=(!isOn ? 'social-box--hidden' : ''))
                        if !user.isPremium
                            a.get__premium(href="/subscription")= t.profile.get_premium
                        label.social-visibility-toggle(title=t.info.toggle_visibility data-toggle=s.toggle)
                            input.social-visibility-toggle__input(
                                type="checkbox"
                                checked=isOn
                                disabled=(!user.isPremium)
                            )
                            span.social-visibility-toggle__track
                                span.social-visibility-toggle__thumb
                        .social-box__logo
                            img(src="/images/logos/" + s.logo alt=s.alt)
                        .social-box__title= s.label
                        .social-box__field
                            input.input(placeholder=t.info.link_placeholder value=s.val disabled=(!user.isPremium))
                            button.btn.secondary.btn--sm.btn__social-save
                                span= t.avail.save

    //- ── Delete account modal ─────────────────────────────────────────────────
    .delete-account-modal#deleteAccountModal(style="display:none")
        .delete-account-modal__overlay#deleteAccountOverlay
        .delete-account-modal__box
            .delete-account-modal__header
                h3= t.info.delete_title
                button.delete-account-modal__close#closeDeleteModal
                    svg(xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor")
                        path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
            .delete-account-modal__body
                .delete-account-step#deleteStep1
                    p.delete-account-modal__desc!= t.info.delete_desc1
                    p.delete-account-modal__desc= t.info.delete_desc2
                    button.btn.danger#sendDeleteCode(type="button")= t.info.send_code
                    .delete-account-modal__status#deleteCodeStatus
                .delete-account-step#deleteStep2(style="display:none")
                    p.delete-account-modal__desc= t.info.enter_code
                    input.input#deleteCodeInput(type="text" placeholder=t.info.code_placeholder maxlength="6")
                    button.btn.danger#confirmDeleteAccount(type="button")= t.info.confirm_delete
                    .delete-account-modal__status#deleteConfirmStatus

    +dialog()
    +prompt()

block scripts
    script(src='/js/layouts/informations.js')
    script(src='/js/templates/dialog.js' type="module")
    script(src='/js/templates/edit-email.js')
    script.
        const __services = !{JSON.stringify(services)};
        (function() {
            // ── Autocomplete business type ──
            const input = document.getElementById('businessTypeInput');
            const dropdown = document.getElementById('businessTypeDropdown');

            function normalize(str) {
                return str.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
            }
            function renderList(items) {
                dropdown.innerHTML = '';
                if (!items.length) { dropdown.style.display = 'none'; return; }
                items.forEach(function(item) {
                    const div = document.createElement('div');
                    div.className = 'service-dropdown__item';
                    div.textContent = item;
                    div.addEventListener('mousedown', function(e) {
                        e.preventDefault();
                        input.value = item;
                        dropdown.style.display = 'none';
                    });
                    dropdown.appendChild(div);
                });
                dropdown.style.display = 'block';
            }
            if (input && dropdown) {
                input.addEventListener('input', function() {
                    const q = normalize(input.value.trim());
                    if (!q) { dropdown.style.display = 'none'; return; }
                    renderList(__services.filter(s => normalize(s).includes(q)).slice(0, 8));
                });
                input.addEventListener('focus', function() {
                    const q = normalize(input.value.trim());
                    if (q) renderList(__services.filter(s => normalize(s).includes(q)).slice(0, 8));
                });
                input.addEventListener('blur', function() {
                    setTimeout(function() { dropdown.style.display = 'none'; }, 150);
                });
            }

            // ── Compteur description ──
            const textarea = document.getElementById('descriptionCoach');
            const counter  = document.getElementById('descCount');
            if (textarea && counter) {
                textarea.addEventListener('input', function() {
                    counter.textContent = textarea.value.length + '/500';
                });
            }

            // ── Enregistrer nom + description + type en une fois ──
            const saveBusinessInfo = document.getElementById('saveBusinessInfo');
            const businessNameInput = document.getElementById('businessNameInput');
            if (saveBusinessInfo) {
                saveBusinessInfo.addEventListener('click', async function() {
                    const btn = saveBusinessInfo;
                    const businessName = businessNameInput ? businessNameInput.value.trim() : '';
                    const description  = textarea ? textarea.value.trim() : '';
                    const businessType = input ? input.value.trim() : '';
                    const res = await fetch('/account/business-info', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ businessName, description, businessType })
                    });
                    const data = await res.json();
                    if (data.success) {
                        btn.querySelector('span').textContent = '✓ Enregistré';
                        setTimeout(() => { btn.querySelector('span').textContent = 'Enregistrer'; }, 2500);
                    }
                });
            }

            // ── Upload photo établissement ──
            const businessFileInput = document.getElementById('businessFileInput');
            const uploadBusinessBtn = document.getElementById('uploadBusinessBtn');
            const businessPicPreview = document.getElementById('businessPicPreview');

            if (uploadBusinessBtn && businessFileInput) {
                uploadBusinessBtn.addEventListener('click', function() { businessFileInput.click(); });
                businessFileInput.addEventListener('change', async function() {
                    const file = businessFileInput.files[0];
                    if (!file) return;

                    const reader = new FileReader();
                    reader.onload = function(e) {
                        if (businessPicPreview.tagName === 'IMG') {
                            businessPicPreview.src = e.target.result;
                        } else {
                            const img = document.createElement('img');
                            img.src = e.target.result;
                            img.alt = 'Photo établissement';
                            img.id = 'businessPicPreview';
                            businessPicPreview.replaceWith(img);
                        }
                    };
                    reader.readAsDataURL(file);

                    const formData = new FormData();
                    formData.append('businessPicture', file);
                    const res = await fetch('/account/business-picture', { method: 'PATCH', body: formData });
                    await res.json();
                });
            }
        })();
