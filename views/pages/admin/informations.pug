extends ../../layouts/admin

include ../../templates/modals/dialog.pug
include ../../templates/modals/prompt.pug

block links
    link(rel="stylesheet", href="/css/layouts/informations.css")
    link(rel="stylesheet", href="/css/templates/dialog.css")

block content
    .wrapper.account
        .account__container
            .account__left
                .account__avatar
                    img(alt="Profile picture" src=user.profilePicture || "/images/no-user.webp" id="avatarPreview")
                .account__avatar-btn
                    input#fileInput(type="file" style="display:none" accept="image/*")
                    button.btn#uploadBtn
                        span= t.profile.upload_photo
            .account__right
                h2= t.profile.title
                .account__form
                    .field
                        label(for="fullname")= t.profile.fullname
                        input#fullname.input(value=user.fullName name="fullName")
                    .field
                        label(for="email")= t.profile.email
                        input#email.input(disabled value=maskEmail name="email")
                        div(style="width:fit-content")
                            .more#emailOpen= t.profile.edit_email
                    .field
                        label(for="phone")= t.profile.phone
                        input#phone.input(value=user.phone name="phone" placeholder=t.profile.phone)
                    .field
                        label(for="password")= t.profile.password
                        input#password.input(placeholder="●●●●●●●●●●●" disabled)
                        a(href="/forgot-password").more#passwordOpen= t.profile.change_pwd
                        .success= success
                    .account__actions
                        button#saveChanges
                            span= t.profile.save
                        button#deleteAccountBtn.danger(type="button")
                            span= t.profile.delete_account
        .account__container.reversed
            .account__left
                .business-pic-wrapper
                    .business-pic-preview
                        if user.businessPicture
                            img(alt="Photo établissement" src=user.businessPicture id="businessPicPreview")
                        else
                            .business-pic-placeholder#businessPicPreview
                                svg(xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="currentColor")
                                    path(d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80ZM480-320q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113T480-320Zm0-80q33 0 56.5-23.5T560-480q0-33-23.5-56.5T480-560q-33 0-56.5 23.5T400-480q0 33 23.5 56.5T480-400Z")
                    .account__avatar-btn
                        input#businessFileInput(type="file" style="display:none" accept="image/*")
                        button.btn#uploadBusinessBtn
                            span= t.info.business_photo
            .account__right
                h2= t.info.business_section_title
                .account__form
                    .field
                        label= t.info.business_name
                        input.input#businessNameInput(
                            type="text"
                            value=user.businessName || ""
                            placeholder=t.info.business_name_placeholder
                        )
                    .field
                        label= t.info.business_desc_label
                        textarea.textarea#descriptionCoach(maxlength=500 placeholder=t.info.business_desc_placeholder)= user.description || ''
                        span.field-hint#descCount #{(user.description || '').length}/500
                    .field
                        label= t.info.business_type_label
                        .service-select-wrapper
                            input.input.service-input(
                                type="text"
                                id="businessTypeInput"
                                placeholder="Ex: Coiffeur, Médecin, Coach sportif..."
                                autocomplete="off"
                                value=user.businessType || ""
                            )
                            .service-dropdown#businessTypeDropdown
                    .account__actions
                        button#saveBusinessInfo
                            span= t.info.business_save

        //- ---- Delete account modal ----
        .delete-account-modal#deleteAccountModal(style="display:none")
            .delete-account-modal__overlay#deleteAccountOverlay
            .delete-account-modal__box
                .delete-account-modal__header
                    h3= t.info.delete_title
                    button.delete-account-modal__close#closeDeleteModal
                        svg(xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor")
                            path(d="m336-280-56-56 144-144-144-143 56-56 144 144 143-144 56 56-144 143 144 144-56 56-143-144-144 144Z")
                .delete-account-modal__body
                    .delete-account-step#deleteStep1
                        p.delete-account-modal__desc!= t.info.delete_desc1
                        p.delete-account-modal__desc= t.info.delete_desc2
                        button#sendDeleteCode.btn.danger(type="button")= t.info.send_code
                        .delete-account-modal__status#deleteCodeStatus
                    .delete-account-step#deleteStep2(style="display:none")
                        p.delete-account-modal__desc= t.info.enter_code
                        input#deleteCodeInput.input(type="text" placeholder=t.info.code_placeholder maxlength="6")
                        button#confirmDeleteAccount.btn.danger(type="button")= t.info.confirm_delete
                        .delete-account-modal__status#deleteConfirmStatus

        .location__container
            .location__map(id="mapContainer")
                if user.location.iframeUrl
                    iframe(src=user.location.iframeUrl height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade")
                else
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1299500.656531456!2d3.147172292480064!3d50.495334442699736!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c17d64edf39797%3A0x47ebf2b439e60ff2!2sBelgique!5e0!3m2!1sfr!2sbe!4v1775722964111!5m2!1sfr!2sbe" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            .location__form
                h2= t.info.location_title
                .location__form-body
                    input(type="hidden", id="latInput")
                    input(type="hidden", id="lonInput")
                    .form__navigation
                        .radio-group
                            .radio-item
                                input(id='onlineService' type="radio" name="serviceType" checked=(user.location.serviceType !== 'en_ligne'))
                                label(for="onlineService")
                                    span.custom-radio
                                    = t.info.on_site
                            .radio-item
                                input(id='homeService' type="radio" name="serviceType" checked=(user.location.serviceType === 'en_ligne'))
                                label(for="homeService")
                                    span.custom-radio
                                    = t.info.online_svc
                    //- Shown for "Service sur place" (full address)
                    .form__top#addressSearchBlock
                        .form-group
                            label= t.info.search_addr
                            input.input(placeholder=t.info.addr_placeholder id="addressInput" autocomplete="chrome-off")
                            #results.results
                    .form__bottom#fullAddressBlock
                        .form-group
                            label= t.info.address
                            input.input(id='streetInput' value=user.location.address || "")
                        .form-group
                            label= t.info.zip
                            input.input(id='zipInput' value=user.location.zip || "")
                        .form-group
                            label= t.info.city
                            input.input(id='cityInput' value=user.location.city || "")
                        .form-group
                            label= t.info.country
                            input.input(id='countryInput' value=user.location.country || "")
                    //- Shown for "Service en ligne" (only country + optional city)
                    .form__bottom#onlineAddressBlock(style="display:none")
                        .form-group
                            label= t.info.country
                            input.input(id='countryInputOnline' value=user.location.country || "")
                        .form-group
                            label= t.info.city_optional
                            input.input(id='cityInputOnline' value=user.location.city || "")
                    .form-action
                        button(id="confirmLocation" style="width:auto")
                            span= t.info.confirm_location
        .social
            .social__container
                .social__box(data-name="emailPro")
                    if !user.isPremium
                        a(href="/subscription").get__premium= t.profile.get_premium
                    .social__logo
                        img(src="/images/logos/email-logo.webp" alt="Email logo")
                    .social__title= t.profile.social.email_pro
                    .social__field
                        input.input(placeholder=t.info.link_placeholder value=user.emailPro || "" disabled=(!user.isPremium))
                        button.btn__social-save
                            span= t.avail.save
                .social__box(data-name="phonePro")
                    if !user.isPremium
                        a(href="/subscription").get__premium= t.profile.get_premium
                    .social__logo
                        img(src="/images/logos/phone-logo.webp" alt="Phone logo")
                    .social__title= t.profile.social.phone_pro
                    .social__field
                        input.input(placeholder=t.info.link_placeholder value=user.phonePro || "" disabled=(!user.isPremium))
                        button.btn__social-save
                            span= t.avail.save
                .social__box(data-name="instagramLink")
                    if !user.isPremium
                        a(href="/subscription").get__premium= t.profile.get_premium
                    .social__logo
                        img(src="/images/logos/instagram-logo.webp" alt="Instagram logo")
                    .social__title= t.profile.social.instagram
                    .social__field
                        input.input(placeholder=t.info.link_placeholder value=user.instagramLink || "" disabled=(!user.isPremium))
                        button.btn__social-save
                            span= t.avail.save
                .social__box(data-name="whatsappLink")
                    if !user.isPremium
                        a(href="/subscription").get__premium= t.profile.get_premium
                    .social__logo
                        img(src="/images/logos/whatsapp-logo.webp" alt="Whatsapp logo")
                    .social__title= t.profile.social.whatsapp
                    .social__field
                        input.input(placeholder=t.info.link_placeholder value=user.whatsappLink || "" disabled=(!user.isPremium))
                        button.btn__social-save
                            span= t.avail.save
                .social__box(data-name="facebookLink")
                    if !user.isPremium
                        a(href="/subscription").get__premium= t.profile.get_premium
                    .social__logo
                        img(src="/images/logos/facebook-logo.webp" alt="Facebook logo")
                    .social__title= t.profile.social.facebook
                    .social__field
                        input.input(placeholder=t.info.link_placeholder value=user.facebookLink || "" disabled=(!user.isPremium))
                        button.btn__social-save
                            span= t.avail.save
                .social__box(data-name="website")
                    if !user.isPremium
                        a(href="/subscription").get__premium= t.profile.get_premium
                    .social__logo
                        img(src="/images/logos/website-logo.webp" alt="Website logo")
                    .social__title= t.profile.social.website
                    .social__field
                        input.input(placeholder=t.info.link_placeholder value=user.website || "" disabled=(!user.isPremium))
                        button.btn__social-save
                            span= t.avail.save
    +dialog()
    +prompt()


block scripts
    script(src='/js/layouts/informations.js')
    script(src='/js/templates/dialog.js' type="module")
    script(src='/js/templates/edit-email.js')
    script.
        const __services = !{JSON.stringify(services)};
        (function() {
            // ── Autocomplete business type ──
            const input = document.getElementById('businessTypeInput');
            const dropdown = document.getElementById('businessTypeDropdown');

            function normalize(str) {
                return str.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
            }
            function renderList(items) {
                dropdown.innerHTML = '';
                if (!items.length) { dropdown.style.display = 'none'; return; }
                items.forEach(function(item) {
                    const div = document.createElement('div');
                    div.className = 'service-dropdown__item';
                    div.textContent = item;
                    div.addEventListener('mousedown', function(e) {
                        e.preventDefault();
                        input.value = item;
                        dropdown.style.display = 'none';
                    });
                    dropdown.appendChild(div);
                });
                dropdown.style.display = 'block';
            }
            if (input && dropdown) {
                input.addEventListener('input', function() {
                    const q = normalize(input.value.trim());
                    if (!q) { dropdown.style.display = 'none'; return; }
                    renderList(__services.filter(s => normalize(s).includes(q)).slice(0, 8));
                });
                input.addEventListener('focus', function() {
                    const q = normalize(input.value.trim());
                    if (q) renderList(__services.filter(s => normalize(s).includes(q)).slice(0, 8));
                });
                input.addEventListener('blur', function() {
                    setTimeout(function() { dropdown.style.display = 'none'; }, 150);
                });
            }

            // ── Compteur description ──
            const textarea = document.getElementById('descriptionCoach');
            const counter  = document.getElementById('descCount');
            if (textarea && counter) {
                textarea.addEventListener('input', function() {
                    counter.textContent = textarea.value.length + '/500';
                });
            }

            // ── Enregistrer nom + description + type en une fois ──
            const saveBusinessInfo = document.getElementById('saveBusinessInfo');
            const businessNameInput = document.getElementById('businessNameInput');
            if (saveBusinessInfo) {
                saveBusinessInfo.addEventListener('click', async function() {
                    const btn = saveBusinessInfo;
                    const businessName = businessNameInput ? businessNameInput.value.trim() : '';
                    const description  = textarea ? textarea.value.trim() : '';
                    const businessType = input ? input.value.trim() : '';
                    const res = await fetch('/account/business-info', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ businessName, description, businessType })
                    });
                    const data = await res.json();
                    if (data.success) {
                        btn.querySelector('span').textContent = '✓ Enregistré';
                        setTimeout(() => { btn.querySelector('span').textContent = 'Enregistrer'; }, 2500);
                    }
                });
            }

            // ── Upload photo établissement ──
            const businessFileInput = document.getElementById('businessFileInput');
            const uploadBusinessBtn = document.getElementById('uploadBusinessBtn');
            const businessPicPreview = document.getElementById('businessPicPreview');

            if (uploadBusinessBtn && businessFileInput) {
                uploadBusinessBtn.addEventListener('click', function() { businessFileInput.click(); });
                businessFileInput.addEventListener('change', async function() {
                    const file = businessFileInput.files[0];
                    if (!file) return;

                    // Preview immédiat
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        if (businessPicPreview.tagName === 'IMG') {
                            businessPicPreview.src = e.target.result;
                        } else {
                            // Remplacer le placeholder par une vraie image
                            const img = document.createElement('img');
                            img.src = e.target.result;
                            img.alt = 'Photo établissement';
                            img.id = 'businessPicPreview';
                            businessPicPreview.replaceWith(img);
                        }
                    };
                    reader.readAsDataURL(file);

                    // Upload
                    const formData = new FormData();
                    formData.append('businessPicture', file);
                    const res = await fetch('/account/business-picture', { method: 'PATCH', body: formData });
                    await res.json();
                });
            }
        })();