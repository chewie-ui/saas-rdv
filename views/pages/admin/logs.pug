extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/layouts/history.css")
    link(rel="stylesheet", href="/css/layouts/logs.css")

block content
    .hist-page

        //- ── Filter bar ──────────────────────────────────────────────
        .hist-filters
            .hist-selects
                form#actionFilterForm(method="GET" action="/logs")
                    select.hist-select#actionFilter(name="action" onchange="this.form.submit()")
                        option(value="all" selected=selectedAction === 'all')= t.logs.all_actions
                        each opt in actionOptions
                            option(value=opt.value selected=selectedAction === opt.value)= opt.label

        .hist-table-wrap
            table.hist-table
                thead
                    tr
                        th= t.logs.col_date
                        th= t.logs.col_author
                        th= t.logs.col_action
                        th= t.logs.col_details
                tbody
                    if !logs || logs.length === 0
                        tr
                            td(colspan="4" style="padding:56px 24px;text-align:center;")
                                .hist-empty
                                    span.material-symbols-outlined(style="font-size:40px;opacity:.15;margin:0 auto 12px;display:block") description
                                    p(style="font-size:14px;font-weight:600;color:var(--text-secondary);margin:0 0 4px")= t.logs.empty_title
                                    p(style="font-size:13px;color:var(--text-muted);margin:0")= t.logs.empty_hint
                    each log in logs
                        - var d = new Date(log.createdAt)
                        - var dateStr = d.toLocaleDateString('fr-FR') + ' à ' + d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })
                        tr.hist-row
                            td.hist-td.hist-td--mono= dateStr
                            td.hist-td
                                span.log-actor(class=`log-actor--${log.role || 'owner'}`)= log.userName || t.logs.unknown_actor
                                if log.role
                                    span.log-role-badge= log.role === 'owner' ? t.logs.role_owner : log.role === 'manager' ? t.logs.role_manager : t.logs.role_staff
                            td.hist-td= log.actionLabel
                            td.hist-td.log-desc= log.description

            //- Pagination
            if totalPages > 1
                .hist-pagination
                    span.hist-pag-info #{t.logs.pagination_label} #{currentPage} / #{totalPages}
                    .hist-pag-btns
                        if currentPage > 1
                            a.hist-pag-btn(href=`/logs?page=${currentPage - 1}&action=${selectedAction}`)
                                span.material-symbols-outlined(style=`font-size:18px`) chevron_left
                        else
                            span.hist-pag-btn.disabled
                                span.material-symbols-outlined(style=`font-size:18px`) chevron_left
                        if currentPage < totalPages
                            a.hist-pag-btn(href=`/logs?page=${currentPage + 1}&action=${selectedAction}`)
                                span.material-symbols-outlined(style=`font-size:18px`) chevron_right
                        else
                            span.hist-pag-btn.disabled
                                span.material-symbols-outlined(style=`font-size:18px`) chevron_right
