extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/layouts/history.css")
    link(rel="stylesheet", href="/css/layouts/logs.css")

block content
    .hist-page

        //- ── Filter bar ──────────────────────────────────────────────
        .hist-filters
            .hist-selects
                form#actionFilterForm(method="GET" action="/logs")
                    select.hist-select#actionFilter(name="action" onchange="this.form.submit()")
                        option(value="all" selected=selectedAction === 'all') Toutes les actions
                        each opt in actionOptions
                            option(value=opt.value selected=selectedAction === opt.value)= opt.label

        .hist-table-wrap
            table.hist-table
                thead
                    tr
                        th Date
                        th Auteur
                        th Action
                        th Détails
                tbody
                    if !logs || logs.length === 0
                        tr
                            td(colspan="4" style="padding:56px 24px;text-align:center;")
                                .hist-empty
                                    svg(xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="currentColor" style="opacity:.15;margin-bottom:12px;display:block;margin:0 auto 12px")
                                        path(d="M320-240h320v-80H320v80Zm0-160h320v-80H320v80ZM240-80q-33 0-56.5-23.5T160-160v-640q0-33 23.5-56.5T240-880h320l240 240v480q0 33-23.5 56.5T720-80H240Z")
                                    p(style="font-size:14px;font-weight:600;color:var(--text-secondary);margin:0 0 4px") Aucune action enregistrée
                                    p(style="font-size:13px;color:var(--text-muted);margin:0") Les actions de votre équipe (services, RDV, collaborateurs...) apparaîtront ici.
                    each log in logs
                        - var d = new Date(log.createdAt)
                        - var dateStr = d.toLocaleDateString('fr-FR') + ' à ' + d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })
                        tr.hist-row
                            td.hist-td.hist-td--mono= dateStr
                            td.hist-td
                                span.log-actor(class=`log-actor--${log.role || 'owner'}`)= log.userName || 'Quelqu\'un'
                                if log.role
                                    span.log-role-badge= log.role === 'owner' ? 'Patron' : log.role === 'manager' ? 'Manager' : 'Staff'
                            td.hist-td= log.actionLabel
                            td.hist-td.log-desc= log.description

            //- Pagination
            if totalPages > 1
                .hist-pagination
                    span.hist-pag-info Page #{currentPage} / #{totalPages}
                    .hist-pag-btns
                        if currentPage > 1
                            a.hist-pag-btn(href=`/logs?page=${currentPage - 1}&action=${selectedAction}`)
                                svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                    path(d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z")
                        else
                            span.hist-pag-btn.disabled
                                svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                    path(d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z")
                        if currentPage < totalPages
                            a.hist-pag-btn(href=`/logs?page=${currentPage + 1}&action=${selectedAction}`)
                                svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                    path(d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z")
                        else
                            span.hist-pag-btn.disabled
                                svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                    path(d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z")
