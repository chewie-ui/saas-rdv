extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/components/admin/panel.admin.css")

block content
    -
        var companyName = currentCompany && currentCompany.name ? currentCompany.name : 'Studio'
        var companyInitials = companyName.split(' ').slice(0,2).map(function(w){return w[0]}).join('').toUpperCase() || 'BS'
        var dashStats = [
            { label: 'Revenue',      value: '€3 412', delta: '+12%', period: 'vs. last week', pts: '6,18 18,14 30,16 42,10 54,12 66,6 78,8 90,4' },
            { label: 'Bookings',     value: '47',     delta: '+8%',  period: 'this week',     pts: '6,16 18,14 30,18 42,12 54,8 66,10 78,6 90,4' },
            { label: 'Show-up rate', value: '96%',    delta: '+2pt', period: '30-day',        pts: '6,14 18,16 30,12 42,14 54,10 66,8 78,10 90,6' },
            { label: 'New clients',  value: '11',     delta: '+3',   period: 'this week',     pts: '6,18 18,12 30,14 42,8 54,12 66,6 78,8 90,4' }
        ]
        var activityFeed = [
            { type: 'New booking',   sub: 'Tanya Kim · Wed Jun 21 13:00',  when: '2m',  kind: 'accent' },
            { type: 'Cancelled',     sub: 'Pierre M. cancelled Tue 14:30', when: '12m', kind: 'danger' },
            { type: 'Review (5★)',   sub: '"Amazing!" — Camille D.',       when: '1h',  kind: 'warning' },
            { type: 'Reminder sent', sub: '12 SMS reminders for tomorrow', when: '2h',  kind: 'muted' },
            { type: 'New client',    sub: 'Iris V. created an account',    when: '3h',  kind: 'muted' }
        ]

    //- ── Greeting card ──────────────────────────────────────────
    .dash-greeting
        .dash-greeting__avatar= companyInitials
        .dash-greeting__text
            .dash-greeting__hello Good morning, #{companyName} ☀️
            .dash-greeting__sub Today's overview — stay on top of your day!
        .dash-greeting__btns
            button.sm-btn.sm-btn--ghost Today's view
            a.sm-btn.sm-btn--primary(href="/appointment/new")
                svg(xmlns="http://www.w3.org/2000/svg" height="14" viewBox="0 -960 960 960" width="14" fill="currentColor")
                    path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                span Quick book

    //- ── Stats grid ─────────────────────────────────────────────
    .dash-stats
        each s in dashStats
            .dash-stat-card
                .dash-stat-card__label= s.label
                .dash-stat-card__value= s.value
                .dash-stat-card__row
                    span.pill.pill--confirmed.pill--sm= s.delta
                    span.dash-stat-period= s.period
                svg.dash-sparkline(viewBox="0 0 100 24" width="100%" height="24" aria-hidden="true")
                    polyline(fill="none" stroke="var(--accent)" stroke-width="1.6" points=s.pts)
                    polyline(fill="var(--accent)" opacity="0.08" stroke="none" points=`6,24 ${s.pts} 90,24`)

    //- ── Main two-column grid ────────────────────────────────────
    .dash-grid

        //- Today's appointments
        .section__container.dash-appts
            .section__container-header
                .section__container-header__name
                    svg(xmlns="http://www.w3.org/2000/svg" height="18" viewBox="0 -960 960 960" width="18" fill="currentColor")
                        path(d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Z")
                    h3 Today's appointments
                .dash-appts__filter
                    span.pill.pill--default All staff ▾
            .dash-appts__body
                if appointments && appointments.length
                    each appt in appointments
                        .dash-appt-row
                            .dash-appt-row__time= appt.time
                            .dash-appt-row__info
                                .dash-appt-row__name= appt.clientName || appt.displayDate || 'Client'
                                .dash-appt-row__svc= appt.serviceName || '—'
                            span.pill(class=appt.status === 'pending' ? 'pill--no-show' : 'pill--confirmed')
                                span.pill__dot
                                | #{appt.status === 'pending' ? 'Pending' : 'Confirmed'}
                            a.sm-btn.sm-btn--ghost(href=`/appointment/${appt._id}`) Open →
                else
                    -
                        var sampleAppts = [
                            { time: '09:00', name: 'Sara Mehmet',     svc: 'Cut & blow-dry · 60 min',  status: 'confirmed' },
                            { time: '10:30', name: 'Benjamin Garcia', svc: 'Color refresh · 90 min',   status: 'confirmed' },
                            { time: '13:00', name: 'Tanya Kim',       svc: 'Curly cut consult · 75 min', status: 'pending' },
                            { time: '14:30', name: 'Joachim Lefèvre', svc: 'Cut · 45 min',             status: 'confirmed' },
                            { time: '16:30', name: 'Ana Reyes',       svc: 'Highlights · 120 min',     status: 'confirmed' }
                        ]
                    each appt in sampleAppts
                        .dash-appt-row
                            .dash-appt-row__time= appt.time
                            .dash-appt-row__info
                                .dash-appt-row__name= appt.name
                                .dash-appt-row__svc= appt.svc
                            span.pill(class=appt.status === 'pending' ? 'pill--no-show' : 'pill--confirmed')
                                span.pill__dot
                                | #{appt.status === 'pending' ? 'Pending' : 'Confirmed'}
                            a.sm-btn.sm-btn--ghost(href="#") Open →

        //- Latest activity
        .section__container.dash-activity
            .section__container-header
                .section__container-header__name
                    svg(xmlns="http://www.w3.org/2000/svg" height="18" viewBox="0 -960 960 960" width="18" fill="currentColor")
                        path(d="M160-200v-80h80v-280q0-83 50-147.5T420-792v-28q0-25 17.5-42.5T480-880q25 0 42.5 17.5T540-820v28q80 20 130 84.5T720-560v280h80v80H160Zm320-300Zm0 420q-33 0-56.5-23.5T400-160h160q0 33-23.5 56.5T480-80ZM320-280h320v-280q0-66-47-113t-113-47q-66 0-113 47t-47 113v280Z")
                    h3 Latest activity
                a.more(href="#") View all
            .dash-activity__body
                each act in activityFeed
                    .dash-act-row
                        .dash-act-row__dot(class=`dash-act-dot--${act.kind}`)
                        .dash-act-row__body
                            .dash-act-row__title= act.type
                            .dash-act-row__sub= act.sub
                        .dash-act-row__when= act.when

block scripts
