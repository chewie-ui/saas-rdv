extends ../../layouts/admin

block links
    link(rel="stylesheet" href="/css/components/admin/panel.admin.css")

block content

    //- ── Greeting ───────────────────────────────────────────────────────────
    .dash-greeting
        .dash-greeting__left
            .dash-greeting__avatar= initials
            .dash-greeting__text
                .dash-greeting__hello #{greeting}, #{companyName} 👋
                .dash-greeting__sub
                    | #{todayStr}
                    if nextAppt
                        span.dash-greeting__next  · Prochain RDV à #{nextAppt.startTime}
        .dash-greeting__btns
            a.sm-btn.sm-btn--ghost(href="/appointment") Voir le calendrier
            a.sm-btn.sm-btn--primary(href="/appointment/new")
                span.material-symbols-outlined(style=`font-size:14px`) add
                span Nouveau RDV

    //- ── Stat cards ─────────────────────────────────────────────────────────
    .dash-stats
        each s in stats
            .dash-stat-card
                .dash-stat-card__top
                    .dash-stat-card__icon(style=`color:${s.color};background:${s.color}18`)
                        span.material-symbols-outlined(style="font-size:18px")= s.icon
                    .dash-stat-card__label= s.label
                .dash-stat-card__value= s.value
                .dash-stat-card__row
                    if s.delta
                        span.dash-delta(class=s.delta.positive ? 'dash-delta--up' : 'dash-delta--down')= s.delta.label
                    span.dash-stat-period= s.period
                svg.dash-sparkline(viewBox="0 0 96 24" width="100%" height="28" preserveAspectRatio="none" aria-hidden="true")
                    polyline(fill="none" stroke=s.color stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" points=s.pts)
                    polygon(fill=s.color opacity="0.08" points=s.fillPts)

    //- ── Main grid ──────────────────────────────────────────────────────────
    .dash-grid

        //- Left column
        .dash-col

            //- Today's appointments
            .dash-card
                .dash-card__hd
                    .dash-card__hd-left
                        span.material-symbols-outlined(style=`font-size:17px`) calendar_month
                        h3 RDV aujourd'hui
                    a.dash-card__more(href="/appointment") Calendrier →
                .dash-card__body
                    if todayAppts && todayAppts.length
                        each a in todayAppts
                            .dash-appt-row
                                .dash-appt-row__time= a.startTime
                                .dash-appt-avatar= a.initials
                                .dash-appt-row__info
                                    .dash-appt-row__name= a.clientName
                                    .dash-appt-row__svc= a.serviceName || '—'
                                span.dash-status-pill(class=a.status === 'confirmed' ? 'dash-status-pill--confirmed' : 'dash-status-pill--canceled')
                                    = a.status === 'confirmed' ? 'Confirmé' : 'Annulé'
                                a.sm-btn.sm-btn--ghost.sm-btn--xs(href=`/history/edit/${a._id}`) Ouvrir
                    else
                        .dash-empty
                            span.material-symbols-outlined(style="font-size:32px;opacity:.25;margin-bottom:8px;display:block") calendar_month
                            | Aucun rendez-vous aujourd'hui

            //- Upcoming this week
            if upcomingAppts && upcomingAppts.length
                .dash-card
                    .dash-card__hd
                        .dash-card__hd-left
                            span.material-symbols-outlined(style=`font-size:17px`) schedule
                            h3 Prochains rendez-vous
                        a.dash-card__more(href="/appointment") Voir tout →
                    .dash-card__body
                        each a in upcomingAppts
                            .dash-upcoming-row
                                .dash-upcoming-row__date= a.dateStr
                                .dash-upcoming-row__time= a.startTime
                                .dash-upcoming-row__name= a.clientName
                                .dash-upcoming-row__svc= a.serviceName || '—'

        //- Right column
        .dash-col

            //- Recent bookings
            .dash-card
                .dash-card__hd
                    .dash-card__hd-left
                        span.material-symbols-outlined(style=`font-size:17px`) receipt_long
                        h3 Dernières réservations
                    a.dash-card__more(href="/history") Historique →
                .dash-card__body
                    if recentBookings && recentBookings.length
                        each b in recentBookings
                            .dash-recent-row
                                .dash-recent-row__info
                                    span.dash-recent-row__name= b.clientName
                                    span.dash-recent-row__date= b.dateStr
                                .dash-recent-row__svc= b.serviceName || '—'
                                span.dash-status-pill(class=b.status === 'confirmed' ? 'dash-status-pill--confirmed' : 'dash-status-pill--canceled')
                                    = b.status === 'confirmed' ? '✓' : '✕'
                    else
                        .dash-empty Aucune réservation récente

            //- Activity feed
            .dash-card
                .dash-card__hd
                    .dash-card__hd-left
                        span.material-symbols-outlined(style=`font-size:17px`) history
                        h3 Activité récente
                    a.dash-card__more(href="/logs") Voir les logs →
                .dash-card__body
                    if recentLogs && recentLogs.length
                        each l in recentLogs
                            .dash-act-row
                                .dash-act-row__dot(class=`dash-act-dot--${l.actionColor}`)
                                .dash-act-row__body
                                    .dash-act-row__title= l.description
                                    if l.userName
                                        .dash-act-row__sub= l.userName
                                .dash-act-row__when= l.ago
                    else
                        .dash-empty Aucune activité enregistrée
