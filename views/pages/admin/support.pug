extends ../../layouts/admin

block links
    link(rel="stylesheet" href="/css/layouts/informations.css")
    link(rel="stylesheet" href="/css/layouts/support.css")

block content
    .info-page
        .info-page__header
            h2= t.support.title
            p.info-page__subtitle= t.support.subtitle

        .support-search
            svg.support-search__icon(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                path(d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z")
            input#supportSearch.support-search__input(type="text" placeholder=t.support.search_placeholder)
            .support-search__results#searchResults

        //- ── Barre de chapitres — générée automatiquement depuis les sections ──
        -
            var _chapters = (sections && sections.length) ? sections.map(function(s){ return s.title; }) : [t.support.default_chapter_how, t.support.default_chapter_faq]
            _chapters.push(t.support.contact_chapter)
        .support-chapters
            each chapter, i in _chapters
                a.support-chapter-pill(href=`#chapter-${i}`)= chapter

        if sections && sections.length
            each section, i in sections
                .info-card.support-section(id=`chapter-${i}`)
                    .info-card__header
                        h3= section.title

                    if section.videos && section.videos.length
                        .support-video-grid
                            each video in section.videos
                                a.support-video-card(href=video.url || '#' target="_blank")
                                    .support-video-card__thumb 🎬
                                    .support-video-card__info
                                        .support-video-card__title= video.title
                                        .support-video-card__duration= video.duration || t.support.video_default_label

                    if section.faqs && section.faqs.length
                        .support-faq-list
                            each faq in section.faqs
                                .support-faq-item
                                    .support-faq-item__q
                                        span= faq.question
                                        svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                            path(d="M480-345 240-585l56-56 184 184 184-184 56 56-240 240Z")
                                    .support-faq-item__a !{faq.answer}
        else
            .info-card.support-section(id="chapter-0")
                .info-card__header
                    h3= t.support.default_chapter_how
                .support-video-grid
                    .support-video-card
                        .support-video-card__thumb 🎬
                        .support-video-card__info
                            .support-video-card__title= t.support.demo_video1_title
                            .support-video-card__duration= t.support.video_soon
                    .support-video-card
                        .support-video-card__thumb 🎬
                        .support-video-card__info
                            .support-video-card__title= t.support.demo_video2_title
                            .support-video-card__duration= t.support.video_soon

            .info-card.support-section(id="chapter-1")
                .info-card__header
                    h3= t.support.default_chapter_faq
                .support-faq-list
                    .support-faq-item
                        .support-faq-item__q
                            span= t.support.demo_faq1_q
                            svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                path(d="M480-345 240-585l56-56 184 184 184-184 56 56-240 240Z")
                        .support-faq-item__a!= t.support.demo_faq1_a
                    .support-faq-item
                        .support-faq-item__q
                            span= t.support.demo_faq2_q
                            svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                path(d="M480-345 240-585l56-56 184 184 184-184 56 56-240 240Z")
                        .support-faq-item__a!= t.support.demo_faq2_a
                    .support-faq-item
                        .support-faq-item__q
                            span= t.support.demo_faq3_q
                            svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                path(d="M480-345 240-585l56-56 184 184 184-184 56 56-240 240Z")
                        .support-faq-item__a!= t.support.demo_faq3_a
                    .support-faq-item
                        .support-faq-item__q
                            span= t.support.demo_faq4_q
                            svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                path(d="M480-345 240-585l56-56 184 184 184-184 56 56-240 240Z")
                        .support-faq-item__a= t.support.demo_faq4_a

        .info-card.support-section(id=`chapter-${_chapters.length - 1}`)
            .info-card__header
                h3= t.support.contact_chapter
            .support-contact-grid
                a.support-contact-card(href="mailto:quentin.rennies@gmail.com")
                    .support-contact-card__icon ✉️
                    .support-contact-card__label= t.support.email_label
                    .support-contact-card__sub quentin.rennies@gmail.com
                a.support-contact-card(href="https://wa.me/32477443988" target="_blank")
                    .support-contact-card__icon 💬
                    .support-contact-card__label= t.support.whatsapp_label
                    .support-contact-card__sub= t.support.whatsapp_sub
                a.support-contact-card(href="tel:+33600000000")
                    .support-contact-card__icon 📞
                    .support-contact-card__label= t.support.phone_label
                    .support-contact-card__sub= t.support.phone_sub

    script.
        window.__t_support = !{JSON.stringify(t.support)};

        // FAQ accordion
        document.querySelectorAll('.support-faq-item').forEach(function(item) {
            item.addEventListener('click', function() {
                var isOpen = item.classList.contains('open');
                document.querySelectorAll('.support-faq-item.open').forEach(function(o) { o.classList.remove('open'); });
                if (!isOpen) item.classList.add('open');
            });
        });

        // Chapters bar — highlight the chapter currently in view
        var chapterPills = Array.from(document.querySelectorAll('.support-chapter-pill'));
        var chapterSections = chapterPills.map(function(p) { return document.querySelector(p.getAttribute('href')); }).filter(Boolean);
        function updateActiveChapter() {
            var scrollPos = window.scrollY + 120;
            var activeIndex = 0;
            chapterSections.forEach(function(sec, i) {
                if (sec.offsetTop <= scrollPos) activeIndex = i;
            });
            chapterPills.forEach(function(p, i) { p.classList.toggle('is-active', i === activeIndex); });
        }
        if (chapterSections.length) {
            window.addEventListener('scroll', updateActiveChapter, { passive: true });
            updateActiveChapter();
        }

        // Build search index from DOM
        var searchIndex = [];
        document.querySelectorAll('.support-section').forEach(function(sec) {
            var sectionTitle = (sec.querySelector('.info-card__header h3') || {}).textContent || '';
            // Videos
            sec.querySelectorAll('.support-video-card').forEach(function(card) {
                var title = (card.querySelector('.support-video-card__title') || {}).textContent || '';
                var dur = (card.querySelector('.support-video-card__duration') || {}).textContent || '';
                if (title) searchIndex.push({ type: 'video', section: sectionTitle, label: title, sub: dur, el: card, faq: null });
            });
            // FAQs
            sec.querySelectorAll('.support-faq-item').forEach(function(item) {
                var q = (item.querySelector('.support-faq-item__q span') || {}).textContent || '';
                if (q) searchIndex.push({ type: 'faq', section: sectionTitle, label: q, sub: '', el: item, faq: item });
            });
        });

        var searchInput = document.getElementById('supportSearch');
        var resultsBox = document.getElementById('searchResults');
        var T = window.__t_support || {};

        function normalize(s) { return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); }

        searchInput.addEventListener('input', function() {
            var q = normalize(searchInput.value.trim());
            resultsBox.innerHTML = '';
            if (!q) { resultsBox.classList.remove('open'); return; }
            var hits = searchIndex.filter(function(r) { return normalize(r.label).includes(q) || normalize(r.section).includes(q); }).slice(0, 6);
            if (!hits.length) {
                var noResultText = (T.no_result || 'Aucun résultat pour "{query}"').replace('{query}', searchInput.value);
                resultsBox.innerHTML = '<div class="support-search__no-result">' + noResultText + '</div>';
                resultsBox.classList.add('open');
                return;
            }
            hits.forEach(function(hit) {
                var div = document.createElement('div');
                div.className = 'support-search__result-item';
                var typeLabel = hit.type === 'faq' ? ('❓ ' + (T.type_faq || 'Question fréquente')) : ('🎬 ' + (T.type_video || 'Vidéo') + (hit.sub ? ' · ' + hit.sub : ''));
                div.innerHTML = '<div class="support-search__result-item__section">' + hit.section + '</div>' +
                    '<div class="support-search__result-item__label">' + hit.label + '</div>' +
                    '<div class="support-search__result-item__type">' + typeLabel + '</div>';
                div.addEventListener('click', function() {
                    searchInput.value = '';
                    resultsBox.classList.remove('open');
                    hit.el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    if (hit.faq) {
                        document.querySelectorAll('.support-faq-item.open').forEach(function(o) { o.classList.remove('open'); });
                        hit.faq.classList.add('open');
                        hit.faq.classList.add('highlight');
                        setTimeout(function() { hit.faq.classList.remove('highlight'); }, 2000);
                    }
                });
                resultsBox.appendChild(div);
            });
            resultsBox.classList.add('open');
        });

        document.addEventListener('click', function(e) {
            if (!document.querySelector('.support-search').contains(e.target)) {
                resultsBox.classList.remove('open');
            }
        });

