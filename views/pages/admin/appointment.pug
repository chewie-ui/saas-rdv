extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/components/admin/appointment.admin.css")

block content
    .calendar
        .calendar__menu
            .calendar__sections.flex-c.space-b
                .calendar__section.calendar__section--left
                    //- Mini month calendar trigger (desktop)
                    .mini-cal-wrapper
                        button.mini-cal-trigger#miniCalTrigger(type="button" aria-label="Open month calendar")
                            svg(xmlns="http://www.w3.org/2000/svg" height="22px" viewBox="0 -960 960 960" width="22px" fill="currentColor")
                                path(d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Zm0 0v-80 80Zm280 240q-17 0-28.5-11.5T440-480q0-17 11.5-28.5T480-520q17 0 28.5 11.5T520-480q0 17-11.5 28.5T480-440Zm-160 0q-17 0-28.5-11.5T280-480q0-17 11.5-28.5T320-520q17 0 28.5 11.5T360-480q0 17-11.5 28.5T320-440Zm320 0q-17 0-28.5-11.5T600-480q0-17 11.5-28.5T640-520q17 0 28.5 11.5T680-480q0 17-11.5 28.5T640-440ZM480-280q-17 0-28.5-11.5T440-320q0-17 11.5-28.5T480-360q17 0 28.5 11.5T520-320q0 17-11.5 28.5T480-280Zm-160 0q-17 0-28.5-11.5T280-320q0-17 11.5-28.5T320-360q17 0 28.5 11.5T360-320q0 17-11.5 28.5T320-280Zm320 0q-17 0-28.5-11.5T600-320q0-17 11.5-28.5T640-360q17 0 28.5 11.5T680-320q0 17-11.5 28.5T640-280Z")
                        //- Dropdown mini calendar
                        .mini-cal-dropdown#miniCalDropdown
                            .mini-cal-header
                                button.mini-cal-nav#miniCalPrev(type="button" aria-label="Mois précédent")
                                    svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                        path(d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z")
                                span.mini-cal-title#miniCalTitle
                                button.mini-cal-nav#miniCalNext(type="button" aria-label="Mois suivant")
                                    svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                        path(d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z")
                            .mini-cal-grid
                                .mini-cal-daynames
                                    span= t.days_abbr.monday
                                    span= t.days_abbr.tuesday
                                    span= t.days_abbr.wednesday
                                    span= t.days_abbr.thursday
                                    span= t.days_abbr.friday
                                    span= t.days_abbr.saturday
                                    span= t.days_abbr.sunday
                                .mini-cal-days#miniCalDays

                .calendar__section.calendar__section--center
                    .calendar__date.flex-c
                        a.calendar__today-btn.btn(href="/appointment").sec= t.bk.today
                        .calendar__date-btn.calendar__date-btn--previous.flex-c(data-direction="prev" aria-label="Previous")
                            svg(xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3")
                                path(d="M400-80 0-480l400-400 71 71-329 329 329 329-71 71Z")
                        .calendar__date-text.calendar__date-text--week= weekLabel
                        .calendar__date-text.calendar__date-text--day
                            span.calendar__date-text-weekday= focusedDayName
                            span.calendar__date-text-date= focusedDayDate
                        .calendar__date-btn.calendar__date-btn--next.flex-c(data-direction="next" aria-label="Next")
                            svg(xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3")
                                path(d="m321-80-71-71 329-329-329-329 71-71 400 400L321-80Z")
                .calendar__section.calendar__section--right
                    .calendar__actions.flex

        .calendar__week-strip
            each weekday in weekDays
                a.calendar__week-day(href=`/appointment?date=${weekday.isoDate}` class=[weekday.isToday && "today", weekday.isFocused && "focused"])
                    span.calendar__week-day-label= weekday.initial
                    span.calendar__week-day-number= weekday.dayNumber

    .calendar-section
        .grid-section
            //- Current time indicator
            #current-time-line.calendar-timeline(style="display:none")
                .timeline-circle
            .cell.time-header GMT-5
            each weekday in weekDays
                .cell.day-header(class=[weekday.isToday && "today", weekday.isFocused && "focused"]) #{weekday.label}, #{weekday.date}

            each hour in hours
                .cell.time= hour
                each day, dayIndex in weekDays
                    .cell.day(class=day.isFocused ? "focused" : "")
                        each appointment in appointments
                            if appointment.isoDate === day.iso.split("T")[0] && appointment.startHour === hour
                                a.appointment(href=`/appointement/${appointment._id}` class={ canceled: appointment.status === 'canceled' })
                                    if appointment.status === "canceled"
                                        .appointment-canceled= t.appt.canceled
                                    .appointment-name= appointment.name
                                    .appointment-time.xs-comment
                                        | #{appointment.startHour} - #{appointment.endHour}


block scripts
    script(src="/js/layouts/appointment.js" type="module")
