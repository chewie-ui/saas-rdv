extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/components/admin/appointment.admin.css")
    link(rel="stylesheet", href="/css/layouts/history-edit.css")

block content
    .calendar
        .calendar__menu
            .calendar__sections
                //- ── Left: mini-calendar ──
                .calendar__section.calendar__section--left
                    .mini-cal-wrapper
                        button.cal-icon-btn#miniCalTrigger(type="button" aria-label="Open month calendar")
                            svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                                path(d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Zm0 0v-80 80Zm280 240q-17 0-28.5-11.5T440-480q0-17 11.5-28.5T480-520q17 0 28.5 11.5T520-480q0 17-11.5 28.5T480-440Zm-160 0q-17 0-28.5-11.5T280-480q0-17 11.5-28.5T320-520q17 0 28.5 11.5T360-480q0 17-11.5 28.5T320-440Zm320 0q-17 0-28.5-11.5T600-480q0-17 11.5-28.5T640-520q17 0 28.5 11.5T680-480q0 17-11.5 28.5T640-440ZM480-280q-17 0-28.5-11.5T440-320q0-17 11.5-28.5T480-360q17 0 28.5 11.5T520-320q0 17-11.5 28.5T480-280Zm-160 0q-17 0-28.5-11.5T280-320q0-17 11.5-28.5T320-360q17 0 28.5 11.5T360-320q0 17-11.5 28.5T320-280Zm320 0q-17 0-28.5-11.5T600-320q0-17 11.5-28.5T640-360q17 0 28.5 11.5T680-320q0 17-11.5 28.5T640-280Z")
                        .mini-cal-dropdown#miniCalDropdown
                            .mini-cal-header
                                button.cal-icon-btn#miniCalPrev(type="button" aria-label="Mois précédent")
                                    svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                        path(d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z")
                                span.mini-cal-title#miniCalTitle
                                button.cal-icon-btn#miniCalNext(type="button" aria-label="Mois suivant")
                                    svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                        path(d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z")
                            .mini-cal-grid
                                .mini-cal-daynames
                                    span= t.days_abbr.monday
                                    span= t.days_abbr.tuesday
                                    span= t.days_abbr.wednesday
                                    span= t.days_abbr.thursday
                                    span= t.days_abbr.friday
                                    span= t.days_abbr.saturday
                                    span= t.days_abbr.sunday
                                .mini-cal-days#miniCalDays

                //- ── Center: date navigation ──
                .calendar__section.calendar__section--center
                    a.cal-today-btn.sm-btn.sm-btn--primary(href=`/appointment?view=${view}`)
                        svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                            path(d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Z")
                        span= t.bk.today
                    .cal-nav-group
                        if view === 'month'
                            a.cal-nav-btn(href=`/appointment?date=${prevMonthIso}&employee=${employeeFilter}&view=month` aria-label="Mois précédent")
                                svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                    path(d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z")
                        else
                            button.cal-nav-btn.calendar__date-btn.calendar__date-btn--previous(data-direction="prev" aria-label="Previous")
                                svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                    path(d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z")
                        .cal-date-label
                            if view === 'month'
                                span.cal-date-week= monthLabel
                            else
                                span.cal-date-week= weekLabel
                                .cal-date-day
                                    span.cal-date-weekday= focusedDayName
                                    span.cal-date-daynum= focusedDayDate
                        if view === 'month'
                            a.cal-nav-btn(href=`/appointment?date=${nextMonthIso}&employee=${employeeFilter}&view=month` aria-label="Mois suivant")
                                svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                    path(d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z")
                        else
                            button.cal-nav-btn.calendar__date-btn.calendar__date-btn--next(data-direction="next" aria-label="Next")
                                svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                    path(d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z")

                //- ── Right: view toggle + employee filter ──
                .calendar__section.calendar__section--right
                    //- Vue semaine / mois (desktop uniquement)
                    .cal-view-toggle
                        a.cal-view-btn(href=`/appointment?date=${focusedIso}&employee=${employeeFilter}&view=week` class=(view === 'week' ? 'is-active' : ''))
                            svg(viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                line(x1="3" y1="6" x2="21" y2="6")
                                line(x1="3" y1="12" x2="21" y2="12")
                                line(x1="3" y1="18" x2="21" y2="18")
                            span Semaine
                        a.cal-view-btn(href=`/appointment?date=${focusedIso}&employee=${employeeFilter}&view=month` class=(view === 'month' ? 'is-active' : ''))
                            svg(viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                rect(x="3" y="3" width="18" height="18" rx="2")
                                line(x1="3" y1="9" x2="21" y2="9")
                                line(x1="9" y1="9" x2="9" y2="21")
                                line(x1="15" y1="9" x2="15" y2="21")
                            span Mois

                    //- Employee filter
                    if employees && employees.length > 0
                        .emp-filter-wrap
                            select.emp-filter-select#empFilterSelect
                                option(value="all" selected=(employeeFilter === 'all')) Tous les employés
                                each emp in employees
                                    - var empFilterLabel = emp.firstName + ' ' + emp.lastName
                                    option(value=String(emp._id) selected=(employeeFilter === String(emp._id)))= empFilterLabel.length > 40 ? empFilterLabel.slice(0, 40) + '…' : empFilterLabel

        if services && services.length > 0 && services.some(s => s.color)
        .calendar__legend#calendarLegend
            each svc in services
                if svc.color
                    span.calendar__legend-item
                        span.calendar__legend-dot(style=`background:${svc.color}`)
                        = svc.name

    .calendar__week-strip(class=(view === 'month' ? 'u-hidden-month' : ''))
            each weekday in weekDays
                a.calendar__week-day(href=`/appointment?date=${weekday.isoDate}&employee=${employeeFilter}` class=[weekday.isToday && "today", weekday.isFocused && "focused", weekday.isDayOff && "off-day"])
                    span.calendar__week-day-label= weekday.initial
                    span.calendar__week-day-number= weekday.dayNumber
                    if weekday.fillStatus && !weekday.isDayOff
                        span.fill-dot(class=`fill-dot--${weekday.fillStatus}`)
                    if weekday.isDayOff
                        span.calendar__week-day-off Off

    //- ── Vue Mois ─────────────────────────────────────────────────────────────
    if view === 'month'
        .cal-month
            .cal-month__daynames
                span Lun
                span Mar
                span Mer
                span Jeu
                span Ven
                span Sam
                span Dim
            .cal-month__grid
                each d in monthDays
                    a.cal-month__cell(
                        href=`/appointment?date=${d.iso}&employee=${employeeFilter}`
                        class=[(d.isToday ? 'is-today' : ''), (!d.current ? 'is-other-month' : ''), (d.iso === focusedIso ? 'is-focused' : '')]
                    )
                        span.cal-month__day= d.day
                        if d.colorCounts && d.colorCounts.length > 0
                            .cal-month__counts
                                each cc in d.colorCounts
                                    span.cal-month__count(style=(cc.color ? `background:${cc.color}` : ''))= cc.count

    //- ── Vue Semaine (masquée en mode mois) ─────────────────────────────────
    .calendar-section(class=(view === 'month' ? 'u-hidden-month' : ''))
        .grid-section
            //- Current time indicator
            #current-time-line.calendar-timeline(style="display:none")
                .timeline-circle
            .cell.time-header GMT+1
            each weekday in weekDays
                .cell.day-header(class=[weekday.isToday && "today", weekday.isFocused && "focused", weekday.isDayOff && "off-day"])
                    .dh-inner
                        span.dh-name= weekday.label
                        span.dh-num= weekday.dayNumber
                    if weekday.isDayOff
                        span.dh-off Off

            each hour in hours
                - const isHalf = hour.split(':')[1] !== '00'
                .cell.time(class=isHalf ? 'time--half' : '' data-time=hour)
                    if !isHalf
                        = hour
                each day, dayIndex in weekDays
                    .cell.day(class=[day.isFocused && "focused", isHalf && "day--half", day.isDayOff && "off-day"])
                        - var cellAppts = appointments.filter(a => a.isoDate === day.isoDate && a.startHour === hour)
                        if cellAppts.length >= 2
                            //- 2+ bookings: pills side-by-side (or summary if 4+)
                            - var maxSlot = cellAppts.reduce(function(mx, a){ return Math.max(mx, a.slotTime || 30); }, 0)
                            - var wrapH = Math.max(Math.round(maxSlot / 30 * 52) - 4, 20)
                            if cellAppts.length > 3
                                //- 4+ → summary pill linking to day view
                                a.appt-pill.appt-pill--summary(href=`/appointment?date=${day.isoDate}` style=`height:${wrapH}px`)
                                    .appt-pill__avatars
                                        each appt, i in cellAppts
                                            if i < 3
                                                img.appt-pill__photo(src=appt.employeePhoto alt="" title=appt.employeeName)
                                        .appt-pill__extra +#{cellAppts.length - 3}
                                    span.appt-pill__label= cellAppts.length + ' RDV · ' + hour
                            else
                                .appt-multi-wrap(style=`height:${wrapH}px`)
                                    each appointment in cellAppts
                                        if appointment.isExternal
                                            .appt-pill.appt-pill--external(title="Indisponible — autre événement")
                                                span.appt-pill__name Autre événement
                                                span.appt-pill__time= appointment.startHour
                                        else
                                            - var canColor = appointment.serviceColor && appointment.status !== 'canceled' && appointment.status !== 'pending' && appointment.status !== 'no-show'
                                            div.appt-pill(
                                                role="button" tabindex="0"
                                                class={ 'appt-pill--canceled': appointment.status === 'canceled' }
                                                style=(canColor ? `background:${appointment.serviceColor}` : '')
                                                data-id=String(appointment._id)
                                                data-name=appointment.name
                                                data-surname=(appointment.surname || '')
                                                data-start=appointment.startHour
                                                data-end=appointment.endHour
                                                data-employee=(appointment.employeeName || '')
                                                data-photo=(appointment.employeePhoto || '')
                                                data-service=(appointment.serviceName || '')
                                                data-color=(appointment.serviceColor || '')
                                                data-status=(appointment.status || '')
                                                data-date=appointment.isoDate
                                            )
                                                span.appt-pill__name= appointment.name
                                                span.appt-pill__time= appointment.startHour
                        else if cellAppts.length === 1
                            - var appointment = cellAppts[0]
                            - var apptH = Math.max(Math.round((appointment.slotTime || 30) / 30 * 52) - 4, 20)
                            if appointment.isExternal
                                .appt-pill.appt-pill--external(style=`height:${apptH}px` title="Indisponible — autre événement")
                                    span.appt-pill__name Autre événement
                                    span.appt-pill__time= appointment.startHour + '–' + appointment.endHour
                            else
                                - var canColor = appointment.serviceColor && appointment.status !== 'canceled' && appointment.status !== 'pending' && appointment.status !== 'no-show'
                                div.appt-pill(
                                    role="button" tabindex="0"
                                    class={ 'appt-pill--canceled': appointment.status === 'canceled' }
                                    style=`height:${apptH}px;` + (canColor ? `background:${appointment.serviceColor}` : '')
                                    data-id=String(appointment._id)
                                    data-name=appointment.name
                                    data-surname=(appointment.surname || '')
                                    data-start=appointment.startHour
                                    data-end=appointment.endHour
                                    data-employee=(appointment.employeeName || '')
                                    data-photo=(appointment.employeePhoto || '')
                                    data-service=(appointment.serviceName || '')
                                    data-color=(appointment.serviceColor || '')
                                    data-status=(appointment.status || '')
                                    data-date=appointment.isoDate
                                )
                                    img.appt-pill__photo(src=appointment.employeePhoto alt="" title=appointment.employeeName)
                                    span.appt-pill__name= appointment.name + ' ' + (appointment.surname || '')
                                    span.appt-pill__time= appointment.startHour

    //- ── Appointment popup (Google Calendar style) ──
    #apptPopup.appt-popup
        .appt-popup__toolbar
            button.appt-popup__tool-btn#apptPopupEdit(type="button" title="Modifier")
                svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                    path(d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z")
            button.appt-popup__tool-btn.appt-popup__tool-btn--danger#apptPopupDelete(type="button" title="Supprimer")
                svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                    path(d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z")
            button.appt-popup__tool-btn#apptPopupClose(type="button" title="Fermer")
                svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                    path(d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z")
        .appt-popup__body
            .appt-popup__color-dot#apptPopupDot
            .appt-popup__info
                h3.appt-popup__title#apptPopupTitle
                p.appt-popup__datetime#apptPopupDatetime
                .appt-popup__meta
                    .appt-popup__meta-row#apptPopupEmployeeRow
                        svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                            path(d="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Z")
                        span#apptPopupEmployeeName
                    .appt-popup__meta-row#apptPopupServiceRow
                        svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                            path(d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z")
                        span#apptPopupServiceName
                .appt-popup__canceled-badge#apptPopupCanceled= t.appt.canceled
        .appt-popup__footer#apptPopupFooter
            a.appt-popup__detail-btn#apptPopupDetailBtn(href="#")
                svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                    path(d="M440-280h80v-240h-80v240Zm40-320q17 0 28.5-11.5T520-640q0-17-11.5-28.5T480-680q-17 0-28.5 11.5T440-640q0 17 11.5 28.5T480-600Zm0 520q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z")
                | Voir le détail

    //- ── Nouveau rendez-vous (panel admin) ──────────────────────────────────
    .new-appt-overlay#newApptOverlay
        .new-appt-modal#newApptModal
            .new-appt-modal__head
                h3 Nouveau rendez-vous
                button.new-appt-modal__close#newApptClose(type="button" aria-label="Fermer")
                    svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                        path(d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z")
            .new-appt-modal__body
                .edit-fields-row.two-col
                    .field-container.flex.col
                        label Date *
                        input.input(type="date" id="newApptDate")
                    .field-container.flex.col
                        label Heure *
                        input.input(type="time" id="newApptTime")

                if services && services.length > 0
                    .edit-fields-row
                        .field-container.flex.col
                            label Service
                            select.input#newApptService
                                option(value="") — Aucun service —
                                each svc in services
                                    option(value=String(svc._id) data-duration=svc.duration)= svc.name.length > 40 ? svc.name.slice(0, 40) + '…' : svc.name

                if employees && employees.length > 0
                    .edit-fields-row
                        .field-container.flex.col
                            label Employé
                            select.input#newApptEmployee
                                option(value="") — Aucun employé —
                                each emp in employees
                                    - var empLabel = emp.firstName + ' ' + emp.lastName
                                    option(value=String(emp._id))= empLabel.length > 40 ? empLabel.slice(0, 40) + '…' : empLabel

                .edit-fields-row.two-col
                    .field-container.flex.col
                        label Prénom *
                        input.input(type="text" id="newApptName" placeholder="Prénom")
                    .field-container.flex.col
                        label Nom
                        input.input(type="text" id="newApptSurname" placeholder="Nom")
                .edit-fields-row.two-col
                    .field-container.flex.col
                        label Email *
                        input.input(type="email" id="newApptEmail" placeholder="email@example.com")
                    .field-container.flex.col
                        label Téléphone
                        input.input(type="tel" id="newApptPhone" placeholder="+32 456 00 00 00")
                .edit-fields-row
                    .field-container.flex.col
                        label Message
                        textarea.input.textarea#newApptMessage(rows="3" placeholder="...")

                p.new-appt-modal__error#newApptError(style="display:none")
            .new-appt-modal__actions
                button.sm-btn.sm-btn--ghost#newApptCancel(type="button") Annuler
                button.sm-btn.sm-btn--primary#newApptSubmit(type="button")
                    span Créer le rendez-vous

block scripts
    script(src="/js/layouts/appointment.js" type="module")
