extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/layouts/history.css")
    link(rel="stylesheet", href="/css/layouts/history-edit.css")

block content
    - var initials = ((results.name || '').charAt(0) + (results.surname || '').charAt(0)).toUpperCase()

    .page.page--history-edit
        //- Back button + Delete button
        .edit-top-bar
            a.edit-back-btn(href="javascript:history.back()")
                svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px")
                    path(d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z")
                span= t.hist_edit.back
            button.sm-btn.sm-btn--danger#deleteHistoryBtn(type="button")
                svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                    path(d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-272h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z")
                span Supprimer ce rendez-vous

        .edit-layout

            //- ── Left summary card (sticky) ──
            .edit-sidebar
                .edit-sidebar__card
                    .edit-sidebar__avatar
                        span= initials || '?'
                    .edit-sidebar__name
                        h3= (results.name || '') + ' ' + (results.surname || '')
                        p= results.email

                    .edit-sidebar__divider

                    .edit-sidebar__meta
                        .edit-sidebar__meta-row
                            svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px")
                                path(d="M224.62-120q-27.62 0-46.12-18.5Q160-157 160-184.62v-510.76q0-27.62 18.5-46.12Q197-760 224.62-760h70.76v-89.23h43.08V-760h286.16v-89.23h40V-760h70.76q27.62 0 46.12 18.5Q800-723 800-695.38v510.76q0 27.62-18.5 46.12Q763-120 735.38-120H224.62Zm0-40h510.76q9.24 0 16.93-7.69 7.69-7.69 7.69-16.93v-350.76H200v350.76q0 9.24 7.69 16.93 7.69 7.69 16.93 7.69ZM200-575.39h560v-119.99q0-9.24-7.69-16.93-7.69-7.69-16.93-7.69H224.62q-9.24 0-16.93 7.69-7.69 7.69-7.69 16.93v119.99Zm0 0V-720-575.39Z")
                            span= results.date.toLocaleDateString("fr-FR")

                        .edit-sidebar__meta-row
                            svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px")
                                path(d="M480-120q-75 0-140.5-28.5t-114-77q-48.5-48.5-77-114T120-480q0-75 28.5-140.5t77-114q48.5-48.5 114-77T480-840q75 0 140.5 28.5t114 77q48.5 48.5 77 114T840-480q0 75-28.5 140.5t-77 114q-48.5 48.5-114 77T480-120Zm0-40q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Zm24 160v-165l-92-54-20 34 72 43v142h40Z")
                            span #{results.startTime} – #{results.endTime}

                    .edit-sidebar__divider

                    //- Status toggle
                    .edit-sidebar__status-label= t.hist_edit.status
                    .edit-sidebar__status-toggle
                        button.status-pill(
                            type="button"
                            class=(results.status === 'confirmed' ? 'active confirmed' : '')
                            data-value="confirmed"
                        )
                            span= t.hist_edit.status_confirmed
                        button.status-pill(
                            type="button"
                            class=(results.status === 'canceled' ? 'active canceled' : '')
                            data-value="canceled"
                        )
                            span= t.hist_edit.status_canceled

                    input(type="hidden" id="editStatus" value=results.status)

            //- ── Right form content ──
            .edit-content

                //- Section: Rendez-vous
                .edit-section
                    .edit-section__header
                        .edit-section__icon
                            svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px")
                                path(d="M224.62-120q-27.62 0-46.12-18.5Q160-157 160-184.62v-510.76q0-27.62 18.5-46.12Q197-760 224.62-760h70.76v-89.23h43.08V-760h286.16v-89.23h40V-760h70.76q27.62 0 46.12 18.5Q800-723 800-695.38v510.76q0 27.62-18.5 46.12Q763-120 735.38-120H224.62Zm0-40h510.76q9.24 0 16.93-7.69 7.69-7.69 7.69-16.93v-350.76H200v350.76q0 9.24 7.69 16.93 7.69 7.69 16.93 7.69ZM200-575.39h560v-119.99q0-9.24-7.69-16.93-7.69-7.69-16.93-7.69H224.62q-9.24 0-16.93 7.69-7.69 7.69-7.69 16.93v119.99Zm0 0V-720-575.39Z")
                        h3= t.hist_edit.section_appointment
                    .edit-section__body
                        .edit-fields-row
                            .field-container.flex.col
                                label= t.hist_edit.date
                                //- Custom calendar picker
                                .datepicker-wrap
                                    input(type="hidden" id="editDate" value=results.date.toISOString().split('T')[0])
                                    button.datepicker-trigger(type="button" id="datepickerTrigger")
                                        svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                            path(d="M224.62-120q-27.62 0-46.12-18.5Q160-157 160-184.62v-510.76q0-27.62 18.5-46.12Q197-760 224.62-760h70.76v-89.23h43.08V-760h286.16v-89.23h40V-760h70.76q27.62 0 46.12 18.5Q800-723 800-695.38v510.76q0 27.62-18.5 46.12Q763-120 735.38-120H224.62Zm0-40h510.76q9.24 0 16.93-7.69 7.69-7.69 7.69-16.93v-350.76H200v350.76q0 9.24 7.69 16.93 7.69 7.69 16.93 7.69ZM200-575.39h560v-119.99q0-9.24-7.69-16.93-7.69-7.69-16.93-7.69H224.62q-9.24 0-16.93 7.69-7.69 7.69-7.69 16.93v119.99Zm0 0V-720-575.39Z")
                                        span#datepickerDisplay= results.date.toLocaleDateString("fr-FR", {weekday:"long", year:"numeric", month:"long", day:"numeric"})
                                    .datepicker-popup(id="datepickerPopup" style="display:none")
                                        .datepicker-header
                                            button.datepicker-nav(type="button" id="dpPrevMonth")
                                                svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                                    path(d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z")
                                            span.datepicker-month-label(id="dpMonthLabel")
                                            button.datepicker-nav(type="button" id="dpNextMonth")
                                                svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor")
                                                    path(d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z")
                                        .datepicker-weekdays
                                            span L
                                            span M
                                            span M
                                            span J
                                            span V
                                            span S
                                            span D
                                        .datepicker-days(id="dpDays")
                        .edit-fields-row.two-col
                            .field-container.flex.col
                                label= t.hist_edit.start_time
                                input.input(type="time" value=results.startTime id="editStartTime")
                            .field-container.flex.col
                                label= t.hist_edit.end_time
                                input.input(type="time" value=results.endTime id="editEndTime")

                        //- Service selector + info chips
                        if services && services.length > 0
                            .edit-fields-row
                                .field-container.flex.col
                                    label Service
                                    .svc-select-row
                                        select.input#editService
                                            option(value="") — Aucun service —
                                            each svc in services
                                                - var svcId = String(svc._id)
                                                - var currentSvcId = results.service ? String(results.service) : ''
                                                option(value=svcId data-name=svc.name data-duration=svc.duration data-price=(svc.price || '') selected=(currentSvcId === svcId))= svc.name.length > 40 ? svc.name.slice(0, 40) + '…' : svc.name
                                    .svc-info-chips#svcInfoChips(style="display:none")
                                        .svc-chip#svcDurationChip
                                            svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                                path(d="M480-120q-75 0-140.5-28.5t-114-77q-48.5-48.5-77-114T120-480q0-75 28.5-140.5t77-114q48.5-48.5 114-77T480-840q75 0 140.5 28.5t114 77q48.5 48.5 77 114T840-480q0 75-28.5 140.5t-77 114q-48.5 48.5-114 77T480-120Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Zm24 160v-165l-92-54-20 34 72 43v142h40Z")
                                            span#svcDurationLabel —
                                        .svc-chip#svcPriceChip(style="display:none")
                                            svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                                                path(d="M441-120v-86q-53-12-91.5-46T293-348l74-30q15 48 44.5 73t77.5 25q41 0 69.5-18.5T587-356q0-35-22-55.5T463-463q-77-27-109.5-58.5T321-600q0-41 24.5-74.5T419-717v-83h44v83q50 8 82.5 36.5T589-600l-71 29q-8-30-29.5-56T418-651q-38 0-62 19.5T332-584q0 32 23.5 52.5T445-474q68 22 102.5 57T582-324q0 57-37.5 91T441-194v74h-44v-82Z")
                                            span#svcPriceLabel —

                        //- Employee selector
                        if employees && employees.length > 0
                            .edit-fields-row
                                .field-container.flex.col
                                    label Employé
                                    select.input#editEmployee
                                        option(value="") — Aucun employé —
                                        each emp in employees
                                            - var empId = String(emp._id)
                                            - var currentEmpId = results.employee ? String(results.employee._id || results.employee) : ''
                                            - var empLabel = emp.firstName + ' ' + emp.lastName
                                            option(value=empId selected=(currentEmpId === empId))= empLabel.length > 40 ? empLabel.slice(0, 40) + '…' : empLabel

                //- Section: Client
                .edit-section
                    .edit-section__header
                        .edit-section__icon
                            svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px")
                                path(d="M480-492.31q-57.75 0-98.87-41.12Q340-574.56 340-632.31q0-57.75 41.13-98.87 41.12-41.13 98.87-41.13 57.75 0 98.87 41.13Q620-690.06 620-632.31q0 57.75-41.13 98.88Q537.75-492.31 480-492.31ZM170-180v-57.85q0-29.61 15.96-54.42 15.96-24.81 42.58-38.35 59.15-29.07 119.3-43.61Q407.99-388.77 480-388.77t132.16 14.54q60.15 14.54 119.3 43.61 26.62 13.54 42.58 38.35Q790-267.46 790-237.85V-180H170Z")
                        h3= t.hist_edit.section_client
                    .edit-section__body
                        .edit-fields-row.two-col
                            .field-container.flex.col
                                label= t.hist_edit.name
                                input.input(value=results.name id="editName" placeholder="Prénom")
                            .field-container.flex.col
                                label= t.hist_edit.surname
                                input.input(value=results.surname id="editSurname" placeholder="Nom")
                        .edit-fields-row.two-col
                            .field-container.flex.col
                                label= t.hist_edit.email
                                input.input(type="email" value=results.email id="editEmail" placeholder="email@example.com")
                            .field-container.flex.col
                                label= t.hist_edit.phone
                                input.input(type="tel" value=(results.phone || '') id="editPhone" placeholder="+32 456 00 00 00")
                        .edit-fields-row
                            .field-container.flex.col
                                label= t.hist_edit.message
                                textarea.input.textarea#editMessage(rows="3" placeholder="...")= results.message || ''

                //- Section: Notes admin
                .edit-section
                    .edit-section__header
                        .edit-section__icon
                            svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px")
                                path(d="M200-200h57l391-391-57-57-391 391v57Zm-40 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T857-647L330-120H160Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z")
                        h3= t.hist_edit.admin_notes
                    .edit-section__body
                        .edit-fields-row
                            .field-container.flex.col
                                textarea.input.textarea#editAdminNotes(
                                    rows="4"
                                    placeholder=t.hist_edit.admin_notes_placeholder
                                )= results.adminNotes || ''

                //- Section: Réponses au formulaire (si présentes)
                if results.formAnswers && results.formAnswers.length > 0
                    .edit-section
                        .edit-section__header
                            .edit-section__icon
                                svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px")
                                    path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Zm-20 200v-40q0-33 10-56t36-49l44-44q14-14 21-29t7-32q0-34-22.5-57T480-640q-38 0-62 22t-31 58l-76-16q12-54 54-88t115-34q67 0 110.5 38.5T634-550q0 29-10 52.5T593-452l-47 44q-14 13-20 29t-6 35v40H460Zm20 120q-17 0-28.5-11.5T440-200q0-17 11.5-28.5T480-240q17 0 28.5 11.5T520-200q0 17-11.5 28.5T480-160Z")
                            h3= t.hist_edit.section_form_answers
                        .edit-section__body
                            .form-answers-list
                                each answer in results.formAnswers
                                    .form-answer-item
                                        p.form-answer-question= answer.question
                                        p.form-answer-value= answer.answer || '–'

        //- Sticky action bar
        .edit-actions-bar
            button.sm-btn.sm-btn--ghost(type="button" onclick="history.back()")
                span= t.hist_edit.back
            button.sm-btn.sm-btn--primary#saveBtnEdit(type="button")
                svg.save-icon(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px")
                    path(d="M840-680v480q0 33-23.5 56.5T760-120H200q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h480l160 160Zm-80 34L646-760H200v560h560v-446ZM480-240q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35ZM240-560h360v-160H240v160Zm-40-86v446-560 114Z")
                span#saveBtnLabel= t.hist_edit.save

    //- ── Conflict modal ──────────────────────────────────────────────────────
    .conflict-overlay(id="conflictOverlay" style="display:none")
        .conflict-modal(id="conflictModal")
            .conflict-modal__icon
                svg(xmlns="http://www.w3.org/2000/svg" height="32px" viewBox="0 -960 960 960" width="32px" fill="currentColor")
                    path(d="m40-120 440-760 440 760H40Zm138-80h604L480-720 178-200Zm302-40q17 0 28.5-11.5T520-280q0-17-11.5-28.5T480-320q-17 0-28.5 11.5T440-280q0 17 11.5 28.5T480-240Zm-40-120h80v-200h-80v200Zm40-100Z")
            h3.conflict-modal__title Conflit de rendez-vous détecté
            p.conflict-modal__desc Le créneau choisi est déjà occupé par les rendez-vous suivants :
            ul.conflict-list(id="conflictList")
            .conflict-modal__warning
                svg(xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" fill="currentColor")
                    path(d="M480-280q17 0 28.5-11.5T520-320q0-17-11.5-28.5T480-360q-17 0-28.5 11.5T440-320q0 17 11.5 28.5T480-280Zm-40-160h80v-240h-80v240Z")
                span Forcer la sauvegarde supprimera définitivement ces rendez-vous.
            .conflict-modal__actions
                button.sm-btn.sm-btn--ghost(type="button" id="conflictCancel") Annuler
                button.sm-btn.sm-btn--danger(type="button" id="conflictForce")
                    svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                        path(d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-272h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z")
                    span Forcer et supprimer les conflits

block scripts
    script(src="/js/layouts/history.js" type="module")
    script.
        // ── Supprimer le rendez-vous ──────────────────────────────────────────
        (function() {
            var btn = document.getElementById('deleteHistoryBtn');
            if (!btn) return;
            var bookingId = window.__bookingId || '!{results._id}';

            btn.addEventListener('click', function() {
                // Même popup que sur la page calendrier
                var existing = document.getElementById('__deleteModal');
                if (existing) existing.remove();

                var overlay = document.createElement('div');
                overlay.id = '__deleteModal';
                overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.45);backdrop-filter:blur(4px);z-index:99999;display:flex;align-items:center;justify-content:center;padding:16px;';
                overlay.innerHTML = '<style>' +
                    '@keyframes __dfadeIn{from{opacity:0}to{opacity:1}}' +
                    '@keyframes __dslidein{from{opacity:0;transform:scale(.94) translateY(8px)}to{opacity:1;transform:scale(1) translateY(0)}}' +
                    '#__deleteModal .dm{background:#fff;border-radius:20px;max-width:420px;width:100%;box-shadow:0 24px 48px -8px rgba(0,0,0,.22);display:flex;flex-direction:column;gap:0;overflow:hidden;animation:__dslidein .18s cubic-bezier(.34,1.4,.64,1)}' +
                    '#__deleteModal .dm__head{padding:24px 24px 0;display:flex;align-items:flex-start;justify-content:space-between;gap:12px}' +
                    '#__deleteModal .dm__icon-wrap{width:44px;height:44px;border-radius:50%;background:#fef2f2;border:1px solid #fecaca;display:flex;align-items:center;justify-content:center;flex-shrink:0}' +
                    '#__deleteModal .dm__icon-wrap svg{stroke:#dc2626}' +
                    '#__deleteModal .dm__close{background:none;border:none;cursor:pointer;color:#9ca3af;width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;transition:background .15s,color .15s;flex-shrink:0;padding:0}' +
                    '#__deleteModal .dm__close:hover{background:#f3f4f6;color:#111}' +
                    '#__deleteModal .dm__body{padding:16px 24px 0;display:flex;flex-direction:column;gap:6px}' +
                    '#__deleteModal .dm__title{font-size:17px;font-weight:700;color:#111;margin:0}' +
                    '#__deleteModal .dm__desc{font-size:13.5px;color:#6b7280;line-height:1.55;margin:0}' +
                    '#__deleteModal .dm__actions{padding:20px 24px 24px;display:flex;gap:8px;justify-content:flex-end}' +
                    '#__deleteModal .dm__cancel{display:inline-flex;align-items:center;justify-content:center;padding:9px 18px;border-radius:10px;font-size:13.5px;font-weight:600;background:#f3f4f6;border:1px solid #e5e7eb;color:#4b5563;cursor:pointer;font-family:inherit;transition:background .15s}' +
                    '#__deleteModal .dm__cancel:hover{background:#e9eaec}' +
                    '#__deleteModal .dm__confirm{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:9px 20px;border-radius:10px;font-size:13.5px;font-weight:700;background:#dc2626;border:none;color:#fff;cursor:pointer;font-family:inherit;box-shadow:0 1px 3px rgba(220,38,38,.3);transition:background .15s}' +
                    '#__deleteModal .dm__confirm:hover{background:#b91c1c}' +
                    '#__deleteModal .dm__confirm.loading{opacity:.6;cursor:wait;pointer-events:none}' +
                    '</style>' +
                    '<div class="dm">' +
                    '<div class="dm__head"><div class="dm__icon-wrap"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6M14 11v6"></path><path d="M9 6V4h6v2"></path></svg></div>' +
                    '<button class="dm__close" aria-label="Fermer"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button></div>' +
                    '<div class="dm__body"><p class="dm__title">Supprimer ce rendez-vous ?</p><p class="dm__desc">Cette action est irréversible. Le rendez-vous sera définitivement supprimé.</p></div>' +
                    '<div class="dm__actions"><button class="dm__cancel">Annuler</button><button class="dm__confirm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path></svg>Supprimer</button></div>' +
                    '</div>';

                function close() { overlay.remove(); }
                overlay.addEventListener('click', function(e) { if (e.target === overlay) close(); });
                overlay.querySelector('.dm__close').addEventListener('click', close);
                overlay.querySelector('.dm__cancel').addEventListener('click', close);
                overlay.querySelector('.dm__confirm').addEventListener('click', async function() {
                    this.classList.add('loading');
                    this.textContent = 'Suppression…';
                    try {
                        var res  = await fetch('/appointment/' + bookingId + '/delete', { method: 'DELETE' });
                        var data = await res.json();
                        close();
                        if (data.success) { window.location.href = '/history'; }
                        else alert(data.message || 'Erreur lors de la suppression.');
                    } catch(e) { close(); alert('Erreur réseau.'); }
                });

                document.body.appendChild(overlay);
                document.addEventListener('keydown', function onKey(e) {
