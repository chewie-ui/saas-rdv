block scripts
    script(src="/js/layouts/history.js" type="module")
    script.
        // ── Popups génériques (confirm / alert) ────────────────────────────────
        (function() {
            function buildModal(opts) {
                var existing = document.getElementById('__customModal');
                if (existing) existing.remove();

                var overlay = document.createElement('div');
                overlay.id = '__customModal';
                overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.45);backdrop-filter:blur(4px);z-index:99999;display:flex;align-items:center;justify-content:center;padding:16px;';

                var iconBg   = opts.danger ? '#fef2f2' : '#eff6ff';
                var iconBorder = opts.danger ? '#fecaca' : '#bfdbfe';
                var iconColor  = opts.danger ? '#dc2626' : '#2563eb';
                var confirmBg  = opts.danger ? '#dc2626' : '#2563eb';
                var confirmBgHover = opts.danger ? '#b91c1c' : '#1d4ed8';
                var confirmShadow  = opts.danger ? 'rgba(220,38,38,.3)' : 'rgba(37,99,235,.3)';

                var iconSvg = opts.alertOnly
                    ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="' + iconColor + '" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'
                    : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="' + iconColor + '" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';

                overlay.innerHTML = '<style>' +
                    '@keyframes __cmslidein{from{opacity:0;transform:scale(.94) translateY(8px)}to{opacity:1;transform:scale(1) translateY(0)}}' +
                    '#__customModal .cm{background:#fff;border-radius:20px;max-width:420px;width:100%;box-shadow:0 24px 48px -8px rgba(0,0,0,.22);display:flex;flex-direction:column;gap:0;overflow:hidden;animation:__cmslidein .18s cubic-bezier(.34,1.4,.64,1)}' +
                    '#__customModal .cm__head{padding:24px 24px 0;display:flex;align-items:flex-start;justify-content:space-between;gap:12px}' +
                    '#__customModal .cm__icon-wrap{width:44px;height:44px;border-radius:50%;background:' + iconBg + ';border:1px solid ' + iconBorder + ';display:flex;align-items:center;justify-content:center;flex-shrink:0}' +
                    '#__customModal .cm__close{background:none;border:none;cursor:pointer;color:#9ca3af;width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;transition:background .15s,color .15s;flex-shrink:0;padding:0}' +
                    '#__customModal .cm__close:hover{background:#f3f4f6;color:#111}' +
                    '#__customModal .cm__body{padding:16px 24px 0;display:flex;flex-direction:column;gap:6px}' +
                    '#__customModal .cm__title{font-size:17px;font-weight:700;color:#111;margin:0}' +
                    '#__customModal .cm__desc{font-size:13.5px;color:#6b7280;line-height:1.55;margin:0}' +
                    '#__customModal .cm__actions{padding:20px 24px 24px;display:flex;gap:8px;justify-content:flex-end}' +
                    '#__customModal .cm__cancel{display:inline-flex;align-items:center;justify-content:center;padding:9px 18px;border-radius:10px;font-size:13.5px;font-weight:600;background:#f3f4f6;border:1px solid #e5e7eb;color:#4b5563;cursor:pointer;font-family:inherit;transition:background .15s}' +
                    '#__customModal .cm__cancel:hover{background:#e9eaec}' +
                    '#__customModal .cm__confirm{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:9px 20px;border-radius:10px;font-size:13.5px;font-weight:700;background:' + confirmBg + ';border:none;color:#fff;cursor:pointer;font-family:inherit;box-shadow:0 1px 3px ' + confirmShadow + ';transition:background .15s}' +
                    '#__customModal .cm__confirm:hover{background:' + confirmBgHover + '}' +
                    '</style>' +
                    '<div class="cm">' +
                    '<div class="cm__head"><div class="cm__icon-wrap">' + iconSvg + '</div>' +
                    '<button class="cm__close" aria-label="#{t.hist_edit.generic_cancel}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button></div>' +
                    '<div class="cm__body"><p class="cm__title">' + opts.title + '</p><p class="cm__desc">' + opts.desc + '</p></div>' +
                    '<div class="cm__actions">' +
                    (opts.alertOnly ? '' : '<button class="cm__cancel">' + (opts.cancelLabel || '#{t.hist_edit.generic_cancel}') + '</button>') +
                    '<button class="cm__confirm">' + opts.confirmLabel + '</button>' +
                    '</div></div>';

                return overlay;
            }

            window.__alertModal = function(desc, title) {
                return new Promise(function(resolve) {
                    var overlay = buildModal({
                        title: title || '#{t.hist_edit.generic_info_title}',
                        desc: desc,
                        confirmLabel: '#{t.hist_edit.generic_ok}',
                        alertOnly: true,
                    });
                    function close() { overlay.remove(); resolve(); }
                    overlay.addEventListener('click', function(e) { if (e.target === overlay) close(); });
                    overlay.querySelector('.cm__close').addEventListener('click', close);
                    overlay.querySelector('.cm__confirm').addEventListener('click', close);
                    document.body.appendChild(overlay);
                    document.addEventListener('keydown', function onKey(e) {
                        if (e.key === 'Escape') { close(); document.removeEventListener('keydown', onKey); }
                    });
                });
            };

            window.__confirmModal = function(desc, opts) {
                opts = opts || {};
                return new Promise(function(resolve) {
                    var overlay = buildModal({
                        title: opts.title || '#{t.hist_edit.generic_confirm_title}',
                        desc: desc,
                        confirmLabel: opts.confirmLabel || '#{t.hist_edit.generic_confirm}',
                        cancelLabel: opts.cancelLabel || '#{t.hist_edit.generic_cancel}',
                        danger: opts.danger || false,
                    });
                    function close(result) { overlay.remove(); resolve(result); }
                    overlay.addEventListener('click', function(e) { if (e.target === overlay) close(false); });
                    overlay.querySelector('.cm__close').addEventListener('click', function() { close(false); });
                    overlay.querySelector('.cm__cancel').addEventListener('click', function() { close(false); });
                    overlay.querySelector('.cm__confirm').addEventListener('click', function() { close(true); });
                    document.body.appendChild(overlay);
                    document.addEventListener('keydown', function onKey(e) {
                        if (e.key === 'Escape') { close(false); document.removeEventListener('keydown', onKey); }
                    });
                });
            };
        })();
    script.
        // ── Supprimer le rendez-vous ──────────────────────────────────────────
        (function() {
            var btn = document.getElementById('deleteHistoryBtn');
            if (!btn) return;
            var bookingId = window.__bookingId || '!{results._id}';

            btn.addEventListener('click', function() {
                // Même popup que sur la page calendrier
                var existing = document.getElementById('__deleteModal');
                if (existing) existing.remove();

                var overlay = document.createElement('div');
                overlay.id = '__deleteModal';
                overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.45);backdrop-filter:blur(4px);z-index:99999;display:flex;align-items:center;justify-content:center;padding:16px;';
                overlay.innerHTML = '<style>' +
                    '@keyframes __dfadeIn{from{opacity:0}to{opacity:1}}' +
                    '@keyframes __dslidein{from{opacity:0;transform:scale(.94) translateY(8px)}to{opacity:1;transform:scale(1) translateY(0)}}' +
                    '#__deleteModal .dm{background:#fff;border-radius:20px;max-width:420px;width:100%;box-shadow:0 24px 48px -8px rgba(0,0,0,.22);display:flex;flex-direction:column;gap:0;overflow:hidden;animation:__dslidein .18s cubic-bezier(.34,1.4,.64,1)}' +
                    '#__deleteModal .dm__head{padding:24px 24px 0;display:flex;align-items:flex-start;justify-content:space-between;gap:12px}' +
                    '#__deleteModal .dm__icon-wrap{width:44px;height:44px;border-radius:50%;background:#fef2f2;border:1px solid #fecaca;display:flex;align-items:center;justify-content:center;flex-shrink:0}' +
                    '#__deleteModal .dm__icon-wrap svg{stroke:#dc2626}' +
                    '#__deleteModal .dm__close{background:none;border:none;cursor:pointer;color:#9ca3af;width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;transition:background .15s,color .15s;flex-shrink:0;padding:0}' +
                    '#__deleteModal .dm__close:hover{background:#f3f4f6;color:#111}' +
                    '#__deleteModal .dm__body{padding:16px 24px 0;display:flex;flex-direction:column;gap:6px}' +
                    '#__deleteModal .dm__title{font-size:17px;font-weight:700;color:#111;margin:0}' +
                    '#__deleteModal .dm__desc{font-size:13.5px;color:#6b7280;line-height:1.55;margin:0}' +
                    '#__deleteModal .dm__actions{padding:20px 24px 24px;display:flex;gap:8px;justify-content:flex-end}' +
                    '#__deleteModal .dm__cancel{display:inline-flex;align-items:center;justify-content:center;padding:9px 18px;border-radius:10px;font-size:13.5px;font-weight:600;background:#f3f4f6;border:1px solid #e5e7eb;color:#4b5563;cursor:pointer;font-family:inherit;transition:background .15s}' +
                    '#__deleteModal .dm__cancel:hover{background:#e9eaec}' +
                    '#__deleteModal .dm__confirm{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:9px 20px;border-radius:10px;font-size:13.5px;font-weight:700;background:#dc2626;border:none;color:#fff;cursor:pointer;font-family:inherit;box-shadow:0 1px 3px rgba(220,38,38,.3);transition:background .15s}' +
                    '#__deleteModal .dm__confirm:hover{background:#b91c1c}' +
                    '#__deleteModal .dm__confirm.loading{opacity:.6;cursor:wait;pointer-events:none}' +
                    '</style>' +
                    '<div class="dm">' +
                    '<div class="dm__head"><div class="dm__icon-wrap"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6M14 11v6"></path><path d="M9 6V4h6v2"></path></svg></div>' +
                    '<button class="dm__close" aria-label="#{t.hist_edit.generic_cancel}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button></div>' +
                    '<div class="dm__body"><p class="dm__title">' + window.__deleteModalTitle + '</p><p class="dm__desc">' + window.__deleteModalDesc + '</p></div>' +
                    '<div class="dm__actions"><button class="dm__cancel">#{t.hist_edit.generic_cancel}</button><button class="dm__confirm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path></svg>#{t.hist_edit.delete_modal_confirm}</button></div>' +
                    '</div>';

                function close() { overlay.remove(); }
                overlay.addEventListener('click', function(e) { if (e.target === overlay) close(); });
                overlay.querySelector('.dm__close').addEventListener('click', close);
                overlay.querySelector('.dm__cancel').addEventListener('click', close);
                overlay.querySelector('.dm__confirm').addEventListener('click', async function() {
                    this.classList.add('loading');
                    this.textContent = '#{t.hist_edit.deleting_label}';
                    try {
                        var res  = await fetch('/appointment/' + bookingId + '/delete', { method: 'DELETE' });
                        var data = await res.json();
                        close();
                        if (data.success) { window.location.href = '/history'; }
                        else window.__alertModal(data.message || "#{t.hist_edit.delete_error}");
                    } catch(e) { close(); window.__alertModal('#{t.hist_edit.network_error}'); }
                });

                document.body.appendChild(overlay);
                document.addEventListener('keydown', function onKey(e) {
                    if (e.key === 'Escape') { close(); document.removeEventListener('keydown', onKey); }
                });
            });
        })();

        // ── Formulaire moyen de reversement ─────────────────────────────────
        (function() {
            var editLink   = document.getElementById('payoutEditLink');
            var form       = document.getElementById('payoutForm');
            var methodSel  = document.getElementById('payoutMethod');
            var saveBtn    = document.getElementById('payoutSaveBtn');
            var cancelBtn  = document.getElementById('payoutCancelBtn');
            var detailIban   = document.getElementById('payoutDetailIban');
            var detailPaypal = document.getElementById('payoutDetailPaypal');
            var detailOther  = document.getElementById('payoutDetailOther');
            if (!editLink || !form) return;

            function showDetail(method) {
                [detailIban, detailPaypal, detailOther].forEach(function(el) { if (el) el.style.display = 'none'; });
                if (method === 'bank_transfer' && detailIban) detailIban.style.display = '';
                if (method === 'paypal' && detailPaypal) detailPaypal.style.display = '';
                if (method === 'other' && detailOther) detailOther.style.display = '';
            }

            editLink.addEventListener('click', function(e) {
                e.preventDefault();
                editLink.style.display = 'none';
                form.style.display = 'flex';
                if (methodSel) showDetail(methodSel.value);
            });
            if (methodSel) {
                methodSel.addEventListener('change', function() { showDetail(this.value); });
            }
            if (cancelBtn) {
                cancelBtn.addEventListener('click', function() {
                    form.style.display = 'none';
                    editLink.style.display = '';
                });
            }
            if (saveBtn) {
                saveBtn.addEventListener('click', async function() {
                    var method = methodSel ? methodSel.value : '';
                    if (!method) { alert('Veuillez choisir un moyen de paiement.'); return; }
                    var payload = { method: method };
                    var ibanEl = document.getElementById('payoutIban');
                    var bicEl  = document.getElementById('payoutBic');
                    var ppEl   = document.getElementById('payoutPaypalEmail');
                    var otEl   = document.getElementById('payoutOther');
                    if (method === 'bank_transfer') { payload.iban = ibanEl ? ibanEl.value.trim() : ''; payload.bic = bicEl ? bicEl.value.trim() : ''; }
                    if (method === 'paypal')        { payload.paypalEmail = ppEl ? ppEl.value.trim() : ''; }
                    if (method === 'other')         { payload.other = otEl ? otEl.value.trim() : ''; }
                    saveBtn.disabled = true;
                    saveBtn.textContent = 'Enregistrement…';
                    try {
                        var r = await fetch('/api/company/payout-info', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                        var d = await r.json();
                        if (d.success) { location.reload(); }
                        else { alert(d.error || 'Erreur lors de l\'enregistrement.'); saveBtn.disabled = false; saveBtn.textContent = 'Enregistrer'; }
                    } catch(e) { alert('Erreur réseau.'); saveBtn.disabled = false; saveBtn.textContent = 'Enregistrer'; }
                });
            }
        })();
    script.
        window.__servicesData = !{JSON.stringify(services || [])};
        window.__bookingId    = '!{results._id}';
        window.__deleteModalTitle = !{JSON.stringify(t.hist_edit.delete_modal_title)};
        window.__deleteModalDesc  = !{JSON.stringify(t.hist_edit.delete_modal_desc)};
    script.
        (function() {
            const bookId = '!{results._id}';

            // ── Marquer une absence (no-show) ───────────────────────────────────
            const noShowBtn     = document.getElementById('noShowBtn');
            const noShowChoices = document.getElementById('noShowChoices');
            const noShowCancel  = document.getElementById('noShowCancel');
            const noShowValid   = document.getElementById('noShowValid');
            const noShowInvalid = document.getElementById('noShowInvalid');

            if (noShowBtn && noShowChoices) {
                noShowBtn.addEventListener('click', () => {
                    noShowBtn.style.display = 'none';
                    noShowChoices.style.display = 'flex';
                });
            }
            if (noShowCancel) {
                noShowCancel.addEventListener('click', () => {
                    noShowChoices.style.display = 'none';
                    noShowBtn.style.display = '';
                });
            }

            async function submitNoShow(reason, btn) {
                const amount = btn.dataset.amount;
                if (reason === 'invalid' && amount) {
                    if (!(await window.__confirmModal(`#{t.hist_edit.charge_question}`.replace('{amount}', amount), { title: "#{t.hist_edit.charge_confirm_title}", confirmLabel: '#{t.hist_edit.charge_confirm_btn}', danger: true }))) return;
                } else if (reason === 'invalid') {
                    if (!(await window.__confirmModal('#{t.hist_edit.mark_invalid_question}', { title: '#{t.hist_edit.generic_confirm_title}', confirmLabel: '#{t.hist_edit.generic_confirm}', danger: true }))) return;
                }

                noShowChoices.querySelectorAll('button').forEach(b => b.disabled = true);
                btn.querySelector('span').textContent = '#{t.hist_edit.processing_label}';

                try {
                    const res  = await fetch(`/appointment/${bookId}/no-show`, {
                        method:  'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body:    JSON.stringify({ reason })
                    });
                    const data = await res.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        await window.__alertModal(data.error || "#{t.hist_edit.processing_error}", '#{t.hist_edit.generic_info_title}');
                        noShowChoices.querySelectorAll('button').forEach(b => b.disabled = false);
                        btn.querySelector('span').textContent = reason === 'invalid'
                            ? (amount ? `#{t.hist_edit.noshow_invalid_charge}`.replace('{amount}', amount) : '#{t.hist_edit.noshow_invalid}')
                            : '#{t.hist_edit.noshow_valid}';
                    }
                } catch (e) {
                    await window.__alertModal('#{t.hist_edit.network_error}', '#{t.hist_edit.generic_info_title}');
                    noShowChoices.querySelectorAll('button').forEach(b => b.disabled = false);
                }
            }

            if (noShowValid)   noShowValid.addEventListener('click',   () => submitNoShow('valid',   noShowValid));
            if (noShowInvalid) noShowInvalid.addEventListener('click', () => submitNoShow('invalid', noShowInvalid));

            // ── Revue des frais d'annulation prélevés automatiquement ───────────
            const cancelReviewBtn     = document.getElementById('cancelReviewBtn');
            const cancelReviewChoices = document.getElementById('cancelReviewChoices');
            const cancelReviewCancel  = document.getElementById('cancelReviewCancel');
            const cancelReviewRefund  = document.getElementById('cancelReviewRefund');
            const cancelReviewKeep    = document.getElementById('cancelReviewKeep');

            if (cancelReviewBtn && cancelReviewChoices) {
                cancelReviewBtn.addEventListener('click', () => {
                    cancelReviewBtn.style.display = 'none';
                    cancelReviewChoices.style.display = 'flex';
                });
            }
            if (cancelReviewCancel) {
                cancelReviewCancel.addEventListener('click', () => {
                    cancelReviewChoices.style.display = 'none';
                    cancelReviewBtn.style.display = '';
                });
            }

            async function submitCancelReview(decision, btn) {
                if (decision === 'refunded' && !(await window.__confirmModal("#{t.hist_edit.refund_question}", { title: '#{t.hist_edit.refund_confirm_title}', confirmLabel: '#{t.hist_edit.refund_confirm_btn}' }))) return;
                if (decision === 'kept' && !(await window.__confirmModal("#{t.hist_edit.keep_question}", { title: '#{t.hist_edit.generic_confirm_title}', confirmLabel: '#{t.hist_edit.generic_confirm}', danger: true }))) return;

                cancelReviewChoices.querySelectorAll('button').forEach(b => b.disabled = true);
                btn.querySelector('span').textContent = '#{t.hist_edit.processing_label}';

                try {
                    const res  = await fetch(`/appointment/${bookId}/review-cancellation`, {
                        method:  'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body:    JSON.stringify({ decision })
                    });
                    const data = await res.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        await window.__alertModal(data.error || "#{t.hist_edit.processing_error}", '#{t.hist_edit.generic_info_title}');
                        cancelReviewChoices.querySelectorAll('button').forEach(b => b.disabled = false);
                        btn.querySelector('span').textContent = decision === 'refunded'
                            ? '#{t.hist_edit.cancel_fee_refund}'
                            : '#{t.hist_edit.cancel_fee_keep}';
                    }
                } catch (e) {
                    await window.__alertModal('#{t.hist_edit.network_error}', '#{t.hist_edit.generic_info_title}');
                    cancelReviewChoices.querySelectorAll('button').forEach(b => b.disabled = false);
                }
            }

            if (cancelReviewRefund) cancelReviewRefund.addEventListener('click', () => submitCancelReview('refunded', cancelReviewRefund));
            if (cancelReviewKeep)   cancelReviewKeep.addEventListener('click',   () => submitCancelReview('kept',     cancelReviewKeep));

            // ── Envoyer un rappel manuellement ──────────────────────────────────
            const sendReminderBtn = document.getElementById('sendReminderBtn');
            if (sendReminderBtn) {
                sendReminderBtn.addEventListener('click', async () => {
                    const confirmed = await window.__confirmModal(
                        "#{t.hist_edit.send_reminder_question}",
                        { title: "#{t.hist_edit.send_reminder_title}", confirmLabel: '#{t.hist_edit.send_reminder_confirm}' }
                    );
                    if (!confirmed) return;

                    const origHtml = sendReminderBtn.innerHTML;
                    sendReminderBtn.disabled = true;
                    sendReminderBtn.querySelector('span').textContent = '#{t.hist_edit.sending_label}';

                    try {
                        const res = await fetch(`/appointment/${bookId}/send-reminder`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await res.json();
                        if (data.success) {
                            location.reload();
                        } else {
                            await window.__alertModal(data.message || data.error || "#{t.hist_edit.send_error}", '#{t.hist_edit.generic_info_title}');
                            sendReminderBtn.disabled = false;
                            sendReminderBtn.innerHTML = origHtml;
                        }
                    } catch (e) {
                        await window.__alertModal('#{t.hist_edit.network_error}', '#{t.hist_edit.generic_info_title}');
                        sendReminderBtn.disabled = false;
                        sendReminderBtn.innerHTML = origHtml;
                    }
                });
            }
        })();
