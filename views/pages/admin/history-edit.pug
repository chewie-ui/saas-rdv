extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/layouts/history.css")
    link(rel="stylesheet", href="/css/layouts/history-edit.css")

block content
    - var initials = ((results.name || '').charAt(0) + (results.surname || '').charAt(0)).toUpperCase()

    .page.page--history-edit
        //- Back button
        a.edit-back-btn(href="javascript:history.back()")
            svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px")
                path(d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z")
            span= t.hist_edit.back

        .edit-layout

            //- ── Left summary card (sticky) ──
            .edit-sidebar
                .edit-sidebar__card
                    .edit-sidebar__avatar
                        span= initials || '?'
                    .edit-sidebar__name
                        h3= (results.name || '') + ' ' + (results.surname || '')
                        p= results.email

                    .edit-sidebar__divider

                    .edit-sidebar__meta
                        .edit-sidebar__meta-row
                            svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px")
                                path(d="M224.62-120q-27.62 0-46.12-18.5Q160-157 160-184.62v-510.76q0-27.62 18.5-46.12Q197-760 224.62-760h70.76v-89.23h43.08V-760h286.16v-89.23h40V-760h70.76q27.62 0 46.12 18.5Q800-723 800-695.38v510.76q0 27.62-18.5 46.12Q763-120 735.38-120H224.62Zm0-40h510.76q9.24 0 16.93-7.69 7.69-7.69 7.69-16.93v-350.76H200v350.76q0 9.24 7.69 16.93 7.69 7.69 16.93 7.69ZM200-575.39h560v-119.99q0-9.24-7.69-16.93-7.69-7.69-16.93-7.69H224.62q-9.24 0-16.93 7.69-7.69 7.69-7.69 16.93v119.99Zm0 0V-720-575.39Z")
                            span= results.date.toLocaleDateString("fr-FR")

                        .edit-sidebar__meta-row
                            svg(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px")
                                path(d="M480-120q-75 0-140.5-28.5t-114-77q-48.5-48.5-77-114T120-480q0-75 28.5-140.5t77-114q48.5-48.5 114-77T480-840q75 0 140.5 28.5t114 77q48.5 48.5 77 114T840-480q0 75-28.5 140.5t-77 114q-48.5 48.5-114 77T480-120Zm0-40q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Zm24 160v-165l-92-54-20 34 72 43v142h40Z")
                            span #{results.startTime} – #{results.endTime}

                    .edit-sidebar__divider

                    //- Status toggle
                    .edit-sidebar__status-label= t.hist_edit.status
                    .edit-sidebar__status-toggle
                        button.status-pill(
                            type="button"
                            class=(results.status === 'confirmed' ? 'active confirmed' : '')
                            data-value="confirmed"
                        )
                            span= t.hist_edit.status_confirmed
                        button.status-pill(
                            type="button"
                            class=(results.status === 'canceled' ? 'active canceled' : '')
                            data-value="canceled"
                        )
                            span= t.hist_edit.status_canceled

                    input(type="hidden" id="editStatus" value=results.status)

            //- ── Right form content ──
            .edit-content

                //- Section: Rendez-vous
                .edit-section
                    .edit-section__header
                        .edit-section__icon
                            svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px")
                                path(d="M224.62-120q-27.62 0-46.12-18.5Q160-157 160-184.62v-510.76q0-27.62 18.5-46.12Q197-760 224.62-760h70.76v-89.23h43.08V-760h286.16v-89.23h40V-760h70.76q27.62 0 46.12 18.5Q800-723 800-695.38v510.76q0 27.62-18.5 46.12Q763-120 735.38-120H224.62Zm0-40h510.76q9.24 0 16.93-7.69 7.69-7.69 7.69-16.93v-350.76H200v350.76q0 9.24 7.69 16.93 7.69 7.69 16.93 7.69ZM200-575.39h560v-119.99q0-9.24-7.69-16.93-7.69-7.69-16.93-7.69H224.62q-9.24 0-16.93 7.69-7.69 7.69-7.69 16.93v119.99Zm0 0V-720-575.39Z")
                        h3= t.hist_edit.section_appointment
                    .edit-section__body
                        .edit-fields-row
                            .field-container.flex.col
                                label= t.hist_edit.date
                                input.input(type="date" value=results.date.toISOString().split('T')[0] id="editDate")
                        .edit-fields-row.two-col
                            .field-container.flex.col
                                label= t.hist_edit.start_time
                                input.input(type="time" value=results.startTime id="editStartTime")
                            .field-container.flex.col
                                label= t.hist_edit.end_time
                                input.input(type="time" value=results.endTime id="editEndTime")

                //- Section: Client
                .edit-section
                    .edit-section__header
                        .edit-section__icon
                            svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px")
                                path(d="M480-492.31q-57.75 0-98.87-41.12Q340-574.56 340-632.31q0-57.75 41.13-98.87 41.12-41.13 98.87-41.13 57.75 0 98.87 41.13Q620-690.06 620-632.31q0 57.75-41.13 98.88Q537.75-492.31 480-492.31ZM170-180v-57.85q0-29.61 15.96-54.42 15.96-24.81 42.58-38.35 59.15-29.07 119.3-43.61Q407.99-388.77 480-388.77t132.16 14.54q60.15 14.54 119.3 43.61 26.62 13.54 42.58 38.35Q790-267.46 790-237.85V-180H170Z")
                        h3= t.hist_edit.section_client
                    .edit-section__body
                        .edit-fields-row.two-col
                            .field-container.flex.col
                                label= t.hist_edit.name
                                input.input(value=results.name id="editName" placeholder="Prénom")
                            .field-container.flex.col
                                label= t.hist_edit.surname
                                input.input(value=results.surname id="editSurname" placeholder="Nom")
                        .edit-fields-row.two-col
                            .field-container.flex.col
                                label= t.hist_edit.email
                                input.input(type="email" value=results.email id="editEmail" placeholder="email@example.com")
                            .field-container.flex.col
                                label= t.hist_edit.phone
                                input.input(type="tel" value=(results.phone || '') id="editPhone" placeholder="+32 456 00 00 00")
                        .edit-fields-row
                            .field-container.flex.col
                                label= t.hist_edit.message
                                textarea.input.textarea#editMessage(rows="3" placeholder="...")= results.message || ''

                //- Section: Notes admin
                .edit-section
                    .edit-section__header
                        .edit-section__icon
                            svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px")
                                path(d="M200-200h57l391-391-57-57-391 391v57Zm-40 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T857-647L330-120H160Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z")
                        h3= t.hist_edit.admin_notes
                    .edit-section__body
                        .edit-fields-row
                            .field-container.flex.col
                                textarea.input.textarea#editAdminNotes(
                                    rows="4"
                                    placeholder=t.hist_edit.admin_notes_placeholder
                                )= results.adminNotes || ''

                //- Section: Réponses au formulaire (si présentes)
                if results.formAnswers && results.formAnswers.length > 0
                    .edit-section
                        .edit-section__header
                            .edit-section__icon
                                svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px")
                                    path(d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Zm-20 200v-40q0-33 10-56t36-49l44-44q14-14 21-29t7-32q0-34-22.5-57T480-640q-38 0-62 22t-31 58l-76-16q12-54 54-88t115-34q67 0 110.5 38.5T634-550q0 29-10 52.5T593-452l-47 44q-14 13-20 29t-6 35v40H460Zm20 120q-17 0-28.5-11.5T440-200q0-17 11.5-28.5T480-240q17 0 28.5 11.5T520-200q0 17-11.5 28.5T480-160Z")
                            h3= t.hist_edit.section_form_answers
                        .edit-section__body
                            .form-answers-list
                                each answer in results.formAnswers
                                    .form-answer-item
                                        p.form-answer-question= answer.question
                                        p.form-answer-value= answer.answer || '–'

        //- Sticky action bar
        .edit-actions-bar
            button.btn.secondary(type="button" onclick="history.back()")
                span= t.hist_edit.back
            button.btn#saveBtnEdit(type="button")
                svg.save-icon(xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px")
                    path(d="M840-680v480q0 33-23.5 56.5T760-120H200q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h480l160 160Zm-80 34L646-760H200v560h560v-446ZM480-240q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35ZM240-560h360v-160H240v160Zm-40-86v446-560 114Z")
                span#saveBtnLabel= t.hist_edit.save

block scripts
    script(src="/js/layouts/history.js" type="module")
