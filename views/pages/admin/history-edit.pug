extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/layouts/history.css")
    link(rel="stylesheet", href="/css/layouts/history-edit.css")
    link(rel="stylesheet", href="/css/components/admin/book.admin.css")
    style.
        .edit-sidebar__reminder { padding: 0 16px 16px; display: flex; flex-direction: column; gap: 0; }
        .reminder-status-badge { display: flex; align-items: center; gap: 7px; padding: 7px 10px; border-radius: 8px; font-size: 12px; font-weight: 600; }
        .reminder-status-badge--manual { background: #f0fdf4; color: #15803d; }
        .reminder-status-badge--auto   { background: #eff6ff; color: #1d4ed8; }

block content
    - var initials = ((results.name || '').charAt(0) + (results.surname || '').charAt(0)).toUpperCase()
    - const isPast = new Date(results.date) < new Date(new Date().setHours(0,0,0,0))

    .page.page--history-edit
        //- Back button + Delete button
        .edit-top-bar
            a.edit-back-btn(href="javascript:history.back()")
                span.material-symbols-outlined(style="font-size:20px") arrow_back
                span= t.hist_edit.back
            button.sm-btn.sm-btn--danger#deleteHistoryBtn(type="button")
                span.material-symbols-outlined delete
                span= t.hist_edit.delete_btn

        .edit-layout

            //- ── Left summary card (sticky) ──
            .edit-sidebar
                .edit-sidebar__card
                    .edit-sidebar__avatar
                        span= initials || '?'
                    .edit-sidebar__name
                        h3= (results.name || '') + ' ' + (results.surname || '')
                        p= results.email

                    .edit-sidebar__divider

                    .edit-sidebar__meta
                        .edit-sidebar__meta-row
                            span.material-symbols-outlined(style="font-size:18px") calendar_month
                            span= results.date.toLocaleDateString(lang)

                        .edit-sidebar__meta-row
                            span.material-symbols-outlined(style="font-size:18px") schedule
                            span #{results.startTime} – #{results.endTime}

                    .edit-sidebar__divider

                    //- Status toggle
                    .edit-sidebar__status-label= t.hist_edit.status
                    .edit-sidebar__status-toggle
                        button.status-pill(
                            type="button"
                            class=(results.status === 'confirmed' ? 'active confirmed' : '')
                            data-value="confirmed"
                        )
                            span= t.hist_edit.status_confirmed
                        button.status-pill(
                            type="button"
                            class=(results.status === 'canceled' ? 'active canceled' : '')
                            data-value="canceled"
                        )
                            span= t.hist_edit.status_canceled

                    input(type="hidden" id="editStatus" value=results.status)

                    .edit-sidebar__divider

                    //- ── Rappel ──────────────────────────────────────────
                    .edit-sidebar__reminder
                        if results.manualReminderSent
                            .reminder-status-badge.reminder-status-badge--manual
                                span.material-symbols-outlined(style="font-size:14px") check
                                span= t.hist_edit.reminder_sent_manual
                        else if results.reminderSent
                            .reminder-status-badge.reminder-status-badge--auto
                                span.material-symbols-outlined(style="font-size:14px") check
                                span= t.hist_edit.reminder_sent_auto
                        if results.status === 'confirmed' && results.email && !isPast
                            button.sm-btn.sm-btn--ghost#sendReminderBtn(type="button" style="width:100%;justify-content:center;margin-top:8px")
                                span.material-symbols-outlined(style="font-size:16px") notifications
                                span= t.hist_edit.send_reminder_btn

            //- ── Right form content ──
            .edit-content

                //- Section: Rendez-vous
                .edit-section
                    .edit-section__header
                        .edit-section__icon
                            span.material-symbols-outlined(style="font-size:20px") calendar_month
                        h3= t.hist_edit.section_appointment
                    .edit-section__body
                        .edit-fields-row
                            .field-container.flex.col
                                label= t.hist_edit.date
                                //- Custom calendar picker
                                .datepicker-wrap
                                    input(type="hidden" id="editDate" value=results.date.toISOString().split('T')[0])
                                    button.datepicker-trigger(type="button" id="datepickerTrigger")
                                        span.material-symbols-outlined(style="font-size:16px") calendar_month
                                        span#datepickerDisplay= results.date.toLocaleDateString(lang, {weekday:"long", year:"numeric", month:"long", day:"numeric"})
                                    .datepicker-popup(id="datepickerPopup" style="display:none")
                                        .datepicker-header
                                            button.datepicker-nav(type="button" id="dpPrevMonth")
                                                span.material-symbols-outlined(style="font-size:18px") chevron_left
                                            span.datepicker-month-label(id="dpMonthLabel")
                                            button.datepicker-nav(type="button" id="dpNextMonth")
                                                span.material-symbols-outlined(style="font-size:18px") chevron_right
                                        .datepicker-weekdays
                                            span= t.days_abbr.monday.charAt(0)
                                            span= t.days_abbr.tuesday.charAt(0)
                                            span= t.days_abbr.wednesday.charAt(0)
                                            span= t.days_abbr.thursday.charAt(0)
                                            span= t.days_abbr.friday.charAt(0)
                                            span= t.days_abbr.saturday.charAt(0)
                                            span= t.days_abbr.sunday.charAt(0)
                                        .datepicker-days(id="dpDays")
                        .edit-fields-row.two-col
                            .field-container.flex.col
                                label= t.hist_edit.start_time
                                input.input(type="time" value=results.startTime id="editStartTime")
                            .field-container.flex.col
                                label= t.hist_edit.end_time
                                input.input(type="time" value=results.endTime id="editEndTime")

                        //- Service selector + info chips
                        if services && services.length > 0
                            .edit-fields-row
                                .field-container.flex.col
                                    label= t.hist_edit.service_label
                                    .svc-select-row
                                        select.input#editService
                                            option(value="")= t.hist_edit.no_service
                                            each svc in services
                                                - var svcId = String(svc._id)
                                                - var currentSvcId = results.service ? String(results.service) : ''
                                                option(value=svcId data-name=svc.name data-duration=svc.duration data-price=(svc.price || '') selected=(currentSvcId === svcId))= svc.name.length > 40 ? svc.name.slice(0, 40) + '…' : svc.name
                                    .svc-info-chips#svcInfoChips(style="display:none")
                                        .svc-chip#svcDurationChip
                                            span.material-symbols-outlined(style="font-size:14px") schedule
                                            span#svcDurationLabel —
                                        .svc-chip#svcPriceChip(style="display:none")
                                            span.material-symbols-outlined(style="font-size:14px") payments
                                            span#svcPriceLabel —

                        //- Employee selector
                        if employees && employees.length > 0
                            .edit-fields-row
                                .field-container.flex.col
                                    label= t.hist_edit.employee_label
                                    select.input#editEmployee
                                        option(value="")= t.hist_edit.no_employee
                                        each emp in employees
                                            - var empId = String(emp._id)
                                            - var currentEmpId = results.employee ? String(results.employee._id || results.employee) : ''
                                            - var empLabel = emp.firstName + ' ' + emp.lastName
                                            option(value=empId selected=(currentEmpId === empId))= empLabel.length > 40 ? empLabel.slice(0, 40) + '…' : empLabel

                //- Section: Paiement
                -
                    var payMethodLabels = {
                        online: t.hist_edit.pay_method_online,
                        on_site: t.hist_edit.pay_method_on_site,
                        bank_transfer: t.hist_edit.pay_method_bank_transfer,
                        paypal: t.hist_edit.pay_method_paypal,
                        none: t.hist_edit.pay_method_none,
                    }
                    var payStatusLabels = {
                        none: t.hist_edit.pay_status_none,
                        authorized: t.hist_edit.pay_status_authorized,
                        paid: t.hist_edit.pay_status_paid,
                        refunded: t.hist_edit.pay_status_refunded,
                        partial: t.hist_edit.pay_status_partial,
                        penalty: t.hist_edit.pay_status_penalty,
                        failed: t.hist_edit.pay_status_failed,
                    }
                    var payStatusClass = {
                        none: "neutral",
                        authorized: "info",
                        paid: "success",
                        refunded: "neutral",
                        partial: "warning",
                        penalty: "warning",
                        failed: "danger",
                    }
                    var pay = results.payment || {}
                    var payMethod = pay.method || "none"
                    var payStatus = pay.status || "none"

                .edit-section
                    .edit-section__header
                        .edit-section__icon
                            span.material-symbols-outlined(style="font-size:20px") payments
                        h3= t.hist_edit.payment_title
                    .edit-section__body
                        .pay-info-grid
                            .pay-info-item
                                span.pay-info-label= t.hist_edit.payment_method_label
                                span.pay-info-value= payMethodLabels[payMethod] || payMethod
                            if payMethod !== "none"
                                .pay-info-item
                                    span.pay-info-label= t.hist_edit.payment_status_label
                                    span.pay-info-value
                                        span.pay-status-badge(class="pay-status-badge--" + (payStatusClass[payStatus] || "neutral"))= payStatusLabels[payStatus] || payStatus
                            if pay.amount
                                .pay-info-item
                                    span.pay-info-label= t.hist_edit.payment_amount_label
                                    span.pay-info-value= pay.amount.toFixed(2).replace(".", ",") + " €"
                            if pay.paidAt
                                .pay-info-item
                                    span.pay-info-label= t.hist_edit.payment_date_label
                                    span.pay-info-value= new Date(pay.paidAt).toLocaleString(lang)
                            if pay.cardLast4
                                .pay-info-item
                                    span.pay-info-label Carte du client
                                    span.pay-info-value.pay-card-chip
                                        span.material-symbols-outlined(style="font-size:13px") credit_card
                                        | #{pay.cardBrand ? (pay.cardBrand.charAt(0).toUpperCase() + pay.cardBrand.slice(1)) : 'Carte'}
                                        span.pay-card-mask  •••• #{pay.cardLast4}

                        if results.noShow
                            .pay-noshow-row(class=results.noShowReason === "invalid" ? "pay-noshow-row--charged" : "pay-noshow-row--free")
                                span.material-symbols-outlined(style="font-size:16px") info
                                if results.noShowReason === "invalid"
                                    span= t.hist_edit.noshow_charged
                                else
                                    span= t.hist_edit.noshow_free

                        //- ── Helpers pour le statut de paiement ─────────────────────
                        -
                            var payStatus = results.payment && results.payment.status
                            var payAmt    = (results.payment && results.payment.amount) || 0
                            var keptAmt   = (results.payment && results.payment.keptAmount) || 0
                            var penaltyAmt2 = (results.payment && (results.payment.penaltyAmount || results.payment.amount)) || 0
                            var isNoShowCharged = results.noShow && results.noShowReason === 'invalid' && (payStatus === 'penalty' || payStatus === 'paid')
                            var isCancelPenaltyKept = results.status === 'canceled' && payStatus === 'penalty' && results.payment && results.payment.cancellationReviewDecision === 'kept'
                            var isCancelPartial = results.status === 'canceled' && payStatus === 'partial' && keptAmt > 0
                            var isCancelFullKept = results.status === 'canceled' && payStatus === 'paid' && keptAmt > 0
                            var payoutAmt = isNoShowCharged ? penaltyAmt2 : (isCancelPenaltyKept ? penaltyAmt2 : keptAmt)
                            var showPayoutBlock = isNoShowCharged || isCancelPenaltyKept || isCancelPartial || isCancelFullKept
                            var showChargeFailed = payStatus === 'failed'
                            var showNoCard = results.noShow && results.noShowReason === 'invalid' && (payStatus === 'none' || payStatus === 'authorized') && !showChargeFailed

                        //- ── Bloc : prélèvement échoué / pas de carte ───────────────
                        if showChargeFailed || showNoCard
                            .charge-failed-block
                                .charge-failed-block__hd
                                    span.material-symbols-outlined(style="font-size:18px") warning
                                    if showChargeFailed
                                        div
                                            strong Le prélèvement a échoué
                                            span La carte du client a été refusée ou n'est plus disponible. Voici vos options pour récupérer la somme due :
                                    else
                                        div
                                            strong Aucun moyen de paiement enregistré
                                            span Ce client n'avait pas de carte bancaire enregistrée. Vous pouvez tenter un recouvrement à l'amiable ou légal :
                                .charge-failed-block__options
                                    .charge-failed-option
                                        span.charge-failed-option__num 1
                                        div
                                            strong Rappel amiable
                                            span Contactez le client directement (email, téléphone) et proposez un règlement par virement, espèces ou PayPal.
                                    .charge-failed-option
                                        span.charge-failed-option__num 2
                                        div
                                            strong Mise en demeure
                                            span Envoyez un courrier recommandé avec AR demandant le règlement sous 8 jours. Ce document est indispensable avant toute action judiciaire.
                                    .charge-failed-option
                                        span.charge-failed-option__num 3
                                        div
                                            strong Procédure simplifiée en ligne
                                            span Pour les petits montants, la procédure de recouvrement simplifiée est gratuite et rapide.
                                            a.charge-failed-option__link(href="https://www.service-public.fr/particuliers/vosdroits/F1746" target="_blank" rel="noopener")
                                                | service-public.fr →
                                    .charge-failed-option
                                        span.charge-failed-option__num 4
                                        div
                                            strong Injonction de payer
                                            span Pour les montants plus importants, votre tribunal judiciaire peut ordonner le paiement sans audience contradictoire.

                        //- ── Bloc reversement BranShee (raison non valable OU annulation payée) ──
                        if showPayoutBlock
                            -
                                var pi = payoutInfo || {}
                                var piMethod = pi.method || ''
                            .payout-block
                                .payout-block__msg
                                    span.material-symbols-outlined(style="font-size:18px") check_circle
                                    div
                                        if isNoShowCharged
                                            strong BranShee a enregistré la pénalité d'absence
                                        else if isCancelPenaltyKept
                                            strong BranShee a confirmé la retenue des frais d'annulation
                                        else if isCancelPartial
                                            strong #{payAmt - keptAmt} € remboursés au client automatiquement
                                        else
                                            strong Pénalité 100% — le client ne sera pas remboursé
                                        if payoutAmt > 0
                                            if isCancelPartial
                                                span Vous recevrez #{keptAmt} € (votre part retenue) dans les prochains jours.
                                            else
                                                span Vous recevrez #{payoutAmt} € dans les prochains jours sur votre moyen de paiement préféré.
                                .payout-block__method
                                    p.payout-block__method-label Moyen de paiement préféré pour recevoir l'argent
                                    if piMethod === 'bank_transfer'
                                        .payout-block__method-display
                                            span.material-symbols-outlined(style="font-size:14px") account_balance
                                            span Virement bancaire
                                            if pi.iban
                                                span.payout-block__method-detail — IBAN : #{pi.iban}
                                            a.payout-block__edit-link#payoutEditLink(href="#") Modifier
                                    else if piMethod === 'paypal'
                                        .payout-block__method-display
                                            span.material-symbols-outlined(style="font-size:14px") account_balance_wallet
                                            span PayPal
                                            if pi.paypalEmail
                                                span.payout-block__method-detail — #{pi.paypalEmail}
                                            a.payout-block__edit-link#payoutEditLink(href="#") Modifier
                                    else if piMethod === 'cash'
                                        .payout-block__method-display
                                            span.material-symbols-outlined(style="font-size:14px") payments
                                            span Espèces
                                            a.payout-block__edit-link#payoutEditLink(href="#") Modifier
                                    else if piMethod === 'other'
                                        .payout-block__method-display
                                            span.material-symbols-outlined(style="font-size:14px") info
                                            span #{pi.other || 'Autre'}
                                            a.payout-block__edit-link#payoutEditLink(href="#") Modifier
                                    else
                                        .payout-block__no-method
                                            span.material-symbols-outlined(style="font-size:14px") info
                                            span Veuillez ajouter un moyen de recevoir l'argent
                                            a.payout-block__edit-link#payoutEditLink(href="#") Ajouter
                                    //- Formulaire inline (caché par défaut, révélé par "Modifier / Ajouter")
                                    form.payout-block__form#payoutForm(style="display:none")
                                        select.input.input--sm#payoutMethod(name="method")
                                            option(value="" disabled selected=(piMethod==='')) Choisir un moyen…
                                            option(value="bank_transfer" selected=(piMethod==='bank_transfer')) Virement bancaire (IBAN)
                                            option(value="paypal" selected=(piMethod==='paypal')) PayPal
                                            option(value="cash" selected=(piMethod==='cash')) Espèces
                                            option(value="other" selected=(piMethod==='other')) Autre
                                        .payout-block__form-detail#payoutDetailIban(style=(piMethod==='bank_transfer' ? '' : 'display:none'))
                                            input.input.input--sm#payoutIban(type="text" placeholder="IBAN (ex: BE12 3456 7890 1234)" value=(pi.iban||''))
                                            input.input.input--sm#payoutBic(type="text" placeholder="BIC (optionnel)" value=(pi.bic||''))
                                        .payout-block__form-detail#payoutDetailPaypal(style=(piMethod==='paypal' ? '' : 'display:none'))
                                            input.input.input--sm#payoutPaypalEmail(type="email" placeholder="Email PayPal" value=(pi.paypalEmail||''))
                                        .payout-block__form-detail#payoutDetailOther(style=(piMethod==='other' ? '' : 'display:none'))
                                            input.input.input--sm#payoutOther(type="text" placeholder="Précisez le moyen (ex: virement Wise, Lydia…)" value=(pi.other||''))
                                        .payout-block__form-actions
                                            button.sm-btn.sm-btn--primary#payoutSaveBtn(type="button") Enregistrer
                                            button.sm-btn.sm-btn--ghost#payoutCancelBtn(type="button") Annuler

                        //- ── Marquer une absence (no-show) ───────────────────────────
                        -
                            var hasOnlinePayment = pay && pay.method === 'online'
                            var canChargeNoShow = hasOnlinePayment && (pay.status === 'authorized' || pay.status === 'paid') && (pay.stripePaymentMethodId || pay.status === 'paid')
                        if isPast && results.status === 'confirmed' && !results.noShow
                            .noshow-wrap
                                button.sm-btn.sm-btn--danger#noShowBtn(type="button")
                                    span.material-symbols-outlined(style="font-size:14px") info
                                    span= t.hist_edit.noshow_btn
                                .noshow-choices#noShowChoices(style="display:none")
                                    p.noshow-choices__title= t.hist_edit.noshow_question
                                    button.sm-btn.sm-btn--soft#noShowValid(type="button" data-reason="valid")
                                        span= t.hist_edit.noshow_valid
                                    if canChargeNoShow
                                        button.sm-btn.sm-btn--danger#noShowInvalid(type="button" data-reason="invalid" data-amount=(pay.amount || 0))
                                            span= t.hist_edit.noshow_invalid_charge.replace('{amount}', pay.amount)
                                    else
                                        button.sm-btn.sm-btn--danger#noShowInvalid(type="button" data-reason="invalid")
                                            span= t.hist_edit.noshow_invalid
                                    button.sm-btn.sm-btn--ghost#noShowCancel(type="button")= t.hist_edit.generic_cancel

                        //- ── Revue des frais d'annulation prélevés automatiquement ────
                        if results.status === 'canceled' && pay && pay.status === 'penalty' && !pay.cancellationReviewDecision
                            - var penaltyAmt = pay.penaltyAmount || pay.amount
                            .noshow-wrap
                                button.sm-btn.sm-btn--danger#cancelReviewBtn(type="button")
                                    span.material-symbols-outlined(style="font-size:14px") info
                                    span= t.hist_edit.cancel_fee_charged.replace('{amount}', penaltyAmt)
                                .noshow-choices#cancelReviewChoices(style="display:none")
                                    p.noshow-choices__title= t.hist_edit.cancel_fee_question.replace('{amount}', penaltyAmt)
                                    button.sm-btn.sm-btn--soft#cancelReviewRefund(type="button")
                                        span= t.hist_edit.cancel_fee_refund
                                    button.sm-btn.sm-btn--danger#cancelReviewKeep(type="button")
                                        span= t.hist_edit.cancel_fee_keep
                                    button.sm-btn.sm-btn--ghost#cancelReviewCancel(type="button")= t.hist_edit.generic_cancel
                        if pay && pay.cancellationReviewDecision
                            .noshow-badge(class=pay.cancellationReviewDecision === 'refunded' ? 'noshow-badge--free' : 'noshow-badge--charged')
                                span.material-symbols-outlined(style="font-size:14px") info
                                span= pay.cancellationReviewDecision === 'refunded' ? t.hist_edit.cancel_late_refunded : t.hist_edit.cancel_late_kept

                //- Section: Client
                .edit-section
                    .edit-section__header
                        .edit-section__icon
                            span.material-symbols-outlined(style="font-size:20px") person
                        h3= t.hist_edit.section_client
                    .edit-section__body
                        .edit-fields-row.two-col
                            .field-container.flex.col
                                label= t.hist_edit.name
                                input.input(value=results.name id="editName" placeholder="Prénom")
                            .field-container.flex.col
                                label= t.hist_edit.surname
                                input.input(value=results.surname id="editSurname" placeholder="Nom")
                        .edit-fields-row.two-col
                            .field-container.flex.col
                                label= t.hist_edit.email
                                input.input(type="email" value=results.email id="editEmail" placeholder="email@example.com")
                            .field-container.flex.col
                                label= t.hist_edit.phone
                                input.input(type="tel" value=(results.phone || '') id="editPhone" placeholder="+32 456 00 00 00")
                        .edit-fields-row
                            .field-container.flex.col
                                label= t.hist_edit.message
                                textarea.input.textarea#editMessage(rows="3" placeholder="...")= results.message || ''

                //- Section: Réponses au formulaire (si présentes)
                if results.formAnswers && results.formAnswers.length > 0
                    .edit-section
                        .edit-section__header
                            .edit-section__icon
                                span.material-symbols-outlined(style="font-size:20px") help
                            h3= t.hist_edit.section_form_answers
                        .edit-section__body
                            .form-answers-list
                                each answer in results.formAnswers
                                    .form-answer-item
                                        p.form-answer-question= answer.question
                                        p.form-answer-value= answer.answer || '–'

        //- Sticky action bar
        .edit-actions-bar
            button.sm-btn.sm-btn--ghost(type="button" onclick="history.back()")
                span= t.hist_edit.back
            if results.email
                a.sm-btn.sm-btn--soft(href=`/clients/${encodeURIComponent(results.email)}`)
                    span.material-symbols-outlined(style="font-size:16px") description
                    span= t.hist_edit.view_client_file
            button.sm-btn.sm-btn--primary#saveBtnEdit(type="button")
                span.material-symbols-outlined.save-icon(style="font-size:18px") save
                span#saveBtnLabel= t.hist_edit.save

    //- ── Conflict modal ──────────────────────────────────────────────────────
    .conflict-overlay(id="conflictOverlay" style="display:none")
        .conflict-modal(id="conflictModal")
            .conflict-modal__icon
                span.material-symbols-outlined(style="font-size:32px") warning
            h3.conflict-modal__title= t.hist_edit.conflict_title
            p.conflict-modal__desc= t.hist_edit.conflict_desc
            ul.conflict-list(id="conflictList")
            .conflict-modal__warning
                span.material-symbols-outlined(style="font-size:14px") warning
                span= t.hist_edit.conflict_warning
            .conflict-modal__actions
                button.sm-btn.sm-btn--ghost(type="button" id="conflictCancel")= t.hist_edit.generic_cancel
                button.sm-btn.sm-btn--danger(type="button" id="conflictForce")
                    span.material-symbols-outlined(style="font-size:16px") delete
                    span= t.hist_edit.conflict_force

block scripts
    script(src="/js/layouts/history.js" type="module")
    script(src="/js/utils/confirm-modal.js")
    script.
        // ── Supprimer le rendez-vous ──────────────────────────────────────────
        (function() {
            var btn = document.getElementById('deleteHistoryBtn');
            if (!btn) return;
            var bookingId = window.__bookingId || '!{results._id}';

            btn.addEventListener('click', async function() {
                var result = await window.confirmDelete({
                    url: '/appointment/' + bookingId + '/delete',
                    title: window.__deleteModalTitle,
                    desc: window.__deleteModalDesc,
                    confirmLabel: '#{t.hist_edit.delete_modal_confirm}',
                    cancelLabel: '#{t.hist_edit.generic_cancel}',
                    errorMessage: "#{t.hist_edit.delete_error}",
                    networkErrorMessage: '#{t.hist_edit.network_error}',
                });
                if (result.success) window.location.href = '/history';
            });
        })();

        // ── Formulaire moyen de reversement ─────────────────────────────────
        (function() {
            var editLink   = document.getElementById('payoutEditLink');
            var form       = document.getElementById('payoutForm');
            var methodSel  = document.getElementById('payoutMethod');
            var saveBtn    = document.getElementById('payoutSaveBtn');
            var cancelBtn  = document.getElementById('payoutCancelBtn');
            var detailIban   = document.getElementById('payoutDetailIban');
            var detailPaypal = document.getElementById('payoutDetailPaypal');
            var detailOther  = document.getElementById('payoutDetailOther');
            if (!editLink || !form) return;

            function showDetail(method) {
                [detailIban, detailPaypal, detailOther].forEach(function(el) { if (el) el.style.display = 'none'; });
                if (method === 'bank_transfer' && detailIban) detailIban.style.display = '';
                if (method === 'paypal' && detailPaypal) detailPaypal.style.display = '';
                if (method === 'other' && detailOther) detailOther.style.display = '';
            }

            editLink.addEventListener('click', function(e) {
                e.preventDefault();
                editLink.style.display = 'none';
                form.style.display = 'flex';
                if (methodSel) showDetail(methodSel.value);
            });
            if (methodSel) {
                methodSel.addEventListener('change', function() { showDetail(this.value); });
            }
            if (cancelBtn) {
                cancelBtn.addEventListener('click', function() {
                    form.style.display = 'none';
                    editLink.style.display = '';
                });
            }
            if (saveBtn) {
                saveBtn.addEventListener('click', async function() {
                    var method = methodSel ? methodSel.value : '';
                    if (!method) { alert('Veuillez choisir un moyen de paiement.'); return; }
                    var payload = { method: method };
                    var ibanEl = document.getElementById('payoutIban');
                    var bicEl  = document.getElementById('payoutBic');
                    var ppEl   = document.getElementById('payoutPaypalEmail');
                    var otEl   = document.getElementById('payoutOther');
                    if (method === 'bank_transfer') { payload.iban = ibanEl ? ibanEl.value.trim() : ''; payload.bic = bicEl ? bicEl.value.trim() : ''; }
                    if (method === 'paypal')        { payload.paypalEmail = ppEl ? ppEl.value.trim() : ''; }
                    if (method === 'other')         { payload.other = otEl ? otEl.value.trim() : ''; }
                    saveBtn.disabled = true;
                    saveBtn.textContent = 'Enregistrement…';
                    try {
                        var r = await fetch('/api/company/payout-info', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                        var d = await r.json();
                        if (d.success) { location.reload(); }
                        else { alert(d.error || 'Erreur lors de l\'enregistrement.'); saveBtn.disabled = false; saveBtn.textContent = 'Enregistrer'; }
                    } catch(e) { alert('Erreur réseau.'); saveBtn.disabled = false; saveBtn.textContent = 'Enregistrer'; }
                });
            }
        })();
    script.
        window.__servicesData = !{JSON.stringify(services || [])};
        window.__bookingId    = '!{results._id}';
        window.__deleteModalTitle = !{JSON.stringify(t.hist_edit.delete_modal_title)};
        window.__deleteModalDesc  = !{JSON.stringify(t.hist_edit.delete_modal_desc)};
    script.
        (function() {
            const bookId = '!{results._id}';

            // ── Marquer une absence (no-show) ───────────────────────────────────
            const noShowBtn     = document.getElementById('noShowBtn');
            const noShowChoices = document.getElementById('noShowChoices');
            const noShowCancel  = document.getElementById('noShowCancel');
            const noShowValid   = document.getElementById('noShowValid');
            const noShowInvalid = document.getElementById('noShowInvalid');

            if (noShowBtn && noShowChoices) {
                noShowBtn.addEventListener('click', () => {
                    noShowBtn.style.display = 'none';
                    noShowChoices.style.display = 'flex';
                });
            }
            if (noShowCancel) {
                noShowCancel.addEventListener('click', () => {
                    noShowChoices.style.display = 'none';
                    noShowBtn.style.display = '';
                });
            }

            async function submitNoShow(reason, btn) {
                const amount = btn.dataset.amount;
                if (reason === 'invalid' && amount) {
                    if (!(await window.confirmModal("#{t.hist_edit.charge_confirm_title}", `#{t.hist_edit.charge_question}`.replace('{amount}', amount), { confirmLabel: '#{t.hist_edit.charge_confirm_btn}', danger: true }))) return;
                } else if (reason === 'invalid') {
                    if (!(await window.confirmModal('#{t.hist_edit.generic_confirm_title}', '#{t.hist_edit.mark_invalid_question}', { confirmLabel: '#{t.hist_edit.generic_confirm}', danger: true }))) return;
                }

                noShowChoices.querySelectorAll('button').forEach(b => b.disabled = true);
                btn.querySelector('span').textContent = '#{t.hist_edit.processing_label}';

                try {
                    const res  = await fetch(`/appointment/${bookId}/no-show`, {
                        method:  'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body:    JSON.stringify({ reason })
                    });
                    const data = await res.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        await window.alertModal(data.error || "#{t.hist_edit.processing_error}", '#{t.hist_edit.generic_info_title}');
                        noShowChoices.querySelectorAll('button').forEach(b => b.disabled = false);
                        btn.querySelector('span').textContent = reason === 'invalid'
                            ? (amount ? `#{t.hist_edit.noshow_invalid_charge}`.replace('{amount}', amount) : '#{t.hist_edit.noshow_invalid}')
                            : '#{t.hist_edit.noshow_valid}';
                    }
                } catch (e) {
                    await window.alertModal('#{t.hist_edit.network_error}', '#{t.hist_edit.generic_info_title}');
                    noShowChoices.querySelectorAll('button').forEach(b => b.disabled = false);
                }
            }

            if (noShowValid)   noShowValid.addEventListener('click',   () => submitNoShow('valid',   noShowValid));
            if (noShowInvalid) noShowInvalid.addEventListener('click', () => submitNoShow('invalid', noShowInvalid));

            // ── Revue des frais d'annulation prélevés automatiquement ───────────
            const cancelReviewBtn     = document.getElementById('cancelReviewBtn');
            const cancelReviewChoices = document.getElementById('cancelReviewChoices');
            const cancelReviewCancel  = document.getElementById('cancelReviewCancel');
            const cancelReviewRefund  = document.getElementById('cancelReviewRefund');
            const cancelReviewKeep    = document.getElementById('cancelReviewKeep');

            if (cancelReviewBtn && cancelReviewChoices) {
                cancelReviewBtn.addEventListener('click', () => {
                    cancelReviewBtn.style.display = 'none';
                    cancelReviewChoices.style.display = 'flex';
                });
            }
            if (cancelReviewCancel) {
                cancelReviewCancel.addEventListener('click', () => {
                    cancelReviewChoices.style.display = 'none';
                    cancelReviewBtn.style.display = '';
                });
            }

            async function submitCancelReview(decision, btn) {
                if (decision === 'refunded' && !(await window.confirmModal('#{t.hist_edit.refund_confirm_title}', "#{t.hist_edit.refund_question}", { confirmLabel: '#{t.hist_edit.refund_confirm_btn}', danger: false }))) return;
                if (decision === 'kept' && !(await window.confirmModal('#{t.hist_edit.generic_confirm_title}', "#{t.hist_edit.keep_question}", { confirmLabel: '#{t.hist_edit.generic_confirm}', danger: true }))) return;

                cancelReviewChoices.querySelectorAll('button').forEach(b => b.disabled = true);
                btn.querySelector('span').textContent = '#{t.hist_edit.processing_label}';

                try {
                    const res  = await fetch(`/appointment/${bookId}/review-cancellation`, {
                        method:  'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body:    JSON.stringify({ decision })
                    });
                    const data = await res.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        await window.alertModal(data.error || "#{t.hist_edit.processing_error}", '#{t.hist_edit.generic_info_title}');
                        cancelReviewChoices.querySelectorAll('button').forEach(b => b.disabled = false);
                        btn.querySelector('span').textContent = decision === 'refunded'
                            ? '#{t.hist_edit.cancel_fee_refund}'
                            : '#{t.hist_edit.cancel_fee_keep}';
                    }
                } catch (e) {
                    await window.alertModal('#{t.hist_edit.network_error}', '#{t.hist_edit.generic_info_title}');
                    cancelReviewChoices.querySelectorAll('button').forEach(b => b.disabled = false);
                }
            }

            if (cancelReviewRefund) cancelReviewRefund.addEventListener('click', () => submitCancelReview('refunded', cancelReviewRefund));
            if (cancelReviewKeep)   cancelReviewKeep.addEventListener('click',   () => submitCancelReview('kept',     cancelReviewKeep));

            // ── Envoyer un rappel manuellement ──────────────────────────────────
            const sendReminderBtn = document.getElementById('sendReminderBtn');
            if (sendReminderBtn) {
                sendReminderBtn.addEventListener('click', async () => {
                    const confirmed = await window.confirmModal(
                        "#{t.hist_edit.send_reminder_title}",
                        "#{t.hist_edit.send_reminder_question}",
                        { confirmLabel: '#{t.hist_edit.send_reminder_confirm}', danger: false }
                    );
                    if (!confirmed) return;

                    const origHtml = sendReminderBtn.innerHTML;
                    sendReminderBtn.disabled = true;
                    sendReminderBtn.querySelector('span').textContent = '#{t.hist_edit.sending_label}';

                    try {
                        const res = await fetch(`/appointment/${bookId}/send-reminder`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await res.json();
                        if (data.success) {
                            location.reload();
                        } else {
                            await window.alertModal(data.message || data.error || "#{t.hist_edit.send_error}", '#{t.hist_edit.generic_info_title}');
                            sendReminderBtn.disabled = false;
                            sendReminderBtn.innerHTML = origHtml;
                        }
                    } catch (e) {
                        await window.alertModal('#{t.hist_edit.network_error}', '#{t.hist_edit.generic_info_title}');
                        sendReminderBtn.disabled = false;
                        sendReminderBtn.innerHTML = origHtml;
                    }
                });
            }
        })();
