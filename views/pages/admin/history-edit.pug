extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/layouts/history.css")

block content
    .page.page--history-edit
        .history__edit
            .history__edit-form
                .form__title
                    h2 #{t.hist_edit.title} #{results.date.toLocaleDateString("fr-FR")} #{results.startTime} - #{results.endTime}
                .form__wrapper
                    .form-group
                        label= t.hist_edit.full_name
                        input.input(value=`${results.name} ${results.surname}` id="fullName")
                    .form-group
                        label= t.hist_edit.email
                        input.input(value=`${results.email}` id="email")
                    .form-group
                        label= t.hist_edit.phone
                        input.input(value=`${results.phone}` id="phone")
                    .form-group
                        label= t.hist_edit.date
                        input.input(type="date" value=results.date.toISOString().split('T')[0] id="editDate")
                    .form-group
                        label= t.hist_edit.start_time
                        input.input(type="time" value=results.startTime id="editStartTime")
                    .form-group
                        label= t.hist_edit.notes
                        input.input(value=`${results.message}` id="message")
            .history__edit-actions
                .actions__buttons
                    button.btn.secondary(onclick="history.back()")= t.hist_edit.back
                    button.btn#saveBtnEdit.sec= t.hist_edit.save

block scripts
    script(src="/js/layouts/history.js" type="module")
