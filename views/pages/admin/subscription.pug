extends ../../layouts/admin

include ../../templates/modals/dialog.pug

block links
    link(rel="stylesheet", href="/css/layouts/subscription.css")
    link(rel="stylesheet", href="/css/templates/dialog.css")

block content
    //- ══════════════════════════════════════════════════════════════════════
    //-  Les identifiants et les classes marqués « contrat JS » sont lus par
    //-  public/js/layouts/subscription.js. Les renommer casse silencieusement
    //-  la bascule mensuel/annuel, les prix barrés ou le paiement — sans la
    //-  moindre erreur visible. Contrat exact :
    //-
    //-    #billMonthly / #billYearly      bascule (classe .active portée ici)
    //-    .sub-plans                      conteneur (scroll après un code promo)
    //-    .sub-plan--premium / --studio   cartes payantes, lues par PLANS_PAYANTS
    //-    .sub-plan__price[data-monthly]  prix lu ET réécrit
    //-    .sub-plan__per                  suffixe repris dans la note d'essai
    //-    .sub-plan__pricing              parent où s'insère .sub-promo-wrap
    //-    #getProPlan #getBusinessPlan #getFreePlan #getProPlanAlert
    //-    #cancelSubscriptionPro #retakeSubscription
    //-    #promoCodeInput #applyPromoBtn #promoCodeStatus
    //- ══════════════════════════════════════════════════════════════════════

    -
        //- Libellé d'une offre mise en avant par le superadmin. La page
        //- appelait déjà `_offerLabel(_proOffer)` — sauf que ni la fonction ni
        //- les variables n'existaient : la mention « déjà appliqué » ne s'est
        //- jamais affichée, alors que la remise, elle, partait bien au
        //- paiement. On la calcule ici, à partir des offres que la route a
        //- déjà filtrées pour CE compte.
        function _offerLabel(o) {
            if (!o) return '';
            if (o.discountType === 'trial')   return (o.trialDays || 30) + ' jours gratuits';
            if (o.discountType === 'percent') return '−' + o.discountValue + '% sur la 1ère facture';
            return '−' + o.discountValue + '€ sur la 1ère facture';
        }
        //- Une offre vaut soit pour tous les plans, soit pour un plan précis
        //- (pro_monthly, business_yearly…). On ne l'annonce que sur la carte
        //- concernée : promettre une remise sur la mauvaise carte, c'est un
        //- prix affiché que le serveur refusera.
        function _offerFor(plan) {
            var liste = defaultOffers || [];
            for (var i = 0; i < liste.length; i++) {
                var ap = liste[i].applicablePlan || 'all';
                if (ap === 'all' || ap.indexOf(plan) === 0) return liste[i];
            }
            return null;
        }
        var _proOffer = _offerFor('pro');
        var _bizOffer = _offerFor('business');

    .subscription

        //- ── Bandeaux d'état ──────────────────────────────────────────────
        if isExpired
            .sub-alert.sub-alert--expired
                span.material-symbols-outlined.sub-alert__icon error
                .sub-alert__body
                    p.sub-alert__title= t.subscription.alert_expired_title
                    p.sub-alert__sub= t.subscription.alert_expired_sub
                button.sub-alert__cta#getProPlanAlert(type="button")= t.subscription.alert_expired_btn

        else if user && user.isPremium && isExpiring
            .sub-alert.sub-alert--warning
                span.material-symbols-outlined.sub-alert__icon warning
                .sub-alert__body
                    if hoursLeft
                        p.sub-alert__title #{t.subscription.days_left} : #{hoursLeft} #{hoursLeft > 1 ? t.subscription.hours_suffix_many : t.subscription.hours_suffix_one}
                    else
                        p.sub-alert__title #{t.subscription.days_left} : #{daysLeft} #{daysLeft > 1 ? t.subscription.days_suffix_many : t.subscription.days_suffix_one}
                    p.sub-alert__sub= t.subscription.alert_expiring_sub
                button.sub-alert__cta#getProPlanAlert(type="button")= t.subscription.alert_expiring_btn

        //- ── Titre ────────────────────────────────────────────────────────
        header.sub-hero
            h1.sub-hero__title Un outil qui se rembourse tout seul
            p.sub-hero__sub Commencez gratuitement, sans limite de rendez-vous. Passez au Pro le jour où les rappels automatiques vous manquent.

            //- Le forfait est porté par l'établissement, pas par le compte :
            //- on indique lequel sera facturé. `currentCompanyName` et non
            //- `currentCompany.name` — sur les fiches antérieures au
            //- multi-établissement, le nom vit sur le compte du patron et la
            //- Company l'a vide ; le repli est déjà calculé dans injectCompany.
            if currentCompany
                p.sub-hero__scope
                    span.material-symbols-outlined storefront
                    | Forfait de l'établissement&nbsp;
                    strong= currentCompanyName || 'Mon établissement'

            .sub-toggle(role="group" aria-label="Période de facturation")
                button.sub-toggle__btn.active#billMonthly(type="button")= t.subscription.monthly || 'Mensuel'
                button.sub-toggle__btn#billYearly(type="button")
                    = t.subscription.yearly || 'Annuel'
                    span.sub-toggle__save −20%

            //- Le mois offert n'est dû qu'UNE fois par compte
            //- (utils/freeTrial.js). L'annoncer à quelqu'un qui l'a déjà
            //- consommé, c'est promettre « 0 € aujourd'hui » à quelqu'un que le
            //- serveur va débiter immédiatement.
            if !isPro && essaiGratuitDisponible
                p.sub-hero__trial
                    span.material-symbols-outlined redeem
                    | 1 mois offert sur les formules payantes — 0 € aujourd'hui, débité le mois suivant, annulable en un clic.

        //- ── Les trois formules ───────────────────────────────────────────
        //- Prix issus de utils/tarifs.js : même source que le calcul du revenu
        //- récurrent, pour qu'un montant ne puisse pas diverger entre la page
        //- des formules et la comptabilité.
        .sub-plans#subPlans

            //- ─── Amateur ───────────────────────────────────────────────
            article.sub-plan.sub-plan--starter(class=(!isPro && currentPlan === 'basic') ? 'sub-plan--current' : '')
                if !isPro && currentPlan === 'basic'
                    span.sub-plan__pill.sub-plan__pill--muted Votre formule
                h2.sub-plan__name= _tarifs.basic.libelle
                p.sub-plan__for Pour commencer et se faire connaître
                .sub-plan__pricing
                    span.sub-plan__price Gratuit
                    span.sub-plan__per pour toujours
                .sub-plan__sep
                .sub-plan__grow
                    ul.sub-plan__feats
                        each f in ['Rendez-vous illimités', 'Page de réservation en ligne', '5 prestations', 'Confirmations par e-mail', 'Historique de vos clients', 'Visible dans la recherche']
                            li
                                span.material-symbols-outlined.sub-plan__ok check
                                span= f
                        li.is-off
                            span.material-symbols-outlined.sub-plan__lock lock
                            span Rappels automatiques, Google Agenda, personnalisation
                .sub-plan__cta
                    if !isPro && currentPlan === 'basic'
                        button.sub-plan__btn.sub-plan__btn--quiet(type="button" disabled)= t.subscription.btn_current
                    else
                        button.sub-plan__btn.sub-plan__btn--ghost#getFreePlan(type="button") Revenir à l'Amateur

            //- ─── Pro (mis en avant) ────────────────────────────────────
            article.sub-plan.sub-plan--premium(class=(currentPlan === 'pro' && isPro) ? 'sub-plan--current' : '')
                span.sub-plan__pill.sub-plan__pill--reco= (currentPlan === 'pro' && isPro) ? 'Votre formule' : 'Recommandé'
                h2.sub-plan__name= _tarifs.pro.libelle
                p.sub-plan__for Pour qui travaille tous les jours
                .sub-plan__pricing
                    span.sub-plan__price(
                        data-monthly=String(_tarifs.pro.mensuel)
                        data-yearly=String(_tarifs.pro.annuelParMois)
                    ) #{_tarifs.pro.mensuel}€
                    span.sub-plan__per / mois
                //- Argument chiffré plutôt que promotionnel : un pro ne compare
                //- pas des fonctionnalités, il compare 19 € à une plage vide.
                p.sub-plan__payback 2 rendez-vous manqués en moins, et l'abonnement est remboursé 4 fois.
                .sub-plan__sep
                p.sub-plan__eyebrow Tout l'Amateur, plus
                .sub-plan__grow
                    ul.sub-plan__feats
                        each f in ['Rappels automatiques par e-mail', '50 rappels SMS par mois', 'Synchronisation Google Agenda', 'Page personnalisable', 'Prestations illimitées', '2 collaborateurs', 'Support prioritaire']
                            li
                                span.material-symbols-outlined.sub-plan__ok check
                                span= f
                .sub-plan__cta
                    if currentPlan === 'pro' && isPro
                        button.sub-plan__btn.sub-plan__btn--quiet(type="button" disabled)= t.subscription.btn_current
                        .sub-plan__links
                            if !autoRenew
                                button.sub-plan__link#retakeSubscription(type="button")= t.subscription.btn_retake
                            else
                                button.sub-plan__link.sub-plan__link--danger#cancelSubscriptionPro(type="button")= t.subscription.btn_cancel
                        p.sub-plan__left(class=isExpired ? 'is-expired' : isExpiring ? 'is-expiring' : '')
                            if isExpired
                                = t.subscription.expired_label
                            else if isBetaAccess && daysLeft === null
                                | Accès offert
                            else if hoursLeft
                                | #{t.subscription.days_left} :&nbsp;
                                strong #{hoursLeft} #{hoursLeft > 1 ? t.subscription.hours_suffix_many : t.subscription.hours_suffix_one}
                            else if daysLeft !== null
                                | #{t.subscription.days_left} :&nbsp;
                                strong #{daysLeft} #{t.subscription.days}
                    else if currentPlan === 'business' && isPro
                        //- Déjà au-dessus : proposer « Passer au Pro » serait
                        //- une rétrogradation déguisée en achat.
                        button.sub-plan__btn.sub-plan__btn--quiet(type="button" disabled) Inclus dans votre Pro+
                    else
                        button.sub-plan__btn.sub-plan__btn--accent#getProPlan(type="button")
                            if essaiGratuitDisponible
                                | Essayer le Pro gratuitement
                            else
                                | Passer au Pro
                        if !isPro && _proOffer
                            p.sub-plan__offer
                                span.material-symbols-outlined card_giftcard
                                | #{_offerLabel(_proOffer)} — déjà appliqué

            //- ─── Pro+ ──────────────────────────────────────────────────
            article.sub-plan.sub-plan--studio(class=(currentPlan === 'business' && isPro) ? 'sub-plan--current' : '')
                span.sub-plan__pill.sub-plan__pill--muted= (currentPlan === 'business' && isPro) ? 'Votre formule' : 'Équipes'
                h2.sub-plan__name= _tarifs.business.libelle
                p.sub-plan__for Pour les cabinets et les salons
                .sub-plan__pricing
                    span.sub-plan__price(
                        data-monthly=String(_tarifs.business.mensuel)
                        data-yearly=String(_tarifs.business.annuelParMois)
                    ) #{_tarifs.business.mensuel}€
                    span.sub-plan__per / mois
                .sub-plan__sep
                p.sub-plan__eyebrow Tout le Pro, plus
                .sub-plan__grow
                    ul.sub-plan__feats
                        each f in ['200 rappels SMS par mois', '10 collaborateurs', 'Plusieurs établissements', 'Cours collectifs et ateliers', 'Votre site vitrine', 'Sans marque BranShee', 'Support dédié']
                            li
                                span.material-symbols-outlined.sub-plan__ok check
                                span= f
                .sub-plan__cta
                    if currentPlan === 'business' && isPro
                        button.sub-plan__btn.sub-plan__btn--quiet(type="button" disabled)= t.subscription.btn_current
                        .sub-plan__links
                            if !autoRenew
                                button.sub-plan__link#retakeSubscription(type="button")= t.subscription.btn_retake
                            else
                                button.sub-plan__link.sub-plan__link--danger#cancelSubscriptionPro(type="button")= t.subscription.btn_cancel
                    else
                        button.sub-plan__btn.sub-plan__btn--dark#getBusinessPlan(type="button") Passer au Pro+
                        if !isPro && _bizOffer
                            p.sub-plan__offer
                                span.material-symbols-outlined card_giftcard
                                | #{_offerLabel(_bizOffer)} — déjà appliqué

        //- ── Tableau comparatif ───────────────────────────────────────────
        //- Les lignes sont déclarées en données plutôt qu'en balisage : une
        //- ligne oubliée dans une colonne était invisible à la relecture, et le
        //- tableau promettait des limites que planLimits.js ne tenait pas.
        //- true = inclus · false = absent · une chaîne = la valeur.
        //-
        //- Les rubriques nomment le RÉSULTAT pour le pro, pas la catégorie
        //- technique : « ne plus perdre de rendez-vous » lui parle,
        //- « notifications » non.
        -
            var _lignes = [
                { groupe: 'Agenda et réservations' },
                { l: 'Rendez-vous par mois',            a: 'Illimités', p: 'Illimités',  b: 'Illimités' },
                { l: 'Prestations',                     a: '5',         p: 'Illimitées', b: 'Illimitées' },
                { l: 'Page de réservation en ligne',    a: true,        p: true,         b: true },
                { l: 'Réservation 24h/24',              a: true,        p: true,         b: true },
                { l: 'Historique de vos clients',       a: true,        p: true,         b: true },
                { l: 'Congés et indisponibilités',      a: true,        p: true,         b: true },
                { l: 'Cours collectifs et ateliers',    a: false,       p: false,        b: true },

                { groupe: 'Ne plus perdre de rendez-vous' },
                { l: 'Confirmations par e-mail',        a: true,        p: true,         b: true },
                { l: 'Rappels automatiques e-mail',     a: false,       p: true,         b: true },
                { l: 'Rappels SMS par mois',            a: false,       p: '50',         b: '200' },
                { l: 'Annulation en un clic',           a: true,        p: true,         b: true },
                { l: 'Synchronisation Google Agenda',   a: false,       p: true,         b: true },

                { groupe: 'Votre image' },
                { l: 'Visible dans la recherche',       a: true,        p: true,         b: true },
                { l: 'Page personnalisable',            a: false,       p: true,         b: true },
                { l: 'Galerie photos',                  a: false,       p: true,         b: true },
                { l: 'Avis clients',                    a: true,        p: true,         b: true },
                { l: 'Votre site vitrine',              a: false,       p: false,        b: true },
                { l: 'URL personnalisée',               a: false,       p: 'Option',     b: 'Incluse' },
                { l: 'Sans marque BranShee',            a: false,       p: false,        b: true },

                { groupe: 'Organisation' },
                { l: 'Collaborateurs inclus',           a: false,       p: '2',          b: '10' },
                { l: 'Plusieurs établissements',        a: false,       p: false,        b: true },
                { l: 'Formulaire de réservation',       a: '1 question', p: '5 questions', b: '10 questions' },
                { l: 'Statistiques',                    a: 'Basiques',  p: 'Complètes',  b: 'Complètes' },
                { l: 'Support',                         a: 'Standard',  p: 'Prioritaire', b: 'Dédié' },
            ];

        section.sub-compare
            h2.sub-compare__title Comparer les formules
            .sub-compare__wrap
                table.sub-compare__table
                    thead
                        tr
                            th(scope="col")
                            th(scope="col")
                                span.sub-compare__plan= _tarifs.basic.libelle
                                span.sub-compare__price Gratuit
                            th.sub-compare__th--pro(scope="col")
                                span.sub-compare__plan= _tarifs.pro.libelle
                                span.sub-compare__price #{_tarifs.pro.mensuel}€ / mois
                            th(scope="col")
                                span.sub-compare__plan= _tarifs.business.libelle
                                span.sub-compare__price #{_tarifs.business.mensuel}€ / mois
                    tbody
                        each ligne in _lignes
                            if ligne.groupe
                                tr.sub-compare__group
                                    td(colspan="4")= ligne.groupe
                            else
                                tr
                                    td= ligne.l
                                    each v in [ligne.a, ligne.p, ligne.b]
                                        td
                                            if v === true
                                                span.sub-compare__yes
                                                    span.material-symbols-outlined check
                                            else if v === false
                                                span.sub-compare__no —
                                            else
                                                span.sub-compare__val= v

        //- ── Code promo ───────────────────────────────────────────────────
        section.sub-promo#promoCodeSection
            .sub-promo__head
                span.material-symbols-outlined.sub-promo__icon local_offer
                .sub-promo__text
                    span.sub-promo__title= t.subscription.promo_label
                    span.sub-promo__desc Réduction immédiate sur votre abonnement
            .sub-promo__field
                input.sub-promo__input#promoCodeInput(
                    type="text"
                    placeholder=t.subscription.promo_placeholder
                    autocomplete="off"
                    spellcheck="false"
                )
                button.sm-btn.sm-btn--primary#applyPromoBtn(type="button")
                    span= t.subscription.promo_apply
            p.sub-promo__status#promoCodeStatus

        p.sub-foot Sans engagement · Résiliable en un clic · Aucune commission sur vos rendez-vous

    +dialog()

block scripts
    -
        // `<` échappé : un code promo est saisi en superadmin, il n'a rien à
        // faire d'un « </script> » mais on ne l'injecte pas brut pour autant.
        var offresAutoJson = JSON.stringify((defaultOffers || []).map(function (o) {
            return { code: o.code, discountType: o.discountType, discountValue: o.discountValue,
                     trialDays: o.trialDays, applicablePlan: o.applicablePlan || 'all' };
        })).replace(/</g, '\\u003c');
    - var subTJson = JSON.stringify({ checking: t.subscription.promo_checking, invalid: t.subscription.promo_invalid, cancel_title: t.subscription.dialog_cancel_title, cancel_desc: t.subscription.dialog_cancel_desc, resume_title: t.subscription.dialog_resume_title, resume_desc: t.subscription.dialog_resume_desc, confirm: t.subscription.dialog_confirm, close: t.subscription.dialog_close, success_cancel: t.subscription.dialog_success_cancel, success_resume: t.subscription.dialog_success_resume })
    script.
        window.__subT = !{subTJson};
        // Offres mises en avant par le superadmin. Elles s'appliquent toutes
        // seules : le JS barre le prix plein, affiche le prix remisé et envoie
        // le code au paiement. La route a déjà écarté celles que ce compte ne
        // peut pas obtenir (expirées, épuisées, déjà utilisées par lui).
        window.__offresAuto = !{offresAutoJson};
        // Cartes déjà enregistrées — utilisées par la boîte de confirmation
        // d'achat pour proposer « payer avec la carte X ou en changer » plutôt
        // que de débiter directement au clic.
        window.__paymentMethods = !{JSON.stringify(paymentMethods || [])};
        // Le mois offert n'est dû qu'une fois par compte. `=== true` et non
        // `!== false` : si la variable venait à manquer, on annoncerait le prix
        // plein plutôt qu'une gratuité que le serveur refuserait. Décevoir en
        // bien vaut mieux que trahir une promesse.
        window.__trialAvailable = !{JSON.stringify(essaiGratuitDisponible === true)};
    script(src="/js/templates/dialog.js")
    script(src="/js/layouts/subscription.js")
    //- Aucun gestionnaire inline ici. Le bouton du bandeau d'expiration
    //- (#getProPlanAlert) est déjà câblé par subscription.js, qui lui pose son
    //- propre onclick : en rajouter un second rouvrait la boîte de
    //- confirmation deux fois de suite.
