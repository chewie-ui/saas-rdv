extends ../../layouts/admin

include ../../templates/modals/dialog.pug

block links
    link(rel="stylesheet", href="/css/layouts/subscription.css")
    link(rel="stylesheet", href="/css/templates/dialog.css")

block content
    .subscription

        //- ── Alert banners ───────────────────────────────────────────
        if isExpired
            .sub-alert.sub-alert--expired
                .sub-alert__icon
                    span.material-symbols-outlined error
                .sub-alert__body
                    p.sub-alert__title= t.subscription.alert_expired_title
                    p.sub-alert__sub= t.subscription.alert_expired_sub
                button.sub-alert__cta#getProPlanAlert= t.subscription.alert_expired_btn

        else if user && user.isPremium && isExpiring
            .sub-alert.sub-alert--warning
                .sub-alert__icon
                    span.material-symbols-outlined warning
                .sub-alert__body
                    if hoursLeft
                        p.sub-alert__title #{t.subscription.days_left} : #{hoursLeft} #{hoursLeft > 1 ? t.subscription.hours_suffix_many : t.subscription.hours_suffix_one}
                    else
                        p.sub-alert__title #{t.subscription.days_left} : #{daysLeft} #{daysLeft > 1 ? t.subscription.days_suffix_many : t.subscription.days_suffix_one}
                    p.sub-alert__sub= t.subscription.alert_expiring_sub
                button.sub-alert__cta.sub-alert__cta--warn#getProPlanAlert= t.subscription.alert_expiring_btn

        //- ── Hero ───────────────────────────────────────────────────
        .sub-hero
            .sub-hero__badge
                span.material-symbols-outlined(style=`font-size:12px`) circle
                | &nbsp;#{t.sub_extra.choose_plan || 'Tarifs'}
            h1.sub-hero__title= t.subscription.hero_title || 'Des prix simples. Pas de surprises.'
            p.sub-hero__sub= t.subscription.hero_sub || 'Commencez gratuitement. Passez au Pro quand votre activité décolle.'

            //- Le forfait est porté par l'établissement : on indique lequel sera
            //- concerné (l'établissement actif). Pour en faire passer un autre,
            //- basculer dessus via le sélecteur d'établissement.
            if currentCompany
                p.sub-hero__scope(style="margin-top:10px;font-size:13px;color:var(--text-muted,#6b7280)")
                    span.material-symbols-outlined(style="font-size:16px;vertical-align:-3px;margin-right:5px") storefront
                    | Forfait pour l'établissement : #[strong= currentCompany.name || 'Mon établissement']

            //- Billing toggle
            .sub-toggle
                button.sub-toggle__btn#billMonthly(class="active")= t.subscription.monthly || 'Mensuel'
                button.sub-toggle__btn.sub-toggle__btn--yearly#billYearly
                    = t.subscription.yearly || 'Annuel'
                    span.sub-toggle__discount  −20%

            //- Rappel essai gratuit + annulation libre — pour que la promesse
            //- "1 mois gratuit inclus" (cf. badge sur /register et CTAs marketing)
            //- soit explicite avant le paiement, et que le client sache qu'il ne
            //- sera débité qu'au mois suivant et peut annuler quand il veut.
            if !isPro
                p.sub-trial-note
                    span= t.sub_extra.trial_note || "🎁 1 mois offert sur les plans payants — 0 € aujourd'hui, vous ne serez débité qu'au mois suivant, et vous pouvez annuler à tout moment en un clic."

        //- ── Free tier usage bar ─────────────────────────────────────
        if !isPro && monthlyBookingCount !== null
            - var pct = Math.min(Math.round((monthlyBookingCount / 20) * 100), 100)
            - var usageClass = pct >= 90 ? 'sub-usage--danger' : pct >= 60 ? 'sub-usage--warn' : ''
            .sub-usage(class=usageClass)
                .sub-usage__top
                    span.sub-usage__label
                        span.material-symbols-outlined calendar_month
                        | &nbsp;#{t.subscription.usage_label || 'Réservations ce mois'}
                    span.sub-usage__count
                        strong= monthlyBookingCount
                        | &nbsp;#{t.subscription.usage_of || 'sur'}&nbsp;
                        strong 20
                .sub-usage__bar
                    .sub-usage__fill(style=`width:${pct}%`)
                p.sub-usage__hint= t.subscription.usage_limit || '30 max — passez au Pro pour supprimer cette limite'

        //- ── Upgrade incentive strip (free users only) ───────────────
        if !isPro
            .sub-upgrade-strip
                .sub-upgrade-strip__perks
                    .sub-upgrade-strip__perk
                        span.material-symbols-outlined email
                        span Rappels email auto.
                    .sub-upgrade-strip__perk
                        span.material-symbols-outlined calendar_month
                        span Google Calendar
                    .sub-upgrade-strip__perk
                        span.material-symbols-outlined groups
                        span Jusqu'à 5 employés
                    .sub-upgrade-strip__perk
                        span.material-symbols-outlined description
                        span Page personnalisable
                    .sub-upgrade-strip__perk
                        span.material-symbols-outlined all_inclusive
                        span RDV illimités
                button.sub-upgrade-strip__cta#getProPlanStrip(type="button")
                    | Essayer Pro gratuitement →

        //- ── Sélecteur d'audience : Individuel / Équipe ──────────────
        //- Individuel = Free / Essentiel / Pro · Équipe = Business / Sur mesure.
        .sub-segment#audienceToggle
            button.sub-segment__btn.is-active(type="button" data-aud="individuel")
                span.material-symbols-outlined person
                span Individuel
            button.sub-segment__btn(type="button" data-aud="equipe")
                span.material-symbols-outlined groups
                span Équipe

        //- ── Plan cards ──────────────────────────────────────────────
        .sub-plans#subPlans(data-active="individuel")

            //- ─── Starter (Free) ────────────────────────────────────
            .sub-plan.sub-plan--starter(data-group="individuel" class=(!isPro && currentPlan === 'basic') ? 'sub-plan--current' : '')
                .sub-plan__header
                    .sub-plan__name-wrap
                        h2.sub-plan__name= t.subscription.plan_1
                        p.sub-plan__desc= t.subscription.plan_1_desc || 'Pour découvrir BranShee'
                    .sub-plan__pricing
                        span.sub-plan__price= t.subscription.price_1
                        span.sub-plan__per &nbsp;#{t.subscription.price_1_sub || ''}
                .sub-plan__divider
                .sub-plan__features
                    each feature in t.subscription.plan_1_features
                        .sub-plan__feature
                            span.material-symbols-outlined.feat-check check
                            span= feature
                    //- What's NOT included (shown as locked items)
                    .sub-plan__feature.sub-plan__feature--locked
                        span.material-symbols-outlined.feat-lock lock
                        span Rappels email, Google Calendar, personnalisation…
                .sub-plan__cta
                    if currentPlan === 'basic'
                        button.sub-btn.sub-btn--current(disabled)= t.subscription.btn_current
                    else
                        button.sub-btn.sub-btn--outline#getFreePlan= t.subscription.btn_downgrade

            //- ─── Essentiel ─────────────────────────────────────────
            .sub-plan.sub-plan--essentiel(data-group="individuel" class=(currentPlan === 'essentiel') ? 'sub-plan--current' : '')
                .sub-plan__header
                    .sub-plan__name-wrap
                        h2.sub-plan__name= t.subscription.plan_ess || 'Essentiel'
                        p.sub-plan__desc= t.subscription.plan_ess_desc || 'La prise de rendez-vous en ligne, sans limite'
                    .sub-plan__pricing
                        //- data-yearly n'est posé que si le prix annuel existe côté
                        //- Stripe : sans lui, le bouton « Annuel » laisse le tarif
                        //- mensuel affiché (et c'est bien 9 € qui sera facturé).
                        if essentielYearlyAvailable
                            span.sub-plan__price(data-monthly="9" data-yearly="7") 9€
                        else
                            span.sub-plan__price 9€
                        span.sub-plan__per= t.subscription.price_2_sub || '/mois'
                .sub-plan__divider
                .sub-plan__features
                    each feature in (t.subscription.plan_ess_features || ['Rendez-vous illimités', 'Historique complet conservé', 'Vos services & votre catalogue', 'Page de réservation en ligne'])
                        .sub-plan__feature
                            span.material-symbols-outlined.feat-check check
                            span= feature
                    .sub-plan__feature.sub-plan__feature--locked
                        span.material-symbols-outlined.feat-lock lock
                        span Collaborateurs, personnalisation, rappels, formulaires…
                .sub-plan__cta
                    if currentPlan === 'essentiel'
                        button.sub-btn.sub-btn--current(disabled)= t.subscription.btn_current
                        .sub-plan__links
                            if !autoRenew
                                span.sub-link#retakeSubscription= t.subscription.btn_retake
                            if autoRenew
                                span.sub-link.sub-link--danger#cancelSubscriptionPro= t.subscription.btn_cancel
                        .sub-time-left(class=isExpired ? 'expired' : isExpiring ? 'expiring' : '')
                            if isExpired
                                | #{t.subscription.expired_label}
                            else if hoursLeft
                                | #{t.subscription.days_left} :&nbsp;
                                strong #{hoursLeft} #{hoursLeft > 1 ? t.subscription.hours_suffix_many : t.subscription.hours_suffix_one}
                            else if daysLeft !== null
                                | #{t.subscription.days_left} :&nbsp;
                                strong #{daysLeft} #{t.subscription.days}
                    else
                        button.sub-btn.sub-btn--upgrade#getEssPlan= t.subscription.btn_get_ess || "Choisir l'Essentiel →"

            -
                //- ── Helpers offres actives ──────────────────────────
                //- Cherche une offre active qui s'applique à un plan donné.
                function _offerFor(plan, offers) {
                    if (!offers || !offers.length) return null;
                    return offers.find(function(o) {
                        var ap = o.applicablePlan || 'all';
                        return ap === 'all' || ap === plan + '_monthly' || ap === plan + '_yearly'
                            || ap === 'premium_monthly' && plan === 'pro'
                            || ap === 'premium_yearly'  && plan === 'pro';
                    }) || null;
                }
                function _offerLabel(o) {
                    if (!o) return '';
                    if (o.discountType === 'trial') return '🎁 ' + (o.trialDays || 30) + ' jours gratuits';
                    if (o.discountType === 'percent') return '🎉 -' + o.discountValue + '%';
                    return '🎉 -' + o.discountValue + '€';
                }
                var _proOffer  = _offerFor('pro', defaultOffers);
                var _bizOffer  = _offerFor('business', defaultOffers);

            //- ─── Pro ───────────────────────────────────────────────
            .sub-plan.sub-plan--premium(data-group="individuel" class=(currentPlan === 'pro' && isPro) ? 'sub-plan--current' : '')
                .sub-plan__popular= t.sub_extra.popular || 'Le plus populaire'
                .sub-plan__header
                    .sub-plan__name-wrap
                        h2.sub-plan__name= t.subscription.plan_2
                        p.sub-plan__desc= t.subscription.plan_2_desc || 'Pour les indépendants'
                    .sub-plan__pricing
                        if _proOffer
                            .sub-plan__offer-badge= _offerLabel(_proOffer)
                            small.sub-plan__then puis&nbsp;
                                span.sub-plan__price(
                                    data-monthly=t.subscription.price_2_val || '19'
                                    data-yearly=t.subscription.price_2_yearly_val || '15'
                                )= t.subscription.price_2
                                | /mois
                        else
                            span.sub-plan__price(
                                data-monthly=t.subscription.price_2_val || '19'
                                data-yearly=t.subscription.price_2_yearly_val || '15'
                            )= t.subscription.price_2
                            span.sub-plan__per= t.subscription.price_2_sub
                .sub-plan__divider
                .sub-plan__features
                    each feature in t.subscription.plan_2_features
                        .sub-plan__feature
                            span.material-symbols-outlined.feat-check check
                            span= feature
                .sub-plan__cta
                    if currentPlan === 'pro' && isPro
                        button.sub-btn.sub-btn--current.sub-btn--premium-current(disabled)= t.subscription.btn_current
                        .sub-plan__links
                            if !autoRenew
                                span.sub-link#retakeSubscription= t.subscription.btn_retake
                            if autoRenew
                                span.sub-link.sub-link--danger#cancelSubscriptionPro= t.subscription.btn_cancel
                        .sub-time-left(class=isExpired ? 'expired' : isExpiring ? 'expiring' : '')
                            if isExpired
                                | #{t.subscription.expired_label}
                            else if isBetaAccess && daysLeft === null
                                | 🧪 Accès bêta
                            else if hoursLeft
                                | #{t.subscription.days_left} :&nbsp;
                                strong #{hoursLeft} #{hoursLeft > 1 ? t.subscription.hours_suffix_many : t.subscription.hours_suffix_one}
                            else
                                | #{t.subscription.days_left} :&nbsp;
                                strong #{daysLeft} #{t.subscription.days}
                    else if currentPlan !== 'business'
                        button.sub-btn.sub-btn--upgrade#getProPlan
                            | #{t.subscription.btn_get_pro || 'Passer au Pro →'}
                        if !isPro && _proOffer
                            button.sub-btn.sub-btn--free-month.js-offer-btn(
                                type="button"
                                data-plan="pro"
                                data-code=_proOffer.code
                            )
                                span.material-symbols-outlined(style=`font-size:15px`) card_giftcard
                                | &nbsp;#{_offerLabel(_proOffer)} (code #{_proOffer.code})

            //- ─── Business ──────────────────────────────────────────
            .sub-plan.sub-plan--studio(data-group="equipe" class=(currentPlan === 'business' && isPro) ? 'sub-plan--current' : '')
                .sub-plan__badge-business= t.subscription.plan_3_badge || 'Pour les équipes'
                .sub-plan__header
                    .sub-plan__name-wrap
                        h2.sub-plan__name= t.subscription.plan_3
                        p.sub-plan__desc= t.subscription.plan_3_desc || 'Pour les équipes'
                    .sub-plan__pricing
                        if _bizOffer
                            .sub-plan__offer-badge= _offerLabel(_bizOffer)
                            small.sub-plan__then puis&nbsp;
                                span.sub-plan__price(
                                    data-monthly=t.subscription.price_3_val || '49'
                                    data-yearly=t.subscription.price_3_yearly_val || '39'
                                )= t.subscription.price_3
                                | /mois
                        else
                            span.sub-plan__price(
                                data-monthly=t.subscription.price_3_val || '49'
                                data-yearly=t.subscription.price_3_yearly_val || '39'
                            )= t.subscription.price_3
                            span.sub-plan__per= t.subscription.price_3_sub
                .sub-plan__divider
                .sub-plan__features
                    .sub-plan__feature.sub-plan__feature--includes
                        span.material-symbols-outlined check_circle
                        em= t.sub_extra.includes_pro || 'Inclut tout ce que Pro offre'
                    each feature, fi in t.subscription.plan_3_features
                        if fi > 0
                            .sub-plan__feature
                                span.material-symbols-outlined.feat-check.feat-check--business check
                                span= feature
                .sub-plan__cta
                    if currentPlan === 'business' && isPro
                        button.sub-btn.sub-btn--current.sub-btn--premium-current(disabled)= t.subscription.btn_current
                        .sub-plan__links
                            if !autoRenew
                                span.sub-link#retakeSubscription= t.subscription.btn_retake
                            if autoRenew
                                span.sub-link.sub-link--danger#cancelSubscriptionPro= t.subscription.btn_cancel
                        .sub-time-left(class=isExpired ? 'expired' : isExpiring ? 'expiring' : '')
                            if isExpired
                                | #{t.subscription.expired_label}
                            else if isBetaAccess && daysLeft === null
                                | 🧪 Accès bêta
                            else if hoursLeft
                                | #{t.subscription.days_left} :&nbsp;
                                strong #{hoursLeft} #{hoursLeft > 1 ? t.subscription.hours_suffix_many : t.subscription.hours_suffix_one}
                            else
                                | #{t.subscription.days_left} :&nbsp;
                                strong #{daysLeft} #{t.subscription.days}
                    else
                        button.sub-btn.sub-btn--upgrade.sub-btn--business#getBusinessPlan
                            | #{t.subscription.btn_get_business || 'Passer au Business →'}
                        if !isPro && _bizOffer
                            button.sub-btn.sub-btn--free-month.js-offer-btn(
                                type="button"
                                data-plan="business"
                                data-code=_bizOffer.code
                            )
                                span.material-symbols-outlined(style=`font-size:15px`) card_giftcard
                                | &nbsp;#{_offerLabel(_bizOffer)} (code #{_bizOffer.code})

            //- ─── Sur mesure (grandes entreprises) ──────────────────
            .sub-plan.sub-plan--custom(data-group="equipe")
                .sub-plan__badge-business Sur mesure
                .sub-plan__header
                    .sub-plan__name-wrap
                        h2.sub-plan__name Sur mesure
                        p.sub-plan__desc Pour les grandes entreprises & réseaux
                    .sub-plan__pricing
                        span.sub-plan__price--custom Sur devis
                .sub-plan__divider
                .sub-plan__features
                    .sub-plan__feature.sub-plan__feature--includes
                        span.material-symbols-outlined check_circle
                        em Tout ce que Business offre, sans limite
                    each feature in ['Nombre de services au choix', 'Employés & établissements illimités', "Volume d'appels API défini avec vous", 'Fonctionnalités activées à la carte', 'Account manager dédié', 'SLA & sécurité renforcée']
                        .sub-plan__feature
                            span.material-symbols-outlined.feat-check.feat-check--business check
                            span= feature
                .sub-plan__cta
                    a.sub-btn.sub-btn--contact(href="/support")
                        span.material-symbols-outlined(style="font-size:18px") mail
                        | &nbsp;Contactez-nous

        //- ── Comparison table ────────────────────────────────────────
        mixin cmpYes
          span.material-symbols-outlined.cmp-yes check
        mixin cmpNo
          span.material-symbols-outlined.cmp-no close

        .sub-compare
            h2.sub-compare__title= t.subscription.compare_title || 'Comparer les fonctionnalités'
            .sub-compare__wrap
                table.sub-compare__table
                    thead
                        tr
                            th.sub-compare__th--label
                            th.sub-compare__th
                                span= t.subscription.plan_1
                            th.sub-compare__th
                                span= t.subscription.plan_ess || 'Essentiel'
                            th.sub-compare__th.sub-compare__th--pro
                                span.material-symbols-outlined(style=`font-size:12px`) star
                                | &nbsp;#{t.subscription.plan_2}
                            th.sub-compare__th.sub-compare__th--biz
                                | #{t.subscription.plan_3}
                    tbody
                        tr
                            td= t.subscription.compare_bookings || 'RDV / mois'
                            td 20
                            td: span.cmp-inf ∞
                            td: span.cmp-inf ∞
                            td: span.cmp-inf ∞
                        tr
                            td= t.subscription.compare_services || 'Services'
                            td 5
                            td 5
                            td 20
                            td: span.cmp-inf ∞
                        tr
                            td Historique conservé
                            td 7 j
                            td: +cmpYes
                            td: +cmpYes
                            td: +cmpYes
                        tr
                            td= t.subscription.compare_reminders || 'Rappels email'
                            td: +cmpNo
                            td: +cmpNo
                            td: +cmpYes
                            td: +cmpYes
                        tr
                            td= t.subscription.compare_sms || 'Rappels SMS / mois'
                            td: +cmpNo
                            td: +cmpNo
                            td 30
                            td 100
                        tr
                            td= t.subscription.compare_gcal || 'Google Calendar'
                            td: +cmpNo
                            td: +cmpNo
                            td: +cmpYes
                            td: +cmpYes
                        tr
                            td= t.subscription.compare_custom || 'Page personnalisable'
                            td: +cmpNo
                            td: +cmpNo
                            td: +cmpYes
                            td: +cmpYes
                        tr
                            td= t.subscription.compare_forms || 'Questions formulaire'
                            td 1
                            td 1
                            td 5
                            td 10
                        tr
                            td Collaborateurs inclus
                            td: +cmpNo
                            td: +cmpNo
                            td 1
                            td 4
                        tr
                            td Établissements
                            td 1
                            td 1
                            td 1
                            td 5
                        tr
                            td Cours collectifs
                            td: +cmpNo
                            td: +cmpNo
                            td: +cmpNo
                            td: +cmpYes
                        tr
                            td= t.subscription.compare_url || 'URL personnalisée'
                            td: +cmpNo
                            td: +cmpNo
                            td.cmp-addon= t.subscription.compare_addon || 'Add-on'
                            td: +cmpYes
                        tr
                            td= t.subscription.compare_branding || 'Sans branding BranShee'
                            td: +cmpNo
                            td: +cmpNo
                            td: +cmpNo
                            td: +cmpYes
                        tr
                            td= t.subscription.compare_support || 'Support'
                            td= t.subscription.compare_standard || 'Standard'
                            td= t.subscription.compare_standard || 'Standard'
                            td= t.subscription.compare_priority || 'Prioritaire'
                            td= t.subscription.compare_dedicated || 'Dédié'
            //- Compare CTAs
            .sub-compare__actions
                if !isPro
                    //- L'Essentiel manquait sous le tableau : on comparait les
                    //- quatre colonnes puis on ne pouvait choisir que Pro ou
                    //- Business. Masqué si c'est déjà le plan en cours.
                    if currentPlan !== 'essentiel'
                        button.sub-btn.sub-btn--upgrade.sub-btn--essentiel#getEssPlan2
                            | #{t.subscription.btn_get_ess || "Choisir l'Essentiel →"}
                    button.sub-btn.sub-btn--upgrade#getProPlan2
                        | #{t.subscription.btn_get_pro || 'Passer au Pro →'}
                    button.sub-btn.sub-btn--upgrade.sub-btn--business#getBusinessPlan2
                        | #{t.subscription.btn_get_business || 'Passer au Business →'}

        //- ── Promo code ──────────────────────────────────────────────
        .sub-promo#promoCodeSection
            .sub-promo__inner
                .sub-promo__left
                    .sub-promo__icon
                        span.material-symbols-outlined local_offer
                    .sub-promo__text
                        span.sub-promo__title= t.subscription.promo_label
                        span.sub-promo__desc Réduction immédiate sur votre abonnement
                .sub-promo__right
                    .sub-promo__field
                        input.sub-promo__input#promoCodeInput(
                            type="text"
                            placeholder=t.subscription.promo_placeholder
                            autocomplete="off"
                            style="text-transform:uppercase;"
                        )
                        button.sm-btn.sm-btn--primary#applyPromoBtn
                            span= t.subscription.promo_apply
            .sub-promo__status#promoCodeStatus

    +dialog()

block scripts
    - var subTJson = JSON.stringify({ checking: t.subscription.promo_checking, invalid: t.subscription.promo_invalid, cancel_title: t.subscription.dialog_cancel_title, cancel_desc: t.subscription.dialog_cancel_desc, resume_title: t.subscription.dialog_resume_title, resume_desc: t.subscription.dialog_resume_desc, confirm: t.subscription.dialog_confirm, close: t.subscription.dialog_close, success_cancel: t.subscription.dialog_success_cancel, success_resume: t.subscription.dialog_success_resume })
    script.
        window.__subT = !{subTJson};
        // Cartes déjà enregistrées — utilisées par la boîte de confirmation
        // d'achat pour proposer "payer instant avec carte X ou changer de
        // carte" plutôt que de débiter directement au clic.
        window.__paymentMethods = !{JSON.stringify(paymentMethods || [])};
        // Le mois offert n'est dû qu'une fois par compte : sans ce drapeau, la
        // boîte de confirmation annonçait « 30 jours offerts » à quelqu'un que
        // le serveur allait facturer immédiatement.
        // `=== true` et non `!== false` : si la variable venait à manquer, on
        // annoncerait le prix plein plutôt qu'une gratuité que le serveur
        // refuserait. Décevoir en bien vaut mieux que trahir une promesse.
        window.__trialAvailable = !{JSON.stringify(essaiGratuitDisponible === true)};
    script(src="/js/templates/dialog.js")
    script(src="/js/layouts/subscription.js")
    script.
        // Wire getProPlan2 / getBusinessPlan2 (compare table CTAs) to the same handlers
        document.addEventListener('DOMContentLoaded', function() {
            var p2 = document.getElementById('getProPlan2');
            var b2 = document.getElementById('getBusinessPlan2');
            var ps = document.getElementById('getProPlanStrip');
            var p1 = document.getElementById('getProPlan');
            var b1 = document.getElementById('getBusinessPlan');
            if (p2 && p1) p2.addEventListener('click', function() { p1.click(); });
            if (ps && p1) ps.addEventListener('click', function() { p1.click(); });

            // Essentiel : le bouton du tableau rejoue celui de la carte. Les
            // deux plans sont dans le groupe « Individuel », deja affiche —
            // pas besoin de basculer comme pour Business.
            var e2 = document.getElementById('getEssPlan2');
            var e1 = document.getElementById('getEssPlan');
            if (e2 && e1) e2.addEventListener('click', function() { e1.click(); });

            // « Passer au Business » sous le tableau comparatif : la carte
            // Business vit dans le groupe « Équipe », or la page s'ouvre
            // toujours sur « Individuel ». Le bouton lançait donc le paiement
            // d'un plan dont on n'avait JAMAIS vu la fiche ni le prix.
            // On bascule sur le bon groupe et on amène la carte à l'écran :
            // c'est elle qui porte le detail et son propre bouton.
            if (b2) b2.addEventListener('click', function () {
                var seg2 = document.getElementById('audienceToggle');
                var plans2 = document.getElementById('subPlans');
                if (plans2) plans2.setAttribute('data-active', 'equipe');
                if (seg2) seg2.querySelectorAll('.sub-segment__btn').forEach(function (b) {
                    b.classList.toggle('is-active', b.dataset.aud === 'equipe');
                });
                var carte = document.querySelector('.sub-plan--studio');
                if (carte) {
                    carte.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    // Halo bref : sans ça, on ne comprend pas ce qui vient de
                    // bouger apres le defilement.
                    carte.classList.add('sub-plan--flash');
                    setTimeout(function () { carte.classList.remove('sub-plan--flash'); }, 1600);
                }
            });

            // ── Sélecteur Individuel / Équipe : filtre les cartes de plan ──
            var seg = document.getElementById('audienceToggle');
            var plansEl = document.getElementById('subPlans');
            if (seg && plansEl) {
                function setAudience(aud) {
                    plansEl.setAttribute('data-active', aud);
                    seg.querySelectorAll('.sub-segment__btn').forEach(function (b) {
                        b.classList.toggle('is-active', b.dataset.aud === aud);
                    });
                }
                seg.addEventListener('click', function (e) {
                    var btn = e.target.closest('.sub-segment__btn');
                    if (btn) setAudience(btn.dataset.aud);
                });
                // On reste toujours sur « Individuel » à l'ouverture (c'est l'entrée
                // de gamme, et la majorité des visiteurs) — on ne bascule plus
                // automatiquement sur « Équipe » quand le plan actuel en fait partie.
            }
        });
