extends ../../layouts/admin

include ../../templates/modals/dialog.pug

block links
    link(rel="stylesheet", href="/css/layouts/subscription.css")
    link(rel="stylesheet", href="/css/templates/dialog.css")

block content
    .subscription

        //- ── Alert banners ───────────────────────────────────────────
        if isExpired
            .sub-alert.sub-alert--expired
                .sub-alert__icon
                    span.material-symbols-outlined error
                .sub-alert__body
                    p.sub-alert__title= t.subscription.alert_expired_title
                    p.sub-alert__sub= t.subscription.alert_expired_sub
                button.sub-alert__cta#getProPlanAlert= t.subscription.alert_expired_btn

        else if user && user.isPremium && isExpiring
            .sub-alert.sub-alert--warning
                .sub-alert__icon
                    span.material-symbols-outlined warning
                .sub-alert__body
                    if hoursLeft
                        p.sub-alert__title #{t.subscription.days_left} : #{hoursLeft} #{hoursLeft > 1 ? t.subscription.hours_suffix_many : t.subscription.hours_suffix_one}
                    else
                        p.sub-alert__title #{t.subscription.days_left} : #{daysLeft} #{daysLeft > 1 ? t.subscription.days_suffix_many : t.subscription.days_suffix_one}
                    p.sub-alert__sub= t.subscription.alert_expiring_sub
                button.sub-alert__cta.sub-alert__cta--warn#getProPlanAlert= t.subscription.alert_expiring_btn

        //- ── Hero ───────────────────────────────────────────────────
        .sub-hero
            .sub-hero__badge
                span.material-symbols-outlined(style=`font-size:12px`) circle
                | &nbsp;#{t.sub_extra.choose_plan || 'Tarifs'}
            h1.sub-hero__title= t.subscription.hero_title || 'Des prix simples. Pas de surprises.'
            p.sub-hero__sub= t.subscription.hero_sub || 'Commencez gratuitement. Passez au Pro quand votre activité décolle.'

            //- Le forfait est porté par l'établissement : on indique lequel sera
            //- concerné (l'établissement actif). Pour en faire passer un autre,
            //- basculer dessus via le sélecteur d'établissement.
            if currentCompany
                p.sub-hero__scope(style="margin-top:10px;font-size:13px;color:var(--text-muted,#6b7280)")
                    span.material-symbols-outlined(style="font-size:16px;vertical-align:-3px;margin-right:5px") storefront
                    //- `currentCompanyName` et non `currentCompany.name` : sur
                    //- les fiches créées avant le multi-établissement, le nom
                    //- vit sur le COMPTE du patron et la Company l'a vide. Le
                    //- repli est déjà calculé dans injectCompany, avec la
                    //- bonne règle (jamais le compte du visiteur s'il n'est
                    //- que collaborateur).
                    | Forfait pour l'établissement : #[strong= currentCompanyName || 'Mon établissement']

            //- Billing toggle
            .sub-toggle
                button.sub-toggle__btn#billMonthly(class="active")= t.subscription.monthly || 'Mensuel'
                button.sub-toggle__btn.sub-toggle__btn--yearly#billYearly
                    = t.subscription.yearly || 'Annuel'
                    span.sub-toggle__discount  −20%

            //- Rappel essai gratuit + annulation libre — pour que la promesse
            //- "1 mois gratuit inclus" (cf. badge sur /register et CTAs marketing)
            //- soit explicite avant le paiement, et que le client sache qu'il ne
            //- sera débité qu'au mois suivant et peut annuler quand il veut.
            //-
            //- `essaiGratuitDisponible` : le mois offert n'est dû qu'UNE fois par
            //- compte (utils/freeTrial.js). L'annoncer à quelqu'un qui l'a déjà
            //- consommé, c'est promettre « 0 € aujourd'hui » à quelqu'un que le
            //- serveur va débiter immédiatement. Le drapeau existait déjà, il
            //- n'était simplement pas lu ici.
            if !isPro && essaiGratuitDisponible
                p.sub-trial-note
                    span= t.sub_extra.trial_note || "🎁 1 mois offert sur les plans payants — 0 € aujourd'hui, vous ne serez débité qu'au mois suivant, et vous pouvez annuler à tout moment en un clic."

        //- ── Les trois formules ──────────────────────────────────────
        //-
        //- Le plafond de 20 rendez-vous a disparu : il chassait les pros au
        //- moment précis où l'outil commençait à leur servir. Ce qui sépare
        //- désormais le gratuit du payant, ce sont les rappels automatiques,
        //- la synchro d'agenda et la personnalisation — des options qu'on n'a
        //- pas achetées, jamais un blocage en pleine semaine.
        //-
        //- Le sélecteur « Individuel / Équipe » a été retiré avec l'Essentiel :
        //- trois cartes tiennent sur une ligne, et masquer l'offre la plus
        //- chère derrière un onglet revenait à ne pas la vendre.
        //-
        //- Les prix viennent de utils/tarifs.js — même source que le calcul du
        //- revenu récurrent, pour qu'un montant ne puisse pas diverger entre la
        //- vitrine et la comptabilité.
        .sub-plans#subPlans

            //- ─── Amateur (gratuit) ─────────────────────────────────
            .sub-plan.sub-plan--starter(class=(!isPro && currentPlan === 'basic') ? 'sub-plan--current' : '')
                .sub-plan__header
                    .sub-plan__name-wrap
                        h2.sub-plan__name= _tarifs.basic.libelle
                        p.sub-plan__desc Pour commencer et se faire connaître
                    .sub-plan__pricing
                        span.sub-plan__price Gratuit
                        span.sub-plan__per  pour toujours
                .sub-plan__divider
                .sub-plan__features
                    each f in ['Rendez-vous illimités', 'Page de réservation en ligne', '5 prestations', 'Confirmations par e-mail', 'Historique de vos clients', 'Visible dans la recherche BranShee']
                        .sub-plan__feature
                            span.material-symbols-outlined.feat-check check
                            span= f
                    .sub-plan__feature.sub-plan__feature--locked
                        span.material-symbols-outlined.feat-lock lock
                        span Rappels automatiques, Google Agenda, personnalisation
                .sub-plan__cta
                    if !isPro && currentPlan === 'basic'
                        button.sub-btn.sub-btn--current(disabled)= t.subscription.btn_current
                    else
                        button.sub-btn.sub-btn--ghost#getFreePlan(type="button") Revenir à l'Amateur

            //- ─── Pro (mis en avant) ────────────────────────────────
            .sub-plan.sub-plan--premium(class=(currentPlan === 'pro' && isPro) ? 'sub-plan--current' : '')
                .sub-plan__popular= t.sub_extra.popular || 'Le plus choisi'
                .sub-plan__header
                    .sub-plan__name-wrap
                        h2.sub-plan__name= _tarifs.pro.libelle
                        p.sub-plan__desc Pour qui travaille tous les jours
                    .sub-plan__pricing
                        span.sub-plan__price(
                            data-monthly=String(_tarifs.pro.mensuel)
                            data-yearly=String(_tarifs.pro.annuelParMois)
                        ) #{_tarifs.pro.mensuel}€
                        span.sub-plan__per  / mois
                .sub-plan__divider
                //- Argument chiffré plutôt que promotionnel : deux absences
                //- évitées remboursent l'abonnement plusieurs fois.
                p.sub-plan__pitch
                    span.material-symbols-outlined(style="font-size:16px") trending_up
                    | &nbsp;2 rendez-vous manqués en moins, et l'abonnement est remboursé 4 fois.
                .sub-plan__features
                    .sub-plan__feature.sub-plan__feature--head
                        span Tout l'Amateur, plus :
                    each f in ['Rappels automatiques par e-mail', '50 rappels SMS par mois', 'Synchronisation Google Agenda', 'Page 100% personnalisable', 'Prestations illimitées', '2 collaborateurs', 'Formulaire de réservation', 'Statistiques complètes', 'Support prioritaire']
                        .sub-plan__feature
                            span.material-symbols-outlined.feat-check check
                            span= f
                .sub-plan__cta
                    if currentPlan === 'pro' && isPro
                        button.sub-btn.sub-btn--current.sub-btn--premium-current(disabled)= t.subscription.btn_current
                        .sub-plan__links
                            if !autoRenew
                                span.sub-link#retakeSubscription= t.subscription.btn_retake
                            else
                                span.sub-link.sub-link--danger#cancelSubscriptionPro= t.subscription.btn_cancel
                        .sub-time-left(class=isExpired ? 'expired' : isExpiring ? 'expiring' : '')
                            if isExpired
                                | #{t.subscription.expired_label}
                            else if isBetaAccess && daysLeft === null
                                | Accès offert
                            else if hoursLeft
                                | #{t.subscription.days_left} :&nbsp;
                                strong #{hoursLeft} #{hoursLeft > 1 ? t.subscription.hours_suffix_many : t.subscription.hours_suffix_one}
                            else if daysLeft !== null
                                | #{t.subscription.days_left} :&nbsp;
                                strong #{daysLeft} #{t.subscription.days}
                    else if currentPlan !== 'business'
                        button.sub-btn.sub-btn--upgrade#getProPlan(type="button")
                            if essaiGratuitDisponible
                                | Essayer le Pro gratuitement →
                            else
                                | Passer au Pro →
                        if !isPro && _proOffer
                            p.sub-plan__offer-note
                                span.material-symbols-outlined(style="font-size:15px") card_giftcard
                                | &nbsp;#{_offerLabel(_proOffer)} — déjà appliqué

            //- ─── Pro+ ──────────────────────────────────────────────
            .sub-plan.sub-plan--studio(class=(currentPlan === 'business' && isPro) ? 'sub-plan--current' : '')
                .sub-plan__badge-business Équipes & multi-sites
                .sub-plan__header
                    .sub-plan__name-wrap
                        h2.sub-plan__name= _tarifs.business.libelle
                        p.sub-plan__desc Pour les cabinets et les salons
                    .sub-plan__pricing
                        span.sub-plan__price(
                            data-monthly=String(_tarifs.business.mensuel)
                            data-yearly=String(_tarifs.business.annuelParMois)
                        ) #{_tarifs.business.mensuel}€
                        span.sub-plan__per  / mois
                .sub-plan__divider
                .sub-plan__features
                    .sub-plan__feature.sub-plan__feature--head
                        span Tout le Pro, plus :
                    each f in ['200 rappels SMS par mois', '10 collaborateurs', 'Plusieurs établissements', 'Cours collectifs et ateliers', 'Votre site vitrine BranShee', 'URL personnalisée incluse', 'Sans marque BranShee', 'Support dédié']
                        .sub-plan__feature
                            span.material-symbols-outlined.feat-check check
                            span= f
                .sub-plan__cta
                    if currentPlan === 'business' && isPro
                        button.sub-btn.sub-btn--current(disabled)= t.subscription.btn_current
                        .sub-plan__links
                            if !autoRenew
                                span.sub-link#retakeSubscription= t.subscription.btn_retake
                            else
                                span.sub-link.sub-link--danger#cancelSubscriptionPro= t.subscription.btn_cancel
                    else
                        button.sub-btn.sub-btn--upgrade.sub-btn--business#getBusinessPlan(type="button") Passer au Pro+ →
                        if !isPro && _bizOffer
                            p.sub-plan__offer-note
                                span.material-symbols-outlined(style="font-size:15px") card_giftcard
                                | &nbsp;#{_offerLabel(_bizOffer)} — déjà appliqué


        //- ── Tableau comparatif ──────────────────────────────────────
        //- Trois colonnes depuis le retrait de l'Essentiel. Les lignes sont
        //- déclarées en données plutôt qu'en balisage : une ligne oubliée dans
        //- une colonne était jusqu'ici invisible à la relecture, et le tableau
        //- promettait des limites que planLimits.js ne tenait pas.
        //-
        //- Valeurs : true = inclus · false = absent · une chaîne = la valeur.
        -
            var _lignes = [
                { groupe: 'Agenda et réservations' },
                { l: 'Rendez-vous par mois',        a: 'Illimités', p: 'Illimités', b: 'Illimités' },
                { l: 'Prestations',                 a: '5',         p: 'Illimitées', b: 'Illimitées' },
                { l: 'Page de réservation en ligne', a: true,       p: true,        b: true },
                { l: 'Réservation 24h/24',          a: true,        p: true,        b: true },
                { l: 'Historique de vos clients',   a: true,        p: true,        b: true },
                { l: 'Congés et indisponibilités',  a: true,        p: true,        b: true },
                { l: 'Cours collectifs et ateliers', a: false,      p: false,       b: true },

                { groupe: 'Ne plus perdre de rendez-vous' },
                { l: 'Confirmations par e-mail',    a: true,        p: true,        b: true },
                { l: 'Rappels automatiques e-mail', a: false,       p: true,        b: true },
                { l: 'Rappels SMS par mois',        a: false,       p: '50',        b: '200' },
                { l: 'Annulation en un clic par le client', a: true, p: true,       b: true },
                { l: 'Synchronisation Google Agenda', a: false,     p: true,        b: true },

                { groupe: 'Votre image' },
                { l: 'Visible dans la recherche BranShee', a: true, p: true,        b: true },
                { l: 'Page personnalisable (logo, couleurs)', a: false, p: true,    b: true },
                { l: 'Galerie photos',              a: false,       p: true,        b: true },
                { l: 'Avis clients',                a: true,        p: true,        b: true },
                { l: 'Votre site vitrine',          a: false,       p: false,       b: true },
                { l: 'URL personnalisée',           a: false,       p: 'Option',    b: 'Incluse' },
                { l: 'Sans marque BranShee',        a: false,       p: false,       b: true },

                { groupe: 'Organisation' },
                { l: 'Collaborateurs inclus',       a: false,       p: '2',         b: '10' },
                { l: 'Plusieurs établissements',    a: false,       p: false,       b: true },
                { l: 'Formulaire de réservation',   a: '1 question', p: '5 questions', b: '10 questions' },
                { l: 'Statistiques',                a: 'Basiques',  p: 'Complètes', b: 'Complètes' },
                { l: 'Support',                     a: 'Standard',  p: 'Prioritaire', b: 'Dédié' },
            ];

            //- Rend une cellule : coche, croix, ou texte.
            function _cell(v) { return v; }

        .sub-compare
            h2.sub-compare__title Comparer les formules
            .sub-compare__wrap
                table.sub-compare__table
                    thead
                        tr
                            th.sub-compare__th--label
                            th.sub-compare__th
                                span.sub-compare__plan= _tarifs.basic.libelle
                                span.sub-compare__price Gratuit
                            th.sub-compare__th.sub-compare__th--pro
                                span.sub-compare__plan ★ #{_tarifs.pro.libelle}
                                span.sub-compare__price #{_tarifs.pro.mensuel}€ / mois
                            th.sub-compare__th.sub-compare__th--biz
                                span.sub-compare__plan= _tarifs.business.libelle
                                span.sub-compare__price #{_tarifs.business.mensuel}€ / mois
                    tbody
                        each ligne in _lignes
                            if ligne.groupe
                                tr.sub-compare__group
                                    td(colspan="4")= ligne.groupe
                            else
                                tr
                                    td= ligne.l
                                    each v in [ligne.a, ligne.p, ligne.b]
                                        td
                                            if v === true
                                                span.material-symbols-outlined.sub-compare__yes check
                                            else if v === false
                                                span.sub-compare__no —
                                            else
                                                span.sub-compare__val= v

        //- ── Questions fréquentes ────────────────────────────────────
        //- Les objections qui reviennent avant un abonnement. Y répondre ici
        //- évite qu'elles se transforment en e-mail au support — ou en abandon
        //- silencieux, ce qui est pire parce qu'on ne l'apprend jamais.
        .sub-faq
            h2.sub-faq__title Questions fréquentes
            -
                var _faq = [
                        { q: 'Le plan Amateur est-il vraiment gratuit ?', r: "Oui, et sans limite de rendez-vous. Aucune carte bancaire n'est demandée, et il n'expire pas. Vous passez au Pro le jour où les rappels automatiques vous manquent, pas avant." },
                        { q: 'Puis-je changer de formule ou arrêter quand je veux ?', r: "Oui, en un clic depuis cette page. Aucun engagement de durée. Si vous arrêtez, vous gardez l'accès jusqu'à la fin de la période déjà payée, puis vous repassez en Amateur — sans rien perdre." },
                        { q: 'Que deviennent mes données si je redescends en Amateur ?', r: "Rien ne disparaît : vos rendez-vous, vos clients et votre page restent en place. Seules les fonctions payantes s'arrêtent, comme les rappels automatiques." },
                        { q: 'Prenez-vous une commission sur mes rendez-vous ?', r: "Non. Aucune commission, quel que soit votre plan. Ce que vos clients vous paient vous revient entièrement." },
                        { q: 'À quoi servent les rappels SMS ?', r: "Un SMS envoyé la veille est lu dans les minutes qui suivent, là où un e-mail se noie. C'est le moyen le plus efficace d'éviter les rendez-vous manqués. Le Pro en inclut 50 par mois, le Pro+ 200." },
                        { q: 'Le paiement est-il sécurisé ?', r: "Il passe par Stripe, qui gère aussi les paiements de milliers de sites. Vos coordonnées bancaires ne transitent jamais par BranShee et ne sont jamais stockées chez nous." },
                ];
            .sub-faq__list
                each q in _faq
                    details.sub-faq__item
                        summary.sub-faq__q
                            span= q.q
                            span.material-symbols-outlined.sub-faq__chevron expand_more
                        p.sub-faq__a= q.r


        .sub-promo#promoCodeSection
            .sub-promo__inner
                .sub-promo__left
                    .sub-promo__icon
                        span.material-symbols-outlined local_offer
                    .sub-promo__text
                        span.sub-promo__title= t.subscription.promo_label
                        span.sub-promo__desc Réduction immédiate sur votre abonnement
                .sub-promo__right
                    .sub-promo__field
                        input.sub-promo__input#promoCodeInput(
                            type="text"
                            placeholder=t.subscription.promo_placeholder
                            autocomplete="off"
                            style="text-transform:uppercase;"
                        )
                        button.sm-btn.sm-btn--primary#applyPromoBtn
                            span= t.subscription.promo_apply
            .sub-promo__status#promoCodeStatus

    +dialog()

block scripts
    -
        // `<` échappé : un code promo est saisi en superadmin, il n'a rien à
        // faire d'un « </script> » mais on ne l'injecte pas brut pour autant.
        var offresAutoJson = JSON.stringify((defaultOffers || []).map(function (o) {
            return { code: o.code, discountType: o.discountType, discountValue: o.discountValue,
                     trialDays: o.trialDays, applicablePlan: o.applicablePlan || 'all' };
        })).replace(/</g, '\\u003c');
    - var subTJson = JSON.stringify({ checking: t.subscription.promo_checking, invalid: t.subscription.promo_invalid, cancel_title: t.subscription.dialog_cancel_title, cancel_desc: t.subscription.dialog_cancel_desc, resume_title: t.subscription.dialog_resume_title, resume_desc: t.subscription.dialog_resume_desc, confirm: t.subscription.dialog_confirm, close: t.subscription.dialog_close, success_cancel: t.subscription.dialog_success_cancel, success_resume: t.subscription.dialog_success_resume })
    script.
        window.__subT = !{subTJson};
        // Offres mises en avant par le superadmin. Elles s'appliquent toutes
        // seules : le JS barre le prix plein, affiche le prix remisé et envoie
        // le code au paiement. La route a déjà écarté celles que ce compte ne
        // peut pas obtenir (expirées, épuisées, déjà utilisées par lui).
        window.__offresAuto = !{offresAutoJson};
        // Cartes déjà enregistrées — utilisées par la boîte de confirmation
        // d'achat pour proposer "payer instant avec carte X ou changer de
        // carte" plutôt que de débiter directement au clic.
        window.__paymentMethods = !{JSON.stringify(paymentMethods || [])};
        // Le mois offert n'est dû qu'une fois par compte : sans ce drapeau, la
        // boîte de confirmation annonçait « 30 jours offerts » à quelqu'un que
        // le serveur allait facturer immédiatement.
        // `=== true` et non `!== false` : si la variable venait à manquer, on
        // annoncerait le prix plein plutôt qu'une gratuité que le serveur
        // refuserait. Décevoir en bien vaut mieux que trahir une promesse.
        window.__trialAvailable = !{JSON.stringify(essaiGratuitDisponible === true)};
    script(src="/js/templates/dialog.js")
    script(src="/js/layouts/subscription.js")
    script.
        document.addEventListener('DOMContentLoaded', function() {
            // Le bandeau d'incitation rejoue le bouton de la carte Pro : c'est
            // elle qui porte le prix, l'offre en cours et la boîte de
            // confirmation. Un seul gestionnaire ici — subscription.js n'en
            // pose plus, sinon la confirmation s'ouvrait deux fois.
            var ps = document.getElementById('getProPlanStrip');
            var p1 = document.getElementById('getProPlan');
            if (ps && p1) ps.addEventListener('click', function() { p1.click(); });

            // Le relais des boutons qui vivaient sous le tableau comparatif
            // (getProPlan2 / getEssPlan2 / getBusinessPlan2) a été retiré avec
            // eux : illisibles, et redondants avec les cartes juste au-dessus.

            // Le sélecteur « Individuel / Équipe » a disparu avec l'Essentiel :
            // les trois formules tiennent sur une seule ligne, il n'y a plus
            // rien à filtrer.
        });
