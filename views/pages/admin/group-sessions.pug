extends ../../layouts/admin

block links
    link(rel="stylesheet" href="/css/components/admin/appointment.admin.css")
    link(rel="stylesheet" href="/css/layouts/services.css")
    link(rel="stylesheet" href="/css/components/admin/group-sessions.admin.css")

block content
    - const canManageGS = !!(permissions && permissions.groupSessions && permissions.groupSessions.manage)
    .gs-page
        .gs-page__header
            .gs-page__header-left
                h2= t.group_sessions.title
                p.gs-page__subtitle= t.group_sessions.subtitle
            .gs-page__header-right
                if maxServices > 0 && isFinite(maxServices)
                    span.gs-counter #{courses.length} / #{maxServices}
                if canManageGS
                    button.sm-btn.sm-btn--primary#addCourseBtn(disabled=(maxServices === 0))
                        svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                            path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                        span= t.group_sessions.new_course_btn

        if courses.length === 0
            .gs-empty
                svg(xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="currentColor")
                    path(d="M480-120 200-272v-240L40-600l440-240 440 240v320h-80v-276l-80 44v240L480-120Zm0-332 274-148-274-148-274 148 274 148Zm0 240 200-108v-153l-200 108-200-108v153l200 108Z")
                p= t.group_sessions.empty_title
                p.gs-empty__hint= t.group_sessions.empty_hint
        else
            .gs-courses-grid
                each course in courses
                    - var weekdayLabels = { 0: t.days_abbr.sunday, 1: t.days_abbr.monday, 2: t.days_abbr.tuesday, 3: t.days_abbr.wednesday, 4: t.days_abbr.thursday, 5: t.days_abbr.friday, 6: t.days_abbr.saturday }
                    .gs-course-card(
                        data-id=String(course._id)
                        data-name=course.name
                        data-description=course.description || ''
                        data-price=(course.price !== null && course.price !== undefined ? course.price : '')
                        data-duration=course.duration
                        data-capacity=course.capacity
                        data-mode=(course.recurring.enabled ? 'recurring' : 'fixed')
                        data-weekdays=(course.recurring.weekdays || []).join(',')
                        data-start-time=(course.recurring.startTime || '')
                        data-sessions=JSON.stringify((course.sessions || []).map(function(s){ return { date: s.date.toISOString(), startTime: s.startTime, endTime: s.endTime }; }))
                        data-location=course.location || ''
                        data-employees=(course.employees || []).map(function(e){ return String(e._id); }).join(',')
                        class=(!course.active ? 'gs-course-card--inactive' : '')
                    )
                        .gs-course-card__top
                            h3.gs-course-card__name
                                span.gs-course-card__dot(style=`background:${course.color || '#16a34a'}`)
                                = course.name
                            if canManageGS
                            label.sa-toggle(title=(course.active ? t.group_sessions.deactivate_tooltip : t.group_sessions.activate_tooltip))
                                input.toggle-course-active(type="checkbox" checked=course.active data-id=String(course._id))
                                .sa-toggle__track
                        if course.description
                            p.gs-course-card__desc= course.description
                        .gs-course-card__meta
                            if course.recurring.enabled
                                span.gs-course-card__chip
                                    svg(xmlns="http://www.w3.org/2000/svg" height="13px" viewBox="0 -960 960 960" width="13px" fill="currentColor")
                                        path(d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Z")
                                    = (course.recurring.weekdays || []).map(function(d){ return weekdayLabels[d]; }).join(', ')
                                span.gs-course-card__chip
                                    svg(xmlns="http://www.w3.org/2000/svg" height="13px" viewBox="0 -960 960 960" width="13px" fill="currentColor")
                                        path(d="M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q150 0 255 105t105 255q0 150-105 255T480-120Zm56-260L480-440v-200h80v167l140 140-44 44Z")
                                    = course.recurring.startTime
                            else
                                - var futureSessions = (course.sessions || []).filter(function(s){ return new Date(s.date) >= new Date(new Date().setHours(0,0,0,0)); }).sort(function(a,b){ return new Date(a.date) - new Date(b.date); })
                                if futureSessions.length > 0
                                    span.gs-course-card__chip
                                        svg(xmlns="http://www.w3.org/2000/svg" height="13px" viewBox="0 -960 960 960" width="13px" fill="currentColor")
                                            path(d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Z")
                                        = `${futureSessions.length} ${futureSessions.length > 1 ? t.group_sessions.dates_plural : t.group_sessions.date_singular} · ${t.group_sessions.next_label} ${new Date(futureSessions[0].date).toLocaleDateString(lang, { day: '2-digit', month: '2-digit' })} ${t.group_sessions.at_label} ${futureSessions[0].startTime}`
                                else
                                    span.gs-course-card__chip.gs-course-card__chip--muted= t.group_sessions.no_upcoming_dates
                            span.gs-course-card__chip #{course.duration} min
                            span.gs-course-card__chip #{course.capacity} #{t.group_sessions.places_unit}
                            if course.price !== null && course.price !== undefined
                                span.gs-course-card__chip.gs-course-card__chip--price #{course.price}€
                            if course.location
                                span.gs-course-card__chip 📍 #{course.location}
                        .gs-course-card__employees
                            if course.employees && course.employees.length > 0
                                .gs-course-card__emp-label= t.group_sessions.with_employees_label
                                each emp in course.employees
                                    .emp-chip
                                        img(src=emp.profilePicture alt="")
                                        span= emp.fullName
                            else
                                .gs-course-card__emp-none
                                    svg(xmlns="http://www.w3.org/2000/svg" height="13px" viewBox="0 -960 960 960" width="13px" fill="currentColor")
                                        path(d="M480-481q66 0 113-47t47-113q0-66-47-113t-113-47q-66 0-113 47t-47 113q0 66 47 113t113 47ZM160-160v-94q0-38 19-65t49-41q67-30 128.5-45T480-420q62 0 123 15.5T731.5-360q31 14 49.5 41t18 65v94H160Z")
                                    = t.group_sessions.blocks_everyone
                        if canManageGS
                            .gs-course-card__actions
                                button.sm-btn.sm-btn--ghost.edit-course-btn(data-id=String(course._id))= t.group_sessions.edit_btn
                                button.gs-course-card__delete.delete-course-btn(data-id=String(course._id) data-name=course.name title=t.group_sessions.delete_tooltip)
                                    svg(xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor")
                                        path(d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z")

        .gs-divider
        .gs-page__header
            .gs-page__header-left
                h2= t.group_sessions.upcoming_title
                p.gs-page__subtitle= t.group_sessions.upcoming_subtitle

        if sessions.length === 0
            .gs-empty
                svg(xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="currentColor")
                    path(d="M40-160v-112q0-34 17.5-62.5T104-378q62-31 126-46.5T360-440q66 0 130 15.5T616-378q29 15 46.5 43.5T680-272v112H40Zm720 0v-120q0-44-24.5-84.5T666-434q51 6 96 20.5t84 35.5q36 20 55 44.5t19 53.5v120H760ZM360-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47Z")
                p= t.group_sessions.no_sessions_title
                p.gs-empty__hint= t.group_sessions.no_sessions_hint
        else
            .gs-table
                .gs-table__head
                    span= t.group_sessions.table_service
                    span= t.group_sessions.table_date
                    span= t.group_sessions.table_time
                    span= t.group_sessions.table_places
                    span
                each session in sessions
                    .gs-row(
                        data-service-id=String(session.serviceId)
                        data-date=session.date.toISOString()
                        data-start-time=session.startTime
                        data-capacity=session.capacity
                    )
                        span.gs-row__service= session.serviceName
                        span.gs-row__date= new Date(session.date).toLocaleDateString(lang, { weekday: 'short', day: 'numeric', month: 'short' })
                        span.gs-row__time= session.startTime
                        span.gs-row__count(class=(session.count >= session.capacity ? 'gs-row__count--full' : ''))
                            | #{session.count} / #{session.capacity} #{t.group_sessions.places_unit}
                        button.gs-row__btn(type="button")= t.group_sessions.view_participants_btn

    //- ── Modal : Créer / Modifier un cours collectif ─────────────────────────
    .modal-overlay#courseModalOverlay
    .service-modal#courseModal
        .service-modal__header
            h3#courseModalTitle= t.group_sessions.modal_new_title
            button.modal-close#closeCourseModal(type="button")
                svg(xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor")
                    path(d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z")
        .service-modal__body
            input(type="hidden" id="courseModalId")
            .field
                label= t.group_sessions.field_name
                input.input#courseName(type="text" placeholder=t.group_sessions.name_placeholder)
            .field
                label= t.group_sessions.field_description
                textarea.input.textarea#courseDescription(rows="2" placeholder=t.group_sessions.description_placeholder)
            .field-row
                .field
                    label= t.group_sessions.field_price
                    input.input#coursePrice(type="number" min="0" step="0.5" placeholder=t.group_sessions.price_placeholder)
                .field
                    label= t.group_sessions.field_duration
                    input.input#courseDuration(type="number" min="5" step="5" value="60")
                .field
                    label= t.group_sessions.field_capacity
                    input.input#courseCapacity(type="number" min="1" max="500" value="10")

            .field
                label= t.group_sessions.field_location
                input.input#courseLocation(type="text" placeholder=t.group_sessions.location_placeholder)

            .field
                label= t.group_sessions.field_mode
                .svc-type-options#courseModeOptions
                    button.svc-type-option.is-active(type="button" data-mode="recurring")
                        span.svc-type-option__title= t.group_sessions.mode_recurring_title
                        span.svc-type-option__desc= t.group_sessions.mode_recurring_desc
                    button.svc-type-option(type="button" data-mode="fixed")
                        span.svc-type-option__title= t.group_sessions.mode_fixed_title
                        span.svc-type-option__desc= t.group_sessions.mode_fixed_desc

            #courseRecurringFields
                .field
                    label= t.group_sessions.field_weekdays
                    .gs-weekday-picker#courseWeekdayPicker
                        button.gs-weekday-chip(type="button" data-day="1")= t.days_abbr.monday
                        button.gs-weekday-chip(type="button" data-day="2")= t.days_abbr.tuesday
                        button.gs-weekday-chip(type="button" data-day="3")= t.days_abbr.wednesday
                        button.gs-weekday-chip(type="button" data-day="4")= t.days_abbr.thursday
                        button.gs-weekday-chip(type="button" data-day="5")= t.days_abbr.friday
                        button.gs-weekday-chip(type="button" data-day="6")= t.days_abbr.saturday
                        button.gs-weekday-chip(type="button" data-day="0")= t.days_abbr.sunday

                .field
                    label= t.group_sessions.field_time
                    .appt-time-field
                        .appt-time-box#courseStartBox(tabindex="0" role="button") --:--
                        .appt-time-panel#courseStartPanel
                            input.appt-time-search(type="text" placeholder=t.group_sessions.field_time autocomplete="off")
                            .appt-time-list#courseStartList

            #courseFixedFields(style="display:none")
                .field
                    label= t.group_sessions.field_sessions
                    #courseSessionRows.gs-session-rows
                    .gs-session-add-row
                        input.input#newSessionDate(type="date")
                        .appt-time-field
                            .appt-time-box#newSessionStartBox(tabindex="0" role="button")= t.group_sessions.session_start
                            .appt-time-panel#newSessionStartPanel
                                input.appt-time-search(type="text" placeholder=t.group_sessions.session_start autocomplete="off")
                                .appt-time-list#newSessionStartList
                        .appt-time-field
                            .appt-time-box#newSessionEndBox(tabindex="0" role="button")= t.group_sessions.session_end
                            .appt-time-panel#newSessionEndPanel
                                input.appt-time-search(type="text" placeholder=t.group_sessions.session_end autocomplete="off")
                                .appt-time-list#newSessionEndList
                        button.sm-btn.sm-btn--ghost#addSessionRowBtn(type="button")= t.group_sessions.add_session_btn
                    p.xs-comment= t.group_sessions.session_hint

            if employees && employees.length > 0
                .field
                    label.svc-fee-label
                        span= t.group_sessions.has_employees_label
                        label.sa-toggle
                            input#courseHasEmployees(type="checkbox")
                            .sa-toggle__track
                    p.xs-comment= t.group_sessions.has_employees_hint
                    #courseEmployeesField(style="display:none")
                        .gs-employee-list#courseEmployeeList
                            each emp in employees
                                label.gs-employee-chip
                                    input(type="checkbox" value=String(emp._id))
                                    img(src=emp.profilePicture alt="")
                                    span= emp.firstName + ' ' + emp.lastName
            else
                p.xs-comment= t.group_sessions.no_employees_hint

            p.new-appt-modal__error#courseModalError(style="display:none")
        .service-modal__footer
            button.sm-btn.sm-btn--ghost#cancelCourseModal(type="button")= t.group_sessions.cancel_btn
            button.sm-btn.sm-btn--primary#saveCourseBtn(type="button")
                span= t.group_sessions.save_btn

    script.
        window.__defaultDuration = 60;
        window.__lang = '#{lang}';
        window.__t_group_sessions = !{JSON.stringify(t.group_sessions)};

block scripts
    script(src="/js/utils/confirm-modal.js")
    script(src="/js/components/admin/group-sessions.admin.js" type="module")
    script.
        (function() {
            function buildModal(opts) {
                var existing = document.getElementById('__customModal');
                if (existing) existing.remove();

                var overlay = document.createElement('div');
                overlay.id = '__customModal';
                overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.45);backdrop-filter:blur(4px);z-index:99999;display:flex;align-items:center;justify-content:center;padding:16px;';

                overlay.innerHTML = '<style>' +
                    '@keyframes __cmslidein{from{opacity:0;transform:scale(.94) translateY(8px)}to{opacity:1;transform:scale(1) translateY(0)}}' +
                    '#__customModal .cm{background:#fff;border-radius:20px;max-width:520px;width:100%;max-height:80vh;box-shadow:0 24px 48px -8px rgba(0,0,0,.22);display:flex;flex-direction:column;gap:0;overflow:hidden;animation:__cmslidein .18s cubic-bezier(.34,1.4,.64,1)}' +
                    '#__customModal .cm__head{padding:20px 24px;display:flex;align-items:flex-start;justify-content:space-between;gap:12px;border-bottom:1px solid #eee}' +
                    '#__customModal .cm__close{background:none;border:none;cursor:pointer;color:#9ca3af;width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;transition:background .15s,color .15s;flex-shrink:0;padding:0}' +
                    '#__customModal .cm__close:hover{background:#f3f4f6;color:#111}' +
                    '#__customModal .cm__title{font-size:17px;font-weight:700;color:#111;margin:0}' +
                    '#__customModal .cm__desc{font-size:13px;color:#6b7280;margin:4px 0 0}' +
                    '#__customModal .cm__body{padding:8px 24px 24px;overflow-y:auto;display:flex;flex-direction:column;gap:10px}' +
                    '#__customModal .gs-part{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border:1px solid #eee;border-radius:12px}' +
                    '#__customModal .gs-part__info{display:flex;flex-direction:column;gap:2px}' +
                    '#__customModal .gs-part__name{font-size:13.5px;font-weight:700;color:#111}' +
                    '#__customModal .gs-part__contact{font-size:12px;color:#6b7280}' +
                    '#__customModal .gs-part__actions{display:flex;gap:6px;flex-shrink:0}' +
                    '#__customModal .gs-part__btn{display:inline-flex;align-items:center;justify-content:center;padding:7px 12px;border-radius:9px;font-size:12.5px;font-weight:600;cursor:pointer;font-family:inherit;text-decoration:none;border:1px solid #e5e7eb;background:#f3f4f6;color:#374151;transition:background .15s}' +
                    '#__customModal .gs-part__btn:hover{background:#e9eaec}' +
                    '#__customModal .gs-part__btn--danger{background:#fef2f2;color:#dc2626;border-color:#fecaca}' +
                    '#__customModal .gs-part__btn--danger:hover{background:#fee2e2}' +
                    '#__customModal .gs-empty-list{font-size:13px;color:#6b7280;text-align:center;padding:24px 0}' +
                    '</style>' +
                    '<div class="cm">' +
                    '<div class="cm__head"><div><p class="cm__title">' + opts.title + '</p><p class="cm__desc">' + (opts.desc || '') + '</p></div>' +
                    '<button class="cm__close" aria-label="Fermer"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button></div>' +
                    '<div class="cm__body">' + (opts.bodyHtml || '') + '</div>' +
                    '</div>';

                overlay.addEventListener('click', function(e) { if (e.target === overlay) overlay.remove(); });
                overlay.querySelector('.cm__close').addEventListener('click', function() { overlay.remove(); });
                document.addEventListener('keydown', function onKey(e) {
                    if (e.key === 'Escape') { overlay.remove(); document.removeEventListener('keydown', onKey); }
                });

                return overlay;
            }

            function escapeHtml(str) {
                var div = document.createElement('div');
                div.textContent = str || '';
                return div.innerHTML;
            }

            async function openParticipants(row) {
                var serviceId = row.dataset.serviceId;
                var date = row.dataset.date;
                var startTime = row.dataset.startTime;
                var serviceName = row.querySelector('.gs-row__service').textContent.trim();
                var dateLabel = row.querySelector('.gs-row__date').textContent.trim();

                var overlay = buildModal({
                    title: serviceName,
                    desc: dateLabel + ' #{t.group_sessions.at_label} ' + startTime,
                    bodyHtml: '<div class="gs-empty-list">#{t.group_sessions.loading}</div>',
                });
                document.body.appendChild(overlay);

                try {
                    var res = await fetch('/group-sessions/participants?serviceId=' + encodeURIComponent(serviceId) + '&date=' + encodeURIComponent(date) + '&startTime=' + encodeURIComponent(startTime));
                    var data = await res.json();
                    var body = overlay.querySelector('.cm__body');

                    if (!data.success || !data.participants || data.participants.length === 0) {
                        body.innerHTML = '<div class="gs-empty-list">#{t.group_sessions.no_participants}</div>';
                        return;
                    }

                    body.innerHTML = data.participants.map(function(p) {
                        var name = escapeHtml((p.name || '') + ' ' + (p.surname || '')).trim();
                        var contact = [p.email, p.phone].filter(Boolean).map(escapeHtml).join(' · ');
                        return '<div class="gs-part" data-id="' + p._id + '">' +
                            '<div class="gs-part__info"><span class="gs-part__name">' + (name || '#{t.group_sessions.client_fallback}') + '</span>' +
                            (contact ? '<span class="gs-part__contact">' + contact + '</span>' : '') + '</div>' +
                            '<div class="gs-part__actions">' +
                            '<a class="gs-part__btn" href="/history/edit/' + p._id + '">#{t.group_sessions.edit_btn}</a>' +
                            '<button class="gs-part__btn gs-part__btn--danger" data-cancel="' + p._id + '">#{t.group_sessions.remove_participant_btn}</button>' +
                            '</div></div>';
                    }).join('');
                } catch (e) {
                    overlay.querySelector('.cm__body').innerHTML = '<div class="gs-empty-list">#{t.group_sessions.load_error}</div>';
                }
            }

            document.querySelectorAll('.gs-row__btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    openParticipants(btn.closest('.gs-row'));
                });
            });

            document.addEventListener('click', async function(e) {
                var cancelBtn = e.target.closest('[data-cancel]');
                if (!cancelBtn) return;
                var id = cancelBtn.dataset.cancel;
                if (!confirm('#{t.group_sessions.remove_participant_confirm}')) return;
                try {
                    var res = await fetch('/appointment/' + id + '/cancel', { method: 'PATCH' });
                    if (res.ok) {
                        cancelBtn.closest('.gs-part').remove();
                        // Refresh page to update participant counts in the table.
                        setTimeout(function() { window.location.reload(); }, 300);
                    } else {
                        alert('#{t.group_sessions.remove_error}');
                    }
                } catch (e) {
                    alert('#{t.group_sessions.network_error}');
                }
            });
        })();
