extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/layouts/auth.css")
    link(rel="stylesheet", href="/css/layouts/etablissements.css")

block content
    -
        var palette = ['#6ee7b7', '#93c5fd', '#fcd34d', '#fca5a5', '#c4b5fd', '#f9a8d4', '#a5f3fc', '#bef264'];
        function couleur(s) {
            var n = 0;
            for (var i = 0; i < String(s).length; i++) n += String(s).charCodeAt(i);
            return palette[n % palette.length];
        }
        var canManage = !!(permissions && permissions.grades && permissions.grades.manage);

    a.etab-back-link(href=`/etablissement/${company.id}/collaborateurs` style="display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--text-muted,#6b7280);text-decoration:none;margin-bottom:18px")
        span.material-symbols-outlined(style=`font-size:14px`) arrow_back
        | Retour aux collaborateurs

    .gr-page
        .gr-head
            div
                h1.gr-head__title Grades
                p.gr-head__sub Définissez les accès de chaque rôle de votre équipe.
            if canManage
                button.sm-btn.sm-btn--primary#createGradeBtn(type="button")
                    span.material-symbols-outlined(style="font-size:18px") add
                    span Créer un grade

        if !grades.length
            .gr-empty
                span.gr-empty__ic
                    span.material-symbols-outlined badge
                p.gr-empty__title Aucun grade pour l'instant
                p.gr-empty__desc Créez un grade pour définir les accès de votre équipe.
                if canManage
                    button.sm-btn.sm-btn--primary#createGradeBtn2(type="button")
                        span.material-symbols-outlined(style="font-size:18px") add
                        span Créer un grade
        else
            .ds-table-wrap
                table.ds-table.gr-table
                    thead
                        tr
                            th Grade
                            th Collaborateurs
                            th Type
                            th(style="width:48px")
                    tbody
                        each g in grades
                            tr.gr-row(
                                data-id=g.id
                                data-name=g.name
                                data-permissions=JSON.stringify(g.permissions)
                                data-builtin=g.isBuiltIn ? '1' : '0'
                            )
                                td
                                    .ds-person
                                        span.gr-av(style='background:' + couleur(g.name || '?'))= g.name ? g.name[0].toUpperCase() : '?'
                                        .ds-person__txt
                                            span.ds-person__name= g.name
                                td= g.memberCount + (g.memberCount === 1 ? ' collaborateur' : ' collaborateurs')
                                td
                                    if g.isBuiltIn
                                        span.estab-badge.estab-badge--role Défaut
                                    else
                                        span.estab-badge Personnalisé
                                td.ds-td--actions
                                    .ds-menu
                                        button.ds-ico(type="button" data-gr-menu aria-label="Actions")
                                            span.material-symbols-outlined more_vert
                                        .ds-menu__list
                                            button.ds-menu__item.js-edit(type="button")
                                                span.material-symbols-outlined= canManage ? 'edit' : 'visibility'
                                                span= canManage ? 'Modifier' : 'Voir'
                                            if canManage && !g.isBuiltIn
                                                .ds-menu__sep
                                                button.ds-menu__item.ds-menu__item--danger.js-delete-grade(type="button" data-id=g.id data-name=g.name)
                                                    span.material-symbols-outlined delete
                                                    span Supprimer

    //- ── Modale : éditeur de grade ──────────────────────────────────────────
    .gr-overlay#gradeOverlay(style="display:none")
        .grade-modal#gradeModal
            .grade-modal__head
                .gr-modal-hd-row
                    h3.grade-modal__title#gradeEditorTitle Nouveau grade
                    button.gr-modal-x#gradeCloseBtn(type="button" aria-label="Fermer")
                        span.material-symbols-outlined(style="font-size:20px") close
                .auth-field(style="margin:0")
                    label.auth-label Nom du grade
                    input.auth-input#gradeNameInput(type="text" placeholder="Ex. Réceptionniste")

            .grade-modal__body#gradePermissionsList
                each group in permissionGroups
                    .grade-perm-group
                        .grade-perm-group__hd
                            span.grade-perm-group__title= group.title
                            button.grade-perm-group__check-all(type="button" data-group=group.zones.join(',')) Tout activer
                        .grade-perm-group__zones
                            each zoneKey in group.zones
                                - const zone = permissionSchema[zoneKey]
                                - const zoneKeysList = Object.keys(zone.keys)
                                - const hasView = zoneKeysList.indexOf('view') >= 0
                                - const manageKeys = zoneKeysList.filter(function(k){ return k !== 'view' })
                                - const showOpts = manageKeys.length > 1 || (hasView && manageKeys.length > 0)
                                .grade-perm-zone-card(data-zone=zoneKey)
                                    .grade-perm-zone-card__hd
                                        .grade-perm-zone-card__info
                                            span.grade-perm-zone-card__name= zone.label
                                            if zone.description
                                                span.grade-perm-zone-card__desc= zone.description
                                        .grade-perm-level-pills
                                            button.grade-perm-level-btn.is-active(type="button" data-level="none") Aucun accès
                                            if hasView
                                                button.grade-perm-level-btn(type="button" data-level="view") Voir
                                            if manageKeys.length > 0
                                                button.grade-perm-level-btn(type="button" data-level="manage")= hasView ? 'Gérer' : (manageKeys.length === 1 ? 'Accès' : 'Personnaliser')
                                    if hasView
                                        input(type="checkbox" data-zone=zoneKey data-key="view" style="display:none" tabindex="-1")
                                    if !showOpts
                                        each key in manageKeys
                                            input(type="checkbox" data-zone=zoneKey data-key=key style="display:none" tabindex="-1")
                                    if showOpts
                                        .grade-perm-zone-card__manage-opts(style="display:none")
                                            each key in manageKeys
                                                - const keyLabel = zone.keys[key]
                                                label.grade-perm-toggle
                                                    span.grade-perm-toggle__label= keyLabel
                                                    .grade-perm-toggle__switch
                                                        input(type="checkbox" data-zone=zoneKey data-key=key)
                                                        span.grade-perm-toggle__track
                                                            span.grade-perm-toggle__thumb

            .grade-modal__foot
                p.etab-error#gradeError(style="display:none")
                .grade-modal__foot-actions
                    button.sm-btn.sm-btn--primary#gradeSaveBtn(type="button") Enregistrer
                    button.sm-btn.sm-btn--ghost#gradeCancelBtn(type="button") Annuler

    //- ── Modale suppression de grade ────────────────────────────────────────
    .cancel-modal-overlay#deleteGradeOverlay(style="display:none")
        .cancel-modal#deleteGradeModal
            h3.cancel-modal__title Supprimer ce grade ?
            .cancel-modal__info#deleteGradeInfo
            .auth-field#deleteGradeReassignField(style="display:none")
                label.auth-label Réassigner les collaborateurs concernés à
                select.auth-input#deleteGradeReassignSelect
                    each g in grades
                        option(value=g.id)= g.name
            p.etab-error#deleteGradeError(style="display:none")
            .cancel-modal__actions
                button.sm-btn.sm-btn--danger#deleteGradeConfirm(type="button") Oui, supprimer
                button.sm-btn.sm-btn--ghost#deleteGradeClose(type="button") Annuler

block scripts
    script(src="/js/layouts/grades.admin.js")
    script.
        window.__gradesCtx = {
            companyId: !{JSON.stringify(company.id)},
            canManage: !{JSON.stringify(!!(permissions && permissions.grades && permissions.grades.manage))}
        };
