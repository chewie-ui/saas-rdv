extends ../../layouts/admin

block links
    link(rel="stylesheet", href="/css/layouts/auth.css")
    link(rel="stylesheet", href="/css/layouts/informations.css")
    link(rel="stylesheet", href="/css/layouts/client-dashboard.css")
    link(rel="stylesheet", href="/css/layouts/etablissements.css")

block content
    a.etab-back-link(href="/etablissement/mes-etablissements" style="display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--text-muted,#6b7280);text-decoration:none;margin-bottom:16px")
        svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
            path(d="M19 12H5M12 19l-7-7 7-7")
        | Retour à mes établissements

    .dash-header
        .dash-header__left
            h1= company.name
            span.dash-header__sub
                if collaboratorsLimit !== null
                    = `${collaborators.length} / ${collaboratorsLimit} collaborateur(s) — forfait ${currentPlan}`
                else
                    = `${collaborators.length} collaborateur(s) — forfait ${currentPlan}`
        .dash-header__cta
            if permissions.collaborators.manage && !atCollaboratorsLimit
                button.sm-btn.sm-btn--primary#inviteBtn(type="button")
                    svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                        path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                    span Inviter un collaborateur

    if collaboratorsLimit === 0
        .estab-limit-banner
            span Votre forfait actuel ne permet pas d'ajouter de collaborateurs.
            a(href="/subscription") Passer à un forfait supérieur →
    else if atCollaboratorsLimit
        .estab-limit-banner
            span Vous avez atteint la limite de collaborateurs de votre forfait.
            if currentPlan === 'pro' || currentPlan === 'business'
                span &nbsp;— ajoutez un siège ci-dessous, ou
            a(href="/subscription") Passer à un forfait supérieur →

    if currentPlan === 'pro' || currentPlan === 'business'
        .info-card
            .info-card__header
                h3 Sièges collaborateurs supplémentaires
                p.info-card__desc Chaque siège ajouté permet 1 collaborateur de plus, facturé 10€/mois, avec proratisation automatique.
            .seats-stepper(style="display:flex;align-items:center;gap:12px")
                button.sm-btn.sm-btn--ghost#seatsMinusBtn(type="button" style="width:38px;padding:0") −
                span#seatsValue(style="min-width:26px;text-align:center;font-weight:700;font-size:15px")= extraCollaboratorSeats
                button.sm-btn.sm-btn--ghost#seatsPlusBtn(type="button" style="width:38px;padding:0") +
                span(style="color:var(--text-muted,#6b7280);font-size:13px")= `= +${extraCollaboratorSeats * 10}€/mois`
                button.sm-btn.sm-btn--primary#seatsSaveBtn(type="button" data-current=extraCollaboratorSeats) Mettre à jour
                span#seatsStatus(style="font-size:12.5px;color:var(--text-muted,#6b7280)")

            script.
                (function() {
                    var val = document.getElementById('seatsValue');
                    var minus = document.getElementById('seatsMinusBtn');
                    var plus = document.getElementById('seatsPlusBtn');
                    var save = document.getElementById('seatsSaveBtn');
                    var status = document.getElementById('seatsStatus');
                    function n() { return parseInt(val.textContent, 10) || 0; }
                    minus.addEventListener('click', function() { if (n() > 0) val.textContent = n() - 1; });
                    plus.addEventListener('click', function() { if (n() < 50) val.textContent = n() + 1; });
                    save.addEventListener('click', async function() {
                        save.disabled = true;
                        status.textContent = 'Mise à jour...';
                        try {
                            var r = await fetch('/account/collaborator-seats', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ seats: n() }),
                            });
                            var d = await r.json();
                            if (d.success) {
                                status.textContent = '✓ Mis à jour';
                                setTimeout(function() { window.location.reload(); }, 700);
                            } else {
                                status.textContent = d.error || 'Erreur';
                                save.disabled = false;
                            }
                        } catch (e) {
                            status.textContent = 'Erreur réseau';
                            save.disabled = false;
                        }
                    });
                })();

    if permissions.grades && (permissions.grades.view || permissions.grades.manage)
        .info-card
            .info-card__header
                h3 Grades & permissions
                p.info-card__desc Configurez les niveaux d'accès de chaque grade pour votre équipe.
            a.sm-btn.sm-btn--ghost(href=`/etablissement/${company.id}/grades` style="align-self:flex-start") Gérer les grades →

    .info-card
        .info-card__header
            h3 Patron
            p.info-card__desc Affichez (ou non) le patron comme prestataire sur la page de réservation publique.
        .collab-row(data-owner="1")
            img.collab-row__avatar(src=ownerUser.profilePicture || '/images/no-user.webp' alt=ownerUser.fullName)
            .collab-row__info
                div.collab-row__name= ownerUser.fullName
                div.collab-row__meta= ownerUser.email
            span.estab-badge.estab-badge--active Propriétaire
            - const viewerIsOwner = String(ownerUser._id) === String(user._id)
            if permissions.collaborators.manage || viewerIsOwner
                .collab-row__actions
                    if permissions.collaborators.manage
                        label.estab-active-toggle.js-employee-toggle(title="Afficher comme employé bookable" data-owner="1")
                            input.js-employee-toggle-input(type="checkbox" checked=ownerProfile.isEmployee data-owner="1")
                            span.estab-active-toggle__track
                                span.estab-active-toggle__thumb
                            span.estab-active-toggle__label= ownerProfile.isEmployee ? 'Employé' : 'Masqué'
                    button.sm-btn.sm-btn--ghost.js-edit-employee-profile(type="button" data-owner="1" data-profile=JSON.stringify(ownerProfile) data-name=ownerUser.fullName data-default-photo=(ownerUser.profilePicture || '/images/no-user.webp'))
                        span Modifier le profil

    .info-card
        .info-card__header
            h3 Collaborateurs
            p.info-card__desc Affichez (ou non) chaque collaborateur comme prestataire sur la page de réservation publique.
        if !collaborators.length
            .dash-empty-reviews
                p Aucun collaborateur pour le moment.
        else
            each c in collaborators
                - const isSelf = c.userId === String(user._id)
                .collab-row(class=c.isActive ? '' : 'collab-row--inactive' data-id=c.id)
                    img.collab-row__avatar(src=(c.displayPhoto || c.profilePicture) alt=(c.displayName || c.fullName))
                    .collab-row__info
                        div.collab-row__name= (c.displayName || c.fullName) + (c.isActive ? '' : ' (désactivé)')
                        div.collab-row__meta= c.email + ' · Membre depuis le ' + new Date(c.acceptedAt).toLocaleDateString('fr-FR')
                    .collab-row__actions
                        if permissions.collaborators.manage
                            select.collab-role-select.js-grade-select(data-id=c.id)
                                each g in grades
                                    option(value=g.id selected=c.gradeId === g.id)= g.name
                            select.collab-role-select.js-timeoff-select(data-id=c.id title="Peut poser ses propres congés")
                                option(value="" selected=c.canManageOwnTimeOff === null)= 'Congés : hérite du grade (' + (c.canManageOwnTimeOffEffective ? 'autorisé' : 'refusé') + ')'
                                option(value="true" selected=c.canManageOwnTimeOff === true) Congés : autorisé
                                option(value="false" selected=c.canManageOwnTimeOff === false) Congés : refusé
                            label.estab-active-toggle.js-employee-toggle(title="Afficher comme employé bookable" data-id=c.id)
                                input.js-employee-toggle-input(type="checkbox" checked=c.isEmployee data-id=c.id)
                                span.estab-active-toggle__track
                                    span.estab-active-toggle__thumb
                                span.estab-active-toggle__label= c.isEmployee ? 'Employé' : 'Masqué'
                        else
                            span.estab-badge= c.gradeName
                            span.estab-badge(class=c.isEmployee ? 'estab-badge--active' : '')= c.isEmployee ? 'Employé' : 'Masqué'
                        if permissions.collaborators.manage || isSelf
                            button.sm-btn.sm-btn--ghost.js-edit-employee-profile(type="button" data-id=c.id data-profile=JSON.stringify({isEmployee: c.isEmployee, displayName: c.displayName, displayPhoto: c.displayPhoto, description: c.description, showRole: c.showRole, customInfo: c.customInfo}) data-name=c.fullName data-default-photo=c.profilePicture)
                                span Modifier le profil
                        if permissions.collaborators.manage
                            button.sm-btn.sm-btn--ghost.js-toggle-active(type="button" data-id=c.id data-active=c.isActive ? '1' : '0')
                                span= c.isActive ? 'Désactiver' : 'Réactiver'
                            button.sm-btn.sm-btn--danger.js-remove-collab(type="button" data-id=c.id data-name=c.fullName)
                                span Retirer

    if permissions.collaborators.manage && pendingInvitations && pendingInvitations.length
        .info-card
            .info-card__header
                h3 Invitations envoyées
                p.info-card__desc= pendingInvitations.length + ' invitation(s) en attente d\'acceptation.'
            each inv in pendingInvitations
                .collab-row(data-id=inv.id)
                    img.collab-row__avatar(src="/images/no-user.webp" alt=inv.fullName)
                    .collab-row__info
                        div.collab-row__name= inv.fullName
                        div.collab-row__meta= inv.email + (inv.gradeName ? ' · ' + inv.gradeName : '')
                    .collab-row__actions
                        span.estab-badge.estab-badge--pending En attente
                        button.sm-btn.sm-btn--ghost.js-cancel-invitation(type="button" data-id=inv.id data-name=inv.fullName)
                            span Annuler

    if permissions.collaborators.manage && pendingRequests && pendingRequests.length
        .info-card
            .info-card__header
                h3 Demandes en attente
                p.info-card__desc= pendingRequests.length + ' demande(s) à approuver.'
            each r in pendingRequests
                .collab-row(data-id=r.id)
                    img.collab-row__avatar(src=r.profilePicture alt=r.fullName)
                    .collab-row__info
                        div.collab-row__name= r.fullName
                        div.collab-row__meta= r.email
                    .collab-row__actions
                        button.sm-btn.sm-btn--primary.js-respond-request(type="button" data-id=r.id data-decision="accepted")
                            span Accepter
                        button.sm-btn.sm-btn--ghost.js-respond-request(type="button" data-id=r.id data-decision="rejected")
                            span Refuser

    p.etab-error#collabError(style="display:none")

    //- ── Modale invitation ────────────────────────────────────────────────────
    .cancel-modal-overlay#inviteModalOverlay(style="display:none")
        .cancel-modal.invite-modal#inviteModal
            .cancel-modal__icon.cancel-modal__icon--accent
                svg(xmlns="http://www.w3.org/2000/svg" height="22px" viewBox="0 -960 960 960" width="22px" fill="currentColor")
                    path(d="M720-400v-120H600v-80h120v-120h80v120h120v80H800v120h-80ZM240-440q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM0-200v-50q0-37 19-65t52-44q49-25 100-37t69-12q12 0 28 1.5t29 3.5q-7 39-1 76.5t22 71.5q-50 1-91 16t-67 32q-19 11-31 28.5T0-200Z")
            h3.cancel-modal__title Inviter un collaborateur
            p.invite-modal__sub La personne doit déjà avoir un compte BranShee. Elle recevra une invitation et devra l'accepter avant d'avoir accès.

            .auth-field
                label.auth-label Email du collaborateur
                input.auth-input#inviteEmailInput(type="email" placeholder="prenom@exemple.com" autocomplete="off")

            .auth-field
                label.auth-label Grade
                select.auth-input#inviteGradeInput
                    each g in grades
                        option(value=g.id selected=g.isBuiltIn && g.name === 'Staff')= g.name

            p.etab-error#inviteModalError(style="display:none")
            .cancel-modal__actions
                button.sm-btn.sm-btn--primary#inviteModalConfirm(type="button") Envoyer l'invitation
                button.sm-btn.sm-btn--ghost#inviteModalClose(type="button") Annuler

    //- ── Modale retrait collaborateur ─────────────────────────────────────────
    .cancel-modal-overlay#removeModalOverlay(style="display:none")
        .cancel-modal#removeModal
            h3.cancel-modal__title Retirer ce collaborateur ?
            .cancel-modal__info#removeModalInfo
            .cancel-modal__actions
                button.sm-btn.sm-btn--danger#removeModalConfirm(type="button") Oui, retirer
                button.sm-btn.sm-btn--ghost#removeModalClose(type="button") Annuler

    //- ── Modale profil employé public (patron ou collaborateur) ──────────────
    .cancel-modal-overlay#empProfileOverlay(style="display:none")
        .cancel-modal.emp-profile-modal#empProfileModal
            h3.cancel-modal__title#empProfileTitle Profil employé

            .emp-profile-photo-row
                img#empProfilePhotoPreview.emp-profile-photo-row__img(src="/images/no-user.webp" alt="")
                .emp-profile-photo-row__actions
                    input#empProfilePhotoInput(type="file" accept="image/*" style="display:none")
                    button.sm-btn.sm-btn--ghost#empProfilePhotoBtn(type="button") Changer la photo

            .auth-field
                label.auth-label Nom affiché
                input.auth-input#empProfileNameInput(type="text" placeholder="Laisser vide pour utiliser le nom du compte")

            .auth-field
                label.auth-label Description
                textarea.auth-input#empProfileDescInput(rows="3" placeholder="Quelques mots à propos de cette personne...")

            .auth-field.emp-profile-checkbox-field
                label.emp-profile-checkbox
                    input#empProfileShowRoleInput(type="checkbox")
                    span Afficher le rôle (ex. "Manager") sur la page publique

            .auth-field
                label.auth-label Informations complémentaires
                #empProfileCustomInfoList.emp-profile-custom-list
                button.sm-btn.sm-btn--ghost#empProfileAddInfoBtn(type="button") + Ajouter une information

            p.etab-error#empProfileError(style="display:none")
            .cancel-modal__actions
                button.sm-btn.sm-btn--primary#empProfileSave(type="button") Enregistrer
                button.sm-btn.sm-btn--ghost#empProfileClose(type="button") Annuler


block scripts
    script.
        (function () {
            var companyId = !{JSON.stringify(company.id)};
            var errorEl = document.getElementById('collabError');

            function showError(msg) {
                errorEl.textContent = msg;
                errorEl.style.display = 'block';
                setTimeout(function () { errorEl.style.display = 'none'; }, 5000);
            }

            // ── Inviter ──────────────────────────────────────────────────────
            var inviteOverlay   = document.getElementById('inviteModalOverlay');
            var inviteBtn       = document.getElementById('inviteBtn');
            var inviteEmailInput = document.getElementById('inviteEmailInput');
            var inviteGradeInput = document.getElementById('inviteGradeInput');

            function resetInviteModal() {
                inviteEmailInput.value = '';
                document.getElementById('inviteModalError').style.display = 'none';
            }

            if (inviteBtn) inviteBtn.addEventListener('click', function () { resetInviteModal(); inviteOverlay.style.display = 'flex'; });
            document.getElementById('inviteModalClose').addEventListener('click', function () { inviteOverlay.style.display = 'none'; });

            document.getElementById('inviteModalConfirm').addEventListener('click', function () {
                var email = document.getElementById('inviteEmailInput').value.trim();
                var gradeId = inviteGradeInput.value;
                var errEl = document.getElementById('inviteModalError');
                if (!email) { errEl.textContent = "Indiquez l'email du collaborateur."; errEl.style.display = 'block'; return; }
                var btn = this;
                btn.disabled = true;
                fetch('/account/establishments/' + companyId + '/collaborateurs', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email, gradeId: gradeId }),
                })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        btn.disabled = false;
                        if (data.success) window.location.reload();
                        else { errEl.textContent = data.error || 'Erreur.'; errEl.style.display = 'block'; }
                    })
                    .catch(function () { btn.disabled = false; errEl.textContent = 'Erreur réseau.'; errEl.style.display = 'block'; });
            });

            // ── Changer le grade ───────────────────────────────────────────────
            document.querySelectorAll('.js-grade-select').forEach(function (sel) {
                sel.addEventListener('change', function () {
                    fetch('/account/establishments/' + companyId + '/collaborateurs/' + sel.dataset.id + '/grade', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ gradeId: sel.value }),
                    })
                        .then(function (r) { return r.json(); })
                        .then(function (data) { if (!data.success) showError(data.error || 'Erreur.'); })
                        .catch(function () { showError('Erreur réseau.'); });
                });
            });

            // ── Override individuel "peut poser ses propres congés" ──────────
            document.querySelectorAll('.js-timeoff-select').forEach(function (sel) {
                sel.addEventListener('change', function () {
                    var value = sel.value === '' ? null : sel.value === 'true';
                    fetch('/account/establishments/' + companyId + '/collaborateurs/' + sel.dataset.id + '/time-off-permission', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ canManageOwnTimeOff: value }),
                    })
                        .then(function (r) { return r.json(); })
                        .then(function (data) { if (!data.success) showError(data.error || 'Erreur.'); else window.location.reload(); })
                        .catch(function () { showError('Erreur réseau.'); });
                });
            });

            // ── Activer / désactiver ─────────────────────────────────────────
            document.querySelectorAll('.js-toggle-active').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var isActive = btn.dataset.active === '1';
                    fetch('/account/establishments/' + companyId + '/collaborateurs/' + btn.dataset.id + '/active', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ isActive: !isActive }),
                    })
                        .then(function (r) { return r.json(); })
                        .then(function (data) { if (data.success) window.location.reload(); else showError(data.error || 'Erreur.'); })
                        .catch(function () { showError('Erreur réseau.'); });
                });
            });

            // ── Retirer (virer) ──────────────────────────────────────────────
            var removeOverlay = document.getElementById('removeModalOverlay');
            var removeInfo = document.getElementById('removeModalInfo');
            var removeConfirmBtn = document.getElementById('removeModalConfirm');
            var removeTargetId = null;

            document.querySelectorAll('.js-remove-collab').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    removeTargetId = btn.dataset.id;
                    removeInfo.textContent = 'Vous êtes sur le point de retirer "' + btn.dataset.name + '" de cet établissement.';
                    removeOverlay.style.display = 'flex';
                });
            });
            document.getElementById('removeModalClose').addEventListener('click', function () {
                removeOverlay.style.display = 'none';
                removeTargetId = null;
            });
            removeConfirmBtn.addEventListener('click', function () {
                if (!removeTargetId) return;
                removeConfirmBtn.disabled = true;
                fetch('/account/establishments/' + companyId + '/collaborateurs/' + removeTargetId, { method: 'DELETE' })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        removeConfirmBtn.disabled = false;
                        if (data.success) window.location.reload();
                        else showError(data.error || 'Erreur.');
                    })
                    .catch(function () { removeConfirmBtn.disabled = false; showError('Erreur réseau.'); });
            });

            // ── Toggle "Afficher comme employé" ───────────────────────────────
            function employeeProfileUrl(el) {
                return el.dataset.owner === '1'
                    ? '/account/establishments/' + companyId + '/owner-employee-profile'
                    : '/account/establishments/' + companyId + '/collaborateurs/' + el.dataset.id + '/employee-profile';
            }

            document.querySelectorAll('.js-employee-toggle-input').forEach(function (input) {
                input.addEventListener('change', function () {
                    var label = input.closest('.js-employee-toggle');
                    var labelSpan = label.querySelector('.estab-active-toggle__label');
                    fetch(employeeProfileUrl(input), {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ isEmployee: input.checked }),
                    })
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            if (data.success) labelSpan.textContent = input.checked ? 'Employé' : 'Masqué';
                            else { input.checked = !input.checked; showError(data.error || 'Erreur.'); }
                        })
                        .catch(function () { input.checked = !input.checked; showError('Erreur réseau.'); });
                });
            });

            // ── Modale profil employé (nom, photo, description, rôle, infos) ──
            var empOverlay      = document.getElementById('empProfileOverlay');
            var empTitle        = document.getElementById('empProfileTitle');
            var empPhotoPreview = document.getElementById('empProfilePhotoPreview');
            empPhotoPreview.addEventListener('error', function () {
                if (empPhotoPreview.src.indexOf('no-user.webp') === -1) empPhotoPreview.src = '/images/no-user.webp';
            });
            var empPhotoInput   = document.getElementById('empProfilePhotoInput');
            var empPhotoBtn     = document.getElementById('empProfilePhotoBtn');
            var empNameInput    = document.getElementById('empProfileNameInput');
            var empDescInput    = document.getElementById('empProfileDescInput');
            var empShowRoleInput = document.getElementById('empProfileShowRoleInput');
            var empCustomList   = document.getElementById('empProfileCustomInfoList');
            var empAddInfoBtn   = document.getElementById('empProfileAddInfoBtn');
            var empSaveBtn      = document.getElementById('empProfileSave');
            var empError        = document.getElementById('empProfileError');
            var empTarget       = null; // { isOwner, id, defaultPhoto }
            var empUploadedPhoto = null; // chemin de la nouvelle photo, si changée

            function empCustomRow(label, value) {
                var row = document.createElement('div');
                row.className = 'emp-profile-custom-row';
                row.innerHTML =
                    '<input type="text" class="auth-input js-custom-label" placeholder="Ex. Expérience" value="' + (label || '').replace(/"/g, '&quot;') + '">' +
                    '<input type="text" class="auth-input js-custom-value" placeholder="Ex. 10 ans" value="' + (value || '').replace(/"/g, '&quot;') + '">' +
                    '<button type="button" class="sm-btn sm-btn--ghost js-custom-remove">&times;</button>';
                row.querySelector('.js-custom-remove').addEventListener('click', function () { row.remove(); });
                return row;
            }

            empAddInfoBtn.addEventListener('click', function () { empCustomList.appendChild(empCustomRow('', '')); });

            empPhotoBtn.addEventListener('click', function () { empPhotoInput.click(); });
            empPhotoInput.addEventListener('change', function () {
                var file = empPhotoInput.files[0];
                if (!file) return;
                empPhotoPreview.src = URL.createObjectURL(file);
                var fd = new FormData();
                fd.append('photo', file);
                empPhotoBtn.disabled = true;
                fetch('/account/establishments/photo-temp', { method: 'POST', body: fd })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        empPhotoBtn.disabled = false;
                        if (data.success) empUploadedPhoto = data.path;
                        else { empError.textContent = data.error || "Erreur lors de l'envoi de la photo."; empError.style.display = 'block'; }
                    })
                    .catch(function () { empPhotoBtn.disabled = false; empError.textContent = 'Erreur réseau.'; empError.style.display = 'block'; });
            });

            document.querySelectorAll('.js-edit-employee-profile').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var profile = JSON.parse(btn.dataset.profile || '{}');
                    empTarget = { isOwner: btn.dataset.owner === '1', id: btn.dataset.id, defaultPhoto: btn.dataset.defaultPhoto };
                    empUploadedPhoto = null;
                    empTitle.textContent = 'Profil employé — ' + btn.dataset.name;
                    empNameInput.value = profile.displayName || '';
                    empNameInput.placeholder = btn.dataset.name;
                    empDescInput.value = profile.description || '';
                    empShowRoleInput.checked = !!profile.showRole;
                    empPhotoPreview.src = profile.displayPhoto || btn.dataset.defaultPhoto || '/images/no-user.webp';
                    empCustomList.innerHTML = '';
                    (profile.customInfo || []).forEach(function (i) { empCustomList.appendChild(empCustomRow(i.label, i.value)); });
                    empError.style.display = 'none';
                    empOverlay.style.display = 'flex';
                });
            });

            document.getElementById('empProfileClose').addEventListener('click', function () { empOverlay.style.display = 'none'; });

            empSaveBtn.addEventListener('click', function () {
                if (!empTarget) return;
                var customInfo = Array.from(empCustomList.querySelectorAll('.emp-profile-custom-row')).map(function (row) {
                    return { label: row.querySelector('.js-custom-label').value.trim(), value: row.querySelector('.js-custom-value').value.trim() };
                }).filter(function (i) { return i.label || i.value; });

                var payload = {
                    displayName: empNameInput.value.trim(),
                    description: empDescInput.value.trim(),
                    showRole: empShowRoleInput.checked,
                    customInfo: customInfo,
                };
                if (empUploadedPhoto) payload.displayPhoto = empUploadedPhoto;

                var url = empTarget.isOwner
                    ? '/account/establishments/' + companyId + '/owner-employee-profile'
                    : '/account/establishments/' + companyId + '/collaborateurs/' + empTarget.id + '/employee-profile';

                empSaveBtn.disabled = true;
                fetch(url, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        empSaveBtn.disabled = false;
                        if (data.success) window.location.reload();
                        else { empError.textContent = data.error || 'Erreur.'; empError.style.display = 'block'; }
                    })
                    .catch(function () { empSaveBtn.disabled = false; empError.textContent = 'Erreur réseau.'; empError.style.display = 'block'; });
            });

            // ── Répondre à une demande de rejoindre ──────────────────────────
            document.querySelectorAll('.js-respond-request').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    fetch('/account/establishments/' + companyId + '/join-requests/' + btn.dataset.id, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ decision: btn.dataset.decision }),
                    })
                        .then(function (r) { return r.json(); })
                        .then(function (data) { if (data.success) window.location.reload(); else showError(data.error || 'Erreur.'); })
                        .catch(function () { showError('Erreur réseau.'); });
                });
            });

            // ── Annuler une invitation envoyée ───────────────────────────────
            document.querySelectorAll('.js-cancel-invitation').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    if (!confirm('Annuler l\'invitation envoyée à "' + btn.dataset.name + '" ?')) return;
                    btn.disabled = true;
                    fetch('/account/establishments/' + companyId + '/collaborateurs/' + btn.dataset.id, { method: 'DELETE' })
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            if (data.success) window.location.reload();
                            else { btn.disabled = false; showError(data.error || 'Erreur.'); }
                        })
                        .catch(function () { btn.disabled = false; showError('Erreur réseau.'); });
                });
            });
        })();
