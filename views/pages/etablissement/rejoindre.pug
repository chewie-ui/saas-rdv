extends ../../layouts/auth

block links
    link(rel="stylesheet", href="/css/layouts/auth-register.css")
    link(rel="stylesheet", href="/css/layouts/informations.css")
    style.
        .etab-back-link { display:inline-flex; align-items:center; gap:6px; font-size:13px; color:var(--text-muted,#6b7280); text-decoration:none; margin-bottom:18px; }
        .etab-back-link:hover { color:var(--text-primary,#111); }
        .etab-error { display:none; font-size:13px; color:#dc2626; background:#fef2f2; border:1px solid #fecaca; border-radius:8px; padding:10px 14px; margin-bottom:16px; }
        .etab-sent { display:none; text-align:center; padding:32px 8px; }
        .etab-sent svg { color:var(--accent,#16a34a); margin-bottom:14px; }
        .etab-sent h2 { font-size:18px; margin:0 0 8px; }
        .etab-sent p { font-size:14px; color:var(--text-muted,#6b7280); margin:0; }

block content
    .auth-split

        //- ── Panneau gauche décoratif ───────────────────────────────
        .auth-art
            a.auth-art__logo(href="/")
                img.auth-art__logo-mark(src="/images/icon.svg" alt="BranShee")
                span BranShee

            .auth-art__body
                .auth-art__headline
                    | Rejoignez une équipe&nbsp;
                    br
                    | déjà sur BranShee.
                .auth-art__stats
                    .auth-art__stat
                        .auth-art__stat-num 0 appel
                        .auth-art__stat-label pour réserver
                    .auth-art__stat
                        .auth-art__stat-num 24/7
                        .auth-art__stat-label réservations auto
                    .auth-art__stat
                        .auth-art__stat-num Business
                        .auth-art__stat-label plan requis

            .auth-art__foot © BranShee · Bruxelles

        //- ── Panneau droit : recherche ────────────────────────────
        .auth-form-panel
            .auth-form-inner#joinFormInner
                a.etab-back-link(href="/espace-client")
                    svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                        path(d="M19 12H5M12 19l-7-7 7-7")
                    | Retour à mon espace

                h1 Rejoindre un établissement
                p.auth-sub Recherchez l'établissement à rejoindre — le propriétaire devra approuver votre demande. Seuls les établissements en plan Business apparaissent ici.

                .etab-error#joinError

                .auth-field
                    label.auth-label Nom de l'établissement
                    .service-select-wrapper
                        input.auth-input.service-input#joinCompanyInput(type="text" placeholder="Tapez pour rechercher..." autocomplete="off")
                        .service-dropdown#joinCompanyDropdown

            .etab-sent#joinSentPanel
                svg(xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="currentColor")
                    path(d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z")
                h2 Demande envoyée
                p Le propriétaire de l'établissement doit approuver votre demande. Vous serez averti une fois la décision prise.
                a.sm-btn.sm-btn--primary(href="/espace-client" style="margin-top:18px;display:inline-flex") Retour à mon espace

block scripts
    script.
        (function () {
            var joinInput = document.getElementById('joinCompanyInput');
            var joinDropdown = document.getElementById('joinCompanyDropdown');
            var errorEl = document.getElementById('joinError');
            var formInner = document.getElementById('joinFormInner');
            var sentPanel = document.getElementById('joinSentPanel');
            var joinTimer = null;

            function showError(msg) {
                errorEl.textContent = msg;
                errorEl.style.display = 'block';
            }

            async function submitJoinRequest(companyId, label, btn) {
                if (!confirm('Envoyer une demande pour rejoindre ' + label + ' ? Le propriétaire devra approuver.')) return;
                btn.disabled = true;
                try {
                    var res = await fetch('/account/join-company', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ companyId: companyId }),
                    });
                    var data = await res.json();
                    if (data.success) {
                        formInner.style.display = 'none';
                        sentPanel.style.display = 'block';
                    } else {
                        showError(data.error || "Erreur lors de l'envoi de la demande.");
                        btn.disabled = false;
                    }
                } catch (e) {
                    showError('Erreur réseau.');
                    btn.disabled = false;
                }
            }

            function renderJoinList(companies) {
                joinDropdown.innerHTML = '';
                if (!companies.length) {
                    var empty = document.createElement('div');
                    empty.className = 'service-dropdown__item';
                    empty.style.color = '#9ca3af';
                    empty.textContent = 'Aucun établissement Business trouvé.';
                    joinDropdown.appendChild(empty);
                    joinDropdown.style.display = 'block';
                    return;
                }
                companies.forEach(function (c) {
                    var div = document.createElement('div');
                    div.className = 'service-dropdown__item';
                    div.textContent = c.name + (c.businessType ? ' — ' + c.businessType : '');
                    div.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                        joinDropdown.style.display = 'none';
                        submitJoinRequest(c.id, c.name, joinInput);
                    });
                    joinDropdown.appendChild(div);
                });
                joinDropdown.style.display = 'block';
            }

            function fetchCompanies(q) {
                fetch('/api/joinable-companies?q=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (data) { renderJoinList(data.companies || []); })
                    .catch(function () { joinDropdown.style.display = 'none'; });
            }

            if (joinInput) {
                // Au focus (champ vide) : on propose quelques établissements
                // par défaut, plutôt qu'un menu vide tant qu'on n'a rien tapé.
                joinInput.addEventListener('focus', function () {
                    if (!joinInput.value.trim()) fetchCompanies('');
                });
                joinInput.addEventListener('input', function () {
                    clearTimeout(joinTimer);
                    var q = joinInput.value.trim();
                    joinTimer = setTimeout(function () { fetchCompanies(q); }, 300);
                });
                joinInput.addEventListener('blur', function () {
                    setTimeout(function () { joinDropdown.style.display = 'none'; }, 160);
                });
            }
        })();
