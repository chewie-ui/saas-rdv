doctype html
html(lang="fr")
    head
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(charset="UTF-8")
        title Superadmin — Parrainage
        link(rel="shortcut icon" href="/images/icon.svg" type="image/x-icon")
        link(rel="stylesheet" href="/css/import.css")
        style.
            *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
            body { min-height:100vh; background:#0f0f0f; color:#e0e0e0; font-family:'Inter',sans-serif; padding:32px 24px 80px; }
            .sa-nav { display:flex; gap:8px; margin-bottom:32px; flex-wrap:wrap; align-items:center; justify-content:space-between; }
            .sa-nav__links { display:flex; gap:8px; flex-wrap:wrap; }
            a.sa-link { font-size:13px; padding:7px 16px; border-radius:8px; text-decoration:none; border:1px solid #2a2a2a; color:#888; transition:color .15s,border-color .15s; }
            a.sa-link.active, a.sa-link:hover { color:#fff; border-color:#444; }
            a.logout-btn { font-size:12px; color:#555; text-decoration:none; padding:6px 12px; border:1px solid #2a2a2a; border-radius:8px; }
            a.logout-btn:hover { color:#f87171; border-color:rgba(248,113,113,.3); }
            .page-header { margin-bottom:24px; }
            .page-header h1 { font-size:24px; font-weight:700; color:#fff; letter-spacing:-.02em; }
            .page-header p { font-size:13px; color:#555; margin-top:4px; }
            .stats-row { display:flex; gap:12px; margin-bottom:28px; flex-wrap:wrap; }
            .stat-card { background:#1a1a1a; border:1px solid #2a2a2a; border-radius:12px; padding:16px 20px; display:flex; flex-direction:column; gap:4px; min-width:130px; }
            .stat-card__value { font-size:26px; font-weight:700; color:#fff; letter-spacing:-.02em; line-height:1; }
            .stat-card__label { font-size:11px; color:#555; text-transform:uppercase; letter-spacing:.06em; }
            .ref-card { background:#1a1a1a; border:1px solid #2a2a2a; border-radius:14px; margin-bottom:14px; overflow:hidden; }
            .ref-card__header { display:flex; align-items:center; justify-content:space-between; padding:16px 20px; gap:12px; flex-wrap:wrap; border-bottom:1px solid #222; }
            .ref-card__info { display:flex; flex-direction:column; gap:3px; }
            .ref-card__name { font-size:15px; font-weight:700; color:#fff; }
            .ref-card__email { font-size:12px; color:#555; }
            .ref-card__stats { display:flex; gap:10px; flex-wrap:wrap; }
            .ref-stat { display:flex; flex-direction:column; align-items:center; gap:2px; background:#111; border:1px solid #2a2a2a; border-radius:8px; padding:8px 14px; min-width:80px; }
            .ref-stat__val { font-size:18px; font-weight:800; color:#fff; line-height:1; }
            .ref-stat__val.green { color:#22c55e; }
            .ref-stat__label { font-size:10px; color:#555; text-transform:uppercase; letter-spacing:.06em; }
            .ref-card__code { font-family:monospace; font-size:12px; color:#666; background:#111; border:1px solid #2a2a2a; border-radius:6px; padding:4px 10px; }
            .ref-filleuls { padding:0 20px 16px; }
            .ref-filleuls__title { font-size:10px; text-transform:uppercase; letter-spacing:.08em; color:#444; margin:12px 0 8px; }
            .ref-filleul { display:flex; align-items:center; gap:10px; padding:8px 12px; background:#111; border-radius:8px; margin-bottom:6px; }
            .ref-filleul__name { font-size:13px; font-weight:600; color:#ccc; flex:1; }
            .ref-filleul__email { font-size:11px; color:#555; }
            .ref-filleul__badge { font-size:10px; font-weight:700; text-transform:uppercase; padding:3px 8px; border-radius:6px; }
            .ref-filleul__badge.paying { background:rgba(34,197,94,.15); color:#22c55e; border:1px solid rgba(34,197,94,.25); }
            .ref-filleul__badge.free { background:#1a1a1a; color:#555; border:1px solid #2a2a2a; }
            .ref-filleul__date { font-size:11px; color:#444; }
            .empty-state { text-align:center; padding:60px 24px; color:#444; font-size:14px; }
    body
        .sa-nav
            .sa-nav__links
                a.sa-link(href="/superadmin") 👥 Utilisateurs
                a.sa-link(href="/superadmin/promo-codes") 🎟️ Codes promo
                a.sa-link(href="/superadmin/access-links") 🔗 Liens d'accès
                a.sa-link(href="/superadmin/boost") ⭐ Mise en avant
                a.sa-link.active(href="/superadmin/referrals") 🎁 Parrainage
                a.sa-link(href="/superadmin/features") 🚧 Pages
            a.logout-btn(href="/superadmin/logout") Déconnexion

        .page-header
            h1 🎁 Parrainage
            p Suivi des parrains et de leurs filleuls.

        - var totalParrains = users.length
        - var totalFilleuls = users.reduce(function(s,u){return s+(u.referral&&u.referral.totalInvited||0)},0)
        - var totalPayants  = users.reduce(function(s,u){return s+(u.referral&&u.referral.totalPaying||0)},0)
        - var totalCredits  = users.reduce(function(s,u){return s+(u.referral&&u.referral.creditMonths||0)},0)

        .stats-row
            .stat-card
                .stat-card__value= totalParrains
                .stat-card__label Parrains actifs
            .stat-card
                .stat-card__value= totalFilleuls
                .stat-card__label Filleuls inscrits
            .stat-card
                .stat-card__value= totalPayants
                .stat-card__label Filleuls payants
            .stat-card
                .stat-card__value= totalCredits
                .stat-card__label Mois en attente

        if users.length === 0
            .empty-state Aucun parrainage pour le moment.
        else
            each u in users
                .ref-card
                    .ref-card__header
                        .ref-card__info
                            .ref-card__name= u.fullName
                            .ref-card__email= u.email
                            span.ref-card__code= u.referralCode || '—'
                        .ref-card__stats
                            .ref-stat
                                .ref-stat__val= u.referral && u.referral.totalInvited || 0
                                .ref-stat__label Inscrits
                            .ref-stat
                                .ref-stat__val.green= u.referral && u.referral.totalPaying || 0
                                .ref-stat__label Payants
                            .ref-stat
                                .ref-stat__val= u.referral && u.referral.creditMonths || 0
                                .ref-stat__label Mois offerts
                    if u.filleuls && u.filleuls.length
                        .ref-filleuls
                            .ref-filleuls__title Filleuls (#{u.filleuls.length})
                            each f in u.filleuls
                                .ref-filleul
                                    .ref-filleul__name= f.fullName
                                    .ref-filleul__email= f.email
                                    span.ref-filleul__badge(class=f.isPremium ? 'paying' : 'free')
                                        = f.isPremium ? '💳 Payant' : 'Gratuit'
                                    .ref-filleul__date= new Date(f.createdAt).toLocaleDateString('fr-FR')
