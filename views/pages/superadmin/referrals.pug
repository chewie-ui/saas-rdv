extends ../../layouts/sa

block content
    -
        var palette = ['#6ee7b7', '#93c5fd', '#fcd34d', '#fca5a5', '#c4b5fd', '#f9a8d4', '#a5f3fc', '#bef264'];
        function couleurAvatar(s) {
            var n = 0;
            for (var i = 0; i < String(s).length; i++) n += String(s).charCodeAt(i);
            return palette[n % palette.length];
        }
        function initiales(nom, email) {
            var base = String(nom || email || '?').trim();
            var mots = base.split(/[\s@._-]+/).filter(Boolean);
            return ((mots[0] || '?')[0] + (mots[1] ? mots[1][0] : '')).toUpperCase();
        }
        var totalFilleuls = users.reduce(function (s, u) { return s + ((u.referral && u.referral.totalInvited) || 0); }, 0);
        var totalPayants = users.reduce(function (s, u) { return s + ((u.referral && u.referral.totalPaying) || 0); }, 0);
        var totalCredits = users.reduce(function (s, u) { return s + ((u.referral && u.referral.creditMonths) || 0); }, 0);

    .sa-head
        button.sa-ico.sa-burger(type="button" data-sa-burger aria-label="Menu")
            span.material-symbols-outlined menu
        div
            h1.sa-head__title Parrainage
            .sa-head__sub Parrains, filleuls et mois offerts à créditer

    .sa-body
        .sa-kpis
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined handshake
                    span Parrains
                .sa-kpi__value= users.length
                .sa-kpi__delta Ont invité au moins une personne
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined group_add
                    span Filleuls inscrits
                .sa-kpi__value= totalFilleuls
                .sa-kpi__delta= totalFilleuls ? Math.round((totalPayants / totalFilleuls) * 100) + ' % devenus payants' : '—'
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined credit_card
                    span Filleuls payants
                .sa-kpi__value= totalPayants
                .sa-kpi__delta Abonnements déclenchés
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined redeem
                    span Mois à offrir
                .sa-kpi__value(class=totalCredits ? 'sa-kpi__delta--up' : '')= totalCredits
                .sa-kpi__delta Crédits en attente

        if !users.length
            .sa-empty
                .sa-empty__ic
                    span.material-symbols-outlined handshake
                .sa-empty__t Aucun parrainage
                .sa-empty__d Personne n'a encore invité de filleul.
        else
            each u in users
                - var invites = (u.referral && u.referral.totalInvited) || 0
                - var payants = (u.referral && u.referral.totalPaying) || 0
                - var credits = (u.referral && u.referral.creditMonths) || 0
                .sa-card(style="margin-bottom:14px")
                    .sa-parrain
                        span.sa-av(style='background:' + couleurAvatar(u.email || u.fullName))= initiales(u.fullName, u.email)
                        div(style="min-width:0;flex:1")
                            .sa-person__name= u.fullName || '—'
                            .sa-person__mail= u.email
                        span.sa-tag.sa-mono= u.referralCode || '—'
                        .sa-parrain__stats
                            .sa-parrain__stat
                                .sa-parrain__val= invites
                                .sa-parrain__lbl Inscrits
                            .sa-parrain__stat
                                .sa-parrain__val(style="color:#4ade80")= payants
                                .sa-parrain__lbl Payants
                            .sa-parrain__stat
                                .sa-parrain__val(class=credits ? 'sa-kpi__delta--up' : '')= credits
                                .sa-parrain__lbl Mois offerts

                    if u.filleuls && u.filleuls.length
                        .sa-section(style="margin-top:16px")
                            .sa-section__t= 'Filleuls (' + u.filleuls.length + ')'
                            .sa-props
                                each f in u.filleuls
                                    .sa-prop(style="grid-template-columns:1fr auto")
                                        .sa-prop__k(style="color:var(--sa-txt)")
                                            span.material-symbols-outlined person
                                            div
                                                div= f.fullName || '—'
                                                .sa-person__mail= f.email
                                        div(style="display:flex;align-items:center;gap:10px")
                                            if f.referralPaidCounted
                                                span.sa-tag.sa-tag--green Payant
                                            else
                                                span.sa-tag Gratuit
                                            span.sa-muted(style="font-size:12px")= new Date(f.createdAt).toLocaleDateString('fr-FR')
