extends ../../layouts/sa

block content
    -
        var LIBELLES = { active: 'Actif', maintenance: 'En construction', error: 'Erreur temporaire', disabled: 'Désactivé' };
        var COULEURS = { active: 'sa-tag--green', maintenance: 'sa-tag--amber', error: 'sa-tag--red', disabled: '' };
        var enPanne = features.filter(function (f) { return f.status !== 'active'; }).length;
        var liensCaches = navSections.reduce(function (n, s) {
            return n + s.links.filter(function (l) { return !l.enabled; }).length;
        }, 0);
        var modulesCoupes = adminFeatures.filter(function (f) { return !f.enabled; }).length;

    .sa-head
        button.sa-ico.sa-burger(type="button" data-sa-burger aria-label="Menu")
            span.material-symbols-outlined menu
        div
            h1.sa-head__title Pages & fonctionnalités
            .sa-head__sub Couper une page, la passer en maintenance ou masquer un lien du menu

    .sa-body
        .sa-kpis
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined toggle_on
                    span Pages surveillées
                .sa-kpi__value= features.length
                .sa-kpi__delta(class=enPanne ? 'sa-kpi__delta--down' : '')= enPanne ? enPanne + ' hors service' : 'Toutes actives'
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined visibility_off
                    span Liens masqués
                .sa-kpi__value= liensCaches
                .sa-kpi__delta Invisibles dans le menu des pros
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined extension
                    span Modules coupés
                .sa-kpi__value= modulesCoupes
                .sa-kpi__delta= 'sur ' + adminFeatures.length + ' modules'

        .sa-tabs
            button.sa-tab.is-active(type="button" data-onglet="pages") Pages publiques
            button.sa-tab(type="button" data-onglet="menu") Menu des pros
            button.sa-tab(type="button" data-onglet="modules") Modules

        //- ── Pages publiques ───────────────────────────────────────────────
        .sa-pane.is-active#pane-pages
            each f in features
                .sa-card.sa-flag(data-key=f.key style="margin-bottom:12px")
                    .sa-flag__top
                        div
                            .sa-flag__label= f.label
                            .sa-mono.sa-muted= f.key
                        span.sa-tag.js-badge(class=COULEURS[f.status])= LIBELLES[f.status]
                    .sa-flag__row
                        .sa-field(style="min-width:210px")
                            span.sa-field__label Statut
                            select.sa-select.js-statut
                                option(value="active" selected=f.status === 'active') Actif
                                option(value="maintenance" selected=f.status === 'maintenance') En cours de construction
                                option(value="error" selected=f.status === 'error') Erreur temporaire
                                option(value="disabled" selected=f.status === 'disabled') Désactivé
                        .sa-field(style="flex:1;min-width:220px")
                            span.sa-field__label Message affiché (facultatif)
                            input.sa-input.js-message(type="text" placeholder="Vide = message par défaut" value=f.message)
                        button.sa-btn.js-save(type="button" style="align-self:flex-end")
                            span.material-symbols-outlined save
                            span Enregistrer

        //- ── Menu des pros ─────────────────────────────────────────────────
        .sa-pane#pane-menu
            .sa-alerte
                span.material-symbols-outlined lightbulb
                div Détecté automatiquement depuis le menu latéral des pros. Décochez un lien pour le masquer à <b>tous les comptes</b> pendant que la page est en travaux.
            each section in navSections
                .sa-card(style="margin-bottom:12px")
                    .sa-card__t= section.label
                    each l in section.links
                        .sa-bascule(data-nav-key=l.key)
                            div(style="min-width:0")
                                .sa-flag__label= l.label
                                .sa-mono.sa-muted= l.href
                            label.sa-switch
                                input.js-nav(type="checkbox" checked=l.enabled)
                                span.sa-switch__track

        //- ── Modules ───────────────────────────────────────────────────────
        .sa-pane#pane-modules
            .sa-card
                .sa-card__t Modules activables
                .sa-bascule(data-module-key="sms_notifications")
                    div(style="min-width:0")
                        .sa-flag__label Notifications SMS aux clients
                        .sa-head__sub Envoie un SMS de confirmation après une réservation, en plus de l'email. Préparé mais désactivé par défaut.
                    label.sa-switch
                        input.js-module(type="checkbox" checked=smsNotificationsEnabled)
                        span.sa-switch__track
                each f in adminFeatures
                    .sa-bascule(data-module-key=f.key)
                        div(style="min-width:0")
                            .sa-flag__label= f.label
                            .sa-mono.sa-muted= f.key
                        label.sa-switch
                            input.js-module(type="checkbox" checked=f.enabled)
                            span.sa-switch__track

block scripts
    script.
        (function () {
            // ── Onglets ───────────────────────────────────────────────────
            document.querySelectorAll('[data-onglet]').forEach(function (tab) {
                tab.addEventListener('click', function () {
                    document.querySelectorAll('[data-onglet]').forEach(function (t) { t.classList.remove('is-active'); });
                    document.querySelectorAll('.sa-pane').forEach(function (p) { p.classList.remove('is-active'); });
                    tab.classList.add('is-active');
                    document.getElementById('pane-' + tab.dataset.onglet).classList.add('is-active');
                });
            });

            var LIBELLES = { active: 'Actif', maintenance: 'En construction', error: 'Erreur temporaire', disabled: 'Désactivé' };
            var COULEURS = { active: 'sa-tag--green', maintenance: 'sa-tag--amber', error: 'sa-tag--red', disabled: '' };

            // ── Statut d'une page publique ────────────────────────────────
            document.querySelectorAll('.sa-flag').forEach(function (carte) {
                carte.querySelector('.js-save').addEventListener('click', function () {
                    var bouton = this;
                    var statut = carte.querySelector('.js-statut').value;
                    bouton.disabled = true;
                    fetch('/superadmin/features/' + carte.dataset.key, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ status: statut, message: carte.querySelector('.js-message').value })
                    })
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            bouton.disabled = false;
                            if (!d.success) throw new Error(d.error || 'échec');
                            var badge = carte.querySelector('.js-badge');
                            badge.className = 'sa-tag js-badge ' + (COULEURS[statut] || '');
                            badge.textContent = LIBELLES[statut];
                            window.saToast('Statut mis à jour.');
                        })
                        .catch(function () {
                            bouton.disabled = false;
                            window.saToast('Enregistrement impossible.', 'err');
                        });
                });
            });

            // ── Bascules (liens du menu et modules) ───────────────────────
            function brancher(selecteur, url) {
                document.querySelectorAll(selecteur).forEach(function (input) {
                    input.addEventListener('change', function () {
                        var ligne = input.closest('.sa-bascule');
                        var cle = ligne.dataset.navKey || ligne.dataset.moduleKey;
                        var actif = input.checked;
                        input.disabled = true;
                        fetch(url(cle), {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ enabled: actif })
                        })
                            .then(function (r) { return r.json(); })
                            .then(function (d) {
                                input.disabled = false;
                                if (!d.success) throw new Error(d.error || 'échec');
                                window.saToast(actif ? 'Activé.' : 'Désactivé.');
                            })
                            .catch(function () {
                                input.disabled = false;
                                input.checked = !actif;
                                window.saToast('Changement impossible.', 'err');
                            });
                    });
                });
            }
            brancher('.js-nav', function (cle) { return '/superadmin/nav/' + cle + '/toggle'; });
            brancher('.js-module', function (cle) { return '/superadmin/hidden-features/' + cle; });
        })();
