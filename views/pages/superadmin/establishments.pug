doctype html
html(lang="fr")
    head
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(charset="UTF-8")
        title Superadmin — Établissements
        link(rel="shortcut icon" href="/images/icon.svg" type="image/x-icon")
        link(rel="stylesheet" href="/css/import.css")
        link(rel="stylesheet" href="/css/layouts/superadmin.css")
        style.
            body { padding: 0 24px 80px; }
            .stats-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 28px; }
            .stat-card { background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 12px; padding: 16px 22px; min-width: 110px; }
            .stat-card__value { font-size: 26px; font-weight: 700; color: #fff; letter-spacing: -.02em; }
            .stat-card__label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: #555; margin-top: 4px; }
            .search-bar { margin-bottom: 24px; }
            .search-bar form { display: flex; gap: 10px; }
            .search-bar input { flex: 1; max-width: 340px; background: #1a1a1a; border: 1.5px solid #2a2a2a; border-radius: 10px; color: #fff; font-size: 14px; padding: 9px 14px; outline: none; }
            .search-bar input:focus { border-color: #444; }
            .search-bar button { background: #2a2a2a; border: 1px solid #333; color: #ccc; font-size: 13px; font-weight: 600; padding: 9px 18px; border-radius: 10px; cursor: pointer; }
            .est-table { width: 100%; border-collapse: collapse; background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 14px; overflow: hidden; }
            .est-table thead th { text-align: left; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: #444; padding: 12px 18px; border-bottom: 1px solid #222; background: #161616; }
            .est-table tbody tr { border-bottom: 1px solid #1f1f1f; transition: background .12s; }
            .est-table tbody tr:last-child { border-bottom: none; }
            .est-table tbody tr:hover { background: #1f1f1f; }
            .est-table td { padding: 13px 18px; font-size: 13px; color: #ccc; vertical-align: middle; }
            .est-name { font-weight: 600; color: #fff; display: flex; align-items: center; gap: 10px; }
            .est-avatar { width: 32px; height: 32px; border-radius: 8px; background: #2a2a2a; object-fit: cover; flex-shrink: 0; }
            .est-avatar--placeholder { display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: #555; width: 32px; height: 32px; border-radius: 8px; background: #222; border: 1px solid #2a2a2a; flex-shrink: 0; }
            .badge { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; padding: 3px 8px; border-radius: 5px; }
            .badge--green { color: #22c55e; background: rgba(34,197,94,.08); border: 1px solid rgba(34,197,94,.2); }
            .badge--yellow { color: #facc15; background: rgba(250,204,21,.08); border: 1px solid rgba(250,204,21,.2); }
            .badge--gray { color: #555; background: #1a1a1a; border: 1px solid #2a2a2a; }
            .badge--red { color: #f87171; background: rgba(248,113,113,.08); border: 1px solid rgba(248,113,113,.2); }
            .link-btn { font-size: 12px; color: #555; text-decoration: none; padding: 5px 10px; border: 1px solid #2a2a2a; border-radius: 7px; transition: color .15s, border-color .15s; white-space: nowrap; }
            .link-btn:hover { color: #fff; border-color: #444; }
            .owner-email { font-size: 11px; color: #555; margin-top: 2px; }
            .empty-state { text-align: center; padding: 60px 24px; color: #444; font-size: 14px; }
    body
        - var saPage = 'establishments'
        include ../../includes/sa-nav

        .sa-header(style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:32px 0 24px")
            .sa-header__left
                h1(style="font-size:22px;font-weight:700;color:#fff;letter-spacing:-.02em") 🏢 Établissements
                p(style="font-size:13px;color:#555;margin-top:4px") Tous les espaces professionnels créés sur BranShee.
            .sa-header__right
                span(style="font-size:12px;color:#555;background:#1a1a1a;border:1px solid #2a2a2a;border-radius:8px;padding:5px 12px;font-weight:600")= companies.length + ' établissements'

        - var totalRdv = companies.reduce(function(s,c){return s+c.bookingCount},0)
        - var totalPaused = companies.filter(function(c){return c.isPaused}).length
        .stats-row
            .stat-card
                .stat-card__value= companies.length
                .stat-card__label Total
            .stat-card
                .stat-card__value= companies.filter(function(c){return !c.isPaused}).length
                .stat-card__label Actifs
            .stat-card
                .stat-card__value= totalPaused
                .stat-card__label En pause
            .stat-card
                .stat-card__value= totalRdv.toLocaleString('fr-FR')
                .stat-card__label RDV total

        .search-bar
            form(method="GET" action="/superadmin/establishments")
                input(type="text" name="search" value=search placeholder="Rechercher par nom, slug, métier...")
                button(type="submit") Rechercher
                if search
                    a(href="/superadmin/establishments" style="font-size:13px;color:#555;text-decoration:none;padding:9px 12px") ✕ Effacer

        if companies.length === 0
            .empty-state Aucun établissement trouvé.
        else
            table.est-table
                thead
                    tr
                        th Établissement
                        th Propriétaire
                        th Métier
                        th RDV
                        th Statut
                        th Inscrit le
                        th Actions
                tbody
                    each c in companies
                        tr
                            td
                                .est-name
                                    if c.photo
                                        img.est-avatar(src=c.photo alt=c.name)
                                    else
                                        .est-avatar--placeholder= (c.name || '?')[0].toUpperCase()
                                    div
                                        div= c.name || '—'
                                        div(style="font-size:11px;color:#555;margin-top:2px") /#{c.slug || '—'}
                            td
                                if c.owner
                                    div(style="font-size:13px;color:#ccc;font-weight:500")= c.owner.fullName || '—'
                                    .owner-email= c.owner.email || ''
                                else
                                    span(style="color:#444") —
                            td(style="color:#888;font-size:12px")= c.businessType || '—'
                            td(style="font-weight:600;color:#fff")= c.bookingCount.toLocaleString('fr-FR')
                            td
                                if c.isPaused
                                    span.badge.badge--red En pause
                                else
                                    span.badge.badge--green Actif
                            td(style="color:#666;font-size:12px")= c.createdAt ? new Date(c.createdAt).toLocaleDateString('fr-FR') : '—'
                            td
                                a.link-btn(href='/' + c.slug target="_blank") Voir page
