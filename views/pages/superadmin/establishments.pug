extends ../../layouts/sa

block content
    -
        var palette = ['#6ee7b7', '#93c5fd', '#fcd34d', '#fca5a5', '#c4b5fd', '#f9a8d4', '#a5f3fc', '#bef264'];
        function couleurAvatar(s) {
            var n = 0;
            for (var i = 0; i < String(s).length; i++) n += String(s).charCodeAt(i);
            return palette[n % palette.length];
        }
        function jourFr(d) {
            return d ? new Date(d).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
        }
        //- Échéance exacte d'un octroi (affichée au survol du badge)
        function dateHeureFr(d) {
            return d ? new Date(d).toLocaleString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—';
        }
        var couleurPlan = { Free: '', Essentiel: 'sa-tag--blue', Pro: 'sa-tag--green', Business: 'sa-tag--violet' };
        function requete(extra) {
            var q = [];
            if (filtres.search) q.push('search=' + encodeURIComponent(filtres.search));
            if (filtres.plan !== 'tous') q.push('plan=' + filtres.plan);
            if (filtres.statut !== 'tous') q.push('statut=' + filtres.statut);
            if (filtres.tri !== 'recent') q.push('tri=' + filtres.tri);
            if (extra) q.push(extra);
            return q.length ? '?' + q.join('&') : '';
        }
        var filtreActif = filtres.search || filtres.plan !== 'tous' || filtres.statut !== 'tous';

    .sa-head
        button.sa-ico.sa-burger(type="button" data-sa-burger aria-label="Menu")
            span.material-symbols-outlined menu
        div
            h1.sa-head__title Établissements
            .sa-head__sub Le plan et la durée d'octroi se gèrent ici
        .sa-head__end
            a.sa-btn(href='/superadmin/establishments/export' + requete())
                span.material-symbols-outlined download
                span Exporter

    .sa-body
        .sa-kpis
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined storefront
                    span Établissements
                .sa-kpi__value= kpis.total.toLocaleString('fr-FR')
                .sa-kpi__delta(class=kpis.nouveaux7j ? 'sa-kpi__delta--up' : '')= '+' + kpis.nouveaux7j + ' sur 7 jours'
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined check_circle
                    span Actifs
                .sa-kpi__value= kpis.actifs.toLocaleString('fr-FR')
                .sa-kpi__delta(class=kpis.enPause ? 'sa-kpi__delta--down' : '')= kpis.enPause + ' en pause'
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined workspace_premium
                    span Payants
                .sa-kpi__value= kpis.payants.toLocaleString('fr-FR')
                .sa-kpi__delta= kpis.total ? Math.round((kpis.payants / kpis.total) * 100) + ' % du parc' : '—'
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined payments
                    span Revenu mensuel
                .sa-kpi__value= kpis.mrr.toLocaleString('fr-FR') + ' €'
                .sa-kpi__delta Estimé d'après les plans
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined event
                    span Réservations
                .sa-kpi__value= kpis.totalBookings.toLocaleString('fr-FR')
                .sa-kpi__delta(class=kpis.bookings30j ? 'sa-kpi__delta--up' : '')= kpis.bookings30j.toLocaleString('fr-FR') + ' sur 30 jours'
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined heart_broken
                    span Aucune réservation
                .sa-kpi__value= kpis.sansRdv.toLocaleString('fr-FR')
                .sa-kpi__delta Établissements à relancer
            //- Chaque octroi qui expire est un moment de conversion. Les pros
            //- sont relancés automatiquement à J-7 et J-1 (reminderScheduler),
            //- mais l'échéance doit rester visible ici.
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined hourglass_bottom
                    span Octrois à échéance
                .sa-kpi__value= kpis.octroisQuiExpirent.toLocaleString('fr-FR')
                if kpis.octroiProchain
                    .sa-kpi__delta(class=kpis.octroisUrgents ? 'sa-kpi__delta--down' : '')
                        = 'Prochain : ' + kpis.octroiProchain.nom + ' dans ' + kpis.octroiProchain.jours + ' j'
                else
                    .sa-kpi__delta Aucun octroi daté

        form.sa-toolbar(method="GET" action="/superadmin/establishments" id="formFiltres")
            label.sa-search
                span.material-symbols-outlined search
                input.sa-input(type="text" name="search" placeholder="Nom, lien ou métier…" value=filtres.search)
            select.sa-select(name="plan" data-auto)
                option(value="tous" selected=filtres.plan === 'tous') Tous les plans
                option(value="basic" selected=filtres.plan === 'basic') Free
                option(value="essentiel" selected=filtres.plan === 'essentiel') Essentiel
                option(value="pro" selected=filtres.plan === 'pro') Pro
                option(value="business" selected=filtres.plan === 'business') Business
            select.sa-select(name="statut" data-auto)
                option(value="tous" selected=filtres.statut === 'tous') Tous les statuts
                option(value="actif" selected=filtres.statut === 'actif') Actifs
                option(value="pause" selected=filtres.statut === 'pause') En pause
                option(value="supprime" selected=filtres.statut === 'supprime') Supprimés par le pro
            .sa-toolbar__end
                select.sa-select(name="tri" data-auto)
                    option(value="recent" selected=filtres.tri === 'recent') Plus récents
                    option(value="ancien" selected=filtres.tri === 'ancien') Plus anciens
                    option(value="nom" selected=filtres.tri === 'nom') Nom (A→Z)
                    option(value="rdv" selected=filtres.tri === 'rdv') Plus de réservations
                button.sa-btn(type="submit")
                    span.material-symbols-outlined filter_alt
                    span Filtrer
                if filtreActif
                    a.sa-btn(href="/superadmin/establishments")
                        span.material-symbols-outlined close
                        span Réinitialiser

        if !companies.length
            .sa-tablewrap
                .sa-empty
                    .sa-empty__ic
                        span.material-symbols-outlined storefront
                    .sa-empty__t Aucun établissement
                    .sa-empty__d= filtreActif ? 'Aucun résultat pour ces filtres.' : 'Aucun établissement configuré pour le moment.'
        else
            .sa-tablewrap
                table.sa-table.sa-table--estab
                    thead
                        tr
                            th Établissement
                            th Propriétaire
                            th Plan
                            th Octroi
                            th RDV
                            th Clients
                            th Créé le
                            th Statut
                            th(style="width:44px")
                    tbody
                        each c in companies
                            tr(
                                data-company-id=String(c._id)
                                data-name=c.displayName
                                data-slug=c.slug || ''
                                data-type=c.businessType || ''
                                data-photo=c.displayPhoto
                                data-owner-id=c.owner ? String(c.owner._id) : ''
                                data-plan=c.planKey
                                data-paused=c.isPaused ? '1' : '0'
                                data-expiry=c.trialExpiryAt || ''
                            )
                                td
                                    .sa-person
                                        if c.displayPhoto
                                            img.sa-av.js-photo(src=c.displayPhoto alt="" style="object-fit:cover")
                                        else
                                            span.sa-av(style='background:' + couleurAvatar(c.slug || c.displayName))= (c.displayName || '?')[0].toUpperCase()
                                        div
                                            .sa-person__name.js-name= c.displayName || '—'
                                            .sa-person__mail
                                                span.js-type= c.businessType || 'Métier non renseigné'
                                td
                                    if c.owner
                                        .sa-person__name(style="font-weight:500")= c.owner.fullName || '—'
                                        .sa-person__mail= c.owner.email || ''
                                    else
                                        span.sa-muted —
                                td
                                    select.sa-select.sa-select--mini.js-plan(data-plan=c.planKey)
                                        option(value="free" selected=c.planKey === 'basic') Free
                                        option(value="essentiel" selected=c.planKey === 'essentiel') Essentiel
                                        option(value="pro" selected=c.planKey === 'pro') Pro
                                        option(value="business" selected=c.planKey === 'business') Business
                                td.js-reste
                                    if c.planKey === 'basic'
                                        span.sa-muted —
                                    else if c.trialDaysLeft === null
                                        span.sa-tag Illimité
                                    else
                                        //- title = date d'échéance exacte au survol
                                        span.sa-tag(class=c.trialDaysLeft <= 3 ? 'sa-tag--red' : 'sa-tag--amber' title="Jusqu'au " + dateHeureFr(c.trialExpiryAt))= c.trialLeftLabel
                                td(style="font-weight:600")= c.bookingCount.toLocaleString('fr-FR')
                                td.sa-muted= c.clientCount.toLocaleString('fr-FR')
                                td.sa-td--date= jourFr(c.createdAt)
                                td
                                    if c.isDeleted
                                        span.sa-tag.sa-tag--red
                                            span.sa-tag__dot
                                            span Supprimé
                                    else if c.isPaused
                                        span.sa-tag.sa-tag--amber.js-statut
                                            span.sa-tag__dot
                                            span En pause
                                    else
                                        span.sa-tag.sa-tag--green.js-statut
                                            span.sa-tag__dot
                                            span Actif
                                td.sa-td--right
                                    .sa-menu
                                        button.sa-ico(type="button" data-sa-menu aria-label="Actions")
                                            span.material-symbols-outlined more_vert
                                        .sa-menu__list
                                            button.sa-menu__item(type="button" data-act="fiche")
                                                span.material-symbols-outlined info
                                                span Voir la fiche
                                            a.sa-menu__item(href='/' + (c.slug || '') target="_blank" rel="noopener")
                                                span.material-symbols-outlined open_in_new
                                                span Page publique
                                            button.sa-menu__item(type="button" data-act="modifier")
                                                span.material-symbols-outlined edit
                                                span Modifier
                                            button.sa-menu__item(type="button" data-act="duree")
                                                span.material-symbols-outlined timer
                                                span Durée d'octroi
                                            button.sa-menu__item(type="button" data-act="pause")
                                                span.material-symbols-outlined pause_circle
                                                span= c.isPaused ? 'Réactiver' : 'Mettre en pause'
                                            .sa-menu__sep
                                            if c.owner
                                                button.sa-menu__item(type="button" data-act="acces")
                                                    span.material-symbols-outlined lock_open
                                                    span Accéder au compte
                                                button.sa-menu__item(type="button" data-act="supervision")
                                                    span.material-symbols-outlined visibility
                                                    span Demander une supervision
                                                .sa-menu__sep
                                            button.sa-menu__item.sa-menu__item--danger(type="button" data-act="supprimer")
                                                span.material-symbols-outlined delete
                                                span Supprimer l'établissement

            .sa-pager
                span= resultats + ' établissement' + (resultats > 1 ? 's' : '') + ' · page ' + page + ' / ' + pages
                .sa-pager__end
                    a.sa-pager__btn(href='/superadmin/establishments' + requete('page=' + (page - 1)) class=page <= 1 ? 'is-off' : '')
                        span.material-symbols-outlined chevron_left
                    - var debut = Math.max(1, Math.min(page - 2, pages - 4))
                    - var fin = Math.min(pages, debut + 4)
                    each n in Array.from({ length: fin - debut + 1 }, function (_, i) { return debut + i })
                        a.sa-pager__btn(href='/superadmin/establishments' + requete('page=' + n) class=n === page ? 'is-current' : '')= n
                    a.sa-pager__btn(href='/superadmin/establishments' + requete('page=' + (page + 1)) class=page >= pages ? 'is-off' : '')
                        span.material-symbols-outlined chevron_right

    //- ── Fiche détaillée ───────────────────────────────────────────────────
    .sa-drawer#drawer
        .sa-drawer__overlay(data-close)
        .sa-drawer__panel
            .sa-drawer__head
                span.sa-av#dwAvatar
                div(style="min-width:0")
                    .sa-drawer__title#dwName —
                    .sa-head__sub#dwSlug
                button.sa-ico(type="button" data-close style="margin-left:auto" aria-label="Fermer")
                    span.material-symbols-outlined close
            .sa-drawer__body#dwBody
            .sa-drawer__foot
                a.sa-btn#dwVoir(href="#" target="_blank" rel="noopener")
                    span.material-symbols-outlined open_in_new
                    span Page publique
                button.sa-btn(type="button" id="dwEdit")
                    span.material-symbols-outlined edit
                    span Modifier
                button.sa-btn.sa-btn--danger(type="button" id="dwDel" style="margin-left:auto")
                    span.material-symbols-outlined delete
                    span Supprimer

    //- ── Durée d'octroi manuel ─────────────────────────────────────────────
    .sa-modal#modalDuree
        .sa-modal__overlay(data-close-duree)
        .sa-modal__box
            .sa-modal__head
                span.material-symbols-outlined timer
                span.sa-modal__title Durée d'octroi
                button.sa-ico(type="button" data-close-duree style="margin-left:auto" aria-label="Fermer")
                    span.material-symbols-outlined close
            .sa-modal__body
                .sa-head__sub Plan payant accordé à <b id="durNom" style="color:var(--sa-txt)">—</b>. Au-delà, le compte repasse en Free.
                .sa-field
                    span.sa-field__label Durée
                    select.sa-select#durChoix
                        option(value="infinite") Illimitée
                        optgroup(label="Quelques heures")
                            option(value="1h") 1 heure
                            option(value="3h") 3 heures
                            option(value="6h") 6 heures
                            option(value="12h") 12 heures
                        optgroup(label="Jours")
                            option(value="1d") 1 jour
                            option(value="3d") 3 jours
                            option(value="7d") 7 jours
                            option(value="14d") 14 jours
                            option(value="30d") 30 jours
                        optgroup(label="Mois")
                            option(value="1mo") 1 mois
                            option(value="2mo") 2 mois
                            option(value="3mo") 3 mois
                            option(value="6mo") 6 mois
                            option(value="12mo") 1 an
                        optgroup(label="Sur mesure")
                            option(value="custom") Durée personnalisée…
                            option(value="date") Jusqu'à une date précise…
                //- Durée personnalisée : un nombre + son unité
                .sa-field#durPersoBloc(style="display:none")
                    span.sa-field__label Durée personnalisée
                    div(style="display:flex;gap:8px")
                        input.sa-input#durJours(type="number" min="1" max="3650" value="30" style="flex:1 1 auto;min-width:0")
                        select.sa-select#durUnite(style="flex:0 0 130px")
                            option(value="h") heures
                            option(value="d" selected) jours
                            option(value="mo") mois
                //- Date d'expiration choisie à la main
                .sa-field#durDateBloc(style="display:none")
                    span.sa-field__label Expire le
                    input.sa-input#durDate(type="datetime-local")
                //- Récapitulatif : dit clairement quand l'accès s'arrête
                .sa-head__sub#durApercu(style="margin-top:10px") &nbsp;
            .sa-modal__foot
                button.sa-btn(type="button" data-close-duree) Annuler
                button.sa-btn.sa-btn--primary#durSave(type="button") Appliquer

    //- ── Modification de l'établissement ───────────────────────────────────
    .sa-modal#modalEdit
        .sa-modal__overlay(data-close-edit)
        .sa-modal__box
            .sa-modal__head
                span.material-symbols-outlined edit
                span.sa-modal__title Modifier l'établissement
                button.sa-ico(type="button" data-close-edit style="margin-left:auto" aria-label="Fermer")
                    span.material-symbols-outlined close
            .sa-modal__body
                .sa-field
                    span.sa-field__label Nom
                    input.sa-input#edName(type="text" placeholder="Nom de l'établissement")
                .sa-field
                    span.sa-field__label Métier / activité
                    input.sa-input#edType(type="text" placeholder="Ex. Coiffeur, Kinésithérapeute…")
                .sa-field
                    span.sa-field__label Photo
                    div(style="display:flex;align-items:center;gap:12px")
                        img#edPhoto(src="/images/no-user.webp" alt="" style="width:52px;height:52px;border-radius:12px;object-fit:cover;background:var(--sa-panel-2)")
                        div
                            input#edFile(type="file" accept="image/*" style="display:none")
                            button.sa-btn(type="button" id="edPick")
                                span.material-symbols-outlined image
                                span Choisir une image
                            .sa-head__sub(style="margin-top:5px") JPG, PNG ou WEBP — 60 Mo max
            .sa-modal__foot
                button.sa-btn(type="button" data-close-edit) Annuler
                button.sa-btn.sa-btn--primary#edSave(type="button") Enregistrer

block scripts
    script(src="/socket.io/socket.io.js")
    script(src="/js/utils/confirm-modal.js")
    script(src="/js/superadmin/establishments.js")
