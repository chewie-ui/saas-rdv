extends ../../layouts/sa

block content
    -
        var ICONES = { info: 'info', tip: 'lightbulb', success: 'check_circle', warning: 'warning', security: 'lock' };
        var COULEURS = { info: 'sa-tag--blue', tip: 'sa-tag--violet', success: 'sa-tag--green', warning: 'sa-tag--amber', security: 'sa-tag--red' };
        var diffusions = (messages || []).filter(function (m) { return m.broadcast; }).length;
        var lus = (messages || []).reduce(function (n, m) { return n + (m.readCount || 0); }, 0);

    .sa-head
        button.sa-ico.sa-burger(type="button" data-sa-burger aria-label="Menu")
            span.material-symbols-outlined menu
        div
            h1.sa-head__title Messages
            .sa-head__sub Annonces affichées directement sur le tableau de bord des pros

    .sa-body
        .sa-kpis
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined send
                    span Messages envoyés
                .sa-kpi__value= (messages || []).length
                .sa-kpi__delta= diffusions + ' diffusion(s) générale(s)'
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined group
                    span Destinataires possibles
                .sa-kpi__value= totalUsers.toLocaleString('fr-FR')
                .sa-kpi__delta Comptes sur la plateforme
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined visibility
                    span Lectures cumulées
                .sa-kpi__value= lus.toLocaleString('fr-FR')
                .sa-kpi__delta Messages ouverts puis fermés

        .sa-grid2(style="align-items:start")
            //- ── Composition ───────────────────────────────────────────────
            .sa-card
                .sa-card__t Nouveau message
                .sa-choice
                    button.sa-choice__btn.is-on(type="button" data-mode="broadcast")
                        span.material-symbols-outlined campaign
                        span À tous les pros
                    button.sa-choice__btn(type="button" data-mode="targeted")
                        span.material-symbols-outlined person
                        span Un utilisateur

                .sa-field#champDestinataire(style="margin-top:14px;display:none")
                    span.sa-field__label Email du destinataire
                    input.sa-input#recipientEmail(type="text" list="userEmails" placeholder="ex. cecile@exemple.com")
                    datalist#userEmails
                        if userList
                            each u in userList
                                option(value=u.email)= (u.fullName ? u.fullName + ' — ' : '') + u.email

                .sa-field(style="margin-top:14px")
                    span.sa-field__label Tonalité
                    div(style="display:flex;flex-wrap:wrap;gap:6px" id="tonalites")
                        button.sa-btn.sa-btn--primary(type="button" data-type="info") Info
                        button.sa-btn(type="button" data-type="tip") Conseil
                        button.sa-btn(type="button" data-type="success") Succès
                        button.sa-btn(type="button" data-type="warning") Avertissement
                        button.sa-btn(type="button" data-type="security") Sécurité

                .sa-field(style="margin-top:14px")
                    span.sa-field__label Titre
                    input.sa-input#msgTitle(type="text" maxlength="140" placeholder="ex. Sécurisez votre compte")
                .sa-field(style="margin-top:14px")
                    span.sa-field__label Message
                    textarea.sa-textarea#msgBody(maxlength="4000" placeholder="Bonjour, nous vous conseillons d'activer la double authentification…")
                .sa-grid2(style="margin-top:14px")
                    .sa-field
                        span.sa-field__label Bouton — texte
                        input.sa-input#ctaLabel(type="text" maxlength="60" placeholder="ex. Sécuriser mon compte")
                    .sa-field
                        span.sa-field__label Bouton — lien
                        input.sa-input#ctaUrl(type="text" maxlength="500" placeholder="/account")
                button.sa-btn.sa-btn--primary#sendBtn(type="button" style="margin-top:18px;width:100%;justify-content:center")
                    span.material-symbols-outlined send
                    span Envoyer le message

            //- ── Aperçu ────────────────────────────────────────────────────
            .sa-card
                .sa-card__t Aperçu — ce que verra le pro
                .sa-preview#apercu
                    span.sa-preview__ic#pvIcone
                        span.material-symbols-outlined info
                    div(style="flex:1;min-width:0")
                        .sa-preview__from#pvFrom Message de BranShee
                        .sa-preview__title#pvTitre Titre du message
                        .sa-preview__text#pvTexte Le contenu de votre message apparaîtra ici.
                        .sa-preview__cta#pvCta(style="display:none") Bouton →
                .sa-head__sub(style="margin-top:12px") Le message reste sur le tableau de bord jusqu'à ce que le pro le ferme.

        //- ── Historique ────────────────────────────────────────────────────
        .sa-card(style="margin-top:20px")
            .sa-card__t Historique des envois
            if !messages || !messages.length
                .sa-empty(style="padding:40px 20px")
                    .sa-empty__t Aucun message envoyé
                    .sa-empty__d Les envois apparaîtront ici avec leur taux de lecture.
            else
                each m in messages
                    .sa-histo(data-id=String(m._id))
                        span.sa-histo__ic(class=COULEURS[m.type] || '')
                            span.material-symbols-outlined= ICONES[m.type] || 'info'
                        .sa-histo__txt
                            .sa-histo__top
                                if m.broadcast
                                    span.sa-tag.sa-tag--blue Tous les pros
                                else if m.recipient
                                    span.sa-tag= m.recipient.fullName || m.recipient.email
                                else
                                    span.sa-tag.sa-tag--red Destinataire supprimé
                                span(style="font-weight:600")= m.title
                            .sa-histo__body= m.body
                            .sa-head__sub
                                = new Date(m.createdAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })
                                if m.broadcast
                                    = ' · ' + m.readCount + ' lu' + (m.readCount > 1 ? 's' : '') + ' sur ' + totalUsers
                                else
                                    = m.readCount ? ' · Lu' : ' · Non lu'
                        button.sa-ico.sa-ico--danger.js-del(type="button" title="Supprimer" data-id=String(m._id))
                            span.material-symbols-outlined delete

block scripts
    script(src="/js/utils/confirm-modal.js")
    script(src="/js/superadmin/messages.js")
