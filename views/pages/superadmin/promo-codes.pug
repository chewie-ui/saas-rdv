extends ../../layouts/sa

block content
    -
        var PLANS = {
            all: 'Tous les plans',
            pro_monthly: 'Pro · mensuel',
            pro_yearly: 'Pro · annuel',
            business_monthly: 'Business · mensuel',
            business_yearly: 'Business · annuel',
            premium_monthly: 'Pro · mensuel',
            premium_yearly: 'Pro · annuel',
        };
        var actifs = codes.filter(function (c) { return c.active; }).length;
        var utilisations = codes.reduce(function (n, c) { return n + (c.usedCount || 0); }, 0);
        var epuises = codes.filter(function (c) { return c.maxUses !== null && c.usedCount >= c.maxUses; }).length;

    .sa-head
        button.sa-ico.sa-burger(type="button" data-sa-burger aria-label="Menu")
            span.material-symbols-outlined menu
        div
            h1.sa-head__title Codes promo
            .sa-head__sub Essais gratuits et réductions appliqués à l'inscription
        .sa-head__end
            button.sa-btn.sa-btn--primary#btnNouveau(type="button")
                span.material-symbols-outlined add
                span Nouveau code

    .sa-body
        //- ── Campagne de lancement ────────────────────────────────────────
        //- À distinguer des codes ci-dessous : une campagne s'applique d'office
        //- à tous les éligibles, sans rien à saisir, et s'annonce avec un compte
        //- à rebours sur les pages publiques.
        form.sa-box#formCampagne(style="margin-bottom:22px")
            .sa-head__sub(style="margin-bottom:14px;font-weight:600") Campagne de lancement (offre automatique)
            .sa-grid(style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;align-items:end")
                label.ds-field
                    span.ds-label Active
                    select.ds-select(name="active")
                        option(value="0" selected=!campagne || !campagne.active) Non
                        option(value="1" selected=campagne && campagne.active) Oui
                label.ds-field
                    span.ds-label Prix 1re période (€)
                    input.ds-input(type="number" name="prixEuros" step="0.01" min="0" value=campagne ? (campagne.firstPeriodCents / 100) : 1)
                label.ds-field
                    span.ds-label Durée annoncée (jours)
                    input.ds-input(type="number" name="days" min="1" max="365" value=campagne ? campagne.days : 30)
                label.ds-field
                    span.ds-label Forfait
                    select.ds-select(name="plan")
                        option(value="pro" selected=!campagne || campagne.plan === 'pro') Pro (mensuel)
                        option(value="business" selected=campagne && campagne.plan === 'business') Pro+ (mensuel)
                label.ds-field
                    span.ds-label Fin de l'offre
                    input.ds-input(type="datetime-local" name="endsAt" value=campagneEndsLocal || '')
                button.sa-btn.sa-btn--primary(type="submit")
                    span.material-symbols-outlined save
                    span Enregistrer
            p.ds-help#campagneEtat(style="margin-top:12px")
                if campagne && campagne.active && campagne.endsAt && new Date(campagne.endsAt) > new Date()
                    | En cours — se termine le #{new Date(campagne.endsAt).toLocaleString('fr-BE')}. Le bandeau et le compte à rebours sont affichés sur l'accueil, /tarifs et la page Abonnement ; la landing pro et l'inscription en reprennent le tarif.
                else if campagne && campagne.active
                    | Active mais sans date de fin valable : aucun compte à rebours n'est affiché, et une date passée éteint l'offre.
                else
                    | Éteinte — les pages publiques n'annoncent aucune promo et le tunnel de paiement applique le plein tarif.

        .sa-kpis
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined confirmation_number
                    span Codes
                .sa-kpi__value= codes.length
                .sa-kpi__delta= actifs + ' actif(s)'
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined redeem
                    span Utilisations
                .sa-kpi__value= utilisations.toLocaleString('fr-FR')
                .sa-kpi__delta Toutes périodes confondues
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined block
                    span Épuisés
                .sa-kpi__value= epuises
                .sa-kpi__delta Quota d'utilisations atteint

        .sa-alerte
            span.material-symbols-outlined lightbulb
            div
                | <b>Essai gratuit</b> = essai Stripe : le client saisit sa carte, ne paie rien pendant X jours, puis est débité automatiquement. Identique en mensuel et en annuel.
                br
                | <b>Réduction % ou €</b> = uniquement sur la première facture. Évitez −100 % sur un plan annuel, cela offrirait l'année entière.

        if !codes.length
            .sa-tablewrap
                .sa-empty
                    .sa-empty__ic
                        span.material-symbols-outlined confirmation_number
                    .sa-empty__t Aucun code promo
                    .sa-empty__d Créez-en un pour offrir un essai ou une réduction.
        else
            .sa-tablewrap
                table.sa-table
                    thead
                        tr
                            th Code
                            th Avantage
                            th Plan concerné
                            th Utilisations
                            th Expiration
                            th Offre par défaut
                            th Actif
                            th(style="width:44px")
                    tbody
                        each c in codes
                            tr(data-id=String(c._id))
                                td
                                    .sa-code
                                        span.sa-mono(style="font-weight:700;font-size:13px")= c.code
                                        button.sa-ico.js-copier(type="button" title="Copier le lien d'invitation" data-code=c.code)
                                            span.material-symbols-outlined content_copy
                                td
                                    if c.discountType === 'trial'
                                        span.sa-tag.sa-tag--green= (c.trialDays || 30) + ' jours offerts'
                                    else if c.discountType === 'percent'
                                        span.sa-tag.sa-tag--blue= '−' + c.discountValue + ' % (1ʳᵉ facture)'
                                    else
                                        span.sa-tag.sa-tag--blue= '−' + c.discountValue + ' € (1ʳᵉ facture)'
                                td
                                    span.sa-tag(class=c.applicablePlan && c.applicablePlan !== 'all' ? 'sa-tag--violet' : '')= PLANS[c.applicablePlan || 'all'] || c.applicablePlan
                                td
                                    span(style="font-weight:600")= c.usedCount
                                    span.sa-muted= c.maxUses !== null ? ' / ' + c.maxUses : ' / ∞'
                                td.sa-td--date= c.expiresAt ? new Date(c.expiresAt).toLocaleDateString('fr-FR') : '—'
                                td
                                    button.sa-ico.js-offre(
                                        type="button"
                                        class=c.isDefaultOffer ? 'is-on' : ''
                                        data-id=String(c._id)
                                        title=c.isDefaultOffer ? "Retirer de l'offre par défaut" : "Définir comme offre par défaut"
                                    )
                                        span.material-symbols-outlined star
                                td
                                    label.sa-switch
                                        input.js-actif(type="checkbox" checked=c.active data-id=String(c._id))
                                        span.sa-switch__track
                                td.sa-td--right
                                    button.sa-ico.sa-ico--danger.js-suppr(type="button" title="Supprimer" data-id=String(c._id) data-code=c.code)
                                        span.material-symbols-outlined delete

    //- ── Création ──────────────────────────────────────────────────────────
    .sa-modal#modalNouveau
        .sa-modal__overlay(data-fermer)
        .sa-modal__box
            .sa-modal__head
                span.material-symbols-outlined confirmation_number
                span.sa-modal__title Nouveau code promo
                button.sa-ico(type="button" data-fermer style="margin-left:auto" aria-label="Fermer")
                    span.material-symbols-outlined close
            .sa-modal__body
                .sa-field
                    span.sa-field__label Code
                    input.sa-input#newCode(type="text" placeholder="BIENVENUE30" style="text-transform:uppercase")
                .sa-field
                    span.sa-field__label Type d'avantage
                    select.sa-select#newType
                        option(value="trial") Essai gratuit — X jours offerts puis plein tarif
                        option(value="percent") Réduction en % sur la 1ʳᵉ facture
                        option(value="fixed") Réduction en € sur la 1ʳᵉ facture
                .sa-field#champJours
                    span.sa-field__label Jours d'essai
                    input.sa-input#newTrialDays(type="number" value="30" min="1" max="365")
                    .sa-head__sub 30 = un mois offert · 7 = une semaine
                .sa-field#champValeur(style="display:none")
                    span.sa-field__label Valeur de la réduction
                    input.sa-input#newValue(type="number" min="0" step="0.01" placeholder="20")
                .sa-grid2
                    .sa-field
                        span.sa-field__label Utilisations maximum
                        input.sa-input#newMaxUses(type="number" min="1" placeholder="Vide = illimité")
                    .sa-field
                        span.sa-field__label Expiration
                        input.sa-input#newExpiresAt(type="date")
                .sa-field
                    span.sa-field__label Plan concerné
                    select.sa-select#newApplicablePlan
                        option(value="all") Tous les plans
                        option(value="pro_monthly") Pro · mensuel
                        option(value="pro_yearly") Pro · annuel
                        option(value="business_monthly") Business · mensuel
                        option(value="business_yearly") Business · annuel
            .sa-modal__foot
                button.sa-btn(type="button" data-fermer) Annuler
                button.sa-btn.sa-btn--primary#btnCreer(type="button") Créer le code

block scripts
    script(src="/js/utils/confirm-modal.js")
    script(src="/js/superadmin/promo-codes.js")
