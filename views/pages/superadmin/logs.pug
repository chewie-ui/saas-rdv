doctype html
html(lang="fr")
    head
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(charset="UTF-8")
        title Superadmin — Logs
        link(rel="shortcut icon" href="/images/icon.svg" type="image/x-icon")
        link(rel="stylesheet" href="/css/import.css")
        link(rel="stylesheet" href="/css/layouts/superadmin.css")
        style.
            body { padding: 0 24px 80px; }
            .page-header { margin-top: 32px; margin-bottom: 24px; }
            .page-header h1 { font-size: 22px; font-weight: 700; color: #fff; letter-spacing: -.02em; }
            .page-header p { font-size: 13px; color: #555; margin-top: 4px; }

            /* Filter bar */
            .log-filters { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
            .log-filter-btn { font-size: 12px; padding: 5px 12px; border-radius: 7px; border: 1px solid #2a2a2a; background: transparent; color: #666; cursor: pointer; transition: color .13s, border-color .13s, background .13s; }
            .log-filter-btn:hover, .log-filter-btn.active { color: #fff; border-color: #444; background: #1a1a1a; }

            /* Log list */
            .log-list { display: flex; flex-direction: column; gap: 2px; }
            .log-item { display: flex; align-items: flex-start; gap: 12px; padding: 10px 14px; border-radius: 10px; transition: background .1s; cursor: default; }
            .log-item:hover { background: #141414; }
            .log-item__icon { font-size: 15px; flex-shrink: 0; margin-top: 1px; line-height: 1; }
            .log-item__body { flex: 1; min-width: 0; }
            .log-item__label { font-size: 13px; color: #ccc; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
            .log-item__detail { font-size: 11.5px; color: #555; margin-top: 2px; }
            .log-item__meta { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
            .log-item__time { font-size: 11px; color: #444; white-space: nowrap; }
            .log-badge { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; padding: 2px 7px; border-radius: 5px; }
            .log-badge--register { color: #60a5fa; background: rgba(96,165,250,.1); border: 1px solid rgba(96,165,250,.2); }
            .log-badge--booking  { color: #a78bfa; background: rgba(167,139,250,.1); border: 1px solid rgba(167,139,250,.2); }
            .log-badge--premium  { color: #22c55e; background: rgba(34,197,94,.1);  border: 1px solid rgba(34,197,94,.2);  }
            .log-badge--login    { color: #facc15; background: rgba(250,204,21,.1); border: 1px solid rgba(250,204,21,.2); }
            .log-badge--subscription { color: #22c55e; background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.25); }
            .log-badge--payment  { color: #34d399; background: rgba(52,211,153,.1); border: 1px solid rgba(52,211,153,.25); }
            .log-badge--access   { color: #f472b6; background: rgba(244,114,182,.1); border: 1px solid rgba(244,114,182,.25); }

            .log-empty { text-align: center; padding: 60px 24px; color: #444; font-size: 14px; }

            /* Search */
            .log-search { position: relative; margin-bottom: 16px; }
            .log-search__input { width: 100%; max-width: 420px; background: #141414; border: 1px solid #2a2a2a; border-radius: 10px; color: #e0e0e0; font-size: 13px; padding: 9px 14px 9px 36px; outline: none; transition: border-color .15s; font-family: inherit; }
            .log-search__input:focus { border-color: #444; }
            .log-search__icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); fill: #555; pointer-events: none; }
    body
        - var saPage = 'logs'
        include ../../includes/sa-nav

        .page-header
            h1 📊 Logs
            p Activité récente sur la plateforme — inscriptions, réservations, achats.

        .log-search
            svg.log-search__icon(xmlns="http://www.w3.org/2000/svg" height="15px" viewBox="0 -960 960 960" width="15px")
                path(d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z")
            input.log-search__input#logSearch(type="text" placeholder="Rechercher par nom, email..." autocomplete="off")

        .log-filters
            button.log-filter-btn.active(data-filter="all") Tout
            button.log-filter-btn(data-filter="register") 👤 Inscriptions
            button.log-filter-btn(data-filter="login") 🔑 Connexions
            button.log-filter-btn(data-filter="booking") 📅 Réservations
            button.log-filter-btn(data-filter="subscription") ⭐ Abonnements
            button.log-filter-btn(data-filter="payment") 💰 Paiements
            button.log-filter-btn(data-filter="access") 🎟 Accès

        if events && events.length
            .log-list#logList
                each ev in events
                    - var dt = new Date(ev.date)
                    - var dateStr = dt.toLocaleDateString('fr-FR', {day:'2-digit', month:'short', year:'numeric'}) + ' ' + dt.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'})
                    .log-item(data-type=ev.type data-search=((ev.label || '') + ' ' + (ev.detail || '')).toLowerCase())
                        .log-item__icon= ev.icon
                        .log-item__body
                            .log-item__label= ev.label
                            if ev.detail
                                .log-item__detail= ev.detail
                        .log-item__meta
                            if ev.type === 'register'
                                if ev.plan && ev.plan !== 'basic'
                                    span.log-badge.log-badge--premium= ev.plan
                                else
                                    span.log-badge.log-badge--register inscription
                            else if ev.type === 'booking'
                                span.log-badge.log-badge--booking(class=ev.status === 'canceled' || ev.status === 'cancelled' ? 'log-badge--canceled' : '') #{ev.status || 'confirmé'}
                            else if ev.type === 'login'
                                span.log-badge.log-badge--login connexion
                            else if ev.type === 'subscription'
                                span.log-badge.log-badge--subscription= ev.plan || 'abonnement'
                            else if ev.type === 'payment'
                                span.log-badge.log-badge--payment paiement
                            else if ev.type === 'access'
                                span.log-badge.log-badge--access accès
                            span.log-item__time= dateStr
        else
            .log-empty Aucune activité enregistrée.

        script.
            // Filter buttons
            var btns = document.querySelectorAll('.log-filter-btn');
            var items = document.querySelectorAll('.log-item');
            var searchInput = document.getElementById('logSearch');
            var currentFilter = 'all';
            var currentSearch = '';

            function applyFilters() {
                items.forEach(function(item) {
                    var typeMatch = currentFilter === 'all' || item.dataset.type === currentFilter;
                    var searchMatch = !currentSearch || (item.dataset.search || '').includes(currentSearch);
                    item.style.display = (typeMatch && searchMatch) ? '' : 'none';
                });
            }

            btns.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    btns.forEach(function(b) { b.classList.remove('active'); });
                    btn.classList.add('active');
                    currentFilter = btn.dataset.filter;
                    applyFilters();
                });
            });

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    currentSearch = searchInput.value.toLowerCase().trim();
                    applyFilters();
                });
            }
