extends ../../layouts/sa

block content
    -
        //- Icône et couleur par type d'événement (Material Symbols, cf. CONVENTIONS.md)
        var ICONES = {
            register: 'person_add',
            login: 'login',
            booking: 'event',
            subscription: 'workspace_premium',
            payment: 'payments',
            access: 'confirmation_number',
        };
        var COULEURS = {
            register: 'sa-tag--blue',
            login: 'sa-tag--amber',
            booking: 'sa-tag--violet',
            subscription: 'sa-tag--green',
            payment: 'sa-tag--green',
            access: 'sa-tag--blue',
        };
        var LIBELLES = {
            register: 'inscription',
            login: 'connexion',
            booking: 'réservation',
            subscription: 'abonnement',
            payment: 'paiement',
            access: 'accès',
        };
        //- Certains événements n'ont pas de date exploitable (lien d'accès activé
        //- avant que l'on enregistre `usedAt`, paiement sans `paidAt`) : on les
        //- regroupe sous « Date inconnue » plutôt que de casser le rendu.
        function dateValide(d) {
            var date = new Date(d);
            return d && !isNaN(date.getTime()) ? date : null;
        }
        //- Les statuts sont stockés en anglais en base ; l'interface est en français.
        var STATUTS_RDV = {
            confirmed: 'confirmé',
            pending: 'en attente',
            canceled: 'annulé',
            cancelled: 'annulé',
            completed: 'terminé',
            noshow: 'absent',
        };
        function jourCle(d) {
            var date = dateValide(d);
            return date ? date.toISOString().slice(0, 10) : 'inconnu';
        }
        function jourTitre(d) {
            var date = dateValide(d);
            if (!date) return 'Date inconnue';
            var auj = new Date(); auj.setHours(0, 0, 0, 0);
            var hier = new Date(auj.getTime() - 86400000);
            var j = new Date(date); j.setHours(0, 0, 0, 0);
            if (j.getTime() === auj.getTime()) return "Aujourd'hui";
            if (j.getTime() === hier.getTime()) return 'Hier';
            return date.toLocaleDateString('fr-FR', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' });
        }

    .sa-head
        button.sa-ico.sa-burger(type="button" data-sa-burger aria-label="Menu")
            span.material-symbols-outlined menu
        div
            h1.sa-head__title Activité
            .sa-head__sub Inscriptions, connexions, réservations, abonnements et paiements
        .sa-head__end
            button.sa-btn(type="button" onclick="location.reload()")
                span.material-symbols-outlined refresh
                span Actualiser

    .sa-body
        .sa-kpis
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined login
                    span Connexions (24 h)
                .sa-kpi__value= kpis.connexions24h.toLocaleString('fr-FR')
                .sa-kpi__delta Sessions ouvertes
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined person_add
                    span Inscriptions (7 j)
                .sa-kpi__value= kpis.inscrits7j.toLocaleString('fr-FR')
                .sa-kpi__delta Nouveaux comptes
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined event
                    span Réservations (7 j)
                .sa-kpi__value= kpis.rdv7j.toLocaleString('fr-FR')
                .sa-kpi__delta Sur toute la plateforme
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined payments
                    span Encaissé (7 j)
                .sa-kpi__value= kpis.encaisse7j.toLocaleString('fr-FR') + ' €'
                .sa-kpi__delta Paiements clients en ligne

        .sa-toolbar
            label.sa-search
                span.material-symbols-outlined search
                input.sa-input#recherche(type="text" placeholder="Nom, email, établissement…" autocomplete="off")
            select.sa-select#filtreType(style="width:auto;min-width:150px")
                option(value="all") Tous les types
                option(value="register") Inscriptions
                option(value="login") Connexions
                option(value="booking") Réservations
                option(value="subscription") Abonnements
                option(value="payment") Paiements
                option(value="access") Accès
            select.sa-select#filtrePeriode(style="width:auto;min-width:150px")
                option(value="all") Depuis le début
                option(value="1") Dernières 24 h
                option(value="7") 7 derniers jours
                option(value="30") 30 derniers jours
            .sa-toolbar__end
                span.sa-head__sub#compteur= events.length + ' événements'

        if !events.length
            .sa-empty
                .sa-empty__ic
                    span.material-symbols-outlined monitoring
                .sa-empty__t Aucune activité
                .sa-empty__d Rien n'a encore été enregistré sur la plateforme.
        else
            .sa-feed#flux
                - var jourPrecedent = null
                each ev in events
                    - var cle = jourCle(ev.date)
                    if cle !== jourPrecedent
                        - jourPrecedent = cle
                        .sa-feed__day(data-jour=cle)= jourTitre(ev.date)
                    - var dt = dateValide(ev.date)
                    .sa-feed__row(
                        data-type=ev.type
                        data-date=dt ? dt.toISOString() : ''
                        data-search=((ev.label || '') + ' ' + (ev.detail || '')).toLowerCase()
                    )
                        span.sa-feed__ic(class=COULEURS[ev.type] || '')
                            span.material-symbols-outlined= ICONES[ev.type] || 'circle'
                        .sa-feed__txt
                            .sa-feed__label= ev.label
                            if ev.detail
                                .sa-feed__detail= ev.detail
                        .sa-feed__end
                            if ev.type === 'register' && ev.plan && ev.plan !== 'basic'
                                span.sa-tag.sa-tag--green= ev.plan
                            else if ev.type === 'booking'
                                span.sa-tag(class=(ev.status === 'canceled' || ev.status === 'cancelled') ? 'sa-tag--red' : 'sa-tag--violet')= STATUTS_RDV[ev.status] || 'confirmé'
                            else if ev.type === 'subscription'
                                span.sa-tag.sa-tag--green= ev.plan || 'abonnement'
                            else
                                span.sa-tag(class=COULEURS[ev.type] || '')= LIBELLES[ev.type] || ev.type
                            span.sa-feed__time= dt ? dt.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) : '—'

            .sa-empty#aucunResultat(style="display:none")
                .sa-empty__ic
                    span.material-symbols-outlined search_off
                .sa-empty__t Aucun résultat
                .sa-empty__d Aucun événement ne correspond à ces filtres.

block scripts
    script.
        (function () {
            var lignes = Array.prototype.slice.call(document.querySelectorAll('.sa-feed__row'));
            var jours = Array.prototype.slice.call(document.querySelectorAll('.sa-feed__day'));
            var recherche = document.getElementById('recherche');
            var type = document.getElementById('filtreType');
            var periode = document.getElementById('filtrePeriode');
            var compteur = document.getElementById('compteur');
            var vide = document.getElementById('aucunResultat');
            if (!lignes.length) return;

            function appliquer() {
                var texte = recherche.value.toLowerCase().trim();
                var seuil = periode.value === 'all' ? 0 : Date.now() - Number(periode.value) * 86400000;
                var visibles = 0;

                lignes.forEach(function (l) {
                    var ok = (type.value === 'all' || l.dataset.type === type.value)
                        && (!texte || (l.dataset.search || '').indexOf(texte) !== -1)
                        && (!seuil || new Date(l.dataset.date).getTime() >= seuil);
                    l.style.display = ok ? '' : 'none';
                    if (ok) visibles++;
                });

                // Un intitulé de journée n'a de sens que s'il reste une ligne dessous.
                jours.forEach(function (titre) {
                    var reste = false;
                    var n = titre.nextElementSibling;
                    while (n && !n.classList.contains('sa-feed__day')) {
                        if (n.style.display !== 'none') { reste = true; break; }
                        n = n.nextElementSibling;
                    }
                    titre.style.display = reste ? '' : 'none';
                });

                compteur.textContent = visibles + ' événement' + (visibles > 1 ? 's' : '');
                vide.style.display = visibles ? 'none' : '';
            }

            recherche.addEventListener('input', appliquer);
            type.addEventListener('change', appliquer);
            periode.addEventListener('change', appliquer);
        })();
