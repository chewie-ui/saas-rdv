doctype html
html(lang="fr")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Superadmin — BranShee
        link(rel="shortcut icon" href="/favicon.ico")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
        link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap")
        link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block")
        link(rel="stylesheet" href="/css/layouts/superadmin-v2.css")
        style(type="text/css").
            /* Page de connexion : la coque du panel ne s'applique pas ici. */
            .sa-login { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
            .sa-login__box {
              width: 100%; max-width: 380px; padding: 30px 28px;
              border: 1px solid var(--sa-line); border-radius: 18px;
              background: var(--sa-panel); box-shadow: var(--sa-shadow);
            }
            .sa-login__mark {
              display: inline-flex; align-items: center; justify-content: center;
              width: 42px; height: 42px; margin-bottom: 16px; border-radius: 13px;
              background: linear-gradient(135deg, var(--sa-accent), #15803d); color: #04120a;
            }
            .sa-login__mark .material-symbols-outlined { font-size: 23px; }
            .sa-login__title { margin: 0; font-size: 19px; font-weight: 800; letter-spacing: -.02em; }
            .sa-login__sub { margin: 5px 0 22px; font-size: 13px; color: var(--sa-txt-3); }
            .sa-login .sa-input { height: 42px; }
            .sa-login__btn { width: 100%; height: 42px; justify-content: center; margin-top: 16px; }
            .sa-login__err {
              display: flex; align-items: center; gap: 8px; margin-bottom: 14px;
              padding: 10px 13px; border-radius: var(--sa-r);
              background: var(--sa-red-soft); color: #fca5a5; font-size: 13px; font-weight: 600;
            }
            .sa-login__err .material-symbols-outlined { font-size: 18px; }
    body.sa
        .sa-login
            .sa-login__box
                span.sa-login__mark
                    span.material-symbols-outlined shield_person
                h1.sa-login__title Accès superadmin
                p.sa-login__sub Zone réservée à l'administrateur de BranShee.

                .sa-login__err#superadminError(style=error ? '' : 'display:none')
                    span.material-symbols-outlined error
                    span#superadminErrorText= error || ''

                form#superadminForm(method="POST" action="/superadmin/login")
                    .sa-field
                        span.sa-field__label Mot de passe
                        input.sa-input(type="password" name="secret" placeholder="••••••••••" autofocus required)
                    button.sa-btn.sa-btn--primary.sa-login__btn#superadminBtn(type="submit") Connexion

        script.
            (function () {
                var form = document.getElementById('superadminForm');
                var boite = document.getElementById('superadminError');
                var texte = document.getElementById('superadminErrorText');
                var bouton = document.getElementById('superadminBtn');

                function erreur(message) {
                    texte.textContent = message;
                    boite.style.display = '';
                }

                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    boite.style.display = 'none';
                    bouton.disabled = true;
                    bouton.textContent = 'Connexion…';

                    fetch('/superadmin/login', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'fetch'
                        },
                        body: new URLSearchParams(new FormData(form)).toString()
                    })
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            if (d.success) {
                                location.href = d.redirect || '/superadmin';
                                return;
                            }
                            erreur(d.error || 'Une erreur est survenue.');
                            bouton.disabled = false;
                            bouton.textContent = 'Connexion';
                        })
                        .catch(function () {
                            erreur('Erreur réseau. Veuillez réessayer.');
                            bouton.disabled = false;
                            bouton.textContent = 'Connexion';
                        });
                });
            })();
