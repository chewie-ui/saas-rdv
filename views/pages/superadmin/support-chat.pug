extends ../../layouts/sa

block content
    -
        var palette = ['#6ee7b7', '#93c5fd', '#fcd34d', '#fca5a5', '#c4b5fd', '#f9a8d4', '#a5f3fc', '#bef264'];
        function couleurAvatar(s) {
            var n = 0;
            for (var i = 0; i < String(s).length; i++) n += String(s).charCodeAt(i);
            return palette[n % palette.length];
        }
        function initiale(s) { return String(s || '?').trim().charAt(0).toUpperCase() || '?'; }
        var nonLus = (chats || []).reduce(function (n, c) { return n + (c.unreadByAdmin || 0); }, 0);

    .sa-head
        button.sa-ico.sa-burger(type="button" data-sa-burger aria-label="Menu")
            span.material-symbols-outlined menu
        div
            h1.sa-head__title Chat support
            .sa-head__sub= (chats || []).length + ' conversation' + ((chats || []).length > 1 ? 's' : '') + (nonLus ? ' · ' + nonLus + ' message(s) non lu(s)' : '')

    .sa-body.sa-body--full
        .sa-chat
            .sa-chat__side
                label.sa-search(style="max-width:none;flex:0 0 auto")
                    span.material-symbols-outlined search
                    input.sa-input#chatSearch(type="text" placeholder="Rechercher un utilisateur…")
                .sa-chat__list#chatList
                    if !chats || !chats.length
                        .sa-chat__empty Aucune conversation pour le moment.
                    else
                        each c in chats
                            - var titre = c.businessName || c.email || 'Utilisateur'
                            - var dernier = c.messages && c.messages.length ? c.messages[c.messages.length - 1] : null
                            .sa-chat__item(
                                data-user-id=String(c.user)
                                data-name=titre
                                data-email=c.email || ''
                            )
                                span.sa-av(style='background:' + couleurAvatar(c.email || titre))= initiale(titre)
                                .sa-chat__item-txt
                                    .sa-chat__item-top
                                        span.sa-chat__item-name= titre
                                        if c.unreadByAdmin > 0
                                            span.sa-chat__unread= c.unreadByAdmin
                                        else if c.lastMessageAt
                                            span.sa-chat__item-time= new Date(c.lastMessageAt).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' })
                                    .sa-chat__item-prev= dernier ? (dernier.sender === 'admin' ? 'Vous : ' : '') + dernier.text : '—'

            .sa-chat__panel#chatPanel
                .sa-chat__vide
                    .sa-empty
                        .sa-empty__ic
                            span.material-symbols-outlined forum
                        .sa-empty__t Aucune conversation ouverte
                        .sa-empty__d Choisissez un utilisateur dans la liste de gauche.

block scripts
    script(src="/socket.io/socket.io.js")
    script(src="/js/utils/confirm-modal.js")
    script(src="/js/superadmin/support-chat.js")
