extends ../../layouts/sa

block content
    -
        var palette = ['#6ee7b7', '#93c5fd', '#fcd34d', '#fca5a5', '#c4b5fd', '#f9a8d4', '#a5f3fc', '#bef264'];
        function couleurAvatar(s) {
            var n = 0;
            for (var i = 0; i < String(s).length; i++) n += String(s).charCodeAt(i);
            return palette[n % palette.length];
        }
        //- Les mis en avant d'abord, dans l'ordre d'affichage réel de l'accueil.
        var enAvant = companies.filter(function (c) { return (c.boostPosition || 0) > 0; })
                               .sort(function (a, b) { return a.boostPosition - b.boostPosition; });
        var autres = companies.filter(function (c) { return !(c.boostPosition || 0); });
        var liste = enAvant.concat(autres);

    .sa-head
        button.sa-ico.sa-burger(type="button" data-sa-burger aria-label="Menu")
            span.material-symbols-outlined menu
        div
            h1.sa-head__title Mise en avant
            .sa-head__sub Ordre des établissements affichés en tête de l'accueil

    .sa-body
        .sa-kpis
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined trending_up
                    span Mis en avant
                .sa-kpi__value= enAvant.length
                .sa-kpi__delta= 'sur ' + companies.length + ' établissements'
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined looks_one
                    span Première place
                .sa-kpi__value(style="font-size:17px;line-height:1.5")= enAvant.length ? (enAvant[0].name || (enAvant[0].owner && (enAvant[0].owner.businessName || enAvant[0].owner.fullName)) || 'Sans nom') : '—'
                .sa-kpi__delta Tout en haut de l'accueil

        .sa-alerte
            span.material-symbols-outlined lightbulb
            div
                | Une position supérieure à 0 place l'établissement avant les pros payants et les comptes gratuits. <b>Position 1 = tout en haut.</b> À position égale, l'ordre est alphabétique. Mettez <b>0</b> pour retirer la mise en avant.

        .sa-toolbar
            label.sa-search
                span.material-symbols-outlined search
                input.sa-input#recherche(type="text" placeholder="Nom, métier ou ville…")
            .sa-toolbar__end
                span.sa-head__sub#compteur= companies.length + ' établissements'

        .sa-tablewrap
            table.sa-table
                thead
                    tr
                        th Établissement
                        th Lien public
                        th Statut
                        th(style="width:210px") Position
                tbody
                    each c in liste
                        //- Établissement d'abord, compte propriétaire en repli.
                        - var nom = c.name || (c.owner && (c.owner.businessName || c.owner.fullName)) || 'Sans nom'
                        - var metier = c.businessType || (c.owner && c.owner.businessType) || ''
                        - var ville = (c.owner && c.owner.location && c.owner.location.city) || ''
                        - var photo = c.photo || (c.owner && (c.owner.businessPicture || c.owner.profilePicture)) || null
                        - var slug = c.slug || String(c._id)
                        - var pos = c.boostPosition || 0
                        tr(
                            data-company-id=String(c._id)
                            data-search=(nom + ' ' + metier + ' ' + ville).toLowerCase()
                            class=pos > 0 ? 'is-selected' : ''
                        )
                            td
                                .sa-person
                                    if photo
                                        img.sa-av(src=photo alt="" style="object-fit:cover")
                                    else
                                        span.sa-av(style='background:' + couleurAvatar(slug))= nom.charAt(0).toUpperCase()
                                    div
                                        .sa-person__name= nom
                                        .sa-person__mail= [metier, ville].filter(Boolean).join(' · ') || '—'
                            td
                                a(href='/' + slug target="_blank" rel="noopener" style="color:#93c5fd;text-decoration:none")= '/' + slug
                            td.js-statut
                                if pos > 0
                                    span.sa-tag.sa-tag--amber= 'Position ' + pos
                                else
                                    span.sa-muted —
                            td
                                .sa-boost
                                    input.sa-input.js-pos(type="number" min="0" max="99" value=pos style="width:74px;height:30px")
                                    button.sa-btn.js-save(type="button" style="height:30px")
                                        span.material-symbols-outlined save
                                        span Enregistrer

block scripts
    script.
        (function () {
            document.querySelectorAll('.js-save').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var tr = btn.closest('tr');
                    var champ = tr.querySelector('.js-pos');
                    var position = parseInt(champ.value, 10) || 0;
                    btn.disabled = true;
                    fetch('/superadmin/boost/' + tr.dataset.companyId, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ position: position })
                    })
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            btn.disabled = false;
                            if (!d.success) throw new Error(d.error || 'échec');
                            tr.classList.toggle('is-selected', position > 0);
                            tr.querySelector('.js-statut').innerHTML = position > 0
                                ? '<span class="sa-tag sa-tag--amber">Position ' + position + '</span>'
                                : '<span class="sa-muted">—</span>';
                            window.saToast(position > 0 ? 'Mise en avant en position ' + position + '.' : 'Mise en avant retirée.');
                        })
                        .catch(function () {
                            btn.disabled = false;
                            window.saToast('Enregistrement impossible.', 'err');
                        });
                });
            });

            var recherche = document.getElementById('recherche');
            var compteur = document.getElementById('compteur');
            recherche.addEventListener('input', function () {
                var q = recherche.value.trim().toLowerCase();
                var n = 0;
                document.querySelectorAll('tbody tr').forEach(function (tr) {
                    var ok = !q || (tr.dataset.search || '').indexOf(q) !== -1;
                    tr.style.display = ok ? '' : 'none';
                    if (ok) n++;
                });
                compteur.textContent = n + ' établissement' + (n > 1 ? 's' : '');
            });
        })();
