extends ../../layouts/sa

block content
    -
        var maintenant = Date.now();
        var actifs = links.filter(function (l) { return l.isActive; }).length;
        var activations = links.reduce(function (n, l) { return n + (l.usedCount || 0); }, 0);
        var expires = links.filter(function (l) { return l.expiresAt && new Date(l.expiresAt).getTime() < maintenant; }).length;

    .sa-head
        button.sa-ico.sa-burger(type="button" data-sa-burger aria-label="Menu")
            span.material-symbols-outlined menu
        div
            h1.sa-head__title Liens d'accès
            .sa-head__sub Offrir un plan payant pendant une durée définie, sans carte bancaire
        .sa-head__end
            button.sa-btn.sa-btn--primary#btnNouveau(type="button")
                span.material-symbols-outlined add
                span Générer un lien

    .sa-body
        .sa-kpis
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined link
                    span Liens
                .sa-kpi__value= links.length
                .sa-kpi__delta= actifs + ' actif(s)'
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined how_to_reg
                    span Activations
                .sa-kpi__value= activations
                .sa-kpi__delta Accès accordés
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined event_busy
                    span Expirés
                .sa-kpi__value= expires
                .sa-kpi__delta Ne fonctionnent plus

        if !links.length
            .sa-tablewrap
                .sa-empty
                    .sa-empty__ic
                        span.material-symbols-outlined link
                    .sa-empty__t Aucun lien d'accès
                    .sa-empty__d Générez-en un pour offrir un plan à un partenaire.
        else
            .sa-tablewrap
                table.sa-table
                    thead
                        tr
                            th Code
                            th Plan offert
                            th Durée
                            th Utilisations
                            th Expiration du lien
                            th Actif
                            th(style="width:120px")
                    tbody
                        each l in links
                            - var perime = l.expiresAt && new Date(l.expiresAt).getTime() < maintenant
                            - var complet = l.maxUses !== null && l.usedCount >= l.maxUses
                            tr(data-id=String(l._id) data-code=l.code)
                                td
                                    .sa-code
                                        span.sa-mono(style="font-weight:700;font-size:13px")= l.code
                                    if l.label
                                        .sa-person__mail= l.label
                                td
                                    span.sa-tag(class=l.plan === 'business' ? 'sa-tag--violet' : 'sa-tag--green')= l.plan === 'business' ? 'Business' : 'Pro'
                                td= l.durationDays + ' jours'
                                td
                                    span(class=complet ? 'sa-muted' : '' style="font-weight:600")= l.usedCount
                                    span.sa-muted= l.maxUses !== null ? ' / ' + l.maxUses : ' / ∞'
                                td.sa-td--date
                                    if l.expiresAt
                                        span(class=perime ? 'sa-tag sa-tag--red' : '')= new Date(l.expiresAt).toLocaleDateString('fr-FR')
                                    else
                                        | —
                                td
                                    label.sa-switch
                                        input.js-actif(type="checkbox" checked=l.isActive data-id=String(l._id))
                                        span.sa-switch__track
                                td.sa-td--right
                                    button.sa-ico.js-copier(type="button" title="Copier le lien" data-code=l.code)
                                        span.material-symbols-outlined content_copy
                                    button.sa-ico.js-detail(type="button" title="Voir les activations" data-id=String(l._id))
                                        span.material-symbols-outlined expand_more
                                    button.sa-ico.sa-ico--danger.js-suppr(type="button" title="Supprimer" data-id=String(l._id))
                                        span.material-symbols-outlined delete
                            tr.sa-detail(id='detail-' + l._id style="display:none")
                                td(colspan="7")
                                    .sa-detail__in
                                        .sa-detail__url
                                            span.sa-mono.js-url(data-code=l.code)
                                            button.sa-ico.js-copier(type="button" title="Copier l'URL" data-code=l.code)
                                                span.material-symbols-outlined content_copy
                                        if l.uses && l.uses.length
                                            .sa-props
                                                each u in l.uses
                                                    .sa-prop(style="grid-template-columns:1fr auto")
                                                        .sa-prop__k(style="color:var(--sa-txt)")
                                                            span.material-symbols-outlined person
                                                            span= u.email || '(anonyme)'
                                                        div(style="display:flex;gap:12px;align-items:center")
                                                            span.sa-muted(style="font-size:12px")= u.ip || ''
                                                            span.sa-muted(style="font-size:12px")= new Date(u.usedAt).toLocaleString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })
                                        else
                                            .sa-muted Aucune activation pour l'instant.

    //- ── Création ──────────────────────────────────────────────────────────
    .sa-modal#modalNouveau
        .sa-modal__overlay(data-fermer)
        .sa-modal__box
            .sa-modal__head
                span.material-symbols-outlined link
                span.sa-modal__title Générer un lien d'accès
                button.sa-ico(type="button" data-fermer style="margin-left:auto" aria-label="Fermer")
                    span.material-symbols-outlined close
            .sa-modal__body
                .sa-field
                    span.sa-field__label Libellé interne
                    input.sa-input#newLabel(type="text" placeholder="ex. Offre partenaire mars 2026")
                .sa-grid2
                    .sa-field
                        span.sa-field__label Plan offert
                        select.sa-select#newPlan
                            option(value="pro") Pro
                            option(value="business") Business
                    .sa-field
                        span.sa-field__label Durée de l'accès
                        select.sa-select#newDuration
                            option(value="7") 7 jours
                            option(value="30" selected) 30 jours (1 mois)
                            option(value="60") 60 jours (2 mois)
                            option(value="90") 90 jours (3 mois)
                            option(value="180") 180 jours (6 mois)
                            option(value="365") 365 jours (1 an)
                .sa-grid2
                    .sa-field
                        span.sa-field__label Utilisations maximum
                        input.sa-input#newMaxUses(type="number" min="1" value="1")
                    .sa-field
                        span.sa-field__label Expiration du lien
                        input.sa-input#newExpiresAt(type="date")
            .sa-modal__foot
                button.sa-btn(type="button" data-fermer) Annuler
                button.sa-btn.sa-btn--primary#btnCreer(type="button") Générer le lien

block scripts
    script(src="/js/utils/confirm-modal.js")
    script(src="/js/superadmin/access-links.js")
