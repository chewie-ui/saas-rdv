doctype html
html(lang="fr")
    head
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(charset="UTF-8")
        title Superadmin — Utilisateurs
        link(rel="shortcut icon" href="/images/icon.svg" type="image/x-icon")
        link(rel="stylesheet" href="/css/import.css")
        style.
            *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
            body {
                min-height: 100vh;
                background: #0f0f0f;
                color: #e0e0e0;
                font-family: 'Inter', sans-serif;
                padding: 32px 24px 80px;
            }
            .sa-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 32px;
                flex-wrap: wrap;
                gap: 16px;
            }
            .sa-header__left {
                display: flex;
                flex-direction: column;
                gap: 4px;
            }
            .sa-header__left h1 {
                font-size: 24px;
                font-weight: 700;
                color: #fff;
                letter-spacing: -0.02em;
            }
            .sa-header__left p {
                font-size: 13px;
                color: #555;
            }
            .sa-header__right {
                display: flex;
                align-items: center;
                gap: 12px;
            }
            .badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: #666;
                background: #1a1a1a;
                border: 1px solid #2a2a2a;
                border-radius: 6px;
                padding: 5px 10px;
            }
            .badge--green { color: #22c55e; border-color: rgba(34,197,94,0.2); background: rgba(34,197,94,0.07); }
            .badge--yellow { color: #facc15; border-color: rgba(250,204,21,0.2); background: rgba(250,204,21,0.07); }
            a.logout-btn {
                font-size: 12px;
                color: #555;
                text-decoration: none;
                padding: 6px 12px;
                border: 1px solid #2a2a2a;
                border-radius: 8px;
                transition: color 0.15s, border-color 0.15s;
            }
            a.logout-btn:hover { color: #f87171; border-color: rgba(248,113,113,0.3); }
            .search-bar {
                margin-bottom: 24px;
            }
            .search-bar form {
                display: flex;
                gap: 10px;
            }
            .search-bar input {
                flex: 1;
                max-width: 340px;
                background: #1a1a1a;
                border: 1.5px solid #2a2a2a;
                border-radius: 10px;
                color: #fff;
                font-size: 13px;
                padding: 9px 14px;
                outline: none;
                transition: border-color 0.15s;
            }
            .search-bar input:focus { border-color: #444; }
            .search-bar button {
                background: #fff;
                color: #111;
                border: none;
                border-radius: 10px;
                font-size: 13px;
                font-weight: 600;
                padding: 9px 18px;
                cursor: pointer;
                transition: opacity 0.15s;
            }
            .search-bar button:hover { opacity: 0.85; }
            .stats-row {
                display: flex;
                gap: 12px;
                margin-bottom: 24px;
                flex-wrap: wrap;
            }
            .stat-card {
                background: #1a1a1a;
                border: 1px solid #2a2a2a;
                border-radius: 12px;
                padding: 16px 20px;
                display: flex;
                flex-direction: column;
                gap: 4px;
                min-width: 120px;
            }
            .stat-card__value {
                font-size: 26px;
                font-weight: 700;
                color: #fff;
                letter-spacing: -0.02em;
                line-height: 1;
            }
            .stat-card__label {
                font-size: 11px;
                color: #555;
                text-transform: uppercase;
                letter-spacing: 0.06em;
            }
            .users-table {
                width: 100%;
                border-collapse: collapse;
                background: #1a1a1a;
                border: 1px solid #2a2a2a;
                border-radius: 14px;
                overflow: hidden;
            }
            .users-table thead th {
                text-align: left;
                font-size: 10px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                color: #444;
                padding: 12px 18px;
                border-bottom: 1px solid #222;
                background: #161616;
            }
            .users-table tbody tr {
                border-bottom: 1px solid #1f1f1f;
                transition: background 0.1s;
            }
            .users-table tbody tr:last-child { border-bottom: none; }
            .users-table tbody tr:hover { background: #1f1f1f; }
            .users-table tbody td {
                padding: 14px 18px;
                font-size: 13px;
                color: #ccc;
                vertical-align: middle;
            }
            .user-info {
                display: flex;
                flex-direction: column;
                gap: 2px;
            }
            .user-info__name {
                font-size: 14px;
                font-weight: 600;
                color: #fff;
            }
            .user-info__email {
                font-size: 12px;
                color: #555;
            }
            .toggle-wrap {
                display: flex;
                align-items: center;
                gap: 10px;
            }
            /* Toggle switch */
            .sa-toggle {
                position: relative;
                display: inline-block;
                width: 44px;
                height: 24px;
                flex-shrink: 0;
            }
            .sa-toggle input { opacity: 0; width: 0; height: 0; }
            .sa-toggle__track {
                position: absolute;
                inset: 0;
                background: #2a2a2a;
                border-radius: 99px;
                transition: background 0.2s;
                cursor: pointer;
            }
            .sa-toggle__track::after {
                content: '';
                position: absolute;
                left: 3px;
                top: 3px;
                width: 18px;
                height: 18px;
                background: #555;
                border-radius: 50%;
                transition: transform 0.2s, background 0.2s;
            }
            .sa-toggle input:checked + .sa-toggle__track {
                background: rgba(34,197,94,0.25);
            }
            .sa-toggle input:checked + .sa-toggle__track::after {
                transform: translateX(20px);
                background: #22c55e;
            }
            .toggle-label {
                font-size: 12px;
                color: #555;
            }
            .toggle-label.active { color: #22c55e; font-weight: 600; }
            .date-col { color: #444; font-size: 12px; }
            .empty-state {
                text-align: center;
                padding: 60px 24px;
                color: #444;
                font-size: 14px;
            }
            @media (max-width: 700px) {
                .users-table thead th:nth-child(3),
                .users-table tbody td:nth-child(3) { display: none; }
            }
    body
        .sa-header
            .sa-header__left
                h1 👥 Utilisateurs beta
                p Gérez les accès premium manuels pour les bêta testeurs.
            .sa-header__right
                span.badge= users.length + ' utilisateurs'
                a.logout-btn(href="/superadmin/logout") Déconnexion

        .stats-row
            .stat-card
                .stat-card__value= users.length
                .stat-card__label Total
            .stat-card
                .stat-card__value= users.filter(u => u.isPremium).length
                .stat-card__label Premium
            .stat-card
                .stat-card__value= users.filter(u => u.manualPremium).length
                .stat-card__label Bêta (manuels)

        .search-bar
            form(method="GET" action="/superadmin")
                input(type="text" name="search" placeholder="Rechercher par nom ou email..." value=search)
                button(type="submit") Rechercher
                if search
                    a(href="/superadmin" style="font-size:13px;color:#555;text-decoration:none;margin-left:8px;align-self:center;") ✕ Effacer

        if users.length === 0
            .empty-state Aucun utilisateur trouvé.
        else
            table.users-table
                thead
                    tr
                        th Utilisateur
                        th Premium bêta
                        th Stripe premium
                        th Inscrit le
                tbody
                    each u in users
                        tr(data-user-id=u._id)
                            td
                                .user-info
                                    .user-info__name= u.fullName
                                    .user-info__email= u.email
                            td
                                .toggle-wrap
                                    label.sa-toggle
                                        input(
                                            type="checkbox"
                                            class="manual-premium-toggle"
                                            checked=u.manualPremium
                                            data-user-id=String(u._id)
                                        )
                                        .sa-toggle__track
                                    span.toggle-label(class=u.manualPremium ? 'active' : '')
                                        = u.manualPremium ? 'Actif' : 'Inactif'
                            td
                                if u.isPremium && !u.manualPremium
                                    span.badge.badge--green Stripe ✓
                                else if u.isPremium && u.manualPremium
                                    span.badge.badge--yellow Manuel
                                else
                                    span.badge —
                            td.date-col= new Date(u.createdAt).toLocaleDateString('fr-FR')

        script.
            document.querySelectorAll('.manual-premium-toggle').forEach(function(checkbox) {
                checkbox.addEventListener('change', async function() {
                    const userId = this.dataset.userId;
                    const enabled = this.checked;
                    const label = this.closest('.toggle-wrap').querySelector('.toggle-label');

                    // Optimistic UI
                    label.textContent = enabled ? 'Actif' : 'Inactif';
                    label.classList.toggle('active', enabled);

                    try {
                        const res = await fetch('/superadmin/toggle-premium/' + userId, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ manualPremium: enabled })
                        });
                        const data = await res.json();
                        if (!data.success) throw new Error('Failed');

                        // Update stripe badge cell
                        const row = this.closest('tr');
                        const badgeCell = row.querySelector('td:nth-child(3)');
                        if (enabled) {
                            badgeCell.innerHTML = '<span class="badge badge--yellow">Manuel</span>';
                        } else {
                            badgeCell.innerHTML = '<span class="badge">—</span>';
                        }
                    } catch(e) {
                        // Revert
                        this.checked = !enabled;
                        label.textContent = !enabled ? 'Actif' : 'Inactif';
                        label.classList.toggle('active', !enabled);
                        alert('Erreur lors de la mise à jour.');
                    }
                });
            });
