extends ../../layouts/sa

block content
    -
        var palette = ['#6ee7b7', '#93c5fd', '#fcd34d', '#fca5a5', '#c4b5fd', '#f9a8d4', '#a5f3fc', '#bef264'];
        function couleurAvatar(s) {
            var n = 0;
            for (var i = 0; i < String(s).length; i++) n += String(s).charCodeAt(i);
            return palette[n % palette.length];
        }
        function initiales(nom, email) {
            var base = String(nom || email || '?').trim();
            var mots = base.split(/[\s@._-]+/).filter(Boolean);
            return ((mots[0] || '?')[0] + (mots[1] ? mots[1][0] : '')).toUpperCase();
        }
        function jourFr(d) {
            return d ? new Date(d).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
        }
        function depuis(d) {
            if (!d) return 'jamais';
            var j = Math.floor((Date.now() - new Date(d).getTime()) / 86400000);
            if (j <= 0) return "aujourd'hui";
            if (j === 1) return 'hier';
            if (j < 30) return 'il y a ' + j + ' j';
            if (j < 365) return 'il y a ' + Math.floor(j / 30) + ' mois';
            return 'il y a ' + Math.floor(j / 365) + ' an';
        }
        var couleurPlan = { Free: '', Essentiel: 'sa-tag--blue', Pro: 'sa-tag--green', Business: 'sa-tag--violet' };
        //- Conserve les filtres courants dans les liens (pagination, export).
        function requete(extra) {
            var q = [];
            if (filtres.search) q.push('search=' + encodeURIComponent(filtres.search));
            if (filtres.statut !== 'tous') q.push('statut=' + filtres.statut);
            if (filtres.plan !== 'tous') q.push('plan=' + filtres.plan);
            if (filtres.estab !== 'tous') q.push('estab=' + filtres.estab);
            if (filtres.tri !== 'recent') q.push('tri=' + filtres.tri);
            if (extra) q.push(extra);
            return q.length ? '?' + q.join('&') : '';
        }
        var filtreActif = filtres.search || filtres.statut !== 'tous' || filtres.plan !== 'tous' || filtres.estab !== 'tous';

    .sa-head
        button.sa-ico.sa-burger(type="button" data-sa-burger aria-label="Menu")
            span.material-symbols-outlined menu
        div
            h1.sa-head__title Utilisateurs
            .sa-head__sub Comptes personnels · le plan se gère par établissement
        .sa-head__end
            button.sa-btn(type="button" id="btnBroadcast")
                span.material-symbols-outlined campaign
                span Message à tous
            a.sa-btn(href='/superadmin/users/export' + requete())
                span.material-symbols-outlined download
                span Exporter

    .sa-body
        .sa-kpis
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined group
                    span Comptes
                .sa-kpi__value= kpis.total.toLocaleString('fr-FR')
                .sa-kpi__delta= kpis.etablissements + ' établissement' + (kpis.etablissements > 1 ? 's' : '')
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined task_alt
                    span Actifs
                .sa-kpi__value= kpis.actifs.toLocaleString('fr-FR')
                .sa-kpi__delta(class=kpis.desactives ? 'sa-kpi__delta--down' : '')= kpis.desactives + ' désactivé' + (kpis.desactives > 1 ? 's' : '')
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined person_add
                    span Inscrits aujourd'hui
                .sa-kpi__value= kpis.aujourdhui
                .sa-kpi__delta(class=kpis.inscrits7j ? 'sa-kpi__delta--up' : '')= kpis.inscrits7j + ' sur 7 jours'
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined login
                    span Connectés (7 j)
                .sa-kpi__value= kpis.connectes7j.toLocaleString('fr-FR')
                .sa-kpi__delta= kpis.total ? Math.round((kpis.connectes7j / kpis.total) * 100) + ' % des comptes' : '—'
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined do_not_disturb_on
                    span Jamais connectés
                .sa-kpi__value= kpis.jamaisConnectes.toLocaleString('fr-FR')
                .sa-kpi__delta Comptes créés sans usage
            .sa-kpi
                .sa-kpi__label
                    span.material-symbols-outlined groups
                    span Clients (total)
                .sa-kpi__value= trafic.totalClients.toLocaleString('fr-FR')
                .sa-kpi__delta(class=trafic.clientsToday ? 'sa-kpi__delta--up' : '')= '+' + trafic.clientsToday + " aujourd'hui"

        //- ── Filtres ───────────────────────────────────────────────────────
        form.sa-toolbar(method="GET" action="/superadmin" id="formFiltres")
            label.sa-search
                span.material-symbols-outlined search
                input.sa-input(type="text" name="search" placeholder="Nom ou email…" value=filtres.search)
            select.sa-select(name="statut" data-auto)
                option(value="tous" selected=filtres.statut === 'tous') Tous les statuts
                option(value="actif" selected=filtres.statut === 'actif') Actifs
                option(value="desactive" selected=filtres.statut === 'desactive') Désactivés
            select.sa-select(name="plan" data-auto)
                option(value="tous" selected=filtres.plan === 'tous') Tous les plans
                option(value="basic" selected=filtres.plan === 'basic') Free
                option(value="essentiel" selected=filtres.plan === 'essentiel') Essentiel
                option(value="pro" selected=filtres.plan === 'pro') Pro
                option(value="business" selected=filtres.plan === 'business') Business
            select.sa-select(name="estab" data-auto)
                option(value="tous" selected=filtres.estab === 'tous') Avec ou sans établissement
                option(value="avec" selected=filtres.estab === 'avec') Avec établissement
                option(value="sans" selected=filtres.estab === 'sans') Sans établissement
            .sa-toolbar__end
                select.sa-select(name="tri" data-auto)
                    option(value="recent" selected=filtres.tri === 'recent') Plus récents
                    option(value="ancien" selected=filtres.tri === 'ancien') Plus anciens
                    option(value="nom" selected=filtres.tri === 'nom') Nom (A→Z)
                    option(value="connexion" selected=filtres.tri === 'connexion') Dernière connexion
                button.sa-btn(type="submit")
                    span.material-symbols-outlined filter_alt
                    span Filtrer
                if filtreActif
                    a.sa-btn(href="/superadmin")
                        span.material-symbols-outlined close
                        span Réinitialiser

        //- ── Actions sur la sélection ──────────────────────────────────────
        .sa-bulk#bulkBar
            span#bulkCount 0 sélectionné
            .sa-bulk__end
                button.sa-btn(type="button" id="bulkMsg")
                    span.material-symbols-outlined mail
                    span Message groupé
                button.sa-btn(type="button" id="bulkOff")
                    span.material-symbols-outlined block
                    span Désactiver
                button.sa-btn.sa-btn--danger(type="button" id="bulkDel")
                    span.material-symbols-outlined delete
                    span Supprimer

        if !users.length
            .sa-tablewrap
                .sa-empty
                    .sa-empty__ic
                        span.material-symbols-outlined person_search
                    .sa-empty__t Aucun compte
                    .sa-empty__d= filtreActif ? 'Aucun résultat pour ces filtres.' : 'Aucun utilisateur inscrit pour le moment.'
        else
            .sa-tablewrap
                table.sa-table.sa-table--users
                    thead
                        tr
                            th.sa-col-check
                                input.sa-check(type="checkbox" id="checkAll" aria-label="Tout sélectionner")
                            th Utilisateur
                            th Établissements
                            th Plan
                            th Inscrit le
                            th Dernière connexion
                            th Statut
                            th(style="width:44px")
                    tbody
                        each u in users
                            - var nom = u.fullName || u.email
                            tr(data-user-id=String(u._id) data-user-name=nom data-user-mail=u.email data-actif=(u.isDisabled ? '0' : '1'))
                                td.sa-col-check
                                    input.sa-check.js-row-check(type="checkbox" aria-label='Sélectionner ' + nom)
                                td
                                    .sa-person
                                        span.sa-av(style='background:' + couleurAvatar(u.email || nom))= initiales(u.fullName, u.email)
                                        div
                                            .sa-person__name
                                                span= u.fullName || '—'
                                            .sa-person__mail= u.email
                                td
                                    //- Une seule ligne : toutes les lignes du tableau gardent
                                    //- exactement la même hauteur (règle du design commun).
                                    if u.establishments.length
                                        - var premier = u.establishments[0]
                                        .sa-estab(title=u.establishments.map(function (e) { return e.name || e.slug; }).join(', '))
                                            a(href='/' + (premier.slug || '') style="color:var(--sa-txt-2);text-decoration:none")= premier.name || ('/' + premier.slug)
                                            if premier.isPaused
                                                span.sa-tag.sa-tag--amber En pause
                                            if u.establishments.length > 1
                                                span.sa-muted(style="font-size:12px")= '+' + (u.establishments.length - 1)
                                    else
                                        span.sa-muted —
                                td
                                    span.sa-tag(class=couleurPlan[u.planLabel])= u.planLabel
                                td.sa-td--date= jourFr(u.createdAt)
                                td.sa-td--date
                                    span(class=u.lastLoginAt ? '' : 'sa-muted' style=u.lastLoginAt ? 'color:var(--sa-txt)' : '')= depuis(u.lastLoginAt)
                                td
                                    label.sa-switch(title="Activer / désactiver le compte")
                                        input(type="checkbox" class="js-toggle" checked=!u.isDisabled)
                                        span.sa-switch__track
                                        span.sa-person__mail.js-toggle-label(style="font-size:12px")= u.isDisabled ? 'Désactivé' : 'Actif'
                                td.sa-td--right
                                    .sa-menu
                                        button.sa-ico(type="button" data-sa-menu aria-label="Actions")
                                            span.material-symbols-outlined more_vert
                                        .sa-menu__list
                                            button.sa-menu__item(type="button" data-act="fiche")
                                                span.material-symbols-outlined person
                                                span Voir la fiche
                                            button.sa-menu__item(type="button" data-act="message")
                                                span.material-symbols-outlined mail
                                                span Envoyer un message
                                            button.sa-menu__item(type="button" data-act="copie")
                                                span.material-symbols-outlined content_copy
                                                span Copier l'email
                                            .sa-menu__sep
                                            button.sa-menu__item(type="button" data-act="acces")
                                                span.material-symbols-outlined lock_open
                                                span Accéder au compte
                                            button.sa-menu__item(type="button" data-act="supervision")
                                                span.material-symbols-outlined visibility
                                                span Demander une supervision
                                            .sa-menu__sep
                                            button.sa-menu__item.sa-menu__item--danger(type="button" data-act="supprimer")
                                                span.material-symbols-outlined delete
                                                span Supprimer le compte

            .sa-pager
                span= resultats + ' compte' + (resultats > 1 ? 's' : '') + ' · page ' + page + ' / ' + pages
                .sa-pager__end
                    a.sa-pager__btn(href='/superadmin' + requete('page=' + (page - 1)) class=page <= 1 ? 'is-off' : '')
                        span.material-symbols-outlined chevron_left
                    - var debut = Math.max(1, Math.min(page - 2, pages - 4))
                    - var fin = Math.min(pages, debut + 4)
                    each n in Array.from({ length: fin - debut + 1 }, function (_, i) { return debut + i })
                        a.sa-pager__btn(href='/superadmin' + requete('page=' + n) class=n === page ? 'is-current' : '')= n
                    a.sa-pager__btn(href='/superadmin' + requete('page=' + (page + 1)) class=page >= pages ? 'is-off' : '')
                        span.material-symbols-outlined chevron_right

        //- ── Trafic ────────────────────────────────────────────────────────
        .sa-grid2(style="margin-top:24px")
            .sa-card
                .sa-card__t Trafic du site
                .sa-props
                    .sa-prop
                        .sa-prop__k
                            span.material-symbols-outlined visibility
                            span Vues totales
                        .sa-prop__v= trafic.totalViews.toLocaleString('fr-FR')
                    .sa-prop
                        .sa-prop__k
                            span.material-symbols-outlined person
                            span Visiteurs uniques
                        .sa-prop__v= trafic.uniqueViews.toLocaleString('fr-FR')
                    .sa-prop
                        .sa-prop__k
                            span.material-symbols-outlined groups
                            span Clients enregistrés
                        .sa-prop__v= trafic.totalClients.toLocaleString('fr-FR')
            .sa-card
                .sa-card__t Provenance des vues
                if trafic.topSources && trafic.topSources.length
                    - var maxSource = Math.max.apply(null, trafic.topSources.map(function (s) { return s.count; }))
                    .sa-bars
                        each s in trafic.topSources
                            .sa-bar
                                .sa-bar__name= s._id || 'direct'
                                .sa-bar__track
                                    .sa-bar__fill(style='width:' + Math.round((s.count / maxSource) * 100) + '%')
                                .sa-bar__n= s.count.toLocaleString('fr-FR')
                else
                    .sa-muted Aucune donnée de provenance.
            .sa-card
                .sa-card__t Provenance des inscrits
                if trafic.inscritsParSource && trafic.inscritsParSource.length
                    - var maxInscrit = Math.max.apply(null, trafic.inscritsParSource.map(function (s) { return s.count; }))
                    .sa-bars
                        each s in trafic.inscritsParSource
                            .sa-bar
                                .sa-bar__name= s._id
                                .sa-bar__track
                                    .sa-bar__fill(style='width:' + Math.round((s.count / maxInscrit) * 100) + '%')
                                .sa-bar__n= s.count.toLocaleString('fr-FR')
                else
                    .sa-muted Aucun inscrit tracé pour l'instant.
                if trafic.inscritsSansSource
                    .sa-muted(style="margin-top:10px")
                        = trafic.inscritsSansSource.toLocaleString('fr-FR') + ' compte' + (trafic.inscritsSansSource > 1 ? 's' : '') + ' sans provenance (créé' + (trafic.inscritsSansSource > 1 ? 's' : '') + ' avant le suivi, ou via l\'app mobile)'

    //- ── Fiche détaillée ───────────────────────────────────────────────────
    .sa-drawer#drawer
        .sa-drawer__overlay(data-close)
        .sa-drawer__panel
            .sa-drawer__head
                span.sa-av#dwAvatar
                div(style="min-width:0")
                    .sa-drawer__title#dwName —
                    .sa-head__sub#dwMail
                button.sa-ico(type="button" data-close style="margin-left:auto" aria-label="Fermer")
                    span.material-symbols-outlined close
            .sa-drawer__body#dwBody
            .sa-drawer__foot
                button.sa-btn(type="button" id="dwMsg")
                    span.material-symbols-outlined mail
                    span Message
                button.sa-btn(type="button" id="dwImp")
                    span.material-symbols-outlined lock_open
                    span Accéder
                button.sa-btn.sa-btn--danger(type="button" id="dwDel" style="margin-left:auto")
                    span.material-symbols-outlined delete
                    span Supprimer

    //- ── Composition d'un message ──────────────────────────────────────────
    .sa-modal#modalMsg
        .sa-modal__overlay(data-close-msg)
        .sa-modal__box
            .sa-modal__head
                span.material-symbols-outlined mail
                span.sa-modal__title Envoyer un message
                button.sa-ico(type="button" data-close-msg style="margin-left:auto" aria-label="Fermer")
                    span.material-symbols-outlined close
            .sa-modal__body
                .sa-head__sub À : <b id="msgTo" style="color:var(--sa-txt)">—</b>
                .sa-field
                    span.sa-field__label Tonalité
                    div(style="display:flex;flex-wrap:wrap;gap:6px" id="msgTypes")
                        button.sa-btn(type="button" data-type="info") Info
                        button.sa-btn(type="button" data-type="tip") Conseil
                        button.sa-btn(type="button" data-type="success") Succès
                        button.sa-btn(type="button" data-type="warning") Alerte
                        button.sa-btn(type="button" data-type="security") Sécurité
                .sa-field
                    span.sa-field__label Titre
                    input.sa-input#msgTitle(type="text" maxlength="140" placeholder="ex. Bienvenue sur BranShee !")
                .sa-field
                    span.sa-field__label Message
                    textarea.sa-textarea#msgBody(maxlength="4000" placeholder="Votre message…")
                .sa-field
                    span.sa-field__label Bouton (optionnel) — texte / lien
                    div(style="display:flex;gap:8px")
                        input.sa-input#msgCtaLabel(type="text" maxlength="60" placeholder="ex. Voir")
                        input.sa-input#msgCtaUrl(type="text" maxlength="500" placeholder="/subscription")
            .sa-modal__foot
                button.sa-btn(type="button" data-close-msg) Annuler
                button.sa-btn.sa-btn--primary#msgSend(type="button") Envoyer

block scripts
    script(src="/socket.io/socket.io.js")
    script(src="/js/utils/confirm-modal.js")
    script(src="/js/superadmin/users.js")
