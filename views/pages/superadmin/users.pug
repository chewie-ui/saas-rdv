doctype html
html(lang="fr")
    head
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(charset="UTF-8")
        title Superadmin — Utilisateurs
        link(rel="shortcut icon" href="/images/icon.svg" type="image/x-icon")
        link(rel="stylesheet" href="/css/import.css")
        link(rel="stylesheet" href="/css/layouts/superadmin.css")
        style.
            body { padding: 0 24px 80px; }
            .sa-header__left h1 { font-size: 22px; font-weight: 700; color: #fff; letter-spacing: -.02em; }
            .badge { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 600; letter-spacing: .05em; color: #666; background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 6px; padding: 4px 10px; }
            .search-bar { margin-bottom: 24px; }
            .search-bar form { display: flex; gap: 10px; }
            .search-bar input { flex: 1; max-width: 340px; background: #141414; border: 1.5px solid #2a2a2a; border-radius: 10px; color: #fff; font-size: 13px; padding: 9px 14px; outline: none; transition: border-color .15s; }
            .search-bar input:focus { border-color: #444; }
            .search-bar button { background: #fff; color: #111; border: none; border-radius: 10px; font-size: 13px; font-weight: 600; padding: 9px 18px; cursor: pointer; }
            .stats-row { display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap; }
            .stat-card { background: #141414; border: 1px solid #1e1e1e; border-radius: 12px; padding: 15px 20px; display: flex; flex-direction: column; gap: 4px; min-width: 118px; }
            .stat-card__value { font-size: 25px; font-weight: 700; color: #fff; letter-spacing: -.02em; line-height: 1; }
            .stat-card__value--green { color: #22c55e; }
            .stat-card__value--red { color: #f87171; }
            .stat-card__label { font-size: 10.5px; color: #555; text-transform: uppercase; letter-spacing: .06em; }
            .sources-card { background: #141414; border: 1px solid #1e1e1e; border-radius: 12px; padding: 18px 20px; margin-bottom: 24px; }
            .sources-card__title { font-size: 11px; font-weight: 600; color: #777; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 14px; }
            .source-row { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
            .source-row__name { width: 150px; flex-shrink: 0; font-size: 12.5px; color: #bbb; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
            .source-row__bar-wrap { flex: 1; height: 7px; background: #222; border-radius: 4px; overflow: hidden; }
            .source-row__bar { height: 100%; background: linear-gradient(90deg,#22c55e,#16a34a); border-radius: 4px; }
            .source-row__count { width: 60px; flex-shrink: 0; text-align: right; font-size: 12.5px; font-weight: 600; color: #fff; }
            .users-table { width: 100%; border-collapse: collapse; background: #141414; border: 1px solid #1e1e1e; border-radius: 14px; overflow: hidden; }
            .users-table thead th { text-align: left; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: #444; padding: 12px 18px; border-bottom: 1px solid #1e1e1e; background: #131313; }
            .users-table tbody tr { border-bottom: 1px solid #1c1c1c; transition: background .1s; }
            .users-table tbody tr:last-child { border-bottom: none; }
            .users-table tbody tr:hover { background: #1a1a1a; }
            .users-table tbody td { padding: 13px 18px; font-size: 13px; color: #ccc; vertical-align: middle; }
            .user-info__name { font-size: 14px; font-weight: 600; color: #fff; }
            .user-info__email { font-size: 12px; color: #555; margin-top: 1px; }
            .estabs { display: flex; flex-direction: column; gap: 4px; }
            .estab-chip { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; color: #cbd5e1; }
            .estab-plan { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; padding: 1px 6px; border-radius: 4px; }
            .estab-plan--free { color: #64748b; background: #1e1e1e; border: 1px solid #2a2a2a; }
            .estab-plan--essentiel { color: #38bdf8; background: rgba(56,189,248,.1); border: 1px solid rgba(56,189,248,.25); }
            .estab-plan--pro { color: #22c55e; background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.25); }
            .estab-plan--business { color: #a78bfa; background: rgba(167,139,250,.1); border: 1px solid rgba(167,139,250,.25); }
            .estab-paused { font-size: 10px; color: #f87171; }
            .no-estab { color: #444; font-size: 12px; }
            .date-col { color: #555; font-size: 12px; }
            /* Toggle actif/désactivé */
            .acc-toggle { position: relative; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; }
            .acc-toggle input { display: none; }
            .acc-toggle__track { width: 36px; height: 20px; border-radius: 10px; background: #2a2a2a; border: 1.5px solid #333; transition: background .2s, border-color .2s; flex-shrink: 0; position: relative; }
            .acc-toggle__track::after { content: ''; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%; background: #444; transition: transform .2s, background .2s; }
            .acc-toggle input:checked + .acc-toggle__track { background: rgba(34,197,94,.15); border-color: rgba(34,197,94,.4); }
            .acc-toggle input:checked + .acc-toggle__track::after { transform: translateX(16px); background: #22c55e; }
            .acc-toggle__label { font-size: 12px; font-weight: 600; color: #555; min-width: 60px; }
            .acc-toggle input:checked ~ .acc-toggle__label { color: #22c55e; }
            .acc-toggle--disabled-state .acc-toggle__label { color: #f87171 !important; }
            /* Action buttons */
            .act-btns { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
            .act-btn { font-size: 11px; font-weight: 600; padding: 5px 10px; border-radius: 7px; border: 1px solid #2a2a2a; cursor: pointer; transition: all .15s; white-space: nowrap; background: none; color: #666; }
            .act-btn:hover { background: #1f1f1f; color: #fff; border-color: #444; }
            .act-btn--msg:hover { color: #60a5fa; border-color: rgba(96,165,250,.4); }
            .act-btn--del:hover { color: #f87171; border-color: rgba(248,113,113,.4); }
            .act-btn:disabled { opacity: .6; cursor: default; }
            .empty-state { text-align: center; padding: 60px 24px; color: #444; font-size: 14px; }
            /* Compose modal */
            .sa-modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.72); display: none; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(3px); }
            .sa-modal-overlay.open { display: flex; }
            .sa-modal { background: #111; border: 1px solid #262626; border-radius: 18px; padding: 26px; width: 460px; max-width: 95vw; }
            .sa-modal__title { font-size: 16px; font-weight: 700; color: #fff; margin: 0 0 4px; }
            .sa-modal__sub { font-size: 12.5px; color: #666; margin-bottom: 18px; }
            .sa-modal__sub b { color: #cbd5e1; }
            .field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
            .field__label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .07em; color: #666; }
            .input, .textarea { background: #1a1a1a; border: 1.5px solid #2a2a2a; border-radius: 10px; color: #fff; font-size: 13.5px; padding: 10px 13px; outline: none; width: 100%; box-sizing: border-box; font-family: inherit; }
            .input:focus, .textarea:focus { border-color: #444; }
            .textarea { min-height: 90px; resize: vertical; line-height: 1.5; }
            .type-chips { display: flex; flex-wrap: wrap; gap: 7px; }
            .type-chip { padding: 6px 11px; border-radius: 8px; border: 1.5px solid #2a2a2a; background: #1a1a1a; color: #888; font-size: 12px; font-weight: 600; cursor: pointer; transition: all .15s; }
            .type-chip.active[data-type="info"] { border-color: #3b82f6; color: #fff; background: rgba(59,130,246,.15); }
            .type-chip.active[data-type="tip"] { border-color: #9333ea; color: #fff; background: rgba(147,51,234,.15); }
            .type-chip.active[data-type="success"] { border-color: #16a34a; color: #fff; background: rgba(22,163,74,.15); }
            .type-chip.active[data-type="warning"] { border-color: #d97706; color: #fff; background: rgba(217,119,6,.15); }
            .type-chip.active[data-type="security"] { border-color: #dc2626; color: #fff; background: rgba(220,38,38,.15); }
            .sa-modal__actions { display: flex; gap: 8px; margin-top: 18px; }
            .sa-btn { flex: 1; padding: 11px 16px; border-radius: 10px; font-size: 13.5px; font-weight: 700; cursor: pointer; border: none; }
            .sa-btn--primary { background: #fff; color: #111; }
            .sa-btn--ghost { background: #1a1a1a; border: 1px solid #2a2a2a; color: #888; }
            .sa-btn:disabled { opacity: .5; cursor: default; }
            .modal-status { font-size: 12px; margin-top: 8px; min-height: 15px; }
            .modal-status.ok { color: #22c55e; }
            .modal-status.err { color: #f87171; }
            @media (max-width: 760px) {
                .users-table thead th:nth-child(2), .users-table tbody td:nth-child(2) { display: none; }
            }
    body
        - var saPage = 'users'
        include ../../includes/sa-nav

        .sa-header(style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:32px 0 24px")
            .sa-header__left
                h1 👥 Utilisateurs
                p(style="font-size:13px;color:#555;margin-top:4px") Comptes personnels. Le plan est géré par établissement (onglet Établissements).
            .sa-header__right(style="display:flex;gap:10px;align-items:center")
                button.act-btn.act-btn--msg#broadcastBtn(type="button" style="padding:8px 14px;font-size:12.5px") 📢 Message à tous
                span.badge= users.length + ' utilisateurs'

        - var disabled = disabledCount || 0
        - var active = users.length - disabled
        .stats-row
            .stat-card
                .stat-card__value= users.length
                .stat-card__label Comptes
            .stat-card
                .stat-card__value.stat-card__value--green= active
                .stat-card__label Actifs
            .stat-card
                .stat-card__value(class=disabled ? 'stat-card__value--red' : '')= disabled
                .stat-card__label Désactivés
            .stat-card
                .stat-card__value= adminsToday || 0
                .stat-card__label Inscrits aujourd'hui
            .stat-card
                .stat-card__value= (totalViews || 0).toLocaleString('fr-FR')
                .stat-card__label Vues totales
            .stat-card
                .stat-card__value= (uniqueViews || 0).toLocaleString('fr-FR')
                .stat-card__label Vues uniques
            .stat-card
                .stat-card__value= totalClients || 0
                .stat-card__label Clients (total)
            .stat-card
                .stat-card__value= clientsToday || 0
                .stat-card__label Clients aujourd'hui

        if topSources && topSources.length
            - var maxSourceCount = Math.max.apply(null, topSources.map(function(s){ return s.count; }))
            .sources-card
                .sources-card__title Provenance des vues
                each s in topSources
                    .source-row
                        .source-row__name= s._id || 'direct'
                        .source-row__bar-wrap
                            .source-row__bar(style=`width:${Math.round((s.count / maxSourceCount) * 100)}%`)
                        .source-row__count= s.count.toLocaleString('fr-FR')

        .search-bar
            form(method="GET" action="/superadmin")
                input(type="text" name="search" placeholder="Rechercher par nom ou email..." value=search)
                button(type="submit") Rechercher
                if search
                    a(href="/superadmin" style="font-size:13px;color:#555;text-decoration:none;margin-left:8px;align-self:center;") ✕ Effacer

        if users.length === 0
            .empty-state Aucun utilisateur trouvé.
        else
            table.users-table
                thead
                    tr
                        th Utilisateur
                        th Établissement(s)
                        th Inscrit le
                        th Statut
                        th Actions
                tbody
                    each u in users
                        tr(data-user-id=String(u._id))
                            td
                                .user-info__name= u.fullName || '—'
                                .user-info__email= u.email
                            td
                                if u.establishments && u.establishments.length
                                    - var uPlan = (u.planKey === 'basic' || !u.planKey) ? 'free' : u.planKey
                                    .estabs
                                        each e in u.establishments
                                            .estab-chip
                                                span= e.name || ('/' + (e.slug || '—'))
                                                span.estab-plan(class='estab-plan--' + uPlan)= u.planLabel
                                                if e.isPaused
                                                    span.estab-paused ⏸
                                else
                                    span.no-estab —
                            td.date-col= new Date(u.createdAt).toLocaleDateString('fr-FR')
                            td
                                label.acc-toggle(class=u.isDisabled ? 'acc-toggle--disabled-state' : '')
                                    input(type="checkbox" class="acc-status-toggle" data-user-id=String(u._id) checked=(!u.isDisabled))
                                    span.acc-toggle__track
                                    span.acc-toggle__label= u.isDisabled ? 'Désactivé' : 'Actif'
                            td
                                .act-btns
                                    button.act-btn.act-btn--msg(type="button" data-msg-user-id=String(u._id) data-user-name=(u.fullName || u.email)) ✉️ Message
                                    button.act-btn(type="button" data-imp-user-id=String(u._id) title="Accéder au compte") 🔒 Accès
                                    button.act-btn.act-btn--del(type="button" data-del-user-id=String(u._id) data-user-name=(u.fullName || u.email) title="Supprimer définitivement") 🗑️

        //- ── Modale de composition de message ──────────────────────────────
        .sa-modal-overlay#msgOverlay
            .sa-modal
                h3.sa-modal__title ✉️ Envoyer un message
                p.sa-modal__sub#msgSub À : <b id="msgTo">—</b>
                .field
                    label.field__label Tonalité
                    .type-chips#msgTypeChips
                        button.type-chip.active(type="button" data-type="info") ℹ️ Info
                        button.type-chip(type="button" data-type="tip") 💡 Conseil
                        button.type-chip(type="button" data-type="success") ✅ Succès
                        button.type-chip(type="button" data-type="warning") ⚠️ Alerte
                        button.type-chip(type="button" data-type="security") 🔒 Sécurité
                .field
                    label.field__label Titre
                    input.input#msgTitle(type="text" maxlength="140" placeholder="ex. Bienvenue sur BranShee !")
                .field
                    label.field__label Message
                    textarea.textarea#msgBody(maxlength="4000" placeholder="Votre message…")
                .field
                    label.field__label Bouton (optionnel) — texte / lien
                    div(style="display:flex;gap:8px")
                        input.input#msgCtaLabel(type="text" maxlength="60" placeholder="ex. Voir")
                        input.input#msgCtaUrl(type="text" maxlength="500" placeholder="/subscription")
                .modal-status#msgStatus
                .sa-modal__actions
                    button.sa-btn.sa-btn--primary#msgSend(type="button") Envoyer
                    button.sa-btn.sa-btn--ghost#msgCancel(type="button") Annuler

        script(src="/js/utils/confirm-modal.js")
        script.
            // ── Statut actif / désactivé ──────────────────────────────
            document.querySelectorAll('.acc-status-toggle').forEach(function(checkbox) {
                checkbox.addEventListener('change', async function() {
                    const userId = this.dataset.userId;
                    const label = this.closest('.acc-toggle').querySelector('.acc-toggle__label');
                    const wrapper = this.closest('.acc-toggle');
                    try {
                        const res = await fetch('/superadmin/toggle-account/' + userId, { method: 'PATCH', headers: { 'Content-Type': 'application/json' } });
                        const data = await res.json();
                        if (!data.success) throw new Error('Failed');
                        if (data.isDisabled) { label.textContent = 'Désactivé'; wrapper.classList.add('acc-toggle--disabled-state'); }
                        else { label.textContent = 'Actif'; wrapper.classList.remove('acc-toggle--disabled-state'); }
                    } catch(e) {
                        this.checked = !this.checked;
                        alert('Erreur lors de la mise à jour du statut.');
                    }
                });
            });

            // ── Suppression d'un compte ───────────────────────────────
            document.querySelectorAll('[data-del-user-id]').forEach(function(btn) {
                btn.addEventListener('click', async function() {
                    const userId = this.dataset.delUserId;
                    const userName = this.dataset.userName;
                    const confirmed = await window.confirmModal(
                        'Supprimer "' + userName + '" ?',
                        'Toutes ses données (réservations, services, employés...) seront définitivement supprimées. Cette action est irréversible.'
                    );
                    if (!confirmed) return;
                    this.disabled = true;
                    this.textContent = '⏳';
                    try {
                        const res = await fetch('/superadmin/users/' + userId, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } });
                        const data = await res.json();
                        if (!data.success) throw new Error(data.error || 'Failed');
                        this.closest('tr').remove();
                    } catch(e) {
                        this.disabled = false;
                        this.textContent = '🗑️';
                        // Message réel du serveur affiché (au lieu d'un texte
                        // générique toujours identique) — pour comprendre la
                        // vraie cause si ça échoue encore.
                        await window.alertModal(e.message && e.message !== 'Failed' ? e.message : 'Erreur lors de la suppression du compte.');
                    }
                });
            });

            // ── Impersonation (accès discret) ─────────────────────────
            document.querySelectorAll('[data-imp-user-id]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var userId = btn.dataset.impUserId;
                    var form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/superadmin/impersonate/' + userId;
                    document.body.appendChild(form);
                    form.submit();
                });
            });

            // ── Modale de composition de message ──────────────────────
            (function() {
                var overlay = document.getElementById('msgOverlay');
                var toEl = document.getElementById('msgTo');
                var titleEl = document.getElementById('msgTitle');
                var bodyEl = document.getElementById('msgBody');
                var ctaLabel = document.getElementById('msgCtaLabel');
                var ctaUrl = document.getElementById('msgCtaUrl');
                var sendBtn = document.getElementById('msgSend');
                var cancelBtn = document.getElementById('msgCancel');
                var status = document.getElementById('msgStatus');
                var type = 'info';
                var targetUserId = null; // null = broadcast

                document.querySelectorAll('#msgTypeChips .type-chip').forEach(function(c) {
                    c.addEventListener('click', function() {
                        document.querySelectorAll('#msgTypeChips .type-chip').forEach(function(x) { x.classList.remove('active'); });
                        c.classList.add('active');
                        type = c.dataset.type;
                    });
                });

                function resetType() {
                    type = 'info';
                    document.querySelectorAll('#msgTypeChips .type-chip').forEach(function(x) { x.classList.toggle('active', x.dataset.type === 'info'); });
                }
                function open(userId, label) {
                    targetUserId = userId;
                    toEl.textContent = label;
                    titleEl.value = ''; bodyEl.value = ''; ctaLabel.value = ''; ctaUrl.value = '';
                    status.textContent = ''; status.className = 'modal-status';
                    resetType();
                    overlay.classList.add('open');
                    setTimeout(function() { titleEl.focus(); }, 50);
                }
                function close() { overlay.classList.remove('open'); }

                document.querySelectorAll('[data-msg-user-id]').forEach(function(btn) {
                    btn.addEventListener('click', function() { open(btn.dataset.msgUserId, btn.dataset.userName); });
                });
                var broadcastBtn = document.getElementById('broadcastBtn');
                if (broadcastBtn) broadcastBtn.addEventListener('click', function() { open(null, 'Tous les pros 📢'); });

                cancelBtn.addEventListener('click', close);
                overlay.addEventListener('click', function(e) { if (e.target === overlay) close(); });

                sendBtn.addEventListener('click', function() {
                    status.className = 'modal-status'; status.textContent = '';
                    if (!titleEl.value.trim() || !bodyEl.value.trim()) {
                        status.className = 'modal-status err'; status.textContent = 'Titre et message requis.'; return;
                    }
                    sendBtn.disabled = true; sendBtn.textContent = 'Envoi…';
                    fetch('/superadmin/messages', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            broadcast: targetUserId === null,
                            recipientId: targetUserId,
                            title: titleEl.value.trim(),
                            body: bodyEl.value.trim(),
                            type: type,
                            ctaLabel: ctaLabel.value.trim(),
                            ctaUrl: ctaUrl.value.trim(),
                        }),
                    }).then(function(r) { return r.json(); }).then(function(d) {
                        sendBtn.disabled = false; sendBtn.textContent = 'Envoyer';
                        if (d.success) {
                            status.className = 'modal-status ok'; status.textContent = '✅ Message envoyé !';
                            setTimeout(close, 900);
                        } else {
                            status.className = 'modal-status err'; status.textContent = d.error || 'Erreur.';
                        }
                    }).catch(function() {
                        sendBtn.disabled = false; sendBtn.textContent = 'Envoyer';
                        status.className = 'modal-status err'; status.textContent = 'Erreur réseau.';
                    });
                });
            })();
