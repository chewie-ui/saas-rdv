div(style="background-color: #f8fafc; padding: 40px 20px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #2d3436;")
  div(style="max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 14px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.06);")

    //- Header
    div(style="background-color: #ff5733; padding: 32px 40px; text-align: center;")
      h1(style="margin: 0; font-size: 22px; color: #ffffff; font-weight: 700;") 📩 Nouveau message de contact
      p(style="margin: 8px 0 0; color: rgba(255,255,255,0.85); font-size: 14px;") Reçu via le formulaire de contact SayMiro Calendar

    //- Body
    div(style="padding: 36px 40px;")

      //- Expéditeur
      div(style="background-color: #f8fafc; border-radius: 10px; padding: 20px; margin-bottom: 24px; border-left: 4px solid #ff5733;")
        p(style="margin: 0 0 6px; font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;") De
        p(style="margin: 0; font-size: 16px; font-weight: 600; color: #0f172a;") #{name} #{surname}
        a(href=`mailto:${email}` style="display: inline-block; margin-top: 4px; font-size: 14px; color: #ff5733; text-decoration: none;")= email

      //- Sujet
      div(style="margin-bottom: 20px;")
        p(style="margin: 0 0 6px; font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;") Sujet
        p(style="margin: 0; font-size: 15px; font-weight: 600; color: #0f172a;")= subject

      //- Message
      div(style="margin-bottom: 0;")
        p(style="margin: 0 0 10px; font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;") Message
        div(style="background-color: #f8fafc; border-radius: 10px; padding: 20px; font-size: 14px; line-height: 1.7; color: #374151; white-space: pre-line;")
          = message

    //- Répondre directement
    div(style="padding: 0 40px 32px; text-align: center;")
      a(
        href=`mailto:${email}?subject=Re: ${subject}`
        style="display: inline-block; background-color: #ff5733; color: #ffffff; padding: 14px 32px; border-radius: 30px; font-weight: 600; font-size: 14px; text-decoration: none;"
      ) Répondre à #{name}

    //- Footer
    div(style="text-align: center; padding: 20px 40px; background-color: #f8fafc; border-top: 1px solid #e5e7eb;")
      p(style="margin: 0; font-size: 12px; color: #94a3b8;") © #{new Date().getFullYear()} SayMiro Calendar — formulaire de contact automatique
