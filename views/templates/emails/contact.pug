-
  var _year = new Date().getFullYear()

div(style="margin:0;padding:0;background-color:#f4f7f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;")
  table(width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin:0;padding:0;background-color:#f4f7f5;")
    tr
      td(align="center" style="padding:40px 16px;")
        table(width="100%" cellpadding="0" cellspacing="0" role="presentation" style="max-width:580px;margin:0 auto;")

          //- ── Logo bar ───────────────────────────────────────────────────────
          tr
            td(align="center" style="padding:0 0 20px;")
              a(href="https://www.branshee.com" style="display:inline-block;text-decoration:none;")
                table(cellpadding="0" cellspacing="0" role="presentation" style="display:inline-table;")
                  tr
                    td(valign="middle" style="padding-right:8px;")
                      span(style="display:block;width:32px;height:32px;background:#1a7a4a;border-radius:9px;font-size:16px;font-weight:800;color:#ffffff;font-family:-apple-system,BlinkMacSystemFont,sans-serif;text-align:center;line-height:32px;") B
                    td(valign="middle")
                      span(style="font-size:15px;font-weight:700;color:#1e2923;letter-spacing:-0.2px;") BranShee

          //- ── Card ───────────────────────────────────────────────────────────
          tr
            td(style="background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.06);border:1px solid #e5ede8;")

              //- Header
              table(width="100%" cellpadding="0" cellspacing="0" role="presentation")
                tr
                  td(style="background:#1a7a4a;padding:30px 40px;text-align:center;")
                    p(style="margin:0;font-size:20px;font-weight:700;color:#ffffff;letter-spacing:-0.3px;") 📩 Nouveau message de contact
                    p(style="margin:8px 0 0;font-size:13px;color:rgba(255,255,255,0.72);") Reçu via le formulaire de contact BranShee

              //- Body
              table(width="100%" cellpadding="0" cellspacing="0" role="presentation")
                tr
                  td(style="padding:32px 40px;")

                    //- Expéditeur
                    table(width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:24px;background:#f8faf9;border-radius:10px;border-left:3px solid #1a7a4a;")
                      tr
                        td(style="padding:18px 20px;")
                          p(style="margin:0 0 4px;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.5px;") Expéditeur
                          p(style="margin:0;font-size:16px;font-weight:700;color:#1e2923;") #{name} #{surname}
                          a(href=`mailto:${email}` style="display:inline-block;margin-top:4px;font-size:13px;color:#1a7a4a;text-decoration:none;")= email

                    //- Sujet
                    table(width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:20px;")
                      tr
                        td
                          p(style="margin:0 0 6px;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.5px;") Sujet
                          p(style="margin:0;font-size:15px;font-weight:600;color:#1e2923;")= subject

                    //- Message
                    table(width="100%" cellpadding="0" cellspacing="0" role="presentation")
                      tr
                        td
                          p(style="margin:0 0 10px;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.5px;") Message
                          table(width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background:#f8faf9;border-radius:10px;border:1px solid #e0ebe5;")
                            tr
                              td(style="padding:18px 20px;font-size:14px;line-height:1.7;color:#374151;white-space:pre-line;")= message

              //- Reply button
              table(width="100%" cellpadding="0" cellspacing="0" role="presentation")
                tr
                  td(style="padding:0 40px 36px;text-align:center;")
                    a(
                      href=`mailto:${email}?subject=Re: ${subject}`
                      style="display:inline-block;background:#1a7a4a;color:#ffffff;padding:13px 30px;border-radius:8px;font-weight:600;font-size:14px;text-decoration:none;"
                    ) Répondre à #{name}

              //- Footer
              table(width="100%" cellpadding="0" cellspacing="0" role="presentation")
                tr
                  td(style="padding:20px 40px;background:#f8faf9;border-top:1px solid #e8efeb;text-align:center;")
                    p(style="margin:0;font-size:12px;color:#9ca3af;") Message automatique — formulaire de contact BranShee
                    p(style="margin:8px 0 0;font-size:11px;color:#d1d5db;") © #{_year} BranShee. Tous droits réservés.
