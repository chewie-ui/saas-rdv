-
  var _year = new Date().getFullYear()
  var _clientName = (name || '') + (surname ? ' ' + surname : '')
  var _dateStr = date ? new Date(date).toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' }) : ''

div(style="margin:0;padding:0;background-color:#f4f7f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;")
  table(width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin:0;padding:0;background-color:#f4f7f5;")
    tr
      td(align="center" style="padding:40px 16px;")
        table(width="100%" cellpadding="0" cellspacing="0" role="presentation" style="max-width:580px;margin:0 auto;")

          //- ── Logo bar ───────────────────────────────────────────────────────
          tr
            td(align="center" style="padding:0 0 20px;")
              a(href="https://www.branshee.com" style="display:inline-block;text-decoration:none;")
                table(cellpadding="0" cellspacing="0" role="presentation" style="display:inline-table;")
                  tr
                    td(valign="middle" style="padding-right:8px;")
                      span(style="display:block;width:32px;height:32px;background:#1a7a4a;border-radius:9px;font-size:16px;font-weight:800;color:#ffffff;font-family:-apple-system,BlinkMacSystemFont,sans-serif;text-align:center;line-height:32px;") B
                    td(valign="middle")
                      span(style="font-size:15px;font-weight:700;color:#1e2923;letter-spacing:-0.2px;") BranShee

          //- ── Card ───────────────────────────────────────────────────────────
          tr
            td(style="background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.06);border:1px solid #e5ede8;")

              //- Header
              table(width="100%" cellpadding="0" cellspacing="0" role="presentation")
                tr
                  td(style="background:#1e2923;padding:36px 40px;text-align:center;")
                    table(cellpadding="0" cellspacing="0" role="presentation" style="margin:0 auto 16px;")
                      tr
                        td(style="width:52px;height:52px;background:rgba(255,255,255,0.10);border-radius:50%;text-align:center;vertical-align:middle;")
                          span(style="font-size:22px;line-height:52px;") ✕
                    p(style="margin:0;font-size:22px;font-weight:700;color:#ffffff;letter-spacing:-0.3px;") Rendez-vous annulé
                    p(style="margin:8px 0 0;font-size:14px;color:rgba(255,255,255,0.65);") Votre rendez-vous a été annulé par l'établissement.

              //- Greeting
              table(width="100%" cellpadding="0" cellspacing="0" role="presentation")
                tr
                  td(style="padding:28px 40px 0;")
                    p(style="margin:0;font-size:15px;color:#374151;line-height:1.6;")
                      | Bonjour&nbsp;
                      strong(style="color:#1e2923;")= _clientName
                      | ,
                    p(style="margin:12px 0 0;font-size:14px;color:#6b7280;line-height:1.65;") Nous vous informons que votre rendez-vous a été annulé. Voici le récapitulatif :

              //- Detail card
              table(width="100%" cellpadding="0" cellspacing="0" role="presentation")
                tr
                  td(style="padding:20px 40px 32px;")
                    table(width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background:#f8faf9;border:1px solid #e0ebe5;border-radius:12px;")
                      tr
                        td(style="padding:24px 28px;")

                          //- Date / time
                          table(width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:16px;")
                            tr
                              td(width="36" valign="top" style="padding-top:1px;")
                                span(style="font-size:20px;") 📅
                              td(style="padding-left:12px;")
                                p(style="margin:0;font-weight:600;font-size:13px;color:#6b7280;text-transform:uppercase;letter-spacing:0.5px;") Date
                                p(style="margin:4px 0 0;font-size:14px;color:#1e2923;font-weight:500;text-transform:capitalize;")= _dateStr
                                p(style="margin:3px 0 0;font-size:13px;color:#9ca3af;") #{startHour} — #{endHour}

                          //- Client name
                          table(width="100%" cellpadding="0" cellspacing="0" role="presentation")
                            tr
                              td(width="36" valign="top" style="padding-top:1px;")
                                span(style="font-size:20px;") 👤
                              td(style="padding-left:12px;")
                                p(style="margin:0;font-weight:600;font-size:13px;color:#6b7280;text-transform:uppercase;letter-spacing:0.5px;") Client
                                p(style="margin:4px 0 0;font-size:14px;color:#1e2923;font-weight:500;")= _clientName

              //- Message
              table(width="100%" cellpadding="0" cellspacing="0" role="presentation")
                tr
                  td(style="padding:0 40px 36px;text-align:center;")
                    p(style="margin:0;font-size:13px;color:#9ca3af;line-height:1.65;") Si vous avez des questions, n'hésitez pas à contacter l'établissement directement.

              //- Footer
              table(width="100%" cellpadding="0" cellspacing="0" role="presentation")
                tr
                  td(style="padding:20px 40px;background:#f8faf9;border-top:1px solid #e8efeb;text-align:center;")
                    p(style="margin:0;font-size:13px;color:#9ca3af;") Nous espérons vous revoir bientôt.
                    p(style="margin:8px 0 0;font-size:11px;color:#d1d5db;") © #{_year} BranShee. Tous droits réservés.
                    p(style="margin:6px 0 0;font-size:11px;")
                      a(href="https://www.branshee.com" style="color:#b8ccbe;text-decoration:none;") www.branshee.com
