div(style="background-color: #f8f8f8; padding: 40px 20px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #2d3436;")
  div(style="max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.05);")

    //- Header
    div(style="padding: 40px 20px; text-align: center;")
      div(style="width: 60px; height: 60px; background-color: #e74c3c; border-radius: 50%; margin: 0 auto 20px; display: flow-root;")
        span(style="color: white; font-size: 30px; line-height: 60px; justify-content: center;") ✕

      h1(style="margin: 0; font-size: 24px; color: #1e272e;") Rendez-vous annulé
      p(style="margin-top: 10px; color: #636e72;") Votre rendez-vous a été annulé par l'établissement.

    //- Carte de détails
    div(style="padding: 0 40px 40px;")
      div(style="background-color: #fff5f5; border-radius: 10px; padding: 25px; border: 1px solid #fde0e0;")

        //- Date
        div(style="display: flex; align-items: center; margin-bottom: 20px;")
          span(style="font-size: 20px; margin-right: 15px;") 📅
          div
            p(style="margin: 0; font-weight: bold; color: #2d3436;")= new Date(date).toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' })
            p(style="margin: 0; font-size: 14px; color: #636e72;") #{startHour} — #{endHour}

        //- Client
        div(style="display: flex; align-items: center;")
          span(style="font-size: 20px; margin-right: 15px;") 👤
          div
            p(style="margin: 0; font-weight: bold; color: #2d3436;") #{name} #{surname}

      //- Message
      div(style="text-align: center; margin-top: 30px;")
        p(style="color: #636e72; font-size: 14px;") Si vous avez des questions, n'hésitez pas à nous contacter directement.

    //- Footer
    div(style="text-align: center; padding: 20px; background-color: #fafafa; border-top: 1px solid #f1f1f1;")
      p(style="font-size: 14px; color: #b2bec3; margin: 0;") Nous espérons vous revoir bientôt.
      p(style="font-size: 12px; color: #dfe6e9; margin-top: 10px;") © #{new Date().getFullYear()} SayMiro Calendar. Tous droits réservés.
