mixin calendar()
    #renderCalendar
        .calendar-wrapper
            .calendar
                .calendar-header
                    .prev-month
                        button.btn#prevMonthBtn.sec= t.calendar_t.prev
                    .this-month
                        h2
                    .next-month
                        button.btn#nextMonthBtn.sec= t.calendar_t.next
                .calendar-body
                    .weekdays
                        //- Injected from JS
                    .days
                        //- Injected from JS
                .calendar-action
                    button.btn#closeCalendar.sec= t.calendar_t.close