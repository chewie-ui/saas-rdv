mixin calendar()
    #renderCalendar
        .calendar-wrapper
            .calendar
                .calendar-header
                    .prev-month
                        button.btn#prevMonthBtn.sec Prev
                    .this-month
                        h2
                    .next-month
                        button.btn#nextMonthBtn.sec Next
                .calendar-body
                    .weekdays
                        //- Injected from JS
                    .days
                        //- Injected from JS
                .calendar-action
                    button.btn#closeCalendar.sec Close