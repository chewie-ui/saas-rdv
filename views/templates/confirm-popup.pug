
mixin confirmPopup()
    .confirm-popup
        .confirm-popup__wrapper
            .confirm-popup__title 
            .confirm-popup__description
            .confirm-popup__actions
                button.sm-btn.sm-btn--ghost.cancel-btn
                    span= t.popup.cancel
                button.sm-btn.sm-btn--primary.confirm-btn
                    span= t.popup.confirm

    