footer.footer
    .footer__container.container
        .footer__top
            .footer__logo
                img(src="/images/icon.webp" alt="GymIo Logo")
                h2 SayMiro
            .footer__links
                a(href="/")= t.footer.book_now
                a(href="/manage-business")= t.footer.become_coach
                a(href="/login")= t.footer.login
                a(href="/contact")= t.footer.contact
                a(href="/mes-rdv") Mes rendez-vous
        .footer__legal
            a(href="/confidentialite") Politique de confidentialité
            a(href="/conditions-utilisation") Conditions d'utilisation
        .footer__bottom
            p #{t.footer.rights} #{new Date().getFullYear()} SayMiro Calendar. #{t.footer.made_by} 
                a(href="https://skydev.be" target="_blank") Skydev