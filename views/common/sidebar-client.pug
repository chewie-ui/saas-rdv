aside.sidebar#sidebar
    .sb-wrap

        //- ── Header: logo + close ──────────────────────────────────
        .sb-header
            //- Depuis l'espace client, le logo renvoie vers /search
            //- (page de recherche) et non vers / (landing page marketing).
            a.sb-logo(href="/search")
                img.sb-logo__mark(src="/images/icon.svg" alt="BranShee")
                span.sb-logo__name BranShee
            button.sb-close#closeSidebar(type="button" aria-label="Fermer le menu")
                svg(viewBox="0 -960 960 960" height="20" width="20" fill="currentColor")
                    path(d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z")


        //- ── Navigation ───────────────────────────────────────────
        nav.sb-nav

            .sb-section
                p.sb-section__hd Mon espace
                a.sb-link(href="/espace-client" class=pageName === 'Dashboard' ? 'active' : '')
                    svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                        path(d="M200-640h560v-80H200v80Zm0 0v-80 80Zm0 560q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T800-120H200Zm0-80h560v-400H200v400Zm80-40h160v-160H280v160Zm240 0h160v-40H520v40Zm0-120h160v-40H520v40Zm-240-120h400v-80H280v80Z")
