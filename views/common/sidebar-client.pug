        //- ── Footer: user profile ────────────────────────────────
        .sb-foot
            .sb-user
                .sb-user__avatar
                    img(src=client.profilePicture || '/images/no-user.webp' alt=client.fullName)
                .sb-user__info
                    span.sb-user__name= client.fullName
                    span.sb-user__plan= client.email
