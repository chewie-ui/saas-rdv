.header(class=alwaysSticky ? 'sticky' : '')
    input#headerNav.header__cb(type="checkbox" aria-hidden="true")

    .header__bar.container
        //- Logo
        a.header__logo(href="/")
            .header__logo-img
                img(src="/images/icon.svg" alt="BranShee")
            span.header__logo-name BranShee

        //- ── Liens de pages (ordinateur) ─────────────────────────────────
        //- Quatre entrées seulement. Une barre publique n'est pas un plan du
        //- site : chaque lien ajouté dilue les trois autres et repousse les
        //- boutons d'action. Le reste vit dans le pied de page.
        //-
        //- `reqPath` est posé par app.js (req.path, "" pour l'accueil) : c'est
        //- lui qui marque la page courante — un lien actif calculé en
        //- JavaScript clignoterait au chargement.
        -
            var _pages = [
                { href: '/',        libelle: t.header.nav.home,    actif: !reqPath },
                { href: '/search',  libelle: t.header.nav.search,  actif: reqPath === '/search' },
                { href: '/blog',    libelle: t.header.nav.blog,    actif: (reqPath || '').indexOf('/blog') === 0 },
                { href: '/contact', libelle: t.header.nav.contact, actif: reqPath === '/contact' },
            ];
        nav.header__pages(aria-label="Navigation principale")
            each p in _pages
                a.header__page(href=p.href class=p.actif ? 'is-active' : '' aria-current=p.actif ? 'page' : false)= p.libelle

        //- Right side
        .header__right
            //- Boutons nav (desktop inline, mobile dans le panel)
            nav.header__nav
                if user
                    //- Identité unifiée (cf. plan d'unification) : toujours
                    //- "Espace client" en premier, peu importe pro ou pas —
                    //- le second bouton dépend de s'il a déjà un établissement.
                    //- La déconnexion reste accessible depuis l'espace client.
                    a.sm-btn.sm-btn--ghost.header__btn--ghost(href="/espace-client")
                        span= t.header.my_space
                    if hasEstablishment
                        a.sm-btn.sm-btn--primary(href="/appointment")
                            span= t.header.manage_establishment
                    else
                        a.sm-btn.sm-btn--primary(href="/etablissement/mes-etablissements")
                            span= t.header.start_establishment
                    //- Déconnexion : elle n'était accessible QUE depuis l'espace
                    //- client ou la barre latérale admin. Sur un ordinateur
                    //- partagé, quelqu'un connecté n'avait aucun moyen visible
                    //- de fermer sa session depuis la vitrine.
                    a.header__logout(href="/logout" title=t.header.logout aria-label=t.header.logout)
                        svg(viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true")
                            path(d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h280v80H200Zm440-160-55-58 102-102H360v-80h327L585-622l55-58 200 200-200 200Z")
                else
                    if becomeCoach
                        a.sm-btn.sm-btn--ghost.header__btn--ghost(href="/login")
                            span= t.header.login
                        a.sm-btn.sm-btn--primary(href="/register")
                            span= t.header.register
                    else if clientAuth
                        if clientUser
                            a.sm-btn.sm-btn--ghost.header__btn--ghost(href="/espace-client")
                                span= t.header.my_space
                            a.sm-btn.sm-btn--primary(href="/logout")
                                span= t.header.logout
                        else
                            a.sm-btn.sm-btn--ghost.header__btn--ghost(href="/login")
                                span= t.header.login
                            a.sm-btn.sm-btn--primary(href="/register?intent=client")
                                span= t.header.register
                    else
                        if clientUser
                            a.sm-btn.sm-btn--ghost.header__btn--ghost(href="/espace-client")
                                span= t.header.my_space
                            //- Visiteur déjà connecté en tant que client → proposer de créer un compte pro
                            //- (vers /register : le libellé promet "gratuit", donc plan Starter sans carte)
                            a.sm-btn.sm-btn--primary(href="/register")
                                span= t.header.register
                        else
                            a.sm-btn.sm-btn--ghost.header__btn--ghost(href="/login")
                                span= t.header.client_account
                            a.sm-btn.sm-btn--primary(href="/register")
                                span= t.header.register

            //- Installer (bureau) : masqué par le JS tant que le navigateur ne
            //- sait pas installer. Icône seule pour ne pas alourdir la barre,
            //- l'intitulé est dans l'infobulle.
            button.header__install#headerInstall(type="button" hidden data-pwa-install aria-label=t.pwa.install_title title=t.pwa.install_title)
                svg(viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true")
                    path(d="M480-320 280-520l56-58 104 104v-326h80v326l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z")

            //- Séparateur desktop
            .header__sep

            //- Toggle thème
            button.theme-toggle.secondary.circle(type="button" aria-label="Changer le thème" title="Changer le thème" style="display:none")
                svg.theme-toggle__moon(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24")
                    path(d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z")
                <svg class='theme-toggle__sun hidden' xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M440-760v-160h80v160h-80Zm266 110-55-55 112-115 56 57-113 113Zm54 210v-80h160v80H760ZM440-40v-160h80v160h-80ZM254-652 140-763l57-56 113 113-56 54Zm508 512L651-255l54-54 114 110-57 59ZM40-440v-80h160v80H40Zm157 300-56-57 112-112 29 27 29 28-114 114Zm113-170q-70-70-70-170t70-170q70-70 170-70t170 70q70 70 70 170t-70 170q-70 70-170 70t-170-70Z"/></svg>
            //- Sélecteur de langue
            .header__lang#headerLang
                button.lang-trigger(type="button" aria-label="Langue")
                    img.lang-trigger__flag(src=(lang === 'fr' ? '/images/fr.webp' : lang === 'nl' ? '/images/nl.jpg' : lang === 'es' ? '/images/es.jpg' : lang === 'it' ? '/images/it.png' : lang === 'de' ? '/images/de.png' : "/images/en.jpg") alt="" aria-hidden="true" width="18" height="18")
                    span.lang-trigger__code= lang === 'fr' ? 'FR' : lang === 'nl' ? 'NL' : lang === 'es' ? 'ES' : lang === 'it' ? 'IT' : lang === 'de' ? 'DE' : 'EN'
                    svg.lang-trigger__chevron(viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                        polyline(points="6 9 12 15 18 9")
                .header__lang-panel
                    button.lang-option(type="button" onclick="changeLanguage('fr')" class=lang === 'fr' ? 'active' : '')
                        img(src='/images/fr.webp' alt="FR")
                        span Français
                    button.lang-option(type="button" onclick="changeLanguage('en')" class=lang === 'en' ? 'active' : '')
                        img(src='/images/en.jpg' alt="EN")
                        span English
                    button.lang-option(type="button" onclick="changeLanguage('nl')" class=lang === 'nl' ? 'active' : '')
                        img(src='/images/nl.jpg' alt="NL")
                        span Nederlands
                    button.lang-option(type="button" onclick="changeLanguage('es')" class=lang === 'es' ? 'active' : '')
                        img(src='/images/es.jpg' alt="ES")
                        span Español
                    button.lang-option(type="button" onclick="changeLanguage('it')" class=lang === 'it' ? 'active' : '')
                        img(src='/images/it.png' alt="IT")
                        span Italiano
                    button.lang-option(type="button" onclick="changeLanguage('de')" class=lang === 'de' ? 'active' : '')
                        img(src='/images/de.png' alt="DE")
                        span Deutsch

            //- Burger (mobile seulement)
            label.header__burger(for="headerNav" aria-label="Menu")
                span
                span
                span

    //- Backdrop mobile
    label.header__backdrop(for="headerNav" aria-hidden="true")

    //- Panel mobile (slide-in)
    .header__panel
        //- En-tête du panneau : marque + fermeture explicite. Avant, le panneau
        //- s'ouvrait sans repère ni bouton de sortie — il fallait deviner qu'on
        //- pouvait toucher le fond pour le refermer.
        .header__panel-head
            .header__panel-brand
                img(src="/images/icon.svg" alt="" width="30" height="30")
                span BranShee
            label.header__panel-close(for="headerNav" aria-label="Fermer le menu")
                svg(viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true")
                    path(d="M256-200l-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z")

        nav.header__panel-nav
            if user
                a.sm-btn.sm-btn--ghost.header__btn--ghost(href="/espace-client")
                    span= t.header.my_space
                if hasEstablishment
                    a.sm-btn.sm-btn--primary(href="/appointment")
                        span= t.header.manage_establishment
                else
                    a.sm-btn.sm-btn--primary(href="/etablissement/mes-etablissements")
                        span= t.header.start_establishment
                //- Idem en mobile : sans ça, aucune sortie de session visible.
                a.sm-btn.sm-btn--ghost.header__btn--ghost(href="/logout")
                    span= t.header.logout
            else
                //- L'inscription est TOUJOURS le bouton primaire pour un
                //- visiteur anonyme (le trafic Ads est surtout mobile) — et
                //- un bouton libellé "Commencer gratuitement" doit mener au
                //- plan gratuit sans carte (/register), jamais au flux Pro
                //- avec carte requise.
                if becomeCoach
                    a.sm-btn.sm-btn--primary(href="/register")
                        span= t.header.register
                    a.sm-btn.sm-btn--ghost.header__btn--ghost(href="/login")
                        span= t.header.login
                else if clientAuth
                    if clientUser
                        a.sm-btn.sm-btn--primary(href="/espace-client")
                            span= t.header.my_space
                        a.sm-btn.sm-btn--ghost.header__btn--ghost(href="/logout")
                            span= t.header.logout
                    else
                        a.sm-btn.sm-btn--primary(href="/register?intent=client")
                            span= t.header.register
                        a.sm-btn.sm-btn--ghost.header__btn--ghost(href="/login")
                            span= t.header.login
                else
                    if clientUser
                        a.sm-btn.sm-btn--primary(href="/register")
                            span= t.header.register
                        a.sm-btn.sm-btn--ghost(href="/espace-client")
                            span= t.header.my_space
                    else
                        a.sm-btn.sm-btn--primary(href="/register")
                            span= t.header.register
                        a.sm-btn.sm-btn--ghost(href="/login")
                            span= t.header.client_account

        //- Mêmes quatre pages que la barre de l'ordinateur : deux inventaires
        //- différents selon la taille de l'écran, c'est un lien qu'on ne
        //- retrouve plus une fois passé sur téléphone.
        //- `/subscription` a été retiré : la route est réservée aux comptes
        //- pros connectés (requirePermission billing.manage), elle renvoyait
        //- donc un visiteur anonyme vers la connexion.
        .header__panel-links
            a.header__panel-link(href="/" class=!reqPath ? 'is-active' : '')
                svg(viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true")
                    path(d="M240-200h120v-240h240v240h120v-360L480-740 240-560v360Zm-80 80v-480l320-240 320 240v480H520v-240h-80v240H160Z")
                span= t.header.nav.home
            a.header__panel-link(href="/search" class=reqPath === '/search' ? 'is-active' : '')
                svg(viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true")
                    path(d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z")
                span= t.header.nav.search
            a.header__panel-link(href="/blog" class=(reqPath || '').indexOf('/blog') === 0 ? 'is-active' : '')
                svg(viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true")
                    path(d="M320-280h320v-80H320v80Zm0-160h320v-80H320v80ZM240-80q-33 0-56.5-23.5T160-160v-640q0-33 23.5-56.5T240-880h320l240 240v480q0 33-23.5 56.5T720-80H240Zm280-520v-200H240v640h480v-440H520Z")
                span= t.header.nav.blog
            a.header__panel-link(href="/contact" class=reqPath === '/contact' ? 'is-active' : '')
                svg(viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true")
                    path(d="M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h640q33 0 56.5 23.5T880-720v480q0 33-23.5 56.5T800-160H160Zm320-280 320-200v-80L480-520 160-720v80l320 200Z")
                span= t.header.nav.contact

        //- Bloc d'installation — masqué par défaut, révélé par le JS uniquement
        //- si l'installation est réellement possible (Android avec l'événement
        //- du navigateur, ou iOS où l'on montre la marche à suivre). Un bouton
        //- qui ne mène à rien serait pire que pas de bouton.
        button.header__panel-install#panelInstall(type="button" hidden data-pwa-install)
            span.header__panel-install__ico
                svg(viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true")
                    path(d="M280-40q-33 0-56.5-23.5T200-120v-720q0-33 23.5-56.5T280-920h200v80H280v40h200v80H280v520h400v-160h80v240q0 33-23.5 56.5T680-40H280Zm0-120v40h400v-40H280Zm400-280L520-600h120v-160h80v160h120L680-440Z")
            span.header__panel-install__txt
                span.header__panel-install__t= t.pwa.install_title
                span.header__panel-install__s= t.pwa.install_sub

        .header__panel-bottom
            //- Langue dans le panel
            .header__panel-lang
                button.header__panel-lang-btn(type="button" onclick="changeLanguage('fr')" class=lang === 'fr' ? 'active' : '')
                    img(src='/images/fr.webp')
                    span FR
                button.header__panel-lang-btn(type="button" onclick="changeLanguage('en')" class=lang === 'en' ? 'active' : '')
                    img(src='/images/en.jpg')
                    span EN
                button.header__panel-lang-btn(type="button" onclick="changeLanguage('nl')" class=lang === 'nl' ? 'active' : '')
                    img(src='/images/nl.jpg')
                    span NL
                button.header__panel-lang-btn(type="button" onclick="changeLanguage('es')" class=lang === 'es' ? 'active' : '')
                    img(src='/images/es.jpg')
                    span ES
                button.header__panel-lang-btn(type="button" onclick="changeLanguage('it')" class=lang === 'it' ? 'active' : '')
                    img(src='/images/it.png')
                    span IT
                button.header__panel-lang-btn(type="button" onclick="changeLanguage('de')" class=lang === 'de' ? 'active' : '')
                    img(src='/images/de.png')
                    span DE
