                    span= t.sidebar.a_support
                if currentCompany
                    a.sb-foot-link.sb-foot-link--ext(href=`/${currentCompany.slug || currentCompany._id}` target="_blank")
                        svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                            path(d="M200-640h560v-80H200v80Zm0 0v-80 80Zm0 560q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T800-80H200Zm0-80h600v-400H200v400Zm0-480h600v-80H200v80Z")
