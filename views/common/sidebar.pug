                            a.sb-link(href="/forms" class=pageName === t.sidebar.a_9 ? 'active' : '')
                                svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                    path(d="M348.5-291.5Q360-303 360-320t-11.5-28.5Q337-360 320-360t-28.5 11.5Q280-337 280-320t11.5 28.5Q303-280 320-280t28.5-11.5Zm0-160Q360-463 360-480t-11.5-28.5Q337-520 320-520t-28.5 11.5Q280-497 280-480t11.5 28.5Q303-440 320-440t28.5-11.5Zm0-160Q360-623 360-640t-11.5-28.5Q337-680 320-680t-28.5 11.5Q280-657 280-640t11.5 28.5Q303-600 320-600t28.5-11.5ZM440-280h240v-80H440v80Zm0-160h240v-80H440v80Zm0-160h240v-80H440v80ZM200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Zm0-80h560v-560H200v560Zm0-560v560-560Z")
                                span= t.sidebar.a_9

                //- ── 3. Communication ─────────────────────────────────
                .sb-section
                    span.sb-section__title Communication
                    .sb-section__links
                        a.sb-link(href="/mon-site" class=pageName === 'MonSite' ? 'active' : '')
                            svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                path(d="M200-160q-33 0-56.5-23.5T120-240v-480q0-33 23.5-56.5T200-800h560q33 0 56.5 23.5T840-720v480q0 33-23.5 56.5T800-160H200Zm0-80h560v-400H200v400Zm80-40h400v-80H280v80Zm0-160h400v-80H280v80Zm-80-200v-80 80Z")
                            span Mon site web
                        a.sb-link(href="/parrainage" class=pageName === 'Parrainage' ? 'active' : '')
                            svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                path(d="M160-80q-33 0-56.5-23.5T80-160v-440q0-33 23.5-56.5T160-680h200v-120q0-33 23.5-56.5T440-880h80q33 0 56.5 23.5T600-800v120h200q33 0 56.5 23.5T880-600v440q0 33-23.5 56.5T800-80H160Zm0-80h640v-440H600q0 33-23.5 56.5T520-520h-80q-33 0-56.5-23.5T360-600H160v440Zm200-40h240v-40q0-50-35-85t-85-35q-50 0-85 35t-35 85v40ZM440-600h80v-200h-80v200Zm80 160Z")
                            span Parrainage
                        a.sb-link(href="/sms" class=pageName === 'Sms' ? 'active' : '')
                            svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                path(d="M240-400h480v-80H240v80Zm0-120h480v-80H240v80Zm0-120h480v-80H240v80ZM80-80v-720q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v480q0 33-23.5 56.5T800-240H240L80-80Zm126-240h594v-480H160v525l46-45Zm-46 0v-480 480Z")
                            span SMS

                //- ── 4. Équipe ────────────────────────────────────────
                - const canSeeCollaborators = !!(currentCompany && permissions && permissions.collaborators.view)
                - const canSeeLogs = !!(permissions && permissions.logs.view)
                - const canSeeGrades = !!(currentCompany && permissions && permissions.grades && (permissions.grades.view || permissions.grades.manage))
                if canSeeCollaborators || canSeeLogs || canSeeGrades
                    .sb-section
                        span.sb-section__title= t.sidebar.section_team
                        .sb-section__links
                            if canSeeCollaborators
                                a.sb-link(href=`/etablissement/${currentCompany._id}/collaborateurs` class=pageName === 'Collaborateurs' ? 'active' : '')
                                    svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                        path(d="M0-240v-86q0-36 19-67t52-49q57-30 119-46t130-16q68 0 130 16t119 46q33 18 52 49t19 67v86H0Zm640 0v-86q0-36-19.5-67.5T568-441q44 6 89.5 22.5T720-385q24 14 38 35.5t14 49.5v60h-132Zm-440-80h280v-6q0-15-9-26.5t-23-19.5q-44-24-91-36t-97-12q-50 0-97 12t-91 36q-14 8-23 19.5t-9 26.5v6Zm140-200q-50 0-85-35t-35-85q0-50 35-85t85-35q50 0 85 35t35 85q0 50-35 85t-85 35Zm320-40q-18 0-33-3t-29-8q14-21 21.5-46t7.5-53q0-28-7.5-53T568-758q14-5 29-8t33-3q50 0 85 35t35 85q0 50-35 85t-85 35Z")
                                    span= t.sidebar.a_collaborators
                                    if pendingMembershipsCount > 0
                                        span.sb-badge= pendingMembershipsCount > 9 ? '9+' : pendingMembershipsCount
                            if canSeeGrades
                                a.sb-link(href=`/etablissement/${currentCompany._id}/grades` class=pageName === 'Grades' ? 'active' : '')
                                    svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                        path(d="M480-80q-139-35-229.5-159.5T160-516v-244l320-120 320 120v244Q720-291 629-167T480-80Zm-40-200 198-198-57-57-141 141-57-57-56 56 113 115Z")
                                    span= t.sidebar.a_grades
                            if canSeeLogs
                                a.sb-link(href="/logs" class=pageName === 'Logs' ? 'active' : '')
                                    svg(viewBox="0 -960 960 960" height="18" width="18" fill="currentColor")
                                        path(d="M320-240h320v-80H320v80Zm0-160h320v-80H320v80ZM240-80q-33 0-56.5-23.5T160-160v-640q0-33 23.5-56.5T240-880h320l240 240v480q0 33-23.5 56.5T720-80H240Zm280-520v-200H240v640h480v-440H520ZM240-800v200-200 640-640Z")
                                    span= t.sidebar.a_logs


        //- ── Footer ───────────────────────────────────────────────
        .sb-foot
            //- Bottom links fixes (Voir calendrier). Paramètres n'est volontairement
            //- pas ici : il reste accessible via le menu profil (.sb-user-panel__item)
            //- pour éviter un doublon.
            .sb-foot-links
                a.sb-foot-link(href="/support" class=pageName === 'Support' ? 'is-active' : '')
