        //- ── Footer: language + user profile ─────────────────────
        .sb-foot

            //- Language selector (keeps .header__lang for admin.js toggle)
            .sb-lang.header__lang#sidebarLang
                button.sb-lang__btn.selector(type="button" aria-label="Language")
                    img.sb-lang__flag(src=(lang === 'fr' ? '/images/fr.webp' : lang === 'nl' ? '/images/nl.jpg' : lang === 'es' ? '/images/es.jpg' : lang === 'it' ? '/images/it.png' : lang === 'de' ? '/images/de.png' : "/images/en.jpg"))
                    span.sb-lang__code= (lang === 'fr' ? 'FR' : lang === 'nl' ? 'NL' : lang === 'es' ? 'ES' : lang === 'it' ? 'IT' : lang === 'de' ? 'DE' : 'EN')
                    svg.sb-lang__caret(viewBox="0 0 24 24" height="14" width="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                        polyline(points="6 9 12 15 18 9")
                .sb-lang__panel.header__lang-panel.selector-btn
                    button.sb-lang__opt(type="button" onclick="changeLanguage('fr')")
                        img(src='/images/fr.webp')
                        span Français
                    button.sb-lang__opt(type="button" onclick="changeLanguage('en')")
                        img(src='/images/en.jpg')
                        span English
                    button.sb-lang__opt(type="button" onclick="changeLanguage('nl')")
                        img(src='/images/nl.jpg')
                        span Nederlands
                    button.sb-lang__opt(type="button" onclick="changeLanguage('es')")
                        img(src='/images/es.jpg')
                        span Español
                    button.sb-lang__opt(type="button" onclick="changeLanguage('it')")
                        img(src='/images/it.png')
                        span Italiano
                    button.sb-lang__opt(type="button" onclick="changeLanguage('de')")
                        img(src='/images/de.png')
                        span Deutsch

            //- User profile chip
            .sb-user
                .sb-user__avatar
                    img(src=user.profilePicture alt=user.fullName)
                .sb-user__info
                    span.sb-user__name= user.fullName
                    if isPro
                        span.sb-user__badge(class=currentPlan === 'business' ? 'sb-user__badge--business' : '')
                            svg(viewBox="0 -960 960 960" height="10" width="10" fill="currentColor")
                                path(d="M200-160v-80h560v80H200Zm0-140-51-321q-2 0-4.5.5t-4.5.5q-25 0-42.5-17.5T80-680q0-25 17.5-42.5T140-740q25 0 42.5 17.5T200-680q0 7-1.5 13t-3.5 11l125 56 125-171q-11-8-18-21t-7-28q0-25 17.5-42.5T480-880q25 0 42.5 17.5T540-820q0 15-7 28t-18 21l125 171 125-56q-2-5-3.5-11t-1.5-13q0-25 17.5-42.5T820-740q25 0 42.5 17.5T880-680q0 25-17.5 42.5T820-620q-2 0-4.5-.5t-4.5-.5l-51 321H200Zm68-80h424l26-167-105 46-133-183-133 183-105-46 26 167Zm212 0Z")
