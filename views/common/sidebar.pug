                    svg.sb-lang__caret(viewBox="0 0 24 24" height="14" width="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                        polyline(points="6 9 12 15 18 9")
                .sb-lang__panel.header__lang-panel.selector-btn
                    button.sb-lang__opt(type="button" onclick="changeLanguage('fr')")
                        img(src='/images/fr.webp')
                        span Français
                    button.sb-lang__opt(type="button" onclick="changeLanguage('en')")
                        img(src='/images/en.jpg')
                        span English
                    button.sb-lang__opt(type="button" onclick="changeLanguage('nl')")
                        img(src='/images/nl.jpg')
                        span Nederlands
                    button.sb-lang__opt(type="button" onclick="changeLanguage('es')")
                        img(src='/images/es.jpg')
                        span Español
                    button.sb-lang__opt(type="button" onclick="changeLanguage('it')")
                        img(src='/images/it.png')
                        span Italiano
                    button.sb-lang__opt(type="button" onclick="changeLanguage('de')")
                        img(src='/images/de.png')
                        span Deutsch

            //- User profile chip + popup
            .sb-user-wrap#sidebarUserWrap
                button.sb-user#sidebarUserBtn(type="button")
                    .sb-user__avatar
                        img(src=user.profilePicture alt=user.fullName)
                    .sb-user__info
                        span.sb-user__name= user.fullName
                        if isPro
                            span.sb-user__badge(class=currentPlan === 'business' ? 'sb-user__badge--business' : '')
                                if currentPlan === 'business'
                                    | Business
                                else
                                    | Pro
                        else
                            span.sb-user__plan Free
                    svg(viewBox="0 0 24 24" height="14" width="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:.4")
                        path(d="M8 9l4-4 4 4M8 15l4 4 4-4")
                .sb-user-panel#sidebarUserPanel
                    .sb-user-panel__header
                        .sb-user-panel__avatar
                            img(src=user.profilePicture alt=user.fullName)
                        .sb-user-panel__info
                            span.sb-user-panel__name= user.fullName
                            span.sb-user-panel__email= user.email
                    .sb-user-panel__sep
                    a.sb-user-panel__item(href="/espace-client")
                        svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                            path(d="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-94q0-38 19-65t49-41q67-30 128.5-45T480-420q62 0 123 15.5T731.5-360q31 14 49.5 41t18 65v94H160Z")
                        span Mon espace client
                    a.sb-user-panel__item(href="/parrainage")
                        svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                            path(d="M500-482q29-32 44.5-73t15.5-85q0-44-15.5-85T500-798q60 8 100 53t40 105q0 60-40 105t-100 53Zm-180-38q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM0-160v-112q0-34 17.5-62.5T64-378q62-31 126-46.5T320-440q66 0 130 15.5T576-378q29 15 46.5 43.5T640-272v112H0Zm720 0v-120q0-36-16-68.5T662-406q51 18 94.5 46.5T800-286v126h-80Z")
                        span Parrainage
                    .sb-user-panel__sep
                    a.sb-user-panel__item.sb-user-panel__item--danger(href="/logout")
                        svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                            path(d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h280v80H200Zm440-160-55-58 102-102H360v-80h327L585-622l55-58 200 200-200 200Z")
                        span Déconnexion

    script.
        (function () {
            var STORAGE_KEY = 'sb_sections_v1';
            var saved = {};
            try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch (e) {}

            document.querySelectorAll('.sb-section[data-section]').forEach(function (section) {
                var key = section.dataset.section;
                var hd = section.querySelector('.sb-section__hd');
                var links = section.querySelector('.sb-section__links');
                if (!hd || !links) return;

                // Never collapse the section that holds the active link
                var hasActive = !!links.querySelector('.sb-link.active');
                if (hasActive) section.classList.add('has-active');

                // Default: all sections collapsed except the one with the active link
                // saved[key] === false means user explicitly opened it (override default)
                if (!hasActive && saved[key] !== false) {
                    section.classList.add('is-collapsed');
                }

                hd.addEventListener('click', function () {
                    var collapsed = section.classList.toggle('is-collapsed');
                    saved[key] = collapsed;
                    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(saved)); } catch (e) {}
                });
            });

            // User profile popup
            var userBtn = document.getElementById('sidebarUserBtn');
            var userPanel = document.getElementById('sidebarUserPanel');
            var userWrap = document.getElementById('sidebarUserWrap');
            if (userBtn && userPanel) {
                userBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var isOpen = userWrap.classList.toggle('is-open');
                    userPanel.style.display = isOpen ? 'block' : 'none';
                });
                document.addEventListener('click', function (e) {
                    if (!userWrap.contains(e.target)) {
                        userWrap.classList.remove('is-open');
                        userPanel.style.display = 'none';
                    }
                });
            }
        })();
