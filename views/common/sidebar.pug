aside.sidebar#sidebar
    .sidebar-wrapper

        .sidebar-bottom
            button.theme-toggle.theme-toggle--sidebar(type="button" aria-label="Passer en mode sombre" title="Changer le thème")
                svg.theme-toggle__moon(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor")
                    path(d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z")
                svg.theme-toggle__sun.hidden(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor")
                    circle(cx="12" cy="12" r="5")
                    line(x1="12" y1="1" x2="12" y2="3")
                    line(x1="12" y1="21" x2="12" y2="23")
                    line(x1="4.22" y1="4.22" x2="5.64" y2="5.64")
                    line(x1="18.36" y1="18.36" x2="19.78" y2="19.78")
                    line(x1="1" y1="12" x2="3" y2="12")
                    line(x1="21" y1="12" x2="23" y2="12")
                    line(x1="4.22" y1="19.78" x2="5.64" y2="18.36")
                    line(x1="18.36" y1="5.64" x2="19.78" y2="4.22")
                span.theme-toggle__label= t.common.dark_mode
            .sidebar-language
                .header__lang#sidebarLang
                    button.selector.secondary(type="button" aria-label="Langue")
                        span.header__lang-code 
                            img.header__lang-img(src=(lang === 'fr' ? '/images/fr.webp' : lang === 'nl' ? '/images/nl.jpg' : lang === 'es' ? '/images/es.jpg' : lang === 'it' ? '/images/it.png' : lang === 'de' ? '/images/de.png' : "/images/en.jpg"))
                            | #{lang === 'fr' ? 'FR' : lang === 'nl' ? 'NL' : lang === 'es' ? 'ES' : lang === 'it' ? 'IT' : lang === 'de' ? 'DE' : 'EN'}
                    .header__lang-panel.selector-btn
                        button.header__lang-option(type="button" onclick="changeLanguage('fr')")
                            img(src='/images/fr.webp')
                            span Français
                        button.header__lang-option(type="button" onclick="changeLanguage('en')")
                            img(src='/images/en.jpg')
                            span English
                        button.header__lang-option(type="button" onclick="changeLanguage('nl')")
                            img(src='/images/nl.jpg')
                            span Nederlands
                        button.header__lang-option(type="button" onclick="changeLanguage('es')")
                            img(src='/images/es.jpg')
                            span Español
                        button.header__lang-option(type="button" onclick="changeLanguage('it')")
                            img(src='/images/it.png')
                            span Italiano
                        button.header__lang-option(type="button" onclick="changeLanguage('de')")
                            img(src='/images/de.png')
                            span Deutsch
            .sidebar-profile
                .profile-image
                    img(src=user.profilePicture)
                .profile-name= user.fullName.split(" ")
                if user.isPremium
                    .admin__profile-premium--icon.flex-c
                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffe600"><path d="M200-160v-80h560v80H200Zm0-140-51-321q-2 0-4.5.5t-4.5.5q-25 0-42.5-17.5T80-680q0-25 17.5-42.5T140-740q25 0 42.5 17.5T200-680q0 7-1.5 13t-3.5 11l125 56 125-171q-11-8-18-21t-7-28q0-25 17.5-42.5T480-880q25 0 42.5 17.5T540-820q0 15-7 28t-18 21l125 171 125-56q-2-5-3.5-11t-1.5-13q0-25 17.5-42.5T820-740q25 0 42.5 17.5T880-680q0 25-17.5 42.5T820-620q-2 0-4.5-.5t-4.5-.5l-51 321H200Zm68-80h424l26-167-105 46-133-183-133 183-105-46 26 167Zm212 0Z"/></svg>
           

        .sidebar-header#switchCompany
            .header-company
                .flex-c.prime
                    img(src="/images/icon.webp")
                a(href="/").company
                    h2 SayMiro
                #closeSidebar
                    svg(xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3")
                        path(d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z")
