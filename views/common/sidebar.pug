aside.sidebar#sidebar
    .sb-wrap

        //- ── Header: logo + close ──────────────────────────────────
        .sb-header
            a.sb-logo(href="/")
                img.sb-logo__mark(src="/images/icon.svg" alt="BranShee")
                span.sb-logo__name BranShee
            button.sb-close#closeSidebar(type="button" aria-label="Close menu")
                svg(viewBox="0 -960 960 960" height="20" width="20" fill="currentColor")
                    path(d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z")

        //- ── Établissement actif + switcher ──────────────────────────
        if currentCompany
            //- Nom de l'ÉTABLISSEMENT actif. Le repli sur le compte est résolu
            //- côté serveur (injectCompany → currentCompanyName) : il porte sur
            //- le compte du VRAI patron, jamais sur celui du visiteur — un
            //- collaborateur voyait sinon le nom de sa propre activité.
            - const estabName = currentCompanyName || currentCompany.name || 'Établissement'
            - const estabInitial = estabName.charAt(0).toUpperCase()
            - const estabPhoto = currentCompany.photo || ''
            .sb-estab.sb-estab--switchable#sidebarEstab
                button.sb-estab__current(type="button")
                    .sb-estab__avatar
                        if estabPhoto
                            img(src=estabPhoto alt="")
                        else
                            = estabInitial
                    span.sb-estab__name= estabName
                    svg.sb-estab__caret(viewBox="0 0 24 24" height="12" width="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                        polyline(points="6 9 12 15 18 9")
                .sb-estab__panel
                    .sb-estab__panel-head
                        .sb-estab__panel-avatar
                            if estabPhoto
                                img(src=estabPhoto alt="")
                            else
                                = estabInitial
                        span.sb-estab__panel-name= estabName
                    if myCompanies && myCompanies.length > 0
                        .sb-estab__sep
                        each c in myCompanies
                            - const cInitial = (c.name || 'E').charAt(0).toUpperCase()
                            - const isCurrent = String(c.id) === String(currentCompany._id)
                            button.sb-estab__opt(type="button" class=isCurrent ? 'is-active' : '' data-id=c.id)
                                .sb-estab__opt-avatar(class=isCurrent ? 'is-active' : '')
                                    if c.photo
                                        img(src=c.photo alt="")
                                    else
                                        = cInitial
                                .sb-estab__opt-info
                                    span.sb-estab__opt-name= c.name
                                    if !c.isOwner
                                        span.sb-estab__opt-tag= t.sidebar.tag_collaborator
                                if isCurrent
                                    span.material-symbols-outlined.sb-estab__opt-check check_circle
                    .sb-estab__sep
                    a.sb-estab__add(href="/etablissement/mes-etablissements")
                        svg(viewBox="0 -960 960 960" height="15" width="15" fill="currentColor")
                            path(d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z")
                        span Plus d'établissements

        //- ── Navigation ───────────────────────────────────────────
        nav.sb-nav

            if currentCompany
                //- ── 1. Menu principal (Dashboard inclus, tout en haut) ─────
                .sb-section
                    span.sb-section__title= t.sidebar.title_1
                    .sb-section__links
                        a.sb-link.sb-link--dashboard(href="/panel" class=pageName === 'Dashboard' ? 'active' : '')
                            svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                                rect(x="3" y="3" width="7.5" height="7.5" rx="1.6")
                                rect(x="13.5" y="3" width="7.5" height="7.5" rx="1.6")
                                rect(x="3" y="13.5" width="7.5" height="7.5" rx="1.6")
                                rect(x="13.5" y="13.5" width="7.5" height="7.5" rx="1.6")
                            span Dashboard
                        a.sb-link(href="/appointment" class=pageName === 'Appointment' ? 'active' : '')
                            svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                                rect(x="3" y="4.5" width="18" height="16" rx="3")
                                path(d="M3 9h18M8 2.5v4M16 2.5v4")
                            span= t.sidebar.a_2
                        //- Lien « Historique » (/history) retiré du menu — la page reste
                        //- accessible (route conservée) mais on coupe tout accès UI, la
                        //- nouvelle section « Clients » (/clients-hub) la remplace.
                        //- Lien « Dossiers clients » (/clients) retiré du menu — la page
                        //- reste accessible (route conservée) le temps de valider la
                        //- nouvelle section « Clients » (/clients-hub) qui la remplace.
                        a.sb-link(href="/clients-hub" class=pageName === 'ClientsHub' ? 'active' : '')
                            svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                                circle(cx="9" cy="8" r="3.2")
                                path(d="M3.5 20a5.5 5.5 0 0 1 11 0M16 5.5a3 3 0 0 1 0 5.6M20.5 20a5 5 0 0 0-3.5-4.8")
                            span Clients

                //- ── 2. Mon activité ──────────────────────────────────
                - const canSeeServices = !!(permissions && (permissions.services.view || permissions.services.manage))
                - const canSeeGroupSessions = !!(permissions && (permissions.groupSessions.view || permissions.groupSessions.manage))
                - const canSeeCustomize = !!(permissions && permissions.customization.manage)
                - const canSeeForms = !!(permissions && permissions.forms.manage)
                .sb-section
                    span.sb-section__title= t.sidebar.section_activity
                    .sb-section__links
                        if canSeeServices
                            a.sb-link(href="/services" class=pageName === 'Services' ? 'active' : '')
                                svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                                    circle(cx="6" cy="6" r="2.6")
                                    circle(cx="6" cy="18" r="2.6")
                                    path(d="M8.2 7.8 20 18M20 6 8.2 16.2")
                                span= t.sidebar.a_8
                        - const hasAvailAccess = permissions && (permissions.availability.manageShared || permissions.availability.manageOwnSchedule || permissions.availability.manageOthersSchedule || permissions.availability.manageOwnTimeOff || permissions.availability.manageOthersTimeOff)
                        a.sb-link(href=(hasAvailAccess ? '/availability' : '#') class=[pageName === 'Availability' ? 'active' : '', !hasAvailAccess ? 'sb-link--disabled' : ''].filter(Boolean).join(' '))
                            svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                                circle(cx="12" cy="12" r="9")
                                path(d="M12 7v5l3.5 2")
                            span= t.sidebar.a_3
                        if canSeeCustomize
                            //- « Profil incomplet » se juge sur l'ÉTABLISSEMENT
                            //- actif (repli compte) : sinon le badge restait
                            //- faux dès le 2e établissement.
                            - var _estabPic = (currentCompany && currentCompany.photo) || user.businessPicture
                            - var _estabName = (currentCompany && currentCompany.name) || user.businessName
                            - var _profileIncomplete = !_estabPic || !_estabName
                            a.sb-link(href="/customize-calendar" class=pageName === 'Customize' ? 'active' : '')
                                svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                                    path(d="M12 3a9 9 0 1 0 0 18c1 0 1.6-.8 1.6-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.1 0-.9.7-1.6 1.6-1.6H16a5 5 0 0 0 5-5c0-3.6-4-6.4-9-6.4Z")
                                    circle(cx="7.5" cy="11" r="1")
                                    circle(cx="12" cy="8" r="1")
                                    circle(cx="16" cy="11" r="1")
                                span= t.sidebar.a_customize
                                if _profileIncomplete
                                    span.sb-badge.sb-badge--warn !
                        if canSeeForms
                            a.sb-link(href="/forms" class=pageName === t.sidebar.a_9 ? 'active' : '')
                                svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                                    rect(x="4" y="3" width="16" height="18" rx="2.5")
                                    path(d="M8 8h8M8 12h8M8 16h5")
                                span= t.sidebar.a_9

                //- ── 3. Communication ─────────────────────────────────
                .sb-section
                    span.sb-section__title Communication
                    .sb-section__links
                        a.sb-link(href="/mon-site" class=pageName === 'MonSite' ? 'active' : '')
                            svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                                circle(cx="12" cy="12" r="9")
                                path(d="M3 12h18M12 3c2.5 2.4 2.5 15.6 0 18M12 3c-2.5 2.4-2.5 15.6 0 18")
                            span Mon site web
                        a.sb-link(href="/parrainage" class=pageName === 'Parrainage' ? 'active' : '')
                            svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                                rect(x="3.5" y="8" width="17" height="12" rx="2")
                                path(d="M3.5 12h17M12 8v12M12 8S10.5 4 8 4s-2 4 4 4Zm0 0s1.5-4 4-4 2 4-4 4Z")
                            span Parrainage
                        a.sb-link(href="/sms" class=pageName === 'Sms' ? 'active' : '')
                            svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                                path(d="M4 5h16v11H8l-4 3.5V5Z")
                                path(d="M8 9.5h8M8 12.5h5")
                            span SMS

                //- ── Abonnement ───────────────────────────────────────
                //- Le lien n'existait QUE dans le menu du profil, replié
                //- derrière l'avatar : les pros ne trouvaient pas la page des
                //- forfaits. Même condition de permission qu'avant.
                if permissions && permissions.billing && permissions.billing.manage
                    .sb-section
                        span.sb-section__title Facturation
                        .sb-section__links
                            a.sb-link(href="/subscription" class=pageName === 'Subscription' ? 'active' : '')
                                svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                                    rect(x="3" y="5" width="18" height="14" rx="2.5")
                                    path(d="M3 9.5h18")
                                span= t.sidebar.a_1 || 'Abonnement'

                //- ── 4. Équipe ────────────────────────────────────────
                - const canSeeCollaborators = !!(currentCompany && permissions && permissions.collaborators.view)
                - const canSeeLogs = !!(permissions && permissions.logs.view)
                - const canSeeGrades = !!(currentCompany && permissions && permissions.grades && (permissions.grades.view || permissions.grades.manage))
                if canSeeCollaborators || canSeeLogs || canSeeGrades
                    .sb-section
                        span.sb-section__title= t.sidebar.section_team
                        .sb-section__links
                            if canSeeCollaborators
                                a.sb-link(href=`/etablissement/${currentCompany._id}/collaborateurs` class=pageName === 'Collaborateurs' ? 'active' : '')
                                    svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                                        circle(cx="8" cy="9" r="2.6")
                                        circle(cx="16" cy="9" r="2.6")
                                        path(d="M3.5 19a4.5 4.5 0 0 1 9 0M11.5 19a4.5 4.5 0 0 1 9 0")
                                    span= t.sidebar.a_collaborators
                                    if pendingMembershipsCount > 0
                                        span.sb-badge= pendingMembershipsCount > 9 ? '9+' : pendingMembershipsCount
                            if canSeeGrades
                                a.sb-link(href=`/etablissement/${currentCompany._id}/grades` class=pageName === 'Grades' ? 'active' : '')
                                    svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                                        path(d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z")
                                    span= t.sidebar.a_grades
                            if canSeeLogs
                                a.sb-link(href="/logs" class=pageName === 'Logs' ? 'active' : '')
                                    svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                                        path(d="M5 4h14v16H5zM9 8h6M9 12h6M9 16h3")
                                    span= t.sidebar.a_logs


        //- ── Footer ───────────────────────────────────────────────
        .sb-foot
            //- Bottom links fixes (Voir calendrier). Paramètres n'est volontairement
            //- pas ici : il reste accessible via le menu profil (.sb-user-panel__item)
            //- pour éviter un doublon.
            .sb-foot-links
                a.sb-foot-link(href="/support" class=pageName === 'Support' ? 'is-active' : '')
                    svg(viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                        circle(cx="12" cy="12" r="9")
                        path(d="M9.5 9.5a2.5 2.5 0 1 1 3.4 2.3c-.6.3-.9.8-.9 1.4v.3")
                        path(d="M12 17h.01")
                    span= t.sidebar.a_support
                if currentCompany
                    a.sb-foot-link.sb-foot-link--ext(href=`/${currentCompany.slug || currentCompany._id}` target="_blank")
                        //- Icône « calendrier » du même jeu que la navigation :
                        //- ce lien ouvre la page de réservation publique.
                        svg(viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                            rect(x="3" y="4.5" width="18" height="16" rx="3")
                            path(d="M3 9h18M8 2.5v4M16 2.5v4")
                        span= t.sidebar.a_5
                        //- Flèche « ouvre dans un nouvel onglet », en trait elle
                        //- aussi pour ne pas jurer à côté de la précédente.
                        svg.sb-ext-icon(viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                            path(d="M14 4h6v6M20 4l-9 9")
                            path(d="M18 14v5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 19V8a1.5 1.5 0 0 1 1.5-1.5H10")

            //- ── Quota RDV card (free users) ──────────────────────────
            if !isPro && monthlyBookingsLimit !== undefined && isFinite(monthlyBookingsLimit)
                -
                    const bCount = monthlyBookingsCount || 0
                    const bLimit = monthlyBookingsLimit || 30
                    const bPct   = Math.min(Math.round((bCount / bLimit) * 100), 100)
                    const bClass = bPct >= 90 ? 'sb-quota--danger' : bPct >= 65 ? 'sb-quota--warn' : ''
                a.sb-quota(href="/subscription" class=bClass)
                    .sb-quota__top
                        span.sb-quota__label= t.subscription.usage_label
                        span.sb-quota__count
                            strong= bCount
                            |  / #{bLimit}
                    .sb-quota__bar
                        .sb-quota__fill(style=`width:${bPct}%`)
                    .sb-quota__bottom
                        span.sb-quota__hint= t.sidebar.quota_hint
                        span.sb-quota__cta →

            //- ── User profile chip + popup ────────────────────────────
            .sb-user-wrap#sidebarUserWrap
                //- Le bouton carré de déconnexion qui doublait cette ligne a été
                //- retiré : « Déconnexion » figure déjà dans le menu ci-dessous,
                //- et deux chemins vers la même action encombraient le pied pour
                //- rien. Le compte occupe donc toute la largeur.
                button.sb-user#sidebarUserBtn(type="button" aria-haspopup="true" aria-expanded="false" aria-controls="sidebarUserPanel")
                    .sb-user__avatar
                        img(src=user.profilePicture alt=user.fullName)
                    .sb-user__info
                        span.sb-user__name= user.fullName
                        //- « Plan X » et non « X » seul : le libellé dit ce
                        //- qu'il désigne. « Free » sous un nom se lisait
                        //- comme une qualité de la personne.
                        if isPro
                            span.sb-user__badge(class=currentPlan === 'business' ? 'sb-user__badge--business' : '')
                                = 'Plan ' + (currentPlan === 'business' ? 'Pro+' : 'Pro')
                        else
                            span.sb-user__plan Plan gratuit
                    //- Chevron, pas la double flèche de tri qui était là :
                    //- ce bouton ouvre un menu, il ne trie rien.
                    svg.sb-user__caret(viewBox="0 0 24 24" height="13" width="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                        polyline(points="6 9 12 15 18 9")
                .sb-user-panel#sidebarUserPanel
                    .sb-user-panel__header
                        .sb-user-panel__avatar
                            img(src=user.profilePicture alt=user.fullName)
                        .sb-user-panel__info
                            span.sb-user-panel__name= user.fullName
                            span.sb-user-panel__email= user.email
                    if !isPro && (!currentCompany || (permissions && permissions.billing && permissions.billing.manage))
                        a.sb-user-panel__upgrade(href="/subscription")
                            .sb-user-panel__upgrade-left
                                svg(viewBox="0 -960 960 960" height="14" width="14" fill="currentColor")
                                    path(d="m233-120 65-281L80-590l288-25 112-265 112 265 288 25-218 189 65 281-247-149-247 149Z")
                                .sb-user-panel__upgrade-text
                                    span.sb-user-panel__upgrade-title= t.sidebar.upgrade_title
                                    span.sb-user-panel__upgrade-sub= t.sidebar.upgrade_sub
                            svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                                path(d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z")
                    .sb-user-panel__sep
                    a.sb-user-panel__item(href="/settings")
                        svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                            path(d="m370-80-16-128q-13-5-24.5-12T307-235l-119 50L78-375l103-78q-1-7-1-13.5v-27q0-6.5 1-13.5L78-585l110-190 119 50q11-8 23-15t24-12l16-128h220l16 128q13 5 24.5 12t22.5 15l119-50 110 190-103 78q1 7 1 13.5v27q0 6.5-2 13.5l103 78-110 190-118-50q-11 8-23 15t-24 12L590-80H370Zm70-80h79l14-106q31-8 57.5-23.5T639-327l99 41 39-68-86-65q5-14 7-29.5t2-31.5q0-16-2-31.5t-7-29.5l86-65-39-68-99 42q-22-23-48.5-38.5T533-694l-13-106h-79l-14 106q-31 8-57.5 23.5T321-633l-99-41-39 68 86 64q-5 15-7 30t-2 32q0 16 2 31t7 30l-86 65 39 68 99-42q22 23 48.5 38.5T427-266l13 106Zm42-180q58 0 99-41t41-99q0-58-41-99t-99-41q-59 0-99.5 41T342-480q0 58 40.5 99t99.5 41Zm-2-140Z")
                        span= t.sidebar.a_settings_account
                    if permissions && permissions.billing && permissions.billing.manage
                        a.sb-user-panel__item(href="/subscription")
                            svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                                path(d="M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h640q33 0 56.5 23.5T880-720v480q0 33-23.5 56.5T800-160H160Zm0-80h640v-480H160v480Zm40-40h400L400-680H200v400Zm320-320h240v-80H520v80ZM160-240v-480 480Z")
                            span= t.sidebar.a_1
                    //- Installer l'app — dans le menu du profil, donc accessible
                    //- depuis TOUTES les pages admin. Masqué par le JS quand le
                    //- navigateur ne sait pas installer ou que c'est déjà fait.
                    button.sb-user-panel__item(type="button" hidden data-pwa-install)
                        svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                            path(d="M480-320 280-520l56-58 104 104v-326h80v326l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z")
                        span= t.pwa.install_title
                    .sb-user-panel__sep
                    a.sb-user-panel__item.sb-user-panel__item--danger(href="/logout")
                        svg(viewBox="0 -960 960 960" height="16" width="16" fill="currentColor")
                            path(d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h280v80H200Zm440-160-55-58 102-102H360v-80h327L585-622l55-58 200 200-200 200Z")
                        span= t.sidebar.a_6

    script.
        (function () {
            // Menu non pliable : sections toujours ouvertes (plus de toggle).
            // User profile popup
            var userBtn = document.getElementById('sidebarUserBtn');
            var userPanel = document.getElementById('sidebarUserPanel');
            var userWrap = document.getElementById('sidebarUserWrap');
            if (userBtn && userPanel) {
                var setOpen = function (open) {
                    userWrap.classList.toggle('is-open', open);
                    userPanel.style.display = open ? 'block' : 'none';
                    userBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
                };
                userBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    setOpen(!userWrap.classList.contains('is-open'));
                });
                document.addEventListener('click', function (e) {
                    if (!userWrap.contains(e.target)) setOpen(false);
                });
                // Échap ferme le menu et rend le focus au bouton : sans ça, on
                // restait piégé dans un menu ouvert au clavier.
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && userWrap.classList.contains('is-open')) {
                        setOpen(false);
                        userBtn.focus();
                    }
                });
            }
        })();
