    script.
        (function () {
            // Menu non pliable : sections toujours ouvertes (plus de toggle).
            // User profile popup
            var userBtn = document.getElementById('sidebarUserBtn');
            var userPanel = document.getElementById('sidebarUserPanel');
            var userWrap = document.getElementById('sidebarUserWrap');
            if (userBtn && userPanel) {
                userBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var isOpen = userWrap.classList.toggle('is-open');
                    userPanel.style.display = isOpen ? 'block' : 'none';
                });
                document.addEventListener('click', function (e) {
                    if (!userWrap.contains(e.target)) {
                        userWrap.classList.remove('is-open');
                        userPanel.style.display = 'none';
                    }
                });
            }
        })();
