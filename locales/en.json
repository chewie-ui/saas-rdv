  "faq": {
    "title": "Frequently asked questions",
    "description": "Everything you need to know to get started with BranShee.",
    "items": [
      {
        "q": "How does BranShee work?",
        "a": "BranShee allows your clients to book sessions online in just a few clicks based on your availability."
      },
      {
        "q": "Do my clients need to create an account?",
        "a": "No, your clients can book quickly without creating an account."
      },
      {
        "q": "Can I manage my availability?",
        "a": "Yes, you can set your schedule, block time slots, and manage your calendar easily."
      },
      {
        "q": "Does BranShee send reminders?",
        "a": "Yes, automatic reminders are sent to reduce no-shows."
      },
      {
        "q": "Can I cancel my subscription?",
        "a": "Yes, you can cancel anytime with no commitment."
      },
      {
        "q": "Is it easy to use?",
        "a": "Yes, BranShee is designed to be simple and quick to use."
      }
    ]
  },
