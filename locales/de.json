  "faq": {
    "title": "Häufig gestellte Fragen",
    "description": "Alles, was du wissen musst, um mit BranShee zu beginnen.",
    "items": [
      {
        "q": "Wie funktioniert BranShee?",
        "a": "BranShee ermöglicht es deinen Kunden, ihre Sitzungen online in wenigen Klicks gemäß deiner Verfügbarkeit zu buchen."
      },
      {
        "q": "Müssen meine Kunden ein Konto erstellen?",
        "a": "Nein, deine Kunden können schnell ohne Konto buchen."
      },
      {
        "q": "Kann ich meine Verfügbarkeit verwalten?",
        "a": "Ja, du kannst deine Arbeitszeiten festlegen, Zeitfenster blockieren und deinen Kalender einfach verwalten."
      },
      {
        "q": "Sendet BranShee Erinnerungen?",
        "a": "Ja, automatische Erinnerungen werden gesendet, um Abwesenheiten zu reduzieren."
      },
      {
        "q": "Kann ich mein Abonnement kündigen?",
        "a": "Ja, du kannst jederzeit ohne Verpflichtung kündigen."
      },
      {
        "q": "Ist es kompliziert zu benutzen?",
        "a": "Nein, BranShee ist so konzipiert, dass es einfach und schnell zu bedienen ist."
      }
    ]
  },
