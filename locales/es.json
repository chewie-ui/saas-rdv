  "faq": {
    "title": "Preguntas frecuentes",
    "description": "Todo lo que necesitas saber para empezar con SayMiro Calendar.",
    "items": [
      {
        "q": "¿Cómo funciona SayMiro Calendar?",
        "a": "SayMiro Calendar permite a tus clientes reservar sus sesiones online en pocos clics según tus disponibilidades."
      },
      {
        "q": "¿Mis clientes necesitan crear una cuenta?",
        "a": "No, tus clientes pueden reservar rápidamente sin crear una cuenta."
      },
      {
        "q": "¿Puedo gestionar mis disponibilidades?",
        "a": "Sí, puedes definir tus horarios, bloquear franjas horarias y gestionar tu agenda fácilmente."
      },
      {
        "q": "¿SayMiro Calendar envía recordatorios?",
        "a": "Sí, se envían recordatorios automáticos para reducir las ausencias."
      },
      {
        "q": "¿Puedo cancelar mi suscripción?",
        "a": "Sí, puedes cancelar en cualquier momento sin compromiso."
      },
      {
        "q": "¿Es complicado de usar?",
        "a": "No, SayMiro Calendar está diseñado para ser simple y rápido de usar."
      }
    ]
